<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8 e non net10: la destinazione del travaso è MariaDB, e l'unico provider EF che la regge è
         Pomelo, che esiste solo per EF Core 8 (ADR-0007 §D4-ter). È lo stesso motivo per cui Vipi.Host è
         net8. Su net10 il tool compilerebbe ma non avrebbe modo di scrivere dove serve. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Tool one-shot: non parte del deploy. Ripreso a mano quando serve rifare il travaso. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Eredita VipiDbContext + entità + i provider EF Sqlite/Npgsql/Pomelo (referenziati non-private in
         Infrastructure, che sul ramo net8 li ha tutti e tre). -->
    <ProjectReference Include="..\..\src\Vipi.Infrastructure\Vipi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
