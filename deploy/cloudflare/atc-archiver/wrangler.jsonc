{
  "name": "atc-archiver",
  "main": "index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2024-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "abf60d59-0814-40a0-a3fc-df15ad64e2c1"
    }
  ]
}