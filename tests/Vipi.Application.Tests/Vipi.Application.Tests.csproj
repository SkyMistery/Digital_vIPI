<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target come Vipi.Application, e per lo stesso motivo di Vipi.Infrastructure.Tests: net8 è il
         TFM che va su atc.it.ivao.aero. Fino all'11 agosto 2026 questo progetto era net10 soltanto, quindi
         tutta la logica editoriale girava esclusivamente sul runtime che NON va in produzione. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Stesso pin di Vipi.Infrastructure (CVE-2025-6965): qui SQLite arriva per conto suo, non via
         ProjectReference, quindi la 2.1.11 rientrerebbe dalla finestra. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- I flussi veri estratti dal vipi.db e il file approvato della loro derivazione: la rete che accompagna la
       sostituzione del modello dei trasferimenti. Copiati accanto all'assembly perché il test li legge (e ci
       scrive il .received.txt quando il confronto fallisce). -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

</Project>
