<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target, e non per gusto: il ramo MariaDB del codice vive sotto #if NET8_0 perché Pomelo non
         ha una build per EF Core 10 (ADR-0007 §D4-ter). Su net10 quel ramo non viene nemmeno compilato,
         quindi senza il target net8 manderemmo in produzione l'unico pezzo che nessun test esegue — che è
         esattamente la condizione in cui si trova ancora oggi il percorso Npgsql di ISchemaDriftProbe.
         `dotnet test` esegue entrambi i target. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vipi.Infrastructure\Vipi.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⚠️ COLLEGATO, non copiato. La cultura di UI di questa macchina è INGLESE (è la lingua di Windows,
         indipendente dal formato regionale), e da quando i messaggi a chi modifica hanno due lingue un test
         che asserisce una parola italiana senza fissarla cade qui. Il difetto non è nuovo: è vecchio, e
         adesso si vede. La regoletta sta in Vipi.Application.Tests: una seconda copia sarebbe un secondo
         posto dove sapere quali lingue esistono. -->
    <Compile Include="..\Vipi.Application.Tests\CulturaDiProva.cs" Link="CulturaDiProva.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- Set di migrazioni MariaDB: esiste solo su net8, come Pomelo. Serve a verificare che non resti
         indietro rispetto al modello — il costo dichiarato della scelta (a) in ADR-0007 è "ogni cambio di
         schema va emesso due volte", e senza una guardia quel costo si paga in produzione. -->
    <ProjectReference Include="..\..\src\Vipi.Infrastructure.MySqlMigrations\Vipi.Infrastructure.MySqlMigrations.csproj" />
  </ItemGroup>

</Project>
