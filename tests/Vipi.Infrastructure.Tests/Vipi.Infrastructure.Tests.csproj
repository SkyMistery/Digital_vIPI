<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target, e non per gusto: net10 è il TFM della PRODUZIONE (Vipi.Host dal 13 settembre 2026,
         L13), net8 quello dell'embedding in Ivao.It. Il ramo MariaDB non sta più sotto #if NET8_0 — lo stack EF
         è EF 8 + Pomelo su entrambi — e i suoi test girano quindi sui due target. `dotnet test` esegue
         entrambi. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vipi.Infrastructure\Vipi.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⚠️ COLLEGATO, non copiato. La cultura di UI di questa macchina è INGLESE (è la lingua di Windows,
         indipendente dal formato regionale), e da quando i messaggi a chi modifica hanno due lingue un test
         che asserisce una parola italiana senza fissarla cade qui. Il difetto non è nuovo: è vecchio, e
         adesso si vede. La regoletta sta in Vipi.Application.Tests: una seconda copia sarebbe un secondo
         posto dove sapere quali lingue esistono. -->
    <Compile Include="..\Vipi.Application.Tests\CulturaDiProva.cs" Link="CulturaDiProva.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- La concordanza fra il motore del sector e AuroraSectorfileParser (carta F2 slice 9). La regola è UNA, nello
         strumento che la misura sull'albero intero; qui la stessa, sui campioni, gira in CI. Il motore si vede
         solo dai test: Vipi.Infrastructure non lo referenzia. -->
    <Compile Include="..\..\tools\Vipi.SectorfileProva\Concordanza.cs" Link="Sectorfile\Concordanza.cs" />
    <ProjectReference Include="..\..\src\Vipi.Sectorfile\Vipi.Sectorfile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Set di migrazioni MariaDB, su entrambi i TFM come Pomelo dal 13 settembre 2026 (L13). Serve a verificare che non resti
         indietro rispetto al modello — il costo dichiarato della scelta (a) in ADR-0007 è "ogni cambio di
         schema va emesso due volte", e senza una guardia quel costo si paga in produzione. -->
    <ProjectReference Include="..\..\src\Vipi.Infrastructure.MySqlMigrations\Vipi.Infrastructure.MySqlMigrations.csproj" />
  </ItemGroup>

</Project>
