<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vipi.Infrastructure\Vipi.Infrastructure.csproj" />
    <!-- Set di migrazioni MySQL: serve per verificare che non resti indietro rispetto al modello. È il
         costo dichiarato della scelta (a) in ADR-0007 §D4-bis — ogni cambio di schema va emesso due volte
         — e senza una guardia quel costo si paga in produzione invece che in CI. -->
    <ProjectReference Include="..\..\src\Vipi.Infrastructure.MySqlMigrations\Vipi.Infrastructure.MySqlMigrations.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\..\src\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

</Project>
