<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Un TFM solo, quello di Vipi.Host: questo progetto avvia l'host in-process. È net10 dal 13 settembre
         2026 (L13), come l'host. Ad agosto era net10 mentre l'host era net8, e caricava l'assembly dell'host
         in roll-forward — «assembly giusta, runtime sbagliato». Uno smoke di avvio che gira su un runtime
         diverso da quello di produzione non è uno smoke di avvio: i due TFM vanno cambiati INSIEME. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- 🔴 Il framework condiviso di ASP.NET Core, DICHIARATO (19 ottobre 2026). Questo progetto avvia l'host
         in-process, quindi a runtime gira già su Microsoft.AspNetCore.App 10. Ma senza dichiararlo il restore
         non lo sa, e non pota i pacchetti che quel framework già contiene: restavano nel grafo le versioni 8 che
         l'host tira dietro con Microsoft.AspNetCore.DataProtection.EntityFrameworkCore 8.0.* —
         DataProtection 8.0.31, System.Security.Cryptography.Xml 8.0.4 e Pkcs 8.0.1, sei avvisi di
         vulnerabilità (NU1902/NU1903). L'host è un progetto Web e quel framework ce l'ha implicito: per questo
         a lui non comparivano, e non comparivano nel publish. Non si fissano versioni a mano: si dichiara
         quel che è vero, e il restore fa la stessa potatura che fa per l'host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vipi.Host\Vipi.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ⚠️ COLLEGATO, non copiato. Da quando le due pagine d'errore parlano la lingua di chi legge, il loro
         testo dipende dalla cultura AMBIENTALE: un test che asserisce l'italiano senza fissarla passa in
         Italia e cade su una macchina inglese. La regoletta per fissarla esiste già in
         Vipi.Application.Tests; una seconda copia sarebbe un secondo posto dove sapere che le lingue sono
         «it» e «en», e i due un giorno direbbero cose diverse. -->
    <Compile Include="..\Vipi.Application.Tests\CulturaDiProva.cs" Link="CulturaDiProva.cs" />
  </ItemGroup>

</Project>
