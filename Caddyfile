# Caddy: TLS automatico (Let's Encrypt) per {$SITE_ADDRESS} e reverse proxy verso l'app .NET.
# WebSocket/SignalR di Blazor Server passano trasparenti: nessuna config extra.
{$SITE_ADDRESS} {
	reverse_proxy app:8080
}
