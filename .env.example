# Copia in `.env` sulla VM e riempi. NON committare `.env` (già in .gitignore).
# Dominio pubblico (DuckDNS o simile) puntato all'IP della VM. Caddy prende il cert HTTPS per questo host.
SITE_ADDRESS=vipitest.duckdns.org

# Client OIDC login IVAO (portale sviluppatori IVAO). Redirect da registrare:
#   https://<SITE_ADDRESS>/signin-oidc  e  https://<SITE_ADDRESS>/signout-callback-oidc
VIPI_CLIENT_ID=
VIPI_CLIENT_SECRET=

# Token app IVAO per il polling tracker (può coincidere o essere separato).
IVAO_CLIENT_ID=
IVAO_CLIENT_SECRET=

# Chi può editare: pattern regex case-insensitive sui codici staff. Es. "IT-.*" = tutti gli staff IT.
ADMIN_STAFF_PATTERN=IT-.*
