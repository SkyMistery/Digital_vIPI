<Project Sdk="Microsoft.NET.Sdk">

  <!--
    La parte comune degli importer (F6, docs/feature/2026-10-18-f6-pdf-aip.md, slice 0c): leggere un PDF dell'AIP
    con le posizioni delle parole e delle righe della tabella, ricavarne colonne e righe di testo, la data AIRAC di
    ogni pagina, e il testo dei limiti laterali come geometrie del modello. Quel che cambia da Stato a Stato
    (colonne, frasi, impaginazione) sta in un progetto per Stato (Aip.Pdf.Italia).

    🔴 Un progetto a sé (carta F6 §3): dipende dal modello, dal runtime e da PdfPig (Apache-2.0, .NET puro: la sola
    dipendenza dichiarata, e sostituibile). Niente «vIPI» nel nome, gira solo in locale.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Aip.Pdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aip\Aip.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
