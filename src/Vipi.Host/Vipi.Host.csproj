<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Vipi.Hosting\Vipi.Hosting.csproj" />
    <ProjectReference Include="..\Vipi.Ui\Vipi.Ui.csproj" />
    <ProjectReference Include="..\Vipi.Infrastructure\Vipi.Infrastructure.csproj" />
    <ProjectReference Include="..\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>79756a9b-0ff7-4ec7-89d3-88a116771871</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- File editabile della frase di coordinamento: copiato in output, ricaricato a caldo. -->
    <Content Update="content\coordination-sentence.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modulo login IVAO OIDC (scenario C, standalone). STACCABILE: rimuovi questo pacchetto + i file
         Auth\*.cs quando vIPI va embedded in un host con auth propria. Il core resta invariato. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.*" />
    <!-- Key-ring Data Protection su DB (antiforgery/cookie persistenti tra redeploy su Render). Vedi VipiDataProtection.cs. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>

</Project>
