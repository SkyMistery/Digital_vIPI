<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- Font self-hosted dal modulo (nessuna chiamata esterna a Google Fonts). I .woff2 sono referenziati
         da dentro vipi-fonts.css, quindi non passano da @@Assets: restano serviti col nome originale. -->
    <link rel="stylesheet" href="@AssetVersion.Url("_content/Vipi.Ui/vipi-fonts.css")" />
    <link rel="stylesheet" href="@AssetVersion.Url("_content/Vipi.Ui/vipi-theme.css")" />
    <link rel="stylesheet" href="@AssetVersion.Url("_content/Vipi.Ui/vipi-aor3d.css")" />
    <link rel="stylesheet" href="@AssetVersion.Url("_content/Vipi.Ui/vipi-print.css")" />
    <link rel="stylesheet" href="@AssetVersion.Url("Vipi.Host.styles.css")" />
    <!-- Leaflet (mappa AOR minimal). -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <!-- Reset di pagina dell'host standalone: il modulo non tocca più body/html (stili confinati in .vipi-root). -->
    <style>html,body{height:100%;margin:0;background:#f4f5f9}</style>
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        // Zoom globale persistente (localStorage). Applicato subito e ri-applicato a ogni navigazione.
        (function () {
            var read = function () { var z = parseFloat(localStorage.getItem('vipiZoom') || '1'); return isNaN(z) ? 1 : z; };
            window.vipiApplyZoom = function () {
                var z = read();
                document.documentElement.style.zoom = z;
                var el = document.getElementById('vipiZoomPct');
                if (el) el.textContent = Math.round(z * 100) + '%';
            };
            window.vipiSetZoom = function (v) {
                v = Math.min(1.8, Math.max(0.7, Math.round(v * 100) / 100));
                localStorage.setItem('vipiZoom', v);
                window.vipiApplyZoom();
            };
            window.vipiZoom = function (d) { window.vipiSetZoom(read() + d); };
            window.vipiZoomReset = function () { window.vipiSetZoom(1); };
            window.vipiApplyZoom();
        })();
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-ui.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-screens.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-live.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-aor.js")"></script>
    <!-- Three.js (viewer 3D AoR) — vendorizzato localmente (r128 UMD, espone THREE globale). NON caricato qui:
         sono 592 KB che servono al solo tab 3D, mentre questo <head> vale per ogni pagina. L'URL (con l'impronta
         di MapStaticAssets) passa a vipi-aor3d.js, che lo carica alla prima apertura di uno stage 3D. -->
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-aor3d.js")"
            data-three-src="@AssetVersion.Url("_content/Vipi.Ui/vendor/three.min.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-editor.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-tour.js")"></script>
    <script src="@AssetVersion.Url("_content/Vipi.Ui/vipi-media.js")"></script>
    <script>
        // Ri-applica zoom e ricollega l'interattività dopo ogni navigazione "enhanced" di Blazor
        // (che rimpiazza il DOM e perderebbe lo stile zoom inline e gli handler).
        Blazor.addEventListener('enhancedload', function () {
            window.vipiApplyZoom && window.vipiApplyZoom();
            window.vipiWireUi && window.vipiWireUi();
            window.vipiInitScreens && window.vipiInitScreens();
            window.vipiInitAor && window.vipiInitAor();
            window.vipiInitAor3d && window.vipiInitAor3d();
            window.vipiMaybeTour && window.vipiMaybeTour();
        });
    </script>
</body>

</html>
