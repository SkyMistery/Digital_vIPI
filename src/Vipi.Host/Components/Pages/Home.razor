@page "/"
@inject NavigationManager Nav

<PageTitle>vIPI · IVAO Italy</PageTitle>

@code {
    // La radice porta all'hub dei servizi, non più direttamente alla documentazione: dal 22 agosto 2026 la
    // documentazione è UNO dei servizi, e chi arriva sul dominio deve vederli tutti.
    // `replace: true` perché questa pagina non deve finire nella cronologia: chi torna indietro dall'hub
    // vuole uscire dal sito, non rimbalzare qui e essere rispedito avanti.
    protected override void OnInitialized() => Nav.NavigateTo("/services", replace: true);
}
