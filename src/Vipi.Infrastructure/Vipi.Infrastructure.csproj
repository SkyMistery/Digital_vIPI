<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
  </ItemGroup>

  <!-- Ramo embedding (host Ivao.It, net8): stessa API, stack EF Core 8. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- MySQL: provider di PRODUZIONE (atc.it.ivao.aero), ADR-0007 §D4-bis.
         Una sola versione per entrambi i TFM, a differenza degli altri due pacchetti EF: il nuspec di
         10.0.9 ha tre gruppi di dipendenze — net8.0→EF 8.0.28, net9.0→EF 9.0.17, net10.0→EF 10.0.9 —
         quindi il PackageReference sta qui, fuori dai gruppi condizionati, e non va duplicato.
         NON è Pomelo: Pomelo è fermo a EF Core 9 e su net10 non esiste (§0.1 del piano). -->
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Binario nativo di SQLite. EF Core 10 tira la 2.1.11, che è dentro il range di CVE-2025-6965
         (GHSA-2m69-gcr7-jv3q: SQLite < 3.50.2, corruzione di memoria) e fa fallire l'audit NuGet.
         La 2.1.12 è fuori dal range. Solo il .dll nativo: l'API gestita di bundle_e_sqlite3 non cambia.
         Rimuovere quando EF Core tirerà da sé una versione non vulnerabile.
         Vale per entrambi i TFM: EF Core 8 tira una 2.1.x ancora più vecchia. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
