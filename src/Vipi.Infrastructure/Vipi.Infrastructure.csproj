<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vipi.Application\Vipi.Application.csproj" />
    <ProjectReference Include="..\Vipi.Domain\Vipi.Domain.csproj" />
  </ItemGroup>

  <!-- ⚠️ LO STACK EF È UNO SOLO, EF Core 8, SU ENTRAMBI I TFM — ANCHE SU net10, ED È VOLUTO (L13, T-059, 13 settembre
       2026; ADR-0007 §D4-quater). Il database di produzione è MariaDB 11.4 (§D4-ter) e l'unico provider che la regge
       è Pomelo, che si ferma a EF Core 9 (9.0.0, agosto 2025) e non ha una build per EF Core 10: le PR della comunità
       sono aperte, il repository è fermo. Il provider Oracle, che EF 10 ce l'ha, scarta la collation di MariaDB
       proprio sulle colonne indicizzate. Quindi l'host va su net10 — runtime e ASP.NET Core supportati fino al 2028,
       che è il rischio vero di T-059 (OIDC, Kestrel, DataProtection) — e qui sotto resta EF 8 con Pomelo 8.0.3,
       lo stesso già verificato contro MariaDB vera. EF 9 non comprerebbe niente: EF 8 e EF 9 escono dal supporto
       lo STESSO giorno, il 10 novembre 2026, e cambiare versione vorrebbe dire rifare la prova delle migrazioni.
       Non passare a EF 10 finché non c'è un Pomelo 10: l'host non avrebbe più un provider per la produzione. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.*" />
  </ItemGroup>

  <!-- Ramo embedding (host Ivao.It, net8). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Binario nativo di SQLite. EF Core 10 tirava la 2.1.11, che è dentro il range di CVE-2025-6965
         (GHSA-2m69-gcr7-jv3q: SQLite < 3.50.2, corruzione di memoria) e fa fallire l'audit NuGet.
         La 2.1.12 è fuori dal range. Solo il .dll nativo: l'API gestita di bundle_e_sqlite3 non cambia.
         Rimuovere quando EF Core tirerà da sé una versione non vulnerabile.
         Vale per entrambi i TFM: EF Core 8 tira una 2.1.x ancora più vecchia. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- ⚠️ IL RID SI DICHIARA QUI, e non è cosmesi: senza, il `packages.lock.json` di questo progetto CAMBIA
         FORMA a seconda di chi lo restora. Un `dotnet build` normale (Windows, nessun RID) non produce la
         sezione `net8.0/linux-x64`, il publish del pacchetto la produce, e il file balla a ogni giro —
         mostrandosi modificato in git senza che nessuna dipendenza sia cambiata. Dichiarandolo, ogni restore
         risolve anche il grafo linux-x64 e il lock è lo stesso per tutti. La CI restora in «locked mode» e si
         fermerebbe su un lock di forma diversa da quella committata. -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ⚠️ Serve perché i servizi in background sono `internal` dal 7 settembre 2026 (revisione del
         6 settembre, R-009): `AddHostedService<T>` non chiede che siano pubblici — la registrazione avviene
         dentro questo assieme — ma `AtcPollingShutdownTests` ne COSTRUISCE uno a mano, ed è giusto che
         possa: quel test prova lo spegnimento, che è la cosa che in produzione perde dati.
         Stessa scelta già presa per Vipi.AuroraBridge.Core, Vipi.AuroraProfiles e Vipi.Host. -->
    <InternalsVisibleTo Include="Vipi.Infrastructure.Tests" />
  </ItemGroup>

</Project>
