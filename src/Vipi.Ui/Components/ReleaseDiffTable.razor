@* Tabella delle differenze di una release rispetto alla baseline. Condivisa da ReleasePanel (editor, un solo
   bersaglio) e da VersioniPage (admin, molti documenti): entrambe caricano il diff a richiesta e lo passano qui,
   quindi Diff nullo = caricamento in corso. *@
@inject IStringLocalizer<SharedResource> L

@if (Diff is null)
{
    <p class="help" style="margin:0">@L["Rel_LoadingDiff"]</p>
}
else
{
    <div class="muted" style="font-size:12px;margin-bottom:4px">@L["Rel_ComparedWith"] @BaselineLabel()</div>
    @if (Diff.Rows.Count == 0)
    {
        <p class="help" style="margin:0">@L["Rel_NoDiff"]</p>
    }
    else
    {
        <table class="cfg-table">
            <thead><tr><th>@L["Rel_ColItem"]</th><th>@L["Rel_ColChange"]</th><th>@L["Rel_ColDetail"]</th></tr></thead>
            <tbody>
                @foreach (var r in Diff.Rows)
                {
                    <tr>
                        <td>@r.Label</td>
                        <td><span class="pill @Pill(r.Change)">@ChangeLabel(r.Change)</span></td>
                        <td class="muted" style="font-size:12px">@Detail(r)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    /// <summary>Diff da mostrare. Null = ancora in caricamento (il chiamante lo risolve in modo asincrono).</summary>
    [Parameter] public ReleaseDiff? Diff { get; set; }

    // Il service consegna un enum e dei numeri (doc 13 §3k): tutto ciò che si legge lo compone la UI, quindi
    // segue la lingua della pagina — anche nel diff di una vLOA, che è un documento inglese.
    private static string Pill(ReleaseChangeKind change) => change switch
    {
        ReleaseChangeKind.Added => "green",
        ReleaseChangeKind.Removed => "grey",
        _ => "blue",
    };

    private string ChangeLabel(ReleaseChangeKind change) => change switch
    {
        ReleaseChangeKind.Added => L["Rel_ChangeAdded"],
        ReleaseChangeKind.Removed => L["Rel_ChangeRemoved"],
        _ => L["Rel_ChangeModified"],
    };

    private string Detail(ReleaseDiffRow r) => r.Change == ReleaseChangeKind.Modified
        ? string.Format(L["Rel_DiffItemsFromTo"].Value, r.PreviousCount, r.Count)
        : string.Format(L["Rel_DiffItems"].Value, r.Count ?? r.PreviousCount);

    private string BaselineLabel() => Diff!.BaselineCycle is { } cycle
        ? string.Format(L["Rel_BaselineCycle"].Value, cycle)
        : L["Rel_BaselineNone"];
}
