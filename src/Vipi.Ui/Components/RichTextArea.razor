@* Campo di testo markdown con la barra di formattazione: grassetto, corsivo, sottolineato, i due elenchi e il
   loro rientro (fino a cinque livelli, dal 16 settembre 2026). Il campo cresce col testo (`data-adatta`, in
   vipi-editor.js).
   È la PORTA SOLA dei campi di prosa dell'editor — paragrafo, callout, nota d'allegato, didascalia, intro
   VFR. Una barra scritta due volte diventerebbe due barre diverse al primo ritocco.

   ⚠️ La barra è SEMPRE nel DOM e si accende col fuoco in CSS (`:focus-within`), non in C#. Legarla a un
   `@onfocus`/`@onblur` sarebbe stato uno stato in più e un giro di rete a ogni entrata e uscita dal campo —
   su un editor con venti blocchi si vede. E soprattutto: una barra che compare farebbe crescere il blocco e
   scivolare in giù tutto quello sotto, esattamente il salto che `vipi-editor.js` già compensa a mano per la
   fisarmonica. Occupando lo spazio sempre, non c'è niente da compensare.

   ⚠️ Il secondo motivo per non spegnerla: il `blur` parte PRIMA del `click`. Una barra che sparisce sul blur
   sparirebbe mentre la clicchi. *@
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@* ⚠️ L'etichetta è un PARAMETRO e non un involucro lasciato al chiamante: dentro un `<label>` un click su
   un tasto della barra attiva l'etichetta, che rimanda il fuoco alla textarea — e nel rimandarlo azzera la
   selezione, cioè proprio la cosa che il tasto stava per formattare. Qui il legame si fa con `for`/`id`,
   che dà l'accessibilità senza l'effetto collaterale. *@
@if (!string.IsNullOrWhiteSpace(Label))
{
    <label class="app-lbl" for="@_id">@Label</label>
}
<div class="rta">
    <div class="rta-bar" role="toolbar" aria-label="@L["Rta_Toolbar"]">
        @Tasto("**", "**", L["Rta_Bold"].Value + " (Ctrl+B)", L["Rta_BoldLetter"].Value, "rta-b")
        @Tasto("*", "*", L["Rta_Italic"].Value + " (Ctrl+I)", L["Rta_ItalicLetter"].Value, "rta-i")
        @Tasto("__", "__", L["Rta_Underline"].Value + " (Ctrl+U)", L["Rta_UnderlineLetter"].Value, "rta-u")
        <span class="rta-sep" aria-hidden="true"></span>
        @TastoElenco(false, L["Rta_Bullets"].Value, "•")
        @TastoElenco(true, L["Rta_Numbers"].Value, "1)")
        @* Il rientro. ⚠️ Tasti E scorciatoia, non solo la scorciatoia: Tab dentro un campo non lo indovina
           nessuno, e su un tablet non c'è. E un tasto che non si vede non esiste (vedi l'aiuto sotto il campo
           dell'import tabelle). La scorciatoia sta nel titolo. *@
        @TastoRientro(-1, L["Rta_Outdent"].Value, "⇤")
        @TastoRientro(1, L["Rta_Indent"].Value, "⇥")
        @if (CitaSid)
        {
            <span class="rta-sep" aria-hidden="true"></span>
            @* §A73: una SID citata, col nome che segue la SID. Stesso `preventDefault` degli altri tasti: al clic il
               fuoco — e con lui la posizione del cursore — deve essere ancora nel campo. *@
            <button type="button" class="rta-btn rta-sid" title="@L["Rta_Sid"]" aria-label="@L["Rta_Sid"]"
                    aria-expanded="@(_sidAperto ? "true" : "false")"
                    @onmousedown:preventDefault="true" @onclick="ApriSid">@L["Sid_Btn"]</button>
        }
    </div>
    @if (_sidAperto)
    {
        <SidPicker IcaoIniziale="@IcaoDelDocumento" OnScegli="InserisciSid" OnChiudi="() => _sidAperto = false" />
    }
    @* `data-adatta`: il campo cresce col testo fino al 60% dello schermo, e la maniglia resta (vipi-editor.js). *@
    <textarea @ref="_ta" id="@_id" class="app-ta" rows="@Rows" value="@Value" placeholder="@Placeholder"
              data-adatta @onchange="Cambiato"></textarea>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Etichetta sopra il campo. Vuota = nessuna etichetta (il caso dei blocchi, che hanno già il
    /// loro titolo di sezione).</summary>
    [Parameter] public string? Label { get; set; }

    private ElementReference _ta;
    private readonly string _id = "rta-" + Guid.NewGuid().ToString("n")[..8];

    private Task Cambiato(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value as string ?? string.Empty);

    // ⚠️ `@onmousedown:preventDefault` NON è un dettaglio: senza, premere il tasto toglie il fuoco alla
    // textarea e il browser AZZERA la selezione. Quando il click arriva, `selectionStart` e `selectionEnd`
    // sono già collassati e il gesto formatterebbe il nulla. Il click scatta lo stesso: si annulla solo il
    // trasferimento del fuoco.
    private RenderFragment Tasto(string pre, string post, string titolo, string lettera, string cls) => __builder =>
    {
        <button type="button" class="rta-btn @cls" title="@titolo" aria-label="@titolo"
                @onmousedown:preventDefault="true" @onclick="() => Wrap(pre, post)">@lettera</button>
    };

    private RenderFragment TastoElenco(bool ordinato, string titolo, string segno) => __builder =>
    {
        <button type="button" class="rta-btn" title="@titolo" aria-label="@titolo"
                @onmousedown:preventDefault="true" @onclick="() => Lista(ordinato)">@segno</button>
    };

    private RenderFragment TastoRientro(int delta, string titolo, string segno) => __builder =>
    {
        <button type="button" class="rta-btn" title="@titolo" aria-label="@titolo"
                @onmousedown:preventDefault="true" @onclick="() => Rientro(delta)">@segno</button>
    };

    private Task Wrap(string pre, string post) => JS.InvokeVoidAsync("vipiMdWrap", _ta, pre, post).AsTask();

    private Task Lista(bool ordinato) => JS.InvokeVoidAsync("vipiMdList", _ta, ordinato).AsTask();

    // `vipiMdRientro` torna vero/falso (serve al Tab per decidere se tenersi il tasto): dal tasto non interessa.
    private Task Rientro(int delta) => JS.InvokeAsync<bool>("vipiMdRientro", _ta, delta).AsTask();

    /// <summary>Lo scalo del documento che si sta scrivendo, dall'editor che ne ha uno (§A73). Null = il
    /// selettore propone l'ultimo usato.</summary>
    [CascadingParameter(Name = "IcaoDelDocumento")] public string? IcaoDelDocumento { get; set; }

    /// <summary>
    /// Se offrire il tasto «SID». Falso dove il testo NON passa da un disegno che risolve i nomi: lì un riferimento
    /// resterebbe per sempre col nome di quando è stato scritto, e il tasto prometterebbe il contrario (l'intro VFR
    /// dell'APP, revisione del 18 settembre 2026).
    /// </summary>
    [Parameter] public bool CitaSid { get; set; } = true;

    private bool _sidAperto;

    /// <summary>Il gettone del campo segnato: ogni apertura ha il suo, così due selettori aperti non si scambiano il
    /// campo (vedi `vipiSidPrendi`).</summary>
    private string _gettone = "";

    // Il campo e la posizione del cursore si segnano ADESSO: aperto il selettore, il fuoco va nella sua ricerca.
    private async Task ApriSid()
    {
        if (_sidAperto) { _sidAperto = false; return; }
        _gettone = await JS.InvokeAsync<string>("vipiSidPrendi", _ta) ?? "";
        _sidAperto = _gettone.Length > 0;
    }

    private async Task InserisciSid(string riferimento)
    {
        _sidAperto = false;
        await JS.InvokeAsync<bool>("vipiSidInserisci", _gettone, riferimento);
    }
}
