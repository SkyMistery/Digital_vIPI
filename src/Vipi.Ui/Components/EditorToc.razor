@* Menu-sezioni laterale (TOC) CONDIVISO tra gli editor: aside.toc sticky, riusa lo stile del viewer.
   Proiezione dato-guidata di sezioni già in memoria (nessuna query DB). Vedi docs/feature/2026-07-29-toc-editor.md.
   Dal 26 agosto 2026 le voci-sezione si TRASCINANO per riordinare, se l'host passa OnReorder:
   docs/feature/2026-08-26-riordino-sezioni-trascinando.md. *@
@inject IStringLocalizer<SharedResource> L

@if (Items.Count > 0)
{
    <aside class="toc editor-toc-side @(Draggable ? "toc-drag" : null)" data-tour="toc">
        <p class="toc-h">@(HeaderLabel ?? L["Common_Navigation"])</p>
        @if (Draggable)
        {
            <p class="toc-drag-hint">@L["Toc_DragHint"]</p>
        }
        <ul>
            @{ string? lastGroup = null; }
            @foreach (var it in Items)
            {
                @if (it.GroupLabel is { Length: > 0 } g && !string.Equals(g, lastGroup, StringComparison.Ordinal))
                {
                    lastGroup = g;
                    <li class="toc-grp-li"><p class="toc-grp">@g</p></li>
                }
                <li>
                    @* ⚠️ `draggable` si scrive SEMPRE quando il riordino è acceso: un <a href> nasce
                       trascinabile per conto suo, e senza il "false" esplicito il pannello Release e i blocchi
                       ACC senza figli si lascerebbero prendere per poi non andare da nessuna parte.
                       Fuori dal riordino l'ancora resta quella di prima: nessun gestore di trascinamento
                       registrato sul circuito per gli editor che non riordinano (l'aeroporto).

                       ⚠️ Il `preventDefault` sul `dragover` — quello che rende la voce un bersaglio che
                       ACCETTA — NON sta qui: lo fa `wireTocDrop` in vipi-ui.js, dove c'è scritto perché.
                       Qui c'era scritto il modificatore `:preventDefault` su `ondragover` e non faceva
                       niente: Blazor ascolta un evento solo se qualcuno vi registra un GESTORE, e per
                       `dragover` non ce n'è. Il gesto partiva, illuminava la destinazione e spariva senza
                       drop. Sul `drop` qui sotto invece il modificatore funziona: il gestore c'è. *@
                    @if (Draggable)
                    {
                        <a class="lvl@(it.Level) @(IsDragging(it) ? "toc-dragging" : null) @(IsDropTarget(it) ? "toc-drop" : null)"
                           href="#@it.AnchorId"
                           draggable="@(CanDrag(it) ? "true" : "false")"
                           title="@(CanDrag(it) ? L["Toc_DragTitle"].Value : null)"
                           @ondragstart="() => DragStart(it)" @ondragend="DragEnd"
                           @ondragenter="() => DragEnter(it)" @ondragleave="() => DragLeave(it)"
                           @ondrop="() => Drop(it)" @ondrop:preventDefault="true">
                            @Label(it)
                        </a>
                    }
                    else
                    {
                        <a class="lvl@(it.Level)" href="#@it.AnchorId">@Label(it)</a>
                    }
                </li>
            }
        </ul>
        @if (Footer is not null)
        {
            <div class="toc-foot">@Footer</div>
        }
    </aside>
}

@code {
    private RenderFragment Label(EditorTocItem it) => __builder =>
    {
        @it.Label
        @if (it.Dirty) { <span class="dirt" title="@L["Ape_Unsaved"]"></span> }
    };

    /// <summary>Voci del menu (proiezione delle sezioni). Vuoto = nessun aside renderizzato.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<EditorTocItem> Items { get; set; } = System.Array.Empty<EditorTocItem>();

    /// <summary>Intestazione del pannello (default: "Navigazione" localizzato).</summary>
    [Parameter] public string? HeaderLabel { get; set; }

    /// <summary>Contenuto extra in fondo al TOC (es. pulsanti Espandi/Comprimi tutto).</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>
    /// Riordino per trascinamento: l'host lo passa SOLO quando il documento è in modifica (ed è suo il lock).
    /// Non passarlo lascia il TOC quello di prima — è così che l'editor aeroporto, che di sezioni-documento non
    /// ne ha, resta fuori senza una condizione dedicata.
    /// </summary>
    [Parameter] public EventCallback<TocReorder> OnReorder { get; set; }

    private bool Draggable => OnReorder.HasDelegate;

    private EditorTocItem? _dragged;
    private int? _overId;

    private bool CanDrag(EditorTocItem it) => Draggable && it.SectionId is not null;

    private bool IsDragging(EditorTocItem it) => _dragged is EditorTocItem m && it.SectionId == m.SectionId;

    private bool IsDropTarget(EditorTocItem it) => _overId is int o && it.SectionId == o;

    private void DragStart(EditorTocItem it)
    {
        if (!CanDrag(it)) return;
        _dragged = it;
        _overId = null;
    }

    private void DragEnd() { _dragged = null; _overId = null; }

    private void DragEnter(EditorTocItem it)
    {
        if (Accepts(it)) _overId = it.SectionId;
    }

    private void DragLeave(EditorTocItem it)
    {
        if (_overId == it.SectionId) _overId = null;
    }

    /// <summary>Bersaglio valido: lo dice <see cref="TocDropRules.Accetta"/>, che è dove stanno le regole —
    /// qui resta solo il pennello che illumina la voce.</summary>
    private bool Accepts(EditorTocItem it)
        => _dragged is EditorTocItem mossa && TocDropRules.Accetta(Items, mossa, it);

    private async Task Drop(EditorTocItem it)
    {
        var mossa = _dragged;
        DragEnd();
        if (mossa is not EditorTocItem v) return;

        // La traduzione del gesto in mossa sta in TocDropRules: riordino fra fratelli o cambio di padre.
        if (TocDropRules.Mossa(Items, v, it) is { } esito) await OnReorder.InvokeAsync(esito);
    }
}
