@* Barre: una colonna per mese. HTML e non SVG apposta — così l'etichetta resta testo vero (si cerca nella
   pagina, la legge un lettore di schermo, si stampa) e la barra è solo un'altezza in percentuale.

   ⚠️ L'altezza è relativa al MASSIMO della serie, non a un fondo scala inventato: un mese da 12 ore accanto
   a uno da 11 deve vedersi diverso di un dodicesimo, non del doppio. *@

<div class="bars" role="img" aria-label="@Titolo">
    @foreach (var b in Barre)
    {
        <div class="bar-col @(b.Highlight ? "on" : "")" title="@b.Title">
            <span class="bar-val">@(b.Value > 0 ? Formato(b.Value) : "")</span>
            <div class="bar-fill" style="height:@Altezza(b.Value)"></div>
            <span class="bar-lab">@b.Label</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StatsBar> Barre { get; set; } = Array.Empty<StatsBar>();

    [Parameter] public string Titolo { get; set; } = "";

    /// <summary>Come si scrive il numero sopra la barra. Di serie: un decimale.</summary>
    [Parameter] public Func<double, string> Formato { get; set; } = v => v.ToString("0.#");

    private double Massimo => Barre.Count == 0 ? 0 : Barre.Max(b => b.Value);

    // Il fondo è l'area della barra meno lo spazio del numero e dell'etichetta: 100% qui dentro sarebbe
    // il numero fuori dal riquadro.
    private string Altezza(double v) =>
        Massimo <= 0 ? "2px" : StatsView.Svg(Math.Max(2, v / Massimo * 82)) + "%";
}
