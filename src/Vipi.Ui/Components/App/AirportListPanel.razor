@* L'elenco degli aeroporti di una ACC: le schede — una voce per documento, vIPI e vSOP militare —, i filtri
   per categoria e il meteo che arriva dopo.

   ⚠️ È un'ISOLA interattiva (doc 14 §3g), come <LiveBadge> nella topbar, e sta dentro una pagina che è SSR
   statica. Il motivo è misurato: la vIPI d'aeroporto era l'unico dei quattro documenti pubblici a tenere un
   circuito aperto per OGNI lettore, perché elenco e documento condividono una rotta e una pagina ha un solo
   render mode.

   ⚠️ La carta diceva che per togliere quel circuito bisognava separare la rotta. Non è vero, e verificarlo
   ha evitato di toccare indirizzi pubblici che stanno nei preferiti di chi controlla: il render mode si
   dichiara sul COMPONENTE, quindi basta che le due parti interattive — questa e il selettore di pista delle
   SID — diventino isole, e la pagina torna statica con le sue URL intatte.

   ⚠️ Si carica da sé a partire dal solo codice ACC, e non riceve gli aeroporti come parametro. È la stessa
   scelta di <LiveBadge>, e qui ha una ragione in più: attraversare il confine SSR→interattivo vuol dire
   serializzare, e una lista di schede col meteo dentro sarebbe una serializzazione grossa per ogni lettore. *@
@rendermode InteractiveServer
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Application.Weather
@inject IOnlineAtcProvider Online
@inject Vipi.Application.Abstractions.IWeatherProvider Weather
@inject IStringLocalizer<SharedResource> L

@if (_aeroporti.Count == 0)
{
    <EmptyState Title="@L["Common_NoAirport"]">@L["Airport_NoneBody"]</EmptyState>
}
else
{
    @* I filtri per CATEGORIA (carta 2026-09-11-categorie-aeroporto.md), dal più civile al più militare, più
       «tutti». La barra c'è solo dove c'è qualcosa da filtrare: su una ACC di soli scali civili sarebbe un
       comando che non fa niente. Dentro, le quattro categorie ci sono SEMPRE — una a zero è spenta, e il suo
       zero scritto sul chip dice perché. *@
    @if (_aeroporti.Select(x => x.Scalo.Category).Distinct().Count() > 1)
    {
        <div class="struct-bar apt-filtri" style="margin-top:14px">
            <span class="sb-chips">
                <button class="sh-chip @(_filtro is null ? "on" : "")" aria-pressed="@(_filtro is null ? "true" : "false")"
                        @onclick="() => _filtro = null">@L["Airport_ChipAll", _aeroporti.Count]</button>
                @foreach (var c in AeroportiDellAcc.OrdineDelleCategorie)
                {
                    var quanti = _aeroporti.Count(x => x.Scalo.Category == c);
                    <button class="sh-chip @(_filtro == c ? "on" : "")" aria-pressed="@(_filtro == c ? "true" : "false")"
                            disabled="@(quanti == 0)" title="@L[AirportCategoryText.TitleKey(c)]"
                            @onclick="() => Commuta(c)">@L[AirportCategoryText.Key(c)] @quanti</button>
                }
            </span>
        </div>
    }
    <div class="choice-grid" style="margin-top:14px">
        @foreach (var voce in Mostrati())
        {
            var ap = voce.Scalo;
            var n = OnlineSu(ap.Icao);
            @* ⚠️ Con DUE documenti la scheda non è più un link unico: un <a> dentro un <a> non è HTML valido, e
               il browser lo spezza da sé. Diventa un riquadro con due voci, una per documento. Con un documento
               solo resta tutta cliccabile, com'era. *@
            @if (voce.HaVipi && voce.HaVsop)
            {
                <div class="choice apt-card apt-two">
                    @Corpo(voce, n)
                    <div class="apt-docs">
                        <a class="btn ghost" href="@voce.VipiHref(Acc)"><Icon Name="plane" Size="13" /> @L["Mil_LinkToCivil"]</a>
                        <a class="btn ghost mil" href="@voce.VsopHref(Acc)"><Icon Name="shield" Size="13" /> @L["Mil_LinkFromCivil"]</a>
                    </div>
                </div>
            }
            else
            {
                <a class="choice apt-card" href="@voce.Href(Acc)">
                    @Corpo(voce, n)
                </a>
            }
        }
    </div>
}

@code {
    /// <summary>Il contenuto comune alle due forme di scheda: ICAO, stato online, nome, categoria e meteo.</summary>
    private RenderFragment Corpo(AeroportoInElenco voce, int n) => __builder =>
    {
        var ap = voce.Scalo;
        <div class="apt-top">
            <h2 class="h-card">@ap.Icao</h2>
            <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? L["Common_OnlineN", n] : L["Common_Offline"])</span>
        </div>
        <p class="muted">@ap.Name</p>
        @* ⚠️ Nell'ELENCO la categoria compare solo sui campi con presenza militare: «Civile» su sessanta
           schede sarebbe rumore. È nei DOCUMENTI che la categoria c'è sempre, anche «Civile» (carta
           2026-09-11-categorie-aeroporto.md). *@
        @if (ap.HasMilitaryPresence)
        {
            <p class="apt-mil"><MilitaryTag Category="ap.Category" /></p>
        }
        @if (_meteo.TryGetValue(ap.Icao, out var wx))
        {
            <div class="apt-wx">
                <span><span class="wx-k">@L["Airport_Wind"]</span><b>@(string.IsNullOrWhiteSpace(wx.Wind) ? "—" : wx.Wind)</b></span>
                <span><span class="wx-k">QNH</span><b>@(wx.Qnh is int q ? $"{q}" : "—")</b></span>
                @if (!string.IsNullOrEmpty(wx.Dep) || !string.IsNullOrEmpty(wx.Arr))
                {
                    <span><span class="wx-k">@L["Airport_Departures"]</span><b>@(wx.Dep ?? "—")</b></span>
                    <span><span class="wx-k">@L["Airport_Arrivals"]</span><b>@(wx.Arr ?? "—")</b></span>
                }
            </div>
        }
        else if (_meteoInArrivo)
        {
            <div class="apt-wx loading"><span class="muted" style="font-size:12.5px">@L["Airport_WxLoading"]</span></div>
        }
    };
}

@code {
    /// <summary>Il codice della ACC di cui elencare gli aeroporti.</summary>
    [Parameter, EditorRequired] public string Acc { get; set; } = default!;

    /// <summary>La categoria mostrata; <c>null</c> = tutte.</summary>
    private AirportCategory? _filtro;

    private IReadOnlyList<AeroportoInElenco> _aeroporti = Array.Empty<AeroportoInElenco>();
    // ⚠️ Piste e regole, NON il profilo intero. Fino al 27 agosto 2026 qui c'era una AirportData per
    // aeroporto, caricata una alla volta: otto query a testa (livelli di transizione, SID, link-frequenze…)
    // per leggerne due liste. Contate: 36 query per un elenco di TRE righe.
    private IReadOnlyDictionary<string, PisteDiAeroporto> _piste =
        new Dictionary<string, PisteDiAeroporto>(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, (string? Wind, int? Qnh, string? Dep, string? Arr)> _meteo = new(StringComparer.OrdinalIgnoreCase);
    private bool _meteoInArrivo;
    private string? _caricato;

    // Dallo scope DI proprio: il contesto è isolato dal circuito (stessa regola dei sei componenti dopo
    // l'audit del 30 luglio 2026).
    private IStructureEditingService _struttura = default!;
    private IDocumentAdminService _documenti = default!;
    private IAirportEditingService _profilo = default!;

    protected override void OnInitialized()
    {
        _struttura = ScopedServices.GetRequiredService<IStructureEditingService>();
        _documenti = ScopedServices.GetRequiredService<IDocumentAdminService>();
        _profilo = ScopedServices.GetRequiredService<IAirportEditingService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        var acc = (Acc ?? "").Trim().ToUpperInvariant();
        if (acc.Length == 0 || acc == _caricato) return;
        _caricato = acc;

        var data = await _struttura.LoadAsync(acc);
        // Gli scali con almeno un documento pubblico, vIPI o vSOP militare: la regola sta in AeroportiDellAcc,
        // la stessa che conta gli aeroporti nella landing dell'ACC.
        _aeroporti = data is null
            ? Array.Empty<AeroportoInElenco>()
            : AeroportiDellAcc.Elenco(data.Airports, await _documenti.ListAsync(), acc);

        // Piste e regole di TUTTI gli scali in una volta: servono alla pista consigliata. Il METAR (HTTP,
        // lento) NON si aspetta qui — la lista si disegna subito e il meteo arriva dopo. È la ragione per
        // cui questa è un'isola.
        _piste = await _profilo.ListRunwayDataAsync(_aeroporti.Select(x => x.Scalo.Icao).ToList());

        _meteo.Clear();
        _meteoInArrivo = _aeroporti.Count > 0;
        if (_meteoInArrivo) _ = CaricaMeteoAsync(acc);
    }

    private IEnumerable<AeroportoInElenco> Mostrati() =>
        _filtro is { } c ? _aeroporti.Where(x => x.Scalo.Category == c) : _aeroporti;

    /// <summary>Ricliccato torna a «tutti», come i chip della pagina Aeroporti.</summary>
    private void Commuta(AirportCategory c) => _filtro = _filtro == c ? null : c;

    /// <summary>Gli ATC su quello scalo, ATIS escluso: un ATIS acceso non è una posizione presidiata.</summary>
    private int OnlineSu(string icao) => Online.GetCurrent().Callsigns.Count(cs =>
        cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase)
        && !cs.EndsWith("_ATIS", StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Il meteo di tutti gli scali, in parallelo, fuori dal percorso di render.
    /// ⚠️ Il controllo sull'ACC alla fine è un token anti-corsa: chi cambia ACC mentre questi HTTP sono in
    /// volo non deve vedersi arrivare il meteo di quella di prima.
    /// </summary>
    private async Task CaricaMeteoAsync(string acc)
    {
        var esiti = await Task.WhenAll(_aeroporti.Select(x => x.Scalo.Icao).Select(async icao =>
        {
            try
            {
                var wx = await Weather.GetAsync(icao);
                var m = string.IsNullOrWhiteSpace(wx?.Metar) ? null : MetarParser.ParseMetar(wx!.Metar!);
                return (icao, Metar: m);
            }
            catch { return (icao, Metar: (ParsedMetar?)null); }
        }));

        if (acc != _caricato) return;
        foreach (var (icao, m) in esiti)
            if (m is not null)
            {
                var (dep, arr) = PisteConsigliate(icao, m);
                _meteo[icao] = (m.Wind?.Label, m.QnhHpa, dep, arr);
            }
        _meteoInArrivo = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Piste consigliate dal profilo: le regole se ci sono, altrimenti il miglior vento di testa.</summary>
    private (string? Dep, string? Arr) PisteConsigliate(string icao, ParsedMetar m)
    {
        var profilo = _piste.GetValueOrDefault(icao);
        int? dir = m.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        var kt = m.Wind?.SpeedKt ?? 0;

        if (profilo is { Rules.Count: > 0 })
        {
            var bagnata = m.HasRain || m.HasSnow;
            var vincente = RunwaySuggestion.EvaluateRules(
                profilo.Rules.Select(AirportViewFormat.MapRule).ToList(), dir, kt, bagnata, DateTime.UtcNow);
            if (vincente is not null) return (Norm(vincente.Dep), Norm(vincente.Arr));
        }

        var piste = profilo?.Runways.Select(r => r.Ident).ToList() ?? new List<string>();
        if (piste.Count > 0)
        {
            var s = RunwaySuggestion.Suggest(piste, dir, kt);
            if (s.Best is not null) return (Norm(s.DepIdent ?? s.Best.Ident), Norm(s.ArrIdent ?? s.Best.Ident));
        }
        return (null, null);
    }

    private static string? Norm(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
}
