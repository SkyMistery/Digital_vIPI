@* L'editor di una tabella a colonne fisse: si aggiungono righe, si spostano, si tolgono, e le celle si
   scrivono. Colonne dal profilo (carta §12g).

   ⚠️ Si salva a ogni cella lasciata (`@onchange`, non `@oninput`): un salvataggio per tasto premuto
   attraverserebbe il circuito Blazor a ogni lettera, e su una tabella di dieci righe si vede.

   ⚠️ Il contenuto sta tutto nel documento: qui non si scrive in nessun catalogo condiviso, e infatti non c'è
   nessun avviso da dare — a differenza delle Radioassistenze, dove quel che si scrive cambia gli altri SOP. *@
@using Vipi.Application.Import
@inject IStringLocalizer<SharedResource> L

@* ⚠️ `milt-free` e non `cfg-table`: qui le colonne le decide il PROFILO — tre per i nominativi, tre
   per i parcheggi, domani un'altra tabella con cinque — e larghezze cablate su quattro colonne sarebbero
   sbagliate per costruzione. *@
<table class="res-table mil-table milt-free">
    <thead>
        <tr>
            @if (Editing) { <th class="c-move"></th> }
            @foreach (var c in Colonne) { <th>@c</th> }
            @if (Editing) { <th class="c-act"></th> }
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Righe.Count; i++)
        {
            var idx = i;
            <tr>
                @if (Editing)
                {
                    <td class="c-move">
                        <button type="button" class="btn ghost" disabled="@(idx == 0)"
                                title="@L["Common_Up"]" @onclick="() => OnMove.InvokeAsync((idx, -1))">↑</button>
                        <button type="button" class="btn ghost" disabled="@(idx == Righe.Count - 1)"
                                title="@L["Common_Down"]" @onclick="() => OnMove.InvokeAsync((idx, 1))">↓</button>
                    </td>
                }
                @for (var j = 0; j < Colonne.Count; j++)
                {
                    var col = j;
                    <td>
                        @if (Editing)
                        {
                            <input value="@Cella(idx, col)" aria-label="@Colonne[col]"
                                   @onchange="e => OnSet.InvokeAsync((idx, col, e.Value?.ToString() ?? string.Empty))" />
                        }
                        else { @(Cella(idx, col) is { Length: > 0 } v ? v : "—") }
                    </td>
                }
                @if (Editing)
                {
                    <td class="c-act">
                        <button type="button" class="btn ghost" title="@L["Common_Delete"]"
                                @onclick="() => OnRemove.InvokeAsync(idx)">✕</button>
                    </td>
                }
            </tr>
        }
        @if (Righe.Count == 0)
        {
            <tr><td colspan="@(Colonne.Count + (Editing ? 2 : 0))" class="muted">@(Vuoto ?? L["Mil_TableEmpty"].Value)</td></tr>
        }
    </tbody>
</table>

@if (Editing)
{
    <div class="mil-add">
        <button type="button" class="btn primary" @onclick="() => OnAdd.InvokeAsync()">+ @L["Mil_TableAddRow"]</button>
        @* ⚠️ Il tasto c'e' solo se qualcuno ascolta: una tabella a colonne fisse che non sa dove mettere le
           righe importate mostrerebbe un tasto che non fa niente. *@
        @if (OnImporta.HasDelegate)
        {
            <button type="button" class="btn ghost" @onclick="() => _import = !_import">
                ⤓ @L["Imp_Open"]
            </button>
        }
        <EsportaCsv Nome="@Chiave" Colonne="Colonne" Righe="Righe" />
    </div>

    @if (_import)
    {
        <ImportaTabella Spec="@Spec" Sorgenti="@Sorgenti" CaricaSorgente="@CaricaSorgente" OnImporta="Importa"
                        OnAnnulla="() => { _import = false; return Task.CompletedTask; }" />
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Colonne { get; set; } = Array.Empty<string>();
    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyList<string>> Righe { get; set; } = Array.Empty<IReadOnlyList<string>>();
    [Parameter] public bool Editing { get; set; }
    [Parameter] public string? Vuoto { get; set; }

    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<int> OnRemove { get; set; }
    [Parameter] public EventCallback<(int Indice, int Delta)> OnMove { get; set; }

    /// <summary>Scrive UNA cella: riga, colonna, testo.</summary>
    [Parameter] public EventCallback<(int Riga, int Colonna, string Testo)> OnSet { get; set; }

    /// <summary>
    /// La tabella <b>intera</b> dopo l'import: le righe di prima piu' quelle importate, o solo quelle
    /// importate se si e' scelto «sostituisci». Non impostato = niente tasto d'import.
    /// <para>⚠️ Esce la tabella intera e non «le righe nuove piu' un flag»: chi salva scrive sempre tutte le
    /// righe (e' il modello di questo payload), e fargli rifare la fusione qui sarebbe la stessa decisione
    /// presa due volte.</para>
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<IReadOnlyList<string>>> OnImporta { get; set; }

    /// <summary>La chiave della tabella, per la specifica d'import (<c>callsigns</c>, <c>parkings</c>).</summary>
    [Parameter] public string Chiave { get; set; } = "fixed";

    /// <summary>Gli altri documenti da cui si puo' prendere questa stessa tabella.</summary>
    [Parameter] public IReadOnlyList<SorgenteTabella>? Sorgenti { get; set; }

    /// <summary>Come si legge quella tabella dal documento scelto.</summary>
    [Parameter] public Func<string, Task<Griglia>>? CaricaSorgente { get; set; }

    private bool _import;

    /// <summary>
    /// La specifica si costruisce dalle COLONNE CORRENTI, che sono gia' nella lingua del documento: sono
    /// anche i nomi con cui si riconosce l'intestazione incollata.
    /// </summary>
    private SpecImport Spec => SpecImport.ColonneFisse(Chiave, Colonne);

    private Task Importa(RichiestaImport r)
    {
        _import = false;
        var righe = r.Proposta.Buone
            .Select(x => (IReadOnlyList<string>)x.Celle.Select(c => c.Valore).ToList())
            .ToList();
        var tutte = r.Sostituisci ? righe : Righe.Concat(righe).ToList();
        return OnImporta.InvokeAsync(tutte);
    }

    private string Cella(int r, int c) => r < Righe.Count && c < Righe[r].Count ? Righe[r][c] : "";
}
