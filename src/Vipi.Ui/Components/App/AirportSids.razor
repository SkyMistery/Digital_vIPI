@* Sezione «SID»: il merge fra le righe editoriali e quelle importate dal sectorfile, già filtrato per ciclo
   AIRAC e ordinato per punto. Il filtro per pista è una scelta di LETTURA, non del documento: chi guarda vuole
   le SID della pista in uso, e la sceglie qui. *@
@* ⚠️ ISOLA INTERATTIVA (doc 14 §3g). Il selettore di pista è l'unico comando del DOCUMENTO d'aeroporto, e
   per servirlo l'intera pagina era `InteractiveServer`: un circuito aperto per ogni lettore, l'unico dei
   quattro documenti pubblici a farlo. Da qui in poi il circuito lo apre solo chi arriva a questa sezione.

   ⚠️ I parametri attraversano il confine SSR→interattivo, quindi devono SERIALIZZARE: per questo le piste in
   uso arrivano come array e non come HashSet. Il tipo `AirportSidView` è un record di stringhe, e passa. *@
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResource> L

@if (View.Rows.Count > 0)
{
    @if (Runways.Count > 1)
    {
        <div class="cfg-sel" style="margin:0 0 12px">
            <span class="cfg-sel-lab">@L["Airport_Runway"]</span>
            @foreach (var rw in Runways)
            {
                var pista = rw;
                <button type="button" class="cfg-btn @(string.Equals(_scelta, pista, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                        @onclick="() => _scelta = pista">
                    @pista @if (DepIdents.Contains(pista, StringComparer.OrdinalIgnoreCase)) { <span title="@L["Airport_RwyInUse"]">🛫</span> }
                </button>
            }
        </div>
    }
    <div style="overflow:auto">
    @* Larghezze di colonna cablate in CSS (.sid-view): con table-layout:auto la tabella si ridisegnava a ogni
       cambio pista, perché le colonne quasi vuote (Condition tutta «—» su una pista, piena sull'altra) si
       afflosciavano e le altre si allargavano. *@
    <table class="res-table sid-table sid-view">
        <thead><tr><th class="col-rwy">@L["Airport_RunwayAbbr"]</th><th class="col-fix">FIX</th><th class="col-sid">SID</th><th class="col-trans">Transition</th><th class="col-climb">Initial climb</th><th class="col-type">Type</th><th class="col-cat">Cat.</th><th class="col-wtc">WTC</th><th class="col-cond">Condition</th></tr></thead>
        <tbody>
            @foreach (var r in Shown())
            {
                <tr><td class="col-rwy">@r.Runway</td><td class="col-fix">@r.Fix</td><td class="col-sid">@r.Name</td><td class="col-trans">@r.Transition</td><td class="col-climb">@AirportViewFormat.InitialClimb(r.InitialClimb, TransitionAltitudeFt)</td><td class="col-type">@r.Type</td><td class="col-cat">@r.Cat</td><td class="col-wtc">@r.Wtc</td><td class="col-cond">@r.Condition</td></tr>
            }
        </tbody>
    </table>
    </div>
}
else
{
    <div class="callout info"><span class="cic"><Icon Name="refresh" Size="18" /></span><div><p class="ct">@L["Airport_NoSidsTitle"]</p>@L["Airport_NoSidsBody"]</div></div>
}

@code {
    [Parameter, EditorRequired] public AirportSidView View { get; set; } = AirportSidView.Empty;

    /// <summary>Pista da cui partire: la pista in uso in partenza, che il documento conosce e l'isola no.
    /// È un SEME, non uno stato condiviso — da qui in avanti la scelta è di questo componente.
    ///
    /// ⚠️ **Prima era `Selected` + `SelectedChanged`, e le chip non funzionavano.** Lo stato viveva nella
    /// pagina, che dal doc 14 è **SSR statica**: il clic arrivava al server (visto sul WebSocket) e tornava
    /// pure un `RenderBatch`, ma il gestore aggiornava un campo di una pagina che **non si ridisegna mai
    /// più**, e questa isola si riceveva indietro il valore congelato nel descrittore. Nessun errore, da
    /// nessuna parte: le chip si limitavano a non fare niente.
    ///
    /// *Uno stato che cambia deve vivere dentro l'isola che lo cambia*: un genitore statico può solo
    /// seminarlo.</summary>
    [Parameter] public string? InitialRunway { get; set; }

    /// <summary>Piste in partenza adesso: marcano il chip della pista in uso. Dato LIVE.
    /// ⚠️ Un array e non un HashSet: attraversa il confine SSR→interattivo e dev'essere serializzabile.</summary>
    [Parameter] public string[] DepIdents { get; set; } = Array.Empty<string>();

    /// <summary>TA dello scalo: serve a rendere l'initial climb come quota o come livello.</summary>
    [Parameter] public int? TransitionAltitudeFt { get; set; }

    /// <summary>Piste distinte presenti nelle SID pubblicate (escluso "—"/vuoto), ordinate.</summary>
    public IReadOnlyList<string> Runways => RunwaysOf(View);

    public static IReadOnlyList<string> RunwaysOf(AirportSidView view) => view.Rows
        .Select(r => r.Runway)
        .Where(x => !string.IsNullOrWhiteSpace(x) && x != "—")
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    /// <summary>Pista scelta ADESSO. Nasce dal seme e poi è solo di questo componente.</summary>
    private string? _scelta;
    private bool _seminata;

    /// <summary>⚠️ Il seme si prende UNA VOLTA. Riprenderlo a ogni giro di parametri riporterebbe la scelta
    /// del lettore alla pista in uso ogni volta che il genitore ridisegna — che è il difetto di prima
    /// scritto al contrario.</summary>
    protected override void OnParametersSet()
    {
        if (_seminata) return;
        _scelta = InitialRunway;
        _seminata = true;
    }

    /// <summary>SID da mostrare: quelle della pista scelta più quelle senza pista, valide per tutte.</summary>
    private IEnumerable<AirportSidRowView> Shown() => View.Rows
        .Where(r => _scelta is null
            || string.Equals(r.Runway, _scelta, StringComparison.OrdinalIgnoreCase)
            || string.IsNullOrWhiteSpace(r.Runway) || r.Runway == "—");
}
