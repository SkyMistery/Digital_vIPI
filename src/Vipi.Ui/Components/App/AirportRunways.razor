@* Sezione «Piste». La tabella può venire da uno snapshot di release; l'evidenza della pista in uso no — quella
   è live e arriva da fuori (`DepIdents`/`ArrIdents`, calcolate dal vento del METAR e dalle regole piste).
   Sono due cose diverse e vanno tenute separate: la pista in uso adesso non è un dato di ciclo AIRAC. *@
@inject IStringLocalizer<SharedResource> L

@if (Legend)
{
    <p class="muted" style="font-size:12.5px;margin:0 0 8px">
        @* Lo spazio è scritto come entità: Razor scarta il testo di sola spaziatura che precede un blocco di
           codice (anche dentro <text>), e usciva «consigliatidal vento METAR». *@
        @((MarkupString)L["Airport_RwyLegend"].Value)@if (MostraProvenienza)
        {
            <text>&#32;</text>
            @(RuleName is not null ? string.Format(L["Airport_RwyByRule"], RuleName) : L["Airport_RwyByWind"].Value)
        }@* ⚠️ Il punto è marcatura NUDA, non un <text>: fuori da un blocco di codice `<text>` non è un
             comando di Razor ma un elemento HTML sconosciuto, e finisce nel DOM alla lettera. Visto nel
             prerender di LIBD il 4 settembre 2026 — a schermo si leggeva giusto, nel documento no. *@.
        @* Il vento si legge col carattere della TABELLA — stesso corpo, stesso inchiostro, stesso peso del
           numero di pista — e non col grigio della legenda: è un dato, non una didascalia, ed è il dato che
           chi apre la pagina cerca per primo. *@
        @if (WindDir is int wd)
        {
            <text>&#32;</text><span class="rwy-wind">@string.Format(L["Airport_WindVal"], wd, WindKt)</span>
        }
        @if (HasRain) { <span class="pill">🌧️ @L["Airport_Rain"]</span> }
        @if (HasSnow) { <span class="pill">❄️ @L["Airport_Snow"]</span> }
        @if (MostraProvenienza && RuleNote is not null) { <span class="pill" style="background:var(--tint-yellow-soft);color:var(--warn-ink)">@RuleNote</span> }
    </p>
}
<table class="rwy-table">
    <thead><tr><th>@L["Airport_Runway"]</th><th>@L["Airport_Use"]</th><th>@L["Airport_LengthM"]</th><th>TORA</th><th>LDA</th><th>APP procedures</th><th>Patterns</th><th>Circling</th></tr></thead>
    <tbody>
        @foreach (var r in View.Rows)
        {
            var dep = DepIdents.Contains(r.Ident.Trim());
            var arr = ArrIdents.Contains(r.Ident.Trim());
            <tr class="@RwyRowClass(dep, arr)">
                <td><b>@r.Ident</b></td>
                <td style="white-space:nowrap;font-size:15px">
                    @if (dep) { <span title="@L["Airport_RwyDepTip"]">🛫</span> }
                    @if (arr) { <span title="@L["Airport_RwyArrTip"]">🛬</span> }
                    @if (!dep && !arr) { <span class="muted" style="font-size:12px">—</span> }
                </td>
                <td>@(r.LengthM?.ToString() ?? "—")</td>
                <td>@r.Tora</td>
                <td>@r.Lda</td>
                <td>@r.AppProcedures</td>
                <td>@r.Patterns</td>
                <td>@r.Circling</td>
            </tr>
        }
        @if (View.Rows.Count == 0)
        {
            <tr><td colspan="8" class="muted">@L["Airport_NoRunways"]</td></tr>
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public AirportRunwaysView View { get; set; } = AirportRunwaysView.Empty;

    /// <summary>Piste in uso adesso, in partenza e in arrivo: dato LIVE, non di release.</summary>
    [Parameter] public HashSet<string> DepIdents { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    [Parameter] public HashSet<string> ArrIdents { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Mostra la riga che spiega da dove viene la pista consigliata. Fuori dalla vista pubblica non serve.</summary>
    [Parameter] public bool Legend { get; set; } = true;

    /// <summary>
    /// Se dire <b>da dove</b> viene la pista consigliata: «by the active rule «#2»» / «from the METAR wind», e la
    /// nota della regola. Il vento e i colori si vedono comunque.
    ///
    /// <para>⚠️ La meccanica delle regole è roba da staff (decisione del committente, 4 settembre 2026): a chi
    /// legge la vIPI serve sapere quali piste sono in uso e con che vento, non quale delle nove regole sta
    /// vincendo — un numero che senza la tabella delle regole non vuol dire niente.</para>
    ///
    /// <para>⚠️ Il valore predefinito è <b>falso</b>, come ogni cancello del prodotto: chi la vuole aperta lo
    /// scrive. Il contrario è il modo in cui un dettaglio riservato ricompare in una pagina nuova senza che
    /// nessuno l'abbia deciso.</para>
    /// </summary>
    [Parameter] public bool MostraProvenienza { get; set; }
    [Parameter] public string? RuleName { get; set; }
    [Parameter] public string? RuleNote { get; set; }
    [Parameter] public int? WindDir { get; set; }
    [Parameter] public int WindKt { get; set; }
    [Parameter] public bool HasRain { get; set; }
    [Parameter] public bool HasSnow { get; set; }

    private static string RwyRowClass(bool dep, bool arr) =>
        dep && arr ? "rwy-both" : arr ? "rwy-arr" : dep ? "rwy-dep" : "";
}
