@* Sezione Frequenze (derivata): ATIS·DEL·GND·TWR·APP(★) dal sottoalbero + link extra. In editor: riordino per riga + rimozione link.
   Con GroupOf (Aerovia ACC): colonna "Settore unico" con rowspan che accorpa le CTR per ramo dell'albero (#5). *@
@inject IStringLocalizer<SharedResource> L
@{
    var rowsList = Rows as IReadOnlyList<AppFreqRow> ?? Rows.ToList();
    var grouped = GroupOf is not null;
    // Per ogni riga: etichetta ramo + se è la prima del gruppo + span (0 se non prima). I gruppi sono già consecutivi (righe pre-ordinate).
    var gLabel = new string?[rowsList.Count];
    var gFirst = new bool[rowsList.Count];
    var gSpan = new int[rowsList.Count];
    if (grouped)
    {
        var i = 0;
        while (i < rowsList.Count)
        {
            var lbl = GroupOf!(rowsList[i]);
            var j = i;
            while (j < rowsList.Count && string.Equals(GroupOf!(rowsList[j]), lbl, StringComparison.Ordinal)) j++;
            gLabel[i] = lbl; gFirst[i] = true; gSpan[i] = j - i;
            for (var k = i + 1; k < j; k++) { gLabel[k] = lbl; gFirst[k] = false; }
            i = j;
        }
    }
    var cols = (grouped ? 1 : 0) + 3 + (Editing || RowActions is not null ? 1 : 0);
}
<table class="@(grouped ? "cfg-table" : null)">
    <thead>
        <tr>
            @if (grouped) { <th>@L["AppFreq_UniSector"]</th> }
            <th>@L["AppFreq_Callsign"]</th><th>@L["AppFreq_Position"]</th><th>@L["Airport_Frequency"]</th>
            @if (Editing) { <th style="width:120px">@L["Common_Order"]</th> }
            else if (RowActions is not null) { <th style="width:104px"></th> }
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < rowsList.Count; i++)
        {
            var idx = i;
            var row = rowsList[idx];
            <tr class="@(row.IsPrimary ? "freq-table primary" : null) @(Editing && DragIndex == idx ? "app-sec-drag" : null) @(grouped && gFirst[idx] ? "grp-start" : null)"
                style="@(IsDimmed?.Invoke(row) == true ? "opacity:.45" : null)"
                @ondragover:preventDefault="Editing" @ondragenter="() => OnDragEnter.InvokeAsync(idx)"
                @ondrop="OnDrop" @ondragend="OnDragEnd">
                @if (grouped && gFirst[idx])
                {
                    <td class="uni" rowspan="@gSpan[idx]">@(string.IsNullOrWhiteSpace(gLabel[idx]) ? "—" : gLabel[idx])</td>
                }
                <td>
                    @if (Editing)
                    {
                        <span class="app-drag" title="@L["Common_DragReorder"]" draggable="true" @ondragstart="() => OnDragStart.InvokeAsync(idx)">⠿</span>
                    }
                    @row.Name @if (row.IsLink) { <Icon Name="link" /> }
                </td>
                <td>@row.Callsign</td>
                <td>@row.FrequencyMhz @(row.IsPrimary ? (MarkupString)"<span class=\"freq-key\">★</span>" : (MarkupString)"")</td>
                @if (!Editing && RowActions is not null)
                {
                    <td>@RowActions(row)</td>
                }
                @if (Editing)
                {
                    <td>
                        <button class="btn ghost" disabled="@(idx == 0)" title="@L["Common_Up"]" @onclick="() => OnMove.InvokeAsync((idx, -1))">↑</button>
                        <button class="btn ghost" disabled="@(idx == rowsList.Count - 1)" title="@L["Common_Down"]" @onclick="() => OnMove.InvokeAsync((idx, 1))">↓</button>
                        @if (row.IsLink && row.SourceSectorId is int sid)
                        {
                            <button class="btn ghost" title="@L["Common_RemoveLink"]" @onclick="() => OnRemoveLink.InvokeAsync(sid)">✕</button>
                        }
                    </td>
                }
            </tr>
        }
        @if (rowsList.Count == 0)
        {
            <tr><td colspan="@cols" class="muted">@L["AppFreq_NoneInSubtree"]</td></tr>
        }
    </tbody>
</table>
@* La spiegazione di come si riordina sta nel «?» della riga-titolo della sezione (DocumentSectionsEditor):
   stesso testo, stessa chiave (AppFreq_EditHelp), ma non piu' tre righe fisse per ogni blocco. *@

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppFreqRow> Rows { get; set; } = Array.Empty<AppFreqRow>();
    [Parameter] public bool Editing { get; set; }
    [Parameter] public EventCallback<(int Index, int Dir)> OnMove { get; set; }
    [Parameter] public EventCallback<int> OnRemoveLink { get; set; }

    // Accorpamento per ramo (Aerovia ACC): callsign → nome ramo. null = nessun raggruppamento.
    [Parameter] public Func<AppFreqRow, string?>? GroupOf { get; set; }

    /// <summary>Righe da mostrare in trasparenza invece che nascondere: la vLOA in editing fa vedere anche le
    /// frequenze escluse dal documento, per poterle riaccendere. Null = nessuna riga attenuata.</summary>
    [Parameter] public Func<AppFreqRow, bool>? IsDimmed { get; set; }

    /// <summary>Colonna di azioni per riga, fuori dal riordino (la vLOA ci mette «mostra/nascondi»). Null = niente
    /// colonna. Doc 13 §3l: la vLOA aveva una tabella tutta sua, che è tornata a divergere appena l'hanno toccata.</summary>
    [Parameter] public RenderFragment<AppFreqRow>? RowActions { get; set; }

    // Drag-and-drop riordino (maniglia ⠿): il container/pagina possiede lo stato _freqDragIndex.
    [Parameter] public int? DragIndex { get; set; }
    [Parameter] public EventCallback<int> OnDragStart { get; set; }
    [Parameter] public EventCallback<int> OnDragEnter { get; set; }
    [Parameter] public EventCallback OnDrop { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }
}
