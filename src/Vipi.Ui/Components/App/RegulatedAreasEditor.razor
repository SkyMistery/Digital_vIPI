@* Editor della sezione «Aree regolamentate»: aree dell'ACC di appartenenza + aree di altri ACC (extra).
   Condiviso fra la vIPI ACC (blocchi Aerovia/gruppi APP) e la vIPI APP non remotizzata.
   `AllowAuto` accende il modo automatico «tutte le aree dell'ACC» (solo blocco Aerovia): senza, non esistono aree
   di default e si scelgono tutte a mano. `ShowExtra` mostra il pannello delle aree di altri ACC.
   Il componente non salva: emette la selezione completa e l'host la persiste. *@
@inject IStringLocalizer<SharedResource> L

@{
    var ownIds = EffectiveOwnIds();
}

@* --- Aree del proprio ACC --- *@
<div class="block" style="border-style:dashed">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px">
        <p class="app-lbl" style="margin:0">@L["Acc_OwnAreas"]</p>
        @if (AllowAuto && Editing)
        {
            <div class="sector-pick" style="margin:0">
                <button type="button" class="sp-item @(Selection.OwnAuto ? "on" : "")" @onclick="() => SetOwnAuto(true)">@L["Acc_Automatic"]</button>
                <button type="button" class="sp-item @(!Selection.OwnAuto ? "on" : "")" @onclick="() => SetOwnAuto(false)">@L["Acc_Manual"]</button>
            </div>
        }
        else if (AllowAuto)
        {
            <span class="pill @(Selection.OwnAuto ? "green" : "grey")">@(Selection.OwnAuto ? L["Acc_Automatic"] : L["Acc_Manual"])</span>
        }
    </div>

    @if (AllowAuto && Selection.OwnAuto)
    {
        <p class="help" style="margin:0 0 6px">@L["Acc_AllAreasAuto"]@(Editing ? " " + L["Acc_RemoveToManual"].Value : "")</p>
    }

    @if (ownIds.Count > 0)
    {
        <div class="sector-pick" style="margin-bottom:6px">
            @foreach (var id in ownIds)
            {
                var areaId = id;
                var pk = OwnPicks.FirstOrDefault(p => string.Equals(p.IvaoId, areaId, StringComparison.OrdinalIgnoreCase));
                var name = pk?.Name ?? areaId;
                @if (pk is null)
                {
                    @* Area sparita dai cataloghi (potata da un import): il viewer la salta in silenzio, qui si vede. *@
                    <span class="sp-item on" title="@L["Acc_AreaGoneHint"]">⚠ <b>@name</b> <span class="muted">@L["Acc_AreaGone"]</span>
                        @if (Editing) { <button type="button" class="btn ghost" style="padding:0 4px" @onclick="() => ToggleOwnArea(areaId)">✕</button> }
                    </span>
                }
                else if (Editing)
                {
                    <button type="button" class="sp-item on" title="Rimuovi" @onclick="() => ToggleOwnArea(areaId)">✓ <b>@name</b> ✕</button>
                }
                else { <span class="sp-item on">✓ <b>@name</b></span> }
            }
        </div>
    }
    else { <p class="muted">@L["Acc_NoOwnAreaSelected"]</p> }

    @if (Editing && !(AllowAuto && Selection.OwnAuto))
    {
        @if (AllowAuto)
        {
            <button type="button" class="btn ghost" style="margin-bottom:6px" @onclick="() => SetOwnAuto(true)">↺ @L["Acc_BackToAuto"]</button>
        }
        <input class="app-in" placeholder="@L["Acc_SearchOwnArea"]" value="@_ownSearch"
               @oninput="e => _ownSearch = AsString(e.Value)" />
        @if (OwnPicks.Count == 0)
        {
            <p class="muted" style="margin-top:6px">@L["Acc_NoIvaoArea"]</p>
        }
        else
        {
            var ownMatches = OwnPicks
                .Where(p => !ownIds.Contains(p.IvaoId, StringComparer.OrdinalIgnoreCase))
                .Where(p => Matches(p, _ownSearch, null))
                .ToList();

            <div class="sector-pick area-pick-list" style="margin-top:6px">
                @foreach (var p in ownMatches.Take(PageSize))
                {
                    var pick = p;
                    <button type="button" class="sp-item" @onclick="() => ToggleOwnArea(pick.IvaoId)">
                        <b>@pick.Name</b> @if (!string.IsNullOrWhiteSpace(pick.Type)) { <span class="muted">@pick.Type</span> }
                    </button>
                }
            </div>
            @* Senza il conteggio l'elenco tagliato sembra «non c'è»: su un ACC con 99 aree se ne vedevano 12 mute. *@
            <p class="help" style="margin:4px 0 0">@CountHint(ownMatches.Count)</p>
        }
    }
</div>

@* --- Aree di altri ACC (extra) --- *@
@if (ShowExtra)
{
    <div class="block" style="border-style:dashed;margin-top:8px">
        <p class="app-lbl" style="margin:0 0 4px">@L["Acc_OtherAccAreas"] <span class="muted">@L["Acc_AddedManually"]</span></p>
        @if (Selection.ExtraIds.Count > 0)
        {
            <div class="sector-pick" style="margin-bottom:6px">
                @foreach (var id in Selection.ExtraIds)
                {
                    var areaId = id;
                    var pk = OtherPicks.FirstOrDefault(p => string.Equals(p.IvaoId, areaId, StringComparison.OrdinalIgnoreCase));
                    var name = pk?.Name ?? areaId;
                    @if (pk is null)
                    {
                        <span class="sp-item on" title="@L["Acc_AreaGoneHint"]">⚠ <b>@name</b> <span class="muted">@L["Acc_AreaGone"]</span>
                            @if (Editing) { <button type="button" class="btn ghost" style="padding:0 4px" @onclick="() => ToggleExtraArea(areaId)">✕</button> }
                        </span>
                    }
                    else if (Editing)
                    {
                        <button type="button" class="sp-item on" title="Rimuovi" @onclick="() => ToggleExtraArea(areaId)">✓ <b>@name</b> <span class="muted">@pk?.CentersText</span> ✕</button>
                    }
                    else { <span class="sp-item on">✓ <b>@name</b> <span class="muted">@pk?.CentersText</span></span> }
                }
            </div>
        }
        else if (!Editing) { <p class="muted">@L["Acc_None"]</p> }

        @if (Editing)
        {
            @* Le aree di altri ACC sono centinaia: senza il filtro per ente la ricerca libera è l'unico modo di
               trovarne una, e l'elenco tagliato non dice quante ne sta nascondendo. *@
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <select style="width:auto;flex:none;min-width:150px" value="@_extraAcc"
                        @onchange="e => _extraAcc = AsString(e.Value)">
                    <option value="">@L["Acc_AllAccs"]</option>
                    @foreach (var accCode in OtherAccCodes())
                    {
                        var n = OtherPicks.Count(p => p.Centers.Contains(accCode, StringComparer.OrdinalIgnoreCase));
                        <option value="@accCode">@accCode (@n)</option>
                    }
                </select>
                <input class="app-in" style="flex:1;min-width:160px" placeholder="@L["Acc_SearchOtherArea"]" value="@_extraSearch"
                       @oninput="e => _extraSearch = AsString(e.Value)" />
            </div>

            var extraMatches = OtherPicks
                .Where(p => !Selection.ExtraIds.Contains(p.IvaoId, StringComparer.OrdinalIgnoreCase))
                .Where(p => Matches(p, _extraSearch, _extraAcc))
                .ToList();

            @if (!string.IsNullOrWhiteSpace(_extraSearch) || !string.IsNullOrWhiteSpace(_extraAcc))
            {
                <div class="sector-pick area-pick-list" style="margin-top:6px">
                    @foreach (var p in extraMatches.Take(PageSize))
                    {
                        var pick = p;
                        <button type="button" class="sp-item" @onclick="() => ToggleExtraArea(pick.IvaoId)">
                            <b>@pick.Name</b> <span class="muted">@pick.CentersText</span>
                        </button>
                    }
                </div>
                <p class="help" style="margin:4px 0 0">@CountHint(extraMatches.Count)</p>
            }
        }
    </div>
}

@code {
    /// <summary>Selezione corrente (aree proprie auto/manuale + extra). L'host la ricarica dopo il salvataggio.</summary>
    [Parameter, EditorRequired] public RegulatedSelection Selection { get; set; } = new();

    /// <summary>Aree dell'ACC di appartenenza, selezionabili.</summary>
    [Parameter] public IReadOnlyList<SpecialAreaPick> OwnPicks { get; set; } = Array.Empty<SpecialAreaPick>();

    /// <summary>Aree di altri ACC, selezionabili come extra.</summary>
    [Parameter] public IReadOnlyList<SpecialAreaPick> OtherPicks { get; set; } = Array.Empty<SpecialAreaPick>();

    [Parameter] public bool Editing { get; set; }

    /// <summary>Vero se esiste il modo automatico «tutte le aree dell'ACC» (solo blocco Aerovia della vIPI ACC).</summary>
    [Parameter] public bool AllowAuto { get; set; }

    /// <summary>Vero se si possono aggiungere aree di altri ACC.</summary>
    [Parameter] public bool ShowExtra { get; set; } = true;

    /// <summary>Selezione completa dopo la modifica: l'host la persiste e ricarica.</summary>
    [Parameter] public EventCallback<RegulatedSelection> SelectionChanged { get; set; }

    private string _ownSearch = "";
    private string _extraSearch = "";
    private string _extraAcc = "";      // filtro per ente delle aree extra ("" = tutti)

    /// <summary>Quante voci mostrare per volta. L'elenco è affiancato dal conteggio dei risultati totali.</summary>
    private const int PageSize = 20;

    // Filtro comune ai due picker: testo su nome/tipo/ACC (i tre modi in cui uno cerca un'area) + ente opzionale.
    private static bool Matches(SpecialAreaPick p, string? search, string? accCode)
    {
        // Un'area può essere elencata da più enti (es. una R nazionale è dell'ACC civile e del militare): basta
        // che uno combaci col filtro.
        if (!string.IsNullOrWhiteSpace(accCode) && !p.Centers.Contains(accCode, StringComparer.OrdinalIgnoreCase))
            return false;
        if (string.IsNullOrWhiteSpace(search)) return true;
        var s = search.Trim();
        return p.Name.Contains(s, StringComparison.OrdinalIgnoreCase)
               || (p.Type ?? "").Contains(s, StringComparison.OrdinalIgnoreCase)
               || p.Centers.Any(c => c.Contains(s, StringComparison.OrdinalIgnoreCase));
    }

    // ACC presenti fra le aree extra, col loro conteggio nella tendina: dice subito dove c'è qualcosa da pescare.
    private IEnumerable<string> OtherAccCodes() =>
        OtherPicks.SelectMany(p => p.Centers).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase);

    private string CountHint(int total) => total == 0
        ? L["Acc_NoAreaFound"].Value
        : (total <= PageSize ? L["Acc_AreaCount", total].Value : L["Acc_AreaCountTruncated", PageSize, total].Value);

    // Aree proprie effettivamente selezionate: in automatico sono tutte quelle dell'ACC, sennò il sottoinsieme scelto.
    private List<string> EffectiveOwnIds() =>
        AllowAuto && Selection.OwnAuto
            ? OwnPicks.Select(p => p.IvaoId).ToList()
            : new List<string>(Selection.OwnIds);

    // Passaggio automatico↔manuale: manuale materializza le aree attualmente mostrate (tutte), così non ne sparisce
    // nessuna al primo click; automatico torna dinamico e scarta il sottoinsieme.
    private Task SetOwnAuto(bool auto) => Emit(new RegulatedSelection
    {
        OwnAuto = auto,
        OwnIds = auto ? new List<string>() : EffectiveOwnIds(),
        ExtraIds = new List<string>(Selection.ExtraIds),
    });

    // Seleziona/deseleziona un'area propria. In automatico passa a manuale materializzando le attuali.
    private Task ToggleOwnArea(string areaId)
    {
        var own = EffectiveOwnIds();
        if (own.Contains(areaId, StringComparer.OrdinalIgnoreCase))
            own.RemoveAll(x => string.Equals(x, areaId, StringComparison.OrdinalIgnoreCase));
        else own.Add(areaId);
        return Emit(new RegulatedSelection { OwnAuto = false, OwnIds = own, ExtraIds = new List<string>(Selection.ExtraIds) });
    }

    // Aggiunge/rimuove un'area di altro ACC: non tocca il modo auto/manuale delle proprie.
    private Task ToggleExtraArea(string areaId)
    {
        var extra = new List<string>(Selection.ExtraIds);
        if (extra.Contains(areaId, StringComparer.OrdinalIgnoreCase))
            extra.RemoveAll(x => string.Equals(x, areaId, StringComparison.OrdinalIgnoreCase));
        else extra.Add(areaId);
        return Emit(new RegulatedSelection
        {
            OwnAuto = Selection.OwnAuto,
            OwnIds = new List<string>(Selection.OwnIds),
            ExtraIds = extra,
        });
    }

    private Task Emit(RegulatedSelection sel) => SelectionChanged.InvokeAsync(sel);

    private static string AsString(object? v) => v as string ?? "";
}
