@* Sezione Coordinamenti (derivata dai trasferimenti del settore APP): verso ACC (partenze+arrivi) · verso torri (solo arrivi). *@
@* Nome del componente diverso dal DTO AppCoordination per evitare il mascheramento del tipo. *@
@inject IStringLocalizer<SharedResource> L
<p class="muted" style="margin-top:0;font-size:13.5px">@L["AppCoord_Intro"]</p>

@if (Coord.TowardAcc.Count == 0 && Coord.TowardTowers.Count == 0 && Coord.Overflights.Count == 0)
{
    <p class="muted" style="margin:0">@L["AppCoord_None"]</p>
}

<div class="coord-wrap">
@if (Coord.TowardAcc.Count > 0 || Coord.TowardTowers.Count > 0 || Coord.Overflights.Count > 0)
{
    @CoordTools
}
@if (Coord.TowardAcc.Count > 0)
{
    var accRows = Coord.TowardAcc.SelectMany(g => g.Rows).ToList();
    var partenze = accRows.Where(r => r.Kind == TransferFlowKind.Departure).ToList();
    var arrivi = accRows.Where(r => r.Kind == TransferFlowKind.Arrival).ToList();

    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_TowardAcc"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @if (partenze.Count > 0)
            {
                <details class="coord-sub2" open>
                    <summary><span>@L["Airport_Departures"]</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(partenze, showKind: false)</div>
                </details>
            }
            @if (arrivi.Count > 0)
            {
                <details class="coord-sub2" open>
                    <summary><span>@L["Airport_Arrivals"]</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(arrivi, showKind: false, lastCol: "From")</div>
                </details>
            }
        </div>
    </details>
}

@if (Coord.TowardTowers.Count > 0)
{
    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_TowardTowers"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @foreach (var g in Coord.TowardTowers)
            {
                <details class="coord-sub2" open>
                    <summary><span>@g.TargetCallsign</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(g.Rows, showKind: false)</div>
                </details>
            }
        </div>
    </details>
}

@if (Coord.Overflights.Count > 0)
{
    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_Overflights"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @foreach (var g in Coord.Overflights)
            {
                <details class="coord-sub2" open>
                    <summary><span>@g.TargetCallsign</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(g.Rows, showKind: false)</div>
                </details>
            }
        </div>
    </details>
}
</div>

@code {
    [Parameter, EditorRequired] public AppCoordination Coord { get; set; } = AppCoordination.Empty;

    // Controlli espandi/comprimi tutto (sezione + sottosezioni). Vedi vipiDetails in vipi-ui.js.
    // Property (non field initializer): usa L, che è un membro d'istanza.
    private RenderFragment CoordTools => __builder =>
    {
        <div class="coord-tools">
            <button type="button" onclick="vipiDetails(this,true)">@L["Common_ExpandAll"]</button>
            <button type="button" onclick="vipiDetails(this,false)">@L["Common_CollapseAll"]</button>
        </div>
    };

    private RenderFragment RenderTable(IReadOnlyList<AppCoordRow> rows, bool showKind, string lastCol = "Next") => __builder =>
    {
        @foreach (var r in rows.Where(x => !string.IsNullOrWhiteSpace(x.Sentence)))
        {
            <p class="coord-sentence">@r.Sentence</p>
        }
        var hasCond = rows.Any(x => !string.IsNullOrWhiteSpace(x.ConditionLabel));
        <table>
            <thead>
                <tr>
                    @if (showKind) { <th>@L["AppCoord_Flow"]</th> }
                    <th>CoP</th><th>@L["AppCoord_Level"]</th><th>@lastCol</th>@if (hasCond) { <th>@L["AppCoord_Condition"]</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in rows)
                {
                    <tr>
                        @if (showKind) { <td>@TransferFlowKindLabels.Label(r.Kind)</td> }
                        <td>@(string.IsNullOrWhiteSpace(r.Cop) ? "—" : r.Cop)</td>
                        <td>@r.Level</td>
                        <td>@r.Next</td>
                        @if (hasCond) { <td>@(string.IsNullOrWhiteSpace(r.ConditionLabel) ? "—" : r.ConditionLabel)</td> }
                    </tr>
                }
            </tbody>
        </table>
    };
}
