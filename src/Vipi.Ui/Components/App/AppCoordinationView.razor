@* Sezione Coordinamenti (derivata dai trasferimenti del settore APP): verso ACC (partenze+arrivi) · verso torri (solo arrivi). *@
@* Nome del componente diverso dal DTO AppCoordination per evitare il mascheramento del tipo. *@
@* Come nella vIPI ACC: aperto il solo primo livello (verso ACC / verso torri / sorvoli), dentro compresso. *@
@inject IStringLocalizer<SharedResource> L
<p class="muted" style="margin-top:0;font-size:13.5px">@L["AppCoord_Intro"]</p>

@{ var hasAny = Coord.TowardAcc.Count > 0 || Coord.TowardTowers.Count > 0
                || Coord.TowardApps.Count > 0 || Coord.Overflights.Count > 0; }
@if (!hasAny)
{
    <p class="muted" style="margin:0">@L["AppCoord_None"]</p>
}

<div class="coord-wrap">
@if (hasAny)
{
    @CoordTools
}
@if (Coord.TowardAcc.Count > 0)
{
    var accRows = Coord.TowardAcc.SelectMany(g => g.Rows).ToList();
    var partenze = accRows.Where(r => r.Kind == TransferFlowKind.Departure).ToList();
    var arrivi = accRows.Where(r => r.Kind == TransferFlowKind.Arrival).ToList();

    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_TowardAcc"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @if (partenze.Count > 0)
            {
                <details class="coord-sub2">
                    <summary><span>@L["Airport_Departures"]</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(partenze, showKind: false)</div>
                </details>
            }
            @if (arrivi.Count > 0)
            {
                @* L'intestazione dell'ultima colonna la sceglie CoordTable, riga per riga: qui c'era «Da»
                   cablato sugli arrivi, che indovinava giusto solo perché fra APP e ACC gli arrivi entrano
                   quasi sempre. Verso le torri e verso gli APP confinanti sbagliava. *@
                <details class="coord-sub2">
                    <summary><span>@L["Airport_Arrivals"]</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(arrivi, showKind: false)</div>
                </details>
            }
        </div>
    </details>
}

@if (Coord.TowardTowers.Count > 0)
{
    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_TowardTowers"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @foreach (var g in Coord.TowardTowers)
            {
                @* Colonna «Flusso»: verso le torri ora passano anche le partenze, non solo gli arrivi. *@
                <details class="coord-sub2">
                    <summary><span>@g.TargetCallsign</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(g.Rows, showKind: true)</div>
                </details>
            }
        </div>
    </details>
}

@if (Coord.TowardApps.Count > 0)
{
    @* TMA confinanti: prima questi coordinamenti non avevano un gruppo dove finire e sparivano dal documento. *@
    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_TowardApps"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @foreach (var g in Coord.TowardApps)
            {
                <details class="coord-sub2">
                    <summary><span>@g.TargetCallsign</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(g.Rows, showKind: true)</div>
                </details>
            }
        </div>
    </details>
}

@if (Coord.Overflights.Count > 0)
{
    <details class="coord-sub" open>
        <summary><span>@L["AppCoord_Overflights"]</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools
            @foreach (var g in Coord.Overflights)
            {
                <details class="coord-sub2">
                    <summary><span>@g.TargetCallsign</span><span class="chev">▸</span></summary>
                    <div class="body">@RenderTable(g.Rows, showKind: false)</div>
                </details>
            }
        </div>
    </details>
}
</div>

@code {
    /// <summary>Prosa a CAPOFILA: una frase che introduce ogni tabella invece di una per clausola. Viene dalla
    /// SEZIONE, quindi è una scelta editoriale versionata e non un'opzione della vista.</summary>
    [Parameter] public bool LeadSentence { get; set; }

    [Parameter, EditorRequired] public AppCoordination Coord { get; set; } = AppCoordination.Empty;

    // Controlli espandi/comprimi tutto (sezione + sottosezioni). Vedi vipiDetails in vipi-ui.js.
    // Property (non field initializer): usa L, che è un membro d'istanza.
    private RenderFragment CoordTools => __builder =>
    {
        <div class="coord-tools">
            <button type="button" onclick="vipiDetails(this,true)">@L["Common_ExpandAll"]</button>
            <button type="button" onclick="vipiDetails(this,false)">@L["Common_CollapseAll"]</button>
        </div>
    };

    // Stessa tabella della vIPI ACC e della vLOA: vedi CoordTable (colonne per presenza dati, gruppi varianti,
    // taglio per verso e intestazione dell'ultima colonna).
    private RenderFragment RenderTable(IReadOnlyList<AppCoordRow> rows, bool showKind) => __builder =>
    {
        <CoordTable LeadSentence="LeadSentence" Rows="rows" ShowKind="showKind" />
    };
}
