@* Il comando della categoria di un aeroporto, nella pagina Aeroporti (carta 2026-09-11-categorie-aeroporto.md).
   Si usa solo sui campi CON presenza militare: gli altri sono «Civile» per la sorgente, e non c'è niente da
   scegliere — lì la pagina mostra l'etichetta e basta.

   ⚠️ La conferma compare SOLO quando il gesto ha una conseguenza che chi sceglie non vede: la categoria nuova
   esclude un documento che lo scalo ha GIÀ (una vIPI civile sotto «solo militare», un vSOP sotto «civile con
   presenza militare»). Quel documento non viene toccato — resta com'è, online se è pubblicato — e toglierlo è
   un gesto a parte. 🔴 Negli altri casi la scelta scrive subito: una conferma che chiede sempre è una conferma
   che nessuno legge, ed è il modo in cui si perde quella che conta.

   ⚠️ Mentre la conferma è aperta il `<select>` NON si disegna. Non è estetica: Blazor non riscrive il `value` di
   un elemento se il valore nel modello non è cambiato, quindi annullando la tendina resterebbe sulla voce
   scelta e non confermata — a schermo una categoria che l'archivio non ha. Tolto e rimesso, l'elemento nasce
   di nuovo con la voce giusta. *@
@using Vipi.Domain
@inject IStringLocalizer<SharedResource> L

@if (_pending is AirportCategory nuova)
{
    <span class="inline-confirm is-open apt-cat-confirm">
        <span class="ic-prompt muted">@Prompt(nuova)</span>
        <button type="button" class="btn primary" disabled="@Disabled" @onclick="() => ConfermaAsync(nuova)">@YesLabel(nuova)</button>
        <button type="button" class="btn ghost" disabled="@Disabled" @onclick="() => _pending = null">@L["Common_Close"]</button>
    </span>
}
else
{
    @* `@key` a giro: stessa ragione del commento in testa. Se la scrittura fallisce la categoria in archivio
       non cambia, e senza un elemento nuovo la tendina resterebbe sulla voce rifiutata. *@
    <select @key="_giro" class="apt-cat pill @AirportCategoryText.PillClass(Category)" disabled="@Disabled"
            aria-label="@L["Apt_CatPickAria", Icao]" title="@L[AirportCategoryText.TitleKey(Category)]"
            @onchange="ScegliAsync">
        @foreach (var c in AirportCategories.Selectable)
        {
            <option value="@c" selected="@(c == Category)">@L[AirportCategoryText.Key(c)]</option>
        }
    </select>
}

@code {
    [Parameter, EditorRequired] public string Icao { get; set; } = "";

    /// <summary>La categoria in archivio.</summary>
    [Parameter] public AirportCategory Category { get; set; }

    /// <summary>Lo scalo ha già una vIPI civile (anche solo in bozza).</summary>
    [Parameter] public bool HasCivilDocument { get; set; }

    /// <summary>Lo scalo ha già un vSOP militare (anche solo in bozza).</summary>
    [Parameter] public bool HasMilitaryDocument { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>La categoria scelta (e, se serviva, confermata): la pagina la scrive.</summary>
    [Parameter] public EventCallback<AirportCategory> OnChange { get; set; }

    private AirportCategory? _pending;
    private int _giro;

    /// <summary>
    /// Quale documento esistente la categoria nuova lascerebbe <b>fuori categoria</b>, se ce n'è uno che quella
    /// attuale ammetteva. <c>null</c> = nessuna conseguenza nascosta: la scelta scrive senza chiedere.
    /// <para>⚠️ «Che quella attuale ammetteva»: un documento già fuori categoria non è una conseguenza di QUESTO
    /// gesto, e chiedere conferma per lui a ogni cambio sarebbe la conferma che nessuno legge.</para>
    /// </summary>
    public static DocumentEdition? Conseguenza(AirportCategory da, AirportCategory a, bool haCivile, bool haMilitare) =>
        haCivile && da.AllowsCivil() && !a.AllowsCivil() ? DocumentEdition.Civil
        : haMilitare && da.AllowsMilitary() && !a.AllowsMilitary() ? DocumentEdition.Military
        : null;

    private async Task ScegliAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<AirportCategory>(e.Value?.ToString(), out var nuova) || nuova == Category) return;
        if (Conseguenza(Category, nuova, HasCivilDocument, HasMilitaryDocument) is not null)
        {
            _pending = nuova;
            return;
        }
        await ScriviAsync(nuova);
    }

    private async Task ConfermaAsync(AirportCategory nuova)
    {
        _pending = null;
        await ScriviAsync(nuova);
    }

    private async Task ScriviAsync(AirportCategory nuova)
    {
        try { await OnChange.InvokeAsync(nuova); }
        finally { _giro++; }
    }

    private string Prompt(AirportCategory nuova) =>
        Conseguenza(Category, nuova, HasCivilDocument, HasMilitaryDocument) == DocumentEdition.Civil
            ? L["Apt_MilitaryOnlyConCivile", Icao].Value
            : L["Apt_CatConMil", Icao, L[AirportCategoryText.Key(nuova)].Value].Value;

    private string YesLabel(AirportCategory nuova) =>
        Conseguenza(Category, nuova, HasCivilDocument, HasMilitaryDocument) == DocumentEdition.Civil
            ? L["Apt_MilitaryOnlyConCivileYes"].Value
            : L["Apt_CatConfirmYes"].Value;
}
