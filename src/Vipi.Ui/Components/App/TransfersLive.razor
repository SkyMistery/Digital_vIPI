@* Resa live dei trasferimenti risolti (vista live) — masonry come mockup #reduced.
   Un riquadro (.xpair) per mittente EFFETTIVO: se un settore è chiuso, i suoi trasferimenti compaiono
   sotto il primo antenato online che lo assorbe (già risolto in ResolvedOwnerCallsign). Dentro: per tipo
   di flusso (Arrivi/Partenze/…) → una card per aeroporto coi suoi CoP, livello e ricevente risolto. *@

@inject IStringLocalizer<SharedResource> L

@{
    var shown = Shown();
    var hidden = UnicomCount();
}

@if (hidden > 0)
{
    @* Un rilascio a UNICOM non è un handoff: sotto non c'è nessuno. Di default sta fuori dai piedi, ma resta
       a un click — serve quando devi dire al pilota a chi (non) passarlo. *@
    <div class="xt-unicom-bar">
        <button type="button" class="btn ghost" @onclick="() => _showUnicom = !_showUnicom">
            @(_showUnicom ? L["Live_HideUnicom"] : L["Live_ShowUnicom", hidden])
        </button>
    </div>
}

@if (shown.Count == 0)
{
    <p class="help">@(Flows.Count == 0 ? EmptyText : L["Live_OnlyUnicom"])</p>
}
else
{
    <div id="xfer-pairs">
        @foreach (var owner in shown.GroupBy(r => r.ResolvedOwnerCallsign).OrderBy(g => g.Key))
        {
            <div class="xpair @(IsChanged(owner.Key) ? "xt-changed" : "")">
                <div class="xpair-h">@owner.Key @(owner.First().OwnerOnline ? "" : "· offline")</div>
                <div class="xpair-body">
                    @foreach (var kind in owner.GroupBy(r => r.Flow.Kind).OrderBy(g => g.Key))
                    {
                        <div class="xt-sub-h">@TransferFlowKindLabels.Label(kind.Key)</div>
                        <div class="xt-cards">
                            @foreach (var apt in kind.GroupBy(r => r.Flow.AirportIcao).OrderBy(g => g.Key ?? "~"))
                            {
                                var points = apt.SelectMany(r => r.Points).ToList();
                                var aptName = apt.Select(r => r.Flow.AirportName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
                                <div class="xt-card">
                                    <div class="xt-card-h">
                                        <b class="xt-dest">@(string.IsNullOrWhiteSpace(apt.Key) ? "—" : apt.Key)</b>
                                        @if (!string.IsNullOrWhiteSpace(aptName)) { <span class="muted" style="font-size:11px">@aptName</span> }
                                        <span class="muted" style="font-size:11px">@points.Count pt</span>
                                    </div>
                                    @foreach (var p in points)
                                    {
                                        <div class="xt-pt @(IsChanged(p.ResolvedHandler) ? "xt-changed" : "")">
                                            <span class="cop">@(string.IsNullOrWhiteSpace(p.Point.Cop) ? "—" : p.Point.Cop)</span>
                                            @* In frequenza servono ENTRAMBI i livelli, e in quest'ordine: quello a cui
                                               autorizzi e quello a cui trasferisci. Mostrarne uno solo significherebbe
                                               scegliere per il controllore quale delle due istruzioni dimenticare. *@
                                            <b class="fl">@p.Point.LevelText</b>
                                            @if (p.Point.HandoffLevelText.Length > 0)
                                            {
                                                <b class="fl" style="opacity:.85">→ @p.Point.HandoffLevelText</b>
                                            }
                                            @if (p.Point.SpeedText.Length > 0)
                                            {
                                                <span class="muted" style="font-size:10.5px;margin-left:4px">@p.Point.SpeedText</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(p.Point.ConditionLabel))
                                            {
                                                <span class="xt-cond" title="Condizione operativa" style="font-size:10.5px;background:var(--surface-muted);color:var(--ink-mid);border-radius:4px;padding:1px 5px;margin-left:4px">@p.Point.ConditionLabel</span>
                                            }
                                            <span class="xt-next @(p.IsOnline ? "" : "tieni")">→ <b>@p.ResolvedHandler</b></span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ResolvedTransferFlow> Flows { get; set; } = Array.Empty<ResolvedTransferFlow>();
    [Parameter] public string EmptyText { get; set; } = "Nessun coordinamento.";

    /// <summary>Callsign appena passati online/offline: le righe che li riguardano si evidenziano, così un
    /// cambio di destinatario non passa inosservato mentre stai guardando altrove.</summary>
    [Parameter] public IReadOnlySet<string>? Changed { get; set; }

    private bool IsChanged(string? callsign) =>
        Changed is { Count: > 0 } && !string.IsNullOrWhiteSpace(callsign) && Changed.Contains(callsign);

    private const string Unicom = "UNICOM";
    private bool _showUnicom;

    private static bool IsUnicom(ResolvedTransferPoint p) =>
        string.Equals(p.ResolvedHandler, Unicom, StringComparison.OrdinalIgnoreCase);

    private int UnicomCount() => Flows.Sum(f => f.Points.Count(IsUnicom));

    /// <summary>Flussi da rendere: filtrati dei punti che finiscono a UNICOM, salvo richiesta esplicita.
    /// Si filtra qui, una volta, così tutti i raggruppamenti a valle restano invariati.</summary>
    private IReadOnlyList<ResolvedTransferFlow> Shown()
    {
        if (_showUnicom) return Flows;
        return Flows
            .Select(f => new ResolvedTransferFlow
            {
                Flow = f.Flow,
                ResolvedOwnerCallsign = f.ResolvedOwnerCallsign,
                OwnerOnline = f.OwnerOnline,
                Points = f.Points.Where(p => !IsUnicom(p)).ToList(),
            })
            .Where(f => f.Points.Count > 0)
            .ToList();
    }
}
