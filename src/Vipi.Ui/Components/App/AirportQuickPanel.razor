@* Vista rapida aeroporto (inline nella vista live ACC/APP). Mostra ESATTAMENTE ciò che è nel
   documento pubblico dell'aeroporto (release-aware), coerente con /services/vsop/{acc}/airports?icao=:
   - TA / TL·QNH → dal DocumentView pubblico (BuildAirportVipiAsync live:false, rispetta la release del ciclo)
   - Piste suggerite → dal profilo strutturato (come /airports)
   - SID → dalla STESSA derivazione del documento completo (IAirportSidDerivationService): stesse colonne,
     stesso filtro AIRAC, stesse note. Qui c'era una seconda derivazione scritta a mano, e diceva una cosa
     diversa — la nota «to coord with APP» sull'initial climb non usciva mai.
   METAR live solo per la pista consigliata e l'evidenza della riga TL col QNH corrente. *@
@using System.Text.Json
@using System.Text.RegularExpressions
@using Vipi.Application.Content
@using Vipi.Application.Live
@using Vipi.Application.Weather
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject Vipi.Application.Abstractions.IWeatherProvider Weather
@inject IStringLocalizer<SharedResource> L
@* ViewService e AirportProfile risolti dallo scope DI proprio (VipiDbContext isolato dal circuito). Vedi [[EditLockBar]]. *@

@if (_view is null)
{
    <div class="block">
        <div class="rap-h" style="justify-content:space-between">
            <span><b>@Icao</b> <span class="muted">vista rapida</span></span>
            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@Icao">@L["Apt_OpenFullVipi"] →</a>
        </div>
        <p class="muted" style="margin:0">Nessun documento pubblicato per @Icao.</p>
    </div>
}
else
{
    <div class="block">
        <div class="rap-h" style="justify-content:space-between">
            <span><b>@Icao</b> <span class="muted">vista rapida</span></span>
            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@Icao">@L["Apt_OpenFullVipi"] →</a>
        </div>

        <div class="rap-quick">
            @* Chi chiamare adesso: è la domanda per cui si apre questa vista, e prima non c'era risposta.
               Le posizioni dello scalo online dal gate in su; se manca qualcosa, chi copre risalendo. *@
            @if (Presidency is not null)
            {
                <div class="rap-box" style="flex-basis:100%"><span class="muted">Adesso</span><b>@ChiPresiede()</b></div>
            }
            <div class="rap-box"><span class="muted">TA</span><b>@(_ta is int ta ? $"{ta} ft" : "N/A")</b></div>
            <div class="rap-box"><span class="muted">TL@(_qnh is int q ? $" · QNH {q}" : "")</span><b>@TlNow()</b></div>
            @* Il vento accanto alla pista suggerita: la pista si sceglie per il vento, e senza vederlo la
               riga «piste suggerite» e' un numero da prendere per buono. *@
            <div class="rap-box"><span class="muted">@L["Apt_Wind"]</span><b>@WindText()</b></div>
            <div class="rap-box"><span class="muted">@L["Apt_SuggestedRunways"]</span><b>@SuggText()</b></div>
        </div>

        @if (_runways.Count > 0)
        {
            <p class="muted" style="font-size:12.5px;margin:14px 0 6px">@L["Aqp_SelectedRunway"]</p>
            <div class="rap-quick" style="margin-bottom:12px">
                <Chip Class="@($"sid-pill {(_selRwy == "all" ? "on" : "")}")" Active='_selRwy == "all"' OnActivate='() => _selRwy = "all"'>@L["Common_All"]</Chip>
                @foreach (var r in _runways)
                {
                    var rwy = r;
                    <Chip Class="@($"sid-pill {(_selRwy == rwy ? "on" : "")}")" Active="_selRwy == rwy" OnActivate="() => _selRwy = rwy">@rwy</Chip>
                }
            </div>
        }

        @{
            var sids = FilteredSids().ToList();
            // Cat. e WTC restano opzionali: sono decorazioni, e una colonna vuota su TUTTE le righe dello
            // scalo ruba larghezza senza dire niente. Transition e Condition NO — ci sono sempre, come nel
            // documento completo (richiesta del committente, 5 settembre 2026).
            //
            // 🔴 Si guarda `_sids`, cioe' TUTTE le SID dello scalo, NON le righe filtrate: legandole al
            // filtro la tabella cambiava numero di colonne mentre si digitava (visto a schermo su LIRN —
            // cercando «AGNIS» la riga passava da sette celle a cinque). Una colonna che va e viene non si
            // legge come «qui non c'e' il dato», si legge come un guasto.
            var showCat = _sids.Any(s => s.Cat != "—");
            var showWtc = _sids.Any(s => s.Wtc != "—");
        }
        @if (_sids.Count > 0)
        {
            @* Cercare per PUNTO o per CODICE: in una lista di ottanta SID il filtro per pista non basta, e
               chi controlla cerca il punto che gli ha detto il pilota. La ricerca guarda anche la
               transition, che e' un punto anche lei. *@
            @* 🔴 NIENTE `value="@_q"` su questo campo, ed è misurato, non una preferenza. Riscrivendo il
               `value` a ogni tasto il server rimanda indietro il testo di UN GIRO PRIMA: tenendo premuto
               Backspace i caratteri cancellati ricompaiono (otto Backspace, tre caratteri sopravvissuti su
               «AGNI7G» — visto a schermo su LIRN il 5 settembre 2026, a ritmo umano di 120 ms).
               Senza `value` il testo lo tiene il browser, che è l'unico che sa dove sta il cursore, e `_q`
               ne è lo specchio. Quando invece siamo NOI a doverlo svuotare — la ✕, o un aeroporto diverso —
               si cambia `@key`: l'elemento viene ricreato, ed è l'unico modo di scriverci dentro dal server
               senza rimettersi in mezzo mentre uno digita. *@
            <div class="sid-find">
                <input @key="_gen" type="search" @oninput="OnQuery" autocomplete="off"
                       placeholder="@L["Aqp_SearchSid"]" aria-label="@L["Aqp_SearchSid"]" />
                @if (_q.Length > 0)
                {
                    <button type="button" class="btn ghost sid-find-x" @onclick="Azzera"
                            title="@L["Aqp_ClearSearch"]">✕</button>
                    <span class="muted sid-find-n">@L["Aqp_SidCount", sids.Count]</span>
                }
            </div>
        }
        @if (sids.Count > 0)
        {
            <div class="tbl-scroll">
            <table class="res-table sid-table sid-quick">
                <thead>
                    <tr>
                        <th class="col-fix">Punto</th>
                        <th class="col-sid">SID</th>
                        <th class="col-trans">Transition</th>
                        <th class="col-climb">Salita iniz.</th>
                        @if (showCat) { <th class="col-cat">Cat.</th> }
                        @if (showWtc) { <th class="col-wtc">WTC</th> }
                        <th class="col-cond">Condition</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in sids)
                    {
                        <tr>
                            <td class="col-fix"><b>@s.Fix</b></td>
                            <td class="col-sid">@s.Name</td>
                            <td class="col-trans">@s.Transition</td>
                            <td class="col-climb">@FormatInitialClimb(s.InitialClimb)</td>
                            @if (showCat) { <td class="col-cat">@s.Cat</td> }
                            @if (showWtc) { <td class="col-wtc">@s.Wtc</td> }
                            <td class="col-cond">@s.Condition</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        else if (_q.Length > 0)
        {
            <p class="muted" style="font-size:13px;margin:0">@L["Aqp_NoSidMatch", _q]</p>
        }
        else if (_runways.Count > 0)
        {
            <p class="muted" style="font-size:13px;margin:0">Nessuna SID@(_selRwy == "all" ? "" : $" per la pista {_selRwy}").</p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Icao { get; set; } = default!;
    [Parameter, EditorRequired] public string Acc { get; set; } = default!;

    /// <summary>
    /// Chi presiede l'aeroporto adesso. Arriva dal chiamante e non si calcola qui **di proposito**: nella
    /// vista live la pagina l'ha già risolta per le chip, e ricalcolarla qui vorrebbe dire rifare le query a
    /// ogni tick del feed — oltre a rischiare che le due parti della stessa schermata dicano cose diverse.
    /// Null = il chiamante non la conosce (o non è pertinente): la riga non si mostra affatto.
    /// </summary>
    [Parameter] public AirportPresidency? Presidency { get; set; }

    private DocumentView? _view;                    // documento PUBBLICO (release-aware): fonte di TA/TL
    private AirportData? _profile;           // profilo LIVE: fonte di piste/SID (come /airports)
    private int? _ta;
    private List<(string Range, string Level)> _tlRows = new();
    private int? _qnh;
    private ParsedWind? _wind;
    private (string? Dep, string? Arr) _sugg;
    private List<string> _runways = new();
    private string _selRwy = "all";
    private string? _loadedIcao;

    /// <summary>
    /// Le SID <b>già derivate</b>, le stesse righe del documento completo. Prima questo pannello partiva
    /// dalle <c>SidRow</c> grezze e rifaceva a mano filtro AIRAC, ordine e trattini: due derivazioni della
    /// stessa tabella, e infatti divergevano — qui la nota «to coord with APP» sull'initial climb non
    /// compariva, perché la aggiunge la derivazione (<c>AirportSidDerivationService.Climb</c>).
    /// </summary>
    private IReadOnlyList<AirportSidRowView> _sids = Array.Empty<AirportSidRowView>();

    /// <summary>Testo cercato: punto, codice SID o transition. Vuoto = tutte.</summary>
    private string _q = "";

    /// <summary>Generazione del campo di ricerca: cambiarla lo fa RICREARE, ed è così che il server lo
    /// svuota senza riscrivergli dentro mentre si digita (vedi il commento accanto all'input).</summary>
    private int _gen;

    // Risolti dallo scope proprio (OwningComponentBase): context isolato dal circuito.
    private IVipiViewService ViewService = default!;
    private IAirportEditingService AirportProfile = default!;
    private IAirportSidDerivationService SidView = default!;
    protected override void OnInitialized()
    {
        ViewService = ScopedServices.GetRequiredService<IVipiViewService>();
        AirportProfile = ScopedServices.GetRequiredService<IAirportEditingService>();
        SidView = ScopedServices.GetRequiredService<IAirportSidDerivationService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedIcao, Icao, StringComparison.OrdinalIgnoreCase)) return;
        _loadedIcao = Icao;

        _view = null; _profile = null; _ta = null; _tlRows = new();
        _qnh = null; _wind = null; _sugg = (null, null); _runways = new(); _selRwy = "all";
        _sids = Array.Empty<AirportSidRowView>(); Azzera();   // aeroporto diverso: il campo si svuota davvero

        // Documento pubblico dell'aeroporto (rispetta la release effettiva del ciclo, come /airports).
        _view = await ViewService.BuildAirportVipiAsync(Icao, BlockTier.Extended, live: false);
        if (_view is null) return;

        ParseTransition(_view);                     // TA + tabella TL dal documento

        _profile = await AirportProfile.LoadForViewAsync(Icao);
        _runways = _profile?.Runways.Select(r => r.Ident.Trim()).Where(s => s.Length > 0).Distinct().ToList() ?? new();

        // La tabella SID è la STESSA del documento completo: stesse colonne, stesso filtro AIRAC, stesso
        // ordine. Al ciclo corrente, che qui è sempre «adesso»: il pannello rapido non ha anteprime.
        _sids = (await SidView.DeriveAsync(Icao)).Rows;

        var wx = await Weather.GetAsync(Icao);
        var metar = string.IsNullOrWhiteSpace(wx?.Metar) ? null : MetarParser.ParseMetar(wx!.Metar!);
        _qnh = metar?.QnhHpa;
        _wind = metar?.Wind;
        _sugg = SuggestRwy(metar);
        _selRwy = _sugg.Dep is string dep && _runways.Contains(dep) ? dep : "all";
    }

    /// <summary>Una riga: le posizioni locali online, e chi copre il resto. Nessuno dei due ⇒ UNICOM.</summary>
    private string ChiPresiede()
    {
        var p = Presidency!;
        if (p.Unicom) return L["Apt_NobodyOnline"];

        var locali = string.Join(" · ", p.Local.Select(s => s.Callsign));
        if (p.Covering is null) return locali;
        return locali.Length == 0 ? $"{p.Covering.Callsign} (copre)" : $"{locali} — resto: {p.Covering.Callsign}";
    }

    // ---- TA/TL dal documento pubblico (stessa logica di AeroportoPage.SplitSections/ParseTlTable) ----
    private void ParseTransition(DocumentView view)
    {
        var sec = view.Sections.FirstOrDefault(s => s.Title.Contains("transi", StringComparison.OrdinalIgnoreCase));
        if (sec is null) return;
        foreach (var b in sec.Blocks)
        {
            if (b.Format == BlockFormat.Prose && b.Body is not null && _ta is null)
            {
                var m = Regex.Match(b.Body, @"Altitude[^0-9]*(\d{3,5})");
                if (m.Success) _ta = int.Parse(m.Groups[1].Value);
            }
            else if (b.Format == BlockFormat.Table && b.BodyJson is not null && _tlRows.Count == 0)
            {
                // Qui servono solo le righe: le intestazioni le rende il documento completo, non il pannello.
                _tlRows.AddRange(AirportViewFormat.ParseTransitionLevels(b.BodyJson).Rows);
            }
        }
    }

    private string TlNow()
    {
        if (_tlRows.Count == 0) return "—";
        if (_qnh is int q)
        {
            var hit = _tlRows.FirstOrDefault(r => AirportViewFormat.QnhRowMatches(r.Range, q));
            if (hit.Level is not null) return _ta is null ? "N/A" : hit.Level;
        }
        return _ta is null ? "N/A" : _tlRows[0].Level;
    }

    // ---- Piste suggerite dal profilo (come AeroportoPage): regole se presenti, altrimenti vento di testa ----
    private (string? Dep, string? Arr) SuggestRwy(ParsedMetar? m)
    {
        if (_profile is null) return (null, null);
        int? windDir = m?.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        int windKt = m?.Wind?.SpeedKt ?? 0;
        if (_profile.Rules.Count > 0)
        {
            var wet = (m?.HasRain ?? false) || (m?.HasSnow ?? false);
            var rr = RunwaySuggestion.EvaluateRules(_profile.Rules.Select(AirportViewFormat.MapRule).ToList(), windDir, windKt, wet, DateTime.UtcNow);
            if (rr is not null) return (Norm(rr.Dep), Norm(rr.Arr));
        }
        if (_runways.Count > 0)
        {
            var s = RunwaySuggestion.Suggest(_runways, windDir, windKt);
            if (s.Best is not null) return (Norm(s.DepIdent ?? s.Best.Ident), Norm(s.ArrIdent ?? s.Best.Ident));
        }
        return (null, null);
    }

    /// <summary>Vento del METAR corrente, con la raffica se c'è (es. «160° / 12 kt G24»).</summary>
    private string WindText()
    {
        if (_wind is null) return "—";
        return _wind.GustKt is int g ? $"{_wind.Label} G{g}" : _wind.Label;
    }

    private string SuggText()
    {
        if (_sugg.Dep is null && _sugg.Arr is null) return "—";
        if (string.Equals(_sugg.Dep, _sugg.Arr, StringComparison.OrdinalIgnoreCase)) return _sugg.Dep!;
        return $"{_sugg.Dep ?? "—"} dep · {_sugg.Arr ?? "—"} arr";
    }

    /// <summary>
    /// Le righe da mostrare: pista scelta (le SID senza pista valgono per tutte) più il testo cercato.
    /// L'ordine e il filtro AIRAC li ha già fatti la derivazione.
    /// </summary>
    private IEnumerable<AirportSidRowView> FilteredSids()
    {
        var q = _q.Trim();
        return _sids
            .Where(s => _selRwy == "all" || s.Runway == "—"
                        || s.Runway.Equals(_selRwy, StringComparison.OrdinalIgnoreCase))
            .Where(s => AirportViewFormat.SidMatches(s, q));
    }

    private void OnQuery(ChangeEventArgs e) => _q = e.Value?.ToString() ?? "";

    /// <summary>Svuota la ricerca: il testo E l'elemento, o il campo resterebbe scritto a schermo.</summary>
    private void Azzera()
    {
        _q = "";
        _gen++;
    }

    private static string? Norm(string? r) => string.IsNullOrWhiteSpace(r) ? null : r.Trim();

    private string FormatInitialClimb(string? raw) => AirportViewFormat.InitialClimb(raw, _ta);
}
