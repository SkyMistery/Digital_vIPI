@* L'editor della sezione «Quote di transizione»: la TA e la tabella dei livelli per fascia QNH.

   ⚠️ È un componente A PARTE da <AirportTransition>, che è la lettura, e non è una svista (doc 14 §3g).
   Le due forme dei dati sono davvero diverse: in lettura la fascia è la stringa già composta «1014 – 1030»,
   perché quella è la forma che si congela nella release; in scrittura sono due estremi separati e mutabili,
   perché è ciò che un <input> sa legare. Fonderli darebbe un componente che porta dentro entrambe le forme e
   ne usa una alla volta: due componenti in un cappotto solo.

   Quel che invece era un difetto — e che questo componente chiude — è che tutto questo stava scritto DENTRO
   AeroportoEditorPage, dove nessun test poteva montarlo. *@
@inject IStringLocalizer<SharedResource> L

<div @onchange="() => OnChanged.InvokeAsync()">
    <div class="ed-h3 ed-h3-mini">
        <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_TlHelpAria"]" ExtraClass="wide">@((MarkupString)L["Ape_TlHelp"].Value)</HelpHint>
        @if (SourceLocked)
        {
            @* Il chip resta a schermo (è uno STATO: questo dato non si tocca), la spiegazione del perché va
               nel «?» accanto. *@
            <span class="pill neutral" title="@L["Ape_TaFromSourceTitle"]"><Icon Name="key" Size="11" /> @L["Ape_FromSource"]</span>
            <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_TaFromSourceAria"]" ExtraClass="wide">@L["Ape_TaFromSource"]</HelpHint>
        }
    </div>
    @{ var problemi = AirportTlValidation.Issues(Rows); }
    @if (problemi.Count > 0)
    {
        <div class="callout warning"><span class="cic">⚠️</span><div>@foreach (var p in problemi) { <div>@L[p.Key, p.Args]</div> }</div></div>
    }
    <div class="se-row">
        <label><b>@L["Ape_TaLabel"]</b></label>
        <input type="number" style="width:100px" value="@TransitionAltitudeFt"
               @onchange="e => TransitionAltitudeFtChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var v) ? v : null)"
               disabled="@SourceLocked" />
        <button class="btn primary" disabled="@(Busy || !CanEdit || SourceLocked)" @onclick="() => OnSaveTa.InvokeAsync()">@L["Ape_SaveTa"]</button>
    </div>
    <table class="res-table" style="max-width:460px">
        <thead><tr><th>@L["Ape_QnhFrom"]</th><th>@L["Ape_QnhTo"]</th><th>Transition Level</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in Rows)
            {
                <tr @key="t">
                    <td><input type="number" style="width:90px" @bind="t.From" placeholder="@L["Ape_Open"]" /></td>
                    <td><input type="number" style="width:90px" @bind="t.To" placeholder="@L["Ape_Open"]" /></td>
                    <td><input style="width:90px" @bind="t.Level" placeholder="FL75" /></td>
                    <td><button class="btn ghost" @onclick="() => Rimuovi(t)">✕</button></td>
                </tr>
            }
        </tbody>
    </table>
    <div style="margin-top:10px;display:flex;gap:8px">
        <button class="btn ghost" @onclick="Aggiungi">+ @L["Dse_Row"]</button>
        <button class="btn primary" disabled="@(Busy || !CanEdit)" @onclick="() => OnSaveRows.InvokeAsync()">@L["Ape_SaveTable"]</button>
    </div>
</div>

@code {
    /// <summary>Le righe in lavorazione. Il componente le muta in posto (è ciò che <c>@@bind</c> fa) e avvisa
    /// l'host con <see cref="OnChanged"/>: l'host decide quando salvarle.</summary>
    [Parameter, EditorRequired] public List<TlEdit> Rows { get; set; } = new();

    /// <summary>La quota di transizione dello scalo.</summary>
    [Parameter] public int? TransitionAltitudeFt { get; set; }
    [Parameter] public EventCallback<int?> TransitionAltitudeFtChanged { get; set; }

    /// <summary>La TA arriva dalla sorgente IVAO: non si tocca, e il chip lo dice.</summary>
    [Parameter] public bool SourceLocked { get; set; }

    /// <summary>Un salvataggio è in corso: i tasti si spengono.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Chi guarda ha il permesso di scrivere su questo scalo.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>Qualcosa è cambiato: l'host segna la sezione fra quelle non salvate.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public EventCallback OnSaveTa { get; set; }
    [Parameter] public EventCallback OnSaveRows { get; set; }

    /// <summary>Chiede conferma prima di togliere una riga. L'host la fa col dialogo del browser; null = non
    /// si chiede. È un parametro e non una chiamata JS diretta perché così il componente resta montabile in
    /// una prova, dove un dialogo del browser non c'è.</summary>
    [Parameter] public Func<Task<bool>>? ConfirmRemove { get; set; }

    private async Task Aggiungi()
    {
        Rows.Add(new TlEdit());
        await OnChanged.InvokeAsync();
    }

    private async Task Rimuovi(TlEdit t)
    {
        if (ConfirmRemove is not null && !await ConfirmRemove()) return;
        Rows.Remove(t);
        await OnChanged.InvokeAsync();
    }
}
