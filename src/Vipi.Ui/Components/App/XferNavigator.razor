@inject IStringLocalizer<SharedResource> L

@*
    Colonna 1: l'albero degli accordi. Controparte ▸ accordo, e l'accordo è una FOGLIA — si sceglie, non si apre.

    L'asse è cambiato con il modello: prima era settore ▸ aeroporto ▸ gruppo, cioè l'ordine in cui il modello
    vecchio costringeva a SCRIVERE. Adesso è la controparte, che è il modo in cui un accordo viene in mente —
    «l'accordo con Roma», non «il flusso del settore ES verso l'aeroporto di Bari». Un livello in meno, e
    l'aeroporto smette di essere un ramo: è un attributo dell'accordo, che può averne quattro.

    Gli avvisi risalgono: un accordo senza ricevente accende il pallino sulla propria controparte. Un avviso che
    si vede solo dopo aver aperto il ramo giusto non è un avviso.
*@

<div class="xt-nav">
    <div class="xt-nav-head">
        <b>@L["Xfer_NavTitle"]</b>
        <span class="muted xt-hint">@(string.Format(L["Xfer_GroupsN"].Value, Counterparts.Sum(c => c.AgreementCount)))</span>
    </div>

    <div class="xt-nav-body">
        @if (Counterparts.Count == 0)
        {
            @* Elenco vuoto: senza questo la colonna sembra rotta, e — con i filtri accesi — non si capisce che
               è il filtro a nascondere tutto invece che l'archivio a essere vuoto. *@
            <p class="help xt-nav-empty">@(Filtered ? L["Xfer_NoFilterMatch"] : L["Xfer_NoFlows"])</p>
        }
        @foreach (var cp in Counterparts)
        {
            var open = ForceOpen || !Collapsed.Contains(cp.Key);
            <div class="xt-nav-sec xt-clickable" role="button" tabindex="0" aria-expanded="@open"
                 @onclick="() => OnToggle.InvokeAsync(cp.Key)"
                 @onkeydown="e => Activate(e, () => OnToggle.InvokeAsync(cp.Key))">
                <span class="xt-chev">@(open ? "▾" : "▸")</span>
                <span class="xt-nav-name">@cp.Label</span>
                @if (cp.HasWarning) { <span class="xt-nav-warn" title="@L["Xfer_NavWarnTitle"]">●</span> }
                <span class="xt-nav-count">@cp.AgreementCount</span>
            </div>
            @if (!open) { continue; }

            foreach (var a in cp.Agreements)
            {
                <button type="button" class="xt-nav-flow @(a.Id == SelectedId ? "on" : "")"
                        title="@a.Description" @onclick="() => OnSelect.InvokeAsync(a.Id)">
                    <span class="xt-nav-kind">@XferLabels.Kind(L, a.Kind)</span>
                    @* Gli aeroporti stanno QUI e non su un ramo proprio: un accordo può averne quattro, e
                       quattro rami che portano tutti alla stessa tabella sarebbero quattro modi di aprire la
                       stessa cosa. *@
                    @if (a.Airports.Length > 0)
                    {
                        <span class="xt-nav-desc">@a.Airports</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(a.Description))
                    {
                        <span class="xt-nav-desc">@a.Description</span>
                    }
                    @* Due versi = accordo bilaterale, e si vede senza aprirlo: è l'informazione che dice se il
                       reciproco è già stato scritto o è ancora da fare. *@
                    @if (a.Directions > 1) { <span class="pill blue xt-nav-bi" title="@L["Xfer_BidirectionalTitle"]">⇄</span> }
                    @if (a.HasWarning) { <span class="xt-nav-warn" title="@WarnTitle(a)">●</span> }
                    <span class="xt-nav-count">@a.ClauseCount</span>
                </button>
            }
        }
    </div>

    @* Il tasto sta FUORI dal corpo che scorre, ed è l'unico modo di creare il primo accordo: con l'archivio
       vuoto l'albero non ha nodi, e un ingresso che vive dentro l'elenco non esisterebbe proprio quando serve. *@
    <div class="xt-nav-foot">
        <button class="btn ghost" disabled="@Disabled" @onclick="() => OnNew.InvokeAsync()">+ @L["Xfer_Agreement"]</button>
    </div>
</div>

@code {
    /// <summary>L'albero già costruito dalla pagina (filtri applicati).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<XferNavCounterpart> Counterparts { get; set; } = Array.Empty<XferNavCounterpart>();

    /// <summary>L'accordo aperto nel riquadro di lavoro.</summary>
    [Parameter] public int? SelectedId { get; set; }

    [Parameter] public IReadOnlySet<string> Collapsed { get; set; } = new HashSet<string>();

    /// <summary>Un filtro attivo apre l'albero: quello che resta va visto, non ricercato a mano cliccando.</summary>
    [Parameter] public bool ForceOpen { get; set; }

    /// <summary>C'è un filtro attivo: cambia cosa dice l'elenco vuoto.</summary>
    [Parameter] public bool Filtered { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }

    /// <summary>Cosa dice il pallino d'avviso: il traffico finisce a UNICOM, o ci sono clausole da rivedere.</summary>
    private string WarnTitle(XferNavAgreement a)
    {
        var parts = new List<string>(2);
        if (a.NoReceiver) parts.Add(L["Xfer_NoReceiverFilter"]);
        if (a.ToReview > 0) parts.Add($"{a.ToReview} · {L["Xfer_ToReview"]}");
        return string.Join(" · ", parts);
    }

    /// <summary>Invio/Spazio sui nodi non-<c>button</c>: senza, l'albero si apre solo col mouse.</summary>
    private static Task Activate(KeyboardEventArgs e, Func<Task> action) =>
        e.Key is "Enter" or " " or "Spacebar" ? action() : Task.CompletedTask;
}
