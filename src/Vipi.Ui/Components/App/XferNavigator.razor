@inject IStringLocalizer<SharedResource> L

@*
    Colonna 1: l'albero degli accordi. ACC della controparte ▸ ACCORDO, e l'accordo è una FOGLIA — si sceglie,
    non si apre. Dentro ci sono le sue sezioni, che stanno nel riquadro di lavoro.

    L'asse è cambiato quattro volte. Prima settore ▸ aeroporto ▸ gruppo, cioè l'ordine in cui il modello di
    luglio costringeva a SCRIVERE. Poi «la controparte», ma con la chiave sul lato B: e per gli accordi in cui la
    ACC aperta È il lato B — 13 su 40 per LIBB, 10 su 11 per LIRR — il ramo prendeva il nome dei nostri stessi
    settori. Poi ACC ▸ relazione ▸ accordo, perché una coppia poteva avere PIÙ accordi (LIBB ⇄ LGGG ne aveva
    otto). Dal 18 agosto 2026 non può: la relazione È l'accordo, e il livello in mezzo è sparito insieme alla
    ragione che lo teneva in piedi.

    I callsign sono INTERI: abbreviarli in «ES ⇄ CS0» sarebbe un secondo modo di nominare gli enti in una
    colonna che già li scrive per esteso. Se lo spazio stringe taglia il CSS, e il titolo porta la coppia piena.

    Gli avvisi risalgono fino all'ACC: un avviso che si vede solo dopo aver aperto il ramo giusto non è un avviso.
*@

<div class="xt-nav">
    <div class="xt-nav-head">
        <b>@L["Xfer_NavTitle"]</b>
        <span class="muted xt-hint">@(string.Format(L["Xfer_GroupsN"].Value, Counterparts.Sum(c => c.AgreementCount)))</span>
    </div>

    <div class="xt-nav-body">
        @if (Counterparts.Count == 0)
        {
            @* Elenco vuoto: senza questo la colonna sembra rotta, e — con i filtri accesi — non si capisce che
               è il filtro a nascondere tutto invece che l'archivio a essere vuoto. *@
            <p class="help xt-nav-empty">@(Filtered ? L["Xfer_NoFilterMatch"] : L["Xfer_NoFlows"])</p>
        }
        @foreach (var cp in Counterparts)
        {
            var open = ForceOpen || !Collapsed.Contains(cp.Key);
            @* ⚠️ La stringa, non il bool: `aria-expanded="@bool"` in Blazor è un attributo booleano HTML —
               `true` diventa `aria-expanded=""` e `false` sparisce, e un attributo assente dice «non
               espandibile», non «chiuso». *@
            <div class="xt-nav-sec xt-clickable" role="button" tabindex="0" aria-expanded="@open.ToString().ToLowerInvariant()"
                 @onclick="() => OnToggle.InvokeAsync(cp.Key)"
                 @onkeydown="e => Activate(e, () => OnToggle.InvokeAsync(cp.Key))">
                <span class="xt-chev">@(open ? "▾" : "▸")</span>
                <span class="xt-nav-name">@cp.Label</span>
                @if (!string.IsNullOrWhiteSpace(cp.Note)) { <span class="muted xt-nav-note">@cp.Note</span> }
                @if (cp.HasWarning) { <span class="xt-nav-warn" title="@L["Xfer_NavWarnTitle"]">●</span> }
                <span class="xt-nav-count">@cp.AgreementCount</span>
            </div>
            @if (!open) { continue; }

            foreach (var a in cp.Agreements)
            {
                <button type="button" class="xt-nav-flow @(a.Id == SelectedId ? "on" : "")"
                        title="@($"{a.Near} ⇄ {a.Far}")" @onclick="() => OnSelect.InvokeAsync(a.Id)">
                    @* La COPPIA, per esteso: è ciò che identifica l'accordo adesso che ne esiste uno solo per
                       relazione. L'ACC da sola non distingue LIRR_TS_CTR da LIRN_US0_APP. *@
                    <span class="xt-nav-relnear">@a.Near</span>
                    <span class="xt-nav-relway">⇄</span>
                    <span class="xt-nav-relfar">@a.Far</span>
                    @if (a.HasWarning) { <span class="xt-nav-warn" title="@WarnTitle(a)">●</span> }
                    @* SEZIONI e clausole, non il totale delle sole clausole: un accordo con sei sezioni e due
                       clausole è scritto a metà, e il solo «2» non lo direbbe. *@
                    <span class="xt-nav-count" title="@CountsTitle(a)">@a.Sections ▤ @a.Clauses</span>
                    @* ⚠️ La nota sta DOPO il conteggio e va a capo da sola (`flex-basis:100%`). Messa prima,
                       rubava la riga al conteggio e mandava a capo QUELLO — su ogni foglia, anche su quelle
                       senza nota, perché il wrap è una proprietà della riga. Così le foglie senza nota tornano a
                       una riga sola. *@
                    @if (!string.IsNullOrWhiteSpace(a.Note))
                    {
                        <span class="xt-nav-desc">@a.Note</span>
                    }
                </button>
            }
        }
    </div>

    @* Il tasto sta FUORI dal corpo che scorre, ed è l'unico modo di creare il primo accordo: con l'archivio
       vuoto l'albero non ha nodi, e un ingresso che vive dentro l'elenco non esisterebbe proprio quando serve. *@
    <div class="xt-nav-foot">
        <button class="btn ghost" disabled="@Disabled" @onclick="() => OnNew.InvokeAsync()">+ @L["Xfer_Agreement"]</button>
    </div>
</div>

@code {
    /// <summary>L'albero già costruito dalla pagina (filtri applicati, orientamento risolto).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<XferNavCounterpart> Counterparts { get; set; } = Array.Empty<XferNavCounterpart>();

    /// <summary>L'accordo aperto nel riquadro di lavoro.</summary>
    [Parameter] public int? SelectedId { get; set; }

    [Parameter] public IReadOnlySet<string> Collapsed { get; set; } = new HashSet<string>();

    /// <summary>Un filtro attivo apre l'albero: quello che resta va visto, non ricercato a mano cliccando.</summary>
    [Parameter] public bool ForceOpen { get; set; }

    /// <summary>C'è un filtro attivo: cambia cosa dice l'elenco vuoto.</summary>
    [Parameter] public bool Filtered { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }

    /// <summary>Cosa dice il pallino d'avviso: un reciproco che manca, o clausole da rivedere.</summary>
    private string WarnTitle(XferNavAgreement a)
    {
        var parts = new List<string>(2);
        if (a.MissingReverse > 0) parts.Add(L["Xfer_NavMissingReciprocal"]);
        if (a.ToReview > 0) parts.Add($"{a.ToReview} · {L["Xfer_ToReview"]}");
        return string.Join(" · ", parts);
    }

    /// <summary>Cosa dicono i due conteggi della foglia.</summary>
    private string CountsTitle(XferNavAgreement a) =>
        $"{XferLabels.Sections(L, a.Sections)} · {XferLabels.Clauses(L, a.Clauses)}";

    /// <summary>Invio/Spazio sui nodi non-<c>button</c>: senza, l'albero si apre solo col mouse.</summary>
    private static Task Activate(KeyboardEventArgs e, Func<Task> action) =>
        e.Key is "Enter" or " " or "Spacebar" ? action() : Task.CompletedTask;
}
