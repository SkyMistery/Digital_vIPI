@* La sezione «METAR & TAF» in scrittura: da quale stazione prendere il bollettino (15 settembre 2026, committente:
   LIRJ non emette un METAR suo).

   ⚠️ Il dato è dell'ANAGRAFICA dello scalo (`Airport.MetarStationIcao`), non del documento: lo stesso METAR decide
   la pista in uso, il QNH delle quote di transizione e lo stato LVP, in vIPI, vSOP e vAWOS. Per questo la
   montano l'editor d'aeroporto e — sul solo campo senza vIPI civile — quello del vSOP, come gli altri dati dello
   scalo. Il cancello è `Editing` (il lock), letto come ramo di render come negli editor fratelli. *@
@inject IStringLocalizer<SharedResource> L

<div class="callout info" style="margin:0 0 10px">
    <span class="cic"><Icon Name="cloud" Size="18" /></span>
    <div><p class="ct">@L["Ape_WeatherTitle"]</p>@L["Ape_WeatherBody"]</div>
</div>
<div class="se-row">
    <label><b>@L["Wx_StationLabel"]</b></label>
    @if (Editing)
    {
        <input style="width:90px;text-transform:uppercase" maxlength="4" placeholder="@Icao" value="@Value"
               @onchange="Cambiata" aria-label="@L["Wx_StationLabel"]" />
    }
    else
    {
        <b>@(string.IsNullOrWhiteSpace(Value) ? Icao : Value)</b>
    }
    <span class="muted">@L["Wx_StationHint"]</span>
</div>

@code {
    /// <summary>Lo scalo del documento: è il riferimento quando il campo è vuoto.</summary>
    [Parameter, EditorRequired] public string Icao { get; set; } = "";

    /// <summary>La stazione scritta, o null/vuoto per lo scalo stesso.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public bool Editing { get; set; }

    /// <summary>Avvisa l'host, che salva subito dalla sua porta (come la TA).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private Task Cambiata(ChangeEventArgs e)
    {
        var v = (e.Value?.ToString() ?? "").Trim().ToUpperInvariant();
        return ValueChanged.InvokeAsync(v.Length == 0 ? null : v);
    }
}
