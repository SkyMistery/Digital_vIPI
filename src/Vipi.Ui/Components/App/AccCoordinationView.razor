@* Coordinamenti ACC: un'unica gerarchia Settore(NE) → ACC → Aeroporto → Arrivi/Partenze. *@
@* English=true → stessa struttura con etichette in inglese (usato dalle vLOA, documenti bilaterali). *@
@* All'apertura del documento è espanso il SOLO livello settore: dentro, un ACC ha decine di aeroporti e ognuno
   arrivi+partenze, quindi tutto aperto seppelliva il resto del documento. I livelli interni si aprono a richiesta
   (o in blocco con «Espandi tutto»); la stampa li apre comunque da sé (beforeprint in vipi-ui.js). *@
<p class="muted" style="margin-top:0;font-size:13.5px">@Intro</p>

@if (Coord.Sectors.Count == 0)
{
    <p class="muted" style="margin:0">@EmptyMsg</p>
}

<div class="coord-wrap">
@if (Coord.Sectors.Count > 0)
{
    @CoordTools()
}
@foreach (var s in Coord.Sectors)
{
    <details class="coord-sub" open>
        <summary><span>@s.SectorLabel</span><span class="chev">▸</span></summary>
        <div class="body">
            @CoordTools()
            @foreach (var acc in s.Accs)
            {
                <details class="coord-sub2">
                    <summary><span>@acc.AccLabel</span><span class="chev">▸</span></summary>
                    <div class="body">
                        @CoordTools()
                        @foreach (var ap in acc.Airports)
                        {
                            <details class="coord-sub2">
                                <summary><span>@ap.AirportLabel</span><span class="chev">▸</span></summary>
                                <div class="body">
                                    @if (ap.Arrivals.Count > 0)
                                    {
                                        <p class="muted" style="margin:.4em 0 .1em;font-weight:600">@ArrivalsLabel</p>
                                        @RenderTable(ap.Arrivals)
                                    }
                                    @if (ap.Departures.Count > 0)
                                    {
                                        <p class="muted" style="margin:.4em 0 .1em;font-weight:600">@DeparturesLabel</p>
                                        @RenderTable(ap.Departures)
                                    }
                                </div>
                            </details>
                        }
                        @foreach (var ex in acc.Extras)
                        {
                            <details class="coord-sub2">
                                <summary><span>@ex.KindLabel</span><span class="chev">▸</span></summary>
                                <div class="body">
                                    @RenderTable(ex.Rows)
                                </div>
                            </details>
                        }
                    </div>
                </details>
            }
        </div>
    </details>
}
</div>

@code {
    [Parameter, EditorRequired] public AccCoordination Coord { get; set; } = AccCoordination.Empty;

    /// <summary>Etichette in inglese (vLOA). Default false = italiano (vIPI ACC).</summary>
    [Parameter] public bool English { get; set; }

    private string Intro => English
        ? "Sector transfers, grouped by sector → ACC → airport → arrivals/departures. Derived from the configured flows."
        : "Trasferimenti dei settori del blocco, per settore → ACC dell'aeroporto → aeroporto → arrivi/partenze. Derivati dai flussi configurati.";
    private string EmptyMsg => English ? "No coordination configured." : "Nessun coordinamento configurato per questo blocco.";
    private string ArrivalsLabel => English ? "Arrivals" : "Arrivi";
    private string DeparturesLabel => English ? "Departures" : "Partenze";

    // Controlli espandi/comprimi tutto (sezione + sottosezioni). Dentro un <details> agiscono sul suo sottoalbero;
    // in testa al blocco (fuori dai details) su tutti i coordinamenti. Vedi vipiDetails in vipi-ui.js.
    private RenderFragment CoordTools() => __builder =>
    {
        <div class="coord-tools">
            <button type="button" onclick="vipiDetails(this,true)">⊕ @(English ? "Expand all" : "Espandi tutto")</button>
            <button type="button" onclick="vipiDetails(this,false)">⊖ @(English ? "Collapse all" : "Comprimi tutto")</button>
        </div>
    };

    // La tabella è la stessa della vIPI APP e della vLOA: sta in CoordTable, che sa anche quali colonne
    // mostrare (per presenza di dati) e come rendere i gruppi di varianti.
    private RenderFragment RenderTable(IReadOnlyList<AppCoordRow> rows) => __builder =>
    {
        @* Nessun LastColHeader: lo decide CoordTable, che in italiano lo prende dalle risorse e in inglese lo
           scrive in inglese. Qui c'era «Prossimo» scritto a mano, e con l'interfaccia in inglese usciva una
           testata mezza tradotta: VIA · CLEARED · TRANSFER · TRANSFER LEVEL · **PROSSIMO** · CONDITION. *@
        <CoordTable Rows="rows" English="English" />
    };
}
