@* La tabella «spazi aerei» sotto la mappa AoR (carta docs/feature/2026-09-17-tabella-spazi-aerei-nell-aor.md):
   i volumi dell'AIP agganciati ai settori del documento — nome, base, tetto, classe, note.

   ⚠️ Nome, base e tetto NON si scrivono a mano: vengono dal KMZ, nella grafia del file («4500 FT AMSL»), che è
   quel che il documento deve stampare. Si scrivono solo la CLASSE — il file la dà su 1 CTR su 114 — e la NOTA.
   Stessa divisione della tabella «Aree di lavoro» (`MilWorkingAreas`).

   ⚠️ La disegna `AccAor`, non le pagine: così le quattro pagine che mostrano un'AoR (editor e lettore, APP e
   ACC) la hanno senza una riga ciascuna, e non possono divergere. *@
@inject IStringLocalizer<SharedResource> L
@using Vipi.Application.Content

@if (Rows.Count > 0)
{
    <div class="aorasp-wrap">
        <h4 class="aorasp-title">@L["Aor_AirspacesTitle"]</h4>
        <table class="res-table mil-table aorasp-table">
            <thead>
                <tr>
                    <th>@L["Aor_AirspaceName"]</th>
                    <th class="c-alt">@L["Aor_AirspaceBase"]</th>
                    <th class="c-alt">@L["Aor_AirspaceTop"]</th>
                    <th class="c-cls">@L["Aor_AirspaceClass"]</th>
                    <th class="c-note">@L["Area_Notes"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Rows)
                {
                    var row = r;
                    <tr>
                        <td><b>@row.Name</b></td>
                        <td class="c-alt">@row.BaseRaw</td>
                        <td class="c-alt">@row.TopRaw</td>
                        <td class="c-cls">
                            @if (Editing)
                            {
                                @* ⚠️ Una tendina e non un campo libero: la classe ICAO è una lettera A…G, e un «d»,
                                   un «CTR» o un «D (H24)» scritti a mano sarebbero dati che la stampa ripete. La
                                   voce vuota dice la classe del FILE quando c'è: scegliere «vuoto» torna a quella. *@
                                <select class="aorasp-cls" aria-label="@L["Aor_AirspaceClass"]"
                                        @onchange="e => OnSet.InvokeAsync((row.VolumeKey, e.Value?.ToString(), row.Note))">
                                    <option value="" selected="@(row.EditedClass is null)">@(row.FileClass is { } f ? L["Aor_AirspaceClassFromFile", f].Value : "—")</option>
                                    @foreach (var c in Classi)
                                    {
                                        <option value="@c" selected="@(row.EditedClass == c)">@c</option>
                                    }
                                </select>
                            }
                            else
                            {
                                @(row.Class ?? "—")
                            }
                        </td>
                        <td class="c-note">
                            @if (Editing)
                            {
                                @* `@onchange` e non `@oninput`: si salva quando il campo perde il fuoco (come in
                                   `MilWorkingAreas`), non un giro di salvataggio per carattere. *@
                                <textarea class="in-note" rows="2" value="@row.Note" data-adatta
                                          @onchange="e => OnSet.InvokeAsync((row.VolumeKey, row.EditedClass, e.Value?.ToString()))"
                                          placeholder="@L["Area_NotesPlaceholder"]" aria-label="@L["Area_Notes"]"></textarea>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(row.Note) ? "—" : row.Note)
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly string[] Classi = { "A", "B", "C", "D", "E", "F", "G" };

    [Parameter, EditorRequired] public IReadOnlyList<AorAirspaceRow> Rows { get; set; } = Array.Empty<AorAirspaceRow>();

    [Parameter] public bool Editing { get; set; }

    /// <summary>Cambia classe e nota di UN volume (chiave naturale, classe scritta a mano, nota).</summary>
    [Parameter] public EventCallback<(string VolumeKey, string? Class, string? Note)> OnSet { get; set; }
}
