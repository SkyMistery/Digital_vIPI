@* L'editor della sezione «Regole piste»: si applica la PRIMA regola le cui condizioni sono soddisfatte,
   quindi l'ordine è la regola stessa — e per questo si trascina e si sposta con le frecce.

   ⚠️ Componente a parte da <AirportRunwayRules>, che è la lettura, e qui la ragione è più forte che altrove:
   la lettura è una tabella di 35 righe, questo è un attrezzo da 128 con trascinamento, campi avanzati e un
   banco di prova. Fonderli col flag `Editing` darebbe un componente peggiore di entrambi (doc 14 §3g).

   Il BANCO DI PROVA — dai un vento E UN MOMENTO, ti dice quale regola vince — vive qui dentro e non salva
   niente: è il modo in cui chi scrive le regole verifica di averle messe nell'ordine giusto prima di
   pubblicarle. ⚠️ Il momento serve quanto il vento: senza, orari, giorni, parità e stagione erano gli unici
   campi della regola che non si potevano provare, perché la prova girava sempre sull'istante reale.

   ⚠️ Niente tasto «Salva» e niente `CanEdit` dal 4 settembre 2026 (carta 2026-09-04-aeroporto-porta-sola):
   ogni gesto avvisa l'host, che salva subito. Il cancello è `Editing` — il lock del documento — e senza non
   ci sono né campi né trascinamento. Il BANCO DI PROVA resta acceso comunque: non scrive niente, e serve
   anche a chi sta solo leggendo le regole di uno scalo. *@
@using Vipi.Application.Weather
@inject IStringLocalizer<SharedResource> L

@* ⚠️ Niente `@onchange` sul contenitore: c'era e NON funzionava. Misurato il 4 settembre 2026 — il valore
   entrava nel modello (quindi il `change` del DOM partiva e Blazor lo gestiva sull'input) ma il gestore del
   `div` non veniva mai chiamato, quindi la pagina non sapeva che c'era qualcosa da salvare. L'aggancio sta
   ora su ogni campo EDITORIALE con `@bind:after`. *@
<div>
    @* ⚠️ Niente titolo qui dentro: lo dice l'intestazione della SEZIONE. Ripeterlo faceva leggere due volte
       la stessa cosa a due righe di distanza — «Regole piste» e poi «Runway selection rules». *@
    <div class="ed-h3 ed-h3-mini">
        <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_RwRulesHelpAria"]" ExtraClass="wide">
            @((MarkupString)L["Ape_RwRulesHelp"].Value)
            <p>@L["Ape_RwRulesHelp2"]</p>
        </HelpHint>
    </div>

    @{ var problemi = AirportRuleValidation.Issues(Rows, RunwayIdents, NeverUseIdents); }
    @if (problemi.Errors.Count > 0)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@foreach (var e in problemi.Errors) { <div>@L[e.Key, e.Args]</div> }</div></div>
    }
    @if (problemi.Warnings.Count > 0)
    {
        <div class="callout warning"><span class="cic">⚠️</span><div>@foreach (var a in problemi.Warnings) { <div>@L[a.Key, a.Args]</div> }</div></div>
    }

    @foreach (var (r, idx) in Rows.Select((r, i) => (r, i)))
    {
        <div class="rule-card" @key="r"
             style="@(_provaFatta && _vincente?.RuleIndex == idx ? "outline:2px solid var(--ivao-blue);outline-offset:2px" : null)"
             @ondragover:preventDefault="true" @ondragenter="() => TrascinaSopra(idx)" @ondrop="Rilascia" @ondragend="() => _trascinata = null">
            <div class="rule-head">
                @if (Editing) { <span class="app-drag" draggable="true" @ondragstart="() => _trascinata = idx" title="@L["Ape_DragToReorder"]">⠿</span> }
                <span class="rule-ord">#@(idx + 1)@if (_provaFatta && _vincente?.RuleIndex == idx) { <span title="@L["Ape_TestWinner"]"> ✓</span> }</span>
                @if (!Editing && !string.IsNullOrWhiteSpace(r.Name)) { <b>@r.Name</b> }
                @if (Editing)
                {
                    <div style="display:flex;gap:6px">
                        <button class="btn ghost" disabled="@(idx == 0)" @onclick="() => Sposta(idx, -1)" title="@L["Common_Up"]">↑</button>
                        <button class="btn ghost" disabled="@(idx == Rows.Count - 1)" @onclick="() => Sposta(idx, 1)" title="@L["Common_Down"]">↓</button>
                        <button class="btn ghost" @onclick="() => Rimuovi(r)">✕ @L["Common_Remove"]</button>
                    </div>
                }
            </div>
            <div class="rule-rwys">
                <div><span class="muted">DEP:</span>
                    @if (RunwayIdents.Count == 0) { <i class="muted">@L["Ape_NoRwDefined"]</i> }
                    @foreach (var ident in RunwayIdents)
                    {
                        var id = ident;
                        @if (Editing)
                        {
                            <button type="button" class="pill" style="@Chip(r.Dep, id)" @onclick="() => Commuta(r.Dep, id)">@id</button>
                        }
                        else if (r.Dep.Contains(id))
                        {
                            <span class="pill" style="@Chip(r.Dep, id)">@id</span>
                        }
                    }
                </div>
                <div><span class="muted">ARR:</span>
                    @foreach (var ident in RunwayIdents)
                    {
                        var id = ident;
                        @if (Editing)
                        {
                            <button type="button" class="pill" style="@Chip(r.Arr, id)" @onclick="() => Commuta(r.Arr, id)">@id</button>
                        }
                        else if (r.Arr.Contains(id))
                        {
                            <span class="pill" style="@Chip(r.Arr, id)">@id</span>
                        }
                    }
                </div>
            </div>
            @if (Editing)
            {
                <div class="rule-grid">
                    <label>@L["Ape_MaxTail"]<input type="number" min="0" max="40" @bind="r.MaxTail" @bind:after="Cambiato" /></label>
                    <label>@L["Ape_MaxCross"]<input type="number" min="0" max="60" placeholder="—" @bind="r.MaxCross" @bind:after="Cambiato" /></label>
                    <label>@L["Ape_Surface"]<select @bind="r.Surface" @bind:after="Cambiato"><option value="any">@L["Ape_SurfAny"]</option><option value="dry">@L["Ape_SurfDry"]</option><option value="wet">@L["Ape_SurfWet"]</option></select></label>
                    <label>@L["Airport_Name"]<input @bind="r.Name" @bind:after="Cambiato" placeholder="@L["Ape_RuleNamePh"]" /></label>
                    <label>@L["Ape_Notes"]<input @bind="r.Note" @bind:after="Cambiato" placeholder="@L["Ape_FreeText"]" /></label>
                </div>
                <details class="rule-adv">
                    <summary>@L["Ape_Advanced"]</summary>
                    <div class="rule-grid" style="margin-top:8px">
                        <label>@L["Ape_TimeFrom"]<input type="time" @bind="r.TimeFrom" @bind:after="Cambiato" /></label>
                        @* ⚠️ Il gettone non è decorazione: 22:00→05:00 è una finestra che SCAVALCA, e senza dirlo
                           nessuno sa se le 05:00 sono di stamattina o di domani. Il motore la legge come «la notte
                           di quel giorno» (RunwaySuggestion.GiornoOperativo), e qui lo si vede scrivendola. *@
                        <label>@L["Ape_TimeTo"]
                            <span style="display:flex;gap:6px;align-items:center">
                                <input type="time" @bind="r.TimeTo" @bind:after="Cambiato" style="flex:1;min-width:0" />
                                @if (Scavalca(r)) { <span class="pill" style="background:var(--tint-yellow-soft);color:var(--warn-ink);white-space:nowrap" title="@L["Ape_NextDayTitle"]">@L["Ape_NextDay"]</span> }
                            </span>
                        </label>
                        <label>@L["Ape_DayParity"]<select @bind="r.Parity" @bind:after="Cambiato"><option value="">@L["Ape_SurfAny"]</option><option value="even">@L["Ape_Even"]</option><option value="odd">@L["Ape_Odd"]</option></select></label>
                        <label>@L["Ape_ValidFrom"]
                            <span style="display:flex;gap:4px">
                                <select @bind="r.DateFromDay" @bind:after="Cambiato" style="flex:1">@Giorni()</select>
                                <select @bind="r.DateFromMonth" @bind:after="Cambiato" style="flex:2">@Mesi()</select>
                            </span>
                        </label>
                        <label>@L["Ape_ValidTo"]
                            <span style="display:flex;gap:4px">
                                <select @bind="r.DateToDay" @bind:after="Cambiato" style="flex:1">@Giorni()</select>
                                <select @bind="r.DateToMonth" @bind:after="Cambiato" style="flex:2">@Mesi()</select>
                            </span>
                        </label>
                    </div>
                    <div class="ed-h3 ed-h3-mini">
                        <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_SeasonalHelpAria"]" ExtraClass="wide">@((MarkupString)L["Ape_SeasonalHelp"].Value)</HelpHint>
                        <span class="muted">@L["Ape_SeasonalShort"]</span>
                    </div>
                    <div class="rule-days">
                        <span class="muted">@L["Ape_Days"]</span>
                        @for (var b = 0; b < 7; b++)
                        {
                            var bit = b;
                            <button type="button" class="pill" style="@ChipGiorno(r, bit)" @onclick="() => CommutaGiorno(r, bit)">@NomiGiorni[bit]</button>
                        }
                    </div>
                </details>
            }
            else
            {
                <div class="muted" style="font-size:12.5px">@Riassunto(r)</div>
                @if (!string.IsNullOrWhiteSpace(r.Note)) { <div style="font-size:12.5px">@r.Note</div> }
            }
        </div>
    }

    @if (Editing)
    {
        @* ⚠️ Una regola che non nomina nessuna pista non sceglie niente, e in archivio non ci va. Prima era
           un tasto «Salva» spento; ora è il GESTO che non scrive (AirportSaveGate.Rules), e la riga qui
           accanto lo dice. Il service la rifiuterebbe comunque: questo evita solo di provarci a ogni tasto. *@
        <div style="margin-top:10px;display:flex;gap:8px;align-items:center">
            <button class="btn ghost" @onclick="Aggiungi">+ @L["Ape_Rule"]</button>
            @if (!AirportSaveGate.Rules(Rows)) { <span class="muted">@L["Ape_RowIncomplete"]</span> }
        </div>
    }

    @* --- Il banco di prova: prova le regole con un vento arbitrario. Non salva nulla. --- *@
    <div class="block" style="margin-top:12px;background:var(--surface-soft)">
        <div class="se-row" style="flex-wrap:wrap;align-items:end;gap:10px">
            <label style="display:flex;flex-direction:column;font-size:12px">@L["Ape_TestWindFrom"]
                <input type="number" min="0" max="360" style="width:90px" @bind="_provaDir" placeholder="@L["Ape_WindCalm"]" /></label>
            <label style="display:flex;flex-direction:column;font-size:12px">@L["Ape_TestWindKt"]
                <input type="number" min="0" max="99" style="width:80px" @bind="_provaKt" /></label>
            <label style="display:flex;align-items:center;gap:4px;font-size:12px"><input type="checkbox" @bind="_provaBagnata" /> @L["Ape_SurfWet"]</label>
            @* ⚠️ UN campo solo, e non una tendina «giorno della settimana» accanto a un orario: da un istante
               si ricavano giorno, ora, parità e stagione TUTTI E QUATTRO, e sono per forza coerenti fra loro.
               Con quattro campi separati si potevano provare condizioni che nella realtà non capitano mai. *@
            <label style="display:flex;flex-direction:column;font-size:12px">@L["Ape_TestWhen"]
                <input type="datetime-local" style="width:200px" @bind="_provaQuando" /></label>
            <button type="button" class="btn ghost" @onclick="() => _provaQuando = Adesso()" title="@L["Ape_TestNowTitle"]">@L["Ape_TestNow"]</button>
            <span class="muted" style="font-size:12px;align-self:center">@GiornoScelto()</span>
            <button type="button" class="btn ghost" @onclick="Prova">▷ @L["Ape_TestRun"]</button>
            @if (_provaFatta) { <button type="button" class="btn ghost" @onclick="() => _provaFatta = false">✕ @L["Ape_TestClear"]</button> }
        </div>
        @if (_provaFatta)
        {
            @if (_vincente is not null)
            {
                <div class="callout success" style="margin-top:8px"><span class="cic">✓</span><div>
                    <b>@L["Ape_TestRuleN", _vincente.RuleIndex + 1]@(string.IsNullOrWhiteSpace(_vincente.RuleName) ? "" : $" · {_vincente.RuleName}")</b> —
                    DEP <b>@_vincente.Dep</b> · ARR <b>@_vincente.Arr</b>@if (!string.IsNullOrWhiteSpace(_vincente.Note)) { <text> (@_vincente.Note)</text> }
                    @VentoSullePiste(PisteInUso())
                </div></div>
            }
            else
            {
                <div class="callout warning" style="margin-top:8px"><span class="cic">⚠️</span><div>
                    @if (_ripiego?.Best is not null)
                    {
                        @* ⚠️ Tutto dalle risorse. Fino al 16 settembre 2026 qui usciva la `Note` di
                           `RunwaySuggestion.Suggest`, in italiano cablato anche nell'interfaccia inglese («No rule
                           applies → best headwind fallback: Headwind 13 kt su 13, vento traverso 3 kt»): ora il
                           motore dice solo il MOTIVO, e le componenti stanno nella riga per pista qui sotto. *@
                        <span>@L["Ape_TestNoRule"] DEP <b>@_ripiego.DepIdent</b> · ARR <b>@_ripiego.ArrIdent</b></span>
                        @if (_ripiego.Reason == SuggestionReason.Tailwind)
                        {
                            @* Il vento è in coda su tutte le piste: la «migliore» è la meno peggio, e va detto. *@
                            <span class="muted"> — @L["Ape_TestReasonTailwind"]</span>
                        }
                        @VentoSullePiste(PisteInUso())
                    }
                    else
                    {
                        @* Senza pista scelta (vento calmo, senza direzione, nessuna pista nota) il motivo è l'unica
                           cosa da dire. *@
                        @L["Ape_TestNoRule"] @MotivoSenzaPista()
                    }
                </div></div>
            }

            @* Come lavora OGNI regola col vento di prova: tailwind e vento traverso su ciascuna delle sue piste,
               i massimi con cui si confrontano, e il primo vincolo che la fa cadere. Esce dal motore stesso
               (RunwaySuggestion.ExplainRules), non da un calcolo rifatto qui: se dicessero due cose diverse, il
               banco di prova mentirebbe proprio su quello che serve a capire. *@
            @if (_spiegazione.Count > 0)
            {
                <div class="rule-prova">
                    @foreach (var e in _spiegazione)
                    {
                        var r = e.RuleIndex < Rows.Count ? Rows[e.RuleIndex] : null;
                        if (r is null) continue;
                        <div class="rule-prova-regola @(e.RuleIndex == _vincente?.RuleIndex ? "vince" : "")">
                            <div class="rule-prova-testa">
                                <b>#@(e.RuleIndex + 1)@(string.IsNullOrWhiteSpace(r.Name) ? "" : $" · {r.Name}")</b>
                                <span class="@(e.Verdict == RuleVerdict.Applies ? "ok" : "no")">@Verdetto(e, r)</span>
                            </div>
                            @if (e.Runways.Count == 0)
                            {
                                <div class="muted">@L["Ape_TestNoRunways"]</div>
                            }
                            else
                            {
                                <table class="rule-prova-tab">
                                    <thead>
                                        <tr>
                                            <th>RWY</th>
                                            <th>@L["Ape_TestColTail"] <span class="muted">(max @r.MaxTail kt)</span></th>
                                            <th>@L["Ape_TestColCross"] <span class="muted">(max @(r.MaxCross is int mc ? $"{mc} kt" : "—"))</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in e.Runways)
                                        {
                                            <tr>
                                                <td><b>@p.Ident</b> <span class="muted">@Ruolo(r, p.Ident)</span></td>
                                                <td class="@(p.TailwindKt > r.MaxTail ? "oltre" : "")">@p.TailwindKt kt</td>
                                                <td class="@(r.MaxCross is int c && p.CrosswindKt > c ? "oltre" : "")">@p.CrosswindKt kt</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>Le regole in lavorazione, NELL'ORDINE in cui si applicano: la prima che vince, vince.</summary>
    [Parameter, EditorRequired] public List<RuleEdit> Rows { get; set; } = new();

    /// <summary>Le piste dello scalo: sono i chip che si accendono in DEP e ARR.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> RunwayIdents { get; set; } = Array.Empty<string>();

    /// <summary>Il documento è in modifica e il lock è nostro: solo allora ci sono i campi.</summary>
    [Parameter] public bool Editing { get; set; }

    /// <summary>Le soglie marcate «mai usare» nella tabella piste (anche non ancora salvate): il banco di prova ripiega
    /// senza di loro, e una regola che le nomina riceve un avviso.</summary>
    [Parameter] public IReadOnlyList<string> NeverUseIdents { get; set; } = Array.Empty<string>();

    /// <summary>Le regole sono cambiate — un campo, un chip, l'ordine: l'host le salva subito.</summary>
    [Parameter] public EventCallback RowsChanged { get; set; }

    /// <summary>Conferma prima di togliere una regola; null = non si chiede.</summary>
    [Parameter] public Func<Task<bool>>? ConfirmRemove { get; set; }

    // Stato di VISTA, tutto interno: quale riga si sta trascinando e l'esito dell'ultima prova.
    private int? _trascinata;
    private int? _provaDir = 200;
    private int _provaKt = 10;
    private bool _provaBagnata;
    /// <summary>Il momento da provare, in ora LOCALE italiana — la stessa in cui si scrivono orari, giorni e
    /// stagioni delle regole. Parte da adesso.</summary>
    private DateTime _provaQuando = Adesso();
    private bool _provaFatta;
    private RunwayRuleResult? _vincente;
    private RunwaySuggestionResult? _ripiego;
    private IReadOnlyList<RuleExplanation> _spiegazione = Array.Empty<RuleExplanation>();

    /// <summary>L'esito di una regola a parole. Una regola che passa ma viene DOPO la vincente lo dice: altrimenti
    /// «si applica» su due regole si leggerebbe come «vincono tutt'e due».</summary>
    private string Verdetto(RuleExplanation e, RuleEdit r) => e.Verdict switch
    {
        RuleVerdict.Applies when _vincente is not null && _vincente.RuleIndex != e.RuleIndex
            => L["Ape_TestVerdictShadowed", _vincente.RuleIndex + 1],
        RuleVerdict.Applies => L["Ape_TestVerdictApplies"],
        RuleVerdict.Surface => L["Ape_TestVerdictSurface"],
        RuleVerdict.Time => L["Ape_TestVerdictTime"],
        RuleVerdict.Day => L["Ape_TestVerdictDay"],
        RuleVerdict.Parity => L["Ape_TestVerdictParity"],
        RuleVerdict.Season => L["Ape_TestVerdictSeason"],
        RuleVerdict.Tailwind => L["Ape_TestVerdictTail", e.WorstTailwindKt, r.MaxTail],
        RuleVerdict.Crosswind => L["Ape_TestVerdictCross", e.WorstCrosswindKt, r.MaxCross ?? 0],
        _ => "",
    };

    /// <summary>
    /// Il vento sulle piste IN USO, dentro il riquadro dell'esito: una riga per pista, tailwind e vento traverso.
    ///
    /// <para>Richiesta del committente (16 settembre 2026): i numeri stavano solo nelle schede per regola sotto,
    /// dove la pista che vince si mescola con quelle delle regole scartate — e il riquadro che dice «vince la
    /// regola #1, DEP 31 · ARR 31» non diceva con che vento.</para>
    /// <para>⚠️ Terminologia: «Tailwind» resta tale anche in italiano, il traverso è «Vento traverso», e
    /// «headwind» non si traduce mai (le stesse risorse delle colonne delle schede).</para>
    /// </summary>
    private RenderFragment VentoSullePiste(IReadOnlyList<(string Ident, string Ruolo, int Tail, int Cross)> piste) => __builder =>
    {
        if (piste.Count == 0) return;
        <div class="rule-prova-inuso">
            @foreach (var p in piste)
            {
                <span><b>@p.Ident</b>@if (!string.IsNullOrEmpty(p.Ruolo)) { <span class="muted">@p.Ruolo</span> } —
                    @L["Ape_TestColTail"] <b>@p.Tail kt</b> · @L["Ape_TestColCross"] <b>@p.Cross kt</b></span>
            }
        </div>
    };

    /// <summary>
    /// Le piste in uso con le loro componenti.
    ///
    /// <para>⚠️ Con una regola vincente i numeri sono quelli di <see cref="RunwaySuggestion.ExplainRules"/> per
    /// QUELLA regola — gli stessi della sua scheda sotto — e non un calcolo rifatto qui: se il riquadro e la
    /// scheda dicessero due numeri diversi il banco mentirebbe proprio su quello che serve a capire.</para>
    /// <para>Senza regola vincente la pista la sceglie il ripiego (miglior headwind), che porta headwind e
    /// traverso per estremità: il tailwind è <c>max(0, -headwind)</c>, la stessa regola del motore delle regole.</para>
    /// </summary>
    private IReadOnlyList<(string Ident, string Ruolo, int Tail, int Cross)> PisteInUso()
    {
        if (_vincente is not null)
        {
            var e = _spiegazione.FirstOrDefault(x => x.RuleIndex == _vincente.RuleIndex);
            var r = _vincente.RuleIndex < Rows.Count ? Rows[_vincente.RuleIndex] : null;
            if (e is null || r is null) return Array.Empty<(string, string, int, int)>();
            return e.Runways.Select(p => (p.Ident, Ruolo(r, p.Ident), p.TailwindKt, p.CrosswindKt)).ToList();
        }

        if (_ripiego?.Best is null) return Array.Empty<(string, string, int, int)>();
        var dep = _ripiego.DepIdent ?? _ripiego.Best.Ident;
        var arr = _ripiego.ArrIdent ?? _ripiego.Best.Ident;
        return new[] { dep, arr }
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(id => _ripiego.Ranked.FirstOrDefault(x => string.Equals(x.Ident, id, StringComparison.OrdinalIgnoreCase)))
            .Where(p => p is not null)
            .Select(p => (p!.Ident,
                          (string.Equals(p.Ident, dep, StringComparison.OrdinalIgnoreCase), string.Equals(p.Ident, arr, StringComparison.OrdinalIgnoreCase)) switch
                          {
                              (true, true) => "DEP · ARR",
                              (true, false) => "DEP",
                              (false, true) => "ARR",
                              _ => "",
                          },
                          Math.Max(0, -p.Headwind), p.Crosswind))
            .ToList();
    }

    /// <summary>Perché il ripiego non ha scelto una pista, a parole e nella lingua della pagina.</summary>
    private string MotivoSenzaPista() => _ripiego?.Reason switch
    {
        SuggestionReason.NoRunways => L["Ape_TestReasonNoRunways"],
        SuggestionReason.Calm => L["Ape_TestReasonCalm"],
        SuggestionReason.NoDirection => L["Ape_TestReasonNoDirection"],
        SuggestionReason.AllNeverUse => L["Ape_TestReasonAllNeverUse"],
        _ => "—",
    };

    /// <summary>In che veste la pista sta nella regola: DEP, ARR o tutt'e due.</summary>
    private static string Ruolo(RuleEdit r, string ident) =>
        (r.Dep.Contains(ident), r.Arr.Contains(ident)) switch
        {
            (true, true) => "DEP · ARR",
            (true, false) => "DEP",
            (false, true) => "ARR",
            _ => "",
        };

    private string[] NomiGiorni => new[]
    {
        L["Ape_Mon"].Value, L["Ape_Tue"].Value, L["Ape_Wed"].Value,
        L["Ape_Thu"].Value, L["Ape_Fri"].Value, L["Ape_Sat"].Value, L["Ape_Sun"].Value,
    };

    private string[] NomiMesi => new[]
    {
        L["Ape_Jan"].Value, L["Ape_Feb"].Value, L["Ape_Mar"].Value, L["Ape_Apr"].Value, L["Ape_May"].Value, L["Ape_Jun"].Value,
        L["Ape_Jul"].Value, L["Ape_Aug"].Value, L["Ape_Sep"].Value, L["Ape_Oct"].Value, L["Ape_Nov"].Value, L["Ape_Dec"].Value,
    };

    /// <summary>Adesso, in ora italiana: il fuso lo risolve il motore, non questo componente.</summary>
    private static DateTime Adesso() => RunwaySuggestion.OraLocale(DateTime.UtcNow);

    /// <summary>Vero se la finestra oraria della regola scavalca la mezzanotte (22:00 → 05:00).</summary>
    private static bool Scavalca(RuleEdit r) => r is { TimeFrom: { } f, TimeTo: { } t } && f > t;

    /// <summary>Il giorno del momento scelto, scritto per esteso: è la risposta alla domanda «che giorno sto
    /// provando?», che da un campo <c>datetime-local</c> non si legge a colpo d'occhio.</summary>
    private string GiornoScelto() =>
        _provaQuando.ToString("dddd d MMMM", System.Globalization.CultureInfo.CurrentUICulture);

    private static string Chip(HashSet<string> set, string id) => set.Contains(id)
        ? "background:var(--ivao-blue);color:#fff;border-color:var(--ivao-blue)" : "";

    private static string ChipGiorno(RuleEdit r, int bit) => (r.DaysMask & (1 << bit)) != 0
        ? "background:var(--ivao-blue);color:#fff;border-color:var(--ivao-blue)" : "";

    private RenderFragment Giorni() => builder =>
    {
        builder.AddMarkupContent(0, "<option value=\"\">—</option>");
        for (var d = 1; d <= 31; d++)
            builder.AddMarkupContent(d, $"<option value=\"{d}\">{d}</option>");
    };

    private RenderFragment Mesi() => builder =>
    {
        builder.AddMarkupContent(0, $"<option value=\"\">— {L["Ape_Month"].Value} —</option>");
        for (var m = 1; m <= 12; m++)
            builder.AddMarkupContent(m, $"<option value=\"{m}\">{NomiMesi[m - 1]}</option>");
    };

    /// <summary>Un campo EDITORIALE ha cambiato valore: unico punto d'uscita verso l'host.
    /// ⚠️ I campi del pannello di prova (`_provaDir`, `_provaKt`, `_provaBagnata`, `_provaQuando`) NON passano
    /// di qui: sono stato locale di una simulazione, non contenuto da salvare.</summary>
    private Task Cambiato() => RowsChanged.InvokeAsync();

    /// <summary>La regola in una riga sola, per quando non si sta modificando: i vincoli che ha davvero.
    /// Il nome sta nell'intestazione e la nota va a capo da sé, quindi non entrano qui.</summary>
    private string Riassunto(RuleEdit r)
    {
        // ⚠️ Le etichette si prendono PRIMA: un localizzatore dentro un $"..." rompe il parse (virgolette annidate).
        var etTail = L["Ape_MaxTail"].Value;
        var etCross = L["Ape_MaxCross"].Value;
        var pezzi = new List<string> { $"{etTail} {r.MaxTail} kt" };
        if (r.MaxCross is int c) pezzi.Add($"{etCross} {c} kt");
        if (r.Surface == "dry") pezzi.Add(L["Ape_SurfDry"].Value);
        if (r.Surface == "wet") pezzi.Add(L["Ape_SurfWet"].Value);
        if (r.TimeFrom is { } tf && r.TimeTo is { } tt) pezzi.Add($"{tf:HH\\:mm}\u2013{tt:HH\\:mm}");
        if (r.DaysMask != 0)
            pezzi.Add(string.Join(" ", Enumerable.Range(0, 7).Where(b => (r.DaysMask & (1 << b)) != 0).Select(b => NomiGiorni[b])));
        if (r.Parity == "even") pezzi.Add(L["Ape_Even"].Value);
        if (r.Parity == "odd") pezzi.Add(L["Ape_Odd"].Value);
        if (r.DateFromDay is int fd && r.DateFromMonth is int fm && r.DateToDay is int td && r.DateToMonth is int tm)
            pezzi.Add($"{fd} {NomiMesi[fm - 1]} \u2013 {td} {NomiMesi[tm - 1]}");
        return string.Join(" \u00b7 ", pezzi);
    }

    private async Task Aggiungi()
    {
        Rows.Add(new RuleEdit());
        await RowsChanged.InvokeAsync();
    }

    private async Task Rimuovi(RuleEdit r)
    {
        if (ConfirmRemove is not null && !await ConfirmRemove()) return;
        Rows.Remove(r);
        await RowsChanged.InvokeAsync();
    }

    private async Task Sposta(int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= Rows.Count) return;
        (Rows[idx], Rows[j]) = (Rows[j], Rows[idx]);
        await RowsChanged.InvokeAsync();
    }

    /// <summary>Trascinamento: la riga si sposta mentre la si porta sopra le altre, così l'ordine si vede
    /// prima di lasciarla. Il «sporca» arriva al rilascio, non a ogni passaggio.</summary>
    private void TrascinaSopra(int i)
    {
        if (_trascinata is not int d || d == i || d < 0 || d >= Rows.Count) return;
        var riga = Rows[d];
        Rows.RemoveAt(d);
        Rows.Insert(i, riga);
        _trascinata = i;
    }

    private async Task Rilascia()
    {
        if (_trascinata is null) return;
        _trascinata = null;
        await RowsChanged.InvokeAsync();
    }

    private async Task Commuta(HashSet<string> set, string id)
    {
        if (!set.Remove(id)) set.Add(id);
        await RowsChanged.InvokeAsync();
    }

    private async Task CommutaGiorno(RuleEdit r, int bit)
    {
        r.DaysMask ^= 1 << bit;
        await RowsChanged.InvokeAsync();
    }

    /// <summary>
    /// Prova le regole com'è scritte adesso, senza salvarle. ⚠️ Passa dalla STESSA conversione del
    /// salvataggio (<see cref="AirportRuleMapping"/>): se fossero due, la prova direbbe una cosa e il
    /// documento pubblicato un'altra.
    /// </summary>
    private void Prova()
    {
        var regole = Rows.Select(AirportRuleMapping.ToEval).ToList();
        // ⚠️ Il momento si passa in UTC perché è così che il motore lo vuole, e la conversione la fa LUI:
        // rifarla qui vorrebbe dire due fusi orari nel prodotto, e uno dei due sbagliato prima o poi.
        var quando = RunwaySuggestion.AUtc(_provaQuando);
        _vincente = RunwaySuggestion.EvaluateRules(regole, _provaDir, _provaKt, _provaBagnata, quando);
        _spiegazione = RunwaySuggestion.ExplainRules(regole, _provaDir, _provaKt, _provaBagnata, quando);
        _ripiego = _vincente is null ? RunwaySuggestion.Suggest(RunwayIdents, _provaDir, _provaKt, NeverUseIdents) : null;
        _provaFatta = true;
    }
}
