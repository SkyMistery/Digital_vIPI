@* Sezione AOR (derivata): poligono shape reale sovrapposto a una mappa minimal (Leaflet + CartoDB Positron).
   SVG di fallback se il JS/Leaflet non è disponibile. *@
@if (Polygon is not null)
{
    <div class="aor-leaflet" data-poly="@PointsJson(Polygon)" data-towers="@TowersJson()" style="height:340px;border:1px solid var(--line);border-radius:11px;overflow:hidden">
        @* Fallback (no-JS): il poligono proiettato come SVG. Leaflet sostituisce il contenuto quando carica. *@
        <svg viewBox="@Polygon.ViewBox" width="100%" height="100%" style="background:#f7f9ff">
            <path d="@Polygon.Path" fill="#3C55AC" fill-opacity="0.12" stroke="#3C55AC" stroke-width="2" stroke-linejoin="round" />
        </svg>
    </div>
    <p class="muted" style="font-size:12.5px;margin:6px 0 0">
        Area di competenza dell'avvicinamento ·
        <a href="https://www.openstreetmap.org/?mlat=@Fmt(Polygon.CenterLat)&mlon=@Fmt(Polygon.CenterLon)#map=8/@Fmt(Polygon.CenterLat)/@Fmt(Polygon.CenterLon)" target="_blank" rel="noopener">apri in OpenStreetMap</a>
    </p>
}
else
{
    <div class="callout warning" style="margin:0">
        <span class="cic"><Icon Name="map" Size="18" /></span>
        <div>
            <p class="ct">Shape AOR non disponibile</p>
            Il poligono del settore non è ancora stato importato (o non è leggibile). Comparirà dopo l'import del settore APP.
        </div>
    </div>
}

@code {
    [Parameter] public AppAorPolygon? Polygon { get; set; }
    [Parameter] public IReadOnlyList<AppAorPolygon>? Towers { get; set; }

    private static string Fmt(double v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    private static string PointsJson(AppAorPolygon p) =>
        System.Text.Json.JsonSerializer.Serialize(p.Points);

    // Array di anelli (uno per TWR) per l'overlay Leaflet; "[]" se nessuna torre.
    private string TowersJson() =>
        System.Text.Json.JsonSerializer.Serialize((Towers ?? Array.Empty<AppAorPolygon>()).Select(t => t.Points));
}
