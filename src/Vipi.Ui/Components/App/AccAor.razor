@* AoR di ACC: UNA mappa con anelli per-settore toggleabili (chip sopra) + selettore configurazione (chip sotto).
   data-sectors = [{sec,name,color,rings:[[[lat,lng],…]]}]; l'interattività è client-side (vipi-aor.js). SVG di fallback. *@
@using System.Text.Json
@if (View.Sectors is { Count: > 0 })
{
    <div class="aor-viewmode" data-aor-view>
        <button type="button" class="aor-vm-btn on" data-view="2d">Mappa 2D</button>
        <button type="button" class="aor-vm-btn" data-view="3d">Vista 3D</button>
    </div>
    <div class="aor-view aor-view-2d">
    <div class="aor-block" data-aor="@Id">
        <div class="aor-toggles">
            @foreach (var s in View.Sectors)
            {
                <span class="aor-chip on" data-sec="@s.Callsign" title="@s.Name">
                    <span class="sw" style="background:@(s.Color)33;border-color:@s.Color"></span> @s.Callsign
                </span>
            }
            <span class="aor-chip-actions"><a class="aor-all" data-act="all">Tutti</a> · <a class="aor-all" data-act="none">Nessuno</a></span>
        </div>

        <div @key="MapSignature()" class="aor-leaflet" data-sectors="@SectorsJson()" style="height:340px;border:1px solid var(--line);border-radius:11px;overflow:hidden">
            <svg viewBox="@View.Sectors[0].Polygons[0].ViewBox" width="100%" height="100%" style="background:#f7f9ff">
                @foreach (var s in View.Sectors)
                {
                    @foreach (var p in s.Polygons)
                    {
                        <path data-sec="@s.Callsign" d="@p.Path" fill="@s.Color" fill-opacity="0.16" stroke="@s.Color" stroke-width="2" stroke-linejoin="round" />
                    }
                }
            </svg>
        </div>

        @if (View.Configs is { Count: > 0 })
        {
            <div class="cfg-sel">
                <span class="cfg-sel-lab">Configurazione:</span>
                @foreach (var c in View.Configs)
                {
                    <span class="cfg-btn" data-secs="@string.Join(",", c.OpenCallsigns)" data-cfgkey="@c.Key">@c.Name</span>
                }
                <a class="cfg-clear" data-rows="">azzera</a>
            </div>
        }
        <p class="muted noprint" style="font-size:12.5px;margin:6px 0 0">Accendi/spegni i settori sopra la mappa; scegli una configurazione sotto per applicarne l'assetto.</p>
    </div>
    </div>
    <div class="aor-view aor-view-3d" hidden>
        <AccAor3d View="View" Id="@($"{Id}-3d")" FullPageUrl="@Aor3dPageUrl" />
        <p class="muted" style="font-size:12.5px;margin:6px 0 0">Ogni settore è estruso sulla sua banda di livelli (FL). Clicca una voce in legenda per mostrarlo/nasconderlo.</p>
    </div>
}
else
{
    <div class="callout warning" style="margin:0">
        <span class="cic"><Icon Name="map" Size="18" /></span>
        <div>
            <p class="ct">Shape AOR non disponibile</p>
            Nessun poligono per i settori del blocco (non ancora importati o non leggibili).
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public AccAorView View { get; set; } = AccAorView.Empty;
    [Parameter] public string? Id { get; set; }
    /// <summary>URL della pagina 3D dedicata (instradato ad AccAor3d): mostra il link «Apri pagina» nel tab 3D. null = nessun link.</summary>
    [Parameter] public string? Aor3dPageUrl { get; set; }

    // Firma del contenuto mappa (callsign + colore per settore): cambia il @key del contenitore Leaflet così Blazor
    // sostituisce il nodo quando cambiano colori/settori → vipi-aor.js re-inizializza la mappa (altrimenti l'init è
    // idempotente e la mappa non rileggerebbe i nuovi data-sectors fino a un reset del nodo).
    private string MapSignature() => string.Join("|", View.Sectors.Select(s => s.Callsign + ":" + s.Color));

    private string SectorsJson() => JsonSerializer.Serialize(
        View.Sectors.Select(s => new
        {
            sec = s.Callsign,
            name = s.Name,
            color = s.Color,
            rings = s.Polygons.Select(p => p.Points)
        }));
}
