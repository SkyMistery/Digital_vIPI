@* L'editor della tabella «Aeroporti alternati» (carta vSOP militari §12f).

   ⚠️ Qui, a differenza delle Radioassistenze, si scrive SOLO nel documento: rilevamento e distanza sono di
   questo SOP — il rilevamento di Grottaglie da Amendola non è un fatto dell'aeroporto, è un fatto della
   coppia. Le radioassistenze citate invece vengono dall'anagrafica, e da qui si scelgono soltanto.

   ⚠️ Rilevamento e distanza si scrivono come NUMERI, per richiesta del committente: l'unità la mette il
   documento, così non ci finiscono dentro tre modi diversi di dire gradi. *@
@inject IStringLocalizer<SharedResource> L
@using Vipi.Application.Abstractions
@using Vipi.Application.Content

<table class="cfg-table">
    <thead>
        <tr>
            @if (Editing) { <th style="width:76px"></th> }
            <th>@L["Div_Airports"]</th>
            <th>@L["Div_Navaids"]</th>
            <th style="width:110px">@L["Div_Bearing"]</th>
            <th style="width:110px">@L["Div_Distance"]</th>
            @if (Editing) { <th style="width:40px"></th> }
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Rows.Count; i++)
        {
            var idx = i;
            var r = Rows[idx];
            <tr>
                @if (Editing)
                {
                    <td style="white-space:nowrap">
                        <button type="button" class="btn ghost" style="padding:0 6px" disabled="@(idx == 0)"
                                title="@L["Common_Up"]" @onclick="() => OnMove.InvokeAsync((idx, -1))">↑</button>
                        <button type="button" class="btn ghost" style="padding:0 6px" disabled="@(idx == Rows.Count - 1)"
                                title="@L["Common_Down"]" @onclick="() => OnMove.InvokeAsync((idx, 1))">↓</button>
                    </td>
                }
                <td><b>@r.Icao</b> @r.Name</td>
                <td>
                    @foreach (var n in r.Navaids)
                    {
                        <div style="white-space:nowrap;display:flex;gap:6px;align-items:center">
                            <span>@NavaidText.ConTipo(n.Code, n.Type, n.Channel, n.Frequency)</span>
                            @if (Editing)
                            {
                                <button type="button" class="btn ghost" style="padding:0 5px"
                                        title="@L["Div_RemoveNavaid"]"
                                        @onclick="() => OnRemoveNavaid.InvokeAsync((idx, new NavaidKey(n.Code, n.Kind)))">✕</button>
                            }
                        </div>
                    }
                    @if (r.Navaids.Count == 0 && !Editing) { <span class="muted">—</span> }
                    @if (Editing)
                    {
                        <div style="display:flex;gap:4px;align-items:center;margin-top:4px">
                            <input list="@CodiciId" placeholder="@L["Nav_Code"]" style="width:90px"
                                   value="@LeggiBozza(idx)" @onchange="e => _bozzaNavaid[idx] = e.Value?.ToString() ?? string.Empty" />
                            <button type="button" class="btn ghost" style="padding:0 6px"
                                    @onclick="() => AggiungiNavaid(idx)">+</button>
                        </div>
                    }
                </td>
                <td>
                    @if (Editing)
                    {
                        <input type="number" min="0" max="360" value="@r.Bearing" style="width:80px" placeholder="126"
                               aria-label="@L["Div_Bearing"]"
                               @onchange="e => OnSetNumber.InvokeAsync((idx, true, Numero(e.Value)))" />
                    }
                    else { @Vuoto(MilDiversionText.Rilevamento(r.Bearing)) }
                </td>
                <td>
                    @if (Editing)
                    {
                        <input type="number" min="0" max="9999" value="@r.DistanceNm" style="width:80px" placeholder="40"
                               aria-label="@L["Div_Distance"]"
                               @onchange="e => OnSetNumber.InvokeAsync((idx, false, Numero(e.Value)))" />
                    }
                    else { @Vuoto(MilDiversionText.Distanza(r.DistanceNm)) }
                </td>
                @if (Editing)
                {
                    <td>
                        <button type="button" class="btn ghost" style="padding:0 6px" title="@L["Div_RemoveRow"]"
                                @onclick="() => OnRemove.InvokeAsync(idx)">✕</button>
                    </td>
                }
            </tr>
        }
        @if (Rows.Count == 0)
        {
            <tr><td colspan="@(Editing ? 6 : 4)" class="muted">@L["Div_Empty"]</td></tr>
        }
    </tbody>
</table>

@if (Editing)
{
    <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-top:10px">
        <label style="display:flex;flex-direction:column;gap:2px;font-size:12px">
            @L["Div_Icao"]
            <input list="@AeroportiId" @bind="_nuovoIcao" style="width:110px" placeholder="LIBG" />
        </label>
        <button type="button" class="btn primary" @onclick="Aggiungi">+ @L["Div_Add"]</button>
        @if (_errore is not null) { <span class="muted" style="color:var(--danger-ink)">@_errore</span> }
    </div>
    @* ⚠️ Lo si dice PRIMA, non dopo un fallimento: un alternato estero è il caso normale su un campo di
       confine, e chi scrive deve sapere che il codice glielo cerchiamo anche fuori dai nostri. *@
    <p class="help" style="margin-top:6px">@L["Div_AddHint"]</p>

    <datalist id="@AeroportiId">
        @foreach (var a in Aeroporti) { <option value="@a.Icao">@a.Name</option> }
    </datalist>
    <datalist id="@CodiciId">
        @foreach (var n in Anagrafica) { <option value="@n.Code">@n.Kind</option> }
    </datalist>
}

@code {
    private const string AeroportiId = "vipi-div-airports";
    private const string CodiciId = "vipi-div-navaids";

    [Parameter, EditorRequired] public IReadOnlyList<MilDiversionView> Rows { get; set; } = Array.Empty<MilDiversionView>();

    /// <summary>Gli scali del nostro archivio, per suggerire i codici. Un alternato estero si scrive comunque:
    /// il nome lo cerca il servizio alla sorgente.</summary>
    [Parameter] public IReadOnlyList<AirportName> Aeroporti { get; set; } = Array.Empty<AirportName>();

    /// <summary>L'anagrafica delle radioassistenze, per suggerire i codici da citare.</summary>
    [Parameter] public IReadOnlyList<NavaidRow> Anagrafica { get; set; } = Array.Empty<NavaidRow>();

    [Parameter] public bool Editing { get; set; }

    /// <summary>Aggiunge lo scalo con questo ICAO. Il nome lo risolve l'host (archivio, poi sorgente).</summary>
    [Parameter] public EventCallback<string> OnAdd { get; set; }

    [Parameter] public EventCallback<int> OnRemove { get; set; }
    [Parameter] public EventCallback<(int Indice, int Delta)> OnMove { get; set; }

    /// <summary>Cita una radioassistenza su questa riga. ⚠️ Il codice basta: se in anagrafica ce n'è una sola
    /// con quel codice, la natura la sa già il sistema — chiederla sarebbe una domanda di cui conosce la
    /// risposta.</summary>
    [Parameter] public EventCallback<(int Indice, string Codice)> OnAddNavaid { get; set; }

    [Parameter] public EventCallback<(int Indice, NavaidKey Chiave)> OnRemoveNavaid { get; set; }

    /// <summary>Rilevamento (<c>true</c>) o distanza (<c>false</c>) della riga; null = si svuota.</summary>
    [Parameter] public EventCallback<(int Indice, bool Rilevamento, int? Valore)> OnSetNumber { get; set; }

    private string _nuovoIcao = "";
    private string? _errore;
    private readonly Dictionary<int, string> _bozzaNavaid = new();

    private static string Vuoto(string s) => s.Length > 0 ? s : "—";

    private static int? Numero(object? v) =>
        int.TryParse(v?.ToString(), out var n) ? n : null;

    private string LeggiBozza(int i) => _bozzaNavaid.TryGetValue(i, out var v) ? v : "";

    private async Task Aggiungi()
    {
        _errore = null;
        var icao = (_nuovoIcao ?? "").Trim().ToUpperInvariant();
        if (icao.Length != 4 || !icao.All(char.IsLetterOrDigit)) { _errore = L["Div_BadIcao"].Value; return; }
        if (Rows.Any(r => r.Icao == icao)) { _errore = L["Div_Duplicate"].Value; return; }

        await OnAdd.InvokeAsync(icao);
        _nuovoIcao = "";
    }

    private async Task AggiungiNavaid(int i)
    {
        _errore = null;
        var codice = NavaidRules.Norm(LeggiBozza(i));
        if (!NavaidRules.CodiceValido(codice)) { _errore = L["Nav_BadCode"].Value; return; }

        await OnAddNavaid.InvokeAsync((i, codice));
        _bozzaNavaid[i] = "";
    }
}
