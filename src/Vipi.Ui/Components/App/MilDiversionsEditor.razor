@* L'editor della tabella «Aeroporti alternati» (carta vSOP militari §12f).

   ⚠️ Qui, a differenza delle Radioassistenze, si scrive SOLO nel documento: rilevamento e distanza sono di
   questo SOP — il rilevamento di Grottaglie da Amendola non è un fatto dell'aeroporto, è un fatto della
   coppia. Le radioassistenze citate invece vengono dall'anagrafica, e da qui si scelgono soltanto.

   ⚠️ Rilevamento e distanza si scrivono come NUMERI, per richiesta del committente: l'unità la mette il
   documento, così non ci finiscono dentro tre modi diversi di dire gradi. *@
@inject IStringLocalizer<SharedResource> L
@using Vipi.Application.Abstractions
@using Vipi.Application.Content

<table class="res-table mil-table div-table">
    <thead>
        <tr>
            @if (Editing) { <th class="c-move"></th> }
            <th>@L["Div_Airports"]</th>
            <th class="c-nav">@L["Div_Navaids"]</th>
            <th class="c-num">@L["Div_Bearing"]</th>
            <th class="c-num">@L["Div_Distance"]</th>
            @if (Editing) { <th class="c-act"></th> }
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Rows.Count; i++)
        {
            var idx = i;
            var r = Rows[idx];
            <tr>
                @if (Editing)
                {
                    <td class="c-move">
                        <button type="button" class="btn ghost" disabled="@(idx == 0)"
                                title="@L["Common_Up"]" @onclick="() => OnMove.InvokeAsync((idx, -1))">↑</button>
                        <button type="button" class="btn ghost" disabled="@(idx == Rows.Count - 1)"
                                title="@L["Common_Down"]" @onclick="() => OnMove.InvokeAsync((idx, 1))">↓</button>
                    </td>
                }
                <td><b>@r.Icao</b> @r.Name</td>
                <td class="c-nav">
                    @foreach (var n in r.Navaids)
                    {
                        <div class="mil-cite">
                            <span>@NavaidText.ConTipo(n.Code, n.Type, n.Channel, n.Frequency)</span>
                            @if (Editing)
                            {
                                <button type="button" class="btn ghost" title="@L["Div_RemoveNavaid"]"
                                        @onclick="() => OnRemoveNavaid.InvokeAsync((idx, n.Key))">✕</button>
                            }
                        </div>
                    }
                    @if (r.Navaids.Count == 0 && !Editing) { <span class="muted">—</span> }
                    @if (Editing)
                    {
                        @* ⚠️ Un codice che è di PIÙ impianti non si rifiuta: si chiede quale. Su un campo
                           militare VORTAC e NDB condividono l'ident, e rifiutare voleva dire lasciare
                           citabili quasi solo i codici unici in tutta l'anagrafica. *@
                        @if (Candidate(idx) is { Count: > 0 } cand)
                        {
                            <div class="mil-cite-pick">
                                <select aria-label="@L["Nav_Pick"]"
                                        @onchange="e => Scegli(idx, e.Value?.ToString())">
                                    <option value="">@L["Nav_Pick"]</option>
                                    @for (var c = 0; c < cand.Count; c++)
                                    {
                                        var n = cand[c];
                                        <option value="@c">@NavaidText.ConTipo(n.Code, n.Type, n.Channel, n.Frequency)</option>
                                    }
                                </select>
                                <button type="button" class="btn ghost" title="@L["Common_Cancel"]"
                                        @onclick="() => _scelta.Remove(idx)">✕</button>
                            </div>
                        }
                        else
                        {
                            <div class="mil-cite-add">
                                <input list="@CodiciId" placeholder="@L["Nav_Code"]"
                                       value="@LeggiBozza(idx)" @onchange="e => _bozzaNavaid[idx] = e.Value?.ToString() ?? string.Empty" />
                                <button type="button" class="btn ghost" title="@L["Div_AddNavaid"]"
                                        @onclick="() => AggiungiNavaid(idx)">+</button>
                            </div>
                        }
                    }
                </td>
                <td class="c-num">
                    @if (Editing)
                    {
                        <input type="number" min="0" max="360" value="@r.Bearing" placeholder="126"
                               aria-label="@L["Div_Bearing"]"
                               @onchange="e => OnSetNumber.InvokeAsync((idx, true, Numero(e.Value)))" />
                    }
                    else { @Vuoto(MilDiversionText.Rilevamento(r.Bearing)) }
                </td>
                <td class="c-num">
                    @if (Editing)
                    {
                        <input type="number" min="0" max="9999" value="@r.DistanceNm" placeholder="40"
                               aria-label="@L["Div_Distance"]"
                               @onchange="e => OnSetNumber.InvokeAsync((idx, false, Numero(e.Value)))" />
                    }
                    else { @Vuoto(MilDiversionText.Distanza(r.DistanceNm)) }
                </td>
                @if (Editing)
                {
                    <td class="c-act">
                        <button type="button" class="btn ghost" title="@L["Div_RemoveRow"]"
                                @onclick="() => OnRemove.InvokeAsync(idx)">✕</button>
                    </td>
                }
            </tr>
        }
        @if (Rows.Count == 0)
        {
            <tr><td colspan="@(Editing ? 6 : 4)" class="muted">@L["Div_Empty"]</td></tr>
        }
    </tbody>
</table>

@if (Editing)
{
    <div class="mil-add">
        <label>
            @L["Div_Icao"]
            <input class="w-code" list="@AeroportiId" @bind="_nuovoIcao" placeholder="LIBG" />
        </label>
        <button type="button" class="btn primary" @onclick="Aggiungi">+ @L["Div_Add"]</button>
        @if (_errore is not null) { <span class="mil-err">@_errore</span> }
    </div>
    @* ⚠️ Lo si dice PRIMA, non dopo un fallimento: un alternato estero è il caso normale su un campo di
       confine, e chi scrive deve sapere che il codice glielo cerchiamo anche fuori dai nostri. Una riga
       sotto la barra d'aggiunta, come nelle Radioassistenze — un «?» da solo, senza niente accanto, in
       fondo a una testata di sezione già piena di comandi si legge come un segno rimasto lì per sbaglio. *@
    <p class="help mil-hint">@L["Div_AddHint"]</p>

    <datalist id="@AeroportiId">
        @foreach (var a in Aeroporti) { <option value="@a.Icao">@a.Name</option> }
    </datalist>
    <datalist id="@CodiciId">
        @foreach (var n in Anagrafica) { <option value="@n.Code">@n.Kind</option> }
    </datalist>
}

@code {
    private const string AeroportiId = "vipi-div-airports";
    private const string CodiciId = "vipi-div-navaids";

    [Parameter, EditorRequired] public IReadOnlyList<MilDiversionView> Rows { get; set; } = Array.Empty<MilDiversionView>();

    /// <summary>Gli scali del nostro archivio, per suggerire i codici. Un alternato estero si scrive comunque:
    /// il nome lo cerca il servizio alla sorgente.</summary>
    [Parameter] public IReadOnlyList<AirportName> Aeroporti { get; set; } = Array.Empty<AirportName>();

    /// <summary>L'anagrafica delle radioassistenze, per suggerire i codici da citare.</summary>
    [Parameter] public IReadOnlyList<NavaidRow> Anagrafica { get; set; } = Array.Empty<NavaidRow>();

    [Parameter] public bool Editing { get; set; }

    /// <summary>Aggiunge lo scalo con questo ICAO. Il nome lo risolve l'host (archivio, poi sorgente).</summary>
    [Parameter] public EventCallback<string> OnAdd { get; set; }

    [Parameter] public EventCallback<int> OnRemove { get; set; }
    [Parameter] public EventCallback<(int Indice, int Delta)> OnMove { get; set; }

    /// <summary>Cita una radioassistenza su questa riga. ⚠️ Si manda l'<b>identità intera</b>: se in
    /// anagrafica c'è un impianto solo con quel codice la sceglie questo editor senza chiedere niente —
    /// sarebbe una domanda di cui il sistema conosce la risposta — e se ce n'è più d'uno la scelta la fa una
    /// persona <b>qui</b>, prima di chiamare.</summary>
    [Parameter] public EventCallback<(int Indice, NavaidKey Chiave)> OnAddNavaid { get; set; }

    [Parameter] public EventCallback<(int Indice, NavaidKey Chiave)> OnRemoveNavaid { get; set; }

    /// <summary>Rilevamento (<c>true</c>) o distanza (<c>false</c>) della riga; null = si svuota.</summary>
    [Parameter] public EventCallback<(int Indice, bool Rilevamento, int? Valore)> OnSetNumber { get; set; }

    private string _nuovoIcao = "";
    private string? _errore;
    private readonly Dictionary<int, string> _bozzaNavaid = new();

    /// <summary>Le candidate in attesa di scelta, per riga. ⚠️ Vive per indice come la bozza, quindi si
    /// butta quando le righe cambiano: dopo un salvataggio, uno spostamento o una cancellazione l'indice 2
    /// non è più la riga di prima, e una tendina rimasta aperta citerebbe l'aeroporto sbagliato.</summary>
    private readonly Dictionary<int, IReadOnlyList<NavaidRow>> _scelta = new();

    private IReadOnlyList<MilDiversionView>? _righeViste;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Rows, _righeViste)) return;
        _righeViste = Rows;
        _scelta.Clear();
    }

    private IReadOnlyList<NavaidRow>? Candidate(int i) => _scelta.TryGetValue(i, out var v) ? v : null;

    private static string Vuoto(string s) => s.Length > 0 ? s : "—";

    private static int? Numero(object? v) =>
        int.TryParse(v?.ToString(), out var n) ? n : null;

    private string LeggiBozza(int i) => _bozzaNavaid.TryGetValue(i, out var v) ? v : "";

    private async Task Aggiungi()
    {
        _errore = null;
        var icao = (_nuovoIcao ?? "").Trim().ToUpperInvariant();
        if (icao.Length != 4 || !icao.All(char.IsLetterOrDigit)) { _errore = L["Div_BadIcao"].Value; return; }
        if (Rows.Any(r => r.Icao == icao)) { _errore = L["Div_Duplicate"].Value; return; }

        await OnAdd.InvokeAsync(icao);
        _nuovoIcao = "";
    }

    /// <summary>
    /// Le tre risposte al codice battuto a mano, e nessuna si indovina: <b>non</b> è in anagrafica e lo si
    /// dice; è di <b>un</b> impianto e si cita quello; è di <b>più</b> impianti — <c>DEC</c> è un VOR e un
    /// NDB, <c>GRO</c> un VOR e un TACAN — e allora si apre la tendina, perché sceglierne uno a caso
    /// metterebbe su un SOP la frequenza dell'impianto sbagliato.
    /// </summary>
    private async Task AggiungiNavaid(int i)
    {
        _errore = null;
        var codice = NavaidRules.Norm(LeggiBozza(i));
        if (!NavaidRules.CodiceValido(codice)) { _errore = L["Nav_BadCode"].Value; return; }

        var candidate = Anagrafica.Where(n => n.Code == codice).ToList();
        if (candidate.Count == 0) { _errore = L["Div_UnknownNavaid"].Value; return; }
        if (candidate.Count > 1)
        {
            _scelta[i] = candidate;
            _errore = string.Format(L["Nav_PickWhich"].Value, codice);
            return;
        }

        await CitaNavaid(i, candidate[0].Key);
    }

    /// <summary>La candidata scelta in tendina. Il valore è la posizione nell'elenco che si sta mostrando:
    /// l'identità la rilegge il chiamante, che ha l'anagrafica vera.</summary>
    private async Task Scegli(int i, string? posizione)
    {
        if (Candidate(i) is not { } cand) return;
        if (!int.TryParse(posizione, out var c) || c < 0 || c >= cand.Count) return;

        _scelta.Remove(i);
        await CitaNavaid(i, cand[c].Key);
    }

    private async Task CitaNavaid(int i, NavaidKey chiave)
    {
        _errore = null;
        await OnAddNavaid.InvokeAsync((i, chiave));
        _bozzaNavaid[i] = "";
    }
}
