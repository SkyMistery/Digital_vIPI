@* Corpo di una sezione della vIPI ACC (data-driven). Estratto da AccVipiPage per riuso in AccOperativaPage.
   Riceve il blocco + la chiave sezione + i valori già derivati per quel blocco. *@

@* Sotto-sezioni «prima» del corpo (doc 11 §3g). Per le sezioni libere le rende SectionBody insieme ai blocchi. *@
@if (IsStructured(Key) && Editorial is not null && SectionBody.HasChildren(Editorial, SectionSlot.Before))
{
    <SectionBody Section="Editorial" ShowBlocks="false" Slot="SectionSlot.Before" DepthOffset="-1" />
}

@switch (Key)
{
    case "separations": <AppSeparations Rows="Block.Separations" /> break;
    case "configurations": @ConfigTableBody() break;
    case "aor":
        @* @key include l'albero: al cambio root l'elemento mappa è ricreato e il JS Leaflet re-inizializza. *@
        <AccAor @key="@(Block.Key + ":" + Root)" View="Aor ?? AccAorView.Empty" Id="@Block.Key" />
        break;
    case "frequencies": <AppFrequencies Rows="Freqs ?? Array.Empty<AppFreqRow>()" /> break;
    case "vfr": <AppVfr Content="ParseVfr(Block.VfrJson)" /> break;
    case "coordination": <AccCoordinationView Coord="Coord ?? AccCoordination.Empty" /> break;
    case "regulated": <RegulatedAreas Areas="Areas ?? Array.Empty<AccSpecialAreaView>()" /> break;
    default:
        @* Editoriale/libera: resa condivisa con APP e vLOA (prosa/callout/tabella + sotto-sezioni). *@
        @if (Editorial is not null) { <SectionBody Section="Editorial" DepthOffset="-1" /> }
        break;
}

@* Le sotto-sezioni di una sezione strutturata restano contenuto del documento: quelle non marcate «prima» si
   rendono dopo il corpo derivato (prima sparivano, pur essendo creabili dall'editor con «+ sotto-sez»). *@
@if (IsStructured(Key) && Editorial is not null && SectionBody.HasChildren(Editorial, SectionSlot.After))
{
    <SectionBody Section="Editorial" ShowBlocks="false" Slot="SectionSlot.After" DepthOffset="-1" />
}

@code {
    [Parameter, EditorRequired] public AccBlock Block { get; set; } = default!;
    [Parameter, EditorRequired] public string Key { get; set; } = default!;

    /// <summary>Vista editoriale della sezione (blocchi + sotto-sezioni) dal documento: corpo delle sezioni libere,
    /// e sotto-sezioni delle strutturate. Null = nessun contenuto documentale (es. uso parziale in Operativa).</summary>
    [Parameter] public SectionView? Editorial { get; set; }

    // Chi rende il corpo lo dice il catalogo, per profilo (doc 13 §3a): qui stava una delle sei copie dell'insieme.
    private bool IsStructured(string key) =>
        SectionCatalog.IsHostRendered(SectionCatalog.ProfileOfAccBlock(Block.Kind), key);

    [Parameter] public string? Root { get; set; }

    [Parameter] public IReadOnlyList<AppFreqRow>? Freqs { get; set; }
    [Parameter] public AccCoordination? Coord { get; set; }
    [Parameter] public AccAorView? Aor { get; set; }
    [Parameter] public IReadOnlyList<AccSpecialAreaView>? Areas { get; set; }
    [Parameter] public IReadOnlyList<AccConfigTableView>? ConfigTables { get; set; }

    private RenderFragment ConfigTableBody() => __builder =>
    {
        var tables = ConfigTables ?? Array.Empty<AccConfigTableView>();
        @if (tables.Count == 0) { <p class="muted">Nessuna configurazione operativa.</p> }
        else { <p class="muted noprint" style="margin-top:0;font-size:13.5px">Apri una configurazione; selezionandola nell'AoR si apre qui in automatico.</p> }
        @foreach (var cfg in tables)
        {
            <details class="cfg-collapse coord-sub" data-cfgkey="@cfg.ConfigKey" data-cfgblock="@Block.Key">
                <summary><span>@cfg.ConfigName</span><span class="chev">▸</span></summary>
                <div class="body">
                    <table class="cfg-table">
                        <thead><tr><th>Settore Unificato</th><th>Accorpa</th><th>Center Point</th><th>Range</th></tr></thead>
                        <tbody>
                            @foreach (var row in cfg.Rows)
                            {
                                <tr class="grp-start">
                                    <td class="uni">@row.UnifiedCallsign</td>
                                    <td>@string.Join(", ", row.Absorbed)</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.CenterPoint) ? "—" : row.CenterPoint)</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.Range) ? "—" : row.Range)</td>
                                </tr>
                            }
                            @if (cfg.Rows.Count == 0) { <tr><td colspan="4" class="muted">Nessun settore aperto.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    };

    private static AppVfrContent ParseVfr(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return AppVfrContent.Empty;
        try { return System.Text.Json.JsonSerializer.Deserialize<AppVfrContent>(json) ?? AppVfrContent.Empty; }
        catch (System.Text.Json.JsonException) { return AppVfrContent.Empty; }
    }
}
