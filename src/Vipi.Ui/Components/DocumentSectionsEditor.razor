@* Editor editoriale documentale CONDIVISO (doc refactor 08f). Estratto da VloaEditor: sezioni ad albero
   (annidamento fino a DocumentSection.MaxDepth) + blocchi Prose/Callout/Table, su IEditingService — che è
   type-agnostico (opera su versionId/section/block). Riusato da vLOA, ACC, APP, Airport. Le sezioni DERIVATE
   (aor/frequencies/coordination/config/…) sono renderizzate dall'host via DerivedContent; l'host possiede
   caricamento, lock, guard di salvataggio (Run), obbligatorietà e nascondi (per-tipo). *@
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IStringLocalizer<SharedResource> L
@using System.Text.Json
@using RenderMode = Vipi.Domain.RenderMode
@* Editing risolto dallo scope DI proprio (VipiDbContext isolato dal circuito). Vedi [[EditLockBar]]. *@

@if (ShowToc)
{
    <div class="ed-layout @(RightRail is not null ? "with-rail" : null)">
        <EditorToc Items="BuildToc()" />
        <div>@SectionsBody</div>
        @if (RightRail is not null)
        {
            <aside class="ed-rail">@RightRail</aside>
        }
    </div>
}
else
{
    @SectionsBody
}

@code {
    [Parameter, EditorRequired] public EditableDocument Doc { get; set; } = default!;
    [Parameter] public bool IsEditing { get; set; }

    /// <summary>Sezioni radice da editare (default: <see cref="EditableDocument.Sections"/>). La vIPI ACC passa i figli
    /// di un blocco (sotto-editor per blocco). Doc refactor 08e-acc.</summary>
    [Parameter] public IReadOnlyList<EditableSection>? RootSections { get; set; }
    /// <summary>Sezione padre per "+ Aggiungi sezione" (default null = radice). ACC: l'Id della sezione-blocco.</summary>
    [Parameter] public int? AddParentId { get; set; }
    /// <summary>Etichetta del pulsante di aggiunta sezione (null = default localizzato).</summary>
    [Parameter] public string? AddLabel { get; set; }

    /// <summary>Guard dell'host: esegue la mutazione mostrando stato salvataggio / gestendo lock ed errori.</summary>
    [Parameter, EditorRequired] public Func<Func<Task>, Task> Run { get; set; } = default!;
    /// <summary>Notifica l'host dopo ogni mutazione: ricarica il documento e ri-renderizza.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Sezione data-driven (contenuto calcolato live): l'host la renderizza via <see cref="DerivedContent"/>.</summary>
    [Parameter] public Func<EditableSection, bool>? IsDerivedSection { get; set; }
    [Parameter] public RenderFragment<EditableSection>? DerivedContent { get; set; }

    /// <summary>Sezione obbligatoria: titolo bloccato (no rinomina/sposta/elimina), ma sotto-sezioni extra permesse.</summary>
    [Parameter] public Func<EditableSection, bool>? IsMandatory { get; set; }
    /// <summary>Sezione derivabile che espone il toggle Live/Frozen (doc 10 §3a/§S4c): tipicamente le sezioni derivate
    /// (aor/frequencies/coordination/minima). Il badge di stato compare per queste; il toggle solo in modifica.</summary>
    [Parameter] public Func<EditableSection, bool>? IsRenderModeToggleable { get; set; }


    /// <summary>Mostra il menu-sezioni laterale (TOC) sticky: avvolge il render in griglia 2 colonne (toc | contenuto).
    /// Opt-in per gli editor a singola istanza (App/vLOA); la vIPI ACC costruisce il TOC a livello pagina.</summary>
    [Parameter] public bool ShowToc { get; set; }
    /// <summary>Voci extra da accodare al TOC (es. il blocco Release reso dall'host fuori da questo editor).</summary>
    [Parameter] public IReadOnlyList<EditorTocItem>? ExtraTocItems { get; set; }
    /// <summary>Rail azioni a destra (opt-in, richiede <see cref="ShowToc"/>): pulsanti/badge dell'host — Preview, Modifica,
    /// Pubblica, stato salvataggio. Quando presente la griglia diventa 3 colonne (toc | contenuto | azioni).</summary>
    [Parameter] public RenderFragment? RightRail { get; set; }

    // Voci TOC = sezioni di primo livello (anchor s-{Id}, già usato da CollapsibleBlock) + eventuali extra dell'host.
    private IReadOnlyList<EditorTocItem> BuildToc()
    {
        var items = new List<EditorTocItem>();
        foreach (var s in (RootSections ?? Doc.Sections))
            items.Add(new EditorTocItem($"s-{s.Id}", s.Title));
        if (ExtraTocItems is { Count: > 0 }) items.AddRange(ExtraTocItems);
        return items;
    }

    private RenderFragment SectionsBody => __builder =>
    {
        foreach (var s in (RootSections ?? Doc.Sections))
        {
            @SectionEditor(s, 0)
        }

        @if (IsEditing)
        {
            <div class="block" style="border-style:dashed">
                <button class="btn primary" @onclick="() => AddSection(AddParentId)">@(AddLabel ?? L["Dse_AddSection"].Value)</button>
            </div>
        }
    };

    // Risolto dallo scope proprio (OwningComponentBase): context isolato dal circuito.
    private IEditingService Editing = default!;
    protected override void OnInitialized()
        => Editing = ScopedServices.GetRequiredService<IEditingService>();

    private static string AsString(object? v) => v as string ?? "";

    // ---- sezioni ----
    private Task AddSection(int? parentId) => Run(async () =>
    {
        await Editing.AddSectionAsync(Doc.VersionId, parentId, "Nuova sezione", BlockSection.Other);
        await OnChanged.InvokeAsync();
    });

    private Task RenameSection(int sectionId, string title) => Run(async () =>
    {
        await Editing.RenameSectionAsync(sectionId, title);
        await OnChanged.InvokeAsync();
    });

    private Task DeleteSection(int sectionId) => Run(async () =>
    {
        await Editing.DeleteSectionAsync(sectionId);
        await OnChanged.InvokeAsync();
    });

    private Task MoveSection(int sectionId, int dir) => Run(async () =>
    {
        await Editing.MoveSectionAsync(sectionId, dir);
        await OnChanged.InvokeAsync();
    });

    private Task SetRenderMode(int sectionId, RenderMode mode) => Run(async () =>
    {
        await Editing.SetSectionRenderModeAsync(sectionId, mode);
        await OnChanged.InvokeAsync();
    });

    // Nascondi/mostra: stato VERSIONATO sulla sezione (doc 11 §3c), uguale per ACC/APP/vLOA. Prima ogni editor
    // passava un proprio callback su uno storage diverso (blockmeta / DocumentProfile per chiave / per titolo).
    private Task ToggleHidden(EditableSection s) => Run(async () =>
    {
        await Editing.SetSectionHiddenAsync(s.Id, !s.IsHidden);
        await OnChanged.InvokeAsync();
    });

    // Sposta la sotto-sezione prima/dopo il corpo del padre (doc 11 §3g): stato per-sezione, versionato.
    private Task ToggleBeforeParentBody(EditableSection s) => Run(async () =>
    {
        await Editing.SetSectionBeforeParentBodyAsync(s.Id, !s.BeforeParentBody);
        await OnChanged.InvokeAsync();
    });

    // ---- blocchi ----
    private Task AddBlock(int sectionId, BlockFormat format) => Run(async () =>
    {
        var id = await Editing.AddBlockAsync(sectionId, format, BlockTier.Extended, BlockVisibility.Always);
        if (format == BlockFormat.Table)
            await Editing.UpdateBlockAsync(id, new BlockEdit
            {
                Tier = BlockTier.Extended, Visibility = BlockVisibility.Always,
                BodyJson = """{"columns":["Colonna 1","Colonna 2"],"rows":[]}""",
            });
        await OnChanged.InvokeAsync();
    });

    private Task DeleteBlock(int blockId) => Run(async () =>
    {
        await Editing.DeleteBlockAsync(blockId);
        await OnChanged.InvokeAsync();
    });

    private Task MoveBlock(int blockId, int dir) => Run(async () =>
    {
        await Editing.MoveBlockAsync(blockId, dir);
        await OnChanged.InvokeAsync();
    });

    private Task SaveBlock(EditableBlock b, string? body = null, string? bodyJson = null, CalloutKind? kind = null) => Run(async () =>
    {
        await Editing.UpdateBlockAsync(b.Id, new BlockEdit
        {
            Tier = b.Tier,
            Visibility = b.Visibility,
            CalloutKind = kind ?? b.CalloutKind,
            Body = body ?? b.Body,
            BodyJson = bodyJson ?? b.BodyJson,
            RowVersion = b.RowVersion,
        });
        await OnChanged.InvokeAsync();
    });

    // ---- render sezione (ricorsivo) ----
    // relDepth = profondità RELATIVA alla radice di render (RootSections), non l'assoluta s.Depth: la vIPI ACC passa i
    // FIGLI di un blocco come RootSections (s.Depth=1) ma devono rendersi come card di primo livello (.block), come APP/vLOA.
    private RenderFragment SectionEditor(EditableSection s, int relDepth) => __builder =>
    {
        var mand = IsMandatory?.Invoke(s) == true;
        var hid = s.IsHidden;
        if (relDepth == 0)
        {
            // Primo livello = card .block COLLASSABILE (CollapsibleBlock), coerente con tutti gli editor/viewer.
            // Alcune sezioni nascono chiuse anche in editing (doc 11 §3i): lo dice il catalogo, non l'host.
            <CollapsibleBlock @key="s.Id" Id="@($"s-{s.Id}")" Style="@(hid ? "opacity:.5" : null)"
                              InitiallyOpen="@(!SectionCatalog.IsInitiallyCollapsed(s.SectionKey))">
                <Header>@SectionHeader(s, mand, hid, true)</Header>
                <ChildContent>@SectionBody(s, relDepth)</ChildContent>
            </CollapsibleBlock>
        }
        else
        {
            var baseStyle = "padding:10px;margin:8px 0";
            <div class="coord-sub" id="@($"s-{s.Id}")" style="@(hid ? baseStyle + ";opacity:.5" : baseStyle)">
                @SectionHeader(s, mand, hid, false)
                @SectionBody(s, relDepth)
            </div>
        }
    };

    // Intestazione (titolo/rinomina + azioni). depth0 = h3, annidata = h4.
    private RenderFragment SectionHeader(EditableSection s, bool mand, bool hid, bool depth0) => __builder =>
    {
        @* Header dentro il <summary> di CollapsibleBlock (depth0): preventDefault impedisce che il click sui
           controlli (rinomina/sposta/elimina/nascondi) collassi la card. Il toggle resta sul solo chevron. *@
        <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px" @onclick:preventDefault="true" @onclick:stopPropagation="true">
            @if (IsEditing && !mand)
            {
                <input class="app-in" style="font-weight:700;flex:1;max-width:420px" value="@s.Title"
                       @onchange="e => RenameSection(s.Id, AsString(e.Value))" />
                <button class="btn ghost" title="@L["Common_Up"]" @onclick="() => MoveSection(s.Id, -1)">↑</button>
                <button class="btn ghost" title="@L["Common_Down"]" @onclick="() => MoveSection(s.Id, 1)">↓</button>
                <button class="btn ghost" title="@L["Dse_AddSubsectionTitle"]" @onclick="() => AddSection(s.Id)">+ @L["Dse_Subsection"]</button>
                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Dse_DeleteSection"]" TriggerTitle="@L["Dse_DeleteSection"]"
                               Prompt="@L["Dse_DeleteSectionPrompt"]" OnConfirm="() => DeleteSection(s.Id)"><Trigger><Icon Name="x" /></Trigger></InlineConfirm>
            }
            else
            {
                @if (depth0) { <h3 style="margin:0">@s.Title</h3> } else { <h4 style="margin:0">@s.Title</h4> }
                @if (mand) { <span class="pill grey" title="@L["Dse_MandatoryTitle"]">@L["Dse_Mandatory"]</span> }
                @if (IsEditing && mand)
                {
                    <button class="btn ghost" title="@L["Dse_AddSubsectionExtraTitle"]" @onclick="() => AddSection(s.Id)">+ @L["Dse_Subsection"]</button>
                }
            }
            @if (IsRenderModeToggleable?.Invoke(s) == true)
            {
                var live = s.RenderMode == RenderMode.Live;
                <span class="pill @(live ? "green" : "grey")"
                      title="@(live ? L["Dse_LiveTitle"] : L["Dse_FrozenTitle"])">
                    @(live ? "🔴 " + L["Dse_Live"] : "🧊 " + L["Dse_Frozen"])
                </span>
                @if (IsEditing)
                {
                    <button class="btn ghost" title="@(live ? L["Dse_FreezeTitle"] : L["Dse_MakeLiveTitle"])"
                            @onclick="() => SetRenderMode(s.Id, live ? RenderMode.Frozen : RenderMode.Live)">
                        @(live ? "🧊 " + L["Dse_Freeze"] : "🔴 " + L["Dse_MakeLive"])
                    </button>
                }
            }
            @if (IsEditing)
            {
                <button class="btn ghost" style="@(IsRenderModeToggleable?.Invoke(s) == true ? null : "margin-left:auto")" title="@(hid ? L["Dse_ShowInDocTitle"] : L["Dse_HideFromDocTitle"])"
                        @onclick="() => ToggleHidden(s)">@(hid ? "🙈 " + L["Dse_HiddenState"] : "👁 " + L["Dse_Hide"])</button>
            }
            @* Posizione rispetto al corpo del padre: solo per le SOTTO-sezioni (una sezione di primo livello non ha
               un corpo che la preceda). Doc 11 §3g. *@
            @if (IsEditing && !depth0)
            {
                <button class="btn ghost" title="@(s.BeforeParentBody ? L["Dse_MoveAfterBodyTitle"] : L["Dse_MoveBeforeBodyTitle"])"
                        @onclick="() => ToggleBeforeParentBody(s)">
                    @(s.BeforeParentBody ? "⤓ " + L["Dse_AfterBody"] : "⤒ " + L["Dse_BeforeBody"])
                </button>
            }
        </div>
    };

    // Corpo a TRE SLOT (doc 11 §3g): sotto-sezioni «prima» → corpo (derivato dall'host o blocchi editoriali) →
    // sotto-sezioni «dopo». Stessa sequenza dei viewer.
    private RenderFragment SectionBody(EditableSection s, int relDepth) => __builder =>
    {
        @foreach (var c in s.Children.Where(c => c.BeforeParentBody))
        {
            @SectionEditor(c, relDepth + 1)
        }

        @if (IsDerivedSection?.Invoke(s) == true)
        {
            @DerivedContent?.Invoke(s)
        }
        else
        {
            @foreach (var b in s.Blocks)
            {
                @BlockEditor(s, b)
            }

            @if (IsEditing)
            {
                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
                    <button class="btn ghost" @onclick="() => AddBlock(s.Id, BlockFormat.Prose)">+ @L["Dse_Paragraph"]</button>
                    <button class="btn ghost" @onclick="() => AddBlock(s.Id, BlockFormat.Callout)">+ Callout</button>
                    <button class="btn ghost" @onclick="() => AddBlock(s.Id, BlockFormat.Table)">+ @L["Dse_Table"]</button>
                </div>
            }
        }

        @foreach (var c in s.Children.Where(c => !c.BeforeParentBody))
        {
            @SectionEditor(c, relDepth + 1)
        }
    };

    // ---- render blocco per formato ----
    private RenderFragment BlockEditor(EditableSection s, EditableBlock b) => __builder =>
    {
        @if (!IsEditing)
        {
            @ReadOnlyBlock(b)
        }
        else
        {
        <div class="app-block-edit" style="align-items:flex-start;gap:8px;margin:6px 0">
            <div style="flex:1">
                @switch (b.Format)
                {
                    case BlockFormat.Prose:
                    case BlockFormat.List:
                        <textarea class="app-ta" rows="3" value="@b.Body" placeholder="@L["Dse_TextMarkdownPh"]"
                                  @onchange="e => SaveBlock(b, body: AsString(e.Value))"></textarea>
                        break;
                    case BlockFormat.Callout:
                        <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px">
                            <span class="muted" style="font-size:12px">@L["Dse_TypeLabel"]</span>
                            <select class="app-in" style="max-width:150px" value="@b.CalloutKind"
                                    @onchange="e => SaveBlock(b, kind: Enum.Parse<CalloutKind>(AsString(e.Value)))">
                                @foreach (var k in Enum.GetValues<CalloutKind>()) { <option value="@k">@k</option> }
                            </select>
                        </div>
                        <textarea class="app-ta" rows="2" value="@b.Body" placeholder="@L["Dse_CalloutTextPh"]"
                                  @onchange="e => SaveBlock(b, body: AsString(e.Value))"></textarea>
                        break;
                    case BlockFormat.Table:
                        @TableEditor(b)
                        break;
                    default:
                        <p class="muted">@(string.Format(L["Dse_BlockNotEditable"].Value, b.Format))</p>
                        break;
                }
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
                <button class="btn ghost" title="@L["Common_Up"]" @onclick="() => MoveBlock(b.Id, -1)">↑</button>
                <button class="btn ghost" title="@L["Common_Down"]" @onclick="() => MoveBlock(b.Id, 1)">↓</button>
                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Dse_DeleteBlock"]" TriggerTitle="@L["Dse_DeleteBlock"]"
                               Prompt="@L["Dse_DeleteBlockPrompt"]" OnConfirm="() => DeleteBlock(b.Id)"><Trigger><Icon Name="x" /></Trigger></InlineConfirm>
            </div>
        </div>
        }
    };

    private RenderFragment ReadOnlyBlock(EditableBlock b) => __builder =>
    {
        switch (b.Format)
        {
            case BlockFormat.Callout:
                <div class="callout @((b.CalloutKind ?? CalloutKind.Info).ToString().ToLowerInvariant())">
                    <span class="cic"><Icon Name="@CalloutIcon(b.CalloutKind ?? CalloutKind.Info)" Size="18" /></span>
                    <div>@MarkdownLite.Render(b.Body)</div>
                </div>
                break;
            case BlockFormat.Table:
                @RenderTablePreview(b)
                break;
            default:
                @if (!string.IsNullOrWhiteSpace(b.Body)) { <div class="prose">@MarkdownLite.Render(b.Body)</div> }
                break;
        }
    };

    private static string CalloutIcon(CalloutKind k) => k switch
    {
        CalloutKind.Success => "check-circle", CalloutKind.Warning => "warning", CalloutKind.Danger => "octagon", _ => "info",
    };

    // ---- editor tabella (columns + rows di celle) ----
    private (List<string> Cols, List<List<string>> Rows) ParseTable(string? json)
    {
        var cols = new List<string>();
        var rows = new List<List<string>>();
        if (string.IsNullOrWhiteSpace(json)) return (cols, rows);
        try
        {
            using var doc = JsonDocument.Parse(json);
            var r = doc.RootElement;
            if (r.TryGetProperty("columns", out var c) && c.ValueKind == JsonValueKind.Array)
                cols = c.EnumerateArray().Select(e => e.GetString() ?? "").ToList();
            if (r.TryGetProperty("rows", out var rr) && rr.ValueKind == JsonValueKind.Array)
                foreach (var row in rr.EnumerateArray())
                    rows.Add(row.TryGetProperty("cells", out var cs) && cs.ValueKind == JsonValueKind.Array
                        ? cs.EnumerateArray().Select(e => e.GetString() ?? "").ToList()
                        : new List<string>());
        }
        catch (JsonException) { }
        return (cols, rows);
    }

    private static string SerializeTable(List<string> cols, List<List<string>> rows) =>
        JsonSerializer.Serialize(new { columns = cols, rows = rows.Select(r => new { cells = r }) });

    // Ogni mutazione ri-parsa il BodyJson corrente, applica, serializza e salva (nessuno stato catturato tra render).
    private Task SetTableCol(EditableBlock b, int ci, string val)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        if (ci < cols.Count) cols[ci] = val;
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }
    private Task RemoveTableCol(EditableBlock b, int ci)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        if (ci < cols.Count) cols.RemoveAt(ci);
        foreach (var r in rows) if (ci < r.Count) r.RemoveAt(ci);
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }
    private Task AddTableCol(EditableBlock b)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        cols.Add($"Colonna {cols.Count + 1}");
        foreach (var r in rows) r.Add("");
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }
    private Task SetTableCell(EditableBlock b, int ri, int ci, string val)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        if (ri < rows.Count) { while (rows[ri].Count <= ci) rows[ri].Add(""); rows[ri][ci] = val; }
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }
    private Task AddTableRow(EditableBlock b)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        rows.Add(Enumerable.Repeat(string.Empty, Math.Max(1, cols.Count)).ToList());
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }
    private Task RemoveTableRow(EditableBlock b, int ri)
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        if (ri < rows.Count) rows.RemoveAt(ri);
        return SaveBlock(b, bodyJson: SerializeTable(cols, rows));
    }

    private RenderFragment TableEditor(EditableBlock b) => __builder =>
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        <table class="cfg-table">
            <thead>
                <tr>
                    @for (var ci = 0; ci < cols.Count; ci++)
                    {
                        var cidx = ci;
                        <th>
                            <div style="display:flex;gap:4px;align-items:center">
                                <input class="app-in" value="@cols[cidx]" @onchange="e => SetTableCol(b, cidx, AsString(e.Value))" />
                                <button class="btn ghost" title="@L["Dse_RemoveColumn"]" @onclick="() => RemoveTableCol(b, cidx)">✕</button>
                            </div>
                        </th>
                    }
                    <th style="width:42px"><button class="btn ghost" title="@L["Dse_AddColumn"]" @onclick="() => AddTableCol(b)">＋</button></th>
                </tr>
            </thead>
            <tbody>
                @for (var ri = 0; ri < rows.Count; ri++)
                {
                    var ridx = ri;
                    <tr>
                        @for (var ci = 0; ci < cols.Count; ci++)
                        {
                            var cidx = ci;
                            var cell = cidx < rows[ridx].Count ? rows[ridx][cidx] : "";
                            <td><input class="app-in" value="@cell" @onchange="e => SetTableCell(b, ridx, cidx, AsString(e.Value))" /></td>
                        }
                        <td><button class="btn ghost" title="@L["Dse_RemoveRow"]" @onclick="() => RemoveTableRow(b, ridx)">✕</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn ghost" style="margin-top:6px" @onclick="() => AddTableRow(b)">+ @L["Dse_Row"]</button>
    };

    private RenderFragment RenderTablePreview(EditableBlock b) => __builder =>
    {
        var (cols, rows) = ParseTable(b.BodyJson);
        @if (cols.Count > 0 || rows.Count > 0)
        {
            <table class="cfg-table">
                <thead><tr>@foreach (var c in cols) { <th>@c</th> }</tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>@for (var i = 0; i < cols.Count; i++) { <td>@(i < r.Count ? r[i] : "")</td> }</tr>
                    }
                </tbody>
            </table>
        }
    };
}
