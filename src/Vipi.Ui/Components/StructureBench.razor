@inject ICoverageBenchService Bench
@inject IStringLocalizer<SharedResource> L
@* Il banco di prova della struttura: «con questi aperti, chi tiene cosa — e i trasferimenti a chi vanno».

   ⚠️ Non calcola niente da sé: chiede a `ICoverageBenchService`, che usa le stesse due porte della mappa AoR, della
   tabella delle configurazioni e della vista live. E non scrive niente: è una domanda, non una modifica — per
   questo funziona anche senza il lock della struttura.

   ⚠️ Le letture passano dalla FILA della pagina (`InFila`): il servizio è scoped come gli altri della pagina, e
   due letture insieme sullo stesso DbContext sono «A second operation was started» (U-012). *@

<div class="bench">
    <p class="muted" style="margin:0 0 10px">@L["Bench_Intro"]</p>

    <div class="inline-form" style="align-items:flex-end;gap:10px;flex-wrap:wrap">
        <div class="field">
            <label class="app-lbl" for="bench-acc">@L["Bench_Acc"]</label>
            <select id="bench-acc" class="app-in" @onchange="e => ScegliAccAsync(e.Value?.ToString())">
                <option value="" selected="@(_acc is null)">@L["Bench_PickAcc"]</option>
                @foreach (var a in Accs.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@a.Code" selected="@(a.Code == _acc)">@a.Code — @a.Name</option>
                }
            </select>
        </div>
        @if (_scope is not null)
        {
            <button type="button" class="btn ghost" disabled="@_busy" title="@L["Bench_AllOpenTitle"]" @onclick="() => ApriAsync(_tutti)">@L["Bench_AllOpen"]</button>
            <button type="button" class="btn ghost" disabled="@_busy" title="@L["Bench_AllClosedTitle"]" @onclick="() => ApriAsync(_open.Where(a => !DiCasa(a)).ToList())">@L["Bench_AllClosed"]</button>
        }
    </div>

    @if (_errore is not null)
    {
        <p class="st-msg warn" role="alert">@_errore</p>
    }

    @if (_scope is not null)
    {
        @if (_scope.Groups.Count > 0)
        {
            @* Una riga di tasti PER GRUPPO: una configurazione cambia i soli settori del suo gruppo, e lo scenario è
               la combinazione — un'area, e per ogni ente la sua. *@
            <p class="app-lbl" style="margin:12px 0 4px">@L["Bench_Presets"]</p>
            @foreach (var g in _scope.Groups)
            {
                @Tasti(g)
            }
        }
        else
        {
            <p class="muted" style="margin:12px 0 0">@L["Bench_NoPresets"]</p>
        }

        @foreach (var area in new[] { true, false })
        {
            var gruppo = _scope.Sectors.Where(s => s.Area == area).ToList();
            if (gruppo.Count == 0) continue;
            <p class="app-lbl" style="margin:12px 0 4px">@(area ? L["Bench_Area"] : L["Bench_App"])</p>
            @Interruttori(gruppo)
        }

        @if (_scope.Neighbours.Count > 0)
        {
            @* Gli enti degli ALTRI centri che compaiono negli accordi dell'ACC, e chi li raccoglie: fino al 12 ottobre
               2026 erano aperti per costruzione, e un trasferimento fra due ACC si poteva provare da un lato solo. *@
            <p class="app-lbl" style="margin:14px 0 2px">@L["Bench_Neighbours"]</p>
            <p class="muted bench-nb-hint">@L["Bench_NeighboursHint"]</p>
            @foreach (var v in _scope.Neighbours)
            {
                var vicino = v;
                var tuttiAperti = vicino.Sectors.All(s => _open.Contains(s.Callsign));
                <div class="bench-nb" data-bench-acc="@vicino.AccCode">
                    <div class="bench-grp">
                        <span class="bench-grp-name bench-nb-name">
                            @(vicino.AccCode.Length == 0 ? L["Bench_NeighbourUnknown"].Value : vicino.AccCode)
                            @if (vicino.AccName.Length > 0) { <span class="muted">@vicino.AccName</span> }
                        </span>
                        <button type="button" class="btn ghost bench-nb-all" disabled="@_busy"
                                @onclick="() => TuttoIlCentroAsync(vicino, !tuttiAperti)">
                            @(tuttiAperti ? L["Bench_CloseAll"] : L["Bench_OpenAll"])
                        </button>
                    </div>
                    @foreach (var g in vicino.Groups)
                    {
                        @Tasti(g)
                    }
                    @Interruttori(vicino.Sectors)
                </div>
            }
        }

        @if (_esito is not null)
        {
            @* Lo scenario non è una configurazione possibile dichiarata: si dice, e si risponde lo stesso. *@
            @foreach (var fuori in _esito.NonPreviste)
            {
                <p class="st-msg warn bench-notforeseen" style="margin-top:12px">
                    @L["Bench_NotForeseen", fuori.Elenco.Codice, string.Join(" + ", fuori.Aperti)]
                </p>
            }
            <table class="cfg-table" style="margin-top:14px">
                <thead><tr><th>@L["Bench_ColOpen"]</th><th>@L["Bench_ColHolds"]</th></tr></thead>
                <tbody>
                    @foreach (var g in _esito.Coverage)
                    {
                        <tr class="grp-start">
                            <td class="uni">
                                @(g.Holder ?? L["Bench_Nobody"].Value)
                                @if (g.Outside) { <span class="acc-tag">@L["Bench_Outside"]</span> }
                            </td>
                            <td class="@(g.Holder is null ? "bench-warn" : null)">
                                @(g.Items.Count == 0 ? "—" : string.Join(", ", g.Items.Select(Voce)))
                            </td>
                        </tr>
                    }
                    @if (_esito.Coverage.Count == 0)
                    {
                        <tr><td colspan="2" class="muted">@L["Bench_NothingOpen"]</td></tr>
                    }
                </tbody>
            </table>

            @* Tutte le clausole, una riga ciascuna, con l'esito. ⚠️ Di suo si vedono TUTTE: fino al 12 ottobre 2026
               il banco mostrava i soli punti che cambiavano mano, e un trasferimento che funziona come è scritto
               non c'era — chi lo cercava lo dava per perso. *@
            var righe = CoverageBench.Trasferimenti(_esito.Transfers);
            int Quante(BenchTransferState s) => righe.Count(r => r.State == s);
            <details class="cfg-collapse coord-sub" style="margin-top:14px" open>
                <summary>
                    <span>@L["Bench_Transfers"] — @L["Bench_TransfersCount", righe.Count, Quante(BenchTransferState.AsWritten),
                        Quante(BenchTransferState.PickedUp), Quante(BenchTransferState.ToItself), Quante(BenchTransferState.Uncovered)]</span><span class="chev">▸</span>
                </summary>
                <div class="body">
                    <div class="bench-filter" role="group" aria-label="@L["Bench_Filter"]">
                        @foreach (var f in new[] { Filtro.Tutte, Filtro.Cambiano, Filtro.Scoperte })
                        {
                            var filtro = f;
                            <button type="button" class="sp-item @(_filtro == filtro ? "on" : null)"
                                    aria-pressed="@((_filtro == filtro).ToString().ToLowerInvariant())"
                                    @onclick="() => _filtro = filtro">
                                @NomeDi(filtro)
                                <b>@righe.Count(r => Passa(filtro, r))</b>
                            </button>
                        }
                    </div>
                    @{ var mostrate = righe.Where(r => Passa(_filtro, r)).ToList(); }
                    @if (mostrate.Count == 0)
                    {
                        <p class="muted">@(righe.Count == 0 ? L["Bench_NoAgreements"] : L["Bench_NoTransfers"])</p>
                    }
                    else
                    {
                        <table class="res-table">
                            <thead>
                                <tr>
                                    <th>@L["Bench_ColFlow"]</th>
                                    <th>@L["Bench_ColWrittenFrom"]</th>
                                    <th>@L["Bench_ColFrom"]</th>
                                    <th>@L["Bench_ColPoint"]</th>
                                    <th>@L["Bench_ColLevel"]</th>
                                    <th>@L["Bench_ColWrittenTo"]</th>
                                    <th>@L["Bench_ColTo"]</th>
                                    <th>@L["Bench_ColState"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in mostrate)
                                {
                                    var aSe = r.State == BenchTransferState.ToItself;
                                    <tr class="@(aSe ? "bench-self" : null)">
                                        <td>@XferLabels.Kind(L, r.Kind) @string.Join(", ", r.Airports)</td>
                                        <td class="bench-cs">@r.WrittenSender</td>
                                        <td class="bench-cs @(r.Sender is null ? "bench-warn" : r.SenderDiffers && !aSe ? "bench-diff" : null)">
                                            @(r.Sender ?? L["Bench_Nobody"].Value)
                                        </td>
                                        <td>@string.Join(", ", r.Points)</td>
                                        <td>
                                            @r.Level
                                            @if (r.Condition is not null) { <span class="fb-seq-tag">@r.Condition</span> }
                                        </td>
                                        <td class="bench-cs">@r.WrittenReceiver</td>
                                        <td class="bench-cs @(r.Receiver is null ? "bench-warn" : r.ReceiverDiffers && !aSe ? "bench-diff" : null)">
                                            @(r.Receiver ?? L["Bench_Nobody"].Value)
                                            @if (r.ByCoverage) { <span class="fb-seq-tag">@L["Bench_ByCoverage"]</span> }
                                        </td>
                                        <td class="bench-state @(r.State == BenchTransferState.Uncovered ? "bench-warn" : null)">@Esito(r.State)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    }
</div>

@code {
    /// <summary>Gli ACC fra cui scegliere: quelli che la pagina ha già letto.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<AccRow> Accs { get; set; } = Array.Empty<AccRow>();

    /// <summary>La fila della pagina ospite: ogni lettura del banco ci passa dentro.</summary>
    [Parameter, EditorRequired] public Func<Func<Task>, Task> InFila { get; set; } = op => op();

    /// <summary>L'ACC su cui aprirsi (chi arriva dai Trasferimenti). Sconosciuto o vuoto = nessuno scelto.</summary>
    [Parameter] public string? AccIniziale { get; set; }

    private string? _acc;
    private BenchScope? _scope;
    private BenchOutcome? _esito;
    private readonly HashSet<string> _open = new(StringComparer.OrdinalIgnoreCase);
    private bool _busy;
    private Filtro _filtro = Filtro.Tutte;

    /// <summary>Tutto ciò che il banco apre e chiude: i settori dell'ACC e gli altri enti dei suoi accordi.</summary>
    private readonly HashSet<string> _tutti = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>I soli altri enti: è lo scenario in più che si dice al servizio a ogni domanda.</summary>
    private readonly List<string> _altri = new();

    private bool DiCasa(string callsign) =>
        _scope is not null && _scope.Sectors.Any(s => string.Equals(s.Callsign, callsign, StringComparison.OrdinalIgnoreCase));

    /// <summary>I tasti delle configurazioni di un gruppo: la stessa riga per l'ACC e per un altro centro.</summary>
    private RenderFragment Tasti(BenchPresetGroup gruppo) => __builder =>
    {
        <div class="bench-grp">
            <span class="bench-grp-name">@gruppo.Name</span>
            <div class="sector-pick">
                @foreach (var p in gruppo.Presets)
                {
                    var preset = p;
                    <button type="button" class="sp-item @(Accesa(gruppo, preset) ? "on" : null)" disabled="@_busy"
                            title="@string.Join(" · ", preset.Open)" @onclick="() => SceglieAsync(gruppo, preset)">
                        @preset.Name
                    </button>
                }
            </div>
        </div>
    };

    /// <summary>Un interruttore per settore: acceso = aperto.</summary>
    private RenderFragment Interruttori(IReadOnlyList<BenchSector> settori) => __builder =>
    {
        <div class="sector-pick">
            @foreach (var s in settori)
            {
                var settore = s;
                <button type="button" class="sp-item @(_open.Contains(settore.Callsign) ? "on" : null)" disabled="@_busy"
                        aria-pressed="@_open.Contains(settore.Callsign).ToString().ToLowerInvariant()"
                        title="@settore.Name" @onclick="() => CambiaAsync(settore.Callsign)">
                    @settore.Callsign
                </button>
            }
        </div>
    };
    private string? _errore;

    /// <summary>Quali clausole si guardano. Si parte da tutte: un trasferimento che non compare sembra mancare.</summary>
    private enum Filtro { Tutte, Cambiano, Scoperte }

    /// <summary>
    /// ⚠️ «A sé stesso» <b>non</b> è un cambio di mano: WS2 che raccoglie Genova chiusa non passa niente a nessuno,
    /// ed è il caso che la vista live toglie dall'elenco. Resta fra «tutte», attenuato.
    /// </summary>
    private static bool Passa(Filtro filtro, BenchTransferRow r) => filtro switch
    {
        Filtro.Cambiano => r.State is BenchTransferState.PickedUp or BenchTransferState.Uncovered,
        Filtro.Scoperte => r.State == BenchTransferState.Uncovered,
        _ => true,
    };

    private string NomeDi(Filtro filtro) => filtro switch
    {
        Filtro.Cambiano => L["Bench_FilterChanged"],
        Filtro.Scoperte => L["Bench_FilterUncovered"],
        _ => L["Bench_FilterAll"],
    };

    private string Esito(BenchTransferState stato) => stato switch
    {
        BenchTransferState.PickedUp => L["Bench_StatePicked"],
        BenchTransferState.ToItself => L["Bench_StateSelf"],
        BenchTransferState.Uncovered => L["Bench_StateNobody"],
        _ => L["Bench_StateWritten"],
    };

    protected override async Task OnInitializedAsync()
    {
        var iniziale = Accs.FirstOrDefault(a => string.Equals(a.Code, AccIniziale?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (iniziale is not null) await ScegliAccAsync(iniziale.Code);
    }

    private static string Voce(BenchItem i) => i.Band is null ? i.Sector : $"{i.Sector} ({i.Band})";

    /// <summary>La configurazione è quella in atto <b>nel suo gruppo</b>: degli altri gruppi non dice niente.</summary>
    private bool Accesa(BenchPresetGroup gruppo, BenchPreset preset)
    {
        var oic = StringComparer.OrdinalIgnoreCase;
        return _open.Where(a => gruppo.Sectors.Contains(a, oic)).ToHashSet(oic)
            .SetEquals(preset.Open.Where(a => gruppo.Sectors.Contains(a, oic)));
    }

    /// <summary>Sceglie una configurazione: cambiano i soli settori del suo gruppo, gli altri restano come sono.</summary>
    private Task SceglieAsync(BenchPresetGroup gruppo, BenchPreset preset) =>
        ApriAsync(CoverageBench.ConPreset(_open.ToList(), gruppo.Sectors, preset.Open));

    /// <summary>Apre o chiude in un gesto tutti gli enti di un altro centro; il resto dello scenario non si tocca.</summary>
    private Task TuttoIlCentroAsync(BenchNeighbour vicino, bool apri)
    {
        var suoi = vicino.Sectors.Select(s => s.Callsign).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var aperti = _open.Where(a => !suoi.Contains(a)).ToList();
        if (apri) aperti.AddRange(suoi);
        return ApriAsync(aperti);
    }

    private Task ScegliAccAsync(string? acc) => GuardatoAsync(async () =>
    {
        _acc = string.IsNullOrWhiteSpace(acc) ? null : acc;
        _scope = null;
        _esito = null;
        _open.Clear();
        _tutti.Clear();
        _altri.Clear();
        if (_acc is null) return;

        _scope = await Bench.ScopeAsync(_acc);
        if (_scope is null) return;
        foreach (var s in _scope.Sectors) _tutti.Add(s.Callsign);
        foreach (var s in _scope.Neighbours.SelectMany(v => v.Sectors))
            if (_tutti.Add(s.Callsign)) _altri.Add(s.Callsign);
        // Si parte da «tutti aperti», altri centri compresi: ognuno tiene il suo, e chiudendone uno si vede chi lo
        // raccoglie. È lo scenario di sempre — fuori dall'ACC era tutto aperto anche quando non si poteva chiudere.
        foreach (var s in _tutti) _open.Add(s);
        _esito = await Bench.SimulateAsync(_acc, _open, _altri);
    });

    private Task CambiaAsync(string callsign) => GuardatoAsync(async () =>
    {
        if (!_open.Remove(callsign)) _open.Add(callsign);
        _esito = await Bench.SimulateAsync(_acc!, _open, _altri);
    });

    private Task ApriAsync(IEnumerable<string> aperti) => GuardatoAsync(async () =>
    {
        if (_scope is null) return;
        // ⚠️ L'elenco si copia PRIMA di vuotare: chi chiama passa spesso una vista sugli aperti di adesso.
        var nuovi = aperti.Where(_tutti.Contains).ToList();
        _open.Clear();
        foreach (var a in nuovi) _open.Add(a);
        _esito = await Bench.SimulateAsync(_acc!, _open, _altri);
    });

    /// <summary>Ogni gesto: in fila con la pagina, e un guasto del servizio diventa una frase invece di un circuito giù.</summary>
    private async Task GuardatoAsync(Func<Task> gesto)
    {
        if (_busy) return;
        _busy = true;
        _errore = null;
        try { await InFila(gesto); }
        catch (ValidationException ex) { _errore = ex.Message; }
        catch (EditNotAllowedException ex) { _errore = ex.Message; }
        catch (InvalidOperationException ex) { _errore = ex.Message; }
        catch (Exception ex) { _errore = L["Common_UnexpectedError"] + ex.Message; }
        finally { _busy = false; }
    }
}
