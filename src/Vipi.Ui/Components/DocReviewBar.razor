@* Le segnalazioni aperte su un documento — la «casella degli impatti» (carta 2026-08-25). Una riga per fatto:
   un settore sparito, un'area cambiata, la copia pubblicata rimasta indietro. Fino al 25 agosto 2026 era UN
   motivo solo, e il secondo evento cancellava il primo.
   ⚠️ Il ✓ non c'è su tutte: le righe CALCOLATE (deriva, bersaglio di release) le richiude il controllo che le
   ha aperte, e un ✓ sarebbe un ping-pong con il giro notturno.
   Componente autonomo: passa il DocumentId, interroga lo stato e chiude da sé. *@
@using Vipi.Application.Content
@using Vipi.Domain
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IStringLocalizer<SharedResource> L
@* Servizio risolto dallo scope DI proprio (VipiDbContext isolato dal circuito): evita il crash "second
   operation" quando questo sidecar carica mentre la pagina genitore ha ancora una query in volo. [[EditLockBar]] *@

@if (_righe.Count > 0)
{
    <div class="callout warning">
        <span class="cic">⚠️</span>
        <div style="flex:1">
            <p class="ct">@L["Impact_Title", _righe.Count]</p>
            <ul class="impact-list">
                @foreach (var r in _righe)
                {
                    <li>
                        @if (r.IsPublicNow)
                        {
                            <span class="pill red" title="@L["Impact_PublicNowTitle"]">@L["Impact_PublicNow"]</span>
                        }
                        else if (r.Kind.IsDaRipubblicare())
                        {
                            <span class="pill blue" title="@L["Impact_RepublishTitle"]">@L["Impact_Republish"]</span>
                        }
                        else if (r.Kind.IsRotto())
                        {
                            <span class="pill amber">@L["Impact_Broken"]</span>
                        }
                        <span>@Frase(r)</span>
                        @if (r.CanClear)
                        {
                            <button class="btn ghost" disabled="@_busy" @onclick="() => Chiudi(r.Id)"
                                    title="@L["Review_MarkTitle"]">✓ @L["Review_MarkReviewed"]</button>
                        }
                        else
                        {
                            <span class="muted">@L["Impact_AutoClose"]</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    /// <summary>Documento di cui mostrare le segnalazioni aperte. null = niente banner.</summary>
    [Parameter] public int? DocumentId { get; set; }
    /// <summary>Notifica opzionale alla pagina quando una segnalazione viene chiusa.</summary>
    [Parameter] public EventCallback OnResolved { get; set; }

    private IReadOnlyList<DocumentImpactRow> _righe = Array.Empty<DocumentImpactRow>();
    private int? _loadedFor;
    private bool _busy;

    private IDocumentImpactService Impacts = default!;
    protected override void OnInitialized()
        => Impacts = ScopedServices.GetRequiredService<IDocumentImpactService>();

    protected override async Task OnParametersSetAsync()
    {
        if (DocumentId == _loadedFor) return;   // evita ricariche a ogni render
        _loadedFor = DocumentId;
        await RicaricaAsync();
    }

    private async Task RicaricaAsync() =>
        _righe = DocumentId is int id
            ? await Impacts.ListOpenAsync(id)
            : Array.Empty<DocumentImpactRow>();

    /// <summary>La frase la compone la UI dalla chiave e dagli argomenti: in archivio non c'è testo, quindi la
    /// stessa riga si legge in italiano o in inglese secondo chi guarda.</summary>
    private string Frase(DocumentImpactRow r) => r.ReasonArgs.Count switch
    {
        0 => L[r.ReasonKey].Value,
        1 => L[r.ReasonKey, r.ReasonArgs[0]].Value,
        _ => L[r.ReasonKey, r.ReasonArgs[0], r.ReasonArgs[1]].Value,
    };

    private async Task Chiudi(int impactId)
    {
        _busy = true;
        try
        {
            await Impacts.ClearAsync(impactId);
            await RicaricaAsync();
            await OnResolved.InvokeAsync();
        }
        finally { _busy = false; }
    }
}
