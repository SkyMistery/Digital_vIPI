@* Che cosa resta da fare su QUESTO documento, in cima al suo editor.

   Fino al 26 agosto 2026 mostrava solo le segnalazioni del sistema, e gli incarichi assegnati sullo stesso
   documento vivevano in un'altra pagina: chi apriva l'editor vedeva metà del lavoro che lo riguardava.
   Ora legge il read-model unico (`IWorkListService`), quindi le due nature stanno nello stesso banner e la
   riga è resa dallo STESSO componente dell'elenco — carta 2026-08-26-da-fare-una-lista-sola.md §2/D4.

   ⚠️ Il ✓ non c'è su tutte: le righe CALCOLATE (deriva, bersaglio di release) le richiude il controllo che
   le ha aperte, e un ✓ sarebbe un ping-pong con il giro notturno. Al loro posto c'è l'azione che le risolve.
   Componente autonomo: passa il DocumentId, interroga lo stato e chiude da sé. *@
@using Vipi.Application.Content
@using Vipi.Domain
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IStringLocalizer<SharedResource> L
@* Servizi risolti dallo scope DI proprio (VipiDbContext isolato dal circuito): evita il crash "second
   operation" quando questo sidecar carica mentre la pagina genitore ha ancora una query in volo. [[EditLockBar]] *@

@if (_righe.Count > 0)
{
    <div class="callout warning">
        <span class="cic">⚠️</span>
        <div style="flex:1">
            <p class="ct">@L["Impact_Title", _righe.Count]</p>
            <ul class="impact-list wi-list">
                @foreach (var r in _righe)
                {
                    <WorkItemRow @key="r.Chiave" Item="r" ShowAcc="false" Busy="_busy"
                                 OnDone="Chiudi" OnStart="Avvia" />
                }
            </ul>
        </div>
    </div>
}

@code {
    /// <summary>Documento di cui mostrare che cosa resta da fare. null = niente banner.</summary>
    [Parameter] public int? DocumentId { get; set; }
    /// <summary>Notifica opzionale alla pagina quando una riga viene chiusa.</summary>
    [Parameter] public EventCallback OnResolved { get; set; }

    private IReadOnlyList<WorkItem> _righe = Array.Empty<WorkItem>();
    private int? _loadedFor;
    private bool _busy;

    private IWorkListService Lavoro = default!;
    private IDocumentImpactService Impacts = default!;
    private IEditorTaskService Incarichi = default!;

    protected override void OnInitialized()
    {
        Lavoro = ScopedServices.GetRequiredService<IWorkListService>();
        Impacts = ScopedServices.GetRequiredService<IDocumentImpactService>();
        Incarichi = ScopedServices.GetRequiredService<IEditorTaskService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (DocumentId == _loadedFor) return;   // evita ricariche a ogni render
        _loadedFor = DocumentId;
        await RicaricaAsync();
    }

    private async Task RicaricaAsync() =>
        _righe = DocumentId is int id
            ? await Lavoro.PerDocumentoAsync(id)
            : Array.Empty<WorkItem>();

    /// <summary>Chiudere una riga vuol dire due cose diverse secondo la sua natura, e il read-model lo dice:
    /// un fatto del sistema si spunta, un incarico passa a «Fatto».</summary>
    private async Task Chiudi(WorkItem r)
    {
        _busy = true;
        try
        {
            if (r.TaskId is int taskId) await Incarichi.UpdateStatusAsync(taskId, EditorTaskStatus.Done);
            else if (r.ImpactId is int impactId) await Impacts.ClearAsync(impactId);

            await RicaricaAsync();
            await OnResolved.InvokeAsync();
        }
        finally { _busy = false; }
    }

    private async Task Avvia(WorkItem r)
    {
        if (r.TaskId is not int taskId) return;
        _busy = true;
        try
        {
            await Incarichi.UpdateStatusAsync(taskId, EditorTaskStatus.InProgress);
            await RicaricaAsync();
        }
        finally { _busy = false; }
    }
}
