@* Pannello release AIRAC riutilizzabile: timeline + pubblica al ciclo / pubblica ora. Per gli editor profile-based
   (ACC/APP/Aeroporto) e ovunque serva schedulare la pubblicazione di uno snapshot editoriale.
   Parametri opt-in (default = timeline semplice): ShowDiff, AllowCancel, BeforePublishAsync, PreviewUrlFactory. *@
@inject IReleaseService Releases
@inject IServiceProvider Servizi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@* Releases NON isolato: il publish è un'unica operazione logica composta con BeforePublishAsync della pagina
   (es. AeroportoEditorPage.RebuildDocumentAsync), che gira sul context della pagina. Isolare ReleasePanel
   spezzerebbe il publish su due context → hang. Deve condividere il context del circuito con la pagina. *@

@* Involucro di sezione (ancora TOC + titolo + aiuto): sta QUI e non in ogni editor, o torna a divergere —
   l'editor ACC non lo aveva affatto, quello vLOA non aveva l'aiuto (doc 13 §3i). *@
<div class="block" style="margin-top:10px" id="@SectionAnchor" data-tour="release">
    @if (ShowSectionHeader)
    {
        <h3 style="margin-top:0"><Icon Name="calendar" /> @L["Rel_SectionTitle"]</h3>
        <p class="help">@((MarkupString)string.Format(L["Rel_SectionHelp"].Value, _currentCycle))</p>
    }
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <b><Icon Name="calendar" /> @L["Rel_AiracRelease"]</b>
        @* Le tre righe di aiuto erano scritte a mano in italiano: il pannello lo montano TUTTI gli editor,
           quindi in inglese erano italiane in cinque pagine, non in una. *@
        <HelpHint Href="/vsop/guida#editor-release" AriaLabel="@L["Rel_HelpAria"]">
            @((MarkupString)L["Rel_HelpBody"].Value)
        </HelpHint>
        <span class="muted" style="font-size:12px">@(string.Format(L["Rel_HeaderNote"].Value, _currentCycle))</span>
    </div>

    @if (_error is not null) { <div class="callout danger" style="margin:0 0 6px"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div></div> }
    @if (_ok is not null) { <div class="callout success" style="margin:0 0 6px"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@_ok</div></div> }

    @if (_rels.Count == 0)
    {
        <p class="help" style="margin:0 0 6px">@L["Rel_NoRelease"]</p>
    }
    else
    {
        @* ⚠️ La release IN VIGORE e le PROGRAMMATE non si collassano mai: sono lo stato del documento, non
           storia. Le superate oltre le prime tre finiscono in un «altre N» che si apre — di dieci release,
           nove sono superate, e si guardano quando si cerca qualcosa di preciso. *@
        @foreach (var r in InEvidenza)
        {
            @RigaRelease(r)
            @if (ShowDiff && _diffOpen.Contains(r.Id))
            {
                <div class="block" style="margin:2px 0 8px 24px">
                    <ReleaseDiffTable Diff="@(_diffs.TryGetValue(r.Id, out var d) ? d : null)" />
                </div>
            }
        }

        @if (Vecchie.Count > 0)
        {
            <details class="rel-old">
                <summary>@L["Rel_OlderN", Vecchie.Count]</summary>
                @foreach (var r in Vecchie)
                {
                    @RigaRelease(r)
                    @if (ShowDiff && _diffOpen.Contains(r.Id))
                    {
                        <div class="block" style="margin:2px 0 8px 24px">
                            <ReleaseDiffTable Diff="@(_diffs.TryGetValue(r.Id, out var dv) ? dv : null)" />
                        </div>
                    }
                }
            </details>
        }
    }

    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px">
        <select class="app-in" style="min-width:270px;max-width:340px" @bind="_cycle">
            @foreach (var c in _upcoming)
            {
                <option value="@c.Cycle">AIRAC @c.Cycle — @L["Rel_From"] @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
            }
        </select>
        <input class="app-in" style="max-width:240px" placeholder="@L["Rel_NotePh"]" @bind="_note" />
        <button class="btn primary" disabled="@_busy" @onclick="PublishNow" title="@L["Rel_PublishNowTitle"]"><Icon Name="megaphone" /> @L["Rel_PublishNow"]</button>
        <button class="btn ghost" disabled="@_busy" @onclick="PublishAtCycle" title="@L["Rel_ScheduleTitle"]"><Icon Name="calendar" /> @L["Rel_ScheduleAtCycle"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ReleaseTargetType Target { get; set; }
    [Parameter, EditorRequired] public string Key { get; set; } = default!;

    /// <summary>Eseguito PRIMA della pubblicazione (es. rigenerare il documento dell'aeroporto dalla bozza, chiedere
    /// conferma). Se ritorna false, la pubblicazione è annullata. Null = nessun passo preliminare.</summary>
    [Parameter] public Func<Task<bool>>? BeforePublishAsync { get; set; }
    /// <summary>Mostra il pulsante «Differenze» + il blocco diff per ogni release.</summary>
    [Parameter] public bool ShowDiff { get; set; }
    /// <summary>Mostra il pulsante «Annulla» per ogni release (tipicamente solo admin).</summary>
    [Parameter] public bool AllowCancel { get; set; }
    /// <summary>Costruisce l'URL di anteprima release per id (l'host conosce l'ACC). Null = usa il default per-target.</summary>
    [Parameter] public Func<int, string?>? PreviewUrlFactory { get; set; }

    /// <summary>Ancora della sezione «Versioni &amp; release», condivisa dagli editor per la voce di menu.</summary>
    public const string SectionAnchor = "p-release";

    /// <summary>Mostra titolo e testo d'aiuto della sezione. Falso solo dove il pannello è già dentro un
    /// involucro suo (l'editor aeroporto ha il proprio &lt;details&gt;).</summary>
    [Parameter] public bool ShowSectionHeader { get; set; } = true;

    /// <summary>Notificata dopo una pubblicazione riuscita. Serve perché «Pubblica ora» promuove la bozza a versione
    /// pubblicata (<c>PublishWorkingVersionAsync</c>) ma questo pannello ricarica solo le PROPRIE release: senza
    /// l'avviso, l'host continua a mostrare lo stato documento letto all'apertura della pagina — la pill restava
    /// «Bozza vN» a pubblicazione avvenuta.</summary>
    [Parameter] public EventCallback Published { get; set; }

    /// <summary>
    /// Una riga della storia, su UNA riga. Prima ne occupava due — titolo sopra, meta sotto — cioe' 68px
    /// per dieci righe, 680px per una storia che si scorre e non si legge riga per riga. L'ora esatta e la
    /// nota stanno nel `title`: sono la verita' della riga e non si buttano, ma non e' quello che si legge
    /// scorrendo (stessa regola del JSON nel registro di audit).
    /// </summary>
    private RenderFragment RigaRelease(ReleaseInfo r) => __builder =>
    {
        // ⚠️ Il testo del `title` si compone QUI, non dentro l'attributo: un'interpolazione con virgolette
        // escapate dentro un attributo Razor chiude il blocco `@code` in faccia al parser (CS9348, e l'errore
        // punta a venti righe piu' in la').
        var dettaglio = Dettaglio(r);
        <div class="ver-row rel-row @(r.IsEffectiveNow ? "current" : "")" title="@dettaglio">
            <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
            <b class="rel-lbl">@Label(r)</b>
            @* «rilascio #N»: N e' il progressivo della RELEASE per questo bersaglio (SaveReleaseAsync: max+1),
               non la versione del documento. Scritto «rel. vN» si confondeva con la pill «Bozza vN» dell'editor. *@
            <span class="vmeta rel-meta">@L["Rel_VersionLabel", r.VersionNumber] · @Chi(r.CreatedByUserId) · @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")</span>
            <span class="vact">
                @{ var previewUrl = PreviewFor(r.Id); }
                @if (previewUrl is not null)
                {
                    <a class="btn ghost" href="@previewUrl" target="_blank" rel="noopener" title="@L["Rel_PreviewTitle"]"><Icon Name="eye" /> @L["Rel_Preview"]</a>
                }
                @if (ShowDiff)
                {
                    <button class="btn ghost" disabled="@_busy" @onclick="() => ToggleDiff(r.Id)" title="@L["Rel_DiffTitle"]"><Icon Name="search" /> @L["Rel_Diff"]</button>
                }
                @if (AllowCancel)
                {
                    @* ⚠️ `InlineConfirm` e non il `confirm()` nativo: quello BLOCCA il circuito Blazor finche'
                       non si risponde, e il testo utile — QUALE release si sta annullando — finiva in una
                       finestrella di sistema invece che accanto al tasto che l'ha aperta. E' la stessa cura
                       gia' pagata dal giro Versioni il 21 agosto, e qui pesa di piu': annullare una release
                       e' irreversibile e tocca un documento gia' pubblicato. *@
                    <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Rel_CancelTitle"]" AriaLabel="@L["Rel_CancelTitle"]"
                                   Prompt="@L["Rel_CancelPrompt", r.ReleaseAiracCycle]" Disabled="@_busy"
                                   ConfirmLabel="@L["Rel_CancelYes"]" CancelLabel="@L["Common_Close"]"
                                   OnConfirm="() => CancelRelease(r.Id)">
                        <Trigger>✕ @L["Common_Cancel"]</Trigger>
                    </InlineConfirm>
                }
            </span>
        </div>
    };

    /// <summary>Chi ha pubblicato, in chiaro. ⚠️ Un VID non e' un nome (regola 124): il roster e' gia' in casa
    /// e risolve in UNA chiamata per pannello, non una per riga. Se non lo conosce resta il VID — meglio un
    /// numero che un trattino. Terzo posto in cui questa regola si ripaga, dopo Permessi e Incarichi.</summary>
    /// <summary>La verita' della riga per il `title`: rilascio, chi, ora esatta, nota.</summary>
    private string Dettaglio(ReleaseInfo r)
    {
        var nota = string.IsNullOrWhiteSpace(r.Note) ? "" : $" — “{r.Note}”";
        return $"{L["Rel_VersionLabel", r.VersionNumber].Value} · {Chi(r.CreatedByUserId)} · {r.CreatedUtc:dd MMM yyyy HH:mm} UTC{nota}";
    }

    private string Chi(int userId) =>
        _nomi.TryGetValue(userId, out var n) && !string.IsNullOrWhiteSpace(n) ? n : L["Audit_VidN", userId].Value;

    private IReadOnlyDictionary<int, string> _nomi = new Dictionary<int, string>();

    /// <summary>Quelle che contano: la release in vigore, le programmate, e le tre superate piu' recenti.</summary>
    private IReadOnlyList<ReleaseInfo> InEvidenza =>
        _rels.Where(r => r.IsEffectiveNow || r.Status == ReleaseStatus.Scheduled)
             .Concat(_rels.Where(r => !r.IsEffectiveNow && r.Status != ReleaseStatus.Scheduled).Take(3))
             .ToList();

    /// <summary>Le superate oltre le prime tre: storia, e si aprono quando si cerca qualcosa di preciso.</summary>
    private IReadOnlyList<ReleaseInfo> Vecchie =>
        _rels.Where(r => !r.IsEffectiveNow && r.Status != ReleaseStatus.Scheduled).Skip(3).ToList();

    private IReadOnlyList<ReleaseInfo> _rels = Array.Empty<ReleaseInfo>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private string? _cycle;
    private string? _note;
    private bool _busy;
    private string? _error, _ok;
    private readonly HashSet<int> _diffOpen = new();
    private readonly Dictionary<int, ReleaseDiff> _diffs = new();

    // Bersaglio già caricato: OnParametersSetAsync scatta a OGNI re-render del genitore, non solo quando
    // Target/Key cambiano. Ricaricare sempre significava una query DB per re-render, e — condividendo il
    // context del circuito con la pagina (vedi nota in cima) — una collisione: il render intermedio di
    // un'azione della pagina ancora in volo (es. StartEditing → CreateDraftAsync) faceva partire ListAsync
    // sullo stesso context. Su Postgres/Neon, con la latenza di rete, le due si sovrappongono davvero:
    // eccezione nel ciclo di vita del componente → renderer in errore → CIRCUITO TERMINATO (l'editor APP su
    // Render moriva al primo click su «Modifica»). In locale su SQLite le query finiscono prima e non collidono.
    private (ReleaseTargetType Target, string Key)? _loaded;

    protected override async Task OnParametersSetAsync()
    {
        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        _cycle ??= _upcoming.FirstOrDefault()?.Cycle;

        if (_loaded is { } l && l.Target == Target && string.Equals(l.Key, Key, StringComparison.Ordinal)) return;
        _loaded = (Target, Key);
        // Rete di sicurezza: un'eccezione qui NON è catturabile dall'host (è ciclo di vita, non evento) e
        // abbatterebbe il circuito. Meglio il pannello con un errore visibile che la pagina morta.
        try { await Reload(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Reload()
    {
        _rels = await Releases.ListAsync(Target, Key);
        // ⚠️ Una chiamata per PANNELLO, non una per riga: i VID sono pochi e si risolvono in blocco.
        // ⚠️ E il roster si RISOLVE, non si inietta: dare un nome a un VID e' una comodita', non una
        // dipendenza del pannello. Iniettarlo come obbligatorio rende il componente non montabile per
        // chiunque non l'abbia registrato — e questo pannello lo montano quattro editor piu' i test.
        // Senza roster restano i VID, che e' gia' il ripiego dichiarato in `Chi`.
        var roster = Servizi.GetService(typeof(Vipi.Application.Abstractions.IStaffRosterRepository))
            as Vipi.Application.Abstractions.IStaffRosterRepository;
        var vid = _rels.Select(r => r.CreatedByUserId).Where(v => v > 0).Distinct().ToList();
        _nomi = roster is null || vid.Count == 0
            ? new Dictionary<int, string>()
            : await roster.GetDisplayNamesAsync(vid);
        _diffOpen.Clear(); _diffs.Clear();
    }

    private Task PublishAtCycle() => Run(async () =>
    {
        if (BeforePublishAsync is not null && !await BeforePublishAsync()) return false;
        await Releases.PublishAsync(Target, Key, _cycle ?? _currentCycle, _note);
        return true;
    }, string.Format(L["Rel_PublishedAtCycle"].Value, _cycle ?? _currentCycle), notify: true);

    private Task PublishNow() => Run(async () =>
    {
        if (BeforePublishAsync is not null && !await BeforePublishAsync()) return false;
        await Releases.PublishNowAsync(Target, Key, _note);
        return true;
    }, L["Rel_PublishedNow"], notify: true);

    // La domanda la fa `InlineConfirm` accanto al tasto (vedi RigaRelease): qui resta il solo atto.
    private Task CancelRelease(int releaseId) => Run(async () =>
    {
        await Releases.CancelReleaseAsync(releaseId);
        return true;
    }, L["Rel_Canceled"]);

    private async Task ToggleDiff(int releaseId)
    {
        if (_diffOpen.Remove(releaseId)) return;
        _diffOpen.Add(releaseId);
        if (!_diffs.ContainsKey(releaseId))
        {
            try { _diffs[releaseId] = await Releases.DiffAsync(releaseId); }
            catch (EditNotAllowedException ex) { _error = ex.Message; }
        }
    }

    // Esegue l'azione (che ritorna true=proceduta → mostra ok; false=annullata → nessun messaggio) con guardia busy/errori.
    // notify: avvisa l'host (Published) dopo aver ricaricato le release — solo per le azioni che pubblicano.
    private async Task Run(Func<Task<bool>> action, string ok, bool notify = false)
    {
        _busy = true; _error = _ok = null;
        try
        {
            if (await action())
            {
                await Reload();
                _ok = ok;
                if (notify) await Published.InvokeAsync();
            }
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string Label(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 " + L["Rel_Effective"]
        : r.Status == ReleaseStatus.Scheduled ? "🕒 " + L["Rel_Scheduled"] : L["Rel_Superseded"];

    // URL anteprima: factory dell'host se presente, altrimenti default per-target.
    private string? PreviewFor(int releaseId) => PreviewUrlFactory is not null
        ? PreviewUrlFactory(releaseId)
        : Target switch
        {
            ReleaseTargetType.AccVipi => $"/vsop/{Key.Split('|')[0].ToLowerInvariant()}/vipi?as=rel:{releaseId}",
            _ => null,
        };
}
