@* Pannello release AIRAC riutilizzabile: timeline + pubblica al ciclo / pubblica ora. Per gli editor profile-based
   (ACC/APP) e ovunque serva schedulare la pubblicazione di uno snapshot editoriale. *@
@inject IReleaseService Releases

<div class="block" style="margin-top:10px">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
        <b>📅 Release AIRAC</b>
        <span class="muted" style="font-size:12px">il pubblico vede la release in vigore al ciclo corrente (@_currentCycle); l'editor lavora sempre sulla bozza live</span>
    </div>

    @if (_error is not null) { <div class="callout danger" style="margin:0 0 6px"><span class="cic">⛔</span><div>@_error</div></div> }
    @if (_ok is not null) { <div class="callout success" style="margin:0 0 6px"><span class="cic">✓</span><div>@_ok</div></div> }

    @if (_rels.Count == 0)
    {
        <p class="help" style="margin:0 0 6px">Nessuna release: il pubblico vede lo stato pubblicato/live corrente (fallback).</p>
    }
    else
    {
        @foreach (var r in _rels)
        {
            <div class="ver-row @(r.IsEffectiveNow ? "current" : "")">
                <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
                <div style="flex:1">
                    <b>@Label(r)</b>
                    <div class="vmeta">rel. v@r.VersionNumber · VID @r.CreatedByUserId · @r.CreatedUtc.ToString("dd MMM yyyy HH:mm") · in vigore dal @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.Note) ? "" : $" — \"{r.Note}\"")</div>
                </div>
                @{ var previewUrl = PreviewUrl(r.Id); }
                @if (previewUrl is not null)
                {
                    <a class="btn ghost" href="@previewUrl" target="_blank" rel="noopener" title="Anteprima del documento come sarà a questo ciclo">👁 Anteprima</a>
                }
            </div>
        }
    }

    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px">
        <select class="app-in" style="min-width:270px;max-width:340px" @bind="_cycle">
            @foreach (var c in _upcoming)
            {
                <option value="@c.Cycle">AIRAC @c.Cycle — dal @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
            }
        </select>
        <input class="app-in" style="max-width:240px" placeholder="Nota (facoltativa)…" @bind="_note" />
        <button class="btn primary" disabled="@_busy" @onclick="PublishAtCycle">Pubblica al ciclo</button>
        <button class="btn ghost" disabled="@_busy" @onclick="PublishNow" title="Entra in vigore subito (review sul ciclo corrente)">Pubblica ora (review)</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ReleaseTargetType Target { get; set; }
    [Parameter, EditorRequired] public string Key { get; set; } = default!;

    private IReadOnlyList<ReleaseInfo> _rels = Array.Empty<ReleaseInfo>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private string? _cycle;
    private string? _note;
    private bool _busy;
    private string? _error, _ok;

    protected override async Task OnParametersSetAsync()
    {
        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        _cycle ??= _upcoming.FirstOrDefault()?.Cycle;
        await Reload();
    }

    private async Task Reload() => _rels = await Releases.ListAsync(Target, Key);

    private Task PublishAtCycle() => Run(() => Releases.PublishAsync(Target, Key, _cycle ?? _currentCycle, _note),
        $"Release pubblicata al ciclo AIRAC {_cycle ?? _currentCycle}.");

    private Task PublishNow() => Run(() => Releases.PublishNowAsync(Target, Key, _note), "Release pubblicata subito (review).");

    private async Task Run(Func<Task> action, string ok)
    {
        _busy = true; _error = _ok = null;
        try { await action(); await Reload(); _ok = ok; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string Label(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 In vigore"
        : r.Status == ReleaseStatus.Scheduled ? "🕒 Schedulata" : "Superata";

    // URL del viewer tipizzato in modalità anteprima release. Key: ACC = "{acc}|{root}"; Airport = ICAO; App = callsign.
    private string? PreviewUrl(int releaseId) => Target switch
    {
        ReleaseTargetType.AccVipi => $"/vsop/{Key.Split('|')[0].ToLowerInvariant()}/vipi?as=rel:{releaseId}",
        _ => null,
    };
}
