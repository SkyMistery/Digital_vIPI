@inherits ComponenteDelDocumento

<div class="callout @Kind">
    <span class="cic"><Icon Name="@IconName" Size="18" /></span>
    <div>
        <p class="ct">@Title</p>
        @MarkdownLite.Render(Block.Body)
        @* Gli allegati del callout (S121), sotto il testo: lo stesso componente del blocco «Allegato», così link,
           riquadro incorporato e rotazione si vedono uguali nei due posti. *@
        @foreach (var a in CalloutJson.Allegati(Block.BodyJson))
        {
            <AttachmentLink Reference="a" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BlockView Block { get; set; } = default!;

    private CalloutKind K => Block.CalloutKind ?? CalloutKind.Info;
    private string Kind => K.ToString().ToLowerInvariant();

    private string IconName => K switch
    {
        CalloutKind.Success => "check-circle",
        CalloutKind.Warning => "warning",
        CalloutKind.Danger => "octagon-alert",   // «Importante»: il punto esclamativo, non la X dello stop
        _ => "info",
    };

    private string Title
    {
        get
        {
            // Titolo esplicito da BodyJson, altrimenti predefinito per tipo.
            if (CalloutJson.Titolo(Block.BodyJson) is { } s) return s;
            // ⚠️ DAI RESX, non letterali: questa etichetta sta DENTRO il documento, e cablata in italiano
            // restava italiana anche in una pagina inglese — «Nota» in mezzo a cinque callout tradotti.
            // Si vedeva già prima della lingua bloccata, su qualunque lettura in inglese; col blocco si vede
            // di più, perché lì intorno non c'è più una parola d'italiano.
            return K switch
            {
                CalloutKind.Success => L["Callout_Ok"].Value,
                CalloutKind.Warning => L["Callout_Warning"].Value,
                CalloutKind.Danger => L["Callout_Danger"].Value,
                _ => L["Callout_Note"].Value,
            };
        }
    }
}
