@using System.Globalization
@using System.Text.Json
@inject IStringLocalizer<SharedResource> L

<div class="aor-block">
    @* Link "Vista 3D" rimosso: la pagina AoR 3D è disabilitata (rebuild /services/vsop, Round 12). *@
    <div class="aor-toggles">
        @foreach (var s in _sectors)
        {
            <button type="button" class="aor-chip on" data-sec="@s.Key" aria-pressed="true">
                <span class="sw" style="background:@(s.Color)33;border-color:@s.Color"></span> @s.Label
            </button>
        }
        <span class="aor-chip-actions"><button type="button" class="aor-all" data-act="all">@L["AorBlock_All"]</button> · <button type="button" class="aor-all" data-act="none">@L["AorBlock_None"]</button></span>
    </div>

    <div class="aor-wrap">
        <svg viewBox="0 0 460 300" width="100%" style="background:var(--surface-soft);border:1px solid var(--line);border-radius:11px">
            @((MarkupString)BuildSvg())
        </svg>
        <div class="aor-legend">
            <div class="lg" style="font-size:12px;color:var(--ink-soft)">@L["AorBlock_OverlapLegend"]</div>
        </div>
    </div>

    @if (_configs.Count > 0)
    {
        <div class="cfg-sel">
            <span class="cfg-sel-lab">@L["AorBlock_ConfigLabel"]</span>
            @foreach (var c in _configs)
            {
                <button type="button" class="cfg-btn" data-rows="@c.Rows" data-secs="@c.Secs" aria-pressed="false">@c.Name</button>
            }
            <button type="button" class="cfg-clear">@L["AorBlock_ConfigClear"]</button>
        </div>
        <p class="help noprint" style="margin:8px 0 0">@L["AorBlock_ConfigHelp"]</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public BlockView Block { get; set; } = default!;

    private record Sec(string Key, string Label, string Color, double Fill, string Points, string Text, int Tx, int Ty, string TColor);
    private record Cfg(string Name, string Rows, string Secs);

    private List<Sec> _sectors = new();
    private List<Cfg> _configs = new();

    protected override void OnParametersSet()
    {
        _sectors = new(); _configs = new();

        if (string.IsNullOrWhiteSpace(Block.BodyJson)) return;
        try
        {
            using var doc = JsonDocument.Parse(Block.BodyJson);
            var root = doc.RootElement;
            if (root.TryGetProperty("sectors", out var secs))
                foreach (var s in secs.EnumerateArray())
                    _sectors.Add(new Sec(
                        Str(s, "key"), Str(s, "label"), Str(s, "color"),
                        s.TryGetProperty("fill", out var f) ? f.GetDouble() : 0.2,
                        Str(s, "points"), Str(s, "text"),
                        s.TryGetProperty("tx", out var tx) ? tx.GetInt32() : 0,
                        s.TryGetProperty("ty", out var ty) ? ty.GetInt32() : 0,
                        Str(s, "tcolor")));
            if (root.TryGetProperty("configs", out var cfgs))
                foreach (var c in cfgs.EnumerateArray())
                    _configs.Add(new Cfg(Str(c, "name"), Str(c, "rows"), Str(c, "secs")));
        }
        catch (JsonException) { }
    }

    private static string Str(JsonElement e, string name) =>
        e.TryGetProperty(name, out var v) ? v.GetString() ?? "" : "";

    // <text> è una keyword Razor → l'SVG interno si genera come markup.
    // I valori provengono da BodyJson editabile: vanno HTML-encoded per evitare iniezione (XSS) di markup/script.
    //
    // ⚠️ SÌ, QUESTO DISEGNO È UNA COPIA DEI POLIGONI CHE VIAGGIANO ANCHE NEI `data-`, E NO, TOGLIERLO NON
    // CONVIENE. Scritto qui perché è una conclusione che costa mezz'ora di misure e che, a guardare i byte
    // grezzi, sembra ovvia al contrario.
    //
    // Contato il 27 agosto 2026 sulla vIPI ACC di LIBB, la pagina più pesante del sito (294 122 byte di
    // HTML). A occhio nudo la duplicazione è enorme: 47 KB di SVG più 62 KB di JSON negli attributi, di cui
    // 13,6 KB di soli «&quot;». Ma quello che arriva al browser è compresso, e compresso il conto cambia
    // di segno:
    //
    //     com'è oggi                                    grezzo 294 122   br 32 445
    //     coordinate arrotondate a 5 decimali           grezzo 288 161   br 34 426   PEGGIO
    //     JSON fuori dagli attributi (niente &quot;)    grezzo 274 571   br 34 035   PEGGIO
    //
    // Le ripetizioni — le virgolette escapate, le lunghe cifre decimali, gli stessi numeri che compaiono
    // sia qui sia nel JSON — sono esattamente ciò che un compressore mangia meglio. Toglierle ROMPE le
    // ripetizioni e fa uscire più byte di prima. La copia dei poligoni, misurata da sola, costa 770 byte
    // compressi: praticamente niente, perché il compressore la riconosce.
    //
    // Quel che questo disegno costa davvero è 9 230 byte compressi, e sono il prezzo di quello che fa:
    // mostrare l'area PRIMA che Leaflet arrivi — e da quando Leaflet si carica su richiesta (vipi-boot.js)
    // quella finestra è più lunga, non più corta. Toglierlo vuol dire un riquadro vuoto al suo posto.
    //
    // Se un domani lo si volesse comunque togliere, la strada NON è spedire meno dati: è far disegnare
    // questo stesso ripiego al JavaScript, dal JSON che già c'è. Costa codice nuovo e una verifica a
    // schermo, e vale 9 KB su una pagina che ne pesa 32.
    private string BuildSvg()
    {
        var sb = new System.Text.StringBuilder();
        string E(string v) => System.Net.WebUtility.HtmlEncode(v);
        foreach (var s in _sectors)
            sb.Append($"<polygon class=\"sec sec-{E(s.Key)}\" data-sec=\"{E(s.Key)}\" points=\"{E(s.Points)}\" fill=\"{E(s.Color)}\" fill-opacity=\"{s.Fill.ToString(CultureInfo.InvariantCulture)}\" stroke=\"{E(s.Color)}\" stroke-width=\"2\" />");
        foreach (var s in _sectors)
            sb.Append($"<text class=\"lbl lbl-{E(s.Key)}\" data-sec=\"{E(s.Key)}\" x=\"{s.Tx}\" y=\"{s.Ty}\" font-family=\"Nunito Sans\" font-size=\"15\" fill=\"{E(s.TColor)}\" font-weight=\"700\">{E(s.Text)}</text>");
        return sb.ToString();
    }
}
