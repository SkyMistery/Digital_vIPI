@* Editor di UN blocco immagine, condiviso dai due editor di blocchi (DocumentSectionsEditor sul documento,
   DocumentBlocksEditor sulle sezioni extra dell'aeroporto): il codice nuovo di questa feature vive qui una volta sola.
   L'host possiede la persistenza — riceve il JSON del riferimento e la didascalia via callback e li salva come sa.

   Caricamento: click sull'area (scelta dal dispositivo) o trascinamento del file sopra di essa. Entrambi li serve lo
   stesso <InputFile>, reso trasparente sopra l'area: il drop su un file input è comportamento nativo del browser,
   quindi non c'è codice di drag&drop da mantenere — gli handler qui sotto servono SOLO all'evidenziazione. *@
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Application.Media
@inherits OwningComponentBase
@inject IJSRuntime JS
@inject IOptions<MediaOptions> MediaOptions
@inject IStringLocalizer<SharedResource> L
@* IMediaStore risolto dallo scope PROPRIO (OwningComponentBase): il salvataggio non deve passare per il DbContext
   condiviso del circuito, o due operazioni concorrenti lo fanno esplodere. Vedi memoria blazor-dbcontext-concurrency. *@

<div class="img-edit">
    <label class="img-drop @(_dragging ? "over" : null)"
           @ondragenter="() => _dragging = true" @ondragleave="() => _dragging = false" @ondrop="() => _dragging = false">
        <InputFile @ref="_input" OnChange="OnFileAsync" accept="@ImageProbe.AcceptAttribute" class="img-drop-input"
                   disabled="@_busy" aria-label="@L["Img_ChooseAria"]" />
        <ImageFigure Media="Media" Caption="@Caption" EmptyLabel="@L["Img_DropHere"]" />
        <span class="img-drop-hint">
            @(Media is null ? L["Img_DropHere"] : L["Img_Replace"]) · @L["Img_MaxSize", MediaOptions.Value.MaxUploadLabel]
        </span>
    </label>

    @if (_busy)
    {
        <p class="muted" style="margin:6px 0 0">@L["Img_Uploading"]</p>
    }
    @if (_error is not null)
    {
        <div class="callout danger" style="margin-top:8px">
            <span class="cic"><Icon Name="octagon" Size="18" /></span>
            <div>@_error</div>
        </div>
    }

    @if (Media is not null)
    {
        <div class="img-fields">
            <label class="img-field">
                <span class="muted">@L["Img_AltLabel"]</span>
                <input class="app-in" value="@_alt" placeholder="@L["Img_AltPh"]"
                       @onchange="e => SetAltAsync(e.Value as string ?? string.Empty)" />
            </label>
            <label class="img-field">
                <span class="muted">@L["Img_CaptionLabel"]</span>
                <input class="app-in" value="@_caption" placeholder="@L["Img_CaptionPh"]"
                       @onchange="e => SetCaptionAsync(e.Value as string ?? string.Empty)" />
            </label>
            <button class="btn ghost" type="button" @onclick="RemoveAsync">@L["Img_Remove"]</button>
        </div>
    }
</div>

@code {
    /// <summary>JSON del riferimento (<see cref="MediaRef"/>): sta in <c>BodyJson</c> nel documento e in
    /// <c>ExtraBlock.ImageJson</c> negli extra dell'aeroporto — stessa stringa.</summary>
    [Parameter] public string? ImageJson { get; set; }
    [Parameter] public EventCallback<string?> ImageJsonChanged { get; set; }

    /// <summary>Didascalia (markdown leggero, come la prosa).</summary>
    [Parameter] public string? Caption { get; set; }
    [Parameter] public EventCallback<string?> CaptionChanged { get; set; }

    private InputFile? _input;
    private bool _busy;
    private bool _dragging;
    private string? _error;

    private IMediaStore _store = default!;
    protected override void OnInitialized() => _store = ScopedServices.GetRequiredService<IMediaStore>();

    // Aggancia al file input il rimpicciolimento nel browser: intercetta il file scelto e, se serve, lo sostituisce
    // con una copia più leggera PRIMA che Blazor lo legga (il perché sta in cima a vipi-media.js). Da qui in poi il
    // codice C# non sa nulla di tutto ciò: riceve un file e basta. Idempotente lato JS, si può chiamare a ogni render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_input?.Element is not { } element) return;
        var o = MediaOptions.Value;
        try { await JS.InvokeVoidAsync("vipiMedia.osserva", element, o.ClientDownscaleLongestSidePx, o.JpegQuality, o.MaxUploadBytes); }
        catch (JSDisconnectedException) { /* circuito chiuso */ }
        catch (JSException) { /* script non caricato: si carica il file originale, e il limite lo fa il server */ }
    }

    private MediaRef? Media => MediaRef.Parse(ImageJson);

    // Testo dei due campi tenuto QUI mentre l'immagine resta la stessa.
    // Perché non legarli direttamente ai parametri: salvare un campo fa ricaricare il documento all'host, e il
    // render che ne segue riscriverebbe nel campo il valore com'era PRIMA — sovrascrivendo quel che si sta
    // digitando nell'altro campo. Visto dal vivo il 2026-07-31: la didascalia usciva duplicata a metà parola.
    // Nessuno scrive alt e didascalia di questo blocco all'infuori di questo componente, quindi ri-seminare i
    // campi solo al cambio di immagine è sufficiente e toglie di mezzo la corsa.
    private string? _alt, _caption, _seededFor;

    protected override void OnParametersSet()
    {
        var id = Media?.MediaId;
        if (id == _seededFor) return;
        _seededFor = id;
        _alt = Media?.Alt;
        _caption = Caption;
    }

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _busy = true;
        _error = null;
        try
        {
            var max = MediaOptions.Value.MaxUploadBytes;
            // Un byte oltre il limite: basta a far scattare il rifiuto senza tirarsi in casa il resto del file.
            await using var stream = file.OpenReadStream(max + 1);
            var saved = await _store.SaveAsync(stream, file.Name);

            // L'alt scritto per l'immagine precedente non si eredita: descriveva un'altra foto.
            await ImageJsonChanged.InvokeAsync(MediaRef.Serialize(
                new MediaRef(saved.Sha256, null, saved.Width, saved.Height)));
        }
        catch (ValidationException ex)
        {
            _error = ex.Message;                       // limite superato, formato non ammesso, misure fuori scala
        }
        catch (IOException)
        {
            // Il limite scatta sul trasporto: lo stream si interrompe prima che il deposito veda i byte. Il testo
            // arriva dallo stesso posto del rifiuto lato server, o l'utente leggerebbe due frasi diverse per lo
            // stesso motivo (verifica live 2026-07-31: una in italiano e una in inglese).
            _error = MediaValidator.TooBigMessage(MediaOptions.Value);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SetAltAsync(string alt)
    {
        if (Media is null) return Task.CompletedTask;
        var trimmed = alt.Trim();
        _alt = trimmed.Length == 0 ? null : trimmed;
        return ImageJsonChanged.InvokeAsync(MediaRef.Serialize(Media with { Alt = _alt }));
    }

    private Task SetCaptionAsync(string caption)
    {
        _caption = caption;
        return CaptionChanged.InvokeAsync(caption);
    }

    // Stringa vuota, non null: l'host distingue "non toccare" (null) da "togli l'immagine" (vuoto). I byte restano
    // nel deposito — una release già pubblicata continua a citarne lo sha.
    private Task RemoveAsync() => ImageJsonChanged.InvokeAsync("");
}
