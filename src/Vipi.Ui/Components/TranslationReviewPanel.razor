@inherits OwningComponentBase
@inject Vipi.Application.Translation.IDocumentTranslationReview Revisione
@inject IStringLocalizer<SharedResource> L
@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Application.Translation
@using Vipi.Domain.Entities

@*  ⚠️ DUE ISTANZE DELLO STESSO SERVIZIO, E LA DIFFERENZA CONTA (31 agosto 2026).

    `_lettura` viene dallo scope DI PROPRIO del componente (OwningComponentBase.ScopedServices), quindi
    lavora su un `VipiDbContext` isolato: la si usa per TUTTO ciò che parte dal ciclo di vita, cioè mentre
    l'editor genitore ha ancora le sue query in volo. Senza, succede questo — ed è successo, due volte in
    dieci secondi, codici 00-bea549b1… e 00-a0ff0695… su /services/vsop/libb/editor:

        A second operation was started on this context instance
           at EfEditingRepository.LoadForEditAsync ← DocumentTranslationReview.RigheAsync
           ← TranslationReviewPanel.OnParametersSetAsync

    Blazor disegna l'albero mentre `OnInitializedAsync` della pagina è ancora in volo: il pannello si monta
    lì dentro, e la sua lettura cade sullo stesso contesto di quella dell'editor.

    `Revisione` resta invece `@@inject`, cioè sul contesto del circuito, e serve alla SCRITTURA
    (`CorreggiAsync`). ⚠️ Non è una svista ed è la parte da non «uniformare»: `CorreggiAsync` passa da
    `IEditAuthorizationService`, che risolve l'identità da `IHttpContextAccessor`. In uno scope creato
    dopo la richiesta quell'HttpContext non c'è più: il servizio risponderebbe «anonimo» e il salvataggio
    verrebbe rifiutato a tutti. È la stessa regola già scritta per gli altri sei componenti isolati —
    i servizi che leggono i claim restano quelli del circuito. E la scrittura non ha comunque la corsa da
    evitare: parte da un clic, non dal render. *@

@* ---- Il correttore delle traduzioni, dentro l'editor (carta bilingue §5) -----------------------------

   ⚠️ PERCHE' QUI E NON SOLO NEL REGISTRO. Il Registro (`/services/vsop/admin/glossary`, dove il vecchio indirizzo porta) elenca le frasi
   di TUTTA la divisione in ordine di quanto sono state riviste: e' il posto giusto per chi fa un giro di
   revisione, ed e' quello sbagliato per chi ha appena scritto un documento e vuole vedere come viene letto
   QUEL documento. Chi scrive conosce la fraseologia del suo scalo, ed e' l'unico che puo' dire se «riporta
   sottovento» e' diventato «report downwind» o «bring it back downwind».

   ⚠️ SI CORREGGE COME SI DICE, MAI COSA SI DICE. Il testo sorgente e' la chiave della memoria e qui non e'
   modificabile: cambiare cio' che il documento afferma e' un'edit del documento, e passa dall'editor e
   dalla release come ogni altra modifica.

   ⚠️ E LA CORREZIONE TOCCA LA FRASE, NON IL DOCUMENTO: la memoria e' indicizzata sull'impronta, quindi vale
   per ogni documento che contiene quella frase. Il conto si mostra PRIMA di salvare, non dopo. *@

<CollapsibleBlock Id="tr-review" InitiallyOpen="false">
    <Header>
        <h3>
            @L["TrEd_Title"]
            @if (_righe is { Count: > 0 })
            {
                <span>&nbsp;</span>
                <span class="pill @(DaRileggere > 0 ? "amber" : "blue")">@DaRileggere / @_righe.Count</span>
            }
        </h3>
    </Header>
    <ChildContent>
        @if (_bloccata)
        {
            <p class="help">@L["TrEd_Locked"]</p>
        }
        else if (_stessaLingua)
        {
            <p class="help">@L["TrEd_SameLanguage"]</p>
        }
        else if (_righe is null)
        {
            <p class="help">…</p>
        }
        else if (_righe.Count == 0)
        {
            <p class="help">@L["TrEd_Empty"]</p>
        }
        else
        {
            <p class="help">@L["TrEd_Intro", _lettore.ToUpperInvariant()]</p>

            @foreach (var r in _righe)
            {
                <div class="tr-row">
                    <div class="tr-src">
                        <span class="muted tr-where">@L["TrEd_Where"] @r.Dove</span>
                        <div>@r.Sorgente</div>
                    </div>
                    <div class="tr-dst">
                        @if (_aperta == r.Sorgente)
                        {
                            <textarea class="tr-edit" rows="3" @bind="_bozza" @bind:event="oninput"></textarea>
                            @if (_toccati > 1)
                            {
                                <p class="help">@L["Tr_TouchesDocs", _toccati]</p>
                            }
                            <div class="tr-cmds">
                                <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_bozza))"
                                        @onclick="() => SalvaAsync(r)">
                                    <Icon Name="check-circle" Size="14" /> @L["Common_Save"]
                                </button>
                                <button class="btn ghost" disabled="@_busy" @onclick="Chiudi">@L["Common_Cancel"]</button>
                            </div>
                        }
                        else
                        {
                            <button class="btn ghost tr-open" disabled="@_busy" @onclick="() => ApriAsync(r)">
                                @if (string.IsNullOrWhiteSpace(r.Tradotto))
                                {
                                    <span class="muted">@L["TrEd_Missing"]</span>
                                }
                                else
                                {
                                    @r.Tradotto
                                }
                            </button>
                            @if (r.Origine == TranslationOrigin.Human)
                            {
                                <span class="pill blue">@L["Tr_OriginHuman"]</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(r.Tradotto))
                            {
                                <span class="pill amber">@L["TrEd_ToReview"]</span>
                            }
                        }
                    </div>
                </div>
            }

            @if (_esito is { Length: > 0 })
            {
                <p class="help">@_esito</p>
            }
        }
    </ChildContent>
</CollapsibleBlock>

@code {
    /// <summary>Il documento che si sta scrivendo. Senza, il pannello non ha niente da mostrare.</summary>
    [Parameter, EditorRequired] public int DocumentId { get; set; }

    private IReadOnlyList<RigaDaRivedere>? _righe;
    private string _lettore = "it";
    private bool _stessaLingua;
    private bool _busy;
    private string? _aperta;
    private string _bozza = "";
    private int _toccati;
    private string? _esito;

    private int DaRileggere => _righe?.Count(r => r.Origine != TranslationOrigin.Human) ?? 0;

    /// <summary>Il servizio della LETTURA, su un contesto tutto suo. Vedi il riquadro in cima al file.</summary>
    private IDocumentTranslationReview _lettura = default!;

    /// <summary>Il documento si legge in una lingua sola: niente da rivedere, e va detto con parole sue.</summary>
    private bool _bloccata;

    /// <summary>Con quali (documento, lingua) sono state caricate le righe che si stanno mostrando.</summary>
    private (int Doc, string Lingua)? _caricatoPer;

    protected override void OnInitialized()
        => _lettura = ScopedServices.GetRequiredService<IDocumentTranslationReview>();

    protected override async Task OnParametersSetAsync()
    {
        // ⚠️ La lingua è quella della barra, la stessa di tutto il resto: il pannello non ha un selettore
        // suo. Due comandi per la stessa cosa sono il difetto che la Guida ha già pagato.
        _lettore = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

        // ⚠️ LA LETTURA È CONDIZIONATA AL CAMBIO, e non è un'ottimizzazione: è la regola pagata il
        // 1 agosto 2026 con ReleasePanel, riscritta qui parola per parola perché questo file l'aveva persa.
        // `OnParametersSetAsync` NON scatta solo al montaggio: scatta a OGNI ridisegno del genitore, e
        // l'editor si ridisegna al primo `await` di qualunque suo gestore — cioè ogni volta che si salva,
        // si aggiunge una sezione, si apre un blocco. Senza questa riga, ogni gesto dell'editor ricaricava
        // il documento INTERO per un pannello che è chiuso di suo e che nessuno stava guardando.
        // Non è l'`@if` sui dati caricati a proteggere: il pericolo è il RI-render, non il primo montaggio.
        if (_caricatoPer == (DocumentId, _lettore)) return;

        _caricatoPer = (DocumentId, _lettore);
        _righe = null;
        _aperta = null;
        _esito = null;

        var revisione = await _lettura.RevisioneAsync(DocumentId, _lettore);
        // Vuoto vuol dire due cose diverse — «stessa lingua» e «niente da tradurre» — e vanno dette in due
        // modi diversi, o chi guarda pensa che il pannello sia rotto. La risposta arriva dalla STESSA
        // lettura: prima si ricaricava il documento con l'altra lingua solo per dedurla.
        _stessaLingua = revisione.StessaLingua(_lettore);
        _bloccata = revisione.Bloccata;
        _righe = revisione.Righe;
    }

    private async Task ApriAsync(RigaDaRivedere r)
    {
        _aperta = r.Sorgente;
        _bozza = r.Tradotto;
        _esito = null;
        _toccati = await _lettura.DocumentiToccatiAsync(r.Sorgente);
    }

    private void Chiudi()
    {
        _aperta = null;
        _bozza = "";
    }

    private async Task SalvaAsync(RigaDaRivedere r)
    {
        _busy = true;
        try
        {
            await Revisione.CorreggiAsync(DocumentId, _lettore, r.Sorgente, _bozza);
            // ⚠️ Il conto adesso e' vero (vedi DocumentiToccatiAsync), quindi la frase deve dire la
            // verita' anche a uno e a zero: «vale per 1 documenti» era il segno che il numero non lo
            // guardava nessuno.
            _esito = _toccati switch
            {
                0 => L["Tr_SavedNone"],
                1 => L["Tr_SavedOne"],
                _ => L["Tr_Saved", _toccati],
            };
            Chiudi();
            // La rilettura passa dal contesto isolato: la scrittura qui sopra è appena finita su quello del
            // circuito, e riprendere da lì significherebbe rimetterci sopra una query mentre il genitore si
            // ridisegna per il `StateHasChanged` di questo stesso gestore.
            _righe = (await _lettura.RevisioneAsync(DocumentId, _lettore)).Righe;
        }
        catch (Vipi.Application.Aor.ValidationException ex)
        {
            _esito = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
