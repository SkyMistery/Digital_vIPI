@inject IStringLocalizer<SharedResource> L
@* La catena di ripiego di un nodo, per intero e in ordine di lettura.

   ⚠️ Le voci sono raggruppate per PASSO, e le voci di uno stesso passo stanno alla stessa altezza: sono i
   settori che, a quel punto della catena, **si dividono il traffico per fascia di quota**. Un elenco piatto
   direbbe che si provano una dopo l'altra, che è falso — «sopra FL325 ES5, altrimenti WS2» non è una
   sequenza di tentativi, è una divisione.

   Markup dichiarativo: Blazor encoda i valori dinamici (no MarkupString, no XSS). I passi li calcola la
   pagina, dalla STESSA camminata che risolve la ricaduta (`FallbackChain.Sequence`). *@

<div class="fb-seq">
    <div class="fb-seq-me">
        @if (SelfOnline) { <span class="onl-dot" title="@L["Struct_OnlineNow"]"></span> }
        <b>@SelfCallsign</b>
        <span class="node-badge @SelfBadgeClass">@SelfBadge</span>
        <span class="fb-seq-tag">@L["Struct_Fallback_Seq_Self"]</span>
    </div>

    @if (Steps.Count == 0)
    {
        <div class="fb-seq-end">@L["Struct_Fallback_Seq_None"]</div>
    }
    else
    {
        @for (var i = 0; i < Steps.Count; i++)
        {
            var passo = Steps[i];
            <div class="fb-seq-step">
                <span class="fb-seq-n">@(i + 1)</span>
                <div class="fb-seq-alts">
                    @foreach (var r in passo)
                    {
                        <div class="fb-seq-alt @(r.Online ? "live" : null)">
                            <span class="fb-band @(r.Banda is null ? "any" : null)">@(r.Banda ?? L["Struct_Fallback_Seq_AnyLevel"].Value)</span>
                            <span class="fb-arrow">→</span>
                            @if (r.Online) { <span class="onl-dot" title="@L["Struct_OnlineNow"]"></span> }
                            <b>@r.Callsign</b>
                            <span class="node-badge @r.BadgeClass">@r.Badge</span>
                            <span class="acc-tag">@r.AccCode</span>
                            @if (r.DalPadre) { <span class="fb-seq-tag">@L["Struct_Fallback_Seq_FromParent"]</span> }
                        </div>
                    }
                </div>
            </div>
        }
    }

    <div class="fb-seq-end">@L["Struct_Fallback_Seq_Unicom"]</div>
</div>

@code {
    /// <summary>Il nodo di cui si sta guardando la catena.</summary>
    [Parameter, EditorRequired] public string SelfCallsign { get; set; } = "";
    [Parameter] public string SelfBadge { get; set; } = "";
    [Parameter] public string SelfBadgeClass { get; set; } = "";
    [Parameter] public bool SelfOnline { get; set; }

    /// <summary>Un elenco per passo; le voci di uno stesso passo si dividono il traffico per fascia.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<IReadOnlyList<FallbackChainRow>> Steps { get; set; } = Array.Empty<IReadOnlyList<FallbackChainRow>>();
}
