@* Editor documentale della vLOA (coppia Home↔Neighbour). Primo editor costruito su IEditingService:
   bozza + lock esclusivo, sezioni (albero) e blocchi (prosa/callout/tabella), pubblicazione. Lato Home editabile.
   Ospitato da VloaEditorPage (route /vsop/{acc}/vloa/editor?acc=<vicino>). *@
@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject NavigationManager Nav
@inject ILogger<VloaEditor> Logger
@inject IStringLocalizer<SharedResource> L
@* Editing e Vloa risolti dallo scope DI proprio (VipiDbContext isolato dal circuito): evita il crash
   "second operation" sotto latenza Postgres. Vedi [[EditLockBar]]. *@

@if (_notFound)
{
    <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">@L["Vle_NotExist"]</p>
        @((MarkupString)string.Format(L["Vle_NotExistBody"].Value, Home, Foreign))</div></div>
}
else if (_denied)
{
    <div class="callout danger"><span class="cic">🔒</span><div><p class="ct">@L["Vle_Unauthorized"]</p>
        @(string.Format(L["Vle_UnauthorizedBody"].Value, Home))</div></div>
}
else if (_doc is null)
{
    <p class="help">@L["Vle_LoadingEditor"]</p>
}
else
{
    <div class="editor-bar">
        <div class="doc-head" style="margin:0">
            <div>
                <h2 style="margin-bottom:2px">✎ @L["Vle_EditorTitle"] — @Home ↔ @Foreign</h2>
                <span class="muted">@(string.Format(L["Vle_Chrome"].Value, Home, Foreign))</span>
            </div>
        </div>
    </div>

    <div class="callout warning"><span class="cic">🤝</span><div><p class="ct">@L["Vle_BilateralTitle"]</p>
        @((MarkupString)string.Format(L["Vle_BilateralBody"].Value, Home, Foreign))</div></div>

    <DocReviewBar DocumentId="_docId" />

    @if (_lock is { Locked: true, IsMine: false })
    {
        <div class="callout danger"><span class="cic">🔒</span><div><p class="ct">@L["Ed_LockedByOther"]</p>
            @(string.Format(L["Ed_LockedByOtherBody"].Value, _lock.ByName ?? L["Lock_AnotherEditor"].Value, _lock.ExpiresUtc is { } e ? $" (→ {e:HH:mm})" : ""))</div></div>
    }
    @if (_error is not null) { <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div></div> }

    @if (_doc.Sections.Count == 0)
    {
        <div class="callout info"><span class="cic"><Icon Name="file" Size="18" /></span><div><p class="ct">@L["Vle_Empty"]</p>
            @if (_editing) { <text>@L["Vle_EmptyEditing"]</text> } else { <text>@L["Vle_EmptyReadonly"]</text> }</div></div>
    }

    <DocumentSectionsEditor Doc="_doc" IsEditing="_editing" Run="Guard" OnChanged="LoadAsync"
                            IsDerivedSection="IsDerived" DerivedContent="DerivedSection"
                            IsMandatory="IsMandatory"
                            IsRenderModeToggleable="IsRenderModeToggleable"
                            ShowToc="true" ExtraTocItems="_tocExtra">
        <RightRail>
            @if (_save == SaveState.Saving) { <span class="save-badge saving">💾 @L["Ed_Saving"]</span> }
            else if (_save == SaveState.Saved) { <span class="save-badge saved">✓ @L["Ed_Saved"]</span> }
            <span class="pill @(_doc.VersionStatus == DocumentStatus.Draft ? "grey" : "green")">
                @(_doc.VersionStatus == DocumentStatus.Draft ? string.Format(L["Ed_DraftVN"].Value, _doc.VersionNumber) : string.Format(L["Ed_PublishedVN"].Value, _doc.VersionNumber))
            </span>
            <a class="btn ghost" data-tour="preview" href="/vsop/@Home.ToLowerInvariant()/vloa?acc=@Foreign&as=draft" target="_blank" rel="noopener" title="@L["Ed_PreviewDraftTitle"]"><Icon Name="eye" /> @L["Ed_PreviewDraft"]</a>
            <HelpHint Href="/vsop/guida#editor-anteprima" AriaLabel="Aiuto sull'anteprima bozza">
                Apre la <b>bozza</b> in una nuova scheda (<code>?as=draft</code>): la vedi come sarà, ma
                <b>non</b> è ancora pubblica. Controlla sempre qui prima di <b>pubblicare</b>.
            </HelpHint>
            @if (_editing)
            {
                <span class="save-badge lock-mine" title="@L["Lock_Editing"]">🔒 @L["Lock_Editing"]@(_lock.ExpiresUtc is { } e ? string.Format(L["Lock_UntilSuffix"].Value, e.ToString("HH:mm")) : "")</span>
                <button class="btn ghost" @onclick="FinishEditing">✓ @L["Lock_FinishEdit"]</button>
            }
            else if (_lock is { Locked: true, IsMine: false })
            {
                <span class="save-badge lock-badge" title="@L["Ed_LockedByOther"]">🔒 @(_lock.ByName ?? L["Lock_AnotherEditor"].Value)@(_lock.ExpiresUtc is { } e ? $" · → {e:HH:mm}" : "")</span>
                <button class="btn ghost" disabled title="@L["Ed_LockedByOther"]">✎ @L["Ed_Edit"]</button>
            }
            else
            {
                <button class="btn ghost" @onclick="StartEditing">✎ @L["Ed_Edit"]</button>
            }
        </RightRail>
    </DocumentSectionsEditor>

    @* Release AIRAC: stesso componente condiviso di ACC/APP/aeroporto (doc 11 §3f). Prima l'editor vLOA era
       l'unico senza pannello release — la si poteva pubblicare solo da /vsop/versioni — e l'unico con un
       «Pubblica» di versione. «Pubblica ora» fa snapshot + promozione della bozza. *@
    <div class="block" id="@_releaseAnchor">
        <h3 style="margin-top:0"><Icon Name="calendar" /> @L["App_VersionsReleases"]</h3>
        <ReleasePanel Target="ReleaseTargetType.Vloa" Key="@_docId!.Value.ToString()"
                      ShowDiff="true" PreviewUrlFactory="ReleasePreviewUrl"
                      Published="LoadAsync" />
    </div>
}

@code {
    [Parameter, EditorRequired] public string Home { get; set; } = default!;
    [Parameter, EditorRequired] public string Foreign { get; set; } = default!;

    private int? _docId;
    private EditableDocument? _doc;
    // Sezioni DERIVATE (data-driven) unendo i due ACC: AoR, frequenze, coordinamenti.
    private VloaAorData _aor = VloaAorData.Empty;
    private VloaFreqData _freq = VloaFreqData.Empty;
    private VloaCoordination _coord = VloaCoordination.Empty;
    private LockInfo _lock = LockInfo.Free();
    private bool _notFound, _denied, _editing;
    private string? _error;

    // Titoli delle sezioni OBBLIGATORIE (mockup 3d): bloccate (no rinomina/sposta/elimina).
    private IReadOnlySet<string> _mandatory = new HashSet<string>();
    private bool IsMandatory(EditableSection s) => _mandatory.Contains(s.Title);
    // Solo le sezioni DERIVATE (aor/frequencies/coordination) espongono il toggle Live/Frozen (doc 10 §3a).
    private static bool IsRenderModeToggleable(EditableSection s) => SectionCatalog.IsRenderModeToggleable(s.SectionKey);

    private const string _releaseAnchor = "p-release";
    // Voce TOC per il blocco Release (reso fuori da DocumentSectionsEditor), come nell'editor APP.
    private IReadOnlyList<EditorTocItem> _tocExtra => new[] { new EditorTocItem(_releaseAnchor, L["App_VersionsReleases"]) };

    private string ReleasePreviewUrl(int releaseId) =>
        $"/vsop/{(Home ?? "").ToLowerInvariant()}/vloa?acc={Foreign}&as=rel:{releaseId}";

    private enum SaveState { Idle, Saving, Saved }
    private SaveState _save = SaveState.Idle;
    private int _saveTick;

    // Risolti dallo scope proprio (OwningComponentBase): context isolato dal circuito.
    private IEditingService Editing = default!;
    private IVloaDerivationService Vloa = default!;
    protected override void OnInitialized()
    {
        Editing = ScopedServices.GetRequiredService<IEditingService>();
        Vloa = ScopedServices.GetRequiredService<IVloaDerivationService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        _notFound = _denied = false;
        _error = null;
        _doc = null;

        var home = (Home ?? "").Trim().ToUpperInvariant();
        var foreign = (Foreign ?? "").Trim().ToUpperInvariant();
        _mandatory = VloaSections.MandatoryTitles(home, foreign);
        _docId = await Editing.ResolveVloaIdByPairAsync(home, foreign);
        if (_docId is null) { _notFound = true; return; }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_docId is not int id) return;
        try
        {
            _doc = await Editing.LoadForEditAsync(id);
            _lock = await Editing.InspectLockAsync(id);
            if (_doc is null) { _notFound = true; return; }
            _editing = _editing && _doc.IsEditable;   // resta in modifica solo se la working è bozza
            await LoadDerivedAsync(id);
        }
        catch (EditNotAllowedException) { _denied = true; }
    }

    // Carica le sezioni derivate (AoR/frequenze/coordinamenti) unendo i due ACC della coppia.
    private async Task LoadDerivedAsync(int id)
    {
        _aor = await Vloa.DeriveAorAsync(id);
        _freq = await Vloa.DeriveFrequenciesAsync(id);
        _coord = await Vloa.DeriveCoordinationAsync(id);
    }

    private Task ToggleAor(string cs) => Guard(async () =>
    {
        await Vloa.ToggleAorSectorAsync(_docId!.Value, cs);
        _aor = await Vloa.DeriveAorAsync(_docId!.Value);
    });

    private Task ToggleFreq(string cs) => Guard(async () =>
    {
        await Vloa.ToggleFrequencyAsync(_docId!.Value, cs);
        _freq = await Vloa.DeriveFrequenciesAsync(_docId!.Value);
    });

    // Sezione il cui corpo lo produce l'editor dai dati, non i blocchi. Lo dice il catalogo per il profilo vLOA
    // (doc 13 §3a). La sezione PADRE dei coordinamenti lo è quanto le due figlie (doc 11 §3f): l'editor offriva
    // blocchi lì, ma il viewer li sostituisce con le due direzioni e non li mostra mai.
    private static bool IsDerived(EditableSection s) =>
        SectionCatalog.IsHostRendered(SectionProfile.Vloa, s.SectionKey);

    // «Modifica»: garantisce una bozza editabile (+ lock) e passa in edit.
    private async Task StartEditing()
    {
        if (_docId is not int id) return;
        await GuardCore(async () =>
        {
            if (_doc is { IsEditable: false })
            {
                await Editing.CreateDraftAsync(id);   // copia Published→Draft (idempotente) e acquisisce il lock
                await LoadAsync();
            }
            else
            {
                await Editing.AcquireLockAsync(id);
                await LoadAsync();
            }
            _editing = _doc?.IsEditable == true;
        }, silent: true);
    }

    // Fine modifica: rilascia il lock così il documento è subito libero per gli altri (non aspetta i 30 min di TTL).
    private async Task FinishEditing()
    {
        _editing = false;
        if (_docId is int id)
        {
            await GuardCore(() => Editing.ReleaseLockAsync(id), silent: true);
            _lock = await Editing.InspectLockAsync(id);
        }
    }

    // ---- infra ----
    // Firma a 1 parametro preservata: passata come Run= a DocumentSectionsEditor (Func<Func<Task>,Task>).
    private Task Guard(Func<Task> action) => GuardCore(action, silent: false);
    private async Task GuardCore(Func<Task> action, bool silent)
    {
        _error = null;
        if (!silent) { _save = SaveState.Saving; StateHasChanged(); }
        try
        {
            await action();
            if (!silent)
            {
                _save = SaveState.Saved;
                var tick = ++_saveTick;
                _ = DismissSavedAsync(tick);
            }
        }
        catch (EditNotAllowedException) { _error = L["Vle_NoEditPerm"]; _save = SaveState.Idle; }
        catch (EditConflictException ex) { _error = ex.Message; _save = SaveState.Idle; if (_docId is int id) _lock = await Editing.InspectLockAsync(id); }
        catch (ValidationException ex) { _error = ex.Message; _save = SaveState.Idle; }
        // Rete di sicurezza: senza questo, un'eccezione non prevista (DbUpdateException, Npgsql…) sfuggiva,
        // abbatteva il circuito e lasciava il badge inchiodato su "Salvataggio". Meglio un errore visibile.
        catch (Exception ex)
        {
            _error = L["Common_UnexpectedError"] + ex.Message;
            _save = SaveState.Idle;
            Logger.LogError(ex, "Azione editor vLOA fallita (documento {DocId}).", _docId);
        }
    }

    private async Task DismissSavedAsync(int tick)
    {
        await Task.Delay(2000);
        if (tick == _saveTick && _save == SaveState.Saved) { _save = SaveState.Idle; await InvokeAsync(StateHasChanged); }
    }

    // ---- sezioni DERIVATE (data-driven): AoR / frequenze / coordinamenti ----
    private RenderFragment DerivedSection(EditableSection s) => __builder =>
    {
        switch (s.SectionKey)
        {
            case "aor":
                @AorView()
                break;
            case "frequencies":
                @FreqView()
                break;
            case "coordination":
                // La sezione PADRE non porta una direzione: le due direzioni sono le sue SOTTO-sezioni, rese qui
                // sotto dall'editor condiviso. Renderla come se fosse una direzione duplicava l'albero — e per
                // giunta quello sbagliato: il titolo «Coordination» non inizia col codice Home, quindi cadeva
                // sempre su ForeignToHome. (Nel viewer è il padre a rendere ENTRAMBE le direzioni e le figlie non
                // si rendono: là la sequenza è un'altra.)
                if (s.Depth == 0) break;
                var homeToForeign = s.Title.StartsWith(Home ?? "", StringComparison.OrdinalIgnoreCase);
                <AccCoordinationView Coord="@(homeToForeign ? _coord.HomeToForeign : _coord.ForeignToHome)" English="true" />
                break;
        }
    };

    private RenderFragment AorView() => __builder =>
    {
        @if (_editing && _aor.Toggles.Count > 0)
        {
            <p class="muted" style="font-size:12.5px;margin:0 0 6px">@L["Vle_AorToggleHint"]</p>
            <div class="aor-toggles" style="margin-bottom:8px">
                @foreach (var t in _aor.Toggles)
                {
                    <button type="button" class="aor-chip @(t.Hidden ? "" : "on")" @onclick="() => ToggleAor(t.Callsign)"
                            title="@(t.Hidden ? L["AccAdmin_Show"] : L["AccAdmin_Hide"])">
                        <span class="sw" style="background:@(t.Color)33;border-color:@t.Color"></span>
                        @t.Name @(t.IsForeign ? "· " + L["Xfer_Foreign"] : "")
                    </button>
                }
            </div>
        }
        <AccAor View="_aor.Map" Id="@($"vloa-aor-{_docId}")" />
    };

    private RenderFragment FreqView() => __builder =>
    {
        @if (_freq.Rows.Count == 0)
        {
            <p class="muted">@L["Vle_NoDerivedFreq"]</p>
        }
        else
        {
            <h4 style="margin:8px 0 4px">@_freq.HomeCountry - @_freq.HomeAcc</h4>
            @FreqTable(_freq.Rows.Where(r => !r.IsForeign).ToList())
            <h4 style="margin:14px 0 4px">@_freq.ForeignCountry - @_freq.ForeignAcc</h4>
            @FreqTable(_freq.Rows.Where(r => r.IsForeign).ToList())
        }
    };

    private RenderFragment FreqTable(IReadOnlyList<VloaFreqRow> rows) => __builder =>
    {
        @if (rows.Count == 0)
        {
            <p class="muted" style="margin:0">@L["Vle_NoFreq"]</p>
        }
        else
        {
            <table class="cfg-table" style="table-layout:fixed;width:100%">
                <colgroup>
                    <col style="width:32px" />
                    <col style="width:auto" />
                    <col style="width:26%" />
                    <col style="width:120px" />
                    @if (_editing) { <col style="width:104px" /> }
                </colgroup>
                <thead>
                    <tr><th></th><th>@L["Airport_Name"]</th><th>Callsign</th><th>@L["Vle_Frequency"]</th>@if (_editing) { <th></th> }</tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        @if (_editing || !r.Hidden)
                        {
                            <tr style="@(r.Hidden ? "opacity:.45" : "")">
                                <td>@(r.Row.IsPrimary ? "★" : "")</td>
                                <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Row.Name</td>
                                <td>@r.Row.Callsign</td>
                                <td>@r.Row.FrequencyMhz</td>
                                @if (_editing)
                                {
                                    <td><button class="btn ghost" @onclick="() => ToggleFreq(r.Row.Callsign)">@(r.Hidden ? L["AccAdmin_Show"] : L["AccAdmin_Hide"])</button></td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    };

}
