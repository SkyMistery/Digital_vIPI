@* Editor di blocchi editoriali IN-MEMORY, condiviso. Stesso vocabolario/markup del sotto-editor blocchi di
   DocumentSectionsEditor (Prosa/Callout/Tabella), ma su una lista <ExtraBlock> mutata in loco: l'host decide
   come persistere (OnChanged → salva/marca dirty). *@
@using System.Text.Json
@using Vipi.Application.Import
@inject IStringLocalizer<SharedResource> L

@foreach (var b in Blocks)
{
    var blk = b;
    @if (!Editing)
    {
        @ReadOnlyBlock(blk)
    }
    else
    {
        <div class="app-block-edit" style="align-items:flex-start;gap:8px;margin:6px 0">
            <div style="flex:1">
                @switch (blk.Format)
                {
                    case BlockFormat.Prose:
                    case BlockFormat.List:
                        <textarea class="app-ta" rows="3" value="@blk.Text" placeholder="@L["Dse_TextMarkdownPh"]"
                                  @onchange="e => SetText(blk, AsString(e.Value))"></textarea>
                        break;
                    case BlockFormat.Callout:
                        <div style="display:flex;gap:8px;align-items:center;margin-bottom:4px">
                            <span class="muted" style="font-size:12px">@L["Dse_TypeLabel"]</span>
                            <select class="app-in" style="max-width:150px" value="@blk.CalloutKind"
                                    @onchange="e => SetKind(blk, Enum.Parse<CalloutKind>(AsString(e.Value)))">
                                @foreach (var k in Enum.GetValues<CalloutKind>()) { <option value="@k">@k</option> }
                            </select>
                        </div>
                        <textarea class="app-ta" rows="2" value="@blk.Text" placeholder="@L["Dse_CalloutTextPh"]"
                                  @onchange="e => SetText(blk, AsString(e.Value))"></textarea>
                        break;
                    case BlockFormat.Table:
                        @TableEditor(blk)
                        break;
                    case BlockFormat.Image:
                        <ImageBlockEditor DocumentId="DocumentId" ImageJson="@blk.ImageJson" ImageJsonChanged="j => SetImage(blk, j)"
                                          Caption="@blk.Text" CaptionChanged="c => SetText(blk, c ?? string.Empty)" />
                        break;
                    case BlockFormat.Attachment:
                        <AttachmentBlockEditor AttachmentJson="@blk.AttachmentJson" AttachmentJsonChanged="j => SetAttachment(blk, j)"
                                               Note="@blk.Text" />
                        <textarea class="app-ta" rows="2" value="@blk.Text" placeholder="@L["Att_BlockNotePh"]"
                                  @onchange="e => SetText(blk, AsString(e.Value))"></textarea>
                        break;
                }
            </div>
            <div style="display:flex;flex-direction:column;gap:4px">
                <button class="btn ghost" title="@L["Common_Up"]" @onclick="() => Move(blk, -1)">↑</button>
                <button class="btn ghost" title="@L["Common_Down"]" @onclick="() => Move(blk, 1)">↓</button>
                <button class="btn ghost" title="@L["Dse_DeleteBlock"]" @onclick="() => Remove(blk)"><Icon Name="x" /></button>
            </div>
        </div>
    }
}

@if (Editing)
{
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
        <button class="btn ghost" @onclick="() => Add(BlockFormat.Prose)">+ @L["Dse_Paragraph"]</button>
        <button class="btn ghost" @onclick="() => Add(BlockFormat.Callout)">+ Callout</button>
        <button class="btn ghost" @onclick="() => Add(BlockFormat.Table)">+ @L["Dse_Table"]</button>
        <button class="btn ghost" @onclick="() => Add(BlockFormat.Image)">+ @L["Dse_Image"]</button>
        <button class="btn ghost" @onclick="() => Add(BlockFormat.Attachment)">+ @L["Dse_Attachment"]</button>
        <HelpHint Href="/services/vsop/guide#editor-blocchi" AriaLabel="@L["Blocks_HelpAria"]">
            @((MarkupString)L["Blocks_HelpBody"].Value)
        </HelpHint>
    </div>
}

@code {
    /// <summary>Blocchi editati in loco. L'host la possiede e la persiste su <see cref="OnChanged"/>.</summary>
    [Parameter, EditorRequired] public List<ExtraBlock> Blocks { get; set; } = new();
    [Parameter] public bool Editing { get; set; }
    /// <summary>Documento di destinazione, per la quota immagini. Null = quota non applicabile.</summary>
    [Parameter] public int? DocumentId { get; set; }
    /// <summary>Invocato dopo ogni mutazione (aggiunta/modifica/spostamento/rimozione).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private static string AsString(object? v) => v as string ?? "";

    private Task Changed() => OnChanged.InvokeAsync();

    // ---- mutazioni blocco ----
    private Task SetText(ExtraBlock b, string v) { b.Text = v; return Changed(); }
    private Task SetKind(ExtraBlock b, CalloutKind k) { b.CalloutKind = k; return Changed(); }
    private Task SetImage(ExtraBlock b, string? json) { b.ImageJson = json; return Changed(); }
    private Task SetAttachment(ExtraBlock b, string? json) { b.AttachmentJson = json; return Changed(); }

    private Task Add(BlockFormat format)
    {
        var b = new ExtraBlock { Format = format };
        if (format == BlockFormat.Table) b.TableJson = TabellaGenerica.Nuova();
        Blocks.Add(b);
        return Changed();
    }

    private Task Remove(ExtraBlock b) { Blocks.Remove(b); return Changed(); }

    private Task Move(ExtraBlock b, int dir)
    {
        var i = Blocks.IndexOf(b);
        var j = i + dir;
        if (j < 0 || j >= Blocks.Count) return Task.CompletedTask;
        (Blocks[i], Blocks[j]) = (Blocks[j], Blocks[i]);
        return Changed();
    }

    // ---- render read-only (identico a DocumentSectionsEditor.ReadOnlyBlock) ----
    private RenderFragment ReadOnlyBlock(ExtraBlock b) => __builder =>
    {
        switch (b.Format)
        {
            case BlockFormat.Callout:
                <div class="callout @b.CalloutKind.ToString().ToLowerInvariant()">
                    <span class="cic"><Icon Name="@CalloutIcon(b.CalloutKind)" Size="18" /></span>
                    <div>@MarkdownLite.Render(b.Text)</div>
                </div>
                break;
            case BlockFormat.Table:
                @RenderTablePreview(b);
                break;
            case BlockFormat.Image:
                <ImageFigure Media="MediaRef.Parse(b.ImageJson)" Caption="@b.Text" />
                break;
            case BlockFormat.Attachment:
                <AttachmentLink Reference="AttachmentRef.Parse(b.AttachmentJson)" Note="@b.Text" />
                break;
            default:
                @if (!string.IsNullOrWhiteSpace(b.Text)) { <div class="prose">@MarkdownLite.Render(b.Text)</div> }
                break;
        }
    };

    private static string CalloutIcon(CalloutKind k) => k switch
    {
        CalloutKind.Success => "check-circle", CalloutKind.Warning => "warning", CalloutKind.Danger => "octagon", _ => "info",
    };

    // ---- editor tabella (columns + rows di celle) ----
    //
    // La forma del payload sta in UN posto solo (`TabellaGenerica`), condivisa con `DocumentSectionsEditor`.
    private static (List<string> Cols, List<List<string>> Rows) ParseTable(string? json) =>
        TabellaGenerica.Leggi(json);

    private static string SerializeTable(List<string> cols, List<List<string>> rows) =>
        TabellaGenerica.Scrivi(cols, rows);

    private Task SetTableCol(ExtraBlock b, int ci, string val)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        if (ci < cols.Count) cols[ci] = val;
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }
    private Task RemoveTableCol(ExtraBlock b, int ci)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        if (ci < cols.Count) cols.RemoveAt(ci);
        foreach (var r in rows) if (ci < r.Count) r.RemoveAt(ci);
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }
    private Task AddTableCol(ExtraBlock b)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        cols.Add($"Colonna {cols.Count + 1}");
        foreach (var r in rows) r.Add("");
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }
    private Task SetTableCell(ExtraBlock b, int ri, int ci, string val)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        if (ri < rows.Count) { while (rows[ri].Count <= ci) rows[ri].Add(""); rows[ri][ci] = val; }
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }
    private Task AddTableRow(ExtraBlock b)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        rows.Add(Enumerable.Repeat(string.Empty, Math.Max(1, cols.Count)).ToList());
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }
    private Task RemoveTableRow(ExtraBlock b, int ri)
    {
        var (cols, rows) = ParseTable(b.TableJson);
        if (ri < rows.Count) rows.RemoveAt(ri);
        b.TableJson = SerializeTable(cols, rows);
        return Changed();
    }

    private RenderFragment TableEditor(ExtraBlock b) => __builder =>
    {
        var (cols, rows) = ParseTable(b.TableJson);
        <table class="cfg-table">
            <thead>
                <tr>
                    @for (var ci = 0; ci < cols.Count; ci++)
                    {
                        var cidx = ci;
                        <th>
                            <div style="display:flex;gap:4px;align-items:center">
                                <input class="app-in" value="@cols[cidx]" @onchange="e => SetTableCol(b, cidx, AsString(e.Value))" />
                                <button class="btn ghost" title="@L["Dse_RemoveColumn"]" @onclick="() => RemoveTableCol(b, cidx)">✕</button>
                            </div>
                        </th>
                    }
                    <th style="width:42px"><button class="btn ghost" title="@L["Dse_AddColumn"]" @onclick="() => AddTableCol(b)">＋</button></th>
                </tr>
            </thead>
            <tbody>
                @for (var ri = 0; ri < rows.Count; ri++)
                {
                    var ridx = ri;
                    <tr>
                        @for (var ci = 0; ci < cols.Count; ci++)
                        {
                            var cidx = ci;
                            var cell = cidx < rows[ridx].Count ? rows[ridx][cidx] : "";
                            <td><input class="app-in" value="@cell" @onchange="e => SetTableCell(b, ridx, cidx, AsString(e.Value))" /></td>
                        }
                        <td><button class="btn ghost" title="@L["Dse_RemoveRow"]" @onclick="() => RemoveTableRow(b, ridx)">✕</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="display:flex;gap:6px;margin-top:6px">
            <button class="btn ghost" @onclick="() => AddTableRow(b)">+ @L["Dse_Row"]</button>
            @* ⚠️ L'import sta ACCANTO a «+ riga» e non altrove: e' l'alternativa allo scriverle una per una,
               ed e' li' che se ne sente il bisogno. *@
            <button class="btn ghost" @onclick="() => ApriImport(b)">⤓ @L["Imp_Open"]</button>
        </div>
        @if (ReferenceEquals(_importBlock, b))
        {
            <ImportaTabella Spec="@SpecTabella" OnImporta="r => Importa(b, r)"
                            OnAnnulla="() => { _importBlock = null; return Task.CompletedTask; }" />
        }
    };

    // ---- import di una tabella -------------------------------------------------------------------------

    private static readonly SpecImport SpecTabella = SpecImport.Generica();

    /// <summary>Il blocco su cui l'import e' aperto; null = nessuno. ⚠️ E' il BLOCCO e non un flag: due
    /// tabelle nella stessa sezione avrebbero due import aperti insieme, e le righe finirebbero in quella
    /// sbagliata.</summary>
    private ExtraBlock? _importBlock;

    private void ApriImport(ExtraBlock b) => _importBlock = ReferenceEquals(_importBlock, b) ? null : b;

    /// <summary>
    /// Scrive le righe approvate. ⚠️ Le righe si <b>pareggiano</b> al numero di colonne: in una tabella HTML
    /// una riga corta non lascia una cella vuota, sposta tutto a sinistra — il dato sembrerebbe sbagliato
    /// invece che incompleto.
    /// </summary>
    private Task Importa(ExtraBlock b, RichiestaImport r)
    {
        var (cols, rows) = ParseTable(b.TableJson);

        // La tabella generica prende anche le COLONNE da chi incolla, ma solo quando non ne ha gia' di sue:
        // sovrascrivere le intestazioni di una tabella compilata sarebbe una perdita che nessuno ha chiesto.
        if (cols.Count == 0 && r.Proposta.Colonne.Count > 0) cols = r.Proposta.Colonne.ToList();

        var nuove = r.Proposta.Buone.Select(x => (IReadOnlyList<string>)x.Celle.Select(c => c.Valore).ToList());
        var tutte = r.Sostituisci ? nuove.ToList() : rows.Select(x => (IReadOnlyList<string>)x).Concat(nuove).ToList();

        b.TableJson = TabellaGenerica.Scrivi(cols, TabellaGenerica.Pareggia(tutte, cols.Count));
        _importBlock = null;
        return OnChanged.InvokeAsync();
    }

    private RenderFragment RenderTablePreview(ExtraBlock b) => __builder =>
    {
        var (cols, rows) = ParseTable(b.TableJson);
        @if (cols.Count > 0 || rows.Count > 0)
        {
            <table class="cfg-table">
                <thead><tr>@foreach (var c in cols) { <th>@c</th> }</tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>@for (var i = 0; i < cols.Count; i++) { <td>@(i < r.Count ? r[i] : "")</td> }</tr>
                    }
                </tbody>
            </table>
        }
    };
}
