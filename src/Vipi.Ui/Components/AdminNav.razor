@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav
@inject IEditAuthorizationService Authz

@* Barra di navigazione fra le pagine admin.

   Perché è un componente e non un elenco di <a> nella pagina. L'elenco delle pagine admin esisteva in DUE
   posti e diverso: sei card in «Area Staff» (struttura, trasferimenti, documenti, audit, incarichi,
   diagnostica) e quattro link nella barra di Struttura (ACC, aeroporti, confinanti, sorgenti) — e nessuno dei
   due elencava tutto. Il risultato era che Audit, Incarichi e Diagnostica si raggiungevano SOLO dalle card, e
   Aeroporti e Sorgenti SOLO da Struttura. Qui l'elenco sta in un posto: aggiungere una pagina admin è una
   riga in `Voci`.

   ⚠️ La barra DECIDE DA SÉ chi vedere: ogni voce si porta dietro la sua regola d'accesso (`Chi`) e viene
   filtrata qui. Le pagine la scrivono nuda — `<AdminNav />`, senza `@if` intorno — perché un `@if` copiato in
   undici punti è undici posti dove sbagliarsi il giorno che una pagina cambia autorizzazione (ed è la trappola
   della regola 120: un elenco di porte chiuse a chi non può aprirne nessuna). La regola sta accanto alla voce,
   una riga, un posto solo.

   Le etichette sono NOMI CORTI, non troncamenti (regola 33): il nome per esteso sta nel `title`. Una barra
   che va a capo tre volte costa più di quello che fa risparmiare.

   La voce della pagina corrente non è un link ma uno stato: `aria-current="page"` e nessun href — un
   comando che ti porta dove sei già è rumore. *@

@if (Visibili.Count > 1)
{
    @* Niente etichetta «Admin:» davanti alle voci: ripeteva a ogni pagina una cosa che si vede da sola —
       sei nell'area staff, e le voci dicono quali pagine sono. Il nome della barra resta dove serve
       davvero, nell'`aria-label`: chi la incontra con uno screen reader non ha il colpo d'occhio. *@
    <nav class="admin-nav" aria-label="@L["Nav_AdminAria"]">
        @foreach (var v in Visibili)
        {
            var corrente = IsCorrente(v.Url);
            if (corrente)
            {
                <span class="an-link on" aria-current="page" title="@L[v.TitleKey]"><Icon Name="@v.Icon" Size="13" /> @L[v.LabelKey]</span>
            }
            else
            {
                <a class="an-link" href="@v.Url" title="@L[v.TitleKey]"><Icon Name="@v.Icon" Size="13" /> @L[v.LabelKey]</a>
            }
        }
    </nav>
}

@code {
    /// <summary>
    /// Una pagina admin: rotta, icona, nome corto in barra, nome per esteso nel tooltip, e il <b>livello
    /// minimo</b> per entrarci. È l'unico posto dove sta scritto: se domani una pagina si apre (o si
    /// chiude), si cambia la sua riga in <see cref="Voci"/> e la barra si adegua ovunque.
    ///
    /// <para>Il default è <see cref="VipiRole.Admin"/> apposta: una pagina nuova nasce <b>chiusa</b>, e la
    /// si apre scrivendolo. Il contrario — nascere aperta e ricordarsi di chiuderla — è il modo in cui i
    /// permessi si allargano senza che nessuno lo decida.</para>
    /// </summary>
    private sealed record Voce(string Url, string Icon, string LabelKey, string TitleKey,
        VipiRole Minimo = VipiRole.Admin);

    private static readonly Voce[] Voci =
    {
        new("/services/vsop/admin/sector-structure", "building",       "Struct_Title",        "Grants_StructDesc", VipiRole.Editor),
        new("/services/vsop/admin/acc",             "map",            "Struct_NavAcc",       "Home_AccDesc", VipiRole.Editor),
        new("/services/vsop/admin/airports",        "plane-takeoff",  "Struct_NavAirports",  "Nav_AirportsTitle", VipiRole.Editor),
        new("/services/vsop/admin/neighbours",      "globe",          "Struct_NavNeighbours","Conf_Subtitle", VipiRole.Editor),
        new("/services/vsop/admin/sources",        "plug",           "Struct_NavSources",   "Nav_SourcesTitle"),
        new("/services/vsop/admin/transfers",   "refresh",        "Home_TransfersTitle", "Home_TransfersDesc", VipiRole.Editor),
        new("/services/vsop/versions",              "file",           "Nav_Docs",            "Grants_DocsDesc", VipiRole.Editor),
        new("/services/vsop/admin/pending",         "warning",        "Pend_Title",          "Pend_Title", VipiRole.Editor),
        new("/services/vsop/admin/tasks",           "clipboard",      "Nav_Tasks",           "Grants_TasksDesc"),
        new("/services/vsop/admin/translations",    "book-open",      "Tr_AdminTitle",       "Tr_AdminTitle", VipiRole.Editor),
        new("/services/vsop/admin/glossary",        "radio",           "Gl_Title",            "Gl_Subtitle", VipiRole.Editor),
        new("/services/vsop/admin/navaids",         "radio",          "Nav_AdminNav",        "Nav_AdminSubtitle", VipiRole.Editor),
        new("/services/vsop/admin/audit",           "scroll",         "Audit_Title",         "Grants_AuditDesc"),
        new("/services/vsop/admin/diagnostics",     "activity",       "Nav_Diag",            "Grants_DiagDesc"),
        new("/services/vsop/admin/permissions",        "key",            "Nav_Perms",           "Grants_GrantHint"),
    };

    /// <summary>
    /// Le voci che questo utente può davvero aprire.
    ///
    /// <para>Niente giro in banca dati: il livello lo risolve il servizio una volta per scope, dai claim e
    /// dal fotogramma in memoria. Una barra che interrogasse il DB girerebbe su undici pagine mentre ognuna
    /// sta caricando i propri dati, sullo stesso <c>DbContext</c> di circuito — che è esattamente come si
    /// prende un «A second operation was started on this context».</para>
    /// </summary>
    private IReadOnlyList<Voce> Visibili = Array.Empty<Voce>();

    // Una volta sola, non a ogni valutazione del markup: il filtro lo leggono sia il `@if` che il `foreach`.
    protected override void OnInitialized() =>
        Visibili = Voci.Where(v => Authz.Role >= v.Minimo).ToArray();

    /// <summary>
    /// Confronto sul solo percorso: la pagina corrente può portarsi dietro una query (i filtri di Versioni la
    /// riscrivono a ogni clic) e un confronto sull'URL intero direbbe «non sei qui» appena filtri.
    /// </summary>
    private bool IsCorrente(string url)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return string.Equals(path, url.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    }
}
