@inject IStringLocalizer<SharedResource> L

@* Il link a un allegato, reso allo stesso modo ovunque: nel blocco del documento, nell'anteprima degli
   editor e nella pagina d'aeroporto.

   ⚠️ L'href è SEMPRE la nostra rotta /vsop/files/{slug}: nel documento non finisce mai un indirizzo del
   deposito, così cambiare deposito domani non tocca un solo documento.

   ⚠️ E si dice che il clic PORTA FUORI dal sito, prima del clic. Il file sta sul Drive di divisione e si
   apre nel visualizzatore di Google: scoprirlo dopo, con la pagina già cambiata, è il modo in cui un lettore
   si perde e torna indietro. `target="_blank"` per la stessa ragione — un documento aperto per consultarlo
   non deve sparire da sotto chi lo stava leggendo. *@

@if (Reference is { } r)
{
    <p class="att-link">
        <a href="@r.Url" target="_blank" rel="noopener">
            <Icon Name="paperclip" Size="14" /> @(r.Title is { Length: > 0 } t ? t : r.Slug)
        </a>
        <span class="muted att-ext" title="@L["Att_ExternalTitle"]">
            <Icon Name="link" Size="12" /> @L["Att_External"]
        </span>
    </p>
    @if (!string.IsNullOrWhiteSpace(Note))
    {
        <div class="prose att-note">@MarkdownLite.Render(Note)</div>
    }
}
else
{
    @* Un riferimento illeggibile non è un'eccezione in mezzo a un documento: è un posto vuoto che si vede,
       e che dice a chi edita che c'è qualcosa da sistemare. *@
    <p class="att-link muted">@L["Att_Missing"]</p>
}

@code {
    [Parameter] public AttachmentRef? Reference { get; set; }

    /// <summary>La nota sotto il link: markdown, come la prosa.</summary>
    [Parameter] public string? Note { get; set; }
}
