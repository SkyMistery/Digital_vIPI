@* Il comando dell'unione, nell'editor dell'OSPITE (carta 2026-09-03-documenti-uniti.md §5): quali documenti
   si leggono insieme a questo, in che ordine, e i tasti per cambiarlo.

   ⚠️ SCOPE PROPRIO (OwningComponentBase), come i sei componenti del repository dopo l'audit del 30 luglio
   2026: qui si SCRIVE, e un servizio di scrittura preso con `@inject` è quello del DbContext del CIRCUITO —
   che è il difetto già pagato tre volte (la barra, il pannello traduzioni, l'editor che si blocca).
   ⚠️ Non è il caso di `ReleasePanel`, che il contesto NON lo isola apposta: là il publish è un'operazione
   sola composta con il `BeforePublishAsync` della pagina, e spezzarla su due context la manda in stallo.
   Qui i gesti sono a sé — unisci, sposta, sciogli — e non compongono niente.

   ⚠️ I comandi si accendono solo IN MODIFICA, come tutti gli altri dell'editor: l'unione è una scelta
   editoriale sul documento, non una preferenza di chi guarda. *@
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Domain
@inject IStringLocalizer<SharedResource> L
@inject StringheDelSito Sito

<div class="rel-panel" id="sec-unione">
    <div class="doc-head" style="margin:0 0 10px">
        <h3 class="h-card" style="margin:0">@Sito["Union_Title"]
            <HelpHint ExtraClass="wide">@Sito["Union_Help"]</HelpHint>
        </h3>
    </div>

    @if (_errore is { Length: > 0 })
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_errore</div></div>
    }

    @if (_unione is null)
    {
        <p class="muted">@Sito["Union_None"]</p>
    }
    else
    {
        @* 🔴 Chi NON e' l'ospite deve saperlo QUI, e sapere dove andare. Spostando il primo dell'elenco
           l'ospite CAMBIA, e con lui si sposta l'editor unito: i corpi degli altri membri smettono di
           comparire in questa pagina e ricompaiono nell'altra. Senza questa riga sembrava che l'unione si
           fosse persa — segnalato dal committente il 7 settembre 2026, dopo aver invertito l'ordine e
           essere rientrato nell'editor del vSOP. *@
        @if (!SonoOspite)
        {
            <div class="callout info">
                <span class="cic"><Icon Name="info" Size="18" /></span>
                <div>
                    @Sito.Formatta("Union_NotHost", _unione.Host.Doc.Title)
                    @if (_indirizzoOspite is { Length: > 0 })
                    {
                        <div style="margin-top:6px">
                            <a class="btn ghost" href="@_indirizzoOspite">@Sito.Formatta("Union_OpenHost", _unione.Host.Doc.Title)</a>
                        </div>
                    }
                </div>
            </div>
        }

        <p class="muted" style="margin:0 0 6px">@Sito["Union_Members"]</p>
        <ol class="union-list">
            @* ⚠️ Le frecce si spengono sulla POSIZIONE nella lista, non su `m.Order`. `RemoveMemberAsync`
               rinumera, ma la cascata della FK (documento eliminato) no: con le posizioni 0 e 2, l'ultimo
               membro teneva la freccia «giu'» accesa su un gesto che non fa niente — e un tasto che a volte
               non fa niente e' peggio di un tasto spento. *@
            @for (var i = 0; i < _unione.Members.Count; i++)
            {
                var m = _unione.Members[i];
                var posizione = i;
                <li>
                    <b>@m.Doc.Title</b>
                    <span class="muted">@m.Doc.ReleaseKey</span>
                    @if (m.IsHost)
                    {
                        <span class="pill green" title="@Sito["Union_HostHint"]">@Sito["Union_Host"]</span>
                    }
                    @if (IsEditing)
                    {
                        <span class="union-cmds">
                            <button class="btn ghost" title="@Sito["Union_MoveUp"]" aria-label="@Sito["Union_MoveUp"]"
                                    disabled="@(_busy || posizione == 0)" @onclick="() => Sposta(m, -1)">↑</button>
                            <button class="btn ghost" title="@Sito["Union_MoveDown"]" aria-label="@Sito["Union_MoveDown"]"
                                    disabled="@(_busy || posizione == _unione.Members.Count - 1)" @onclick="() => Sposta(m, +1)">↓</button>
                            <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@Sito["Union_Remove"]"
                                           AriaLabel="@Sito["Union_Remove"]" Prompt="@Sito["Union_RemovePrompt"]"
                                           ConfirmLabel="@Sito["Union_RemoveYes"]" CancelLabel="@L["Common_Close"]"
                                           Disabled="@_busy" OnConfirm="() => Togli(m)">
                                <Trigger>✕</Trigger>
                            </InlineConfirm>
                        </span>
                    }
                </li>
            }
        </ol>

        @if (IsEditing && _unione.Members.Count > 1)
        {
            <p class="help" style="margin:0 0 8px">@Sito["Union_FirstIsHost"]</p>
        }

        @if (IsEditing && SonoOspite)
        {
            @* Le sezioni in comune (7 settembre 2026, committente): unendo la vIPI di uno scalo e il suo vSOP
               la pagina ripete METAR, frequenze, piste. Si sceglie CHI LE TIENE e le altre si nascondono —
               col flag del tasto «nascondi», non con una cancellazione.
               ⚠️ Il comando resta SEMPRE, non solo appena si unisce: le sezioni si aggiungono dopo, e una
               comune che nasce domani oggi non esiste. *@
            <button class="btn ghost" disabled="@_busy" @onclick="ApriComuni">@Sito["Union_Common_Open"]</button>
        }

        @if (_scheda)
        {
            <div class="union-common" role="group" aria-label="@Sito["Union_Common_Title"]">
                <h4 class="h-card" style="margin:10px 0 6px">@Sito["Union_Common_Title"]</h4>

                @if (_comuni.Count == 0)
                {
                    <p class="muted">@Sito["Union_Common_None"]</p>
                }
                else
                {
                    <p class="help" style="margin:0 0 8px">@Sito["Union_Common_Hint"]</p>

                    @* ⚠️ CASELLE e non un solo bottone: i membri possono essere tre — LIBV ha due APP — e
                       «da quale nascondere» ha piu' di una risposta. Con due documenti si legge come la
                       richiesta del committente: spunto la vIPI, spariscono quelle della vIPI. *@
                    <p class="muted" style="margin:0 0 4px">@Sito["Union_Common_HideIn"]</p>
                    <ul class="union-keepers">
                        @foreach (var m in _confrontabili)
                        {
                            var id = m.DocumentId;
                            <li>
                                <label>
                                    <input type="checkbox" checked="@_nascondiIn.Contains(id)" disabled="@_busy"
                                           @onchange="e => SpuntaDocumento(id, (bool)(e.Value ?? false))" />
                                    @m.Doc.Title <span class="muted">@m.Doc.ReleaseKey</span>
                                </label>
                            </li>
                        }
                    </ul>

                    <ul class="union-commons">
                        @foreach (var c in _comuni)
                        {
                            var chiave = c.Chiave;
                            <li>
                                <label>
                                    <input type="checkbox" checked="@_spuntate.Contains(chiave)" disabled="@_busy"
                                           @onchange="e => Spunta(chiave, (bool)(e.Value ?? false))" />
                                    @c.Titolo
                                </label>
                                @if (c.Presenze.Any(p => p.Nascosta))
                                {
                                    <span class="pill neutral" title="@Sito["Union_Common_HiddenTitle"]">@Sito["Union_Common_Hidden"]</span>
                                }
                            </li>
                        }
                    </ul>

                    @* 🔴 Spuntare TUTTI i documenti e' legittimo — «quel dato qui non lo vogliamo» — ma la
                       sezione sparisce dalla pagina unita per intero: si dice, non si vieta. *@
                    @if (SezioniComuni.SparisceDaTutti(_comuni, _spuntate.ToList(), _nascondiIn))
                    {
                        <div class="callout warning">
                            <span class="cic"><Icon Name="triangle" Size="18" /></span>
                            <div>@Sito["Union_Common_AllHidden"]</div>
                        </div>
                    }

                    <div class="union-common-cmds">
                        <button class="btn primary" disabled="@(_busy || _spuntate.Count == 0 || _nascondiIn.Count == 0)"
                                @onclick="ApplicaComuni">@Sito["Union_Common_Apply"]</button>
                        <button class="btn ghost" disabled="@_busy" @onclick="() => _scheda = false">@L["Common_Close"]</button>
                    </div>
                }
            </div>
        }

        @if (_esito is { Length: > 0 })
        {
            <p class="help union-conta">@_esito</p>
        }

        @if (IsEditing)
        {
            <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@Sito["Union_Dissolve"]"
                           AriaLabel="@Sito["Union_Dissolve"]" Prompt="@Sito["Union_DissolvePrompt"]"
                           ConfirmLabel="@Sito["Union_DissolveYes"]" CancelLabel="@L["Common_Close"]"
                           Disabled="@_busy" OnConfirm="Sciogli">
                <Trigger>@Sito["Union_Dissolve"]</Trigger>
            </InlineConfirm>
        }
    }

    @if (!IsEditing)
    {
        <p class="muted" style="margin-top:8px">@Sito["Union_EditToChange"]</p>
    }
    else if (_candidati.Count == 0)
    {
        <p class="muted" style="margin-top:8px">@Sito["Union_NoCandidates"]</p>
    }
    else
    {
        @* ⚠️ Un filtro SOPRA la tendina, e non un `<input list>` con `<datalist>` come altrove: quel modo
           lega la CHIAVE, e un aeroporto e il suo vSOP militare hanno la stessa (l'ICAO). Scrivere «LIMN»
           non direbbe QUALE dei due — ed è il caso misto, cioè quello per cui l'unione esiste. Qui il
           filtro restringe e basta: l'identità resta l'id del documento, che è sempre uno solo. *@
        <div class="union-add">
            <label for="union-add-@Key">@Sito["Union_AddLabel"]</label>
            <input id="union-cerca-@Key" class="app-in union-cerca" type="search" autocomplete="off"
                   placeholder="@Sito["Union_SearchPh"]" aria-label="@Sito["Union_SearchPh"]"
                   value="@_cerca" @oninput="SuRicerca" disabled="@_busy" />
            <select id="union-add-@Key" class="app-in union-scelta" @bind="_scelto" disabled="@_busy"
                    size="@Apertura">
                <option value="0">—</option>
                @foreach (var c in Filtrati)
                {
                    <option value="@c.DocumentId">
                        @c.Doc.Title — @c.Doc.ReleaseKey@(c.StessoScalo ? $" ({Sito["Union_SameAirport"]})" : "")
                    </option>
                }
            </select>
            <button class="btn primary" disabled="@(_busy || _scelto == 0)" @onclick="Unisci">@Sito["Union_AddAction"]</button>
        </div>
        @if (_cerca.Length > 0)
        {
            <p class="help union-conta">@Sito.Formatta("Union_Found", Filtrati.Count, _candidati.Count)</p>
        }
    }
</div>

@code {
    /// <summary>La famiglia del documento che si sta redigendo.</summary>
    [Parameter, EditorRequired] public ReleaseTargetType Target { get; set; }

    /// <summary>La sua chiave di release: ICAO o callsign.</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    /// <summary>Vero mentre l'editor è in modifica: i comandi si accendono solo allora.</summary>
    [Parameter] public bool IsEditing { get; set; }

    /// <summary>L'host ricarica: l'unione cambia quel che la pagina mostra, non solo questo riquadro.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private IDocumentUnionService _unioni = default!;
    private IEditingService _editing = default!;
    private Vipi.Application.Routing.IDocRoutesRegistry _rotte = default!;

    /// <summary>
    /// Vero se il documento di QUESTA pagina è l'ospite dell'unione.
    /// <para>⚠️ Famiglia <b>e</b> chiave insieme: un aeroporto e il suo vSOP militare hanno la stessa chiave
    /// di release (l'ICAO) e si distinguono per il tipo — confrontare la sola chiave direbbe «sono io» a
    /// tutt'e due.</para>
    /// </summary>
    private bool SonoOspite => _unione is not null && _unione.IsHostTarget(Target, Key);

    /// <summary>L'editor dell'ospite, per chi ospite non è. null se la famiglia non ne dichiara uno.</summary>
    private string? _indirizzoOspite;

    /// <summary>La scheda delle sezioni in comune è aperta.</summary>
    private bool _scheda;
    private IReadOnlyList<SezioneComune> _comuni = Array.Empty<SezioneComune>();
    /// <summary>I documenti da cui le sezioni comuni SPARISCONO. Gli altri le tengono visibili.</summary>
    private readonly HashSet<int> _nascondiIn = new();
    private readonly HashSet<string> _spuntate = new(StringComparer.Ordinal);
    private string? _esito;
    private UnionView? _unione;
    private IReadOnlyList<UnionCandidate> _candidati = Array.Empty<UnionCandidate>();
    private int _scelto;
    private string _cerca = "";
    private bool _busy;

    /// <summary>
    /// I candidati che passano il filtro. Funzione <b>pura</b> e <c>public static</c> apposta: e' la parte
    /// che si puo' sbagliare senza che nulla protesti, e montare il pannello intero per provarla vorrebbe
    /// dire una fixture con servizio, scope e autorizzazione (stessa scelta di
    /// <c>EditorTocProjection.DaSezioni</c> e di <c>AppDocumentBody.AnchorOf</c>).
    ///
    /// <para>Le parole si cercano <b>tutte</b> e in qualunque ordine, su titolo E chiave: «liba app» trova
    /// «Amendola Approach — LIBA_APP», che scrivendo il titolo per intero non si troverebbe.</para>
    /// </summary>
    public static IReadOnlyList<UnionCandidate> Filtra(IReadOnlyList<UnionCandidate> tutti, string? testo)
    {
        var parole = (testo ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parole.Length == 0) return tutti;
        return tutti.Where(c =>
        {
            var ago = $"{c.Doc.Title} {c.Doc.ReleaseKey}";
            return parole.All(w => ago.Contains(w, StringComparison.OrdinalIgnoreCase));
        }).ToList();
    }

    private IReadOnlyList<UnionCandidate> Filtrati => Filtra(_candidati, _cerca);

    /// <summary>
    /// Quante righe mostrare aperte mentre si filtra; <c>null</c> = tendina normale, chiusa.
    /// <para>⚠️ <b>null e non 1</b>: con <c>size="1"</c> l'attributo c'è comunque, e una regola
    /// <c>.union-scelta[size]</c> gli si applicherebbe <b>sempre</b> — misurato, la tendina veniva 4px più
    /// bassa del campo accanto e con un altro padding. Un attributo omesso non fa scattare il selettore;
    /// un attributo col valore neutro sì.</para>
    /// </summary>
    private int? Apertura =>
        _cerca.Length > 0 && Filtrati.Count > 1 ? Math.Min(Filtrati.Count + 1, 8) : null;

    /// <summary>
    /// ⚠️ Filtrando si AZZERA la scelta se è uscita dall'elenco: una scelta che non si vede piu' resterebbe
    /// nel `select` e il tasto «Unisci» unirebbe un documento che chi preme non ha davanti. E se ne resta
    /// UNO solo lo si sceglie: e' quel che chi ha appena scritto tre lettere si aspetta.
    /// </summary>
    private void SuRicerca(ChangeEventArgs e)
    {
        _cerca = e.Value?.ToString() ?? "";
        var visti = Filtrati;
        if (_scelto != 0 && visti.All(c => c.DocumentId != _scelto)) _scelto = 0;
        if (visti.Count == 1) _scelto = visti[0].DocumentId;
    }
    private string? _errore;
    private string _caricato = "";

    protected override void OnInitialized()
    {
        _unioni = ScopedServices.GetRequiredService<IDocumentUnionService>();
        // ⚠️ Dallo scope PROPRIO come l'altro: qui si scrive (il flag «nascosta» sulle bozze dei membri), e
        // un servizio di scrittura preso col circuito è il difetto già pagato tre volte.
        _editing = ScopedServices.GetRequiredService<IEditingService>();
        _rotte = ScopedServices.GetRequiredService<Vipi.Application.Routing.IDocRoutesRegistry>();
    }

    protected override async Task OnParametersSetAsync()
    {
        // ⚠️ La guardia sta PRIMA dell'await, e su una chiave che comprende la modalità: OnParametersSetAsync
        // scatta a ogni ridisegno, e senza di essa due catene di caricamento si sovrappongono sullo stesso
        // DbContext — «A second operation was started». Lo scope proprio protegge dagli ALTRI, non da sé.
        var chiave = $"{Target}|{Key}|{IsEditing}";
        if (_caricato == chiave) return;
        _caricato = chiave;
        await RicaricaAsync();
    }

    private async Task RicaricaAsync()
    {
        _unione = await _unioni.ForTargetAsync(Target, Key);
        // I candidati servono solo a chi può premere, e costano una lettura dell'elenco unificato.
        // ⚠️ Si chiedono a partire dall'OSPITE quando l'unione c'è già: chi arriva entra in coda a quella,
        // non ne apre una seconda — ed è l'ospite a decidere chi è già dentro.
        _candidati = !IsEditing
            ? Array.Empty<UnionCandidate>()
            : _unione is null
                ? await _unioni.CandidatiPerTargetAsync(Target, Key)
                : await _unioni.CandidatiAsync(_unione.Host.DocumentId);
        _scelto = 0;
        _cerca = "";

        // L'indirizzo dell'editor dell'ospite. ⚠️ L'ACC lo dice l'OSPITE, non questa pagina: due documenti
        // uniti possono stare su ACC diversi, e col proprio si costruirebbe un indirizzo che non esiste —
        // o, peggio, uno che esiste e apre un altro scalo.
        _indirizzoOspite = null;
        if (_unione is not null && !SonoOspite)
        {
            var ospite = _unione.Host.Doc;
            _indirizzoOspite = _rotte.For(ospite.ReleaseTarget)
                .EditorUrl((ospite.AccCode ?? "").ToLowerInvariant(), ospite.ReleaseKey,
                           ospite.NeighbourCode, ospite.DocumentId);
        }
    }

    /// <summary>
    /// Unisce, e SUBITO DOPO apre la scheda delle sezioni in comune: è il momento in cui la ripetizione
    /// nasce, ed è lì che si vuole essere chiesti. Se non ce ne sono, la scheda lo dice invece di non
    /// comparire — «niente da scegliere» è una risposta, il silenzio è un dubbio.
    /// </summary>
    private Task Unisci() => EseguiAsync(async () =>
    {
        if (_scelto == 0) return;
        var ospite = _unione?.Host.DocumentId ?? await _unioni.DocumentIdAsync(Target, Key) ?? 0;
        if (ospite == 0) return;
        await _unioni.UniscoAsync(ospite, _scelto);
        _apriComuniDopoIlCarico = true;
    });

    /// <summary>I membri che partecipano al confronto: sono loro, e solo loro, a comparire fra le
    /// caselle «nascondi in». Vedi <see cref="SezioniComuni.Confrontabili"/>.</summary>
    private IReadOnlyList<UnionMemberView> _confrontabili = Array.Empty<UnionMemberView>();

    private bool _apriComuniDopoIlCarico;

    /// <summary>
    /// Carica le sezioni comuni e apre la scheda. ⚠️ Costa una lettura per membro, quindi si fa quando si
    /// apre — non a ogni ridisegno del pannello per poterne mostrare il numero in un'etichetta.
    /// </summary>
    private Task ApriComuni() => EseguiAsync(async () =>
    {
        await CaricaComuniAsync();
        _scheda = true;
    });

    private async Task CaricaComuniAsync()
    {
        if (_unione is null) { _comuni = Array.Empty<SezioneComune>(); return; }

        // ⚠️ Con la FAMIGLIA, non con degli id nudi: chi si confronta lo decide il servizio
        // (`SezioniComuni.Confrontabili`), perche' un APP unito a una vIPI d'aeroporto ha `frequencies`
        // con lo stesso nome e un altro contenuto. Qui si passano tutti i membri; torna vuoto da solo
        // quando non c'e' niente da confrontare.
        var conFamiglia = _unione.Members.Select(m => (m.DocumentId, m.Doc.ReleaseTarget)).ToList();
        _comuni = await _editing.SezioniComuniAsync(conFamiglia);

        // I documenti su cui si puo' nascondere sono SOLO quelli che si sono confrontati: offrire una
        // casella per l'APP vorrebbe dire proporre di nascondere una sezione che nessuno ripete.
        _confrontabili = _unione.Members
            .Where(m => SezioniComuni.Confrontabili(conFamiglia).Contains(m.DocumentId)).ToList();
        var membri = _confrontabili.Select(m => m.DocumentId).ToList();
        // 🔴 La proposta la fa lo STATO, non un default fisso: riproponendo sempre lo stesso insieme, chi
        // riapre la scheda e preme senza guardare RIBALTA la scelta di prima. A unione appena nata nessuno
        // ha nascosto niente, e allora si propongono tutti tranne l'ospite.
        if (_nascondiIn.Count == 0 || _nascondiIn.Any(id => membri.All(m => m != id)))
        {
            _nascondiIn.Clear();
            foreach (var id in SezioniComuni.DoveNascondere(_comuni, membri)) _nascondiIn.Add(id);
        }
        _spuntate.Clear();
        foreach (var c in _comuni.Where(c => c.Proposta)) _spuntate.Add(c.Chiave);
    }

    private void Spunta(string chiave, bool spuntata)
    {
        if (spuntata) _spuntate.Add(chiave);
        else _spuntate.Remove(chiave);
    }

    private void SpuntaDocumento(int documentId, bool spuntato)
    {
        if (spuntato) _nascondiIn.Add(documentId);
        else _nascondiIn.Remove(documentId);
    }

    /// <summary>
    /// Nasconde. ⚠️ Il conto lo dà il servizio, e conta le sezioni CAMBIATE DAVVERO: dire «sei nascoste»
    /// quando cinque lo erano già è la stessa bugia del conteggio dei documenti pubblicati, che in
    /// quest'area ha già sbagliato tre volte.
    /// </summary>
    private Task ApplicaComuni() => EseguiAsync(async () =>
    {
        if (_unione is null) return;
        var n = await _editing.ApplicaSezioniComuniAsync(
            _nascondiIn.ToList(), _unione.Members.Select(m => (m.DocumentId, m.Doc.ReleaseTarget)).ToList(),
            _spuntate.ToList());
        // ⚠️ Due chiavi, non un plurale solo: «1 sezioni» sbaglia sempre sull'uno, in tutte e due le lingue —
        // e il progetto non ha ICU. È la stessa regola di `XferLabels`.
        _esito = n == 1 ? Sito["Union_Common_Done_One"] : Sito.Formatta("Union_Common_Done", n);
        _scheda = false;
    });

    private Task Sposta(UnionMemberView m, int delta) =>
        EseguiAsync(() => _unioni.SpostaAsync(m.MemberId, delta));

    private Task Togli(UnionMemberView m) =>
        EseguiAsync(() => _unioni.RimuoviMembroAsync(m.MemberId));

    private Task Sciogli() =>
        EseguiAsync(() => _unione is null ? Task.CompletedTask : _unioni.SciogliAsync(_unione.Id));

    /// <summary>
    /// Un gesto sull'unione: esegue, racconta l'esito, ricarica, e avvisa l'host.
    /// <para>⚠️ L'errore si MOSTRA. Una <c>ValidationException</c> qui dice cose che chi ha premuto deve
    /// sapere — «questo documento è già unito ad altri» col nome di quali — e lasciarla cadere darebbe un
    /// tasto che a volte non fa niente senza dire perché.</para>
    /// </summary>
    private async Task EseguiAsync(Func<Task> gesto)
    {
        if (_busy) return;
        _busy = true;
        _errore = null;
        try
        {
            _esito = null;
            await gesto();
            await RicaricaAsync();
            if (_apriComuniDopoIlCarico)
            {
                _apriComuniDopoIlCarico = false;
                await CaricaComuniAsync();
                // ⚠️ Si apre solo se c'e' DAVVERO qualcosa da chiedere. Fino al 9 settembre 2026 si
                // apriva sempre — «niente da scegliere e' una risposta, il silenzio e' un dubbio» — e
                // andava bene finche' l'unione era vIPI + vSOP dello stesso scalo. Unendo un APP le chiavi
                // in comune non sono ripetizioni: la scheda compariva a ogni unione per non proporre
                // niente, e una scheda che si apre per dire «niente» la seconda volta e' rumore.
                _scheda = _comuni.Count > 0;
            }
            else if (_scheda) await CaricaComuniAsync();
            await Changed.InvokeAsync();
        }
        catch (Vipi.Application.Aor.ValidationException ex) { _errore = ex.Message; }
        // 🔴 Il conflitto di lock si MOSTRA, non fa cadere il circuito: la scheda delle sezioni in comune
        // scrive su documenti che non sono quello della pagina, e un lock scaduto su uno di quelli è un caso
        // normale — non una pagina da riavviare. Senza questa riga il messaggio arrivava a schermo come
        // «Attempting to reconnect».
        catch (EditConflictException ex) { _errore = ex.Message; }
        catch (EditNotAllowedException) { _errore = Sito["PageIntro_NotAllowed"]; }
        finally { _busy = false; }
    }
}
