@* Il CORPO di una vIPI d'aeroporto: le sezioni nell'ordine del documento, con il corpo derivato che questa
   famiglia disegna per chiave.

   Sta fuori da `AeroportoPage` perché lo stesso documento va reso in due posti — la sua pagina, e la pagina
   UNITA che lo mostra insieme ad altri (carta 2026-09-03-documenti-uniti.md).

   ⚠️ Qui c'è SOLO il corpo, non l'indice: `DocumentToc` vive nella cella SORELLA della griglia `doc-layout`.
   Chi monta questo componente monta anche l'indice e deve passargli lo STESSO `AnchorOf` — un'ancora diversa
   manda l'indice su un id che non esiste, e i suoi link non fanno niente senza dare errore.

   ⚠️ `lang` sta sul contenitore del CORPO e non sulla pagina: in una pagina unita due membri possono avere
   lingue di redazione diverse, e il chrome parla comunque la lingua del sito.

   Il ciclo delle sezioni lo fa il componente condiviso (doc 14 §3e), e l'ordine è quello DEL DOCUMENTO.
   Fino alla carta del 26 agosto 2026 la pagina d'aeroporto aveva la sequenza CABLATA (meteo → TA+frequenze
   affiancate → piste → SID → extra) e ritrovava le sezioni con `Title.Contains("transi")`: riordinare,
   nascondere o infilare una sezione libera in mezzo non aveva alcun effetto — il documento poteva dire
   quello che voleva, la pagina disegnava sempre la stessa cosa. *@
@using Vipi.Domain
@using Vipi.Application.Auth
@inject IStringLocalizer<SharedResource> L
@inject IEditAuthorizationService Authz

<div lang="@Doc.Bloccata">
    <DocumentSectionsView Sections="Doc.Sezioni" Profile="SectionProfile.Airport"
                          IsDraft="@(Doc.Mode.Kind == PreviewKind.Draft)"
                          AnchorOf="AnchorOf"
                          ExtraClass="ClasseExtra" HeaderContent="Intestazione"
                          DerivedContent="CorpoDerivato" />
</div>

@code {
    /// <summary>Il documento già caricato: lo prepara <see cref="AirportMemberLoader"/>.</summary>
    [Parameter, EditorRequired] public AirportMemberDocument Doc { get; set; } = default!;

    /// <summary>
    /// Se mostrare la <b>meccanica</b> delle regole piste: quale regola sta vincendo adesso, il suo numero e la
    /// sua nota. Da <c>DivisionStaff</c> in su (decisione del committente, 4 settembre 2026).
    ///
    /// <para>⚠️ Non è il contenuto a essere riservato — la tabella delle regole resta pubblica, è documento
    /// pubblicato. È il <b>collegamento col momento</b>: «sta vincendo la #2» è un numero che, letto da chi non
    /// scrive le regole, non dice niente e sembra un codice.</para>
    ///
    /// <para>⚠️ Questa pagina è SSR STATICA e senza cache d'uscita, quindi il livello si può chiedere qui:
    /// ogni richiesta ha il suo scope di DI e la sua risposta. Se un giorno la pagina finisse dietro una cache,
    /// questo cancello andrebbe rifatto, perché la prima risposta servita sarebbe quella di chiunque.</para>
    /// </summary>
    private bool MeccanicaVisibile => Authz.IsDivisionStaff;

    /// <summary>
    /// Ancora di sezione: «s-{Id}» per TUTTE, anche per quelle rese dalla pagina (doc 13 §3e), così i
    /// deep-link della ricerca — che indicizza per Id — atterrano dove devono e non in cima alla pagina.
    /// <para>⚠️ Pubblica perché <c>DocumentToc</c> deve usare la STESSA.</para>
    /// </summary>
    public static string AnchorOf(SectionView s) => s.Id;

    /// <summary>Il corpo che questa famiglia disegna, per chiave di sezione.</summary>
    private RenderFragment<SectionView> CorpoDerivato => sec => __builder =>
    {
        @switch (sec.SectionKey)
        {
            case "weather": <AirportWeather Icao="@Doc.Icao" Report="Doc.Wx" Metar="Doc.Metar" Taf="Doc.Taf" Lingua="@Doc.Bloccata" />; break;
            case "runwayrules":
                @* ⚠️ Il segno «adesso» è la stessa informazione della provenienza vista da un'altra colonna:
                   dice QUALE regola sta vincendo. Sotto lo staff di divisione la tabella resta — è contenuto
                   pubblicato — ma senza il segno che la lega al momento. *@
                <AirportRunwayRules View="Doc.Derived.Rules"
                                    ActivePosition="@(MeccanicaVisibile && Doc.RuleResult is not null ? Doc.RuleResult.RuleIndex + 1 : null)" />;
                break;
            case "transition":
                <AirportTransition View="Doc.Derived.Transition" CurrentQnh="Doc.Metar?.QnhHpa"
                                   MetarTimeRaw="@Doc.Metar?.TimeRaw" Station="Doc.Station" />;
                break;
            case "frequencies": <AirportFrequencies View="Doc.Derived.Frequencies" />; break;
            case "runways":
                <AirportRunways View="Doc.Derived.Runways" DepIdents="Doc.DepIdents" ArrIdents="Doc.ArrIdents"
                                MostraProvenienza="MeccanicaVisibile"
                                RuleName="@(Doc.RuleResult is null ? null : Doc.RuleResult.RuleName ?? $"#{Doc.RuleResult.RuleIndex + 1}")"
                                RuleNote="@Doc.RuleResult?.Note" WindDir="Doc.WindDir" WindKt="Doc.WindKt"
                                HasRain="@(Doc.Metar?.HasRain == true)" HasSnow="@(Doc.Metar?.HasSnow == true)" />;
                break;
            case "sids":
                <AirportSids View="Doc.Derived.Sids" InitialRunway="@Doc.SidRwy" Lingua="@Doc.Bloccata"
                             DepIdents="Doc.DepIdents.ToArray()" TransitionAltitudeFt="Doc.Derived.Transition.TransitionAltitudeFt" />;
                break;
            case "validity": <ValidityStamp Target="ReleaseTargetType.Airport" Key="@Doc.Icao" ReleaseId="@Doc.ReleaseIdShown" />; break;
        }
    };

    /// <summary>⚠️ Il meteo non va in stampa: è un dato live, e su carta sarebbe un'istantanea già scaduta
    /// quando la si legge. È anche l'unica sezione che non si congela mai.</summary>
    private static string? ClasseExtra(SectionView sec) =>
        sec.SectionKey == "weather" ? "noprint" : null;

    /// <summary>L'intestazione del meteo porta l'emoji, l'ICAO e la nota «live NOAA»: non è decorazione, dice
    /// DI CHI è il tempo che si sta leggendo e che è vivo — le due cose che quella sezione ha da dire prima di
    /// essere aperta. Le altre sezioni hanno il titolo e basta, e per quelle il componente fa da sé.</summary>
    private RenderFragment<SectionView> Intestazione => sec => __builder =>
    {
        @if (sec.SectionKey == "weather")
        {
            <text>🌦️ </text>
            @sec.Title
            <text> · @Doc.Icao </text>
            <span class="muted" style="font-weight:400;font-size:13px">@L["Airport_LiveNoaa"]</span>
        }
        else
        {
            @sec.Title
        }
    };
}
