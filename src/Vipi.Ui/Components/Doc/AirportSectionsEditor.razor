    private IMilitaryDocumentService Militari = default!;

    /// <summary>
    /// Il servizio di editing, risolto dallo scope PROPRIO di questa pagina (<c>OwningComponentBase</c>):
    /// contesto isolato da quello del circuito.
    ///
    /// <para>⚠️ <b>Con <c>@@inject</c> veniva dal circuito</b>, cioè dal <c>DbContext</c> che la sessione
    /// condivide con tutto il resto — barra, isole, pannelli, e il <c>LoadAsync</c> di questa pagina. Basta
    /// che due di quelle operazioni si sovrappongano perché esca
    /// «<c>A second operation was started on this context</c>» e il circuito muoia: a schermo una pagina che
    /// non risponde più, da ricaricare. Vedi <c>DocumentEditorShell.FinishEditingAsync</c>.</para>
    /// </summary>
    private IEditingService Editing = default!;

    protected override void OnInitialized()
    {
        Editing = ScopedServices.GetRequiredService<IEditingService>();
        Militari = ScopedServices.GetRequiredService<IMilitaryDocumentService>();
        Sectors = ScopedServices.GetRequiredService<IAirportSectorService>();
        Profile = ScopedServices.GetRequiredService<IAirportEditingService>();
        _shell = new DocumentEditorShell(Editing, JS, L, Logger, "aeroporto", "Ape_NoEditPerm",
            // ⚠️ Il ridisegno avvisa anche l'OSPITE: in un editor unito la testata (versione, lock) e' sua.
            () => InvokeAsync(async () => { StateHasChanged(); await StatoCambiato.InvokeAsync(); }));
        // ⚠️ Ci si presenta all'ospite SOLO senza chrome: col chrome questa e' una pagina a se', e non c'e'
        // nessun ospite da avvisare. `InvokeAsync` su un gestore sincrono finisce subito, e `Registra` e'
        // idempotente — registrarsi due volte vorrebbe dire prendere due volte lo stesso lock.
        if (!Chrome) _ = Registrati.InvokeAsync(this);

    }

