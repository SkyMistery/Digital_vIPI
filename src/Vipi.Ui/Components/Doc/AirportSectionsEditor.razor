    /// <para>⚠️ Questo e i due che seguono, come <c>Editing</c> qui sotto, si prendono dallo scope
    /// <b>proprio</b>: con <c>@@inject</c> verrebbero dal <c>DbContext</c> del <b>circuito</b>, condiviso
    /// con barra, isole e pannelli. È il difetto che il 3 settembre 2026 ha prodotto in produzione nove
    /// pagine d'errore da due componenti gemelli di questo — e la guardia che avrebbe dovuto vederli
    /// guardava un nome solo.</para>
    /// </summary>
    private IAirportEditingService Profile = default!;

