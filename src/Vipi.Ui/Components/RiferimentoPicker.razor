@* Il selettore dei RIFERIMENTI da citare nel testo: le procedure (§A73, §A80) e i dati — frequenze e
   nominativi (carta docs/feature/2026-09-20-riferimenti-ai-dati.md).
   Lo aprono il tasto della barra di formattazione (prosa) e quello sotto una tabella (celle): chi lo apre ha
   già segnato il campo di destinazione (`vipiSidPrendi`), qui si sceglie e basta.

   ⚠️ UN selettore per tutte le famiglie, con le chip: il gesto è lo stesso — «cito qualcosa che vive
   nell'archivio» — e quattro tasti in barra sarebbero quattro decisioni prima ancora di aprire l'elenco.

   ⚠️ Scope DI proprio, non @inject: il selettore si apre dentro un editor che salva a ogni gesto, e due query
   sullo stesso DbContext di circuito sono il guasto «second operation» già pagato. E `ScopeProprioCheAspetta`,
   non `OwningComponentBase`: una scelta fatta mentre l'elenco sta arrivando SMONTA il selettore, e senza l'attesa
   lo scope si porterebbe via il DbContext sotto la query (la «terza porta», TerzaPortaTests).

   ⚠️ L'elenco delle procedure è la tabella VIVA dello scalo — quella che la bozza mostra —, una voce per nome:
   una SID su due piste è una voce sola. Nel testo va il riferimento, e il valore che il lettore vedrà si decide
   al disegno. *@
@using Microsoft.Extensions.DependencyInjection
@inherits ScopeProprioCheAspetta
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="sidref-pick" role="dialog" aria-label="@L["Sid_Pick_Title"]" @onkeydown="Tasto">
    <div class="sidref-pick-head">
        <b>@L["Sid_Pick_Title"]</b>
        @* L'ICAO serve a quel che vive DENTRO uno scalo — procedure e piste; gli enti si cercano per
           callsign, che è già unico, e i punti sono di tutta la divisione. *@
        @if (ServeIcao)
        {
            <input class="app-in icao" maxlength="4" placeholder="ICAO" aria-label="ICAO"
                   value="@_icao" @onchange="CambiaIcao" />
        }
        @* Che cosa si cita. Chip e non tasti in barra: il gesto è lo stesso, e quel che cambia sta dentro il
           selettore, dove si sta già guardando un elenco. *@
        <div class="sidref-pick-kind" role="group" aria-label="@L["Sid_Pick_Kind"]">
            @foreach (var f in Famiglie)
            {
                var scelta = f;
                <button type="button" class="sh-chip @(_famiglia == scelta ? "on" : "")"
                        aria-pressed="@((_famiglia == scelta).ToString().ToLowerInvariant())"
                        @onclick="() => CambiaFamiglia(scelta)">@scelta.Parola</button>
            }
        </div>
        <input class="app-in cerca" placeholder="@L["Sid_Pick_Search"]" aria-label="@L["Sid_Pick_Search"]"
               @ref="_cerca" @bind="_filtro" @bind:event="oninput" @onkeydown="InvioSceglie" />
        <button type="button" class="btn ghost" @onclick="OnChiudi">@L["Common_Close"]</button>
    </div>
    @{ var trovate = Filtrate; }
    @if (ServeIcao && _icao.Length != 4)
    {
        <p class="muted" style="margin:0">@L["Sid_Pick_NeedIcao"]</p>
    }
    else if (_caricando)
    {
        <p class="muted" style="margin:0">…</p>
    }
    else if (trovate.Count == 0)
    {
        <p class="muted" style="margin:0">@string.Format(L["Sid_Pick_None"].Value, ServeIcao ? _icao : _famiglia.Parola)</p>
    }
    else
    {
        <div class="sidref-pick-list">
            @* ⚠️ Non si disegnano tutte: il catalogo dei PUNTI è di tutta la divisione — migliaia di voci —
               e un elenco così lungo non si scorre, si cerca. Le famiglie legate a uno scalo non arrivano
               nemmeno vicino al tetto (misurato: 206 SID a LIRF, il massimo dell'archivio). *@
            @foreach (var v in trovate.Take(MaxVoci))
            {
                var voce = v;
                <button type="button" class="sidref-pick-row" title="@voce.Riferimento"
                        @onclick="() => OnScegli.InvokeAsync(voce.Riferimento)">
                    <span>@voce.Etichetta</span><span class="rwy">@voce.Dettaglio</span>
                </button>
            }
        </div>
        @if (trovate.Count > MaxVoci)
        {
            <p class="muted" style="margin:0">@string.Format(L["Sid_Pick_TooMany"].Value, MaxVoci)</p>
        }
    }
</div>

@code {
    /// <summary>Una voce dell'elenco, qualunque famiglia sia: quel che si legge, quel che si scrive.</summary>
    /// <param name="Riferimento">Il testo che finisce nel campo, <c>[[SID LIRF OST1E]]</c> o <c>[[FREQ LIRF_TWR]]</c>.</param>
    /// <param name="Etichetta">Come si legge nell'elenco: il nome esteso, o il callsign.</param>
    /// <param name="Dettaglio">La colonna di destra: le piste, o la frequenza.</param>
    private sealed record Voce(string Riferimento, string Etichetta, string Dettaglio);

    /// <summary>Una famiglia citabile: la parola della chip e come si costruisce il suo elenco.</summary>
    /// <param name="ConIcao">Vero se quel che si cita vive DENTRO uno scalo, e quindi serve l'ICAO.</param>
    private sealed record Famiglia(string Parola, ProcedureKind? Procedura = null, TipoDato? Dato = null,
        bool ConIcao = false);

    /// <summary>
    /// Le otto famiglie, nell'ordine delle chip (sei fino al 21 settembre 2026, quando sono entrate POS e AREA).
    /// ⚠️ <b>Tutte, non quattro</b>: fino al 20 settembre 2026
    /// piste e punti si risolvevano, si segnalavano quando sparivano e non si potevano <b>inserire</b> — si
    /// scrivevano a mano, che è precisamente il modo di sbagliare la chiave e farsi dire dalla testata che un
    /// dato che c'è «non si trova più».
    /// </summary>
    private static readonly Famiglia[] Famiglie =
    {
        new("SID", Procedura: ProcedureKind.Sid, ConIcao: true),
        new("STAR", Procedura: ProcedureKind.Star, ConIcao: true),
        new("FREQ", Dato: TipoDato.Frequenza),
        new("ATC", Dato: TipoDato.Nominativo),
        // ⚠️ Accanto ad ATC, non in fondo: sono la stessa postazione vista in due modi — «Roma Radar» e
        // «LIRR_NE» — e chi cerca l'una deve vedere che c'è l'altra. Chiesta dal campo il 21 settembre 2026.
        new("POS", Dato: TipoDato.Postazione),
        new("RWY", Dato: TipoDato.Pista, ConIcao: true),
        new("FIX", Dato: TipoDato.Punto),
        // Le aree regolamentate (21 settembre 2026, committente): di tutta la divisione come i punti, quindi
        // senza ICAO; in pagina esce il nome di oggi.
        new("AREA", Dato: TipoDato.Area),
    };

    /// <summary>Quante voci si disegnano al massimo. Vedi la nota nell'elenco.</summary>
    private const int MaxVoci = 300;

    /// <summary>Lo scalo del documento, se il documento ne ha uno (vIPI d'aeroporto, vSOP militare). Vuoto =
    /// l'ultimo usato, che il browser ricorda.</summary>
    [Parameter] public string? IcaoIniziale { get; set; }

    /// <summary>Il testo del riferimento scelto: è tutto quel che serve a chi lo inserisce.</summary>
    [Parameter] public EventCallback<string> OnScegli { get; set; }
    [Parameter] public EventCallback OnChiudi { get; set; }

    /// <summary>La famiglia che si sta citando. Nasce sulle partenze: sono la stragrande maggioranza dei
    /// riferimenti scritti, e chi cita altro lo sa e cambia chip.</summary>
    private Famiglia _famiglia = Famiglie[0];

    /// <summary>Vero se la famiglia in corso vive dentro uno scalo, e quindi il campo ICAO conta.</summary>
    private bool ServeIcao => _famiglia.ConIcao;

    private async Task CambiaFamiglia(Famiglia f)
    {
        if (_famiglia == f) return;
        _famiglia = f;
        await CaricaAsync();
    }

    private const string ChiaveIcao = "vipi.sid.icao";

    private string _icao = "";
    private string _filtro = "";
    private bool _caricando;
    private IReadOnlyList<Voce> _elenco = Array.Empty<Voce>();
    private ElementReference _cerca;

    private IProcedureReferenceResolver Procedure => ScopedServices.GetRequiredService<IProcedureReferenceResolver>();
    private IFrequenzeDegliEnti Enti => ScopedServices.GetRequiredService<IFrequenzeDegliEnti>();

    private IReadOnlyList<Voce> Filtrate =>
        string.IsNullOrWhiteSpace(_filtro)
            ? _elenco
            : _elenco.Where(v => v.Etichetta.Contains(_filtro.Trim(), StringComparison.OrdinalIgnoreCase)
                              || v.Riferimento.Contains(_filtro.Trim(), StringComparison.OrdinalIgnoreCase)
                              || v.Dettaglio.Contains(_filtro.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var icao = RiferimentiProcedura.Norm(IcaoIniziale);
        if (icao.Length != 4)
            icao = RiferimentiProcedura.Norm(await JS.InvokeAsync<string?>("vipiStoreGet", ChiaveIcao));
        await CaricaAsync(icao);
        // 🔴 Chiuso mentre caricava (doppio clic sul tasto, Esc): il campo di ricerca non c'è più, e il fuoco su un
        // elemento sparito alza un'eccezione JS che, uscita da qui, chiude il circuito (revisione del 18 settembre 2026).
        if (Chiusa) return;
        StateHasChanged();
        try { await _cerca.FocusAsync(); }
        catch (JSException) { }                  // sparito fra il disegno e il fuoco: niente da mettere a fuoco
        catch (InvalidOperationException) { }    // riferimento non ancora legato: stessa risposta
    }

    private Task CambiaIcao(ChangeEventArgs e) => CaricaAsync(RiferimentiProcedura.Norm(e.Value as string));

    /// <summary>Ricarica quel che c'è già: serve al cambio di famiglia.</summary>
    private Task CaricaAsync() => CaricaAsync(_icao);

    private async Task CaricaAsync(string icao)
    {
        _icao = icao;
        _elenco = Array.Empty<Voce>();
        if (ServeIcao && icao.Length != 4) return;
        _caricando = true;
        try
        {
            await InFilaAsync(async () =>
            {
                _elenco = _famiglia.Procedura is { } verso
                    ? await ProcedureAsync(icao, verso)
                    : _famiglia.Dato!.Value switch
                    {
                        TipoDato.Pista => await PisteAsync(icao),
                        TipoDato.Punto => await PuntiAsync(),
                        TipoDato.Area => await AreeAsync(),
                        var tipo => await EntiAsync(tipo),
                    };
            });
            if (Chiusa) return;
            if (ServeIcao) await JS.InvokeVoidAsync("vipiStoreSet", ChiaveIcao, icao);
        }
        finally { _caricando = false; }
    }

    /// <summary>
    /// Le soglie dello scalo, dalla sua anagrafica. ⚠️ Escono <b>come sono scritte</b>: la chiave di una
    /// pista è il suo valore, e un rinomino per deriva magnetica non si indovina (vedi <c>RiferimentiDato</c>).
    /// </summary>
    private async Task<IReadOnlyList<Voce>> PisteAsync(string icao)
    {
        var piste = await Enti.PisteAsync(new[] { icao });
        if (!piste.TryGetValue(icao, out var soglie)) return Array.Empty<Voce>();
        return soglie
            .Select(p => new Voce(RiferimentiDato.Scrivi(TipoDato.Pista, $"{icao} {p}"), p, icao))
            .ToList();
    }

    /// <summary>
    /// I punti del catalogo della divisione. Sono migliaia e non hanno uno scalo: si trovano cercando, ed è
    /// per loro che l'elenco ha un tetto.
    /// </summary>
    private async Task<IReadOnlyList<Voce>> PuntiAsync() =>
        (await Enti.PuntiAsync())
            .OrderBy(p => p, StringComparer.Ordinal)
            .Select(p => new Voce(RiferimentiDato.Scrivi(TipoDato.Punto, p), p, ""))
            .ToList();

    /// <summary>
    /// Le aree regolamentate, per nome. A destra il tipo e i centri che le elencano: due aree con nomi simili
    /// si distinguono lì, e chi scrive la vIPI di un ACC riconosce le sue.
    /// </summary>
    private async Task<IReadOnlyList<Voce>> AreeAsync() =>
        (await Enti.AreeAsync())
            .Select(a => new Voce(RiferimentiDato.Scrivi(TipoDato.Area, a.IvaoId), a.Name,
                string.Join(" · ", new[] { a.Type ?? "", a.CentersText }.Where(x => x.Length > 0))))
            .ToList();

    private async Task<IReadOnlyList<Voce>> ProcedureAsync(string icao, ProcedureKind kind) =>
        (await Procedure.ElencoAsync(icao, kind))
            .Select(p => new Voce(p.Riferimento, p.Esteso, p.Piste)).ToList();

    /// <summary>
    /// Gli enti con frequenza. ⚠️ Lo scalo del documento PRIMA: chi scrive la vIPI di LIRF cita quasi sempre un
    /// ente di LIRF, e farglielo cercare in mezzo a tutta la divisione sarebbe un elenco lungo per niente.
    /// </summary>
    private async Task<IReadOnlyList<Voce>> EntiAsync(TipoDato tipo)
    {
        // ⚠️ Due domande diverse, e non una sola come fino al 20 settembre 2026: le FREQUENZE sono i settori
        // che ne hanno una dichiarata, i NOMINATIVI sono tutti — un ente senza frequenza ha comunque un nome
        // alla radio, e chiedendolo all'elenco delle frequenze non si poteva citare.
        // POS è la stessa domanda di ATC con le due colonne scambiate: l'etichetta è il codice, il dettaglio il
        // nominativo — così nell'elenco si riconosce la postazione da tutti e due i lati.
        var righe = tipo switch
        {
            TipoDato.Nominativo => (await Enti.NominativiAsync()).Select(e => (e.Icao, e.Callsign,
                Etichetta: string.IsNullOrWhiteSpace(e.AtcCallsign) ? e.Callsign : e.AtcCallsign!,
                Dettaglio: e.Callsign)),
            TipoDato.Postazione => (await Enti.NominativiAsync()).Select(e => (e.Icao, e.Callsign,
                Etichetta: e.Callsign,
                Dettaglio: string.IsNullOrWhiteSpace(e.AtcCallsign) ? "" : e.AtcCallsign!)),
            _ => (await Enti.TutteAsync()).Select(f => (f.Icao, f.Callsign,
                Etichetta: f.Callsign, Dettaglio: f.FrequencyMhz)),
        };

        var mio = RiferimentiProcedura.Norm(IcaoIniziale);
        return righe
            .OrderByDescending(r => mio.Length == 4 && string.Equals(r.Icao, mio, StringComparison.OrdinalIgnoreCase))
            .ThenBy(r => r.Callsign, StringComparer.Ordinal)
            .Select(r => new Voce(RiferimentiDato.Scrivi(tipo, r.Callsign), r.Etichetta, r.Dettaglio))
            .ToList();
    }

    // Esc chiude, da qualunque punto del pannello.
    private async Task Tasto(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnChiudi.InvokeAsync();
    }

    // Invio nella ricerca sceglie la prima voce che resta: cercando «BANAV 9» si arriva con due tasti.
    // ⚠️ Solo nella ricerca: nel campo ICAO l'Invio conferma lo scalo, e sceglierebbe dall'elenco VECCHIO.
    private async Task InvioSceglie(KeyboardEventArgs e)
    {
        var trovate = Filtrate;
        if (e.Key == "Enter" && trovate.Count > 0) await OnScegli.InvokeAsync(trovate[0].Riferimento);
    }
}
