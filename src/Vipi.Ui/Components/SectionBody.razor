@* Corpo di una sezione documentale CONDIVISO (doc 11 §3b): blocchi e sotto-sezioni in UNA fila.

   ⚠️ Dal 15 settembre 2026 il corpo non è più a tre scomparti fissi — sotto-sezioni «prima» → blocchi →
   sotto-sezioni «dopo» (doc 11 §3g) — ma una fila dove si alternano (committente: «sottosezione, blocco,
   sottosezione, blocco»). L'ordine lo decide `CorpoDiSezione`, lo stesso che usa l'editor: una fusione
   scritta due volte sarebbe un editor che dice una cosa e un documento che ne mostra un'altra.

   Lo usa SectionNode (che aggiunge la card o il <details>) e lo usano i viewer che l'involucro se lo fanno da
   sé. Le sezioni rese dalla PAGINA passano la loro scheda in `Scheda`: sta dopo le figlie «in testa» e prima
   di tutto il resto. Con `ShowBlocks="false"` i blocchi non entrano nella fila (il blocco di una derivata
   porta il payload JSON, non contenuto). *@

@foreach (var voce in CorpoDiSezione.Componi(
              ShowBlocks ? Blocchi() : Array.Empty<(BlockView Blocco, int Ordine)>(), b => b.Ordine,
              Section.Children, c => CorpoDiSezione.Soglia(c.BodyPosition, c.BeforeParentBody),
              conScheda: Scheda is not null))
{
    @switch (voce.Tipo)
    {
        case TipoVoce.Scheda:
            @Scheda
            break;
        case TipoVoce.Figlia:
            <SectionNode Section="voce.Figlia!" DepthOffset="DepthOffset" IsDraft="IsDraft"
                         Profile="Profile" DerivedContent="DerivedContent" />
            break;
        case TipoVoce.Blocco:
            var block = voce.Blocco.Blocco;
            @if (block.State == RenderState.Collapsed)
            {
                <details class="collapsed-strip">
                    <summary>@(block.CollapseLabel ?? "Contenuto compresso — espandi")</summary>
                    <BlockRenderer Block="block" />
                </details>
            }
            else
            {
                <BlockRenderer Block="block" />
            }
            break;
    }
}

@code {
    [Parameter, EditorRequired] public SectionView Section { get; set; } = default!;

    /// <summary>Profilo di catalogo, passato alle sotto-sezioni: senza, una sotto-sezione resa dalla PAGINA
    /// non saprebbe di esserlo e uscirebbe come un titolo vuoto (vedi l'avviso su <c>SectionNode</c>).</summary>
    [Parameter] public SectionProfile? Profile { get; set; }

    /// <summary>Il corpo che la pagina disegna, passato alle sotto-sezioni insieme al profilo.</summary>
    [Parameter] public RenderFragment<SectionView>? DerivedContent { get; set; }

    /// <summary>Rende i blocchi della sezione. False per le sezioni derivate (blocco = payload, non contenuto).</summary>
    [Parameter] public bool ShowBlocks { get; set; } = true;

    /// <summary>La scheda che la pagina disegna per QUESTA sezione, se è resa dalla pagina. Null = nessuna.</summary>
    [Parameter] public RenderFragment? Scheda { get; set; }

    /// <summary>Vista bozza: si passa alle sotto-sezioni, che senza non saprebbero se una nascosta va
    /// mostrata marcata o tolta. Default <c>false</c> = comportamento pubblico, che è il prudente.</summary>
    [Parameter] public bool IsDraft { get; set; }

    /// <summary>Scostamento di profondità per la resa delle sotto-sezioni: la vIPI ACC ospita le sezioni a
    /// <c>Depth 1</c> (figlie della sezione-blocco) ma le mostra come sezioni di primo livello, quindi passa -1.</summary>
    [Parameter] public int DepthOffset { get; set; }

    /// <summary>I blocchi col loro <c>Order</c>. ⚠️ Una vista costruita a mano (i test, le proiezioni che non
    /// lo conoscono) porta 0: allora vale la posizione nella lista, che è l'ordine in cui arrivano.</summary>
    private IReadOnlyList<(BlockView Blocco, int Ordine)> Blocchi() =>
        Section.Blocks.Select((b, i) => (b, b.Order > 0 ? b.Order : i + 1)).ToList();
}
