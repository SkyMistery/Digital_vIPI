@* Una riga di «Da fare», e UNA SOLA volta: la usano l'elenco (/services/vsop/tasks), il banner in cima
   all'editor e la sezione «Documenti da rivedere» di «Da sistemare». Tre resi diversi della stessa riga
   sarebbero tre racconti che iniziano a divergere — ed è esattamente ciò che questa carta esiste per non
   rifare (docs/feature/2026-08-26-da-fare-una-lista-sola.md §1).

   ⚠️ La frase si compone QUI da chiave + argomenti, e non arriva mai come testo: una riga scritta in
   italiano si ripresenterebbe in italiano a chi legge in inglese, e il circuito Blazor cambia lingua senza
   ricaricare. L'unica eccezione è il titolo di un incarico, che l'ha scritto una persona: lo dice
   WorkPhrases.Raw. *@
@inject IStringLocalizer<SharedResource> L

<li class="wi wi-@Item.Severita.ToString().ToLowerInvariant()">
    <span class="wi-badge">@Pastiglia()</span>

    <span class="wi-body">
        <span class="wi-doc">
            @if (Item.SiRaggiunge)
            {
                <a href="@Item.Url" title="@L["Work_OpenTitle"]">@Item.Titolo</a>
            }
            else
            {
                <span title="@L["Work_NoLink"]">@Item.Titolo</span>
            }
            @if (Item.AccCode is { Length: > 0 } acc && ShowAcc)
            {
                <span class="muted wi-acc">@acc</span>
            }
        </span>
        <span class="wi-why">@Frase()</span>
        @if (Item.Origine == WorkOrigin.Persona && Item.AssegnatarioNome is { Length: > 0 } chi)
        {
            <span class="muted wi-who">@L["Work_AssignedTo", chi]@(Item.ScadenzaCiclo is { Length: > 0 } c ? $" · {c}" : "")</span>
        }
    </span>

    <span class="wi-act">
        @* Il tasto che la riga PROMETTE. Non è una decorazione: su una riga calcolata un ✓ sarebbe una
           promessa che il giro notturno smentisce entro stanotte (carta §2/D3). *@
        @switch (Item.Azione)
        {
            case WorkAction.SegnaFatto:
                <button type="button" class="btn ghost" disabled="@Busy" title="@L["Review_MarkTitle"]"
                        @onclick="() => OnDone.InvokeAsync(Item)">✓ @L["Review_MarkReviewed"]</button>
                break;

            case WorkAction.Ripubblica:
                @if (Item.SiRaggiunge)
                {
                    <a class="btn ghost" href="@($"{Item.Url}#sec-versioni")">@L["Work_Republish"]</a>
                }
                break;

            case WorkAction.VaiASistemare:
                @if (Item.SiRaggiunge)
                {
                    <a class="btn ghost" href="@Item.Url">@L["Work_GoFix"]</a>
                }
                else
                {
                    <a class="btn ghost" href="/services/vsop/versions">@L["Work_GoFix"]</a>
                }
                break;

            case WorkAction.CambiaStato:
                @if (Item.Stato is EditorTaskStatus.Todo)
                {
                    <button type="button" class="btn ghost" disabled="@Busy"
                            @onclick="() => OnStart.InvokeAsync(Item)">@L["Task_Start"]</button>
                }
                <button type="button" class="btn ghost" disabled="@Busy"
                        @onclick="() => OnDone.InvokeAsync(Item)">✓ @L["Task_Done"]</button>
                break;
        }

        @* «Prendi in carico»: da fatto del sistema a impegno di una persona. Solo sulle righe di sistema —
           un incarico un assegnatario ce l'ha già. *@
        @if (ShowAssign && Item.Origine == WorkOrigin.Sistema && Item.ImpactId is int)
        {
            <button type="button" class="btn ghost @(_assegna ? "on" : "")" disabled="@Busy"
                    title="@L["Work_AssignTitle"]" @onclick="ApriAssegna">@L["Work_Assign"]</button>
        }
    </span>

    @* ---- A chi, ed entro quando ----------------------------------------------------------------
       Sta DENTRO la riga e non in una finestra: assegnare è un gesto di scorrimento — si guarda l'elenco,
       si distribuisce — e una modale per ogni riga farebbe perdere il posto ogni volta. Compare solo sulla
       riga su cui si è premuto: lo stato è del componente, e ogni riga è un componente.
       ⚠️ L'assegnatario nasce su ME: «me ne occupo io» è il caso frequente, e chi vuole dare il lavoro a
       un altro lo cambia. Il contrario — una tendina vuota da riempire sempre — costa un gesto a ogni riga. *@
    @if (_assegna)
    {
        <span class="wi-assign">
            <label>
                @L["Work_AssignTo"]
                <select class="app-in" @bind="_chi" disabled="@Busy">
                    @if (MyUserId is int io)
                    {
                        <option value="@io">@L["Work_AssignMe"]</option>
                    }
                    @foreach (var m in Roster.Where(m => m.UserId != MyUserId))
                    {
                        <option value="@m.UserId">@NomeRoster(m)</option>
                    }
                </select>
            </label>
            <label>
                @L["Work_AssignDue"]
                <select class="app-in" @bind="_entro" disabled="@Busy">
                    <option value="">@L["Tasks_NoDue"]</option>
                    @foreach (var c in Cycles)
                    {
                        <option value="@c.Cycle">@c.Cycle</option>
                    }
                </select>
            </label>
            <button type="button" class="btn primary" disabled="@(Busy || _chi <= 0)"
                    @onclick="Conferma">@L["Work_AssignConfirm"]</button>
            <button type="button" class="btn ghost" disabled="@Busy"
                    @onclick="() => _assegna = false">@L["Common_Cancel"]</button>
        </span>
    }
</li>

@code {
    [Parameter, EditorRequired] public WorkItem Item { get; set; } = default!;

    /// <summary>Mostra il codice ACC accanto al titolo: serve in elenco, non nel banner di un documento
    /// (lì l'ACC è quella della pagina che si sta guardando, e ripeterla è rumore).</summary>
    [Parameter] public bool ShowAcc { get; set; } = true;

    /// <summary>Offri «prendi in carico». Solo a chi può assegnare lavoro.</summary>
    [Parameter] public bool ShowAssign { get; set; }

    /// <summary>Gli staffisti a cui si può dare il lavoro. Vuoto = si può assegnare solo a sé stessi, che è
    /// il caso di un roster ancora da popolare (ci si entra al primo login).</summary>
    [Parameter] public IReadOnlyList<StaffRosterEntry> Roster { get; set; } = Array.Empty<StaffRosterEntry>();

    /// <summary>I cicli AIRAC proponibili come scadenza.</summary>
    [Parameter] public IReadOnlyList<AiracCycleInfo> Cycles { get; set; } = Array.Empty<AiracCycleInfo>();

    /// <summary>Chi sta guardando: è l'assegnatario predefinito.</summary>
    [Parameter] public int? MyUserId { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<WorkItem> OnDone { get; set; }
    [Parameter] public EventCallback<WorkItem> OnStart { get; set; }

    /// <summary>Chiede di trasformare la riga in un incarico: a chi, ed entro quando.</summary>
    [Parameter] public EventCallback<WorkAssignRequest> OnAssign { get; set; }

    private bool _assegna;
    private int _chi;
    private string _entro = "";

    private void ApriAssegna()
    {
        _assegna = !_assegna;
        if (!_assegna) return;
        _chi = MyUserId ?? 0;
        _entro = "";
    }

    private async Task Conferma()
    {
        var nome = _chi == MyUserId
            ? null   // il nome di chi preme lo sa già il servizio: è l'utente corrente
            : Roster.FirstOrDefault(m => m.UserId == _chi)?.DisplayName;

        await OnAssign.InvokeAsync(new WorkAssignRequest(
            Item, _chi, nome, string.IsNullOrWhiteSpace(_entro) ? null : _entro));
        _assegna = false;
    }

    /// <summary>Il VID accanto al nome, perché due staffisti possono chiamarsi uguale — e chi non ha ancora
    /// un nome nel roster si riconosce dal solo VID.</summary>
    private static string NomeRoster(StaffRosterEntry m) =>
        string.IsNullOrWhiteSpace(m.DisplayName) ? $"VID {m.UserId}" : $"{m.DisplayName} · {m.UserId}";

    /// <summary>La pastiglia dice in una parola PERCHÉ la riga è lì, e il colore quanto urge.</summary>
    private RenderFragment Pastiglia() => builder =>
    {
        var (classe, chiave, titolo) = Item.Severita switch
        {
            WorkSeverity.GiaInPubblico => ("red", "Impact_PublicNow", "Impact_PublicNowTitle"),
            WorkSeverity.Rotto => ("amber", "Impact_Broken", "Impact_Broken"),
            WorkSeverity.InRitardo => ("amber", "Tasks_Overdue", "Tasks_Overdue"),
            WorkSeverity.DaRipubblicare => ("blue", "Impact_Republish", "Impact_RepublishTitle"),
            @* ⚠️ Il colore è lo stesso della riga precedente e la parola no: l'atto che le chiude è lo
               stesso — si pubblica — ma qui non è rotto niente, c'è una SCADENZA. Un colore più acceso
               direbbe che urge come quella sopra, uno spento che si può ignorare. *@
            WorkSeverity.DaPreparare => ("blue", "Impact_Prepare", "Impact_PrepareTitle"),
            WorkSeverity.DaRileggere => ("", "Impact_ToReview", "Impact_ToReview"),
            _ => ("", "Work_Task", "Work_Task"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"pill {classe}".TrimEnd());
        builder.AddAttribute(2, "title", L[titolo].Value);
        builder.AddContent(3, L[chiave].Value);
        builder.CloseElement();
    };

    /// <summary>
    /// La frase della riga: chiave + argomenti, mai testo salvato (una riga scritta in italiano si
    /// ripresenterebbe in italiano a chi legge in inglese).
    ///
    /// <para>⚠️ Gli argomenti si passano <b>tutti</b>. Il <c>switch</c> che stava qui si fermava a due e
    /// l'ultimo ramo buttava via il resto: una frase con tre segnaposto — «l'aeroporto {0} è passato da {1} a
    /// {2}» — alzava <c>FormatException</c> e, siccome questa riga si disegna dentro il banner dell'editor,
    /// non rompeva la riga: <b>non faceva partire la pagina</b>. Preso guidando l'editor d'aeroporto il
    /// 5 settembre 2026, con la suite verde.</para>
    /// </summary>
    private string Frase() =>
        Item.FraseKey == WorkPhrases.Raw
            ? (Item.FraseArgs.Count > 0 ? Item.FraseArgs[0] : "")
            : Item.FraseArgs.Count == 0
                ? L[Item.FraseKey].Value
                : L[Item.FraseKey, Item.FraseArgs.Cast<object>().ToArray()].Value;
}
