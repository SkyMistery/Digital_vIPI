@* Editor di UN blocco allegato, condiviso dai due editor di blocchi (DocumentSectionsEditor sul documento,
   DocumentBlocksEditor sulle sezioni extra): il codice nuovo di questa feature vive qui una volta sola.
   L'host possiede la persistenza — riceve il JSON del riferimento e la nota via callback e li salva come sa.
   È la stessa forma di ImageBlockEditor.

   ⚠️ Si SCEGLIE da un elenco, non si incolla un link. La biblioteca è il posto in cui un allegato entra: se
   di qui si potesse incollare un URL, il registro «chi cita cosa» direbbe il falso il giorno dopo — ed è
   esattamente il difetto che questa feature esiste per chiudere.

   ⚠️ Il titolo si scrive nel blocco: è una decisione editoriale del documento, non una copia della
   biblioteca. Rinominare una voce non deve riscrivere il testo dei documenti che la citano. *@
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IStringLocalizer<SharedResource> L

<div class="att-edit">
    @* La lettura della biblioteca è fallita: si dice, invece di lasciare una tendina vuota che sembra una
       biblioteca vuota. ⚠️ Non è un caso teorico — vedi il commento su `_caricamento`. *@
    @if (_errore is not null)
    {
        <p class="help"><b>@L["Common_Error"]</b>@_errore</p>
    }
    <label class="att-field">
        <span class="muted">@L["Att_BlockPick"]</span>
        <select class="app-in" value="@Riferimento?.Slug" @onchange="e => ScegliAsync(e.Value as string)">
            <option value="">@L["Att_BlockNone"]</option>
            @foreach (var v in _voci)
            {
                <option value="@v.Slug">@v.Title</option>
            }
        </select>
    </label>

    @if (Riferimento is { } r)
    {
        <label class="att-field">
            <span class="muted">@L["Att_BlockLabel"]</span>
            <input class="app-in" value="@r.Title" placeholder="@L["Att_BlockLabelPh"]"
                   @onchange="e => TitoloAsync(e.Value as string)" />
        </label>

        <div class="att-row">
            <label class="att-field">
                <span class="muted">@L["Att_BlockMode"]</span>
                <select class="app-in" value="@r.Mode" @onchange="e => ModoAsync(e.Value as string)">
                    @foreach (var m in Enum.GetValues<AttachmentDisplayMode>())
                    {
                        <option value="@m">@L["AttMode_" + m]</option>
                    }
                </select>
            </label>

            @* L'altezza compare solo dove conta: un campo che c'è ma non fa niente si compila lo stesso, e
               poi qualcuno si chiede perché non è cambiato niente. *@
            @if (r.Mode == AttachmentDisplayMode.Embedded)
            {
                <label class="att-field">
                    <span class="muted">@L["Att_BlockHeight"]</span>
                    <select class="app-in" value="@r.Height" @onchange="e => AltezzaAsync(e.Value as string)">
                        @foreach (var h in Enum.GetValues<AttachmentEmbedHeight>())
                        {
                            <option value="@h">@L["AttHeight_" + h]</option>
                        }
                    </select>
                </label>
            }
        </div>

        @* L'anteprima è il componente vero, non un facsimile: quel che si vede qui è quel che leggerà chi
           apre il documento — riquadro incorporato compreso. *@
        <div class="att-preview"><AttachmentLink Reference="r" Note="@Note" /></div>
    }
    else if (_voci.Count == 0 && _errore is null)
    {
        @* Il catch-22 al contrario: senza questa riga, chi apre l'editor e non trova niente in tendina non ha
           modo di sapere che il posto da cui si comincia è un'altra pagina.
           ⚠️ Ma NON quando la lettura è fallita: «la biblioteca è vuota, caricane uno» manderebbe a caricare
           un allegato che c'è già, e la pagina degli allegati lo direbbe. Una tendina vuota per un guasto e
           una vuota per davvero sono due cose diverse, e vanno dette diverse. *@
        <p class="help">@L["Att_BlockEmptyHint"]</p>
    }
</div>

@code {
    /// <summary>JSON del riferimento (<see cref="AttachmentRef"/>): sta in <c>BodyJson</c> nel documento e in
    /// <c>ExtraBlock.AttachmentJson</c> negli extra — stessa stringa.</summary>
    [Parameter] public string? AttachmentJson { get; set; }
    [Parameter] public EventCallback<string?> AttachmentJsonChanged { get; set; }

    /// <summary>La nota sotto il link, markdown come la prosa.</summary>
    [Parameter] public string? Note { get; set; }

    private IReadOnlyList<AttachmentRow> _voci = Array.Empty<AttachmentRow>();

    private AttachmentRef? Riferimento => AttachmentRef.Parse(AttachmentJson);

    // ⚠️ La biblioteca si risolve dallo scope PROPRIO (OwningComponentBase): una lettura di questo componente
    // non deve passare per il DbContext condiviso del circuito, o due operazioni concorrenti lo fanno
    // esplodere. Stessa ragione di ImageBlockEditor.
    // ⚠️ Ma lo scope proprio protegge dal contesto DEL CIRCUITO, non da SÉ STESSI: due letture di QUESTO
    // componente in volo insieme collidono sul suo contesto, ed è esattamente quel che è successo in
    // produzione il 2 settembre 2026. La serializzazione sta in `_caricamento`, non qui.
    private IAttachmentLibrary Biblioteca => ScopedServices.GetRequiredService<IAttachmentLibrary>();

    /// <summary>
    /// La lettura della biblioteca, <b>memorizzata come compito</b> e non come esito.
    ///
    /// <para>⚠️ <b>Qui c'era la corsa che ha abbattuto tre circuiti in produzione</b> il 2 settembre 2026
    /// (1.4.1, `diagnostica/errori-richieste.txt`: quindici voci, tutte con questi due fotogrammi). La
    /// guardia era <c>if (_voci.Count == 0)</c>, cioè si controllava <b>prima</b> dell'<c>await</c> e si
    /// scriveva <b>dopo</b>: <c>OnParametersSetAsync</c> scatta a <b>ogni</b> ridisegno del genitore, e
    /// finché la prima lettura era in volo <c>_voci</c> restava vuota — quindi ogni ridisegno ne faceva
    /// partire un'altra <b>sullo stesso <c>DbContext</c></b>. La fotografia delle collisioni lo mostra a
    /// occhio nudo: <b>quattro</b> SELECT identiche sulla tabella allegati aperte insieme, a 53, 39, 36 e 35
    /// ms. Poi il resto a cascata — il renderer che si corrompe («unsupported frame type during diffing:
    /// None») e le <c>ObjectDisposedException</c> di chi arriva mentre il circuito muore.</para>
    ///
    /// <para><b>Lo scope proprio non bastava</b>, e vale la pena dirlo perché il commento sopra prometteva
    /// il contrario: <c>OwningComponentBase</c> protegge dal contesto <b>del circuito</b>, non da <b>sé
    /// stessi</b>. Un componente che rientra mentre la sua lettura è in volo collide col proprio contesto.</para>
    ///
    /// <para>Il compito si scrive <b>prima</b> di aspettarlo, in un tratto senza <c>await</c> — e il
    /// renderer di un circuito è a un filo solo, quindi non serve un lucchetto: chi arriva dopo aspetta
    /// <b>la stessa</b> lettura invece di farne una sua. È il rimedio già scelto per gli altri pannelli
    /// (<c>ReleasePanel</c>, <c>DocReviewBar</c>, <c>PageIntroZone</c>), che infatti scrivono la sentinella
    /// prima dell'<c>await</c>; questo era l'unico rimasto con la guardia dalla parte sbagliata.</para>
    ///
    /// <para>⚠️ Ed è anche il rimedio a un difetto minore che nessuno aveva notato: con la guardia
    /// sull'<b>esito</b>, una biblioteca <b>legittimamente vuota</b> faceva rileggere il database a ogni
    /// ridisegno, per sempre.</para>
    /// </summary>
    private Task<IReadOnlyList<AttachmentRow>>? _caricamento;

    /// <summary>Il guasto della lettura, da mostrare invece di portarsi via il circuito.</summary>
    private string? _errore;

    // ⚠️ OnParametersSetAsync e non OnInitializedAsync: su un render mode interattivo il secondo gira una
    // volta sola, e l'elenco resterebbe quello del primo blocco montato.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // ⚠️ Assegnazione PRIMA dell'await: è tutto il punto. Vedi _caricamento.
            // ⚠️ E sta DENTRO il try: una porta può sollevare in modo SINCRONO — prima ancora di
            // restituire un compito — e allora l'eccezione passerebbe accanto alla rete di sicurezza.
            // Non è un caso teorico: è il primo modo in cui questa correzione è stata scritta, e a
            // trovarlo è stato il test qui sotto.
            _caricamento ??= Biblioteca.ListAsync();
            _voci = await _caricamento;
            _errore = null;
        }
        catch (Exception ex)
        {
            // ⚠️ Rete di sicurezza: un'eccezione qui NON è catturabile dall'host — è ciclo di vita, non
            // evento — e si porterebbe via il circuito, cioè la pagina. Meglio la tendina con un errore
            // visibile (stessa scelta di ReleasePanel).
            // Il compito fallito si butta: così un guasto passeggero non inchioda il componente fino al
            // ricaricamento della pagina. I ridisegni qui li muovono i gesti di chi scrive, non un timer,
            // quindi il ritentativo non diventa un martellamento.
            _caricamento = null;
            _errore = ex.Message;
        }
    }

    private async Task ScegliAsync(string? slug)
    {
        var scelto = (slug ?? "").Trim();
        if (scelto.Length == 0)
        {
            await AttachmentJsonChanged.InvokeAsync(null);
            return;
        }

        var voce = _voci.FirstOrDefault(v => v.Slug == scelto);
        if (voce is null) return;

        // Il titolo nasce da quello della biblioteca: è il punto di partenza sensato, e resta modificabile.
        await AttachmentJsonChanged.InvokeAsync(
            AttachmentRef.Serialize(new AttachmentRef(voce.Slug, voce.Title)));
    }

    private async Task ModoAsync(string? modo)
    {
        if (Riferimento is not { } r) return;
        if (!Enum.TryParse<AttachmentDisplayMode>(modo, out var m)) return;

        await AttachmentJsonChanged.InvokeAsync(AttachmentRef.Serialize(r with { Mode = m }));
    }

    private async Task AltezzaAsync(string? altezza)
    {
        if (Riferimento is not { } r) return;
        if (!Enum.TryParse<AttachmentEmbedHeight>(altezza, out var h)) return;

        await AttachmentJsonChanged.InvokeAsync(AttachmentRef.Serialize(r with { Height = h }));
    }

    private async Task TitoloAsync(string? titolo)
    {
        if (Riferimento is not { } r) return;

        var t = (titolo ?? "").Trim();
        await AttachmentJsonChanged.InvokeAsync(
            AttachmentRef.Serialize(r with { Title = t.Length == 0 ? null : t }));
    }
}
