@* Barra di lock di editing esclusivo per pagine SENZA documento (struttura admin, nuovo doc). Riusabile: passa la
   ResourceKey e ascolta LockChanged per abilitare/disabilitare i controlli della pagina. Heartbeat 60s finché la
   scheda è aperta (TTL corto lato service → la chiusura scheda libera da sé in pochi minuti). Rilascio su teardown. *@
@using Vipi.Application.Content
@using Vipi.Application.Auth
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@implements IAsyncDisposable
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@inject ILogger<EditLockBar> Logger
@*
   Locks NON è @inject: viene risolto dallo scope DI PROPRIO del componente (OwningComponentBase.ScopedServices)
   così usa un VipiDbContext isolato da quello del circuito/pagina. Senza questo, sotto latenza (Postgres) il render
   intermedio della pagina genitore monta EditLockBar mentre una query della pagina è ancora in volo → due operazioni
   sullo stesso context condiviso → "A second operation was started on this context instance". Con lo scope proprio i
   due context sono distinti. Authz resta @inject: usa solo i claim (IsAdmin), non tocca il DB in questo componente.
*@

<div class="lockbar @(_lock.IsMine ? "mine" : _lock.Locked ? "other" : "free")">
    @if (_lock.IsMine)
    {
        @* L'ora e' UTC (col suffisso Z): il server non sa in che fuso sta chi guarda — vedi VipiTime.
           L'ora locale la scrive vipi-time.js accanto, IN BARRA e non nel tooltip: era nascosta sotto il
           passaggio del mouse e chi guarda la scadenza del proprio lock rifaceva il conto a mente, che e'
           esattamente cio' che il doppio orario doveva togliere. La testata a una riga regge perche' la
           frase in barra ha perso la parola «lock» (Lock_UntilShort), che nel `title` resta per esteso. *@
        <span class="lb-state" title="@LockTitolo()" data-utc="@VipiTime.Iso(_lock.ExpiresUtc)"><span class="lb-dot"></span> @L["Lock_Editing"]@(_lock.ExpiresUtc is { } e ? string.Format(L["Lock_UntilShort"].Value, VipiTime.Z(e)) : "")</span>
        <button class="btn ghost" @onclick="Release" title="@L["Lock_ReleaseTitle"]">✓ @L["Lock_FinishEdit"]</button>
    }
    else if (_lock.Locked)
    {
        <span class="lb-state" title="@LockTitolo()" data-utc="@VipiTime.Iso(_lock.ExpiresUtc)"><span class="lb-dot"></span> 🔒 @L["Lock_LockedByPrefix"] <b>@(_lock.ByName ?? L["Lock_AnotherEditor"].Value)</b>@(_lock.ExpiresUtc is { } e ? string.Format(L["Lock_UntilShort"].Value, VipiTime.Z(e)) : "")</span>
        @if (Authz.IsEditor)
        {
            <button class="btn ghost" @onclick="ForceUnlock" title="@L["Lock_ForceTitle"]">🔓 @L["Lock_ForceUnlock"]</button>
        }
    }
    else
    {
        @* «Sola lettura» e basta: la spiegazione (prendi il lock, una persona alla volta) la dà il «?» qui
           accanto al clic, e ripeterla in barra costava 150px di riga — abbastanza da mandare a capo la
           testata di Struttura, dove la barra sta in riga col titolo e i collegamenti. *@
        <span class="lb-state muted">@L["Lock_ReadOnly"]</span>
        <button class="btn primary" @onclick="Acquire">✎ @L["Lock_StartEdit"]</button>
        <HelpHint Href="/services/vsop/guide#editor-lock" AriaLabel="@L["Lock_HelpAria"]">
            @((MarkupString)L["Lock_HelpBody"].Value)
        </HelpHint>
    }
</div>

@code {
    [Parameter, EditorRequired] public string ResourceKey { get; set; } = default!;
    /// <summary>Notifica la pagina ad ogni cambio: true = l'utente corrente tiene il lock (può modificare).</summary>
    [Parameter] public EventCallback<bool> LockChanged { get; set; }

    /// <summary>Quando scade il lock (UTC), a ogni battito. Serve alle pagine che vogliono avvisare prima della
    /// scadenza invece di lasciare che l'editing torni in sola lettura mentre si sta scrivendo. Additivo: chi non
    /// lo aggancia non cambia comportamento.</summary>
    [Parameter] public EventCallback<DateTime?> ExpiresChanged { get; set; }

    /// <summary>
    /// Chiamato <b>prima</b> di rilasciare il lock col tasto «Fine modifica»: è dove una pagina salva quel che
    /// ha in mano. Additivo — chi non lo aggancia non cambia di una virgola.
    ///
    /// <para>⚠️ <b>Solo sul tasto</b>, e non sulle altre strade che tolgono il lock: la scadenza e lo sblocco
    /// forzato di un admin significano «questo lock non è più tuo», e salvare <i>lì</i> vorrebbe dire scrivere
    /// sopra al lavoro di chi il lock ce l'ha adesso. Premere il tasto è l'unico caso in cui l'intenzione è
    /// dichiarata.</para>
    ///
    /// <para>⚠️ <b>Torna <c>false</c> per NON rilasciare il lock.</b> Un salvataggio fallito che lascia andare
    /// il lock è il modo più rapido di perdere del lavoro: senza lock chi ha scritto non può nemmeno
    /// riprovare. La barra resta com'è, e chi ha detto no ha già spiegato perché nella sua pagina.</para>
    ///
    /// <para>⚠️ È un <b>valore</b> e non un'eccezione, e la differenza non è di stile: un'eccezione che esce da
    /// un gestore d'evento Blazor <b>abbatte il circuito</b> — la pagina sparisce invece di dire di no.</para>
    /// </summary>
    [Parameter] public Func<Task<bool>>? BeforeRelease { get; set; }

    private LockInfo _lock = LockInfo.Free();
    private CancellationTokenSource? _beat;

    /// <summary>
    /// La frase per esteso, che in barra non ci sta: in riga si legge «Stai modificando · fino alle 14:32Z»,
    /// nel tooltip «… · lock fino alle 14:32Z». L'ora locale la mette vipi-time.js in barra, non qui — un
    /// orario che si vede due volte con lo stesso testo non serve, e il tooltip resta la forma distesa.
    /// </summary>
    private string LockTitolo() => _lock.IsMine
        ? L["Lock_Editing"].Value + (_lock.ExpiresUtc is { } e ? string.Format(L["Lock_UntilSuffix"].Value, VipiTime.Z(e)) : "")
        : $"{L["Lock_LockedByPrefix"].Value} {_lock.ByName ?? L["Lock_AnotherEditor"].Value}"
          + (_lock.ExpiresUtc is { } o ? string.Format(L["Lock_LockedUntilSuffix"].Value, VipiTime.Z(o)) : "");

    // Risolto dallo scope proprio (OwningComponentBase): VipiDbContext isolato dal circuito. Vedi nota in testa.
    private IResourceLockService Locks = default!;

    protected override void OnInitialized()
        => Locks = ScopedServices.GetRequiredService<IResourceLockService>();

    protected override async Task OnInitializedAsync()
    {
        _lock = await Locks.InspectAsync(ResourceKey);
        await NotifyAsync();
        if (_lock.IsMine) StartHeartbeat();
    }

    private async Task Acquire()
    {
        _lock = await Locks.AcquireAsync(ResourceKey);
        await NotifyAsync();
        if (_lock.IsMine) StartHeartbeat();
    }

    private async Task Release()
    {
        // ⚠️ PRIMA di fermare il battito e di lasciare il lock: chi salva qui dentro deve poterlo fare
        // mentre il lock è ancora suo. Se risponde `false`, non si rilascia niente — vedi BeforeRelease.
        if (BeforeRelease is not null && !await BeforeRelease()) return;

        StopHeartbeat();
        await Locks.ReleaseAsync(ResourceKey);
        _lock = LockInfo.Free();
        await NotifyAsync();
    }

    private async Task ForceUnlock()
    {
        await Locks.ForceUnlockAsync(ResourceKey);   // admin: libera il lock altrui
        await Acquire();                              // e prendilo io
    }

    // Rinnova il lock finché la scheda è aperta; se lo perdo (scaduto/forzato), aggiorno lo stato e fermo il battito.
    private void StartHeartbeat()
    {
        StopHeartbeat();
        var cts = _beat = new CancellationTokenSource();
        _ = HeartbeatLoop(cts, cts.Token);
    }

    /// <summary>Ferma il battito corrente, qualunque sia.</summary>
    private void StopHeartbeat()
    {
        var cts = _beat;
        _beat = null;
        Cancel(cts);
    }

    /// <summary>
    /// Ferma <paramref name="cts"/> solo se è ancora il battito corrente. Serve al loop che si auto-ferma: senza
    /// il controllo d'identità, un loop vecchio che scopre di aver perso il lock annullerebbe il CancellationTokenSource
    /// di un battito NUOVO avviato nel frattempo da «Inizia modifica» (ABA) — heartbeat morto in silenzio e lock
    /// scaduto mentre l'utente sta ancora editando.
    /// </summary>
    private void StopIfCurrent(CancellationTokenSource cts)
    {
        if (!ReferenceEquals(_beat, cts)) return;
        _beat = null;
        Cancel(cts);
    }

    private static void Cancel(CancellationTokenSource? cts)
    {
        if (cts is null) return;
        try { cts.Cancel(); } catch (ObjectDisposedException) { /* già fermato */ }
        cts.Dispose();
    }

    private async Task HeartbeatLoop(CancellationTokenSource cts, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Lo stato del lock si legge DENTRO InvokeAsync, sul contesto del renderer: è lì che _lock viene
                // scritto, e leggerlo dal thread del timer sarebbe una lettura non sincronizzata.
                var stillMine = true;
                try
                {
                    await InvokeAsync(async () =>
                    {
                        var was = _lock.IsMine;
                        var scadeva = _lock.ExpiresUtc;
                        _lock = await Locks.HeartbeatAsync(ResourceKey);
                        stillMine = _lock.IsMine;
                        if (_lock.IsMine != was) { await NotifyAsync(); StateHasChanged(); }
                        // ⚠️ La SCADENZA si pubblica anche quando il proprietario non cambia, ed è il caso normale:
                        // il battito rinnova, e senza questo ramo la nuova scadenza restava dentro `_lock` senza che
                        // nessuno la sapesse. La pagina si teneva quella della PRESA e dopo ~2 minuti credeva che il
                        // lock stesse scadendo — falso allarme, con il lock rinnovato regolarmente.
                        // Si vedeva a schermo: la barra diceva «fino alle 23:41Z» e l'avviso della pagina «scade alle
                        // 23:38Z», tre minuti esatti di scarto, cioè un rinnovo avvenuto e mai detto.
                        // Il conto dice che l'avviso non può scattare per davvero se non a battito rotto: TTL 3 minuti
                        // e periodo 60 secondi tengono il residuo fra 180 e 120 secondi, e la soglia è 60. Quando
                        // scatta vuol dire che DUE battiti di fila sono falliti — che è esattamente ciò che deve dire.
                        else if (_lock.ExpiresUtc != scadeva)
                        {
                            await ExpiresChanged.InvokeAsync(_lock.IsMine ? _lock.ExpiresUtc : null);
                            // E il ri-render serve anche alla barra: l'ora che mostra è la sua, e su una pagina
                            // tranquilla — dove il genitore non ridisegna da sé — restava indietro quanto l'avviso.
                            StateHasChanged();
                        }
                    });
                }
                catch (OperationCanceledException) { throw; }
                catch (ObjectDisposedException) { throw; }
                // Un guasto TRANSITORIO del database non deve uccidere il battito. Senza questo catch, un
                // timeout di MariaDB usciva dal ciclo e finiva in un task che nessuno osserva: nessun errore a
                // schermo, e il lock scadeva dopo tre minuti mentre l'utente stava ancora scrivendo. Al
                // salvataggio successivo compariva «Lock scaduto o preso da un altro editor», che è il
                // messaggio giusto per la causa sbagliata.
                // Si salta il colpo e si riprova al tick dopo: con TTL 3 minuti e periodo 60 secondi restano
                // due tentativi di recupero prima che il lock scada davvero — che è il margine per cui quei
                // due numeri sono stati scelti.
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Heartbeat del lock «{Chiave}» fallito; riprovo al prossimo giro.", ResourceKey);
                    continue;
                }

                if (!stillMine) { StopIfCurrent(cts); break; }
            }
        }
        catch (OperationCanceledException) { }
        // Cancel()+Dispose() concorrenti all'attesa affiorano come ObjectDisposedException, non come
        // OperationCanceledException: senza questo catch resterebbe un'eccezione non osservata sul task fire-and-forget.
        catch (ObjectDisposedException) { }
    }

    private async Task NotifyAsync()
    {
        await LockChanged.InvokeAsync(_lock.IsMine);
        await ExpiresChanged.InvokeAsync(_lock.IsMine ? _lock.ExpiresUtc : null);
    }

    public ValueTask DisposeAsync()
    {
        // NON si rilascia il lock qui: il teardown scatta anche navigando tra le pagine che CONDIVIDONO la stessa
        // risorsa (le 4 pagine di struttura), e rilasciare farebbe perdere il lock ad ogni cambio pagina. La chiusura
        // scheda è già gestita dal TTL corto: fermato l'heartbeat, il lock scade da sé in pochi minuti. Il rilascio
        // immediato avviene solo su «Fine modifica» (esplicito) o «Forza sblocco» (admin).
        StopHeartbeat();
        return ValueTask.CompletedTask;
    }
}
