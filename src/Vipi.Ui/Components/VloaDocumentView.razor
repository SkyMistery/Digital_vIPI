@* Resa condivisa di una vLOA (Letter of Agreement) nello stile del mockup 3d: TOC + doc-head + callout bilaterale
   + sezioni (stessa struttura documentale della vIPI, via SectionNode). Le sezioni AoR/Frequenze/Coordinamenti sono
   DERIVATE (data-driven) quando è fornito DocId. La pagina ospitante fornisce wrap/breadcrumb. *@
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IOnlineAtcProvider Online
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@* Vloa e VloaView risolti dallo scope DI proprio (VipiDbContext isolato dal circuito). Vedi [[EditLockBar]]. *@

<div class="doc-layout">
    <aside class="toc">
        <p class="toc-h">@L["Common_Contents"]</p>
        <ul>
            @foreach (var s in View.Sections)
            {
                @if (IsDraft || !s.IsHidden) { <li><a href="#@s.Id">@s.Title</a></li> }
            }
        </ul>
    </aside>

    <div>
        <PrintMeta Title="@View.Title" AiracCycle="@View.AiracCycle" Subtitle="@SubtitleOrDefault()" />
        <div class="doc-head">
            <div>
                <h2 style="margin-bottom:2px">@View.Title</h2>
                <span class="muted">@SubtitleOrDefault()</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <button type="button" class="btn ghost" onclick="window.print()">@L["Common_Print"]</button>
                @if (_canEdit && !string.IsNullOrWhiteSpace(HomeAcc) && !string.IsNullOrWhiteSpace(ForeignAcc))
                {
                    <a class="btn primary" href="/vsop/@HomeAcc.ToLowerInvariant()/vloa/editor?acc=@ForeignAcc">@L["Common_Editor"]</a>
                }
            </div>
        </div>
        <div class="callout info"><span class="cic"><Icon Name="globe" Size="18" /></span><div><p class="ct">@L["Vloa_BilateralNoteTitle"]</p>@L["Vloa_BilateralNoteBody"]</div></div>

        @foreach (var s in View.Sections)
        {
            @if (s.IsHidden && !IsDraft)
            {
                <text></text>   @* nascosta: fuori dal pubblico e dall'anteprima release *@
            }
            else if (s.IsHidden)
            {
                @* Anteprima bozza: la sezione nascosta si vede, marcata — come ACC e APP (doc 11 §3c). Prima
                   spariva anche in bozza, quindi non c'era modo di rivedere cosa si era nascosto. *@
                <CollapsibleBlock Id="@s.Id" Style="opacity:.65">
                    <Header><h3 style="margin-top:0">@s.Title <span class="pill neutral" style="font-weight:500">@L["Common_HiddenNotPublic"]</span></h3></Header>
                    <ChildContent><SectionBody Section="s" /></ChildContent>
                </CollapsibleBlock>
            }
            else if (_derive && s.SectionKey == "aor")
            {
                <CollapsibleBlock Id="@s.Id"><Header><h3 style="margin-top:0">@s.Title</h3></Header><ChildContent>@SubSections(s, SectionSlot.Before)@ReadAor()@SubSections(s, SectionSlot.After)</ChildContent></CollapsibleBlock>
            }
            else if (_derive && s.SectionKey == "frequencies")
            {
                <CollapsibleBlock Id="@s.Id"><Header><h3 style="margin-top:0">@s.Title</h3></Header><ChildContent>@SubSections(s, SectionSlot.Before)@ReadFreq()@SubSections(s, SectionSlot.After)</ChildContent></CollapsibleBlock>
            }
            else if (_derive && s.SectionKey == "coordination")
            {
                <CollapsibleBlock Id="@s.Id">
                    <Header><h3 style="margin-top:0">@s.Title</h3></Header>
                    <ChildContent>
                        @* Le sotto-sezioni EXTRA (quelle che non sono una direzione) sono contenuto del documento
                           come in ogni altra sezione resa dalla pagina: prima questo ramo — solo questo — non le
                           rendeva affatto, pur essendo creabili dall'editor con «+ sotto-sez» (doc 11 §3b). *@
                        @SubSections(WithoutDirections(s), SectionSlot.Before)
                        @* Le due direzioni, riconosciute dalla CHIAVE (doc 13 §3c): prima erano la figlia [0] e la
                           figlia [1], mentre l'editor le distingueva per titolo — due modi per la stessa cosa. *@
                        @if (DirectionVisible(s, SectionKeys.CoordinationOut))
                        {
                            <h4>@_coord.HomeAcc → @_coord.ForeignAcc</h4>
                            <AccCoordinationView Coord="_coord.HomeToForeign" English="true" />
                        }
                        @if (DirectionVisible(s, SectionKeys.CoordinationIn))
                        {
                            <h4>@_coord.ForeignAcc → @_coord.HomeAcc</h4>
                            <AccCoordinationView Coord="_coord.ForeignToHome" English="true" />
                        }
                        @SubSections(WithoutDirections(s), SectionSlot.After)
                    </ChildContent>
                </CollapsibleBlock>
            }
            else
            {
                <SectionNode Section="s" />
            }
        }
    </div>

    <aside class="doc-rail">
        <div class="rail-card">
            <h5><Icon Name="clipboard" /> @L["Common_Summary"]</h5>
            <div class="rail-line"><span class="muted">@L["Common_AiracCycle"]</span><b>@View.AiracCycle</b></div>
            @if (!string.IsNullOrWhiteSpace(HomeAcc))
            {
                <div class="rail-line"><span class="muted">@HomeAcc online</span>@OnlineBadge(HomeAcc)</div>
            }
            @if (!string.IsNullOrWhiteSpace(ForeignAcc))
            {
                <div class="rail-line"><span class="muted">@ForeignAcc online</span>@OnlineBadge(ForeignAcc)</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(HomeAcc))
        {
            <div class="rail-card">
                <h5><Icon Name="link" /> @L["Common_Links"]</h5>
                <ul class="rail-links">
                    <li><a href="/vsop">@L["Common_Home"]</a></li>
                    <li><a href="/vsop/@HomeAcc.ToLowerInvariant()/vloa">@L["Vloa_ListLink"]</a></li>
                    <li><a href="/vsop/@HomeAcc.ToLowerInvariant()/vipi">vIPI @HomeAcc</a></li>
                </ul>
            </div>
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public DocumentView View { get; set; } = default!;

    /// <summary>Sottotitolo sotto il titolo (es. "Roma ACC ↔ Tunis ACC"). Default: "Letter of Agreement (EN)".</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Id del Document vLOA: se fornito, AoR/Frequenze/Coordinamenti sono derivati dai dati (data-driven).</summary>
    [Parameter] public int? DocId { get; set; }

    /// <summary>Vista pubblica: legge le derivate frozen dalla release effettiva (doc 10 §3d). False (bozza/anteprima) = live.</summary>
    [Parameter] public bool UseFrozen { get; set; }

    /// <summary>Codici ACC della coppia (per il riepilogo online + i link della colonna destra). Opzionali.</summary>
    [Parameter] public string? HomeAcc { get; set; }
    [Parameter] public string? ForeignAcc { get; set; }

    /// <summary>Anteprima bozza: le sezioni nascoste restano visibili, marcate (doc 11 §3c).</summary>
    [Parameter] public bool IsDraft { get; set; }

    private bool _derive;
    private bool _canEdit;
    private VloaAorData _aor = VloaAorData.Empty;
    private VloaFreqData _freq = VloaFreqData.Empty;
    private VloaCoordination _coord = VloaCoordination.Empty;

    // Risolti dallo scope proprio (OwningComponentBase): context isolato dal circuito.
    private IVloaDerivationService Vloa = default!;
    private IVloaViewDerivationService VloaView = default!;
    protected override void OnInitialized()
    {
        Vloa = ScopedServices.GetRequiredService<IVloaDerivationService>();
        VloaView = ScopedServices.GetRequiredService<IVloaViewDerivationService>();
    }

    /// <summary>Sottotitolo del documento; in mancanza, la dicitura di default della lettera d'accordo.</summary>
    private string SubtitleOrDefault() =>
        string.IsNullOrWhiteSpace(Subtitle) ? L["Vloa_SubtitleDefault"].Value : Subtitle!;

    /// <summary>Vero se la chiave è una delle due direzioni dei coordinamenti (rese dal corpo, non come sotto-sezioni).</summary>
    private static bool IsDirection(string key) =>
        key.Equals(SectionKeys.CoordinationOut, StringComparison.OrdinalIgnoreCase)
        || key.Equals(SectionKeys.CoordinationIn, StringComparison.OrdinalIgnoreCase);

    /// <summary>La stessa sezione senza le due direzioni fra le figlie: quelle le rende il corpo, le altre sono
    /// sotto-sezioni normali e vanno rese negli slot come ovunque (doc 11 §3g).</summary>
    private static SectionView WithoutDirections(SectionView s) => new()
    {
        Id = s.Id,
        Title = s.Title,
        Depth = s.Depth,
        SectionKey = s.SectionKey,
        IsHidden = s.IsHidden,
        BeforeParentBody = s.BeforeParentBody,
        Blocks = s.Blocks,
        Children = s.Children.Where(c => !IsDirection(c.SectionKey)).ToList(),
    };

    // Direzione dei coordinamenti: visibile se la sotto-sezione con quella chiave non è nascosta (in bozza si
    // mostra comunque). Se il documento non ha quella sotto-sezione (vLOA vecchia, non ancora riconciliata) la
    // direzione si mostra: meglio un coordinamento in più che una lettera d'accordo monca.
    private bool DirectionVisible(SectionView coordination, string key)
    {
        var child = coordination.Children.FirstOrDefault(c =>
            string.Equals(c.SectionKey, key, StringComparison.OrdinalIgnoreCase));
        return child is null || IsDraft || !child.IsHidden;
    }

    // Le sotto-sezioni di una sezione DERIVATA restano contenuto del documento (doc 11 §3b): prima sparivano,
    // pur essendo creabili dall'editor con «+ sotto-sez». I blocchi della sezione derivata NON si rendono
    // (portano il payload, non contenuto). Lo slot decide se stanno prima o dopo il corpo (doc 11 §3g).
    private RenderFragment SubSections(SectionView s, SectionSlot slot) => __builder =>
    {
        @if (SectionBody.HasChildren(s, slot)) { <SectionBody Section="s" ShowBlocks="false" Slot="slot" /> }
    };

    // ATC online di un ACC (testa callsign = codice ACC, es. LIMM_CTR / LFMM_N_CTR).
    private int OnlineOf(string code) =>
        Online.GetCurrent().Callsigns.Count(cs => cs.Split('_', 2)[0].Equals(code, StringComparison.OrdinalIgnoreCase));

    private RenderFragment OnlineBadge(string code) => __builder =>
    {
        var n = OnlineOf(code);
        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
    };

    protected override async Task OnParametersSetAsync()
    {
        _derive = DocId is int;
        if (DocId is int docId)
        {
            // Derivate: frozen dalla release effettiva nella vista pubblica, live in bozza/anteprima (doc 10 §3d).
            var d = await VloaView.ResolveForViewAsync(docId, UseFrozen);
            _aor = d.Aor;
            _freq = d.Freq;
            _coord = d.Coord;
        }
        // vLOA editabile solo lato italiano (CH/AOD dell'ACC home).
        _canEdit = !string.IsNullOrWhiteSpace(HomeAcc) && await Authz.CanEditAccAsync(HomeAcc!);
    }

    private RenderFragment ReadAor() => __builder =>
    {
        <AccAor View="_aor.Map" Id="@($"vloa-aor-view-{DocId}")" />
    };

    private RenderFragment ReadFreq() => __builder =>
    {
        var visible = _freq.Rows.Where(r => !r.Hidden).ToList();
        @if (visible.Count == 0)
        {
            <p class="muted">@L["Vloa_NoFreqAvail"]</p>
        }
        else
        {
            <h4 style="margin:8px 0 4px">@_freq.HomeCountry - @_freq.HomeAcc</h4>
            @FreqTable(visible.Where(r => !r.IsForeign).ToList())
            <h4 style="margin:14px 0 4px">@_freq.ForeignCountry - @_freq.ForeignAcc</h4>
            @FreqTable(visible.Where(r => r.IsForeign).ToList())
        }
    };

    private RenderFragment FreqTable(IReadOnlyList<VloaFreqRow> rows) => __builder =>
    {
        @if (rows.Count == 0)
        {
            <p class="muted" style="margin:0">@L["Vloa_NoFreq"]</p>
        }
        else
        {
            <table class="cfg-table" style="table-layout:fixed;width:100%">
                <colgroup>
                    <col style="width:32px" />
                    <col style="width:auto" />
                    <col style="width:26%" />
                    <col style="width:120px" />
                </colgroup>
                <thead><tr><th></th><th>@L["AppFreq_Callsign"]</th><th>@L["AppFreq_Position"]</th><th>@L["Airport_Frequency"]</th></tr></thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td>@(r.Row.IsPrimary ? "★" : "")</td>
                            <td style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@r.Row.Name</td>
                            <td>@r.Row.Callsign</td>
                            <td>@r.Row.FrequencyMhz</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    };

}
