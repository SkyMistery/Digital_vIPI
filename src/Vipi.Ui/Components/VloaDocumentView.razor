@* Resa condivisa di una vLOA (Letter of Agreement) nello stile del mockup 3d: TOC + doc-head + callout bilaterale
   + sezioni (stessa struttura documentale della vIPI, via SectionNode). Le sezioni AoR/Frequenze/Coordinamenti sono
   DERIVATE (data-driven) quando è fornito DocId. La pagina ospitante fornisce wrap/breadcrumb. *@
@using Microsoft.Extensions.DependencyInjection
@inherits OwningComponentBase
@inject IOnlineAtcProvider Online
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@* Vloa e VloaView risolti dallo scope DI proprio (VipiDbContext isolato dal circuito). Vedi [[EditLockBar]]. *@

<div class="doc-layout">
    @* ⚠️ `SlotsOf` va all'indice **e** al corpo, con la stessa funzione: le due direzioni le disegna il
       corpo da sé, e nell'indice sarebbero due voci verso un id che non esiste. *@
    <DocumentToc Sections="View.Sections" IsDraft="IsDraft" SlotsOf="SenzaDirezioni" />

    <div>
        <PrintMeta Title="@View.Title" AiracCycle="@View.AiracCycle" Subtitle="@SubtitleOrDefault()" Coverage="Coverage" />
        <div class="doc-head">
            <div>
                <h2 style="margin-bottom:2px">@View.Title</h2>
                <span class="muted">@SubtitleOrDefault() · <SimDisclaimer /> <TranslationNotice Coverage="Coverage" Compatto="true" /></span>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <button type="button" class="btn ghost" onclick="window.print()">@L["Common_Print"]</button>
                @if (_canEdit && !string.IsNullOrWhiteSpace(HomeAcc) && !string.IsNullOrWhiteSpace(ForeignAcc))
                {
                    <a class="btn primary" href="/services/vsop/@HomeAcc.ToLowerInvariant()/vloa/editor?acc=@ForeignAcc">@L["Common_Editor"]</a>
                }
            </div>
        </div>
        <div class="callout info"><span class="cic"><Icon Name="globe" Size="18" /></span><div><p class="ct">@L["Vloa_BilateralNoteTitle"]</p>@L["Vloa_BilateralNoteBody"]</div></div>

        @* Il ciclo delle sezioni lo fa il componente condiviso (doc 14 §3e): nascosta/bozza, «nasce chiusa»,
           sotto-sezioni prima e dopo, blocchi propri. Qui resta il solo corpo derivato, per chiave.
           ⚠️ Chi rende il corpo lo dice ora il CATALOGO: prima era una catena di `else if` su tre chiavi
           cablate, e la vLOA era l'unica delle quattro a decidere da sé. *@
        <DocumentSectionsView Sections="View.Sections" Profile="SectionProfile.Vloa" IsDraft="IsDraft"
                              SlotsOf="SenzaDirezioni" DerivedContent="CorpoDerivato" />
    </div>

    <aside class="doc-rail" aria-label="@L["Doc_RailAria"]">
        <div class="rail-card">
            <h5><Icon Name="clipboard" /> @L["Common_Summary"]</h5>
            <div class="rail-line"><span class="muted">@L["Common_AiracCycle"]</span><b>@View.AiracCycle</b></div>
            @if (!string.IsNullOrWhiteSpace(HomeAcc))
            {
                <div class="rail-line"><span class="muted">@HomeAcc online</span>@OnlineBadge(HomeAcc)</div>
            }
            @if (!string.IsNullOrWhiteSpace(ForeignAcc))
            {
                <div class="rail-line"><span class="muted">@ForeignAcc online</span>@OnlineBadge(ForeignAcc)</div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(HomeAcc))
        {
            <div class="rail-card">
                <h5><Icon Name="link" /> @L["Common_Links"]</h5>
                <ul class="rail-links">
                    <li><a href="/services/vsop">@L["Common_Home"]</a></li>
                    <li><a href="/services/vsop/@HomeAcc.ToLowerInvariant()/vloa">@L["Vloa_ListLink"]</a></li>
                    <li><a href="/services/vsop/@HomeAcc.ToLowerInvariant()/vipi">vIPI @HomeAcc</a></li>
                </ul>
            </div>
        }
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public DocumentView View { get; set; } = default!;

    /// <summary>Sottotitolo sotto il titolo (es. "Roma ACC ↔ Tunis ACC"). Default: "Letter of Agreement (EN)".</summary>

    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Id del Document vLOA: se fornito, AoR/Frequenze/Coordinamenti sono derivati dai dati (data-driven).</summary>
    [Parameter] public int? DocId { get; set; }

    /// <summary>Vista pubblica: legge le derivate frozen dalla release effettiva (doc 10 §3d). False (bozza/anteprima) = live.</summary>
    [Parameter] public bool UseFrozen { get; set; }

    /// <summary>Codici ACC della coppia (per il riepilogo online + i link della colonna destra). Opzionali.</summary>
    [Parameter] public string? HomeAcc { get; set; }
    [Parameter] public string? ForeignAcc { get; set; }

    /// <summary>Anteprima bozza: le sezioni nascoste restano visibili, marcate (doc 11 §3c).</summary>
    [Parameter] public bool IsDraft { get; set; }

    /// <summary>Anteprima di una release precisa; null = la release effettiva adesso.</summary>
    [Parameter] public int? ReleaseId { get; set; }

    /// <summary>
    /// La copertura di traduzione: il gettone «tradotta a macchina» sotto il titolo e, sul foglio, la riga
    /// per esteso in <c>PrintMeta</c>.
    /// <para>⚠️ Sta QUI e non nella pagina perché la testata è di questo componente: la pagina non ha una
    /// riga sotto il titolo a cui appendere il gettone. Il default («nessuna traduzione») non mostra
    /// niente.</para>
    /// </summary>
    [Parameter] public Vipi.Application.Translation.TranslationCoverage Coverage { get; set; }
        = Vipi.Application.Translation.TranslationCoverage.Nessuna;

    private bool _canEdit;
    private VloaAorData _aor = VloaAorData.Empty;
    private VloaFreqData _freq = VloaFreqData.Empty;
    private VloaCoordination _coord = VloaCoordination.Empty;

    // Risolti dallo scope proprio (OwningComponentBase): context isolato dal circuito.
    private IVloaDerivationService Vloa = default!;
    private IVloaViewDerivationService VloaView = default!;
    protected override void OnInitialized()
    {
        Vloa = ScopedServices.GetRequiredService<IVloaDerivationService>();
        VloaView = ScopedServices.GetRequiredService<IVloaViewDerivationService>();
    }

    /// <summary>Sottotitolo del documento; in mancanza, la dicitura di default della lettera d'accordo.</summary>
    private string SubtitleOrDefault() =>
        string.IsNullOrWhiteSpace(Subtitle) ? L["Vloa_SubtitleDefault"].Value : Subtitle!;

    /// <summary>
    /// La sotto-sezione è una delle due DIREZIONI dei coordinamenti (resa dal corpo), non una sotto-sezione extra.
    /// <para>
    /// Due forme, e vanno riconosciute entrambe. Quella corrente ha una chiave per verso
    /// (<c>coordination:out</c>/<c>:in</c>, doc 13 §3c). Quella STORICA ripete la chiave del padre: la
    /// riconciliazione al boot sistema i documenti, ma non gli <b>snapshot di release già pubblicati</b>, che
    /// restano com'erano — e sono proprio ciò che il pubblico legge. Guardare solo le chiavi nuove faceva
    /// comparire le direzioni <b>due volte</b> su ogni vLOA pubblicata prima del doc 13: una dal corpo e una come
    /// sotto-sezione, quest'ultima col paragrafo segnaposto che nessuna vista aveva mai mostrato.
    /// </para>
    /// </summary>
    private static bool IsDirection(SectionView child) =>
        child.SectionKey.Equals(SectionKeys.CoordinationOut, StringComparison.OrdinalIgnoreCase)
        || child.SectionKey.Equals(SectionKeys.CoordinationIn, StringComparison.OrdinalIgnoreCase)
        || child.SectionKey.Equals(SectionKeys.Coordination, StringComparison.OrdinalIgnoreCase);

    /// <summary>La stessa sezione senza le due direzioni fra le figlie: quelle le rende il corpo, le altre sono
    /// sotto-sezioni normali e vanno rese negli slot come ovunque (doc 11 §3g).</summary>
    /// <summary>
    /// Il corpo che questa pagina disegna, per chiave di sezione. Sono le stesse chiavi che il catalogo
    /// dichiara «rese dalla pagina» per il profilo vLOA: aor, frequencies, coordination, validity.
    /// </summary>
    private RenderFragment<SectionView> CorpoDerivato => s => __builder =>
    {
        @switch (s.SectionKey)
        {
            case "aor": @ReadAor(); break;
            case "frequencies": @ReadFreq(); break;
            case "coordination":
                @* Le due direzioni, riconosciute dalla CHIAVE (doc 13 §3c): prima erano la figlia [0] e la
                   figlia [1], mentre l'editor le distingueva per titolo — due modi per la stessa cosa.
                   L'ORDINE però è quello del documento: le due sotto-sezioni si spostano dall'editor come
                   ogni altra sezione del loro gruppo, e il pubblicato deve seguirle. *@
                foreach (var key in DirectionOrder(s))
                {
                    var outbound = string.Equals(key, SectionKeys.CoordinationOut, StringComparison.OrdinalIgnoreCase);
                    @if (DirectionVisible(s, key))
                    {
                        <h4>@(outbound ? _coord.HomeAcc : _coord.ForeignAcc) → @(outbound ? _coord.ForeignAcc : _coord.HomeAcc)</h4>
                        <AccCoordinationView Coord="@(outbound ? _coord.HomeToForeign : _coord.ForeignToHome)" English="true" />
                    }
                }
                break;
            case "validity":
                @* Il timbro sopra; il testo bilaterale sotto lo mette il componente condiviso, perché il
                   catalogo dice che questa sezione i propri blocchi li tiene. *@
                @if (DocId is int docId)
                {
                    <ValidityStamp Target="ReleaseTargetType.Vloa" Key="@docId.ToString()" ReleaseId="ReleaseId" />
                }
                break;
        }
    };

    /// <summary>La sezione dei coordinamenti senza le due direzioni: quelle le disegna il corpo derivato, e
    /// senza questo filtro comparirebbero anche come sotto-sezioni ordinarie.</summary>
    private static SectionView SenzaDirezioni(SectionView s) =>
        string.Equals(s.SectionKey, SectionKeys.Coordination, StringComparison.OrdinalIgnoreCase)
            ? WithoutDirections(s) : s;

    private static SectionView WithoutDirections(SectionView s) => new()
    {
        Id = s.Id,
        Title = s.Title,
        Depth = s.Depth,
        SectionKey = s.SectionKey,
        IsHidden = s.IsHidden,
        BeforeParentBody = s.BeforeParentBody,
        Blocks = s.Blocks,
        Children = s.Children.Where(c => !IsDirection(c)).ToList(),
    };

    /// <summary>
    /// Le due direzioni nell'ORDINE del documento: chi ha la sua sotto-sezione si mette dove sta la sotto-sezione,
    /// chi non ce l'ha (o gli snapshot storici, dove entrambe portano la chiave del padre e si distinguono solo per
    /// posizione) resta nell'ordine canonico uscente → entrante.
    /// </summary>
    private static IReadOnlyList<string> DirectionOrder(SectionView coordination)
    {
        string[] canonical = { SectionKeys.CoordinationOut, SectionKeys.CoordinationIn };
        var directions = coordination.Children.Where(IsDirection).ToList();
        if (directions.Count == 0
            || directions.All(c => c.SectionKey.Equals(SectionKeys.Coordination, StringComparison.OrdinalIgnoreCase)))
            return canonical;

        return canonical
            .Select((key, std) => (key, std, at: directions.FindIndex(c => string.Equals(c.SectionKey, key, StringComparison.OrdinalIgnoreCase))))
            .OrderBy(x => x.at < 0 ? x.std : x.at).ThenBy(x => x.std)
            .Select(x => x.key)
            .ToList();
    }

    /// <summary>
    /// Direzione dei coordinamenti: visibile se la sua sotto-sezione non è nascosta (in bozza si mostra comunque).
    /// La si cerca per chiave; sugli snapshot storici, dove entrambe portano quella del padre, si ricade
    /// sull'ordine — è l'unico appiglio che quella fotografia offre. Se la sotto-sezione non c'è affatto, la
    /// direzione si mostra: meglio un coordinamento in più che una lettera d'accordo monca.
    /// </summary>
    private bool DirectionVisible(SectionView coordination, string key)
    {
        var directions = coordination.Children.Where(IsDirection).ToList();
        var child = directions.FirstOrDefault(c => string.Equals(c.SectionKey, key, StringComparison.OrdinalIgnoreCase))
            ?? LegacyByPosition(directions, key);
        return child is null || IsDraft || !child.IsHidden;

        static SectionView? LegacyByPosition(IReadOnlyList<SectionView> directions, string key)
        {
            if (!directions.All(c => c.SectionKey.Equals(SectionKeys.Coordination, StringComparison.OrdinalIgnoreCase)))
                return null;
            var index = key.Equals(SectionKeys.CoordinationOut, StringComparison.OrdinalIgnoreCase) ? 0 : 1;
            return index < directions.Count ? directions[index] : null;
        }
    }

    // ATC online di un ACC (testa callsign = codice ACC, es. LIMM_CTR / LFMM_N_CTR).
    private int OnlineOf(string code) =>
        Online.GetCurrent().Callsigns.Count(cs => cs.Split('_', 2)[0].Equals(code, StringComparison.OrdinalIgnoreCase));

    private RenderFragment OnlineBadge(string code) => __builder =>
    {
        var n = OnlineOf(code);
        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
    };

    protected override async Task OnParametersSetAsync()
    {
        if (DocId is int docId)
        {
            // Derivate: frozen dalla release effettiva nella vista pubblica, live in bozza/anteprima (doc 10 §3d).
            var d = await VloaView.ResolveForViewAsync(docId, UseFrozen);
            _aor = d.Aor;
            _freq = d.Freq;
            _coord = d.Coord;
        }
        // vLOA editabile solo lato italiano (CH/AOD dell'ACC home).
        _canEdit = !string.IsNullOrWhiteSpace(HomeAcc) && Authz.IsEditor;
    }

    /// <summary>Le righe di un lato della coppia, scartato l'involucro di visibilità della vLOA.</summary>
    private static IReadOnlyList<AppFreqRow> Rows(IReadOnlyList<VloaFreqRow> rows, bool foreign) =>
        rows.Where(r => r.IsForeign == foreign).Select(r => r.Row).ToList();

    private RenderFragment ReadAor() => __builder =>
    {
        <AccAor View="_aor.Map" Id="@($"vloa-aor-view-{DocId}")" />
    };

    private RenderFragment ReadFreq() => __builder =>
    {
        var visible = _freq.Rows.Where(r => !r.Hidden).ToList();
        @if (visible.Count == 0)
        {
            <p class="muted">@L["Vloa_NoFreqAvail"]</p>
        }
        else
        {
            @* Stessa tabella della vIPI ACC e dell'APP, invocata una volta per lato (doc 13 §3l): qui c'era una
               copia inline, che infatti aveva finito per chiamare le colonne in un altro modo. *@
            <h4 style="margin:8px 0 4px">@_freq.HomeCountry - @_freq.HomeAcc</h4>
            <AppFrequencies Rows="Rows(visible, foreign: false)" />
            <h4 style="margin:14px 0 4px">@_freq.ForeignCountry - @_freq.ForeignAcc</h4>
            <AppFrequencies Rows="Rows(visible, foreign: true)" />
        }
    };
}
