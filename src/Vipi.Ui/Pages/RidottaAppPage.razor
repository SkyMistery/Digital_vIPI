@* DISABILITATA (rebuild /vsop, Round 12) — rotta rimossa. Ex: "/vsop/{Acc}/ridotta-app". Vedi PAGINE_DISABILITATE.md *@
@layout SopLayout
@inject IStationResolver Stations

<PageTitle>LIRP Pisa APP — Ridotta · IVAO Italia</PageTitle>

<div class="wrap">
    <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc?.Name</a> › <b>Vista ridotta · APP</b></div>
    <div class="reduced-top">
        <h2 style="margin:0">LIRP Pisa APP — Ridotta</h2>
        <div class="live-badge" style="background:#dafbe7;color:#0f7a37;border-color:#a7e9c1"><span class="dot"></span> Live · LIRP_APP</div>
    </div>
    <div class="callout info"><span class="cic">⚡</span><div><p class="ct">Ridotta per posizione APP</p>L'avvicinamento vede frequenze, i trasferimenti verso gli ACC e verso la/e torre/i, e la vista rapida dei suoi aeroporti.</div></div>

    <div class="red-top-grid">
        <details class="acc-item" open>
            <summary><span>📻 Frequenze</span><span class="tag-state tag-covered">aperto</span></summary>
            <div class="body"><table><thead><tr><th>Posizione</th><th>Callsign</th><th>Freq</th></tr></thead><tbody>
                <tr><td><b>Pisa Approach</b></td><td>LIRP_APP</td><td><b>124.250</b></td></tr>
                <tr><td>Pisa Tower</td><td>LIRP_TWR</td><td>118.600</td></tr>
            </tbody></table></div>
        </details>
        <details class="acc-item" open>
            <summary><span><Icon Name="plane-landing" /> Vista rapida — LIRP</span><span class="tag-state tag-covered">aperto</span></summary>
            <div class="body">
                <div class="rap-quick" style="margin-bottom:8px">
                    <div class="rap-box"><span class="muted">TA</span><b>6000 ft</b></div>
                    <div class="rap-box"><span class="muted">Piste</span><b>04R dep · 04L arr</b></div>
                </div>
                <p class="muted" style="font-size:12.5px;margin:0">TA/TL, piste suggerite e SID nella vista rapida aeroporto.</p>
            </div>
        </details>
        <details class="acc-item collapsed-strip">
            <summary><span>🔇 Coordinamenti VFR — gestione paragrafo</span><span class="tag-state tag-covered">covered</span></summary>
            <div class="body"><p class="muted" style="font-size:13px">Punti di riporto e codici nella vIPI dell'aeroporto.</p></div>
        </details>
    </div>

    <details class="acc-item" open>
        <summary><span><Icon Name="refresh" /> Trasferimenti · dove passo il traffico</span><span class="tag-state tag-covered">aperto</span></summary>
        <div class="body">
            <div class="xfer-online">
                <span class="xo-label">Online nel tuo intorno:</span>
                <span class="xo-chip on" data-sec="EW">Roma EW</span>
                <span class="xo-chip" data-sec="SU">Roma SU</span>
                <span class="xo-chip on" data-sec="LIRP_TWR">Pisa TWR</span>
            </div>
            <div>
                <div class="xpair"><div class="xpair-h">Pisa APP ↔ Roma ACC</div><div class="xpair-body"><div class="xt-cards">
                    <div class="xt-card"><div class="xt-card-h"><b class="xt-dest">Verso ACC</b><span class="muted" style="font-size:11px">2 pt</span></div>
                        <div class="xt-pt"><span class="cop">VALMA</span><b class="fl up">FL150↑</b><span class="xt-next" style="background:#e2e8ff;color:#0D2C99;border-left:3px solid #0D2C99">→ <b>EW</b></span></div>
                        <div class="xt-pt"><span class="cop">ELKAP</span><b class="fl down">FL150↓</b><span class="xt-next" style="background:#dafbe7;color:#0f7a37;border-left:3px solid #0f7a37">→ <b>SU</b></span></div>
                    </div>
                </div></div></div>
                <div class="xpair"><div class="xpair-h">Pisa APP ↔ Torri</div><div class="xpair-body"><div class="xt-cards">
                    <div class="xt-card"><div class="xt-card-h"><b class="xt-dest">LIRP_TWR</b><span class="muted" style="font-size:11px">finale</span></div>
                        <div class="xt-pt"><span class="cop">—</span><b class="fl">2000 ft</b><span class="xt-next" style="background:#ffe7d4;color:#9a4a00;border-left:3px solid #9a4a00">→ <b>TWR</b></span></div>
                    </div>
                </div></div></div>
            </div>
            <p class="help" style="margin-top:8px">Una sezione verso gli ACC e una verso le torri (più card se l'APP copre più aeroporti, es. Catania).</p>
        </div>
    </details>
</div>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    private AccInfo? _acc;
    protected override void OnParametersSet() => _acc = Stations.Resolve(Acc);
}
