@page "/vsop/admin/audit"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IAuditLogReader Audit
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Audit_Title"] · IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    @* ---- Le pagine admin, dove stava la briciola di pane ----
       La barra è al posto della briciola perché ne faceva già il lavoro e meglio: «Home › Staff Area ›
       Structure › Airports» portava a tre posti che sono tutti qui dentro (o nel logo in topbar), diceva
       «sei in Airports» come lo dice la voce accesa, e inventava una gerarchia — Aeroporti NON sta sotto
       Struttura, sono pagine sorelle, e la barra le mostra per quello che sono. Le briciole erano anche già
       divergenti fra loro: «Admin» portava a due indirizzi diversi a seconda della pagina.
       Sopra il titolo e non sotto: il titolo deve toccare il contenuto che intitola. Da sotto, la barra si
       infilava fra l'H2 e la sua prima sezione e li staccava.
       ⚠️ Resta nuda, senza `@if` intorno: il filtro per autorizzazione lo fa il componente. *@
    <AdminNav />

    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Audit_Title"]</h2><span class="muted">@L["Audit_Subtitle"]</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_AccessReserved"]</p>@L["Audit_StaffOnly"]</div></div>
    }
    else if (_rows is null)
    {
        <LoadingState />
    }
    else if (_rows.Count == 0)
    {
        <div class="callout info"><span class="cic"><Icon Name="info" Size="18" /></span><div>@L["Audit_NoEvents"]</div></div>
    }
    else
    {
        <table>
            <thead><tr><th>@L["Audit_When"]</th><th>VID</th><th>@L["Audit_Action"]</th><th>@L["Audit_Entity"]</th><th>Id</th><th>@L["Audit_Details"]</th></tr></thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.TimestampUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td><b>@r.UserId</b></td>
                        <td>@r.Action</td>
                        <td>@r.EntityType</td>
                        <td>@r.EntityId</td>
                        <td class="muted" style="font-size:12px">@r.DetailsJson</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private IReadOnlyList<AuditEntry>? _rows;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        _rows = await Audit.ListRecentAsync();
    }
}
