@page "/services/vsop/release/{Id:int}"
@layout SopLayout
@*  ⚠️ NIENTE @@rendermode: questa pagina è un REDIRECT, e un redirect non ha bisogno di un circuito.

    Con «InteractiveServer» il salto costava: pagina resa, WebSocket aperto, e solo allora la navigazione.
    Senza, `Nav.NavigateTo` durante il ciclo di vita diventa quel che è sempre stato — una risposta di
    reindirizzamento HTTP, che il browser segue prima di disegnare qualunque cosa. Più veloce e più
    corretto: chi arriva qui da un segnalibro vecchio ottiene un vero 302 verso l'indirizzo di oggi.

    I tre rami visibili (accesso negato, release inesistente, «reindirizzamento…») restano quello che
    erano: testo, senza un comando dentro.
*@
@inject IReleaseService Releases
@inject IDocumentAdminService DocAdmin
@inject Vipi.Application.Routing.IDocRoutesRegistry DocRoutes
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject EnglishStrings En

@* Compat: la vecchia pagina di anteprima release è ora un redirect al viewer tipizzato con ?as=rel:{id},
   così l'anteprima è resa dentro il documento reale (ACC/APP inclusi), non più solo Aeroporto/vLOA. *@

<PageTitle>Anteprima release · IVAO Italy</PageTitle>
<div class="wrap">
    <div class="breadcrumb"><a href="/services/vsop/versions">@En["Nd_Drafts"]</a> › <b>@En["Rel_PreviewCrumb"]</b></div>
    @if (_denied)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Rel_AccessTitle"]</p>@L["Rel_NoPermissionPreview"]</div></div>
    }
    else if (_notFound)
    {
        <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">@L["Rel_MissingTitle"]</p>@L["Rel_NoReleaseWithId"]</div></div>
    }
    else
    {
        <p class="help">Reindirizzamento all'anteprima…</p>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool _notFound;
    private bool _denied;

    protected override async Task OnParametersSetAsync()
    {
        _notFound = _denied = false;
        ReleaseLocation? loc;
        try
        {
            loc = await Releases.GetLocationAsync(Id);
        }
        catch (EditNotAllowedException) { _denied = true; return; }
        catch (Vipi.Application.Aor.ValidationException) { _notFound = true; return; }
        if (loc is null) { _notFound = true; return; }

        var acc = loc.AccCode.ToLowerInvariant();
        // vLOA: la chiave release è il docId → risolvo il vicino (foreign) dal catalogo; gli altri tipi non usano il vicino.
        var neighbour = loc.Type == ReleaseTargetType.Vloa ? await VloaNeighbourAsync(loc.TargetKey) : null;
        var url = DocRoutes.For(loc.Type).ViewerUrl(acc, loc.TargetKey, neighbour, Id) ?? "/services/vsop/versions";
        Nav.NavigateTo(url, replace: true);
    }

    // vLOA: la chiave release è il docId numerico → risolvo il codice del vicino (foreign) dal catalogo documenti.
    private async Task<string?> VloaNeighbourAsync(string targetKey)
    {
        if (!int.TryParse(targetKey, out var docId)) return null;
        return (await DocAdmin.ListAsync())
            .FirstOrDefault(x => x.Kind == ReleaseTargetType.Vloa && x.DocumentId == docId)?.NeighbourCode;
    }
}
