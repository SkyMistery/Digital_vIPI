@page "/services/vsop/admin/diagnostics"
@layout SopLayout
@rendermode InteractiveServer
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Application.Diagnostics
@using Vipi.Application.Auth

@* ⚠️ SCOPE PROPRIO e sentinelle di rientro (revisione del 6 settembre 2026, R-016). La pagina è
   interattiva: il suo `DbContext` è quello del CIRCUITO e vive per ore, quindi un gesto che parte mentre il
   precedente è ancora in volo lo trova occupato e la pagina muore con «A second operation was started on
   this context instance». Qui il caso è concreto: il giro della deriva dura, e «Aggiorna» è lì accanto.

   Lo scope proprio protegge dagli ALTRI, le sentinelle da SÉ STESSI: servono tutte e due, e i due flag che
   già c'erano (`_loading`, `_derivaInCorso`) spegnevano i tasti a schermo senza fermare chi entrava lo
   stesso — un secondo clic prima del render, la scorciatoia di tastiera, un doppio invio. *@
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Diag_Title"] · IVAO Italy</PageTitle>

@* La pagina era a `max-width:1100px`: con il `.wrap` stretto le undici voci della barra admin andavano a
   capo — 75px invece di 55 — e la tabella dei rilievi, che ha quattro colonne di cui due di prosa,
   lavorava in tre quarti di schermo. *@
<div class="wrap struct">
    <AdminNav />

    @* ---- Testata in UNA riga: titolo · conteggio · «?» · Aggiorna · da quando ----
       Il sottotitolo era una fascia che diceva a chiunque, ogni volta, quello che il «?» dice a chi lo
       chiede (regola 7) — ed era anche FALSO: prometteva i soli soft-ref mentre la tabella ospita cinque
       aree. La fascia «sono solo diagnosi, nessun dato è stato modificato» era prosa: sta nel «?». *@
    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Diag_Title"]
            @if (Authz.IsAdmin && !_loading && _errore is null)
            {
                @* ⚠️ Qui zero è VERDE, al contrario dei chip: «nessun rilievo» è davvero una buona notizia,
                   mentre «0 rilievi di schema» è solo una fetta del totale (regola 108). *@
                <span>&nbsp;</span>
                <span class="pill @(_findings.Count == 0 ? "green" : Gravi > 0 ? "red" : "amber")"
                      title="@L["Diag_CountTitle"]">
                    @(_findings.Count == 0 ? L["Diag_CountNone"].Value : L["Diag_Count", _findings.Count, Gravi].Value)
                </span>
            }
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-diagnostica" AriaLabel="@L["Diag_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Diag_Subtitle"]</p>
            @((MarkupString)L["Diag_Intro"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            <nav class="struct-nav">
                @* Il report è una fotografia e costa ~1,3 s: chi ha appena corretto un'incongruenza deve
                   poter chiedere «e adesso?» senza ricaricare la pagina. *@
                <button class="btn ghost" disabled="@_loading" title="@L["Diag_RefreshTitle"]" @onclick="LoadAsync">
                    <Icon Name="refresh" Size="14" /> @L["Diag_Refresh"]
                </button>
            </nav>
            @if (_quando is DateTime q)
            {
                <span class="muted diag-quando">@L["Diag_AsOf", q.ToString("HH:mm:ss 'UTC'")]</span>
            }
        }
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else
    {
        @* ---- Tre domande, due colonne ----
           A sinistra «qualcosa nei dati non torna?», che cresce senza tetto e si legge scorrendo. A destra
           «chi può editare?» e «quanto spazio sprecano le immagini?», che sono compatte e non crescono.
           ⚠️ Non è elenco+dettaglio (regola 140): a destra non c'è il dettaglio di una riga di sinistra, ci
           sono DUE ARGOMENTI DIVERSI. Il pannello si giustifica perché sono tre domande in una pagina.
           E soprattutto: la card delle immagini stava sotto 1 349px e ci sarebbe restata per sempre — più
           rilievi ci sono, più è lontana, ed è proprio quando si scorre meno. *@
        <div class="diag-layout">
            <div class="panel st-pane">
                @if (_errore is not null)
                {
                    @* Il report non è girato. Dirlo è il minimo: senza, la pagina resterebbe vuota e
                       sembrerebbe che non ci sia niente da segnalare — l'esatto contrario di ciò che si sa. *@
                    <div class="callout danger">
                        <span class="cic"><Icon Name="octagon" Size="18" /></span>
                        <div><p class="ct">@L["Diag_Failed"]</p>@_errore</div>
                    </div>
                }
                else
                {
                    <div class="struct-bar">
                        <input class="htree-search" value="@_q" @oninput="e => SetQuery(e.Value?.ToString())"
                               placeholder="@L["Diag_SearchPh"]" />

                        @* I chip contano, e contano per AREA e non per categoria: le categorie sono tredici
                           e crescono con ogni controllo nuovo, le aree sono cinque e rispondono alla domanda
                           «di chi è il problema». ⚠️ Un chip a zero qui è NEUTRO: zero può anche voler dire
                           «quella sonda non gira su questo provider». *@
                        <span class="sb-chips">
                            @foreach (var area in Aree)
                            {
                                var n = Conta(area);
                                <button class="sh-chip @(_area == area ? "on" : "")" disabled="@(n == 0)"
                                        title="@L["Diag_ChipTitle", ConsistencyNarrator.Area(area, L)]"
                                        @onclick="() => ToggleArea(area)">
                                    @ConsistencyNarrator.Area(area, L) <span class="chip-n">@n</span>
                                </button>
                            }
                            <button class="lnk-mini" disabled="@(!Filtra)" @onclick="ClearFilters"
                                    title="@L["Diag_ClearTitle"]" aria-label="@L["Diag_Clear"]">✕</button>
                        </span>
                    </div>

                    @if (_findings.Count == 0)
                    {
                        <div class="callout"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@L["Diag_NoIssues"]</div></div>
                    }
                    else if (Filtrate.Count == 0)
                    {
                        <p class="help">@L["Diag_NoneInFilter"]</p>
                    }
                    else
                    {
                        <div class="st-scroll">
                            <table class="res-table sticky-head diag-table">
                                <thead>
                                    <tr>
                                        <th class="c-cat">@L["Diag_Category"]</th>
                                        <th class="c-ent">@L["Diag_Entity"]</th>
                                        <th class="c-det">@L["Diag_Detail"]</th>
                                        <th class="c-where">@L["Diag_Where"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Filtrate)
                                    {
                                        <tr>
                                            @* La gravità era una colonna intera per ripetere GRAVE/AVVISO a
                                               ogni riga: è una pill sulla categoria, che è la cosa che
                                               qualifica. *@
                                            <td class="c-cat">
                                                <span class="pill @(f.Severity == ConsistencySeverity.Error ? "red" : "amber")">
                                                    @L[f.Severity == ConsistencySeverity.Error ? "Diag_Severe" : "Diag_Warning"]
                                                </span>
                                                <div class="diag-cat">@ConsistencyNarrator.Categoria(f, L)</div>
                                            </td>
                                            <td class="c-ent">@ConsistencyNarrator.Bersaglio(f, L)</td>
                                            @* ⚠️ Dal narratore, non dal finding: categoria e dettaglio nascono
                                               in italiano perché li leggono anche l'health check e i log,
                                               dove una lingua d'interfaccia non c'è. *@
                                            <td class="c-det muted">@ConsistencyNarrator.Dettaglio(f, L)</td>
                                            <td class="c-where">
                                                @* Vuoto quando non c'è un posto da aprire: server, schema e
                                                   configurazione si correggono fuori dall'applicazione, e un
                                                   link che non porta da nessuna parte è peggio di nessun link. *@
                                                @if (f.Where is { Length: > 0 } dove)
                                                {
                                                    <a class="lnk-mini" href="@dove">@Dove(dove)</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>

            @* --- DESTRA: le altre due domande --- *@
            <div class="diag-side">
                @* Chi può editare: i pattern admin configurati contro i codici staff VERI, quelli visti ai
                   login. Si guarda anche — anzi soprattutto — quando non c'è alcun rilievo: serve a
                   confermare che i pattern siano quelli giusti, non solo a segnalare quando non lo sono. *@
                @if (_admin is not null)
                {
                    <div class="panel diag-card">
                        <div class="doc-head st-head diag-card-head">
                            <h2 class="h-sect st-h2"><Icon Name="key" Size="15" /> @L["Diag_AdminTitle"]</h2>
                            @* I pattern sono espressioni regolari: due righe di configurazione sempre a
                               schermo, che servono QUANDO qualcosa non torna. Nel «?», col loro perché. *@
                            <HelpHint AriaLabel="@L["Diag_AdminHelpAria"]" ExtraClass="wide">
                                <p style="margin:0 0 6px">@L["Diag_AdminHint"]</p>
                                <p style="margin:0 0 6px"><b>@L["Diag_AdminPatterns"]</b><br />
                                    <code>@string.Join(" · ", _admin.Patterns)</code></p>
                                @* I pattern degli altri due livelli ci sono per la stessa ragione dei primi:
                                   se un chief non risulta Redattore, il motivo si legge qui. *@
                                <p style="margin:0 0 6px"><b>@L["Roles_Level_Editor"]</b><br />
                                    <code>@string.Join(" · ", _admin.EditorPatterns)</code></p>
                                <p style="margin:0"><b>@L["Roles_Level_DivisionStaff"]</b><br />
                                    <code>@string.Join(" · ", _admin.DivisionStaffPatterns)</code></p>
                            </HelpHint>
                        </div>

                        @if (_admin.RosterEmpty)
                        {
                            <p class="help">@L["Diag_AdminNoRoster"]</p>
                        }
                        else
                        {
                            <div class="st-scroll">
                                <table class="res-table diag-admin">
                                    <thead><tr><th>VID</th><th>@L["Common_Name"]</th><th>@L["Roles_Level"]</th><th>@L["Diag_AdminIsAdmin"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var r in _admin.Rows)
                                        {
                                            @* I codici osservati sono nel `title`: la colonna era la più
                                               larga e ripeteva dati che servono solo quando NON combaciano. *@
                                            <tr title="@L["Diag_AdminCodes"]: @(r.Codes.Count == 0 ? "—" : string.Join(", ", r.Codes))">
                                                <td><VidLink Vid="r.UserId" SoloNumero="true" /></td>
                                                <td>@(r.DisplayName ?? "—")</td>
                                                @* Il pallino distingue chi ha quel livello per codice staff da
                                                   chi l'ha per promozione a mano: senza, una diagnosi che dice
                                                   «è Redattore» non dice PERCHE'. *@
                                                <td title="@(r.Promosso ? L["Roles_FromOverride"] : L["Roles_FromStaff"])">
                                                    @L[$"Roles_Level_{r.Level}"]@(r.Promosso ? " •" : "")
                                                </td>
                                                <td>
                                                    @if (r.Matched.Count > 0)
                                                    { <span class="pill green">@string.Join(", ", r.Matched)</span> }
                                                    else
                                                    { <span class="muted">—</span> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (!_admin.AnyAdmin)
                            {
                                <div class="callout danger" style="margin-top:10px">
                                    <span class="cic"><Icon Name="octagon" Size="18" /></span>
                                    <div>@L["Diag_AdminNobody"]</div>
                                </div>
                            }
                        }
                    </div>
                }

                @* La casella degli impatti: che cosa, a monte, ha toccato i documenti. Sta QUI e non nella
                   pagina Sorgenti perché il giro che la alimenta non interroga nessuna sorgente — quell'elenco
                   si intitola «stato degli import», e una riga che non importa niente lì dentro mentirebbe
                   (è la stessa ragione per cui ne resta fuori la riconciliazione delle aree estere). *@
                <div class="panel diag-card">
                    <div class="doc-head st-head diag-card-head">
                        <h2 class="h-sect st-h2"><Icon Name="warning" Size="15" /> @L["Diag_ImpactsTitle"]</h2>
                        <HelpHint AriaLabel="@L["Diag_ImpactsTitle"]" ExtraClass="wide">
                            <p style="margin:0">@L["Diag_ImpactsHint"]</p>
                        </HelpHint>
                    </div>

                    @if (_impatti.Count == 0)
                    {
                        <p class="help">@L["Diag_ImpactsNone"]</p>
                    }
                    else
                    {
                        <table class="res-table">
                            <thead><tr><th>@L["Diag_ImpactsKind"]</th><th>@L["Diag_ImpactsOpen"]</th></tr></thead>
                            <tbody>
                                @foreach (var r in _impatti.OrderByDescending(x => x.Value))
                                {
                                    <tr><td>@L["ImpactKind_" + r.Key.ToString()]</td><td>@r.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    }

                    @* L'ultimo giro: senza questa riga, «zero segnalazioni» e «il controllo non gira da tre
                       giorni» si leggono allo stesso modo. *@
                    <p class="help" style="margin-top:10px">
                        @if (_ultimaDeriva is { } q)
                        {
                            @L["Diag_ImpactsLastRun"]
                            <b data-utc="@VipiTime.Iso(q)">@VipiTime.DayZ(q)</b>
                        }
                        else
                        {
                            @L["Diag_ImpactsNeverRun"]
                        }
                        @if (_erroreDeriva is { } e)
                        {
                            <br />
                            <span class="warn">@e</span>
                        }
                    </p>

                    @* ⚠️ L'ALTRA metà della deriva, e un guasto tutto suo: la riconciliazione che la
                       PUBBLICAZIONE chiede per il documento appena scritto è a prova di guasto — se salta, la
                       release resta pubblicata e la rete è il giro qui sopra — ma fino all'8 settembre 2026
                       saltava in SILENZIO, e il sintomo era identico al difetto che era andata a togliere:
                       «ho ripubblicato e l'avviso è ancora lì». Riga separata da quella del giro perché sono
                       due guasti con due rimedi. *@
                    @if (_erroreDerivaPubblicazione is { } ep)
                    {
                        <div class="callout warning" style="margin-top:6px">
                            <span class="cic"><Icon Name="warning" Size="18" /></span>
                            <div>@L["Diag_ImpactsOnPublishFailed", _tentativoDerivaPubblicazione is { } qp ? VipiTime.DayZ(qp) : "?", ep]</div>
                        </div>
                    }

                    @* ⚠️ «Vecchio» non è «non ha girato»: il giro dorme 24 ore fra una passata e l'altra, e
                       riparte da capo a ogni riavvio del processo. Su un host che ricicla spesso può non
                       arrivare MAI alla scadenza — e allora la data resta ferma mentre la lista continua a
                       chiedere lavoro già fatto. Senza questa riga il sintomo è indistinguibile da un bug
                       della deriva. *@
                    @if (DerivaVecchia)
                    {
                        <div class="callout warning" style="margin-top:6px">
                            <span class="cic"><Icon Name="warning" Size="18" /></span>
                            <div>@L["Diag_ImpactsStale"]</div>
                        </div>
                    }

                    @* Il gesto che mancava: fino al 7 settembre 2026 la riga «da ripubblicare» si poteva solo
                       ASPETTARE. Ora la pubblicazione la richiude da sé, e questo resta per il resto — un
                       cambio di catalogo, un import — e per rispondere a «ha girato davvero?». *@
                    <div style="margin-top:8px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                        <button class="btn ghost" disabled="@(_derivaInCorso || _loading)" @onclick="RilanciaDerivaAsync">
                            <Icon Name="refresh" Size="15" /> @L["Diag_ImpactsRun"]
                        </button>
                        @if (_esitoDeriva is { } esito)
                        {
                            <span class="help">@esito</span>
                        }
                    </div>
                </div>

                @* Manutenzione del deposito immagini: sta qui perché è la pagina delle azioni di manutenzione
                   ed è già riservata agli admin. Il quadro di consistenza può essere pulito e lo spazio da
                   recuperare esserci lo stesso. *@
                <MediaCleanupCard />
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConsistencyFinding> _findings = Array.Empty<ConsistencyFinding>();
    private AdminCoverage? _admin;

    // La casella degli impatti: quante righe aperte per tipo, e quando ha girato l'ultima volta il controllo.
    private IReadOnlyDictionary<Vipi.Domain.ImpactKind, int> _impatti = new Dictionary<Vipi.Domain.ImpactKind, int>();
    private DateTime? _ultimaDeriva;
    private string? _erroreDeriva;

    /// <summary>L'ultimo guasto della riconciliazione chiesta dalla <b>pubblicazione</b> (chiave
    /// <c>ImpactDriftOnPublish</c>), e quando è successo. Null = l'ultima è andata bene, o non è mai stata
    /// tentata. È un guasto diverso da quello del giro: vedi il markup.</summary>
    private string? _erroreDerivaPubblicazione;
    private DateTime? _tentativoDerivaPubblicazione;
    private bool _derivaInCorso;
    private string? _esitoDeriva;

    /// <summary>Oltre quanto un giro da 24 ore è «non sta girando» invece di «ha girato stanotte». Trentasei
    /// ore: un giro può slittare di qualche ora (riavvio, retry, host lento) senza che sia un guasto, ma a
    /// una volta e mezza il periodo la spiegazione innocente non c'è più.</summary>
    private static readonly TimeSpan DerivaScaduta = TimeSpan.FromHours(36);

    private bool DerivaVecchia => _ultimaDeriva is { } u && DateTime.UtcNow - u > DerivaScaduta;
    private bool _loading = true;

    /// <summary>Un giro di letture è già in volo. ⚠️ Si alza <b>prima</b> del primo <c>await</c>, ed è un flag
    /// diverso da <see cref="_loading"/>: quello serve allo schermo e nasce acceso.</summary>
    private bool _inCorso;
    private string? _errore;
    private DateTime? _quando;

    private string _q = "";
    private ConsistencyArea? _area;

    private static readonly ConsistencyArea[] Aree = Enum.GetValues<ConsistencyArea>();

    // I servizi che interrogano il database: dallo SCOPE DI QUESTA PAGINA. Vedi il commento in testa al file.
    // ⚠️ `IEditAuthorizationService` resta quello del circuito: risponde dai claim, non dal database, ed è
    // memoizzato per scope — riprenderlo da un altro scope vorrebbe dire rifare il giro dell'identità.
    private IConsistencyReportService Consistency = default!;
    private Vipi.Application.Content.IDocumentImpactService Impacts = default!;
    private Vipi.Application.Abstractions.IImportStateStore ImportStates = default!;
    private Vipi.Application.Content.IImpactDriftUseCase Deriva = default!;
    private IAdminCoverageService AdminCoverage = default!;

    protected override async Task OnInitializedAsync()
    {
        Consistency = ScopedServices.GetRequiredService<IConsistencyReportService>();
        Impacts = ScopedServices.GetRequiredService<Vipi.Application.Content.IDocumentImpactService>();
        ImportStates = ScopedServices.GetRequiredService<Vipi.Application.Abstractions.IImportStateStore>();
        Deriva = ScopedServices.GetRequiredService<Vipi.Application.Content.IImpactDriftUseCase>();
        AdminCoverage = ScopedServices.GetRequiredService<IAdminCoverageService>();

        if (!Authz.IsAdmin) { _loading = false; return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Authz.IsAdmin) return;
        // «Schermo meno ciò che sta sopra» non è esprimibile in CSS: si misura, e a OGNI render — il «?»
        // aperto e la fascia dell'ora cambiano ciò che sta sopra.
        //
        // ⚠️ Qui `vipiFitViewport` (`height`) e non `vipiCapViewport` (`max-height`), al contrario di
        // Sorgenti: là il contenuto era corto e fisso, qui l'elenco cresce senza tetto — otto rilievi fanno
        // 480px di tabella, cinquanta ne farebbero tremila. Il riquadro va stirato, e dentro scorre.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".diag-layout", 900); } catch (Exception) { }
    }

    /// <summary>
    /// ⚠️ La pagina che serve a capire cosa non va non può morire perché qualcosa non va. Le singole sonde si
    /// proteggono da sé (il guasto esce come rilievo, vedi <c>ConsistencyReportService</c>), ma la rete qui
    /// resta: senza, una qualunque eccezione lascia il circuito Blazor morto e il motivo solo nei log.
    /// </summary>
    private async Task LoadAsync()
    {
        // ⚠️ La sentinella è un flag SUO e non `_loading`, che nasce a true per far vedere lo scheletro
        // prima della prima lettura: leggere quello rifiuterebbe proprio il primo giro.
        if (_inCorso) return;
        _inCorso = true;
        _loading = true;
        _errore = null;
        try
        {
            // Grave prima, poi per categoria: la lista più urgente in cima.
            var all = await Consistency.RunAsync();
            _findings = all.OrderByDescending(f => f.Severity).ThenBy(f => f.Category).ToList();
            _admin = await AdminCoverage.DescribeAsync();

            var aperti = new Dictionary<Vipi.Domain.ImpactKind, int>();
            foreach (var k in Enum.GetValues<Vipi.Domain.ImpactKind>())
            {
                var n = (await Impacts.ListOpenByKindCountAsync(k)) ;
                if (n > 0) aperti[k] = n;
            }
            _impatti = aperti;

            // Una lettura sola per due chiavi: il giro giornaliero e la riconciliazione della pubblicazione.
            var stati = await ImportStates.GetAllAsync();
            var stato = stati
                .FirstOrDefault(x => x.Category == Vipi.Application.Abstractions.ImportCategories.ImpactDrift);
            _ultimaDeriva = stato?.LastSuccessUtc == default ? null : stato?.LastSuccessUtc;
            _erroreDeriva = string.IsNullOrWhiteSpace(stato?.LastError) ? null : stato!.LastError;

            var statoPub = stati
                .FirstOrDefault(x => x.Category == Vipi.Application.Abstractions.ImportCategories.ImpactDriftOnPublish);
            _erroreDerivaPubblicazione = string.IsNullOrWhiteSpace(statoPub?.LastError) ? null : statoPub!.LastError;
            _tentativoDerivaPubblicazione = statoPub?.LastAttemptUtc;
            _quando = DateTime.UtcNow;
        }
        catch (Exception ex) { _errore = ex.Message; }
        finally { _loading = false; _inCorso = false; }
    }

    /// <summary>
    /// Rilancia il giro della deriva adesso, e ricarica il quadro con l'esito.
    ///
    /// <para>⚠️ Marca il successo come lo marcherebbe il giro automatico: la data che si legge sopra deve
    /// dire «l'ultima volta che questo controllo è passato», non «l'ultima volta che è passato da solo» —
    /// altrimenti un rilancio a mano lascerebbe la pagina a dichiarare un ritardo che non c'è più.</para>
    ///
    /// <para>⚠️ Il guasto si mostra, non si inghiotte: è la pagina che serve a capire cosa non va.</para>
    /// </summary>
    private async Task RilanciaDerivaAsync()
    {
        if (!Authz.IsAdmin) return;
        if (_derivaInCorso || _inCorso) return;   // la stessa sentinella, sull'altra porta
        _derivaInCorso = true;
        _esitoDeriva = null;
        try
        {
            var esito = await Deriva.RunAsync();
            await ImportStates.MarkSuccessAsync(
                Vipi.Application.Abstractions.ImportCategories.ImpactDrift, DateTime.UtcNow);
            _esitoDeriva = string.Format(L["Diag_ImpactsRunDone"], esito.Esaminati, esito.Aperti, esito.Chiusi);
            await LoadAsync();
        }
        catch (Exception ex) { _esitoDeriva = ex.Message; }
        finally { _derivaInCorso = false; }
    }

    private int Gravi => _findings.Count(f => f.Severity == ConsistencySeverity.Error);

    /// <summary>I rilievi di un'area. È il numero che il chip mostra, e la somma dei chip è il totale.</summary>
    private int Conta(ConsistencyArea area) => _findings.Count(f => f.Area == area);

    private bool Filtra => _area is not null || _q.Length > 0;

    private IReadOnlyList<ConsistencyFinding> Filtrate => _findings
        .Where(f => _area is null || f.Area == _area)
        .Where(f => _q.Length == 0 || Cerca(f))
        .ToList();

    /// <summary>La ricerca guarda quello che si legge — categoria tradotta e dettaglio tradotto — <b>più</b>
    /// il testo grezzo: chi cerca «dangling» lo cerca perché l'ha letto in un log, non in pagina.</summary>
    private bool Cerca(ConsistencyFinding f) =>
        (f.Entity + " " + f.Category + " " + f.Detail + " " + ConsistencyNarrator.Bersaglio(f, L) + " " +
         ConsistencyNarrator.Categoria(f, L) + " " + ConsistencyNarrator.Dettaglio(f, L))
        .Contains(_q, StringComparison.OrdinalIgnoreCase);

    private void SetQuery(string? v) => _q = (v ?? "").Trim();

    private void ToggleArea(ConsistencyArea area) => _area = _area == area ? null : area;

    private void ClearFilters()
    {
        _area = null;
        _q = "";
    }

    /// <summary>Il nome della pagina a cui il rilievo manda. Le rotte le dichiara chi produce il rilievo:
    /// qui si traduce solo l'etichetta, con le stesse parole della barra admin — un vocabolario solo.</summary>
    private string Dove(string rotta) => rotta switch
    {
        "/services/vsop/admin/transfers" => L["Home_TransfersTitle"],
        "/services/vsop/admin/sector-structure" => L["Struct_Title"],
        "/services/vsop/versions" => L["Nav_Docs"],
        _ => rotta,
    };
}
