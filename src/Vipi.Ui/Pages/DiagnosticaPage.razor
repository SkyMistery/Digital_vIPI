@page "/services/vsop/admin/diagnostics"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Diagnostics
@using Vipi.Application.Auth
@inject IConsistencyReportService Consistency
@inject IAdminCoverageService AdminCoverage
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Diag_Title"] · IVAO Italia</PageTitle>

@* La pagina era a `max-width:1100px`: con il `.wrap` stretto le undici voci della barra admin andavano a
   capo — 75px invece di 55 — e la tabella dei rilievi, che ha quattro colonne di cui due di prosa,
   lavorava in tre quarti di schermo. *@
<div class="wrap struct">
    <AdminNav />

    @* ---- Testata in UNA riga: titolo · conteggio · «?» · Aggiorna · da quando ----
       Il sottotitolo era una fascia che diceva a chiunque, ogni volta, quello che il «?» dice a chi lo
       chiede (regola 7) — ed era anche FALSO: prometteva i soli soft-ref mentre la tabella ospita cinque
       aree. La fascia «sono solo diagnosi, nessun dato è stato modificato» era prosa: sta nel «?». *@
    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Diag_Title"]
            @if (Authz.IsAdmin && !_loading && _errore is null)
            {
                @* ⚠️ Qui zero è VERDE, al contrario dei chip: «nessun rilievo» è davvero una buona notizia,
                   mentre «0 rilievi di schema» è solo una fetta del totale (regola 108). *@
                <span>&nbsp;</span>
                <span class="pill @(_findings.Count == 0 ? "green" : Gravi > 0 ? "red" : "amber")"
                      title="@L["Diag_CountTitle"]">
                    @(_findings.Count == 0 ? L["Diag_CountNone"].Value : L["Diag_Count", _findings.Count, Gravi].Value)
                </span>
            }
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-diagnostica" AriaLabel="@L["Diag_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Diag_Subtitle"]</p>
            @((MarkupString)L["Diag_Intro"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            <nav class="struct-nav">
                @* Il report è una fotografia e costa ~1,3 s: chi ha appena corretto un'incongruenza deve
                   poter chiedere «e adesso?» senza ricaricare la pagina. *@
                <button class="btn ghost" disabled="@_loading" title="@L["Diag_RefreshTitle"]" @onclick="LoadAsync">
                    <Icon Name="refresh" Size="14" /> @L["Diag_Refresh"]
                </button>
            </nav>
            @if (_quando is DateTime q)
            {
                <span class="muted diag-quando">@L["Diag_AsOf", q.ToString("HH:mm:ss 'UTC'")]</span>
            }
        }
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else
    {
        @* ---- Tre domande, due colonne ----
           A sinistra «qualcosa nei dati non torna?», che cresce senza tetto e si legge scorrendo. A destra
           «chi può editare?» e «quanto spazio sprecano le immagini?», che sono compatte e non crescono.
           ⚠️ Non è elenco+dettaglio (regola 140): a destra non c'è il dettaglio di una riga di sinistra, ci
           sono DUE ARGOMENTI DIVERSI. Il pannello si giustifica perché sono tre domande in una pagina.
           E soprattutto: la card delle immagini stava sotto 1 349px e ci sarebbe restata per sempre — più
           rilievi ci sono, più è lontana, ed è proprio quando si scorre meno. *@
        <div class="diag-layout">
            <div class="panel st-pane">
                @if (_errore is not null)
                {
                    @* Il report non è girato. Dirlo è il minimo: senza, la pagina resterebbe vuota e
                       sembrerebbe che non ci sia niente da segnalare — l'esatto contrario di ciò che si sa. *@
                    <div class="callout danger">
                        <span class="cic"><Icon Name="octagon" Size="18" /></span>
                        <div><p class="ct">@L["Diag_Failed"]</p>@_errore</div>
                    </div>
                }
                else
                {
                    <div class="struct-bar">
                        <input class="htree-search" value="@_q" @oninput="e => SetQuery(e.Value?.ToString())"
                               placeholder="@L["Diag_SearchPh"]" />

                        @* I chip contano, e contano per AREA e non per categoria: le categorie sono tredici
                           e crescono con ogni controllo nuovo, le aree sono cinque e rispondono alla domanda
                           «di chi è il problema». ⚠️ Un chip a zero qui è NEUTRO: zero può anche voler dire
                           «quella sonda non gira su questo provider». *@
                        <span class="sb-chips">
                            @foreach (var area in Aree)
                            {
                                var n = Conta(area);
                                <button class="sh-chip @(_area == area ? "on" : "")" disabled="@(n == 0)"
                                        title="@L["Diag_ChipTitle", ConsistencyNarrator.Area(area, L)]"
                                        @onclick="() => ToggleArea(area)">
                                    @ConsistencyNarrator.Area(area, L) <span class="chip-n">@n</span>
                                </button>
                            }
                            <button class="lnk-mini" disabled="@(!Filtra)" @onclick="ClearFilters"
                                    title="@L["Diag_ClearTitle"]" aria-label="@L["Diag_Clear"]">✕</button>
                        </span>
                    </div>

                    @if (_findings.Count == 0)
                    {
                        <div class="callout"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@L["Diag_NoIssues"]</div></div>
                    }
                    else if (Filtrate.Count == 0)
                    {
                        <p class="help">@L["Diag_NoneInFilter"]</p>
                    }
                    else
                    {
                        <div class="st-scroll">
                            <table class="res-table sticky-head diag-table">
                                <thead>
                                    <tr>
                                        <th class="c-cat">@L["Diag_Category"]</th>
                                        <th class="c-ent">@L["Diag_Entity"]</th>
                                        <th class="c-det">@L["Diag_Detail"]</th>
                                        <th class="c-where">@L["Diag_Where"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Filtrate)
                                    {
                                        <tr>
                                            @* La gravità era una colonna intera per ripetere GRAVE/AVVISO a
                                               ogni riga: è una pill sulla categoria, che è la cosa che
                                               qualifica. *@
                                            <td class="c-cat">
                                                <span class="pill @(f.Severity == ConsistencySeverity.Error ? "red" : "amber")">
                                                    @L[f.Severity == ConsistencySeverity.Error ? "Diag_Severe" : "Diag_Warning"]
                                                </span>
                                                <div class="diag-cat">@ConsistencyNarrator.Categoria(f, L)</div>
                                            </td>
                                            <td class="c-ent">@ConsistencyNarrator.Bersaglio(f, L)</td>
                                            @* ⚠️ Dal narratore, non dal finding: categoria e dettaglio nascono
                                               in italiano perché li leggono anche l'health check e i log,
                                               dove una lingua d'interfaccia non c'è. *@
                                            <td class="c-det muted">@ConsistencyNarrator.Dettaglio(f, L)</td>
                                            <td class="c-where">
                                                @* Vuoto quando non c'è un posto da aprire: server, schema e
                                                   configurazione si correggono fuori dall'applicazione, e un
                                                   link che non porta da nessuna parte è peggio di nessun link. *@
                                                @if (f.Where is { Length: > 0 } dove)
                                                {
                                                    <a class="lnk-mini" href="@dove">@Dove(dove)</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>

            @* --- DESTRA: le altre due domande --- *@
            <div class="diag-side">
                @* Chi può editare: i pattern admin configurati contro i codici staff VERI, quelli visti ai
                   login. Si guarda anche — anzi soprattutto — quando non c'è alcun rilievo: serve a
                   confermare che i pattern siano quelli giusti, non solo a segnalare quando non lo sono. *@
                @if (_admin is not null)
                {
                    <div class="panel diag-card">
                        <div class="doc-head st-head diag-card-head">
                            <h3 class="st-h2"><Icon Name="key" Size="15" /> @L["Diag_AdminTitle"]</h3>
                            @* I pattern sono espressioni regolari: due righe di configurazione sempre a
                               schermo, che servono QUANDO qualcosa non torna. Nel «?», col loro perché. *@
                            <HelpHint AriaLabel="@L["Diag_AdminHelpAria"]" ExtraClass="wide">
                                <p style="margin:0 0 6px">@L["Diag_AdminHint"]</p>
                                <p style="margin:0"><b>@L["Diag_AdminPatterns"]</b><br />
                                    <code>@string.Join(" · ", _admin.Patterns)</code></p>
                            </HelpHint>
                        </div>

                        @if (_admin.RosterEmpty)
                        {
                            <p class="help">@L["Diag_AdminNoRoster"]</p>
                        }
                        else
                        {
                            <div class="st-scroll">
                                <table class="res-table diag-admin">
                                    <thead><tr><th>VID</th><th>@L["Common_Name"]</th><th>@L["Diag_AdminIsAdmin"]</th></tr></thead>
                                    <tbody>
                                        @foreach (var r in _admin.Rows)
                                        {
                                            @* I codici osservati sono nel `title`: la colonna era la più
                                               larga e ripeteva dati che servono solo quando NON combaciano. *@
                                            <tr title="@L["Diag_AdminCodes"]: @(r.Codes.Count == 0 ? "—" : string.Join(", ", r.Codes))">
                                                <td>@r.UserId</td>
                                                <td>@(r.DisplayName ?? "—")</td>
                                                <td>
                                                    @if (r.Matched.Count > 0)
                                                    { <span class="pill green">@string.Join(", ", r.Matched)</span> }
                                                    else
                                                    { <span class="muted">—</span> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (!_admin.AnyAdmin)
                            {
                                <div class="callout danger" style="margin-top:10px">
                                    <span class="cic"><Icon Name="octagon" Size="18" /></span>
                                    <div>@L["Diag_AdminNobody"]</div>
                                </div>
                            }
                        }
                    </div>
                }

                @* Manutenzione del deposito immagini: sta qui perché è la pagina delle azioni di manutenzione
                   ed è già riservata agli admin. Il quadro di consistenza può essere pulito e lo spazio da
                   recuperare esserci lo stesso. *@
                <MediaCleanupCard />
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConsistencyFinding> _findings = Array.Empty<ConsistencyFinding>();
    private AdminCoverage? _admin;
    private bool _loading = true;
    private string? _errore;
    private DateTime? _quando;

    private string _q = "";
    private ConsistencyArea? _area;

    private static readonly ConsistencyArea[] Aree = Enum.GetValues<ConsistencyArea>();

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) { _loading = false; return; }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Authz.IsAdmin) return;
        // «Schermo meno ciò che sta sopra» non è esprimibile in CSS: si misura, e a OGNI render — il «?»
        // aperto e la fascia dell'ora cambiano ciò che sta sopra.
        //
        // ⚠️ Qui `vipiFitViewport` (`height`) e non `vipiCapViewport` (`max-height`), al contrario di
        // Sorgenti: là il contenuto era corto e fisso, qui l'elenco cresce senza tetto — otto rilievi fanno
        // 480px di tabella, cinquanta ne farebbero tremila. Il riquadro va stirato, e dentro scorre.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".diag-layout", 900); } catch (Exception) { }
    }

    /// <summary>
    /// ⚠️ La pagina che serve a capire cosa non va non può morire perché qualcosa non va. Le singole sonde si
    /// proteggono da sé (il guasto esce come rilievo, vedi <c>ConsistencyReportService</c>), ma la rete qui
    /// resta: senza, una qualunque eccezione lascia il circuito Blazor morto e il motivo solo nei log.
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _errore = null;
        try
        {
            // Grave prima, poi per categoria: la lista più urgente in cima.
            var all = await Consistency.RunAsync();
            _findings = all.OrderByDescending(f => f.Severity).ThenBy(f => f.Category).ToList();
            _admin = await AdminCoverage.DescribeAsync();
            _quando = DateTime.UtcNow;
        }
        catch (Exception ex) { _errore = ex.Message; }
        finally { _loading = false; }
    }

    private int Gravi => _findings.Count(f => f.Severity == ConsistencySeverity.Error);

    /// <summary>I rilievi di un'area. È il numero che il chip mostra, e la somma dei chip è il totale.</summary>
    private int Conta(ConsistencyArea area) => _findings.Count(f => f.Area == area);

    private bool Filtra => _area is not null || _q.Length > 0;

    private IReadOnlyList<ConsistencyFinding> Filtrate => _findings
        .Where(f => _area is null || f.Area == _area)
        .Where(f => _q.Length == 0 || Cerca(f))
        .ToList();

    /// <summary>La ricerca guarda quello che si legge — categoria tradotta e dettaglio tradotto — <b>più</b>
    /// il testo grezzo: chi cerca «dangling» lo cerca perché l'ha letto in un log, non in pagina.</summary>
    private bool Cerca(ConsistencyFinding f) =>
        (f.Entity + " " + f.Category + " " + f.Detail + " " + ConsistencyNarrator.Bersaglio(f, L) + " " +
         ConsistencyNarrator.Categoria(f, L) + " " + ConsistencyNarrator.Dettaglio(f, L))
        .Contains(_q, StringComparison.OrdinalIgnoreCase);

    private void SetQuery(string? v) => _q = (v ?? "").Trim();

    private void ToggleArea(ConsistencyArea area) => _area = _area == area ? null : area;

    private void ClearFilters()
    {
        _area = null;
        _q = "";
    }

    /// <summary>Il nome della pagina a cui il rilievo manda. Le rotte le dichiara chi produce il rilievo:
    /// qui si traduce solo l'etichetta, con le stesse parole della barra admin — un vocabolario solo.</summary>
    private string Dove(string rotta) => rotta switch
    {
        "/services/vsop/admin/transfers" => L["Home_TransfersTitle"],
        "/services/vsop/admin/sector-structure" => L["Struct_Title"],
        "/services/vsop/versions" => L["Nav_Docs"],
        _ => rotta,
    };
}
