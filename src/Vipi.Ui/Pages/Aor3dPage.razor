@* DISABILITATA (rebuild /vsop, Round 12) — rotta rimossa. Ex: "/vsop/{Acc}/aor3d". Vedi PAGINE_DISABILITATE.md *@
@layout SopLayout
@inject IStationResolver Stations

<PageTitle>AoR 3D — @(_acc?.Name) · IVAO Italia</PageTitle>

<div class="wrap">
    <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc?.Name</a> › <b>AoR 3D</b></div>
    <div class="doc-head"><div><h2 style="margin-bottom:2px">AoR 3D — @_acc?.Name</h2><span class="muted">Volumi dei settori per quota · interagenze laterali e verticali</span></div><span class="airac">📅 AIRAC 2606</span></div>
    <div class="callout info"><span class="cic">🧊</span><div><p class="ct">Vista tridimensionale</p>Ogni settore è un <b>volume</b> esteso dalla sua quota inferiore a quella superiore. Le sovrapposizioni mostrano le interagenze (es. un settore basso sotto uno alto). <em>Rappresentazione statica: la resa 3D interattiva (Three.js, orbit/zoom) e le shape reali dal database IVAO arrivano in una fase successiva.</em></div></div>
    <div class="aor3d-bar">
        <button class="btn ghost">↺ Reset vista</button>
        <span class="muted" style="font-size:12.5px">Settori della FIR Roma (dati illustrativi).</span>
    </div>

    <div id="aor3d-stage" style="cursor:default">
        <div class="aor3d-legend">
            <div class="lgt">Settori</div>
            <div class="lg-row"><span class="sw" style="background:#0D2C99"></span> NE alto <span class="fl">FL355–660</span></div>
            <div class="lg-row"><span class="sw" style="background:#3C55AC"></span> NE basso <span class="fl">FL245–355</span></div>
            <div class="lg-row"><span class="sw" style="background:#2EC662"></span> EW <span class="fl">FL245–640</span></div>
            <div class="lg-row"><span class="sw" style="background:#7EA2D6"></span> SU <span class="fl">FL245–460</span></div>
            <div class="lg-row"><span class="sw" style="background:#F9CC2C"></span> TS <span class="fl">FL245–345</span></div>
        </div>
        <div class="aor3d-hint">🧊 anteprima isometrica (volumi impilati per quota)</div>

        <svg viewBox="0 0 600 460" width="100%" height="100%" style="display:block">
            <g transform="translate(300,250)">
                @* volumi estrusi isometrici: faccia superiore + lati, impilati per fascia di quota *@
                <g opacity="0.92">
                    <polygon points="-150,-30 0,-95 150,-30 0,35" fill="#7EA2D6" fill-opacity="0.5" stroke="#3C55AC" />
                    <polygon points="-150,-30 0,35 0,95 -150,30" fill="#5d77c0" fill-opacity="0.5" stroke="#3C55AC" />
                    <polygon points="150,-30 0,35 0,95 150,30" fill="#4a63b0" fill-opacity="0.5" stroke="#3C55AC" />
                </g>
                <g transform="translate(0,-70)" opacity="0.92">
                    <polygon points="-150,-30 0,-95 150,-30 0,35" fill="#2EC662" fill-opacity="0.45" stroke="#0f7a37" />
                    <polygon points="-150,-30 0,35 0,95 -150,30" fill="#26a653" fill-opacity="0.5" stroke="#0f7a37" />
                    <polygon points="150,-30 0,35 0,95 150,30" fill="#1f8a45" fill-opacity="0.5" stroke="#0f7a37" />
                </g>
                <g transform="translate(0,-150)" opacity="0.95">
                    <polygon points="-150,-30 0,-95 150,-30 0,35" fill="#0D2C99" fill-opacity="0.45" stroke="#0D2C99" />
                    <polygon points="-150,-30 0,35 0,95 -150,30" fill="#0a2480" fill-opacity="0.5" stroke="#0D2C99" />
                    <polygon points="150,-30 0,35 0,95 150,30" fill="#0a2480" fill-opacity="0.5" stroke="#0D2C99" />
                    <text x="0" y="-30" font-family="Nunito Sans" font-size="16" fill="#fff" font-weight="700" text-anchor="middle">NE alto</text>
                </g>
            </g>
        </svg>
    </div>
</div>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    private AccInfo? _acc;
    protected override void OnParametersSet() => _acc = Stations.Resolve(Acc);
}
