@page "/services/vsop/{Acc}/apps/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IEditAuthorizationService Authz
@inject AppMemberLoader Loader
@inject IDocumentUnionService Unioni
@inject UnionLoader Membri
@inject NavigationManager Nav
@inject IOnlineAtcProvider Online
@inject Vipi.Application.Live.ILiveViewService VistaLive
@inject IAiracService Airac
@inject StringheDelSito Sito
@inject EnglishStrings En
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@Sito["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_doc is null)
{
    <div class="wrap"><div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@Sito["Appn_AppNotAvailTitle"]</p>@((MarkupString)string.Format(Sito["Appn_AppNotFoundBody"], _app, $"/services/vsop/{Acc.ToLowerInvariant()}/apps/editor?app={_app}"))</div></div></div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_doc.DisplayName · vIPI IVAO Italy</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/apps">@En["AccLanding_Apps"]</a> › <b>@_app</b></div>
        <div class="doc-layout">
            @* ⚠️ L'indice sta QUI, nella cella sorella del corpo, e prende la STESSA ancora del corpo:
               `AppDocumentBody.AnchorOf`. Un'ancora diversa manda l'indice su un id che non esiste, e i
               suoi link non fanno niente — senza errori. *@
            @* ⚠️ Un GRUPPO per membro, intestato col titolo del suo documento: un elenco di dieci voci
               d'avvicinamento seguito da ventisei voci militari, senza una riga che dica dove finisce l'uno
               e comincia l'altro, è un indice che non aiuta a cercare.
               ⚠️ Un solo <aside>, figlio DIRETTO della griglia: i due indici impilati stavano in un <div>
               alto quanto loro, e uno `sticky` appeso lì dentro non ha dove scorrere. *@
            <DocumentToc Gruppi="@Sommario()" />
            <div>
                <PrintMeta Title="@_doc.DisplayName" Subtitle="@($"{_app} · {Sito["Appn_Subtitle"]}")"
                           AiracCycle="@Cycle()" Coverage="_doc.Copertura" Bloccata="@_doc.Bloccata" />
                <div class="doc-head with-aud">
                    @* L'APP di uno scalo militare porta la stessa etichetta del suo aeroporto: chi legge questo
                       documento sta guardando quel campo, e l'informazione non deve dipendere da quale dei due
                       documenti ha aperto. *@
                    @* ⚠️ Riga propria per l'avviso, come nelle altre quattro testate: vedi `.sim-line`. *@
                    <h1 class="page-h1" style="margin-bottom:2px">@_doc.DisplayName <MilitaryTag HasMilitaryPresence="_mil?.HasMilitaryPresence ?? false" IsMilitaryOnly="_mil?.IsMilitaryOnly ?? false" /></h1>
                    @* La CHIP di lettura sta a DESTRA delle due righe e le occupa tutte e due in altezza
                       (6 settembre 2026): appesa in coda al sottotitolo era un dettaglio in mezzo al testo,
                       e i tre link erano piu' piccoli della riga che dovevano governare.
                       ⚠️ La testata e' una GRIGLIA 2×2 (`.doc-head.with-aud`): titolo e tasti in riga 1,
                       queste due righe e la chip in riga 2. La chip sta nella colonna dei TASTI e non in
                       quella del testo, o si porterebbe via la larghezza dell'avviso — misurato: 379px, e
                       la frase tornava a capo. Sul telefono la griglia torna a una colonna sola. *@
                    <div class="hl-text">
                        <div class="sub-line">
                            <span class="muted">@_app · @Sito["Appn_Subtitle"]</span>
                        </div>
                        <div class="sim-line"><SimDisclaimer /> <TranslationNotice Coverage="_doc.Copertura" Compatto="true" /> <LinguaBloccataNotice Lingua="@_doc.Bloccata" Compatto="true" /></div>
                    </div>
                    <AudienceChip Compatto="true" Visibile="@MembroUnito.QualcunoHaMarcate(_doc.HaMarcate, _altri)" Vista="_doc.Vista"
                                  BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}" + (_doc.Mode.Kind == PreviewKind.Draft ? "&as=draft" : ""))" />
                    <div class="dh-actions">
                        <button type="button" class="btn ghost" onclick="window.print()">@Sito["Common_Print"]</button>
                        @* La vista live di una postazione altrui non e' pubblica (carta
                           2026-09-05-vista-live-selettore-e-cancello): a chi non la puo' aprire il tasto non
                           si mostra, o sarebbe un gesto che rimbalza indietro. *@
                        @if (Authz.IsDivisionStaff || string.Equals(_app, VistaLive.MyCallsign(), StringComparison.OrdinalIgnoreCase))
                        {
                            <a class="btn ghost" href="/services/vsop/live/@_app.ToLowerInvariant()">@Sito["Common_Operational"]</a>
                        }
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/apps/editor?app=@_app">@Sito["Common_Editor"]</a>
                        }
                    </div>
                </div>
                @if (_doc.Mode.IsPreview)
                {
                    <PreviewBanner Kind="_doc.Mode.Kind" Cycle="@_doc.RelCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}&as=draft")" />
                }
                <div class="callout info"><span class="cic"><Icon Name="radio" Size="18" /></span><div><p class="ct">@Sito["Appn_InfoTitle"]</p>@Sito["Appn_InfoBody"]</div></div>

                @* ⚠️ Cartelli e filtro di lettura stanno nella TESTATA: vedi la `.doc-head.with-aud` piu' sopra. *@
                @* Il corpo — sezioni e derivate — sta in un componente, perché lo stesso documento va reso
                   anche nella pagina UNITA (carta 2026-09-03-documenti-uniti.md). Qui resta il chrome. *@
                <AppDocumentBody Doc="_doc" />

                @* Gli altri documenti dell'unione, nell'ordine scelto dal redattore. *@
                <UnionBodies Membri="_altri" />
            </div>

            <aside class="doc-rail" aria-label="@Sito["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @Sito["Common_Summary"]</h5>
                    @* Il ciclo del DOCUMENTO che si sta guardando, non quello di oggi (doc 13 §3h): lo snapshot
                       lo porta con sé, e la pagina ce l'aveva sotto mano senza usarlo. *@
                    <div class="rail-line"><span class="muted">@Sito["Common_AiracCycle"]</span><b>@Cycle()</b></div>
                    <div class="rail-line"><span class="muted">@Sito["Common_AtcOnline"]</span>
                        @{ var n = OnlineApp(); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @Sito["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@Sito["Common_Home"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/apps">@Sito["AccLanding_Apps"]</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero (carta vSOP
    /// militari §3).</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }
    [SupplyParameterFromQuery] public string? Live { get; set; }   // legacy: live=1 → alias di as=draft
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>Il documento caricato — vista, modalità OTTENUTA, derivate, lingua. null = questo callsign
    /// non è un APP non remotizzato, o non ha niente da mostrare.</summary>
    private AppMemberDocument? _doc;

    /// <summary>Gli ALTRI documenti dell'unione, se questo è l'ospite. Vuoto = documento solo.</summary>
    private IReadOnlyList<MembroUnito> _altri = Array.Empty<MembroUnito>();

    private AccInfo? _acc;
    private string _app = "";
    // L'aeroporto di questo APP (dalla testa del callsign) con la sua anagrafica militare: null per gli APP
    // di ACC, che non descrivono uno scalo.
    private Vipi.Application.Content.AirportStation? _mil;
    private bool _canEdit;

    /// <summary>Ciclo AIRAC da mostrare: quello del documento mostrato (lo snapshot lo porta con sé); in mancanza,
    /// quello corrente.</summary>
    private string Cycle() => _doc?.RelCycle ?? _doc?.View.AiracCycle ?? Airac.GetCycle(DateTime.UtcNow);

    /// <summary>
    /// I gruppi del sommario: il PROPRIO documento, e poi uno per ogni altro membro dell'unione.
    ///
    /// <para>\u26a0\ufe0f Il proprio gruppo prende un titolo <b>solo dentro un'unione</b>: da solo sarebbe una riga
    /// che ripete il titolo del documento sotto la parola \u00abSommario\u00bb, cio\u00e8 due volte la stessa cosa.</para>
    ///
    /// <para>\u26a0\ufe0f Un GRUPPO per membro e non un elenco unico: \u00e8 la riga che dice dove finisce un documento
    /// e comincia l'altro. E tutti dentro lo <b>stesso</b> riquadro, o lo <c>sticky</c> non regge \u2014 vedi
    /// <see cref="Vipi.Ui.Components.Doc.TocGruppiUnione"/>.</para>
    /// </summary>
    private IReadOnlyList<TocGruppo> Sommario()
    {
        if (_doc is null) return Array.Empty<TocGruppo>();

        var bozza = _doc.Mode.Kind == PreviewKind.Draft;
        var proprio = new TocGruppo(
            _altri.Count > 0 ? _doc.DisplayName : null,
            TocVoce.Da(_doc.View.Sections, bozza, AppDocumentBody.AnchorOf));

        return new[] { proprio }.Concat(TocGruppiUnione.Di(_altri, bozza)).ToList();
    }

    private string PreviewTitlePrefix() => _doc?.Mode.Kind switch
    {
        PreviewKind.Draft => $"{Sito["Common_DraftTag"]} ",
        PreviewKind.Release => $"{Sito["Common_PreviewTag"]} ",
        _ => "",
    };

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        _app = (App ?? "").Trim().ToUpperInvariant();
        _doc = null;
        if (string.IsNullOrWhiteSpace(_app)) return;

        _mil = Stations.AirportOfCallsign(_app);
        _canEdit = Authz.IsEditor;

        // Tutto il carico — anteprima, lingua, derivate, traduzione, titoli di catalogo, filtro di lettura —
        // sta nel caricatore: l'ordine di quei passi è la correttezza, e non appartiene a QUESTA pagina.
        var mode = PreviewMode.Parse(As, Live);
        _doc = await Loader.LoadAsync(_app, mode, Vista);
        if (_doc is null) return;

        // ---- L'unione (carta 2026-09-03, §13 del 10-09) ---------------------------------------------
        // ⚠️ Questa pagina è una PORTA dell'unione, non l'ospite di nessuno: disegna sé stessa per prima e
        // gli altri membri di seguito, nell'ordine memorizzato. Non si reindirizza più (§4 superata): chi
        // apre l'avvicinamento legge PRIMA l'avvicinamento, poi la vIPI d'aeroporto e il vSOP.
        var unione = await Unioni.ForTargetAsync(ReleaseTargetType.App, _app);
        // ⚠️ La porta si cerca per FAMIGLIA E CHIAVE, mai per la sola chiave. `null` = l'unione non descrive
        // questo documento, e allora non c'è unione da disegnare.
        _altri = unione?.Di(ReleaseTargetType.App, _app) is { } mio
            ? await Membri.AltriMembriAsync(unione, mio.DocumentId, _doc.Mode, Vista, Cycle())
            : Array.Empty<MembroUnito>();
    }

    // ATC online per l'APP: callsign _APP/_DEP la cui testa è l'ICAO d'aeroporto del callsign (es. LIRP_APP → LIRP).
    private int OnlineApp()
    {
        var head = _app.Split('_', 2)[0];
        return Online.GetCurrent().Callsigns.Count(cs =>
        {
            var t = cs.Split('_');
            return t.Length >= 2 && (t[^1].ToUpperInvariant() is "APP" or "DEP")
                && t[0].Equals(head, StringComparison.OrdinalIgnoreCase);
        });
    }
}
