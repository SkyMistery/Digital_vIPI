@page "/vsop/{Acc}/apps/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IAppDocumentService AppDoc
@inject IEditAuthorizationService Authz
@inject IVipiViewService ViewService
@inject IEditingService Editing
@inject IReleaseService Releases
@inject IOnlineAtcProvider Online
@inject IAiracService Airac
@using System.Text.Json
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else if (_vloaMode)
{
    <PageTitle>@PreviewTitlePrefix()vLOA @Acc.ToUpperInvariant() ↔ @_vloaForeign · IVAO Italia</PageTitle>
    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> › <a href="/vsop/@Acc.ToLowerInvariant()/vloa">vLOA</a> › <b>@_vloaForeign</b></div>
        @if (_mode.IsPreview)
        {
            <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                           PublicHref="@($"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?vloa={_vloaForeign}")"
                           DraftHref="@($"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?vloa={_vloaForeign}&as=draft")" />
        }
        @if (_vloaView is null)
        {
            <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">vLOA non disponibile</p>Nessuna vLOA pubblicata per la coppia <b>@Acc.ToUpperInvariant() ↔ @_vloaForeign</b>. Generala dalla pagina <a href="/vsop/admin/confinanti">ACC confinanti</a>.</div></div>
        }
        else
        {
            <VloaDocumentView View="_vloaView" DocId="_vloaDocId" Subtitle="@($"{_acc.Name} ↔ {_vloaForeign}")" HomeAcc="@Acc.Trim().ToUpperInvariant()" ForeignAcc="@_vloaForeign" />
        }
    </div>
}
else if (_view is null)
{
    <div class="wrap"><div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">APP non trovato</p>Nessun avvicinamento non remotizzato pubblicato per <code>@_app</code>. Se lo stai preparando, aprilo dall'<a href="/vsop/@Acc.ToLowerInvariant()/apps/editor?app=@_app">editor</a> e pubblicalo.</div></div></div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_displayName · vIPI IVAO Italia</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/vsop/@Acc.ToLowerInvariant()/apps">Avvicinamenti non remotizzati</a> › <b>@_app</b></div>
        <div class="doc-layout">
            <aside class="toc">
                <p class="toc-h">Sommario</p>
                <ul>
                    @foreach (var s in VisibleSections())
                    {
                        <li><a href="#@AnchorOf(s)">@s.Title</a></li>
                    }
                </ul>
            </aside>
            <div>
                <div class="doc-head">
                    <div><h2 style="margin-bottom:2px">@_displayName</h2><span class="muted">@_app · Avvicinamento non remotizzato · doc proprio</span></div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/operativa-app?app=@_app">⚡ Operativa</a>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/vsop/@Acc.ToLowerInvariant()/apps/editor?app=@_app">✎ Editor</a>
                        }
                    </div>
                </div>
                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}")"
                                   DraftHref="@($"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}&as=draft")" />
                }
                <div class="callout info"><span class="cic">📡</span><div><p class="ct">APP con documentazione propria</p>Non remotizzato sotto l'ACC: ha vIPI dedicata. I remotizzati restano nella vIPI di ACC.</div></div>

                @foreach (var s in _view.Sections)
                {
                    var hidden = _hiddenKeys.Contains(s.SectionKey);
                    @if (hidden && _mode.Kind != PreviewKind.Draft)
                    {
                        <text></text>   @* nascosta: fuori dal pubblico e dall'anteprima release *@
                    }
                    else if (IsSpecial(s.SectionKey))
                    {
                        <div class="block" id="@AnchorOf(s)" style="@(hidden ? "opacity:.65" : "")">
                            <h3 style="margin-top:0">@s.Title @if (hidden) { <span class="pill" style="background:#eef1f7;color:#57606a;font-weight:500">🚫 nascosta (non nel pubblico)</span> }</h3>
                            @switch (s.SectionKey)
                            {
                                case "separations": <AppSeparations Rows="ReadSeparations(s)" />; break;
                                case "aor": <AccAor View="_aorView" Id="@($"app-aor-{_app}")" />; break;
                                case "frequencies": <AppFrequencies Rows="_freqs" />; break;
                                case "vfr": <AppVfr Content="ReadVfr(s)" />; break;
                                case "minima": <AppMinima />; break;
                                case "coordination": <AppCoordinationView Coord="_coord" />; break;
                            }
                        </div>
                    }
                    else
                    {
                        <SectionNode Section="s" />   @* editoriale/custom: prosa/tabella/callout + sotto-sezioni *@
                    }
                }
            </div>

            <aside class="doc-rail">
                <div class="rail-card">
                    <h5>📋 Riepilogo</h5>
                    <div class="rail-line"><span class="muted">Ciclo AIRAC</span><b>@Airac.GetCycle(DateTime.UtcNow)</b></div>
                    <div class="rail-line"><span class="muted">ATC online</span>
                        @{ var n = OnlineApp(); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5>🔗 Collegamenti</h5>
                    <ul class="rail-links">
                        <li><a href="/vsop">Home</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()/apps">Avvicinamenti non remotizzati</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }
    [SupplyParameterFromQuery] public string? Vloa { get; set; }
    [SupplyParameterFromQuery] public string? Live { get; set; }   // legacy: live=1 → alias di as=draft
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    private PreviewMode _mode;   // pubblica | bozza | release
    private string? _relCycle;   // ciclo AIRAC della release (banner)

    private bool _vloaMode;
    private string _vloaForeign = "";
    private DocumentView? _vloaView;
    private int? _vloaDocId;

    private AccInfo? _acc;
    private string _app = "";
    private string _displayName = "";
    private bool _canEdit;

    // Storage APP su Document (doc 08e): struttura + editoriale dal DocumentView; derivate live da AppDocumentService.
    private DocumentView? _view;
    private HashSet<string> _hiddenKeys = new(StringComparer.OrdinalIgnoreCase);
    private AppVfrContent _vfr = AppVfrContent.Empty;
    private List<AppFreqRow> _freqs = new();
    private AppCoordination _coord = AppCoordination.Empty;
    private AccAorView _aorView = AccAorView.Empty;

    // Sezioni "speciali" rese da componenti dedicati (derivate live + editoriali-strutturate); le altre via SectionNode.
    private static readonly HashSet<string> Special = new(StringComparer.OrdinalIgnoreCase)
        { "separations", "aor", "frequencies", "vfr", "minima", "coordination" };
    private static bool IsSpecial(string key) => Special.Contains(key);

    private string AnchorOf(SectionView s) => IsSpecial(s.SectionKey) ? $"p-{s.SectionKey}" : s.Id;
    private IEnumerable<SectionView> VisibleSections() =>
        _view!.Sections.Where(s => _mode.Kind == PreviewKind.Draft || !_hiddenKeys.Contains(s.SectionKey));

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => "[Bozza] ",
        PreviewKind.Release => "[Anteprima] ",
        _ => "",
    };

    // Anteprima release gated (authz nel servizio) + verifica identità: null se inesistente/altro bersaglio/non autorizzato.
    private async Task<ReleasePreview?> TryPreviewAsync(int releaseId, ReleaseTargetType expectedType, string? expectedKey)
    {
        try
        {
            var pv = await Releases.GetPreviewAsync(releaseId);
            if (pv is null || pv.Type != expectedType
                || (expectedKey is not null && !string.Equals(pv.TargetKey, expectedKey, StringComparison.OrdinalIgnoreCase)))
                return null;
            return pv;
        }
        catch (EditNotAllowedException) { return null; }
        catch (Vipi.Application.Aor.ValidationException) { return null; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        _mode = PreviewMode.Parse(As, Live);
        _relCycle = null;
        var home = Acc.Trim().ToUpperInvariant();

        // Modalità vLOA: ?vloa=<ACC estero> mostra la Letter of Agreement della coppia (una per coppia ACC↔ACC).
        _vloaForeign = (Vloa ?? "").Trim().ToUpperInvariant();
        _vloaMode = _vloaForeign.Length > 0;
        if (_vloaMode)
        {
            _vloaDocId = await Editing.ResolveVloaIdByPairAsync(home, _vloaForeign);
            switch (_mode.Kind)
            {
                case PreviewKind.Draft:
                    if (await Authz.CanEditAccAsync(home))
                        _vloaView = await ViewService.BuildVloaByPairAsync(home, _vloaForeign, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                    else { _mode = default; _vloaView = await ViewService.BuildVloaByPairAsync(home, _vloaForeign, BlockTier.Extended, live: false); }
                    break;
                case PreviewKind.Release:
                    var pv = _vloaDocId is int vid ? await TryPreviewAsync(_mode.ReleaseId, ReleaseTargetType.Vloa, vid.ToString()) : null;
                    if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _vloaView = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                    else { _mode = default; _vloaView = await ViewService.BuildVloaByPairAsync(home, _vloaForeign, BlockTier.Extended, live: false); }
                    break;
                default:
                    _vloaView = await ViewService.BuildVloaByPairAsync(home, _vloaForeign, BlockTier.Extended, live: false);
                    break;
            }
            return;
        }

        _app = (App ?? "").Trim().ToUpperInvariant();
        _view = null;
        if (string.IsNullOrWhiteSpace(_app)) return;

        var identity = await AppDoc.GetIdentityAsync(_app);
        if (identity is null) return;   // callsign non è un APP standalone
        _displayName = string.IsNullOrWhiteSpace(identity.Title) ? _app : identity.Title;
        _canEdit = await Authz.CanEditAccAsync(identity.AccCode);

        // Vista documentale (struttura + editoriale). Le derivate restano vuote nel view → rese live sotto.
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (_canEdit) _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                else { _mode = default; _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false); }
                break;
            case PreviewKind.Release:
                var pv = await TryPreviewAsync(_mode.ReleaseId, ReleaseTargetType.App, _app);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false); }
                break;
            default:
                _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false);
                break;
        }
        if (_view is null) return;

        var overrides = await AppDoc.GetOverridesAsync(_app);
        _hiddenKeys = overrides.HiddenSections.ToHashSet(StringComparer.OrdinalIgnoreCase);

        // Derivate live (sempre attuali, anche in anteprima release: "i dati derivati restano live").
        _freqs = (await AppDoc.DeriveFrequenciesAsync(_app)).ToList();
        _coord = await AppDoc.DeriveCoordinationAsync(_app);
        _aorView = await AppDoc.GetAorViewAsync(_app);
    }

    // ATC online per l'APP: callsign _APP/_DEP la cui testa è l'ICAO d'aeroporto del callsign (es. LIRP_APP → LIRP).
    private int OnlineApp()
    {
        var head = _app.Split('_', 2)[0];
        return Online.GetCurrent().Callsigns.Count(cs =>
        {
            var t = cs.Split('_');
            return t.Length >= 2 && (t[^1].ToUpperInvariant() is "APP" or "DEP")
                && t[0].Equals(head, StringComparison.OrdinalIgnoreCase);
        });
    }

    // Editoriali-strutturate: il dato vive nel BodyJson del primo blocco Table della sezione keyed del Document.
    private static IReadOnlyList<AppSeparationRow> ReadSeparations(SectionView s) =>
        Deser<List<AppSeparationRow>>(s.Blocks.FirstOrDefault()?.BodyJson) ?? new List<AppSeparationRow>();

    private static AppVfrContent ReadVfr(SectionView s) =>
        Deser<AppVfrContent>(s.Blocks.FirstOrDefault()?.BodyJson) ?? AppVfrContent.Empty;

    private static T? Deser<T>(string? json) where T : class
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<T>(json); }
        catch (JsonException) { return null; }
    }
}
