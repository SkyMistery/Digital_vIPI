@page "/vsop/{Acc}/apps/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IAppProfileService Profile
@inject IEditAuthorizationService Authz

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else if (_data is null)
{
    <div class="wrap"><div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">APP non trovato</p>Nessun avvicinamento non remotizzato per <code>@_app</code>.</div></div></div>
}
else
{
    <PageTitle>@_app — @_name · vIPI IVAO Italia</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> › <b>@_app · @_name (non remotizzato)</b></div>
        <div class="doc-layout">
            <aside class="toc">
                <p class="toc-h">Sommario</p>
                <ul>
                    @foreach (var key in _order)
                    {
                        <li><a href="#p-@key">@TitleOf(key)</a></li>
                    }
                </ul>
            </aside>
            <div>
                <div class="doc-head">
                    <div><h2 style="margin-bottom:2px">@_app — @_name</h2><span class="muted">Avvicinamento non remotizzato · doc proprio</span></div>
                    @if (_canEdit)
                    {
                        <div style="display:flex;align-items:center;gap:10px">
                            <a class="btn primary" href="/vsop/@Acc.ToLowerInvariant()/apps/editor?app=@_app">✎ Editor</a>
                        </div>
                    }
                </div>
                <div class="callout info"><span class="cic">📡</span><div><p class="ct">APP con documentazione propria</p>Non remotizzato sotto l'ACC: ha vIPI dedicata. I remotizzati restano nella vIPI di ACC.</div></div>

                @foreach (var key in _order)
                {
                    var desc = AppSections.Find(key);
                    var custom = desc is null ? _custom.FirstOrDefault(c => c.Key == key) : null;
                    <div class="block" id="p-@key">
                        <h3>@TitleOf(key)</h3>
                        @switch (key)
                        {
                            case "separations": <AppSeparations Rows="_data.Separations" />; break;
                            case "aor": <AppAor Polygon="_aor" Towers="_towers" />; break;
                            case "frequencies": <AppFrequencies Rows="_freqs" />; break;
                            case "vfr": <AppVfr Content="_vfr" />; break;
                            case "minima": <AppMinima />; break;
                            case "coordination": <AppCoordinationView Coord="_coord" />; break;
                            default:
                                @if (custom is not null) { @CustomBody(custom) }
                                break;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    private AccInfo? _acc;
    private string _app = "";
    private string _name = "";
    private bool _canEdit;
    private AppProfileData? _data;
    private List<string> _order = new();
    private List<AppCustomSection> _custom = new();
    private AppVfrContent _vfr = AppVfrContent.Empty;
    private List<AppFreqRow> _freqs = new();
    private AppCoordination _coord = AppCoordination.Empty;
    private AppAorPolygon? _aor;
    private IReadOnlyList<AppAorPolygon> _towers = Array.Empty<AppAorPolygon>();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _app = (App ?? "").Trim().ToUpperInvariant();
        _data = await Profile.LoadForViewAsync(_app);
        if (_data is null) return;

        _name = _data.Name;
        _canEdit = await Authz.CanEditAccAsync(_data.AccCode);
        _custom = _data.CustomSections.ToList();
        _vfr = ParseVfr(_data.VfrJson);
        var customKeys = _custom.Select(c => c.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var hidden = _data.HiddenSections.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _order = AppSections.Reconcile(_data.SectionOrder, customKeys)
            .Where(k => !hidden.Contains(k)).ToList();   // le sezioni nascoste non compaiono nel documento pubblico

        _freqs = (await Profile.DeriveFrequenciesAsync(_app)).ToList();
        _coord = await Profile.DeriveCoordinationAsync(_app);
        _aor = await Profile.GetAorPolygonAsync(_app);
        _towers = await Profile.GetTowerPolygonsAsync(_app);
    }

    private string TitleOf(string key) =>
        AppSections.Find(key)?.Title ?? _custom.FirstOrDefault(c => c.Key == key)?.Title ?? key;

    private static AppVfrContent ParseVfr(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return AppVfrContent.Empty;
        try { return System.Text.Json.JsonSerializer.Deserialize<AppVfrContent>(json) ?? AppVfrContent.Empty; }
        catch (System.Text.Json.JsonException) { return AppVfrContent.Empty; }
    }

    private RenderFragment CustomBody(AppCustomSection sec) => __builder =>
    {
        @foreach (var block in sec.Blocks)
        {
            if (block.Type == AppCustomBlockType.Prose)
            {
                @if (!string.IsNullOrWhiteSpace(block.Text)) { @MarkdownLite.Render(block.Text!) }
            }
            else
            {
                <table>
                    <thead><tr>@foreach (var c in block.Columns ?? Array.Empty<string>()) { <th>@c</th> }</tr></thead>
                    <tbody>
                        @foreach (var r in block.Rows ?? Array.Empty<IReadOnlyList<string>>())
                        {
                            <tr>@foreach (var cell in r) { <td>@cell</td> }</tr>
                        }
                    </tbody>
                </table>
            }
        }
    };
}
