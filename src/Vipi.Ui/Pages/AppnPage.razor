@page "/services/vsop/{Acc}/apps/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IAppDocumentService AppDoc
@inject IAppViewDerivationService AppView
@inject IEditAuthorizationService Authz
@inject IVipiViewService ViewService
@inject IReleaseService Releases
@inject IOnlineAtcProvider Online
@inject IAiracService Airac
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Translation.DocumentTranslator Translator
@inject EnglishStrings En
@using System.Text.Json
@using System.Globalization
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_view is null)
{
    <div class="wrap"><div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["Appn_AppNotAvailTitle"]</p>@((MarkupString)string.Format(L["Appn_AppNotFoundBody"], _app, $"/services/vsop/{Acc.ToLowerInvariant()}/apps/editor?app={_app}"))</div></div></div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_displayName · vIPI IVAO Italy</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/apps">@En["AccLanding_Apps"]</a> › <b>@_app</b></div>
        <div class="doc-layout">
            <aside class="toc" aria-label="@L["Doc_TocAria"]">
                <p class="toc-h">@L["Common_Contents"]</p>
                <ul>
                    @foreach (var s in VisibleSections())
                    {
                        <li><a href="#@AnchorOf(s)">@s.Title</a></li>
                    }
                </ul>
            </aside>
            <div>
                <PrintMeta Title="@_displayName" Subtitle="@($"{_app} · {L["Appn_Subtitle"]}")"
                           AiracCycle="@Cycle()" />
                <div class="doc-head">
                    @* L'APP di uno scalo militare porta la stessa etichetta del suo aeroporto: chi legge questo
                       documento sta guardando quel campo, e l'informazione non deve dipendere da quale dei due
                       documenti ha aperto. *@
                    <div><h1 class="page-h1" style="margin-bottom:2px">@_displayName <MilitaryTag HasMilitaryPresence="_mil?.HasMilitaryPresence ?? false" IsMilitaryOnly="_mil?.IsMilitaryOnly ?? false" /></h1><span class="muted">@_app · @L["Appn_Subtitle"]</span></div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@L["Common_Print"]</button>
                        <a class="btn ghost" href="/services/vsop/live/@_app.ToLowerInvariant()">@L["Common_Operational"]</a>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/apps/editor?app=@_app">@L["Common_Editor"]</a>
                        }
                    </div>
                </div>
                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}&as=draft")" />
                }
                <div class="callout info"><span class="cic"><Icon Name="radio" Size="18" /></span><div><p class="ct">@L["Appn_InfoTitle"]</p>@L["Appn_InfoBody"]</div></div>

                @* Il filtro di lettura pilota/ATC (carta vSOP militari §3): vale su tutte le famiglie,
                   perché il flag è per-sezione e l'editor lo offre ovunque. *@
                <AudienceChip Visibile="_haMarcate" Vista="_vista"
                              BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}" + (_mode.Kind == PreviewKind.Draft ? "&as=draft" : ""))" />

                @* Tradotto a macchina e non ancora riletto, o tradotto a metà: chi legge deve saperlo. *@
                <TranslationNotice Coverage="_copertura" />

                @* Il ciclo delle sezioni lo fa il componente condiviso (doc 14 §3e). Qui resta il solo corpo
                   derivato, per chiave: quello che l'APP disegna e le altre famiglie no. *@
                <DocumentSectionsView Sections="_view.Sections" Profile="SectionProfile.App"
                                      IsDraft="@(_mode.Kind == PreviewKind.Draft)"
                                      AnchorOf="AnchorOf" DerivedContent="CorpoDerivato" />
            </div>

            <aside class="doc-rail" aria-label="@L["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @L["Common_Summary"]</h5>
                    @* Il ciclo del DOCUMENTO che si sta guardando, non quello di oggi (doc 13 §3h): lo snapshot
                       lo porta con sé, e la pagina ce l'aveva sotto mano senza usarlo. *@
                    <div class="rail-line"><span class="muted">@L["Common_AiracCycle"]</span><b>@Cycle()</b></div>
                    <div class="rail-line"><span class="muted">@L["Common_AtcOnline"]</span>
                        @{ var n = OnlineApp(); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @L["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@L["Common_Home"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/apps">@L["AccLanding_Apps"]</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero (carta vSOP
    /// militari §3).</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }
    [SupplyParameterFromQuery] public string? Live { get; set; }   // legacy: live=1 → alias di as=draft
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    private PreviewMode _mode;   // pubblica | bozza | release
    private string? _relCycle;   // ciclo AIRAC della release (banner)

    private Vipi.Domain.SectionAudience? _vista;
    private bool _haMarcate;

    /// <summary>Ciclo AIRAC da mostrare: quello del documento mostrato (lo snapshot lo porta con sé); in mancanza,
    /// quello corrente.</summary>
    private string Cycle() => _relCycle ?? _view?.AiracCycle ?? Airac.GetCycle(DateTime.UtcNow);

    private AccInfo? _acc;
    private string _app = "";
    private string _displayName = "";
    // L'aeroporto di questo APP (dalla testa del callsign) con la sua anagrafica militare: null per gli APP
    // di ACC, che non descrivono uno scalo.
    private Vipi.Application.Content.AirportStation? _mil;
    private bool _canEdit;

    // Storage APP su Document (doc 08e): struttura + editoriale dal DocumentView; derivate frozen (release effettiva) o
    // live (bozza/anteprima) via AppViewDerivationService.
    private DocumentView? _view;
    private Vipi.Application.Translation.TranslationCoverage _copertura =
        Vipi.Application.Translation.TranslationCoverage.Nessuna;
    private bool _useFrozen;   // vista pubblica: leggi le derivate frozen dalla release effettiva (doc 10 §3d)
    private AppVfrContent _vfr = AppVfrContent.Empty;
    private List<AppFreqRow> _freqs = new();
    private AppCoordination _coord = AppCoordination.Empty;
    private AccAorView _aorView = AccAorView.Empty;
    private IReadOnlyList<AccConfigTableView> _configTable = Array.Empty<AccConfigTableView>();
    private IReadOnlyList<AccSpecialAreaView> _areas = Array.Empty<AccSpecialAreaView>();
    private MinimaView _minima = MinimaView.Empty;

    // Sezioni il cui corpo lo rende questa pagina (derivate + editoriali-strutturate); le altre via SectionNode.
    // Chi siano lo dice il catalogo, per profilo (doc 13 §3a): qui stava una delle sei copie dell'insieme.
    /// <summary>Il corpo che questa pagina disegna, per chiave. Le chiavi sono quelle che il catalogo dichiara
    /// «rese dalla pagina» per il profilo App: il componente condiviso ci arriva solo per quelle.</summary>
    private RenderFragment<SectionView> CorpoDerivato => s => __builder =>
    {
        @switch (s.SectionKey)
        {
            case "separations": <AppSeparations Rows="ReadSeparations(s)" />; break;
            case "configurations": <AppConfigurations Configs="Array.Empty<AccConfiguration>()" Tables="_configTable" MapScope="@($"app-aor-{_app}")" />; break;
            case "aor": <AccAor View="_aorView" Id="@($"app-aor-{_app}")" />; break;
            case "frequencies": <AppFrequencies Rows="_freqs" />; break;
            case "minima": <MinimaSection View="_minima" Aor="_aorView" />; break;
            case "vfr": <AppVfr Content="ReadVfr(s)" />; break;
            case "coordination": <AppCoordinationView Coord="_coord" LeadSentence="s.LeadSentence" />; break;
            case "regulated": <RegulatedAreas Areas="_areas" />; break;
            case "validity": <ValidityStamp Target="ReleaseTargetType.App" Key="@_app" ReleaseId="@ReleaseIdShown()" />; break;
        }
    };


    // Ancora di sezione: «s-{Id}» per TUTTE, comprese quelle rese dalla pagina (doc 13 §3e). Prima le speciali
    // usavano «p-{chiave}», e i deep-link della ricerca — che indicizza per Id — cadevano in cima alla pagina.
    private static string AnchorOf(SectionView s) => s.Id;

    /// <summary>La release che questa vista mostra: quella dell'anteprima, o null = la effettiva adesso.</summary>
    private int? ReleaseIdShown() => _mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null;
    private IEnumerable<SectionView> VisibleSections() =>
        _view!.Sections.Where(s => _mode.Kind == PreviewKind.Draft || !s.IsHidden);

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => $"{L["Common_DraftTag"]} ",
        PreviewKind.Release => $"{L["Common_PreviewTag"]} ",
        _ => "",
    };

    // Vista PUBBLICA (doc 11 §3d): documento + derivate frozen si impostano INSIEME. È anche il degrado di
    // un'anteprima non autorizzata/non corrispondente: senza questo, il fallback lasciava _useFrozen=false e
    // serviva al pubblico le derivate LIVE (congelamento AIRAC bypassabile dall'URL con un ?as=rel: qualsiasi).
    private async Task LoadAppPublicAsync()
    {
        _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false);
        _useFrozen = true;
    }

    // Anteprima release gated (authz nel servizio) + verifica identità: null se inesistente/altro bersaglio/non autorizzato.
    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        _mode = PreviewMode.Parse(As, Live);
        _relCycle = null;
        _haMarcate = false;

        _app = (App ?? "").Trim().ToUpperInvariant();
        _view = null;
        _useFrozen = false;
        if (string.IsNullOrWhiteSpace(_app)) return;

        var identity = await AppDoc.GetIdentityAsync(_app);
        if (identity is null) return;   // callsign non è un APP standalone
        _displayName = string.IsNullOrWhiteSpace(identity.Title) ? _app : identity.Title;
        _mil = Stations.AirportOfCallsign(_app);
        _canEdit = Authz.IsEditor;

        // Vista documentale (struttura + editoriale). Le derivate restano vuote nel view → rese live sotto.
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (_canEdit) _view = await ViewService.BuildAppVipiAsync(_app, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                else { _mode = default; await LoadAppPublicAsync(); }
                break;
            case PreviewKind.Release:
                var pv = await Releases.GetPreviewAsync(_mode.ReleaseId, ReleaseTargetType.App, _app);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; await LoadAppPublicAsync(); }
                break;
            default:
                await LoadAppPublicAsync();
                break;
        }
        if (_view is null) return;

        // Derivate: frozen dalla release effettiva nella vista pubblica, live in bozza/anteprima (doc 10 §3d).
        // Il documento mostrato viaggia col resolver: la tabella «Configurazioni» si deriva dalle configurazioni
        // di QUESTA versione, non da quella di lavoro — prima la pagina pubblica mostrava quelle della bozza.
        var derived = await AppView.ResolveForViewAsync(_app, _view, _useFrozen);
        _freqs = derived.Freqs.ToList();
        _coord = derived.Coord;
        _aorView = derived.Aor;
        _configTable = derived.ConfigTable;
        _minima = derived.Minima;

        // Aree regolamentate: gli id li porta il documento mostrato (pubblico/bozza/release), i dettagli e le shape
        // vengono dai cataloghi correnti — come nella vIPI ACC.
        var regulated = _view.Sections.FirstOrDefault(s => string.Equals(s.SectionKey, "regulated", StringComparison.OrdinalIgnoreCase));
        _areas = regulated is null
            ? Array.Empty<AccSpecialAreaView>()
            : await AppDoc.ResolveRegulatedAreasAsync(ReadRegulated(regulated));

        // ---- Lettura bilingue (carta 2026-08-27 §7) --------------------------------------------------
        // ⚠️ La lingua di lettura è quella dell'INTERFACCIA, non un secondo selettore: la sceglie la chip
        // della barra, che scrive il cookie di cultura — l'unico modo perché la scelta sopravviva al
        // circuito, che su /_blazor non porta ?culture=.
        //
        // ⚠️ La sorgente la dice il DOCUMENTO: qui si passa solo la lingua in cui la famiglia NASCE, per i
        // documenti salvati prima che il campo esistesse.
        //
        // ⚠️ IN FONDO, dopo le derivate e le aree: quelle si leggono dall'originale (gli id stanno nel JSON
        // dei blocchi), la traduzione porta la PROSA. Tradurre prima vorrebbe dire cercare «regulated» in un
        // documento che nel frattempo dice altro.
        var lettore = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
        var tradotto = await Translator.TranslateAsync(_view, Vipi.Domain.Language.It, lettore);
        _view = tradotto.View;
        _copertura = tradotto.Coverage;

        // Il filtro di lettura, DOPO la traduzione: si filtra la vista che il lettore vedrà davvero.
        _vista = AudienceFilter.Leggi(Vista);
        _haMarcate = AudienceFilter.HaSezioniMarcate(_view.Sections);
        var filtrate = AudienceFilter.Filtra(_view.Sections, _vista);
        if (!ReferenceEquals(filtrate, _view.Sections))
            _view = new DocumentView
            {
                Title = _view.Title, AiracCycle = _view.AiracCycle, Sections = filtrate,
                Language = _view.Language, Translations = _view.Translations,
            };
    }

    // ATC online per l'APP: callsign _APP/_DEP la cui testa è l'ICAO d'aeroporto del callsign (es. LIRP_APP → LIRP).
    private int OnlineApp()
    {
        var head = _app.Split('_', 2)[0];
        return Online.GetCurrent().Callsigns.Count(cs =>
        {
            var t = cs.Split('_');
            return t.Length >= 2 && (t[^1].ToUpperInvariant() is "APP" or "DEP")
                && t[0].Equals(head, StringComparison.OrdinalIgnoreCase);
        });
    }

    // Editoriali-strutturate: il dato vive nel BodyJson del primo blocco Table della sezione keyed del Document.
    private static IReadOnlyList<AppSeparationRow> ReadSeparations(SectionView s) =>
        Deser<List<AppSeparationRow>>(s.Blocks.FirstOrDefault()?.BodyJson) ?? new List<AppSeparationRow>();

    private static AppVfrContent ReadVfr(SectionView s) =>
        Deser<AppVfrContent>(s.Blocks.FirstOrDefault()?.BodyJson) ?? AppVfrContent.Empty;

    private static RegulatedSelection ReadRegulated(SectionView s) =>
        Deser<RegulatedSelection>(s.Blocks.FirstOrDefault()?.BodyJson) ?? new RegulatedSelection { OwnAuto = false };

    private static T? Deser<T>(string? json) where T : class
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try { return JsonSerializer.Deserialize<T>(json); }
        catch (JsonException) { return null; }
    }
}
