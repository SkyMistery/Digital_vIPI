@page "/sop/{Acc}/editor-trasferimenti"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject ITransferService Transfers

<PageTitle>Editor trasferimenti · IVAO Italia</PageTitle>

<div class="wrap">
    <div class="breadcrumb"><a href="/sop">Admin</a> › <a href="/sop/@Acc?.ToLowerInvariant()/editor">Editor</a> › <b>Trasferimenti</b></div>
    <div class="ed-toolbar">
        <h2 style="margin:0;flex:1">Editor trasferimenti — FIR @_acc?.Code</h2>
        <a class="btn ghost" href="/sop/@Acc?.ToLowerInvariant()/topologia">🧭 Topologia</a>
    </div>
    <div class="callout info"><span class="cic">🔄</span><div><p class="ct">Una riga, due viste</p>Ogni trasferimento si inserisce <b>una volta sola</b> come riga strutturata con la <b>catena handler ordinata</b>: l'Estesa la mostra completa, la Ridotta risolverà il "primo online" col polling (fase F3). Il fallback standard si applica se nessuno è online.</div></div>

    @if (_acc is null)
    {
        <div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="callout danger"><span class="cic">⛔</span><div>@_error</div></div>
        }
        @if (_status is not null)
        {
            <div class="callout success"><span class="cic">✓</span><div>@_status</div></div>
        }

        <div class="xfe-layout">
            <div class="panel">
                @if (_rows.Count == 0)
                {
                    <p class="help">Nessun trasferimento.</p>
                }
                else
                {
                    <table class="xfe-table">
                        <thead><tr><th>Relazione</th><th>Fase</th><th>Aeroporto</th><th>CoP</th><th>FL</th><th>Catena handler</th><th>Std</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in _rows)
                            {
                                <tr>
                                    <td>@t.RelationLabel</td>
                                    <td>@(t.Phase == TransferPhase.Arrival ? "Arrivo" : "Partenza")</td>
                                    <td>@t.AirportIcao</td>
                                    <td>@t.Cop</td>
                                    <td>@t.FlRule</td>
                                    <td><div class="chain">@for (var i = 0; i < t.HandlerChain.Count; i++) { if (i > 0) { <span class="ch-ar">→</span> } <span class="ch-h">@t.HandlerChain[i]</span> }</div></td>
                                    <td><span class="ch-std">@t.StandardFallback</span></td>
                                    <td><button class="btn ghost" disabled="@_busy" @onclick="() => Delete(t.Id)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="panel xfe-form">
                <h5>Nuova riga</h5>
                <div class="field"><label>Relazione (FIR↔FIR)</label><input placeholder="Roma ↔ Milano" @bind="_label" /></div>
                <div class="field"><label>Chiave relazione</label><input placeholder="LIRR-LIMM" @bind="_key" /></div>
                <div class="field"><label>Fase</label>
                    <div class="seg">
                        <button class="@(_phase==TransferPhase.Arrival?"on":"")" @onclick="() => _phase=TransferPhase.Arrival">Arrivo</button>
                        <button class="@(_phase==TransferPhase.Departure?"on":"")" @onclick="() => _phase=TransferPhase.Departure">Partenza</button>
                    </div>
                </div>
                <div class="field" style="display:flex;gap:10px">
                    <div style="flex:1"><label>Aeroporto</label><input placeholder="LIMC" @bind="_apt" /></div>
                    <div style="flex:1"><label>CoP</label><input placeholder="DEVOX" @bind="_cop" /></div>
                    <div style="width:110px"><label>FL</label><input placeholder="FL250↑" @bind="_fl" /></div>
                </div>
                <div class="field"><label>Catena handler (ordine di priorità)</label>
                    <div class="chain-build">
                        @for (var i = 0; i < _chain.Count; i++)
                        {
                            var idx = i;
                            <span class="cb"><b>@(idx + 1)</b> @_chain[idx] <span class="x" style="cursor:pointer" @onclick="() => RemoveHandler(idx)">✕</span></span>
                        }
                    </div>
                    <div style="display:flex;gap:6px;margin-top:8px">
                        <input placeholder="settore/callsign es. ES2" @bind="_handlerInput" />
                        <button class="btn ghost" @onclick="AddHandler">+ catena</button>
                    </div>
                </div>
                <div class="field"><label>Fallback standard</label><input placeholder="UNICOM / Confine" @bind="_fallback" /></div>
                <button class="btn primary" style="width:100%;margin-top:4px" disabled="@_busy" @onclick="Add">Aggiungi alla tabella</button>
                <div class="prev-box">
                    <div class="ph">👁️ Anteprima (Estesa)</div>
                    <div class="prev-res">@_cop @_fl → @(string.Join(" → ", _chain)) @(_chain.Count == 0 ? "" : " ") (std: @_fallback)</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Acc { get; set; } = default!;

    private AccInfo? _acc;
    private List<TransferRow> _rows = new();
    private bool _busy;
    private string? _status;
    private string? _error;

    // form
    private string _label = "", _key = "", _apt = "", _cop = "", _fl = "", _fallback = "UNICOM", _handlerInput = "";
    private TransferPhase _phase = TransferPhase.Arrival;
    private readonly List<string> _chain = new();

    protected override async Task OnInitializedAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        await LoadAsync();
    }

    private async Task LoadAsync() => _rows = (await Transfers.ListByFirAsync(_acc!.Code)).ToList();

    private void AddHandler()
    {
        var h = _handlerInput?.Trim();
        if (!string.IsNullOrEmpty(h)) { _chain.Add(h); _handlerInput = ""; }
    }
    private void RemoveHandler(int i) { if (i >= 0 && i < _chain.Count) _chain.RemoveAt(i); }

    private async Task Add()
    {
        _busy = true; _status = null; _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_key) || string.IsNullOrWhiteSpace(_cop))
                throw new InvalidOperationException("Chiave relazione e CoP sono obbligatori.");
            await Transfers.AddAsync(_acc!.Code, new TransferInput
            {
                RelationKey = _key.Trim(), RelationLabel = string.IsNullOrWhiteSpace(_label) ? _key.Trim() : _label.Trim(),
                Phase = _phase, AirportIcao = _apt.Trim(), Cop = _cop.Trim(), FlRule = _fl.Trim(),
                HandlerChain = _chain.ToList(), StandardFallback = _fallback.Trim(),
            });
            _cop = ""; _fl = ""; _apt = ""; _chain.Clear();
            await LoadAsync();
            _status = "Trasferimento aggiunto.";
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete(int id)
    {
        _busy = true; _status = null; _error = null;
        try { await Transfers.DeleteAsync(_acc!.Code, id); await LoadAsync(); _status = "Trasferimento eliminato."; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
