@page "/vsop/admin/sorgenti"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Abstractions
@using Vipi.Application.Content
@using Vipi.Application.Auth
@using Vipi.Domain
@inject IImportPolicyService Policy
@inject IImportOverviewService Overview
@inject IStaffRosterRepository StaffRoster
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Sorg_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <AdminNav />

    @* ---- Testata in UNA riga: titolo · «modificate» · «?» · Salva ----
       Il sottotitolo e gli otto paragrafi d'aiuto erano una fascia che diceva a chiunque, ogni volta, quello
       che il «?» dice a chi lo chiede (regola 7). La pill compare solo quando c'è una differenza rispetto al
       DB: «Salva» non è mai un tasto di cui non si sa se serve. *@
    <div class="doc-head st-head">
        <h2 class="st-h2">
            @L["Sorg_Title"]
            @if (Authz.IsAdmin && Cambiate.Count > 0)
            {
                <span>&nbsp;</span><span class="pill amber" title="@L["Sorg_DirtyTitle"]">@L["Sorg_Dirty", Cambiate.Count]</span>
            }
        </h2>
        <HelpHint Href="/vsop/guida#admin-sorgenti" AriaLabel="@L["Sorg_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Sorg_Subtitle"]</p>
            @((MarkupString)L["Sorg_Intro"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            <nav class="struct-nav">
                @* ⚠️ Cambiare una spunta non è come cambiare un filtro: decide chi vince al prossimo import, e
                   le due direzioni NON sono simmetriche. «manuale → da sorgente» sovrascrive il lavoro fatto
                   a mano ed è l'unica distruttiva: la conferma in linea la dice, categoria per categoria, e
                   diventa rossa solo in quel verso. Niente `confirm` nativo: blocca il circuito Blazor. *@
                <InlineConfirm TriggerClass="btn primary" Disabled="@(_busy || Cambiate.Count == 0)"
                               Prompt="@RaccontoDelCambio()" Danger="@Cambiate.Any(c => _p.IsImported(c))"
                               ConfirmLabel="@L["Common_Save"]" TriggerTitle="@L["Sorg_SaveTitle"]"
                               OnConfirm="Save">
                    <Trigger><Icon Name="check-circle" Size="14" /> @L["Common_Save"]</Trigger>
                </InlineConfirm>
                <button class="btn ghost" disabled="@(_busy || Cambiate.Count == 0)" @onclick="Annulla"
                        title="@L["Sorg_RevertTitle"]">@L["Common_Cancel"]</button>
            </nav>
            @if (_msg is not null || _ok is not null)
            {
                <span class="st-msg @(_msg is not null ? "warn" : "ok")" role="status" aria-live="polite">
                    <Icon Name="@(_msg is not null ? "warning" : "check-circle")" Size="14" />
                    <span class="st-msg-t">@(_msg ?? _ok)</span>
                    <button class="tclose" title="@L["Common_Close"]" @onclick="() => { _msg = _ok = null; }">✕</button>
                </span>
            }
        }
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else if (_righe is null)
    {
        <LoadingState />
    }
    else
    {
        @* ---- UNA tabella, non due ----
           Prima ce n'erano due che parlavano delle stesse cinque cose con due vocabolari: sopra «Settori»,
           sotto `AirportSector`; sopra «da sorgente / manuale», sotto «ok / errore». Il lettore doveva fare a
           mente un join che sbagliava — nell'elenco degli stati compariva anche il segnaposto delle aree
           estere, che import non è, e mancava la riga dell'anagrafica ACC, che si importa ogni giorno.
           ⚠️ Qui il `thead` appiccicato NON serve e non si mette: sei righe, e sono sei per sempre. *@
        <div class="panel st-pane sorg-pane">
            <div class="st-scroll">
                <table class="res-table sorg-table">
                    <thead>
                        <tr>
                            <th class="c-cat">@L["Sorg_ColCategory"]</th>
                            @* L'etichetta sale qui: «importa dalla sorgente» stava scritto cinque volte, una per riga. *@
                            <th class="c-prov">@L["Sorg_ColProvenance"]</th>
                            <th class="c-upd">@L["Sorg_ColLastUpdate"]</th>
                            <th class="c-where">@L["Sorg_ColWhere"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _righe)
                        {
                            <tr>
                                <td class="c-cat">
                                    <b>@Nome(r)</b>
                                    <div class="muted sorg-desc">@Descrizione(r)</div>
                                </td>
                                <td class="c-prov">
                                    @if (r.Categoria is ImportCategory cat)
                                    {
                                        @* La spunta e la parola sono la STESSA informazione: una cella sola.
                                           `@bind:after` perché la pill «modificate» e i tasti si accendono al
                                           cambio, non al render successivo. *@
                                        <label class="se-row sorg-pick">
                                            <input type="checkbox" checked="@_p.IsImported(cat)"
                                                   @onchange="e => Cambia(cat, (bool)(e.Value ?? false))" />
                                            <span>@(_p.IsImported(cat) ? L["Sorg_ProvSource"] : L["Sorg_ProvManual"])</span>
                                        </label>
                                        @if (cat == ImportCategory.SpecialAreas && !_p.SpecialAreas)
                                        {
                                            @* Le aree non sono editabili da nessuna pagina: escluderle non le
                                               rende manuali, le congela. *@
                                            <div class="muted sorg-desc">❄ @L["Sorg_SpecialAreasFrozen"]</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="muted">🔒 @L["Sorg_ProvSourceAlways"]</span>
                                    }
                                </td>
                                <td class="c-upd">
                                    <span class="pill @ClassePill(r.Stato)" title="@TitoloStato(r)">@Stato(r.Stato)</span>
                                    <div class="muted sorg-desc">@Quando(r)</div>
                                </td>
                                <td class="c-where">
                                    @* La riga porta al posto da cui l'import si lancia a mano: un sesto
                                       bottone «importa adesso» su questa pagina sarebbe il modo in cui due
                                       comandi della stessa cosa divergono. *@
                                    @foreach (var (testo, href) in Dove(r))
                                    {
                                        <a class="lnk-mini" href="@href">@testo</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @* Chi ha deciso. ⚠️ Autore 0 = nessuna persona ha mai salvato: le esclusioni che si vedono
                   vengono dai default delle colonne. Non è archeologia — ImportSids è nato `false` su un DB
                   già popolato (migration AddSidImport, luglio 2026), e senza questa riga un import fermo da
                   mesi è indistinguibile da una scelta dell'amministratore. *@
                <p class="help sorg-who">
                    @if (_info is { MaiDecisa: true })
                    {
                        <span class="@(EscluseOra > 0 ? "sorg-never" : "")">@L["Sorg_NeverDecided"]</span>
                    }
                    else if (_info is { UpdatedUtc: DateTime quando })
                    {
                        @L["Sorg_DecidedBy", _autore ?? _info.UpdatedByUserId.ToString(), quando.ToString("dd MMM yyyy · HH:mm")]
                    }
                </p>
            </div>
        </div>
    }
</div>

@code {
    private ImportPolicySnapshot _p = ImportPolicySnapshot.AllImported;
    private ImportPolicySnapshot _salvata = ImportPolicySnapshot.AllImported;
    private ImportPolicyInfo? _info;
    private IReadOnlyList<ImportOverviewRow>? _righe;
    private string? _autore;
    private bool _busy;
    private string? _msg, _ok;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Authz.IsAdmin) return;
        // «Schermo meno ciò che sta sopra» non è esprimibile in CSS: si misura, e a OGNI render — il «?»
        // aperto, la conferma in linea e la fascia di stato cambiano ciò che sta sopra.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".sorg-pane", 900); } catch (Exception) { }
    }

    private async Task LoadAsync()
    {
        _info = await Policy.GetInfoAsync();
        _p = _salvata = _info.Policy;
        _righe = await Overview.ListAsync();

        // Un VID non è un nome: il roster ce l'ha già (come su Audit, Versioni e Permessi).
        _autore = null;
        if (!_info.MaiDecisa)
            _autore = (await StaffRoster.GetDisplayNamesAsync(new[] { _info.UpdatedByUserId }))
                .TryGetValue(_info.UpdatedByUserId, out var n) ? n : null;
    }

    /// <summary>Le categorie che differiscono da quanto è salvato. È ciò che contano la pill e la conferma.</summary>
    private List<ImportCategory> Cambiate =>
        Enum.GetValues<ImportCategory>().Where(c => _p.IsImported(c) != _salvata.IsImported(c)).ToList();

    private int EscluseOra => Enum.GetValues<ImportCategory>().Count(c => !_salvata.IsImported(c));

    private void Cambia(ImportCategory cat, bool daSorgente)
    {
        _p = cat switch
        {
            ImportCategory.TransitionAltitude => _p with { TransitionAltitude = daSorgente },
            ImportCategory.Runways => _p with { Runways = daSorgente },
            ImportCategory.Sectors => _p with { Sectors = daSorgente },
            ImportCategory.Sids => _p with { Sids = daSorgente },
            _ => _p with { SpecialAreas = daSorgente },
        };
        _msg = _ok = null;
    }

    private void Annulla()
    {
        _p = _salvata;
        _msg = _ok = null;
    }

    /// <summary>
    /// Il racconto del cambio, una frase per categoria toccata. ⚠️ Le due direzioni non si mescolano: quella
    /// verso la sorgente dice che al prossimo import il lavoro fatto a mano sparisce, ed è la sola distruttiva.
    /// Sono le stesse frasi che finiscono nel registro di audit: un vocabolario solo.
    /// </summary>
    private string RaccontoDelCambio()
    {
        var frasi = Cambiate.Select(c => _p.IsImported(c)
            ? L["Sorg_ChangeToSource", ImportCategoryLabels.Etichetta(c, L)].Value
            : L["Sorg_ChangeToManual", ImportCategoryLabels.Etichetta(c, L)].Value);
        return string.Join(" ", frasi);
    }

    private async Task Save()
    {
        _busy = true; _msg = _ok = null;
        try
        {
            await Policy.SaveAsync(_p);
            _ok = L["Sorg_Saved"];
            await LoadAsync();       // stato e provenienze si rileggono insieme: sono la stessa riga
        }
        catch (EditNotAllowedException) { _msg = L["Common_OpAdminOnly"]; }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // ---- come si legge una riga ------------------------------------------------------------------------

    private string Nome(ImportOverviewRow r) =>
        r.Categoria is ImportCategory c ? ImportCategoryLabels.Etichetta(c, L) : L["Sorg_AccLabel"];

    private string Descrizione(ImportOverviewRow r) => r.Categoria switch
    {
        // Non è prosa d'aiuto, è il dato: dice QUALI colonne la sorgente possiede.
        ImportCategory.TransitionAltitude => L["Sorg_TaDesc"],
        ImportCategory.Runways => L["Sorg_RunwaysDesc"],
        ImportCategory.Sectors => L["Sorg_SectorsDesc"],
        ImportCategory.Sids => L["Sorg_SidDesc"],
        ImportCategory.SpecialAreas => L["Sorg_SpecialAreasDesc"],
        _ => L["Sorg_AccDesc"],
    };

    private string Stato(ImportHealth h) => L["Sorg_St_" + h];

    /// <summary>⚠️ «Esclusa» è NEUTRO, non verde e non rosso: è una scelta, non un guasto (regola 108).</summary>
    private static string ClassePill(ImportHealth h) => h switch
    {
        ImportHealth.Aggiornata => "green",
        ImportHealth.InErrore => "red",
        ImportHealth.Ferma => "amber",
        _ => "neutral",
    };

    /// <summary>Il dato grezzo non si butta e non si mette in colonna: l'errore per esteso sta nel title.</summary>
    private string TitoloStato(ImportOverviewRow r) => r.UltimoErrore ?? Stato(r.Stato);

    private string Quando(ImportOverviewRow r)
    {
        if (r.Stato == ImportHealth.SuRichiesta) return L["Sorg_OnDemand"];
        if (r.UltimoErrore is { Length: > 0 } err) return err;
        if (r.UltimoSuccessoUtc is not DateTime u) return "—";
        var ultimo = u.ToString("dd MMM · HH:mm 'UTC'");
        return r.ProssimoUtc is DateTime p
            ? L["Sorg_LastAndNext", ultimo, p.ToString("dd MMM · HH:mm")]
            : ultimo;
    }

    /// <summary>Dove si tocca quel dato. Il link va all'elenco, non a un aeroporto a caso.</summary>
    private IEnumerable<(string Testo, string Href)> Dove(ImportOverviewRow r) => r.Categoria switch
    {
        ImportCategory.TransitionAltitude or ImportCategory.Runways or ImportCategory.Sids =>
            new[] { (L["Struct_NavAirports"].Value, "/vsop/admin/airports") },
        ImportCategory.Sectors => new[]
        {
            (L["Struct_Title"].Value, "/vsop/admin/sectorstructure"),
            (L["Struct_NavAirports"].Value, "/vsop/admin/airports"),
        },
        _ => new[] { (L["Struct_NavAcc"].Value, "/vsop/admin/acc") },
    };
}
