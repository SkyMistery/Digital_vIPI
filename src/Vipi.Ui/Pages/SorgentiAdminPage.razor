@page "/services/vsop/admin/sources"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Abstractions
@using Vipi.Application.Content
@using Vipi.Application.Auth
@using Vipi.Domain
@inject IImportPolicyService Policy
@inject IImportOverviewService Overview
@inject INavaidSource Navaids
@inject ISidFixAliasRepository SidAliases
@inject IStaffRosterRepository StaffRoster
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Sorg_Title"] · vIPI IVAO Italy</PageTitle>

<div class="wrap struct">
    <AdminNav />

    @* ---- Testata in UNA riga: titolo · «modificate» · «?» · Salva ----
       Il sottotitolo e gli otto paragrafi d'aiuto erano una fascia che diceva a chiunque, ogni volta, quello
       che il «?» dice a chi lo chiede (regola 7). La pill compare solo quando c'è una differenza rispetto al
       DB: «Salva» non è mai un tasto di cui non si sa se serve. *@
    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Sorg_Title"]
            @if (Authz.IsAdmin && Cambiate.Count > 0)
            {
                <span>&nbsp;</span><span class="pill amber" title="@L["Sorg_DirtyTitle"]">@L["Sorg_Dirty", Cambiate.Count]</span>
            }
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-sorgenti" AriaLabel="@L["Sorg_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Sorg_Subtitle"]</p>
            @((MarkupString)L["Sorg_Intro"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            <nav class="struct-nav">
                @* ⚠️ Cambiare una spunta non è come cambiare un filtro: decide chi vince al prossimo import, e
                   le due direzioni NON sono simmetriche. «manuale → da sorgente» sovrascrive il lavoro fatto
                   a mano ed è l'unica distruttiva: la conferma in linea la dice, categoria per categoria, e
                   diventa rossa solo in quel verso. Niente `confirm` nativo: blocca il circuito Blazor. *@
                <InlineConfirm TriggerClass="btn primary" Disabled="@(_busy || Cambiate.Count == 0)"
                               Prompt="@RaccontoDelCambio()" Danger="@Cambiate.Any(c => _p.IsImported(c))"
                               ConfirmLabel="@L["Common_Save"]" TriggerTitle="@L["Sorg_SaveTitle"]"
                               OnConfirm="Save">
                    <Trigger><Icon Name="check-circle" Size="14" /> @L["Common_Save"]</Trigger>
                </InlineConfirm>
                @* ⚠️ «Ripristina» e non «Annulla»: con la conferma aperta questo tasto sta ACCANTO
                   all'«Annulla» di InlineConfirm, e i due fanno cose diverse — uno chiude la domanda, l'altro
                   butta le modifiche. Due tasti con la stessa parola a due centimetri l'uno dall'altro è un
                   difetto che si vede solo guardando la schermata: nessuna misura lo trova. *@
                <button class="btn ghost" disabled="@(_busy || Cambiate.Count == 0)" @onclick="Annulla"
                        title="@L["Sorg_RevertTitle"]">@L["Sorg_Revert"]</button>
                @* Il catalogo dei punti non è una categoria d'import — non ha una spunta e non finisce in
                   tabella, perché non tocca il database: vive in memoria e serve a suggerire i nomi negli
                   editor. Il tasto sta qui lo stesso perché questa è la pagina di chi guarda la SORGENTE, ed
                   è l'unico posto da cui si può dire «rileggila adesso» senza aspettare le ventiquattro ore. *@
                <button class="btn ghost" disabled="@_busy" @onclick="RicaricaCatalogo"
                        title="@L["Sorg_ReloadNavaidsTitle"]"><Icon Name="refresh" Size="14" /> @L["Sorg_ReloadNavaids"]</button>
            </nav>
            <LiveRegion>
                @if (_msg is not null || _ok is not null)
                {
                    <span class="st-msg @(_msg is not null ? "warn" : "ok")">
                        <Icon Name="@(_msg is not null ? "warning" : "check-circle")" Size="14" />
                        <span class="st-msg-t">@(_msg ?? _ok)</span>
                        <button class="tclose" title="@L["Common_Close"]" @onclick="() => { _msg = _ok = null; }">✕</button>
                    </span>
                }
            </LiveRegion>
        }
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else if (_righe is null)
    {
        <LoadingState />
    }
    else
    {
        @* ---- UNA tabella, non due ----
           Prima ce n'erano due che parlavano delle stesse cinque cose con due vocabolari: sopra «Settori»,
           sotto `AirportSector`; sopra «da sorgente / manuale», sotto «ok / errore». Il lettore doveva fare a
           mente un join che sbagliava — nell'elenco degli stati compariva anche il segnaposto delle aree
           estere, che import non è, e mancava la riga dell'anagrafica ACC, che si importa ogni giorno.
           ⚠️ Qui il `thead` appiccicato NON serve e non si mette: sei righe, e sono sei per sempre.
           ⚠️ E il riquadro si misura con `vipiCapViewport`, non con `vipiFitViewport`: `max-height`, non
           `height`. Con `height` il riquadro veniva stirato a tutto lo schermo per contenere sei righe e
           lasciava mezzo pannello di bianco; senza misura affatto, a 1024×768 e da zoom 1.25 in su la pagina
           tornava a scorrere. Il tetto fa entrambe le cose: alto quanto il contenuto quando ci sta, e dentro
           scorre solo quando non ci starebbe. *@
        <div class="panel st-pane sorg-pane">
            <div class="st-scroll">
            <table class="res-table sorg-table">
                <thead>
                    <tr>
                        <th class="c-cat">@L["Sorg_ColCategory"]</th>
                        @* L'etichetta sale qui: «importa dalla sorgente» stava scritto cinque volte, una per riga. *@
                        <th class="c-prov">@L["Sorg_ColProvenance"]</th>
                        <th class="c-upd">@L["Sorg_ColLastUpdate"]</th>
                        <th class="c-where">@L["Sorg_ColWhere"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _righe)
                    {
                        @* Nome, descrizione e link vengono da UNA tabella (ImportCategoryLabels.Riga):
                           erano tre switch sulla stessa categoria, e ognuno aveva un ramo di scarto che
                           voleva dire «anagrafica ACC» — con la seconda anagrafica avrebbero chiamato ACC
                           anche gli aeroporti, in silenzio. Letta una volta per riga, non tre. *@
                        var t = ImportCategoryLabels.Riga(r, L);
                        <tr>
                            <td class="c-cat">
                                <b>@t.Nome</b>
                                <div class="muted sorg-desc">@t.Descrizione</div>
                            </td>
                            <td class="c-prov">
                                @if (r.Categoria is ImportCategory cat)
                                {
                                    @* La spunta e la parola sono la STESSA informazione: una cella sola —
                                       prima erano una colonna «Provenienza» e una casella che dicevano
                                       l'una il valore dell'altra.
                                       ⚠️ `@onchange` e non `@bind`: la pill «modificate» e i due tasti si
                                       accendono al cambio, e il valore va scritto nel record `_p` (che è
                                       immutabile) — un `@bind` a `_p.Qualcosa` non si può scrivere. *@
                                    <label class="sorg-pick">
                                        <input type="checkbox" checked="@_p.IsImported(cat)"
                                               @onchange="e => Cambia(cat, (bool)(e.Value ?? false))" />
                                        <span>@(_p.IsImported(cat) ? L["Sorg_ProvSource"] : L["Sorg_ProvManual"])</span>
                                    </label>
                                    @if (cat == ImportCategory.SpecialAreas && !_p.SpecialAreas)
                                    {
                                        @* Le aree non sono editabili da nessuna pagina: escluderle non le
                                           rende manuali, le congela. *@
                                        <div class="muted sorg-desc">❄ @L["Sorg_SpecialAreasFrozen"]</div>
                                    }
                                }
                                else
                                {
                                    <span class="muted">🔒 @L["Sorg_ProvSourceAlways"]</span>
                                }
                            </td>
                            <td class="c-upd">
                                <span class="pill @ClassePill(r.Stato)" title="@TitoloStato(r)">@Stato(r.Stato)</span>
                                @* Il messaggio della sorgente non si butta e non si prende la riga: due righe
                                   a vista (clamp) e per intero nel `title`. Un errore di rete lungo quattro
                                   righe faceva la riga SID alta il doppio di tutte le altre. *@
                                <div class="muted sorg-desc @(r.Stato == ImportHealth.InErrore ? "sorg-err" : "")"
                                     title="@TitoloStato(r)">@Quando(r)</div>
                            </td>
                            <td class="c-where">
                                @* La riga porta al posto da cui l'import si lancia a mano: un bottone
                                   «importa adesso» su questa pagina sarebbe il modo in cui due comandi
                                   della stessa cosa divergono. *@
                                @foreach (var (testo, href) in t.Dove)
                                {
                                    <a class="lnk-mini" href="@href">@testo</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* Chi ha deciso. ⚠️ Autore 0 = nessuna persona ha mai salvato: le esclusioni che si vedono
               vengono dai default delle colonne. Non è archeologia — ImportSids è nato `false` su un DB
               già popolato (migration AddSidImport, luglio 2026), e senza questa riga un import fermo da
               mesi è indistinguibile da una scelta dell'amministratore. *@
            <p class="help sorg-who">
                @if (_info is { MaiDecisa: true })
                {
                    <span class="@(EscluseOra > 0 ? "sorg-never" : "")">@L["Sorg_NeverDecided"]</span>
                }
                else if (_info is { UpdatedUtc: DateTime quando })
                {
                    @* Senza nome dal roster resta il VID, e dentro una frase già formattata lo rende
                       premibile `VidText`. ⚠️ Il ripiego passa da `Audit_VidN` («VID 1234567») e non dal
                       numero nudo: è la forma che `VidText` sa tagliare. *@
                    <VidText Testo="@L["Sorg_DecidedBy", _autore ?? L["Audit_VidN", _info.UpdatedByUserId].Value, quando.ToString("dd MMM yyyy · HH:mm")].Value" />
                }
            </p>

            @* ---- Alias dei fix ----
               Stanno QUI, dentro il riquadro che si misura da solo, e non in una pagina propria: sono la
               toppa manuale sopra la sorgente, cioe' esattamente la domanda di questa pagina. Un riquadro in
               piu' sotto avrebbe rimesso a scorrere una pagina che e' stata messa a misura apposta.

               ⚠️ Fino a oggi si potevano solo CREARE (la casella «alias» nell'editor aeroporto) e non si
               vedevano da nessuna parte: `ListAsync` e `DeleteAsync` esistevano nel repository e non li
               chiamava nessuno. Un alias sbagliato — o diventato sbagliato perche' il punto e' sparito dal
               sectorfile — restava a risolvere per sempre, in silenzio, leggibile solo nel database. *@
            <h2 class="h-sect sorg-h3">@L["Sorg_AliasTitle"] <span class="pill blue">@(_alias?.Count ?? 0)</span></h2>
            <p class="help sorg-aliashelp">@L["Sorg_AliasHelp"]</p>

            @if (_alias is null)
            {
                <LoadingState />
            }
            else if (_alias.Count == 0)
            {
                <p class="muted sorg-desc">@L["Sorg_AliasNone"]</p>
            }
            else
            {
                <table class="res-table sorg-alias">
                    <thead><tr><th class="c-pfx">@L["Sorg_AliasColPrefix"]</th><th class="c-fix">@L["Sorg_AliasColFix"]</th><th class="c-act"></th></tr></thead>
                    <tbody>
                        @foreach (var a in _alias)
                        {
                            var ignoto = NavaidCheck.IsUnknown(a.FixName, _navaids);
                            <tr>
                                <td class="c-pfx"><b>@a.Prefix</b></td>
                                <td class="c-fix">
                                    @* Il segno e' lo stesso dei CoP fuori catalogo: un nome che non risulta si
                                       sottolinea e si spiega nel suggerimento. Qui vale doppio, perche' l'alias
                                       e' autoritativo — vince sull'espansione del prefisso — quindi un bersaglio
                                       morto continuerebbe a essere scritto negli import senza che nulla protesti. *@
                                    @if (ignoto)
                                    {
                                        <span class="nav-unknown-txt" title="@L["Sorg_AliasUnknown"]">@a.FixName</span>
                                        <Icon Name="warning" Size="12" />
                                    }
                                    else { @a.FixName }
                                </td>
                                <td class="c-act">
                                    <InlineConfirm TriggerClass="btn ghost" Disabled="@_busy" Danger="true"
                                                   Prompt="@L["Sorg_AliasDeletePrompt", a.Prefix, a.FixName].Value"
                                                   ConfirmLabel="@L["Common_Remove"]"
                                                   TriggerTitle="@L["Sorg_AliasDeleteTitle"]"
                                                   AriaLabel="@L["Sorg_AliasDeleteTitle"]"
                                                   OnConfirm="() => EliminaAlias(a)">
                                        <Trigger>✕</Trigger>
                                    </InlineConfirm>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
        </div>
    }
</div>

@code {
    private ImportPolicySnapshot _p = ImportPolicySnapshot.AllImported;
    private ImportPolicySnapshot _salvata = ImportPolicySnapshot.AllImported;
    private ImportPolicyInfo? _info;
    private IReadOnlyList<ImportOverviewRow>? _righe;

    /// <summary>Gli alias fix, o null finché non sono letti. Vivono qui perché questa è la pagina della
    /// sorgente, e un alias è la deroga manuale a ciò che la sorgente dice.</summary>
    private IReadOnlyList<SidFixAliasRow>? _alias;

    /// <summary>Il catalogo dei punti: serve a dire quali alias puntano a un nome che non esiste più. Vuoto
    /// finché non arriva (e per sempre, se la sorgente tace): in quel caso non si segnala nulla.</summary>
    private NavaidCatalog _navaids = NavaidCatalog.Empty;
    private string? _autore;
    private bool _busy;
    private string? _msg, _ok;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Authz.IsAdmin) return;

        // Il catalogo DOPO il primo disegno e non in apertura: è una discesa da GitHub con quindici secondi di
        // timeout, e in `OnInitializedAsync` significherebbe una pagina che non compare quando la sorgente è
        // lenta. Serve solo a marcare gli alias, quindi può arrivare un istante dopo.
        if (firstRender)
        {
            try
            {
                _navaids = await Navaids.GetAsync();
                if (_navaids.Entries.Count > 0) StateHasChanged();
            }
            catch (Exception) { }
        }

        // A OGNI render: il «?» aperto, la conferma in linea e la fascia di stato cambiano ciò che sta sopra,
        // e «schermo meno ciò che sta sopra» in CSS non è esprimibile.
        try { await JS.InvokeVoidAsync("vipiCapViewport", ".sorg-pane", 900); } catch (Exception) { }
    }

    private async Task LoadAsync()
    {
        _info = await Policy.GetInfoAsync();
        _p = _salvata = _info.Policy;
        _righe = await Overview.ListAsync();
        _alias = await SidAliases.ListAsync();

        // Un VID non è un nome: il roster ce l'ha già (come su Audit, Versioni e Permessi).
        _autore = null;
        if (!_info.MaiDecisa)
            _autore = (await StaffRoster.GetDisplayNamesAsync(new[] { _info.UpdatedByUserId }))
                .TryGetValue(_info.UpdatedByUserId, out var n) ? n : null;
    }

    /// <summary>Le categorie che differiscono da quanto è salvato. È ciò che contano la pill e la conferma.</summary>
    private List<ImportCategory> Cambiate =>
        Enum.GetValues<ImportCategory>().Where(c => _p.IsImported(c) != _salvata.IsImported(c)).ToList();

    private int EscluseOra => Enum.GetValues<ImportCategory>().Count(c => !_salvata.IsImported(c));

    private void Cambia(ImportCategory cat, bool daSorgente)
    {
        _p = cat switch
        {
            ImportCategory.TransitionAltitude => _p with { TransitionAltitude = daSorgente },
            ImportCategory.Runways => _p with { Runways = daSorgente },
            ImportCategory.Sectors => _p with { Sectors = daSorgente },
            ImportCategory.Sids => _p with { Sids = daSorgente },
            ImportCategory.AtcSessions => _p with { AtcSessions = daSorgente },
            _ => _p with { SpecialAreas = daSorgente },
        };
        _msg = _ok = null;
    }

    private void Annulla()
    {
        _p = _salvata;
        _msg = _ok = null;
    }

    /// <summary>
    /// Il racconto del cambio, una frase per categoria toccata. ⚠️ Le due direzioni non si mescolano: quella
    /// verso la sorgente dice che al prossimo import il lavoro fatto a mano sparisce, ed è la sola distruttiva.
    /// Sono le stesse frasi che finiscono nel registro di audit: un vocabolario solo.
    /// </summary>
    private string RaccontoDelCambio()
    {
        // Raggruppate per VERSO, non una frase per categoria: la spiegazione è la stessa per tutte quelle che
        // vanno nella stessa direzione, e ripetuta cinque volte diventa un muro che nessuno legge. È anche la
        // forma che ha la riga di audit — un vocabolario solo.
        var frasi = new List<string>();
        var verso = Elenco(Cambiate.Where(c => _p.IsImported(c)));
        var manuali = Elenco(Cambiate.Where(c => !_p.IsImported(c)));
        if (verso is not null) frasi.Add(L["Sorg_ChangeToSource", verso]);
        if (manuali is not null) frasi.Add(L["Sorg_ChangeToManual", manuali]);
        return string.Join(" ", frasi);
    }

    private string? Elenco(IEnumerable<ImportCategory> cat)
    {
        var nomi = cat.Select(c => ImportCategoryLabels.Etichetta(c, L)).ToList();
        return nomi.Count == 0 ? null : string.Join(", ", nomi);
    }

    private async Task Save()
    {
        _busy = true; _msg = _ok = null;
        try
        {
            await Policy.SaveAsync(_p);
            _ok = L["Sorg_Saved"];
            await LoadAsync();       // stato e provenienze si rileggono insieme: sono la stessa riga
        }
        catch (EditNotAllowedException) { _msg = L["Common_OpAdminOnly"]; }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RicaricaCatalogo()
    {
        if (!Authz.IsAdmin) return;
        _busy = true; _msg = _ok = null;
        try
        {
            var catalogo = await Navaids.RefreshAsync();
            _navaids = catalogo;   // i segni sugli alias devono raccontare il catalogo APPENA riletto
            // Il conteggio e non un «fatto»: e' l'unica cosa che dice se la sorgente ha risposto davvero. Zero
            // voci con la sorgente configurata significa file spostati, ed e' esattamente cio' che si vuole vedere.
            _ok = L["Sorg_ReloadNavaidsOk", catalogo.Entries.Count];
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>
    /// Toglie un alias. Non tocca le SID già importate: la risoluzione cambia al prossimo import, e questo è
    /// voluto — un alias sbagliato ha scritto un fix sbagliato su righe che possono avere sopra del lavoro
    /// editoriale, e cancellarlo qui vorrebbe dire deciderlo per conto di chi quel lavoro l'ha fatto.
    /// </summary>
    private async Task EliminaAlias(SidFixAliasRow a)
    {
        if (!Authz.IsAdmin) return;
        _busy = true; _msg = _ok = null;
        try
        {
            await SidAliases.DeleteAsync(a.Id);
            _alias = await SidAliases.ListAsync();
            _ok = L["Sorg_AliasDeleted", a.Prefix];
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // ---- come si legge una riga ------------------------------------------------------------------------

    private string Stato(ImportHealth h) => L["Sorg_St_" + h];

    /// <summary>⚠️ «Esclusa» è NEUTRO, non verde e non rosso: è una scelta, non un guasto (regola 108).</summary>
    private static string ClassePill(ImportHealth h) => h switch
    {
        ImportHealth.Aggiornata => "green",
        ImportHealth.InErrore => "red",
        ImportHealth.Ferma => "amber",
        _ => "neutral",
    };

    /// <summary>Il dato grezzo non si butta e non si mette in colonna: l'errore per esteso sta nel title.</summary>
    private string TitoloStato(ImportOverviewRow r) =>
        r.Stato == ImportHealth.InErrore ? r.UltimoErrore! : Stato(r.Stato);

    /// <summary>
    /// La riga sotto la pill. Dice quello che la pill <b>non</b> dice: mai la stessa cosa due volte.
    ///
    /// <para>⚠️ Una categoria <b>esclusa</b> non annuncia il prossimo giro. La riga di stato in archivio è
    /// rimasta lì con la sua cadenza — <c>GatedImportLoop</c> continua a marcare il successo anche quando il
    /// run esce subito — e mostrarne il «prossimo» sarebbe la stessa bugia che il giro ha tolto dalla pill,
    /// spostata di una cella. Resta la data dell'<b>ultimo dato</b>, che è vera e serve: dice quanto è
    /// vecchio ciò che si sta guardando.</para>
    /// </summary>
    private string Quando(ImportOverviewRow r)
    {
        var ultimo = r.UltimoSuccessoUtc?.ToString("dd MMM · HH:mm 'UTC'");
        var ultimoDato = ultimo is null ? "" : L["Sorg_LastData", ultimo].Value;

        // ⚠️ L'ordine conta: una categoria ESCLUSA non racconta l'errore dell'ultimo giro. Quel giro è di
        // prima della decisione e non la riguarda più — raccontarlo è il verde regalato, al contrario.
        if (r.Stato is ImportHealth.Esclusa) return ultimoDato;
        if (r.UltimoErrore is { Length: > 0 } err) return err;
        if (ultimo is null) return "";                              // la pill dice già «su richiesta»/«mai eseguita»
        if (r.Stato is ImportHealth.SuRichiesta) return ultimoDato;

        // ⚠️ Un «prossimo» che sta nel PASSATO non è un'attesa, è la prova che il giro è saltato: su una riga
        // ferma da tre giorni la pagina annunciava «prossimo 19 agosto» col 21 sul calendario.
        return r.ProssimoUtc is DateTime p
            ? L[p > DateTime.UtcNow ? "Sorg_LastAndNext" : "Sorg_LastAndMissed", ultimo, p.ToString("dd MMM · HH:mm")]
            : ultimo;
    }
}
