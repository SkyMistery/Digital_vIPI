@page "/services/vsop/{Acc}/apps"
@layout SopLayout
@inject IStringLocalizer<SharedResource> L
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject IDocumentAdminService Docs
@inject IOnlineAtcProvider Online
@inject IEditAuthorizationService Authz

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@L["Apps_Title"] @_acc.Code · vIPI IVAO Italia</PageTitle>
    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@L["Apps_Title"]</b></div>
        <div class="doc-head">
            <div><h1 class="page-h1" style="margin-bottom:2px">@L["Apps_Title"] — @_acc.Name - @_acc.Code</h1></div>
        </div>
        @if (_canEdit)
        {
            <p class="help" style="margin-top:2px">@((MarkupString)L["Apps_StaffHelp"].Value)</p>
        }
        @if (_apps.Count == 0)
        {
            <EmptyState Title="@L["Apps_EmptyTitle"]">@L["Apps_EmptyBody"]</EmptyState>
        }
        else
        {
            <div class="choice-grid" style="margin-top:14px">
                @foreach (var ap in _apps)
                {
                    var n = OnlineAt(ap);
                    var st = StateOf(ap.Callsign);
                    // Pubblicato → viewer pubblico. Non pubblicato (bozza/senza doc) → editor (solo staff arriva qui: crea/edita).
                    var href = st == AppState.Published
                        ? $"/services/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={ap.Callsign}"
                        : $"/services/vsop/{Acc.ToLowerInvariant()}/apps/editor?app={ap.Callsign}";
                    <a class="choice apt-card" href="@href">
                        <div class="apt-top">
                            <h2 class="h-card">@(ap.AirportIcao ?? ap.Callsign)</h2>
                            <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? L["Common_NOnline", n].Value : L["Common_Offline"].Value)</span>
                        </div>
                        <p class="muted">@ap.Name</p>
                        <span class="apt-tag">@ap.Callsign</span>
                        @if (st == AppState.None)
                        {
                            <span class="apt-tag" style="background:var(--ivao-blue);color:var(--on-brand);margin-left:6px">＋ @L["Apps_CreateDoc"]</span>
                        }
                        else if (st == AppState.Draft)
                        {
                            <span class="apt-tag" style="background:var(--warn-ink);color:var(--on-brand);margin-left:6px">@L["Apps_Draft"]</span>
                        }
                        else if (st == AppState.Hidden)
                        {
                            <span class="apt-tag" style="margin-left:6px">@L["Apps_Hidden"]</span>
                        }
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private enum AppState { None, Draft, Published, Hidden }

    [Parameter] public string Acc { get; set; } = default!;
    private AccInfo? _acc;
    private IReadOnlyList<SectorRow> _apps = Array.Empty<SectorRow>();
    private bool _canEdit;
    private Dictionary<string, AppState> _state = new(StringComparer.OrdinalIgnoreCase);   // callsign → stato documento

    private AppState StateOf(string callsign) => _state.TryGetValue(callsign, out var s) ? s : AppState.None;

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _canEdit = await Authz.CanEditAccAsync(_acc.Code);
        var data = await Structure.LoadAsync(_acc.Code);
        var all = data?.Sectors ?? (IReadOnlyList<SectorRow>)Array.Empty<SectorRow>();

        // Stato del documento per callsign APP di questa ACC. Assente dalla lista ⇒ nessun documento ancora (AppState.None).
        _state = (await Docs.ListAsync())
            .Where(m => m.Kind == ManagedDocKind.AppVipi
                        && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase))
            .GroupBy(m => m.Scope, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g =>
            {
                var m = g.First();
                // Visibilità pubblica = release AIRAC effettiva (doc 10 §3f, doc 11 §3e), la stessa regola della
                // pagina: prima l'elenco guardava lo stato del Document, quindi un APP servito al pubblico poteva
                // comparire qui come bozza e linkare all'editor invece che al documento.
                return m.IsHidden ? AppState.Hidden : m.HasEffectiveRelease ? AppState.Published : AppState.Draft;
            }, StringComparer.OrdinalIgnoreCase);

        // APP NON remotizzati (ApproachKind.Standalone: doc proprio; i Remotized vivono nella vIPI di ACC).
        // Pubblico: solo i pubblicati. Staff che può editare l'ACC: TUTTI (per creare/editare il primo documento).
        var standalone = all
            .Where(s => s.Type == SectorType.App && s.ApproachKind == ApproachKind.Standalone
                        && (_canEdit || StateOf(s.Callsign) == AppState.Published))
            .ToList();
        var standaloneIds = standalone.Select(s => s.Id).ToHashSet();
        var byId = all.ToDictionary(s => s.Id);

        // Collasso d'albero: se un APP standalone ha un antenato che è a sua volta un APP standalone (mostrato),
        // si mostra solo l'antenato (es. LIBN_G_APP sotto LIBN_APP ⇒ solo LIBN_APP).
        bool HasStandaloneAncestor(SectorRow s)
        {
            var pid = s.ParentSectorId;
            while (pid is int id && byId.TryGetValue(id, out var p))
            {
                if (standaloneIds.Contains(p.Id)) return true;
                pid = p.ParentSectorId;
            }
            return false;
        }

        _apps = standalone.Where(s => !HasStandaloneAncestor(s)).OrderBy(s => s.Callsign).ToList();
    }

    // ATC online per l'APP: callsign APP/DEP il cui primo token è l'ICAO d'aeroporto collegato (o la testa del callsign).
    // Il nodo mostrato ingloba i figli collassati (es. LIBN_APP conta anche LIBN_G_APP).
    private int OnlineAt(SectorRow ap)
    {
        var head = ap.AirportIcao ?? ap.Callsign.Split('_', 2)[0];
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
        {
            var t = cs.Split('_');
            if (t.Length < 2) return false;
            var last = t[^1].ToUpperInvariant();
            return (last == "APP" || last == "DEP") && t[0].Equals(head, StringComparison.OrdinalIgnoreCase);
        });
    }
}
