@page "/vsop/admin/sectorstructure"
@layout SopLayout
@rendermode InteractiveServer
@inject IStructureEditingService Struct
@inject IHierarchyEditingService Hierarchy
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Struct_PageTitle"] · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <b>@L["Struct_Title"]</b></div>
    @* ---- Testata in UNA riga: titolo · «?» · i sei tasti · stato del lock ----
       Come nei Trasferimenti (.xt-head). Il sottotitolo non c'è più: diceva in prosa sempre a schermo ciò che
       il «?» dice al clic, e qui l'altezza è albero — ogni fascia tolta in testa diventa nodi visibili, perché
       l'altezza del riquadro la MISURA vipiFitViewport a ogni render. La barra del lock sale sulla stessa
       riga per la stessa ragione: è uno stato, non una sezione. *@
    <div class="doc-head st-head">
        <h2 class="st-h2">@L["Struct_Title"]</h2>
        <HelpHint Href="/vsop/guida#struttura" AriaLabel="@L["Struct_HelpAria"]" ExtraClass="wide">
            @((MarkupString)L["Struct_HelpBody"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            @* ⚠️ La testata di questa pagina non ha più comandi: c'erano ACC, Aeroporti, Confinanti,
               Trasferimenti e Sorgenti (cinque doppioni della barra admin qui sotto, e sotto ~1280px
               mandavano la testata a capo) e «Nuovo documento», che era l'unico ingresso a newdoc rimasto
               qui pur non appartenendo a questa pagina: si crea da Documenti, che è la pagina dei documenti,
               e quel tasto lì c'è già. Qui restano solo lo stato e il lock — che stati sono, non comandi. *@
            @* L'esito sta prima del lock, come nella pagina ACC: da fascia sotto la testata spingeva
               in giù l'albero mentre ci si lavorava — e qui l'altezza del riquadro è misurata, quindi una
               fascia in più sono nodi in meno. *@
            @if (_msg is not null)
            {
                <span class="st-msg warn" role="status">
                    <Icon Name="warning" Size="14" />
                    <span class="st-msg-t">@_msg</span>
                    <button class="tclose" title="@L["Common_Close"]" @onclick="() => _msg = null">✕</button>
                </span>
            }
            @* ⚠️ La EditLockBar sta QUI, in testata, e non come fascia a sé: i suoi margini di fascia si
               azzerano nel CSS di .st-head, non nel componente — newdoc la usa ancora come fascia. *@
            <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" />
        }
    </div>

    @* Le altre pagine admin, in una riga sola e uguale ovunque. Va nuda, senza `@if` intorno: il filtro per
       autorizzazione lo fa il componente (una regola per voce). L'altezza che si prende non va scontata a
       mano: `vipiFitViewport` misura il `top` del riquadro, quindi l'albero si riadatta da solo. *@
    <AdminNav />

    @* Il testo dell'albero di fallback è lo stesso di prima, parola per parola: cambia solo dove si legge —
       dal clic sul «?» invece che da tre righe di prosa sempre a schermo. *@
    <div class="section-title">
        <h3>@L["Struct_CoverageHierarchy"] <span class="pill blue">@L["Struct_Division"]</span></h3>
        <HelpHint Href="/vsop/guida#struttura" AriaLabel="@L["Struct_HierarchyHelpAria"]" ExtraClass="wide">
            @((MarkupString)L["Struct_HierarchyHelp"].Value)
        </HelpHint>
        <span class="ln"></span>
    </div>

    <div class="gerarchia-2col">
        @* --- Settori per ACC (card con alberi) --- *@
        <div class="panel st-pane">
            <div class="sub-h">@L["Struct_TreesByAcc"]<span class="ln" style="flex:1"></span></div>
            @{ var aptOrphans = OrphanAirports().Count; var appOrphans = OrphanApps().Count; var accRoots = AccRoots().Count; var orphans = aptOrphans + appOrphans; }
            @* ---- UNA barra sola: cosa cerco → come guardo → come sto ----
               Erano due fasce (chip di salute sopra, ricerca sotto) per tre gruppi di comandi che si usano
               nello stesso gesto. Qui l'altezza è albero: una fascia in meno sono nodi visibili.
               ⚠️ I chip ci sono SEMPRE, anche a zero (spenti): quello degli orfani compariva col contatore e
               all'ultimo nodo agganciato la riga si accorciava sotto il puntatore. Per la stessa ragione
               sparisce «mostra tutti»: il chip È già l'interruttore del filtro, e due comandi per lo stesso
               stato sono uno di troppo. *@
            <div class="struct-bar">
                <input class="htree-search" placeholder="@L["Struct_SearchPlaceholder"]" value="@_treeFilter" @oninput="OnSearchInput" />
                <select class="htree-select" @bind="_countryFilter" title="@L["Struct_FilterCountry"]">
                    <option value="">@L["Struct_AllCountries"]</option>
                    @foreach (var c in CountryOptions())
                    {
                        <option value="@c.Prefix">@c.Name</option>
                    }
                </select>
                @if (_searching) { <span class="sb-count">@L["Struct_ResultsN", _tree.Count(Matches)]</span> }
                <span class="sb-sep"></span>
                <button class="lnk-mini" disabled="@_searching" @onclick="ExpandAll" title="@L["Struct_ExpandAllTitle"]">@L["Struct_Expand"]</button>
                <button class="lnk-mini" disabled="@_searching" @onclick="CollapseAll" title="@L["Struct_CollapseAllTitle"]">@L["Struct_Collapse"]</button>
                @* I tre chip sono UN gruppo: quando la barra va a capo scendono insieme, e la riga di sotto è
                   sempre la stessa. Sciolti, andava a capo l'ultimo da solo e il taglio cambiava con la
                   larghezza del pannello — la barra sembrava rotta, non stretta. *@
                <span class="sb-chips">
                @* Il chip dice QUANTI e basta: la ripartizione aeroporti/APP è la cosa più larga della barra e
                   non cambia il gesto (si clicca comunque per vederli). Sta nel title, insieme a cosa fa il clic. *@
                <button class="sh-chip @(orphans > 0 ? "warn" : "") @(_orphansOnly ? "on" : "")" disabled="@(orphans == 0)"
                        @onclick="ToggleOrphans"
                        title="@(orphans > 0 ? $"{OrphansLabel(aptOrphans, appOrphans)} — {L["Struct_ShowUnassignedTitle"].Value}" : L["Struct_CompleteTitle"].Value)">
                    @(orphans > 0 ? $"⚠ {string.Format(L["Struct_ToAttachN"].Value, orphans)}" : L["Struct_Complete"].Value)
                </button>
                <span class="sh-chip" title="@L["Struct_AccRootsTitle"]">@L["Struct_AccRootsN", accRoots]</span>
                <button class="sh-chip @(_showAirportPositions ? "on" : "")" title="@L["Struct_ShowPositionsTitle"]"
                        @onclick="() => _showAirportPositions = !_showAirportPositions">@L["Struct_ShowPositions"]</button>
                </span>
            </div>
            @* Scorre SOLO il corpo: barra dei filtri e intestazione restano ferme mentre si cerca un nodo
               fra i ~250 dell'albero. L'altezza del riquadro la scrive vipiFitViewport. *@
            <div class="st-scroll">
            @{ var groups = RootGroups(); }
            @if (groups.Count == 0)
            {
                @if (_searching)
                {
                    <p class="help">@string.Format(L["Struct_NoSectorMatch"], _treeFilter)</p>
                }
                else
                {
                    <p class="help">@((MarkupString)L["Struct_NoSectorCatalog"].Value)</p>
                }
            }
            else
            {
                @foreach (var g in groups)
                {
                    var rows = FlattenForest(g.Roots);
                    if (_filtering && rows.Count == 0) { continue; }
                    var cardOpen = _filtering || !_collapsedCards.Contains(g.Code);
                    <div class="acc-grp">
                        <div class="acc-grp-h" role="button" tabindex="0"
                             aria-expanded="@cardOpen.ToString().ToLowerInvariant()"
                             aria-label="@L["Struct_ToggleCard", g.Code]"
                             @onclick="() => ToggleCard(g.Code)"
                             @onkeydown="e => ToggleCardOnKey(e, g.Code)">
                            <span class="grp-chev">@(cardOpen ? "▾" : "▸")</span>
                            <span class="acc-grp-code">@g.Code</span> @g.Name
                            <span class="muted" style="font-weight:500">· @L["Struct_SectorsN", ForestCount(g.Roots)]</span>
                        </div>
                        @if (cardOpen)
                        {
                            @foreach (var node in rows)
                            {
                                var n = node;
                                var isTarget = n.Callsign is not null;   // solo i nodi interni (ACC/APP) sono drop-target
                                <div id="@RowId(n.Kind, n.Id)"
                                     class="acc-row @(IsSelected(n.Kind, n.Id) ? "sel" : "") @(IsHit(n) ? "match" : "") @DropClass(n)"
                                     style="padding-left:@(12 + n.Depth * 20)px"
                                     draggable="@(Authz.IsAdmin && _canEdit ? "true" : "false")"
                                     @ondragstart="() => OnDragStart(n)"
                                     @ondragend="OnDragEnd"
                                     ondragover="event.preventDefault()"
                                     @ondragenter="() => OnDragEnter(n)"
                                     @ondrop="() => OnDrop(n)"
                                     @onclick="() => Select(n.Kind, n.Id)">
                                    @if (n.HasChildren && !_filtering)
                                    {
                                        <button type="button" class="htree-toggle" aria-expanded="@((!_collapsed.Contains(n.Callsign!)).ToString().ToLowerInvariant())"
                                                aria-label="@L["Struct_ToggleNode", n.Callsign!]"
                                                @onclick="() => Toggle(n.Callsign!)" @onclick:stopPropagation="true">@(_collapsed.Contains(n.Callsign!) ? "▸" : "▾")</button>
                                    }
                                    else
                                    {
                                        <span class="htree-toggle empty"></span>
                                    }
                                    @if (n.Callsign is not null && _online.Contains(n.Callsign)) { <span class="onl-dot" title="@L["Struct_OnlineNow"]"></span> }
                                    <span class="node-badge @FacilityClass(n.Kind, n.Callsign)">@FacilityBadge(n.Kind, n.Callsign)</span>
                                    <span class="acc-row-label">@n.Label</span>
                                    @if (n.AccCode != g.Code) { <span class="acc-tag" title="cross-ACC">@n.AccCode</span> }
                                    @if (n.IsHidden) { <span class="muted" style="font-size:11px">@L["Struct_Hidden"]</span> }
                                    @if (n.HasChildren && _collapsed.Contains(n.Callsign!) && !_filtering)
                                    {
                                        <span class="acc-row-parent">@(ChildrenOf(n.Callsign!).Count()) ⋯</span>
                                    }
                                    else if (n.IsInherited)
                                    {
                                        <span class="acc-row-parent inherited" title="@L["Struct_InheritedTitle"]">@L["Struct_Inherited"]</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(n.ParentCallsign))
                                    {
                                        <span class="acc-row-parent">@(n.Kind == HierarchyNodeKind.Airport ? L["Struct_ToAssign"].Value : L["Struct_Root"].Value)</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            }
            </div>
        </div>

        @* --- Dettaglio nodo ---
           Era `.detail-sticky`: agganciato mentre la pagina scorreva. Ora la pagina non scorre più — il
           riquadro è alto quanto lo schermo meno ciò che gli sta sopra — e il pannello è un `.st-pane` come
           l'altro, con il solo corpo che scorre. La classe vecchia è sparita col meccanismo che descriveva. *@
        <div class="panel st-pane">
            <div class="sub-h">@L["Struct_Detail"]</div>
            <div class="st-scroll">
            @if (Selected() is not HierarchyNode sel)
            {
                <p class="help">@L["Struct_SelectHint"]</p>
            }
            else
            {
                <p style="margin:0 0 4px">
                    @if (sel.Callsign is not null && _online.Contains(sel.Callsign)) { <span class="onl-dot" title="online adesso"></span> }
                    <b>@sel.Label</b> <span class="node-badge @FacilityClass(sel.Kind, sel.Callsign)">@FacilityBadge(sel.Kind, sel.Callsign)</span> <span class="acc-tag">@sel.AccCode</span>
                </p>
                @if (sel.Kind == HierarchyNodeKind.Airport)
                {
                    <p class="muted" style="font-size:12px;margin:0 0 10px">@L["Struct_LeafHint"]</p>
                }
                <StructureFallbackChain Rows="ChainRows(sel)" />
                <StructureCoverage IsLeaf="sel.Callsign is null" Rows="CoverageRows(sel)" AirportsCovered="AirportsCovered(sel)" />
                <div class="field" style="margin-top:10px">
                    <label>@L["Struct_ParentLabel"]</label>
                    <input placeholder="@L["Struct_FilterCallsign"]" @bind="_parentFilter" @bind:event="oninput" disabled="@(!Authz.IsAdmin || !_canEdit || _busy)" style="margin-bottom:6px" />
                    <select value="@_pendingParent" disabled="@(!Authz.IsAdmin || !_canEdit || _busy)" @onchange="e => _pendingParent = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                        <option value="">@InheritOptionLabel(sel)</option>
                        @foreach (var p in EligibleParents(sel))
                        {
                            <option value="@p.Callsign">@p.Callsign (@FacilityBadge(p.Kind, p.Callsign)) · @p.AccCode</option>
                        }
                    </select>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:10px">
                        <button class="btn primary" disabled="@(!Authz.IsAdmin || !_canEdit || _busy || !IsDirty(sel))" @onclick="() => Apply(sel)">@L["Common_Apply"]</button>
                        @if (IsDirty(sel))
                        {
                            <button class="btn ghost" disabled="@_busy" @onclick="() => _pendingParent = sel.ParentCallsign">@L["Common_Cancel"]</button>
                            <span class="muted" style="font-size:12px">@L["Common_Unsaved"]</span>
                        }
                        else
                        {
                            <span class="muted" style="font-size:12px">@L["Common_NoChange"]</span>
                        }
                    </div>
                </div>
            }
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<AccRow> _accs = Array.Empty<AccRow>();   // solo per i nomi ACC delle card (RootGroups)
    private bool _busy;
    private string? _msg;

    // Albero di copertura globale (cross-ACC) dai cataloghi.
    private IReadOnlyList<HierarchyNode> _tree = Array.Empty<HierarchyNode>();
    private HierarchyNodeKind? _selKind;
    private int _selId;
    private string _parentFilter = "";     // filtro del picker padre (dettaglio)
    private string _treeFilter = "";       // ricerca nell'albero
    private string _countryFilter = "";    // filtro per nazione (prefisso ICAO, "" = tutte)
    private string? _pendingParent;        // padre selezionato ma non ancora applicato (Applica)

    // Settori esteri che confinano davvero con l'IT: solo questi si mostrano/usano per gli ACC esteri.
    private IReadOnlySet<string> _confining = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    private HashSet<string> _online = new(StringComparer.OrdinalIgnoreCase);   // callsign ATC online adesso
    private bool _orphansOnly;                                                  // filtro "solo nodi da agganciare"
    // Torri, ground e delivery sono ~110 nodi su ~250: spenti di default, così chi lavora sulla struttura d'area
    // non se li trova fra i piedi. Chi deve sistemare uno scalo sdoppiato li accende.
    private bool _showAirportPositions;

    // Drag&drop re-parent: nodo trascinato + target correntemente sotto il cursore.
    private HierarchyNodeKind? _dragKind;
    private int _dragId;
    private string? _dropTargetCs;

    private bool _scrollPending;   // dopo una ricerca: porta in vista il primo match
    private bool _canEdit;         // true = questa sessione tiene il lock di struttura (EditLockBar)

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // Etichetta orfani con pluralizzazione IT/EN gestita via chiavi singolare/plurale.
    private string OrphansLabel(int apt, int app)
    {
        var aptPart = string.Format(apt == 1 ? L["Struct_AptToAssign1"] : L["Struct_AptToAssignN"], apt);
        if (app <= 0) return aptPart;
        var appPart = string.Format(app == 1 ? L["Struct_AppOrphan1"] : L["Struct_AppOrphanN"], app);
        return $"{aptPart} · {appPart}";
    }

    protected override async Task OnInitializedAsync()
    {
        _accs = await Struct.ListAccsAsync();
        _confining = await Hierarchy.ListConfiningForeignCallsignsAsync();
        _online = new HashSet<string>(Online.GetCurrent().Callsigns, StringComparer.OrdinalIgnoreCase);
        await ReloadTreeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending)
        {
            _scrollPending = false;
            var first = _tree.Where(Matches).OrderBy(n => n.AccCode).ThenBy(n => n.Label).FirstOrDefault();
            if (first is not null)
                await JS.InvokeVoidAsync("vipiScrollToId", RowId(first.Kind, first.Id));
        }

        // ⚠️ L'altezza «schermo meno ciò che sta sopra» non è esprimibile in CSS: N è proprio ciò che non si
        // sa. Si misura, e si rimisura a OGNI render perché sopra ci sono cose che compaiono e spariscono da
        // sole (avviso del lock, callout d'errore). Sotto i 900px la griglia è a una colonna e l'altezza fissa
        // va TOLTA: un riquadro alto quanto lo schermo dentro una pagina che scorre sono due barre annidate.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".gerarchia-2col", 900); } catch (Exception) { }
    }

    private async Task ReloadTreeAsync()
    {
        var full = await Hierarchy.LoadTreeAsync();
        // ACC esteri: tieni solo i settori che confinano con l'Italia (non tutti quelli dell'ACC).
        _tree = full.Where(n => !n.IsForeign || (n.Callsign != null && _confining.Contains(n.Callsign))).ToList();
    }

    private async Task Guarded(Func<Task> action)
    {
        _busy = true; _msg = null;
        try { await action(); await ReloadTreeAsync(); }
        catch (ValidationException ex) { _msg = ex.Message; }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Vero se il padre selezionato (pending) differisce da quello salvato sul nodo.</summary>
    private bool IsDirty(HierarchyNode sel) =>
        !string.Equals(_pendingParent ?? "", sel.ParentCallsign ?? "", StringComparison.OrdinalIgnoreCase);

    /// <summary>Applica il padre pending al nodo (lo aggancia all'albero) e riproietta.</summary>
    private Task Apply(HierarchyNode sel) =>
        Guarded(() => Hierarchy.SetParentAsync(sel.Kind, sel.Id,
            string.IsNullOrWhiteSpace(_pendingParent) ? null : _pendingParent));

    /// <summary>Vero se il nodo soddisfa il filtro di ricerca (callsign/label/ACC).</summary>
    private bool Matches(HierarchyNode n)
    {
        var q = _treeFilter.Trim();
        return (n.Callsign?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
               || n.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
               || n.AccCode.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Vero se la riga è un risultato diretto della ricerca (da evidenziare).</summary>
    private bool IsHit(FlatNode n)
    {
        if (string.IsNullOrWhiteSpace(_treeFilter)) return false;
        var q = _treeFilter.Trim();
        return n.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
               || n.AccCode.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private static string NodeKey(HierarchyNodeKind kind, int id) => $"{kind}:{id}";

    private bool _searching => !string.IsNullOrWhiteSpace(_treeFilter);
    private bool _filtering => _searching || _orphansOnly;   // albero appiattito/filtrato (ricerca o solo-orfani)

    // --- Compressione card (per ACC) e rami (per callsign) ---
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);       // rami compressi (callsign)
    private readonly HashSet<string> _collapsedCards = new(StringComparer.OrdinalIgnoreCase);   // card compresse (codice ACC)
    private void Toggle(string callsign) { if (!_collapsed.Add(callsign)) _collapsed.Remove(callsign); }
    private void ToggleCard(string code) { if (!_collapsedCards.Add(code)) _collapsedCards.Remove(code); }

    /// <summary>
    /// L'intestazione della scheda ACC apre e chiude il gruppo: è un comando, non un titolo. Era un
    /// <c>&lt;div&gt;</c> col solo <c>@onclick</c>, cioè raggiungibile solo col mouse. Ora ha
    /// <c>role="button"</c>, <c>tabindex</c> e questi due tasti.
    /// <para>Non è diventata un <c>&lt;button&gt;</c> come il toggle del nodo perché contiene già altro
    /// (codice, nome, conteggio settori): un pulsante che avvolge tre elementi si annuncia leggendoli tutti
    /// di fila.</para>
    /// </summary>
    private void ToggleCardOnKey(KeyboardEventArgs e, string code)
    {
        if (e.Key is "Enter" or " ") ToggleCard(code);
    }
    private void ExpandAll() { _collapsed.Clear(); _collapsedCards.Clear(); }
    private void CollapseAll()
    {
        _collapsedCards.Clear();
        foreach (var g in RootGroups()) _collapsedCards.Add(g.Code);
    }

    // --- Alberi raggruppati per ACC della radice ---
    private sealed record RootGroup(string Code, string Name, List<HierarchyNode> Roots);
    private sealed record FlatNode(HierarchyNodeKind Kind, int Id, string Label, string AccCode, bool IsHidden, string? ParentCallsign, int Depth, string? Callsign, bool HasChildren, bool IsInherited);

    /// <summary>Radici (nodi senza padre risolvibile), raggruppate per ACC della radice. Con la ricerca attiva tiene solo le radici che hanno almeno un nodo visibile nel proprio albero.</summary>
    private List<RootGroup> RootGroups()
    {
        var byCs = NodesByCallsign();
        var vis = VisibleKeys();
        var nameByCode = _accs.GroupBy(a => a.Code, StringComparer.OrdinalIgnoreCase)
                              .ToDictionary(g => g.Key, g => g.First().Name, StringComparer.OrdinalIgnoreCase);

        bool RootVisible(HierarchyNode r)
        {
            if (vis is null) return true;
            if (vis.Contains(NodeKey(r.Kind, r.Id))) return true;
            return r.Callsign is not null && DescendantNodes(r.Callsign).Any(d => vis.Contains(NodeKey(d.Kind, d.Id)));
        }

        return _tree
            .Where(n => n.ParentCallsign is null || !byCs.ContainsKey(n.ParentCallsign))   // radici
            .Where(n => string.IsNullOrEmpty(_countryFilter) || string.Equals(n.CountryPrefix, _countryFilter, StringComparison.OrdinalIgnoreCase))
            .Where(RootVisible)
            .GroupBy(r => r.AccCode, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key)
            .Select(g => new RootGroup(g.Key,
                nameByCode.TryGetValue(g.Key, out var nm) ? nm : "",
                g.OrderBy(r => r.Kind).ThenBy(r => r.Label).ToList()))
            .ToList();
    }

    /// <summary>Numero totale di nodi negli alberi di una card (radici + discendenti).</summary>
    private int ForestCount(IEnumerable<HierarchyNode> roots) =>
        roots.Sum(r => 1 + (r.Callsign is null ? 0 : DescendantNodes(r.Callsign).Count));

    /// <summary>Appiattisce gli alberi delle radici date in pre-ordine con profondità, rispettando compressione rami e ricerca.</summary>
    private List<FlatNode> FlattenForest(IEnumerable<HierarchyNode> roots)
    {
        var list = new List<FlatNode>();
        var vis = VisibleKeys();
        var guard = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        void Walk(HierarchyNode n, int depth)
        {
            if (IsCollapsedPosition(n)) return;
            var hasChildren = n.Callsign is not null && ChildrenOf(n.Callsign).Any(c => !IsCollapsedPosition(c));
            if (vis is null || vis.Contains(NodeKey(n.Kind, n.Id)))
                list.Add(new FlatNode(n.Kind, n.Id, n.Label, n.AccCode, n.IsHidden, n.ParentCallsign, depth, n.Callsign, hasChildren, n.IsInherited));
            if (n.Callsign is null || !guard.Add(n.Callsign)) return;
            if (vis is null && _collapsed.Contains(n.Callsign)) return;   // ramo compresso (ignorato in ricerca)
            foreach (var c in ChildrenOf(n.Callsign)) Walk(c, depth + 1);
        }

        foreach (var r in roots.OrderBy(r => r.Kind).ThenBy(r => r.Label)) Walk(r, 0);
        return list;
    }

    /// <summary>Quando il filtro è attivo: chiavi dei nodi da mostrare = ogni match + tutti i suoi ANTENATI + tutti i suoi DISCENDENTI (gerarchia completa del CS cercato).</summary>
    private HashSet<string>? VisibleKeys()
    {
        if (_orphansOnly) return OrphanVisibleKeys();
        if (string.IsNullOrWhiteSpace(_treeFilter)) return null;   // null = nessun filtro
        var byCs = NodesByCallsign();
        var vis = new HashSet<string>();
        foreach (var m in _tree.Where(Matches))
        {
            vis.Add(NodeKey(m.Kind, m.Id));
            // antenati (catena ParentCallsign fino alla radice)
            var pcs = m.EffectiveParentCallsign;
            var guard = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            while (pcs is not null && guard.Add(pcs) && byCs.TryGetValue(pcs, out var p))
            {
                vis.Add(NodeKey(p.Kind, p.Id));
                pcs = p.ParentCallsign;
            }
            // discendenti (sottoalbero)
            if (m.Callsign is not null)
                foreach (var d in DescendantNodes(m.Callsign)) vis.Add(NodeKey(d.Kind, d.Id));
        }
        return vis;
    }

    private List<HierarchyNode> DescendantNodes(string callsign)
    {
        var res = new List<HierarchyNode>();
        var guard = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Walk(string cs)
        {
            if (!guard.Add(cs)) return;
            foreach (var c in ChildrenOf(cs)) { res.Add(c); if (c.Callsign is not null) Walk(c.Callsign); }
        }
        Walk(callsign);
        return res;
    }

    // --- Helpers albero ---

    // --- Nazioni presenti nell'albero (prefisso ICAO → nome), per il filtro ---
    private sealed record CountryOption(string Prefix, string Name);
    private List<CountryOption> CountryOptions() =>
        _tree.Select(n => n.CountryPrefix)
             .Where(p => !string.IsNullOrWhiteSpace(p))
             .Distinct(StringComparer.OrdinalIgnoreCase)
             .Select(p => new CountryOption(p, CountryName(p)))
             .OrderBy(c => c.Prefix.Equals("LI", StringComparison.OrdinalIgnoreCase) ? "" : c.Name)   // Italia prima
             .ToList();

    private static string CountryName(string prefix) => prefix.ToUpperInvariant() switch
    {
        "LI" => "🇮🇹 Italia",
        "LF" => "🇫🇷 Francia",
        "LS" => "🇨🇭 Svizzera",
        "LO" => "🇦🇹 Austria",
        "LD" => "🇭🇷 Croazia",
        "LJ" => "🇸🇮 Slovenia",
        "LG" => "🇬🇷 Grecia",
        "LM" => "🇲🇹 Malta",
        "LA" => "🇦🇱 Albania",
        "LQ" => "🇧🇦 Bosnia",
        "LY" => "🇷🇸 Serbia/Montenegro",
        "LW" => "🇲🇰 Macedonia del Nord",
        "DT" => "🇹🇳 Tunisia",
        "DA" => "🇩🇿 Algeria",
        _ => prefix.ToUpperInvariant(),
    };

    // --- Ricerca: aggiorna filtro e programma lo scroll al primo match ---
    private void OnSearchInput(ChangeEventArgs e)
    {
        _treeFilter = e.Value?.ToString() ?? "";
        if (_searching) { _orphansOnly = false; _scrollPending = true; }
    }

    // --- Completezza / orfani ---
    // Padre EFFETTIVO ovunque nell'albero: quello scritto, altrimenti quello ereditato dalla scaletta
    // d'aeroporto. Usare solo ParentCallsign mostrerebbe come «da assegnare» posizioni che il sistema aggancia
    // davvero — due schermate che dicono cose diverse sullo stesso nodo.
    private bool IsRooted(HierarchyNode n)   // ha un padre effettivamente risolvibile nell'albero
    {
        if (string.IsNullOrWhiteSpace(n.EffectiveParentCallsign)) return false;
        return NodesByCallsign().ContainsKey(n.EffectiveParentCallsign);
    }
    private List<HierarchyNode> OrphanAirports() =>
        _tree.Where(n => n.Kind == HierarchyNodeKind.Airport && !IsRooted(n)).ToList();
    private List<HierarchyNode> OrphanApps() =>
        _tree.Where(n => n.Kind == HierarchyNodeKind.AirportPosition && !IsRooted(n)).ToList();
    private List<HierarchyNode> AccRoots() =>
        _tree.Where(n => n.Kind == HierarchyNodeKind.Acc && !IsRooted(n)).ToList();

    private void ToggleOrphans()
    {
        _orphansOnly = !_orphansOnly;
        if (_orphansOnly) _treeFilter = "";
    }

    // Filtro "solo orfani": mostra i nodi Airport/APP senza padre + i loro antenati (di norma nessuno).
    private HashSet<string> OrphanVisibleKeys()
    {
        var byCs = NodesByCallsign();
        var vis = new HashSet<string>();
        foreach (var m in OrphanAirports().Concat(OrphanApps()))
        {
            vis.Add(NodeKey(m.Kind, m.Id));
            var pcs = m.EffectiveParentCallsign;
            var guard = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            while (pcs is not null && guard.Add(pcs) && byCs.TryGetValue(pcs, out var p))
            {
                vis.Add(NodeKey(p.Kind, p.Id));
                pcs = p.ParentCallsign;
            }
        }
        return vis;
    }

    // --- Badge facility (CTR/FSS/APP/TWR/GND/DEL/APT) dal suffisso callsign ---
    private static string FacilityBadge(HierarchyNodeKind kind, string? callsign)
    {
        if (kind == HierarchyNodeKind.Airport) return "APT";
        var last = callsign?.Split('_').LastOrDefault()?.ToUpperInvariant();
        if (kind == HierarchyNodeKind.AirportPosition)
            return last switch { "TWR" => "TWR", "GND" => "GND", "DEL" => "DEL", _ => "APP" };
        return last switch { "CTR" => "CTR", "FSS" => "FSS", _ => "ACC" };
    }
    private static string FacilityClass(HierarchyNodeKind kind, string? callsign) => FacilityBadge(kind, callsign).ToLowerInvariant();

    private static string RowId(HierarchyNodeKind kind, int id) => $"hn-{kind}-{id}";

    // --- Drag & drop re-parent (le righe albero sono FlatNode: risolvo l'HierarchyNode dai campi) ---
    private void OnDragStart(FlatNode n) { if (!_canEdit) return; _dragKind = n.Kind; _dragId = n.Id; }
    private void OnDragEnd() { _dragKind = null; _dropTargetCs = null; }
    private void OnDragEnter(FlatNode target) { _dropTargetCs = target.Callsign; }

    private HierarchyNode? Dragged() => _dragKind is HierarchyNodeKind k
        ? _tree.FirstOrDefault(n => n.Kind == k && n.Id == _dragId) : null;
    private HierarchyNode? NodeOf(FlatNode f) => _tree.FirstOrDefault(n => n.Kind == f.Kind && n.Id == f.Id);

    // Padre ammesso per il nodo trascinato: non sé stesso/discendente + stessa nazione (come EligibleParents).
    private bool IsEligibleParent(HierarchyNode child, HierarchyNode parent)
    {
        if (parent.Callsign is null) return false;
        if (string.Equals(parent.Callsign, child.Callsign, StringComparison.OrdinalIgnoreCase)) return false;
        if (child.Callsign is not null && Descendants(child.Callsign).Contains(parent.Callsign)) return false;
        return child.IsForeign
            ? parent.IsForeign && string.Equals(parent.CountryPrefix, child.CountryPrefix, StringComparison.OrdinalIgnoreCase)
            : !parent.IsForeign;
    }

    private string DropClass(FlatNode targetRow)
    {
        if (_dragKind is null || targetRow.Callsign is null || !string.Equals(_dropTargetCs, targetRow.Callsign, StringComparison.OrdinalIgnoreCase))
            return "";
        var child = Dragged();
        var target = NodeOf(targetRow);
        if (child is null || target is null) return "";
        return IsEligibleParent(child, target) ? "drop-ok" : "drop-no";
    }

    private async Task OnDrop(FlatNode targetRow)
    {
        var child = Dragged();
        var target = NodeOf(targetRow);
        _dropTargetCs = null;
        if (child is null || target?.Callsign is null) { _dragKind = null; return; }
        if (!Authz.IsAdmin || !_canEdit) { _dragKind = null; return; }
        if (!IsEligibleParent(child, target))
        {
            _msg = string.Format(L["Struct_DropInvalid"], child.Callsign ?? child.Label, target.Callsign);
            _dragKind = null;
            return;
        }
        var kind = child.Kind; var id = child.Id; var parentCs = target.Callsign;
        _dragKind = null;
        await Guarded(() => Hierarchy.SetParentAsync(kind, id, parentCs));
    }

    // --- Anteprima copertura (dominio GIÙ) del nodo selezionato: dati per <StructureCoverage>. ---
    private IReadOnlyList<CoverageChildRow> CoverageRows(HierarchyNode sel)
    {
        if (sel.Callsign is null) return Array.Empty<CoverageChildRow>();
        return ChildrenOf(sel.Callsign)
            .Select(c => new CoverageChildRow(
                c.Callsign ?? c.Label,
                FacilityBadge(c.Kind, c.Callsign),
                FacilityClass(c.Kind, c.Callsign),
                c.Callsign is null ? 0 : DescendantNodes(c.Callsign).Count))
            .ToList();
    }

    private int AirportsCovered(HierarchyNode sel) =>
        sel.Callsign is null ? 0 : DescendantNodes(sel.Callsign).Count(d => d.Kind == HierarchyNodeKind.Airport);

    private Dictionary<string, HierarchyNode> NodesByCallsign() =>
        _tree.Where(n => n.Callsign is not null)
             .GroupBy(n => n.Callsign!, StringComparer.OrdinalIgnoreCase)
             .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Torre/ground/delivery nascoste dall'interruttore. Restano visibili quando si sta cercando (una ricerca per
    /// callsign deve trovarle), quando sono selezionate, e quando sono orfane in modalità «solo da agganciare» —
    /// altrimenti il filtro nasconderebbe proprio i nodi che chiedono un intervento.
    /// </summary>
    private bool IsCollapsedPosition(HierarchyNode n)
    {
        if (_showAirportPositions || _filtering) return false;
        if (n.Kind != HierarchyNodeKind.AirportPosition) return false;
        if (IsSelected(n.Kind, n.Id)) return false;
        return !string.Equals(BadgeOfCallsign(n.Callsign), "APP", StringComparison.OrdinalIgnoreCase);
    }

    private static string BadgeOfCallsign(string? callsign) =>
        callsign?.Split('_').LastOrDefault()?.ToUpperInvariant() ?? "";

    private IEnumerable<HierarchyNode> ChildrenOf(string callsign) =>
        _tree.Where(n => string.Equals(n.EffectiveParentCallsign, callsign, StringComparison.OrdinalIgnoreCase))
             .OrderBy(n => n.Kind).ThenBy(n => n.Label);

    /// <summary>Etichetta dell'opzione «nessun padre scritto»: se la scaletta ne deriva uno, va detto quale —
    /// altrimenti l'admin crede di staccare il nodo mentre resta agganciato.</summary>
    private string InheritOptionLabel(HierarchyNode sel)
    {
        if (sel.DerivedParentCallsign is { Length: > 0 } d) return L["Struct_OptInherit", d];
        return sel.Kind == HierarchyNodeKind.Acc ? L["Struct_OptRoot"].Value : L["Struct_OptToAssign"].Value;
    }

    private void Select(HierarchyNodeKind kind, int id)
    {
        _selKind = kind; _selId = id; _parentFilter = "";
        _pendingParent = _tree.FirstOrDefault(n => n.Kind == kind && n.Id == id)?.ParentCallsign;
    }
    private bool IsSelected(HierarchyNodeKind kind, int id) => _selKind == kind && _selId == id;
    private HierarchyNode? Selected() => _selKind is HierarchyNodeKind k
        ? _tree.FirstOrDefault(n => n.Kind == k && n.Id == _selId) : null;

    /// <summary>Padri ammessi: nodi interni (ACC/APP) esclusi sé stesso e i propri discendenti (anti-ciclo). Filtrabili per testo.</summary>
    private IEnumerable<HierarchyNode> EligibleParents(HierarchyNode sel)
    {
        var blocked = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (sel.Callsign is not null)
        {
            blocked.Add(sel.Callsign);
            foreach (var d in Descendants(sel.Callsign)) blocked.Add(d);
        }
        return _tree
            .Where(n => n.Callsign is not null && !blocked.Contains(n.Callsign))
            // Nodo estero: padri solo della STESSA nazione (stesso prefisso ICAO). Nodo domestico: solo padri domestici.
            .Where(n => sel.IsForeign
                        ? n.IsForeign && string.Equals(n.CountryPrefix, sel.CountryPrefix, StringComparison.OrdinalIgnoreCase)
                        : !n.IsForeign)
            .Where(n => string.IsNullOrWhiteSpace(_parentFilter)
                        || n.Callsign!.Contains(_parentFilter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.AccCode).ThenBy(n => n.Callsign);
    }

    private HashSet<string> Descendants(string callsign)
    {
        var result = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        void Walk(string cs) { foreach (var c in ChildrenOf(cs)) if (c.Callsign is not null && result.Add(c.Callsign)) Walk(c.Callsign); }
        Walk(callsign);
        return result;
    }

    /// <summary>Catena di fallback del nodo selezionato (antenati per callsign fino alla radice): dati per &lt;StructureFallbackChain&gt;.</summary>
    private IReadOnlyList<FallbackChainRow> ChainRows(HierarchyNode sel)
    {
        var byCs = NodesByCallsign();
        var rows = new List<FallbackChainRow>();
        var guard = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        // Padre EFFETTIVO, come l'albero: con quello scritto la catena direbbe «radice» su una posizione che il
        // sistema aggancia davvero — e il pannello contraddirebbe la riga che l'ha appena selezionata.
        var pcs = sel.EffectiveParentCallsign;
        while (pcs is not null && guard.Add(pcs) && byCs.TryGetValue(pcs, out var p))
        {
            rows.Add(new FallbackChainRow(p.Callsign ?? "", FacilityBadge(p.Kind, p.Callsign),
                FacilityClass(p.Kind, p.Callsign), p.AccCode));
            pcs = p.EffectiveParentCallsign;
        }
        return rows;
    }
}
