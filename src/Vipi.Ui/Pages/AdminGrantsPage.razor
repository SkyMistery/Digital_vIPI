@page "/vsop/admin/permessi"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IStationResolver Stations
@inject IStaffRosterService Roster

<PageTitle>Area Staff · IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1000px">
    <div class="breadcrumb"><a href="/vsop">Admin</a> › <b>Area Staff</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">Area Staff</h2><span class="muted">Tutte le funzioni riservate allo staff</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic">⛔</span><div><p class="ct">Accesso riservato</p>Solo lo staff può accedere a quest'area.</div></div>
    }
    else
    {
        <div class="section-title"><h3>Dashboard</h3><span class="ln"></span></div>
        <div class="choice-grid">
            <a class="choice" href="/vsop/admin/sectorstructure" style="text-decoration:none;color:inherit"><h4><span class="ic">🏗️</span> Struttura</h4><p class="muted">ACC, posizioni, settori, ownership, frequenze e topologia.</p></a>
            <a class="choice" href="/vsop/admin/trasferimenti" style="text-decoration:none;color:inherit"><h4><span class="ic">🔄</span> Trasferimenti</h4><p class="muted">Flussi e punti di coordinamento tra settori, per ACC.</p></a>
            <a class="choice" href="/vsop/versioni" style="text-decoration:none;color:inherit"><h4><span class="ic">🗂️</span> Documenti · Bozze &amp; versioni</h4><p class="muted">Crea, modifica, nascondi/elimina e pubblica: vIPI, aeroporti, vLOA. Storico e release AIRAC.</p></a>
            <a class="choice" href="/vsop/admin/audit" style="text-decoration:none;color:inherit"><h4><span class="ic">📜</span> Audit log</h4><p class="muted">Chi ha fatto cosa: pubblicazioni e modifiche permessi.</p></a>
            <a class="choice" href="/vsop/admin/tasks" style="text-decoration:none;color:inherit"><h4><span class="ic">📋</span> Incarichi editor</h4><p class="muted">Assegna e monitora i task degli editor, con avanzamento e ritardi.</p></a>
        </div>

        <div class="section-title"><h3>Permessi editing</h3><span class="ln"></span></div>
        <div class="callout info"><span class="cic">ℹ️</span><div><p class="ct">Grant per VID</p>Seleziona uno staffista dall'elenco (staff IT che si è loggato almeno una volta) oppure inserisci un VID a mano.</div></div>

        @if (_error is not null) { <div class="callout danger"><span class="cic">⛔</span><div>@_error</div></div> }
        @if (_status is not null) { <div class="callout success"><span class="cic">✓</span><div>@_status</div></div> }

        <div class="apt-2col" style="margin-top:14px">
            <div>
                <h4>Permessi attivi</h4>
                @if (_grants is null) { <p class="help">Caricamento…</p> }
                else if (_grants.Count == 0) { <p class="help">Nessun permesso concesso.</p> }
                else
                {
                    <table>
                        <thead><tr><th>VID</th><th>Nome</th><th>ACC</th><th>Concesso da</th><th>Quando</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var g in _grants)
                            {
                                <tr>
                                    <td><b>@g.UserId</b></td>
                                    <td>@(string.IsNullOrWhiteSpace(g.DisplayName) ? "—" : g.DisplayName)</td>
                                    <td>@g.AccCode</td>
                                    <td>@g.GrantedByUserId</td>
                                    <td>@g.GrantedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                                    <td><button class="btn ghost" disabled="@_busy" @onclick="() => Revoke(g.Id)">Revoca</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="xfe-form">
                <h4>Concedi permesso</h4>
                @if (_members is { Count: > 0 })
                {
                    <div class="field"><label>Staffista IT</label>
                        <select @bind="_selectedUserId" @bind:after="OnMemberPicked">
                            <option value="0">— seleziona —</option>
                            @foreach (var m in _members)
                            {
                                <option value="@m.UserId">@m.UserId@(string.IsNullOrWhiteSpace(m.DisplayName) ? "" : $" — {m.DisplayName}") (@string.Join(", ", m.StaffPositions))</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <p class="help">Nessuno staffista nell'elenco: comparirà dopo il primo login. Inserisci il VID a mano.</p>
                }
                <div class="field"><label>VID</label><input type="number" placeholder="es. 123456" @bind="_userId" /></div>
                <div class="field"><label>Nome (opzionale)</label><input placeholder="es. Mario Rossi" @bind="_name" /></div>
                <div class="field"><label>ACC</label>
                    <select @bind="_accCode">
                        @foreach (var acc in Stations.Accs) { <option value="@acc.Code">@acc.Code — @acc.Name</option> }
                    </select>
                </div>
                <button class="btn primary" style="width:100%;margin-top:4px" disabled="@_busy" @onclick="Add">+ Concedi</button>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<GrantRow>? _grants;
    private bool _busy;
    private string? _status, _error;

    private int _userId;
    private string _name = "";
    private string _accCode = "LIRR";

    private IReadOnlyList<StaffRosterEntry>? _members;
    private int _selectedUserId;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        await LoadAsync();
        _members = await Roster.ListActiveAsync();
    }

    private void OnMemberPicked()
    {
        var m = _members?.FirstOrDefault(x => x.UserId == _selectedUserId);
        if (m is null) return;
        _userId = m.UserId;
        _name = m.DisplayName ?? "";
    }

    private async Task LoadAsync()
    {
        try { _grants = await Authz.ListGrantsAsync(); }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    private async Task Add()
    {
        _busy = true; _status = null; _error = null;
        try
        {
            if (_userId <= 0) throw new InvalidOperationException("VID non valido.");
            await Authz.AddGrantAsync(_userId, string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(), _accCode);
            _userId = 0; _name = "";
            await LoadAsync();
            _status = "Permesso concesso.";
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Revoke(int id)
    {
        _busy = true; _status = null; _error = null;
        try { await Authz.RevokeGrantAsync(id); await LoadAsync(); _status = "Permesso revocato."; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
