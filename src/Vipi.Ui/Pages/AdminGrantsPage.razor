@page "/vsop/admin/permessi"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IStationResolver Stations
@inject IStaffRosterService Roster
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Abstractions.IStaffRosterRepository StaffRoster
@inject IJSRuntime JS

<PageTitle>@L["Common_StaffArea"] · IVAO Italia</PageTitle>

<div class="wrap struct">
    @* ---- Le pagine admin, dove stava la briciola di pane ----
       La barra è al posto della briciola perché ne faceva già il lavoro e meglio: «Home › Staff Area ›
       Structure › Airports» portava a tre posti che sono tutti qui dentro (o nel logo in topbar), diceva
       «sei in Airports» come lo dice la voce accesa, e inventava una gerarchia — Aeroporti NON sta sotto
       Struttura, sono pagine sorelle, e la barra le mostra per quello che sono. Le briciole erano anche già
       divergenti fra loro: «Admin» portava a due indirizzi diversi a seconda della pagina.
       Sopra il titolo e non sotto: il titolo deve toccare il contenuto che intitola. Da sotto, la barra si
       infilava fra l'H2 e la sua prima sezione e li staccava.
       ⚠️ Resta nuda, senza `@if` intorno: il filtro per autorizzazione lo fa il componente. *@
    <AdminNav />

    @* ---- Testata in UNA riga: titolo (+conteggio) · «?» · comandi di PAGINA · esito ----
       Il titolo era «Area Staff» su una rotta che si chiama /permessi: la pagina era due pagine, un hub di
       navigazione e i permessi. L'hub è diventato la barra qui sotto, e il titolo dice cosa fa la pagina. *@
    <div class="doc-head st-head">
        <h2 class="st-h2">@L["Home_PermsTitle"]&nbsp;<span class="pill blue" title="@L["Grants_CountTitle"]">@CountLabel()</span></h2>
        <HelpHint Href="/vsop/guida#admin-permessi" AriaLabel="@L["Grants_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Grants_Subtitle"]</p>
            @((MarkupString)L["Grants_Intro"].Value)
        </HelpHint>
        @if (Authz.IsAdmin)
        {
            <nav class="struct-nav">
                @* Concedere a una persona NUOVA è il gesto raro: paga un clic. Dare un secondo ACC a chi c'è
                   già — il gesto comune — si fa dal pannello della persona, senza ridigitare il VID. *@
                <button class="btn primary @(_grantOpen ? "on" : "")" disabled="@_busy" @onclick="ToggleGrantForm"
                        title="@L["Grants_GrantPermission"]"><Icon Name="plus" Size="14" /> @L["Grants_GrantBtn"]</button>
            </nav>
            @if (_error is not null || _status is not null)
            {
                <span class="st-msg @(_error is not null ? "warn" : "ok")" role="status" aria-live="polite">
                    <Icon Name="@(_error is not null ? "warning" : "check-circle")" Size="14" />
                    <span class="st-msg-t">@(_error ?? _status)</span>
                    <button class="tclose" title="@L["Common_Close"]" @onclick="ClearStatus">✕</button>
                </span>
            }
        }
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_AccessReserved"]</p>@L["Grants_StaffOnly"]</div></div>
    }
    else
    {
        @* ---- Due pannelli alti quanto lo schermo meno ciò che sta sopra (vipiFitViewport a ogni render) ----
           A sinistra una riga per PERSONA, a destra la persona scelta (o il form per una nuova). Prima la
           tabella lavorava in mezza pagina perché l'altra metà era il form «Concedi» sempre aperto: 16 grant
           facevano righe da 86px col nome e la data a capo, e sotto il form restavano ~1 100px di bianco. *@
        <div class="perm-layout">
            @* --- SINISTRA: chi ha un permesso --- *@
            <div class="panel st-pane">
                <div class="struct-bar">
                    <input class="htree-search" value="@_q" @oninput="e => SetQuery(e.Value?.ToString())" placeholder="@L["Grants_SearchPh"]" />
                    @* I chip contano le PERSONE per ACC, non i grant: è la stessa unità delle righe che
                       filtrano (regola 107). Ci sono sempre, spenti a zero. *@
                    <span class="sb-chips">
                        @foreach (var acc in AccConGrant)
                        {
                            var n = PersonePerAcc(acc);
                            <button class="sh-chip @(_accFilter == acc ? "on" : "")" disabled="@(n == 0)"
                                    title="@L["Grants_ChipAccTitle", acc]" @onclick="() => ToggleAcc(acc)">@acc <span class="chip-n">@n</span></button>
                        }
                        <button class="lnk-mini" disabled="@(!IsFiltering)" @onclick="ClearFilters"
                                title="@L["Grants_ClearTitle"]" aria-label="@L["Grants_Clear"]">✕</button>
                    </span>
                </div>
                @if (_grants is null)
                {
                    <LoadingState />
                }
                else if (Persone.Count == 0)
                {
                    <p class="help">@(_grants.Count == 0 ? L["Grants_NoneGranted"] : L["Grants_NoMatch"])</p>
                }
                else
                {
                    <div class="st-scroll">
                        @foreach (var p in Persone)
                        {
                            @* La riga intera sceglie: cliccata sceglie, ricliccata lascia, un'altra sposta la
                               scelta; Invio e Spazio fanno quello che fa il clic. *@
                            <div class="doc-rowi acc-pick @(_selUserId == p.UserId ? "picked" : "")"
                                 role="button" tabindex="0" aria-pressed="@(_selUserId == p.UserId ? "true" : "false")"
                                 title="@L["Grants_RowPickTitle"]" @onclick="() => Pick(p.UserId)" @onkeydown="e => OnRowKey(e, p.UserId)">
                                <span class="di"><Icon Name="key" Size="16" /></span>
                                <div class="dr-main">
                                    <b>@Nome(p)</b>
                                    <div class="dr-sub">VID @p.UserId@(p.Staff.Count == 0 ? "" : " · " + string.Join(" ", p.Staff))</div>
                                </div>
                                @foreach (var g in p.Grants)
                                {
                                    <span class="pill blue">@g.AccCode</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* --- DESTRA: la persona scelta, oppure il form per una persona nuova --- *@
            <div class="panel st-pane">
                @if (_grantOpen)
                {
                    <div class="ver-detail-head">
                        <div class="dr-main"><b>@L["Grants_GrantPermission"]</b><div class="dr-sub">@L["Grants_GrantByVid"]</div></div>
                        <button class="lnk-mini" @onclick="ToggleGrantForm" title="@L["Common_Close"]" aria-label="@L["Common_Close"]">✕</button>
                    </div>
                    <div class="st-scroll">
                        <div class="perm-form">
                            @if (_members is { Count: > 0 })
                            {
                                <div class="field"><label>@L["Grants_ItStaffer"]</label>
                                    <select class="app-in" @bind="_selectedUserId" @bind:after="OnMemberPicked">
                                        <option value="0">@L["Grants_Select"]</option>
                                        @foreach (var m in _members)
                                        {
                                            <option value="@m.UserId">@m.UserId@(string.IsNullOrWhiteSpace(m.DisplayName) ? "" : $" — {m.DisplayName}") (@string.Join(", ", m.StaffPositions))</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <p class="help">@L["Grants_NoStaffer"]</p>
                            }
                            @* ⚠️ Il VID nasce VUOTO, non a zero: con `0` nel campo il segnaposto «es. 123456»
                               non si vedeva mai, e zero non è un VID. *@
                            <div class="field"><label>VID</label><input class="app-in" type="number" placeholder="@L["Grants_VidPh"]" @bind="_userIdText" @bind:event="oninput" /></div>
                            <div class="field"><label>@L["Grants_NameOptional"]</label><input class="app-in" placeholder="@L["Grants_NamePh"]" @bind="_name" /></div>
                            <div class="field"><label>ACC</label>
                                <select class="app-in" @bind="_accCode">
                                    @foreach (var acc in Stations.Accs) { <option value="@acc.Code">@acc.Code — @acc.Name</option> }
                                </select>
                            </div>
                            <button class="btn primary perm-go" disabled="@(_busy || ParsedVid is null)" @onclick="Add"><Icon Name="plus" Size="14" /> @L["Grants_GrantBtn"]</button>
                        </div>
                    </div>
                }
                else if (Scelta is { } sel)
                {
                    <div class="ver-detail-head">
                        <div class="dr-main">
                            <b>@Nome(sel)</b>
                            <div class="dr-sub">VID @sel.UserId@(sel.Staff.Count == 0 ? "" : " · " + string.Join(" ", sel.Staff))</div>
                        </div>
                        <span class="pill grey" title="@L["Grants_NAccTitle"]">@L["Grants_NAcc", sel.Grants.Count]</span>
                    </div>
                    <div class="st-scroll">
                        @foreach (var g in sel.Grants)
                        {
                            <div class="ver-row">
                                <span class="vb">@g.AccCode</span>
                                <div>
                                    <b>@L["Grants_GrantedOn", g.GrantedAtUtc.ToLocalTime().ToString("dd MMM yyyy")]</b>
                                    <div class="vmeta">@L["Grants_GrantedBy"]: @Autore(g.GrantedByUserId)</div>
                                </div>
                                <span class="vact">
                                    @* Revocare non distrugge un documento, ma toglie l'accesso a una persona
                                       che magari sta editando: la conferma dice CHI e QUALE ACC. *@
                                    <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Grants_RevokeTitle"]" AriaLabel="@L["Grants_Revoke"]"
                                                   Prompt="@L["Grants_RevokePrompt", Nome(sel), g.AccCode]" Disabled="@_busy"
                                                   ConfirmLabel="@L["Grants_RevokeYes"]" CancelLabel="@L["Common_Cancel"]"
                                                   OnConfirm="() => Revoke(g.Id)">
                                        <Trigger><Icon Name="x" Size="14" /> @L["Grants_Revoke"]</Trigger>
                                    </InlineConfirm>
                                </span>
                            </div>
                        }
                        @* Il caso comune: un secondo ACC a chi c'è già. Senza ridigitare il VID. *@
                        <div class="perm-add">
                            <select class="app-in" @bind="_addAccCode">
                                @foreach (var acc in AccDisponibili(sel))
                                {
                                    <option value="@acc.Code">@acc.Code — @acc.Name</option>
                                }
                            </select>
                            <button class="btn ghost" disabled="@(_busy || AccDisponibili(sel).Count == 0)" @onclick="() => AddTo(sel)"
                                    title="@L["Grants_AddAccTitle"]"><Icon Name="plus" Size="14" /> @L["Grants_AddAcc"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="help">@L["Grants_PickHint"]</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<GrantRow>? _grants;
    private bool _busy;
    private string? _status, _error;

    // Il VID si tiene come TESTO: un `int` legato a un <input type=number> nasce a 0, e con «0» dentro il
    // campo il segnaposto non si vede mai — mentre 0 non è un VID. Vuoto significa vuoto.
    private string _userIdText = "";
    private string _name = "";
    private string _accCode = "LIRR";
    private string _addAccCode = "";

    private IReadOnlyList<StaffRosterEntry>? _members;
    private int _selectedUserId;

    // Stato di PAGINA: la persona scelta e il form di concessione, che non convivono nel pannello di destra.
    private int? _selUserId;
    private bool _grantOpen;

    private string _q = "";
    private string? _accFilter;

    // Nomi risolti dal roster: l'elenco porta solo i VID di chi ha concesso, e «704798» non dice niente.
    private readonly Dictionary<int, string> _nomi = new();

    private int? ParsedVid => int.TryParse(_userIdText, out var v) && v > 0 ? v : null;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        // Il menù degli ACC legge Stations.Accs nel RENDER: senza scaldarlo qui, il primo accesso è un
        // lazy-load sul DbContext del circuito mentre un'altra operazione è in volo ⇒ «A second operation
        // was started». Vale per ogni provider; su MariaDB si vede sempre (verifica live A6).
        Stations.Prewarm();
        await LoadAsync();
        _members = await Roster.ListActiveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Authz.IsAdmin) return;
        // «Schermo meno ciò che sta sopra» non è esprimibile in CSS: si misura, e a ogni render — sopra ci
        // sono cose che compaiono e spariscono (il chip d'esito, la barra che va a capo, il «?» aperto).
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".perm-layout", 900); } catch (Exception) { }
    }

    private void OnMemberPicked()
    {
        var m = _members?.FirstOrDefault(x => x.UserId == _selectedUserId);
        if (m is null) return;
        _userIdText = m.UserId.ToString();
        _name = m.DisplayName ?? "";
    }

    private async Task LoadAsync()
    {
        try
        {
            _grants = await Authz.ListGrantsAsync();
            await RisolviNomiAsync();
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    /// <summary>
    /// Risolve in nomi i VID che l'elenco mostra ma non porta: quelli di chi ha CONCESSO. Il nome della
    /// persona che riceve sta già nella riga (<c>DisplayName</c>), ma non sempre — chi è stato aggiunto a
    /// mano senza nome compariva come «—» anche quando il roster il nome ce l'aveva.
    /// </summary>
    private async Task RisolviNomiAsync()
    {
        if (_grants is null) return;
        var vids = new HashSet<int>();
        foreach (var g in _grants) { vids.Add(g.GrantedByUserId); vids.Add(g.UserId); }
        var mancanti = vids.Where(v => v != 0 && !_nomi.ContainsKey(v)).ToList();
        if (mancanti.Count == 0) return;
        foreach (var kv in await StaffRoster.GetDisplayNamesAsync(mancanti)) _nomi[kv.Key] = kv.Value;
    }

    private string Autore(int vid) => _nomi.TryGetValue(vid, out var n) ? $"{n} (VID {vid})" : $"VID {vid}";

    // ---- le persone: un raggruppamento in PAGINA, non un modello gemello ----
    // La revoca continua a viaggiare per Id del grant; qui si risponde alla domanda della pagina, che è
    // «chi può cosa» — prima la stessa persona compariva in due punti lontani dell'elenco per ACC.
    private sealed record Persona(int UserId, string? DisplayName, IReadOnlyList<GrantRow> Grants, IReadOnlyList<string> Staff);

    private IReadOnlyList<Persona> Persone
    {
        get
        {
            if (_grants is null) return Array.Empty<Persona>();
            var q = _q.Trim();
            return _grants
                .GroupBy(g => g.UserId)
                .Select(g => new Persona(
                    g.Key,
                    g.Select(x => x.DisplayName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)),
                    g.OrderBy(x => x.AccCode, StringComparer.OrdinalIgnoreCase).ToList(),
                    _members?.FirstOrDefault(m => m.UserId == g.Key)?.StaffPositions ?? Array.Empty<string>()))
                .Where(p => _accFilter is null || p.Grants.Any(x => string.Equals(x.AccCode, _accFilter, StringComparison.OrdinalIgnoreCase)))
                .Where(p => q.Length == 0
                    || p.UserId.ToString().Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (Nome(p)?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || p.Grants.Any(x => x.AccCode.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(p => Nome(p), StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    /// <summary>Nome da mostrare: quello del grant, o quello del roster, o il VID — mai un trattino.</summary>
    private string Nome(Persona p) =>
        !string.IsNullOrWhiteSpace(p.DisplayName) ? p.DisplayName!
        : _nomi.TryGetValue(p.UserId, out var n) ? n
        : $"VID {p.UserId}";

    private Persona? Scelta => _selUserId is null ? null : Persone.FirstOrDefault(p => p.UserId == _selUserId);

    /// <summary>Gli ACC che compaiono in almeno un permesso: sono i chip della barra, e sono pochi.</summary>
    private IReadOnlyList<string> AccConGrant => _grants is null
        ? Array.Empty<string>()
        : _grants.Select(g => g.AccCode).Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a, StringComparer.OrdinalIgnoreCase).ToList();

    /// <summary>Il chip conta le PERSONE, come le righe che mostra una volta cliccato (regola 107).</summary>
    private int PersonePerAcc(string acc) => _grants is null
        ? 0
        : _grants.Where(g => string.Equals(g.AccCode, acc, StringComparison.OrdinalIgnoreCase))
            .Select(g => g.UserId).Distinct().Count();

    private IReadOnlyList<AccInfo> AccDisponibili(Persona p) =>
        Stations.Accs.Where(a => !p.Grants.Any(g => string.Equals(g.AccCode, a.Code, StringComparison.OrdinalIgnoreCase))).ToList();

    private bool IsFiltering => !string.IsNullOrWhiteSpace(_q) || _accFilter is not null;

    private string CountLabel()
    {
        if (_grants is null) return "";
        var tot = _grants.Select(g => g.UserId).Distinct().Count();
        var mostrate = Persone.Count;
        return IsFiltering ? $"{mostrate}/{tot}" : tot.ToString();
    }

    private void SetQuery(string? q) { _q = q ?? ""; }
    private void ToggleAcc(string acc) { _accFilter = _accFilter == acc ? null : acc; }
    private void ClearFilters() { _q = ""; _accFilter = null; }
    private void ClearStatus() { _status = _error = null; }

    private void Pick(int userId)
    {
        _selUserId = _selUserId == userId ? null : userId;
        if (_selUserId is not null) _grantOpen = false;   // i due modi del pannello non convivono
        // ⚠️ Il menu «aggiungi ACC» va portato su un valore che esiste FRA LE SUE OPZIONI: con `@bind` a una
        // stringa vuota il browser non sceglie niente e la casella nasce vuota — sembra rotta, e il tasto
        // accanto sembra non fare niente.
        _addAccCode = Scelta is { } p ? AccDisponibili(p).FirstOrDefault()?.Code ?? "" : "";
    }

    private void OnRowKey(KeyboardEventArgs e, int userId)
    {
        if (e.Key is "Enter" or " " or "Spacebar") Pick(userId);
    }

    private void ToggleGrantForm()
    {
        _grantOpen = !_grantOpen;
        if (_grantOpen) _selUserId = null;
    }

    private async Task Add()
    {
        if (ParsedVid is not int vid) { _error = L["Grants_BadVid"]; return; }
        await Esegui(async () =>
        {
            await Authz.AddGrantAsync(vid, string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(), _accCode);
            _userIdText = ""; _name = ""; _selectedUserId = 0;
            _grantOpen = false;
            _selUserId = vid;         // si finisce sulla persona appena servita, non su una pagina vuota
        }, L["Grants_GrantedMsg"]);
    }

    /// <summary>Un ACC in più a chi c'è già: il caso comune, senza ridigitare il VID.</summary>
    private async Task AddTo(Persona p)
    {
        var acc = string.IsNullOrWhiteSpace(_addAccCode) ? AccDisponibili(p).FirstOrDefault()?.Code : _addAccCode;
        if (acc is null) return;
        await Esegui(async () =>
        {
            await Authz.AddGrantAsync(p.UserId, string.IsNullOrWhiteSpace(p.DisplayName) ? null : p.DisplayName, acc);
            _addAccCode = "";   // ricalcolato sotto, quando l'elenco aggiornato dice cosa resta disponibile
        }, L["Grants_GrantedMsg"]);
    }

    private async Task Revoke(int id) => await Esegui(() => Authz.RevokeGrantAsync(id), L["Grants_RevokedMsg"]);

    private async Task Esegui(Func<Task> azione, string ok)
    {
        _busy = true; _status = _error = null;
        try
        {
            await azione();
            await LoadAsync();
            // Revocato l'ultimo ACC, la persona non esiste più come riga: il pannello si svuota da sé invece
            // di mostrare qualcuno che a schermo non c'è.
            if (_selUserId is int sel && _grants is not null && !_grants.Any(g => g.UserId == sel)) _selUserId = null;
            if (Scelta is { } p2 && !AccDisponibili(p2).Any(a => string.Equals(a.Code, _addAccCode, StringComparison.OrdinalIgnoreCase)))
                _addAccCode = AccDisponibili(p2).FirstOrDefault()?.Code ?? "";
            _status = ok;
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
