@page "/services/vsop/search"
@layout SopLayout
@rendermode InteractiveServer
@using System.Net
@using System.Text.RegularExpressions
@using Microsoft.Extensions.DependencyInjection
@inherits ScopeProprioCheAspetta
@inject IStringLocalizer<SharedResource> L
@inject EnglishStrings En

<PageTitle>@L["Search_Title"] · vIPI IVAO Italy</PageTitle>

<div class="wrap" style="max-width:1000px">
    <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <b>@En["Search_Title"]</b></div>
    @* ⚠️ Fuori campo e non a schermo: qui il titolo lo dice già la briciola di pane, e stamparne uno vero
       sopra il campo di ricerca vorrebbe dire ripetere la stessa parola due volte a 20px di distanza. Ma una
       pagina senza <h1> non ha un titolo per chi la naviga per intestazioni, ed è una pagina di RISULTATI:
       sapere dove si è atterrati è metà del mestiere. *@
    <h1 class="sr-only">@L["Search_Title"]</h1>

    <div class="searchbar" style="background:var(--surface);border:1px solid var(--line);max-width:none;margin:6px 0 16px">
        <span class="ico"><Icon Name="search" /></span>
        @* ⚠️ La ricerca parte dal CAMBIO DEL TESTO (`@bind:after`), non dal tasto. Fino al 24 settembre 2026 partiva
           a `keyup`, mentre il testo mostrato seguiva `input`: incollando col mouse, col completamento automatico o
           con una prova via script, la riga diceva la parola nuova col conteggio vecchio — «0 results for Brindisi»
           in produzione, con 16 risultati veri (S7, docs/filoni/sito.md). *@
        <input @bind="_q" @bind:event="oninput" @bind:after="DopoIlTesto" placeholder="@L["Search_Placeholder"]" style="color:var(--ink)" />
    </div>
    <div class="apt-quick" style="margin-bottom:18px">
        @foreach (var (labelKey, sc) in _scopes)
        {
            <Chip Class="@($"ch {(_scope == sc ? "on" : "")}")" Active="_scope == sc" Style="cursor:pointer" OnActivate="() => SetScope(sc)">@L[labelKey]</Chip>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(_q) || _q.Trim().Length < 2)
    {
        <p class="muted" style="font-size:13px">@L["Search_MinChars"]</p>
    }
    else
    {
        <p class="muted" style="font-size:13px;margin-bottom:12px">@L["Search_ResultsFor", _hits.Count] <b>@_q</b></p>
        <div class="res">
            @foreach (var h in _hits)
            {
                <a class="res-row @(IsGuide(h) ? "guide" : null)" href="@h.Url" style="display:block;text-decoration:none;color:inherit">
                    <div class="res-where">@if (IsGuide(h)) { <Icon Name="book-open" Size="13" /> } @h.Where</div>
                    <div class="res-snip">@Highlight(h.Snippet)</div>
                </a>
            }
            @if (_hits.Count == 0)
            {
                <p class="help">@L["Search_NoResults"]</p>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private string _q = "";
    private SearchScope _scope = SearchScope.All;
    private IReadOnlyList<SearchHit> _hits = new List<SearchHit>();

    // (chiave-risorsa, scope): l'etichetta è localizzata in markup via L[labelKey].
    private static readonly (string, SearchScope)[] _scopes =
    {
        ("Common_All", SearchScope.All), ("Search_ScopeVipi", SearchScope.Vipi), ("Search_ScopeApp", SearchScope.App), ("Search_ScopeVloa", SearchScope.Vloa), ("Search_ScopeAirports", SearchScope.Airport),
        // ⚠️ I vSOP militari NON stanno sotto «Aeroporti»: quel taglio guarda il tipo di release, non
        // l'ICAO, e un documento militare non è una vIPI d'aeroporto — ha altre sezioni, altra release e
        // altro ciclo. Senza un taglio suo si poteva trovare solo cercando in «Tutto».
        ("Mil_Title", SearchScope.Mil),
    };

    // 🔴 T-014 (revisione del 13 settembre 2026). Ogni tasto lanciava una ricerca (5-8 query) sul DbContext del
    // CIRCUITO, senza porta: scrivendo «LIRF» di seguito la seconda partiva mentre la prima aspettava, EF
    // rispondeva «A second operation was started» e il circuito di un anonimo cadeva. Quando non cadeva, una
    // risposta vecchia poteva arrivare dopo quella nuova e sovrascriverla. Tre cose, ognuna per un pezzo:
    // - scope proprio: il DbContext è della pagina, non del circuito;
    // - la porta (InFilaAsync): una ricerca alla volta, e chi lascia la pagina aspetta quella in volo;
    // - il giro: chi è stato superato mentre aspettava non cerca, e un risultato superato non si scrive.
    private ISearchService Search = default!;
    private int _giro;

    /// <summary>Quanto si aspetta dopo un tasto prima di cercare: chi scrive «LIRF» fa una ricerca, non quattro.</summary>
    private static readonly TimeSpan Pausa = TimeSpan.FromMilliseconds(200);

    protected override void OnInitialized() => Search = ScopedServices.GetRequiredService<ISearchService>();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Q) && string.IsNullOrEmpty(_q)) _q = Q!;
        await RunAsync(pausa: false);
    }

    private Task DopoIlTesto() => RunAsync(pausa: true);
    private Task SetScope(SearchScope sc) { _scope = sc; return RunAsync(pausa: false); }

    private async Task RunAsync(bool pausa)
    {
        var mio = ++_giro;
        if (pausa)
        {
            await Task.Delay(Pausa);
            if (mio != _giro) return;   // un tasto dopo: cercherà lui
        }

        await InFilaAsync(async () =>
        {
            if (mio != _giro || Chiusa) return;   // superato mentre aspettava la porta
            var q = _q;
            var hits = await Search.SearchAsync(q, _scope);
            if (mio == _giro) _hits = hits;
        });
    }

    // Hit della Guida: mostrati con icona libro. Vedi GuideSearchCatalog.
    // ⚠️ Si riconoscono dall'INDIRIZZO, non dal testo: fino al 24 settembre 2026 si guardava «Guida ›», e in inglese
    // la Guida scrive «Guide ›» — le sue voci perdevano il libro e sembravano documenti (S8, docs/filoni/sito.md).
    private static bool IsGuide(SearchHit h) => h.Url.StartsWith(GuidaUrl, StringComparison.OrdinalIgnoreCase);
    private const string GuidaUrl = "/services/vsop/guide";

    // Evidenziazione sicura: encode dell'HTML, poi <mark> attorno alle occorrenze del termine (no XSS).
    private MarkupString Highlight(string text)
    {
        var enc = WebUtility.HtmlEncode(text);
        var term = WebUtility.HtmlEncode(_q.Trim());
        if (term.Length == 0) return new MarkupString(enc);
        var html = Regex.Replace(enc, Regex.Escape(term), m => $"<mark>{m.Value}</mark>", RegexOptions.IgnoreCase);
        return new MarkupString(html);
    }
}
