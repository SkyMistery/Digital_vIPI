    /// <summary>«Re-import from IVAO»: tutto quello che l'aeroporto prende dalla sorgente, in un colpo —
    /// piste + Transition Altitude (secondo la policy «Sorgenti dati») E catalogo settori. Prima faceva solo
    /// le prime due e non lasciava traccia: il ↧ accanto al bottone è la data d'import dei SETTORI, quindi
    /// non si muoveva mai e sembrava che il bottone non facesse niente. L'esito ora è scritto nel callout.</summary>
    private async Task Reimport()
    {
        if (!await ConfirmDiscardingSidEdits())
            return;
        if (!await Confirm(L["Ape_ReimportConfirm"].Value))
            return;

        AirportSectorImportResult? sectors = null;
        var ok = await Guarded(async () =>
        {
            await Profile.ReimportFromSourceAsync(_icao);
            sectors = await Sectors.ImportFromSourceAsync(_icao);
        });
        if (!ok) return;

        await LoadAsync();
        _saveInfo = L["Ape_ReimportDone", _rwys.Count, sectors?.Created ?? 0, sectors?.Updated ?? 0].Value;
        _saveInfoWarn = false;
        ProgrammaChiusuraInformativa();
    }

    // --- Import SID dal sectorfile: rimpiazza le importate, preserva manuali/priorità/forzatura ---
    // ImportForCurrentUserAsync e non ImportAsync: quest'ultimo è l'ingresso del job periodico, che gira
    // senza utente e quindi senza controllo di autorizzazione. Vedi ISidImporter.
    // ⚠️ Ricarica i buffer dal DB: le righe toccate e non salvate sparirebbero in silenzio. Prima si chiede.
    private async Task ReimportSids()
    {
        if (!await ConfirmDiscardingSidEdits()) return;
        if (await Guarded(() => SidImporter.ImportForCurrentUserAsync(_icao))) await LoadAsync();
    }

    private async Task<bool> ConfirmDiscardingSidEdits() =>
        _dirtySid.Count == 0 || await Confirm(Plural(_dirtySid.Count, "Ape_SidDiscardConfirm", _dirtySid.Count));

    // «Salvate 1 SID» è il genere di dettaglio che fa sembrare la pagina scritta da nessuno: le chiavi con un
    // contatore hanno la loro forma singolare, con lo stesso nome più «One».
    private string Plural(int n, string key, params object[] args) => L[n == 1 ? key + "One" : key, args].Value;

    private async Task PersistImported(ImportedSidEdit e)
    {
        string? resolvedFix = null;
        if (e.NeedsReview && !string.IsNullOrWhiteSpace(e.FixOverride))
        {
            resolvedFix = e.FixOverride!.Trim();
            if (e.CreateAlias) await SidAliases.UpsertAsync(e.Fix, resolvedFix);   // e.Fix = prefisso grezzo
        }
        await Profile.UpdateImportedSidAsync(_icao, e.Id, e.Priority, e.ForcePublished, resolvedFix,
            e.InitialClimb, e.InitialClimbByApp, e.Cat, e.Wtc, e.Condition);
        e.IsPublicNow = e.IsPublicNow || e.ForcePublished;   // riflette subito la forzatura senza reload totale
    }

    // --- Arricchimenti multi-select su SID importate: CAT per VREF, WTC per scia; salvati come CSV nell'ordine canonico ---
    private static readonly string[] WtcTokens = { "L", "M", "H", "S" };
    private static readonly string[] CatTokens = { "A", "B", "C", "D", "E" };

    private static bool HasTok(string? csv, string tok) =>
        (csv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Contains(tok, StringComparer.OrdinalIgnoreCase);

    // Toggle di un token; ricompone la CSV nell'ordine canonico (order) così la resa è stabile a prescindere dai click.
    private static string? ToggleTok(string? csv, string tok, string[] order)
    {
        var set = (csv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => t.ToUpperInvariant()).ToHashSet();
        if (!set.Remove(tok)) set.Add(tok);
        var res = string.Join(", ", order.Where(set.Contains));
        return res.Length == 0 ? null : res;
    }

    // Ogni modifica a una riga importata la auto-seleziona: così "Salva selezionate" raccoglie tutte le righe toccate.
    private void TouchImported(ImportedSidEdit e) => _dirtySid.Add(e.Id);

    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // Chip Cat./WTC: clic = solo questo, doppio clic o Shift+clic = anche i precedenti
    //
    // Una procedura per categoria E vale anche per le più piccole, e quasi sempre si accendono a scala.
    // ⚠️ Il doppio clic del browser arriva DOPO due clic singoli: i due toggle si annullano fra loro, quindi
    // quando `TokScale` parte lo stato è quello di partenza e la regola si applica su quello giusto. Si vede
    // un lampeggio del chip: toglierlo vorrebbe dire ritardare ogni clic singolo di un quarto di secondo, e
    // qui di clic se ne fanno a centinaia.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    private static string? ScaleTok(string? csv, string tok, string[] order)
    {
        var turnOn = !HasTok(csv, tok);
        var upTo = Array.IndexOf(order, tok);
        if (upTo < 0) return csv;
        var set = new HashSet<string>(
            (csv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i <= upTo; i++)
        {
            if (turnOn) { set.Add(order[i]); } else { set.Remove(order[i]); }
        }
        var res = string.Join(",", order.Where(t => set.Contains(t)));
        return res.Length == 0 ? null : res;
    }

    // Shift+clic (e Shift+Invio, che il browser consegna come clic con lo shift premuto) fa quello che fa il
    // doppio clic: è la via da tastiera, e i chip sono già bottoni raggiungibili con Tab.
    private async Task TokClick(MouseEventArgs ev, bool imported, object row, string tok, string[] order)
    {
        if (ev.ShiftKey) { await TokScale(imported, row, tok, order); return; }
        SetTok(imported, row, order, Toggle: true, tok);
        await TouchRow(imported, row);
    }

    private async Task TokScale(bool imported, object row, string tok, string[] order)
    {
        SetTok(imported, row, order, Toggle: false, tok);
        await TouchRow(imported, row);
    }

    private void SetTok(bool imported, object row, string[] order, bool Toggle, string tok)
    {
        var cat = ReferenceEquals(order, CatTokens);
        if (imported)
        {
            var e = (ImportedSidEdit)row;
            var cur = cat ? e.Cat : e.Wtc;
            var next = Toggle ? ToggleTok(cur, tok, order) : ScaleTok(cur, tok, order);
            if (cat) { e.Cat = next; } else { e.Wtc = next; }
        }
        else
        {
            var m = (SidEdit)row;
            var cur = cat ? m.Cat : m.Wtc;
            var next = Toggle ? ToggleTok(cur, tok, order) : ScaleTok(cur, tok, order);
            if (cat) { m.Cat = next; } else { m.Wtc = next; }
        }
    }

    private Task TouchRow(bool imported, object row)
    {
        if (imported) { TouchImported((ImportedSidEdit)row); return Task.CompletedTask; }
        return MarkDirty("SID");
    }

    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // Scelta di gruppo: tutte le righe con lo stesso punto o la stessa transition
    //
    // Le varianti per pista e transizione della stessa procedura sono un gruppo naturale (su LIRF «NENIG»
    // sono nove righe): sceglierle una per una prima di «Pubblica scelte» è lavoro inutile. Agisce su ciò che
    // è A SCHERMO: scegliere righe nascoste da un filtro sarebbe una sorpresa, non una comodità.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    private void PickSameFix(ImportedSidEdit e) =>
        PickGroup(ImportedView().Where(x => string.Equals(x.Fix, e.Fix, OIC)).Select(x => x.Id).ToList());

    private void PickSameTrans(ImportedSidEdit e) =>
        PickGroup(ImportedView().Where(x => string.Equals(x.Transition ?? "", e.Transition ?? "", OIC)).Select(x => x.Id).ToList());

    private void PickGroup(List<int> ids)
    {
        if (ids.Count == 0) return;
        if (ids.All(_selSid.Contains)) { foreach (var id in ids) { _selSid.Remove(id); } }
        else { foreach (var id in ids) { _selSid.Add(id); } }
        _lastSelIdx = null;
    }

    private void PickSameFixManual(SidEdit s) =>
        PickGroupManual(ManualView().Where(x => string.Equals(x.Fix ?? "", s.Fix ?? "", OIC)).ToList());

    private void PickSameTransManual(SidEdit s) =>
        PickGroupManual(ManualView().Where(x => string.Equals(x.Transition ?? "", s.Transition ?? "", OIC)).ToList());

    private void PickGroupManual(List<SidEdit> rows)
    {
        if (rows.Count == 0) return;
        if (rows.All(_selManual.Contains)) { foreach (var r in rows) { _selManual.Remove(r); } }
        else { foreach (var r in rows) { _selManual.Add(r); } }
    }

    // I due gesti valgono anche dai tasti della barra, che agiscono sulla riga del campo toccato per ultimo:
    // il doppio clic è una scorciatoia, non l'unico modo di arrivarci.
    private void PickSameFromBar(bool imported, bool byTransition)
    {
        if (_src is null || _src.Imported != imported) return;
        if (imported)
        {
            var e = (ImportedSidEdit)_src.Row;
            if (byTransition) { PickSameTrans(e); } else { PickSameFix(e); }
        }
        else
        {
            var m = (SidEdit)_src.Row;
            if (byTransition) { PickSameTransManual(m); } else { PickSameFixManual(m); }
        }
    }

    private void ToggleManual(SidEdit s) { if (!_selManual.Remove(s)) { _selManual.Add(s); } }

    private void ToggleManualOnKey(KeyboardEventArgs ev, SidEdit s)
    {
        if (ev.Key != "Enter" && ev.Key != " " && ev.Key != "Spacebar") return;
        ToggleManual(s);
    }

    private void ToggleSelectAllManual(List<SidEdit> view)
    {
        if (view.Count == 0) return;
        if (view.All(_selManual.Contains)) { foreach (var r in view) { _selManual.Remove(r); } }
        else { foreach (var r in view) { _selManual.Add(r); } }
    }

    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // «Applica alle scelte»: copia il valore della cella toccata per ultimo nelle righe scelte
    //
    // L'unità è la CELLA, non il campo: la quota porta con sé il tasto APP (sono la stessa informazione), e
    // Cat./WTC copiano il gruppo intero di chip. Fix, nome, pista e transition non si propagano mai: sono
    // l'identità della riga. Si scrive nei buffer, quindi le righe restano «modificate» e un errore si annulla
    // ricaricando la pagina senza salvare.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    private enum SidCol { Climb, Cat, Wtc, Cond, Prio }
    private sealed record CellSource(bool Imported, object Row, SidCol Col);
    private CellSource? _src;

    private void Src(bool imported, object row, SidCol col) => _src = new CellSource(imported, row, col);

    private bool CanApply(bool imported) =>
        _src is not null && _src.Imported == imported && SelCount(imported) > 0 && _canEdit && !_busy;

    private int SelCount(bool imported) => imported ? _selSid.Count : _selManual.Count;

    /// <summary>Valore della cella sorgente, come si legge nel tasto e nella conferma.</summary>
    private string SourceValue()
    {
        if (_src is null) return "";
        string v;
        if (_src.Imported)
        {
            var e = (ImportedSidEdit)_src.Row;
            v = _src.Col switch
            {
                SidCol.Climb => (e.InitialClimb ?? "—") + (e.InitialClimbByApp ? " + APP" : ""),
                SidCol.Cat => e.Cat ?? "—",
                SidCol.Wtc => e.Wtc ?? "—",
                SidCol.Cond => e.Condition ?? "—",
                _ => e.Priority?.ToString() ?? "—",
            };
        }
        else
        {
            var m = (SidEdit)_src.Row;
            v = _src.Col switch
            {
                SidCol.Climb => (m.InitialClimb ?? "—") + (m.InitialClimbByApp ? " + APP" : ""),
                SidCol.Cat => m.Cat ?? "—",
                SidCol.Wtc => m.Wtc ?? "—",
                SidCol.Cond => m.Condition ?? "—",
                _ => m.Priority?.ToString() ?? "—",
            };
        }
        v = v.Trim();
        if (v.Length == 0) { v = "—"; }
        return v.Length > 22 ? v[..21] + "…" : v;
    }

    private string ApplyLabel(bool imported) =>
        _src is null || _src.Imported != imported
            ? L["Ape_ApplyNoSource"].Value
            : L["Ape_ApplyN", SourceValue(), SelCount(imported)].Value;

    private async Task ApplyToSelected(bool imported)
    {
        if (!CanApply(imported)) return;
        var value = SourceValue();
        var n = SelCount(imported);
        // Sopra le venti righe si rilegge prima di scrivere: sotto sarebbe rumore, sopra è una scrittura
        // che vale la pena confermare.
        if (n > 20 && !await Confirm(L["Ape_ApplyConfirm", value, n].Value)) return;

        var hidden = 0;
        if (imported)
        {
            var src = (ImportedSidEdit)_src!.Row;
            var visible = ImportedView().Select(x => x.Id).ToHashSet();
            foreach (var e in _imported.Where(x => _selSid.Contains(x.Id)))
            {
                CopyCell(src, e, _src.Col);
                TouchImported(e);
                if (!visible.Contains(e.Id)) { hidden++; }
            }
        }
        else
        {
            var src = (SidEdit)_src!.Row;
            var visible = ManualView().ToHashSet();
            foreach (var m in _selManual)
            {
                CopyCell(src, m, _src.Col);
                if (!visible.Contains(m)) { hidden++; }
            }
            await MarkDirty("SID");
        }
        _saveInfo = Plural(n, "Ape_ApplyDone", n) + (hidden > 0 ? L["Ape_ApplyHidden", hidden].Value : "");
        _saveInfoWarn = false;
        ProgrammaChiusuraInformativa();
    }

    private static void CopyCell(ImportedSidEdit from, ImportedSidEdit to, SidCol col)
    {
        switch (col)
        {
            case SidCol.Climb: to.InitialClimb = from.InitialClimb; to.InitialClimbByApp = from.InitialClimbByApp; break;
            case SidCol.Cat: to.Cat = from.Cat; break;
            case SidCol.Wtc: to.Wtc = from.Wtc; break;
            case SidCol.Cond: to.Condition = from.Condition; break;
            default: to.Priority = from.Priority; break;
        }
    }

    private static void CopyCell(SidEdit from, SidEdit to, SidCol col)
    {
        switch (col)
        {
            case SidCol.Climb: to.InitialClimb = from.InitialClimb; to.InitialClimbByApp = from.InitialClimbByApp; break;
            case SidCol.Cat: to.Cat = from.Cat; break;
            case SidCol.Wtc: to.Wtc = from.Wtc; break;
            case SidCol.Cond: to.Condition = from.Condition; break;
            default: to.Priority = from.Priority; break;
        }
    }

    /// <summary>Ctrl+Invio dentro un campo = «applica alle scelte», senza staccare le mani dalla tastiera.</summary>
    private Task CellKey(KeyboardEventArgs ev, bool imported) =>
        ev.CtrlKey && ev.Key == "Enter" ? ApplyToSelected(imported) : Task.CompletedTask;

    // Scelta da tastiera sulla cella di selezione (regola generale delle tabelle: Invio e Spazio fanno il clic).
    private void PickSidOnKey(KeyboardEventArgs ev, int id)
    {
        if (ev.Key != "Enter" && ev.Key != " " && ev.Key != "Spacebar") return;
        if (!_selSid.Remove(id)) _selSid.Add(id);
        _lastSelIdx = null;
    }

    private void ClearSidSelection() { _selSid.Clear(); _lastSelIdx = null; }

    // Conteggio onesto: «N di TOT» quando un filtro è attivo, il totale secco quando non lo è.
    private string CountLabel(int shown, int total) =>
        shown == total ? total.ToString() : L["Apt_CountOf", shown, total].Value;

    // Piste presenti fra le importate, con quante righe ciascuna: sono i chip della barra. Il conteggio segue
    // gli altri filtri (ricerca, «da verificare»), altrimenti un chip da 40 righe ne mostrerebbe 3 senza dirlo.
    private List<(string Ident, int Count)> ImportedRunways() =>
        FilteredImported(ignoreRunway: true)
            .Where(e => !string.IsNullOrWhiteSpace(e.Runway))
            .GroupBy(e => e.Runway!, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => (g.Key, g.Count()))
            .ToList();

    // --- Tabella importate: filtro (ricerca + solo-da-verificare) ---
    private List<ImportedSidEdit> ImportedView() => FilteredImported(ignoreRunway: false).ToList();

    private IEnumerable<ImportedSidEdit> FilteredImported(bool ignoreRunway)
    {
        IEnumerable<ImportedSidEdit> q = _imported;
        if (_sidOnlyReview) q = q.Where(e => e.NeedsReview);
        var s = (_sidSearch ?? "").Trim();
        if (s.Length > 0)
            q = q.Where(e => e.Fix.Contains(s, OIC) || e.Name.Contains(s, OIC) || (e.Runway?.Contains(s, OIC) ?? false));
        if (!ignoreRunway && _sidRwFilter is { Length: > 0 } rw)
            q = q.Where(e => string.Equals(e.Runway, rw, StringComparison.OrdinalIgnoreCase));
        return q;
    }

    // --- Multi-select importate: click = toggle (Shift/Ctrl+click = intervallo dall'ancora);
    //     trascina giù = seleziona lo spazzato, trascina su = deseleziona lo spazzato ---
    private bool _selDragActive;
    private int _selDragStart;
    private bool _selDragMoved;
    private bool _selDragMods;

    private void SelDragStart(int idx, MouseEventArgs e)
    {
        _selDragActive = true;
        _selDragStart = idx;
        _selDragMoved = false;
        _selDragMods = e.ShiftKey || e.CtrlKey;
    }

    private void SelDragEnter(int idx)
    {
        if (!_selDragActive || idx == _selDragStart) return;
        _selDragMoved = true;
        var view = ImportedView();
        var down = idx >= _selDragStart;                 // verso il basso = seleziona; verso l'alto = deseleziona
        var lo = Math.Min(idx, _selDragStart);
        var hi = Math.Max(idx, _selDragStart);
        for (var i = lo; i <= hi && i < view.Count; i++)
            if (down) _selSid.Add(view[i].Id); else _selSid.Remove(view[i].Id);
        _lastSelIdx = idx;
    }

    private void SelDragEnd()
    {
        if (_selDragActive && !_selDragMoved)            // click puro sulla riga d'avvio (nessun trascinamento)
        {
            var view = ImportedView();
            if (_selDragStart < view.Count)
            {
                if (_selDragMods && _lastSelIdx is int a && a >= 0 && a < view.Count)
                {
                    var lo = Math.Min(a, _selDragStart);
                    var hi = Math.Max(a, _selDragStart);
                    for (var i = lo; i <= hi; i++) _selSid.Add(view[i].Id);
                }
                else
                {
                    var id = view[_selDragStart].Id;
                    if (!_selSid.Remove(id)) _selSid.Add(id);
                    _lastSelIdx = _selDragStart;
                }
            }
        }
        _selDragActive = false;
    }

    private bool AllSelected(List<ImportedSidEdit> view) => view.Count > 0 && view.All(e => _selSid.Contains(e.Id));

    private void ToggleSelectAll(List<ImportedSidEdit> view)
    {
        if (AllSelected(view)) foreach (var e in view) _selSid.Remove(e.Id);
        else foreach (var e in view) _selSid.Add(e.Id);
        _lastSelIdx = null;
    }

    // Salva TUTTE le righe toccate (non le scelte). Chi fallisce resta modificato: sparire dal contatore
    // senza essere stata scritta è la stessa perdita di non averla mai provata.
    private Task SaveDirtyImported() => Guarded(async () =>
    {
        var targets = _imported.Where(e => _dirtySid.Contains(e.Id)).ToList();
        if (targets.Count == 0) return;
        var ok = 0;
        var failed = new List<string>();
        foreach (var e in targets)
        {
            try { await PersistImported(e); _dirtySid.Remove(e.Id); ok++; }
            catch (Exception ex)
            {
                failed.Add(e.Fix);
                Logger.LogWarning(ex, "Salvataggio SID importata fallito ({Icao} {Fix}).", _icao, e.Fix);
            }
        }
        _saveInfo = Plural(ok, "Ape_SidSavedN", ok)
            + (failed.Count > 0 ? Plural(failed.Count, "Ape_SidSaveFailedN", failed.Count) : "");
        _saveInfoWarn = failed.Count > 0;
        ProgrammaChiusuraInformativa();
    });

    // Pubblica subito (ForcePublished) le importate selezionate: stessa selezione del salvataggio in blocco.
    private Task PublishSelectedImported() => Guarded(async () =>
    {
        var targets = _imported.Where(e => _selSid.Contains(e.Id)).ToList();
        if (targets.Count == 0) return;
        foreach (var e in targets) { e.ForcePublished = true; await PersistImported(e); _dirtySid.Remove(e.Id); }
        _selSid.Clear();
        _lastSelIdx = null;
        _saveInfo = Plural(targets.Count, "Ape_SidPublishedN", targets.Count);
        _saveInfoWarn = false;
        ProgrammaChiusuraInformativa();
    });

    // --- Tabella manuali: filtro + clona riga ---
    private IEnumerable<SidEdit> ManualView()
    {
        var q = (_sidManualSearch ?? "").Trim();
        if (q.Length == 0) return _sids;
        return _sids.Where(s =>
            (s.Fix?.Contains(q, OIC) ?? false) || (s.Name?.Contains(q, OIC) ?? false) || (s.Runway?.Contains(q, OIC) ?? false));
    }

    private async Task CloneSid(SidEdit s)
    {
        var i = _sids.IndexOf(s);
        var copy = new SidEdit
        {
            Runway = s.Runway, Fix = s.Fix, Name = s.Name, Transition = s.Transition, InitialClimb = s.InitialClimb,
            InitialClimbByApp = s.InitialClimbByApp, Type = s.Type, Cat = s.Cat, Wtc = s.Wtc, Condition = s.Condition,
            Priority = s.Priority,
        };
        _sids.Insert(i < 0 ? _sids.Count : i + 1, copy);
        _sidManualSearch = "";   // rendi visibile la nuova riga anche se un filtro era attivo
        await MarkDirty("SID");
    }

    // Ciclo di prima pubblicazione automatica = ciclo successivo a quello di prelievo.
    private string NextCycleOf(string? sourceCycle)
    {
        if (string.IsNullOrWhiteSpace(sourceCycle)) return "—";
        try { return Airac.GetCycle(Airac.EffectiveUtcForCycle(sourceCycle).AddDays(28)); }
        catch (ArgumentException) { return "—"; }
    }

    // --- Release AIRAC (sezione «Versioni» via ReleasePanel). Prima di pubblicare rigenera il documento dalla bozza. ---
    // Callback passato a ReleasePanel: avvisa sulle sezioni non salvate, conferma, poi rigenera. false = annulla il publish.
    private async Task<bool> BeforePublishAsync()
    {
        if (_dirtySections.Count > 0 &&
            !await Confirm(string.Format(L["Ape_UnsavedPublishConfirm"].Value, string.Join(", ", _dirtySections.Select(PanelLabel)))))
            return false;
        if (!await Confirm(L["Ape_RebuildConfirm"].Value))
            return false;
        await Profile.RebuildDocumentAsync(_icao);
        return true;
    }

