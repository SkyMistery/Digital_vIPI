    private readonly Dictionary<int, int?> _secUpper = new();

    // ---- il motore condiviso: chi rende cosa, cosa è fisso, cosa si può congelare ----
    // Le tre risposte le dà il CATALOGO, per profilo (doc 13 §3a/§3b): qui non c'è nessun insieme scritto a mano.
    private static bool IsDerived(EditableSection s) =>
        s.Depth == 0 && SectionCatalog.IsHostRendered(SectionProfile.Airport, s.SectionKey);

    private static bool IsMandatory(EditableSection s) => SectionCatalog.IsFixed(SectionProfile.Airport, s.SectionKey);

    private static bool IsRenderModeToggleable(EditableSection s) => SectionCatalog.IsRenderModeToggleable(s.SectionKey);

