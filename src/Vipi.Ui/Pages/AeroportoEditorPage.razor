            /// <summary>Avvisi sulla tabella TL: fasce QNH sovrapposte e livello mancante.</summary>
        /// <summary>Avvisi sulle piste: ident duplicati (rompono i chip DEP/ARR delle regole).</summary>
        /// <summary>Avvisi sulle SID manuali: FIX/nome mancante, pista non tra quelle definite, righe duplicate.</summary>
        // ---- il corpo delle sezioni FISSE, reso da questa pagina ----
    // ⚠️ Un frammento per sezione, e il dispatch è una `switch` di sola ESPRESSIONE. Mettere la marcatura
    // dentro i rami di una `switch` non compila: il parser Razor conta le graffe del blocco e un `@{ … }`
    // dentro un `case` gliele sbilancia («RZ1006: the switch block is missing a closing "}"»). Ogni
    // frammento comincia invece con un elemento, quindi si legge come marcatura dal primo carattere.
    private RenderFragment DerivedSection(EditableSection s) => s.SectionKey switch
    {
        "weather" => WeatherNote,
        "runwayrules" => RulesEditor,
        "transition" => TransitionEditor,
        "frequencies" => FrequenciesEditor,
        "runways" => RunwaysEditor,
        "sids" => SidsEditor,
        "validity" => ValidityEditor,
        _ => _ => { },
    };

