    /// editor salvano a ogni gesto e non hanno nulla di sospeso da segnalare.</summary>
    private bool IsSectionDirty(EditableSection s) => _dirtySections.Contains(s.SectionKey);

    /// <summary>Etichetta leggibile di una chiave sporca, per il riepilogo del salvataggio in blocco.</summary>
