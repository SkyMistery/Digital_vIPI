        public string Parity = "";                                 // ""|"even"|"odd" (avanzate)
        public int? DateFromDay; public int? DateFromMonth;        // finestra stagionale ricorrente: giorno+mese, nessun anno (avanzate)
        public int? DateToDay; public int? DateToMonth;
    }
