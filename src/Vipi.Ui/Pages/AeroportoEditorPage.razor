@page "/services/vsop/{Acc}/airports/editor"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Content
@using Vipi.Application.Aor
@using Vipi.Application.Weather
@using Microsoft.AspNetCore.Components.Web
@using Vipi.Application.Auth
@using Vipi.Application.Abstractions
@using Vipi.Domain
@using RenderMode = Vipi.Domain.RenderMode
@inject IAirportEditingService Profile
@inject IEditingService Editing
@inject IAirportSectorService Sectors
@inject IEditAuthorizationService Authz
@inject IStationResolver Stations
@inject ISidImporter SidImporter
@inject ISidFixAliasRepository SidAliases
@inject INavaidSource Navaids
@inject Vipi.Domain.Services.IAiracService Airac
@inject IJSRuntime JS
@inject ILogger<AeroportoEditorPage> Logger
@implements IAsyncDisposable
@inject IDocRoutesRegistry DocRoutes
@inject IMilitaryDocumentService Militari
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Airspace.ISectorShapeResolver Forme
@inject EnglishStrings En

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Vle_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@L["Ape_EditorTitle"] @_icao · vIPI</PageTitle>
    @* Qui e non dentro una sezione: lo stesso elenco serve alla tabella delle SID importate e a quella delle
       manuali, e una sezione chiusa non renderebbe il suo contenuto. *@
    <NavaidDatalist Entries="_navaids.Entries" />
    <div class="wrap struct">
        <div class="breadcrumb">
            <a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> ›
            <a href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@_icao">@_icao</a> › <b>@En["Common_Editor"]</b>
        </div>

        @* ---- Testata in UNA riga: titolo · «?» · stato · lock · larghezza piena ----
           La STESSA degli altri tre editor (regola 8 e regola 1): la pill dice bozza/pubblicata con il numero
           di versione, il lock è uno STATO in riga e non una voce in fondo al rail. Il sottotitolo col nome
           dell'ACC non c'è: lo dice il pangrattato due righe sopra. *@
        <div class="editor-bar">
            <div class="doc-head st-head" style="margin:0">
                <h1 class="st-h2 page-h1">✎ @L["Ape_EditorTitle"] @_icao <MilitaryTag HasMilitaryPresence="_mil?.HasMilitaryPresence ?? false" IsMilitaryOnly="_mil?.IsMilitaryOnly ?? false" /></h1>
                <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_HelpAria"]" ExtraClass="wide">
                    @((MarkupString)L["Ape_HelpBody"].Value)
                </HelpHint>
                @if (_shell.Doc is not null)
                {
                    <span class="pill @(_shell.Doc.VersionStatus == DocumentStatus.Draft ? "grey" : "green")">
                        @(_shell.Doc.VersionStatus == DocumentStatus.Draft ? L["Ed_DraftVN", _shell.Doc.VersionNumber] : L["Ed_PublishedVN", _shell.Doc.VersionNumber])
                    </span>
                }
                @if (_shell.IsEditing)
                {
                    @* Il chip dice l'ORA, la frase intera sta nel `title`: a 1024 la testata andava a capo. *@
                    <span class="sh-chip ok" data-utc-title="@VipiTime.Iso(_shell.Lock.ExpiresUtc)" title="@(L["Lock_Editing"].Value + (_shell.Lock.ExpiresUtc is { } mt ? L["Lock_UntilSuffix", VipiTime.Z(mt)].Value : ""))">
                        🔒 @(_shell.Lock.ExpiresUtc is { } me ? L["Lock_EditingShort", VipiTime.Z(me)].Value : L["Lock_EditingNoTime"].Value)
                    </span>
                }
                else if (_shell.Lock is { Locked: true, IsMine: false })
                {
                    <span class="sh-chip warn" data-utc-title="@VipiTime.Iso(_shell.Lock.ExpiresUtc)" title="@(string.Format(L["Ed_LockedByOtherBody"].Value, _shell.Lock.ByName ?? L["Lock_AnotherEditor"].Value, _shell.Lock.ExpiresUtc is { } ot ? L["Lock_UntilSuffix", VipiTime.Z(ot)].Value : ""))">
                        🔒 @(_shell.Lock.ByName ?? L["Lock_AnotherEditor"].Value)@(_shell.Lock.ExpiresUtc is { } oe ? L["Lock_UntilSuffix", VipiTime.Z(oe)].Value : "")
                    </span>
                }
                @* ⤢ Larghezza piena: serve alle tabelle larghe (SID, settori). Stesse classi e chiavi degli altri. *@
                <button type="button" class="btn ghost st-head-end" @onclick="() => _wide = !_wide"
                        aria-pressed="@_wide.ToString().ToLowerInvariant()"
                        title="@(_wide ? L["Ed_NarrowTitle"] : L["Ed_WideTitle"])">@(_wide ? "⤡" : "⤢") @(_wide ? L["Ed_Narrow"] : L["Ed_Wide"])</button>
            </div>
        </div>

        @if (_data is not null)
        {
            <DocReviewBar DocumentId="_shell.DocumentId" OnResolved="LoadAsync" />

            @* Come si legge questo documento nell'altra lingua, e la correzione sul posto. Chiuso di suo: si
               apre quando serve, e chi scrive in italiano non ha ragione di vederlo tutti i giorni. *@
            @if (_shell.DocumentId is int docIdTraduzione)
            {
                <TranslationReviewPanel DocumentId="docIdTraduzione" />
            }

        }

        @if (_shell.Error is not null)
        {
            <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div style="flex:1">@_shell.Error</div><button class="btn ghost" style="padding:0 6px" @onclick="() => _shell.Error = null">✕</button></div>
        }

        @if (_data is null)
        {
            <div class="callout warning"><span class="cic">⚠️</span><div>@L["Ape_NotFound"]</div></div>
        }
        else if (_shell.Doc is null)
        {
            @* Documento non ancora nato e chi guarda non può farlo nascere: l'Ensure è ACC-gated. *@
            <div class="callout warning"><span class="cic">🔒</span><div>@(string.Format(L["Ape_ReadOnly"].Value, _data.AccCode))</div></div>
        }
        else
        {
            @if (!_canEdit)
            {
                <div class="callout warning"><span class="cic">🔒</span><div>@(string.Format(L["Ape_ReadOnly"].Value, _data.AccCode))</div></div>
            }

            @* ---- Le sezioni, dal DOCUMENTO ----
               Fino alla carta 2026-08-26 questo editor montava otto <details> scritti a mano, elencati in un
               array di stringhe italiane (`_panels`). Non era una scelta di stile: il documento d'aeroporto non
               AVEVA sezioni proprie — le cuoceva e le riconosceva per titolo — quindi non c'era niente da
               iterare. Ora c'è, ed è lo stesso motore condiviso degli altri tre editor: riordino con le frecce
               e col trascinamento nel menu, nascondi, sotto-sezioni, Live/Frozen, sezioni libere ovunque.

               ⚠️ Il corpo delle sezioni FISSE lo rende questa pagina (DerivedContent): sono i sei editor
               strutturati di sotto. Le sezioni libere passano dai blocchi, come nelle altre famiglie. *@
            <DocumentSectionsEditor Doc="_shell.Doc" IsEditing="_shell.IsEditing" Run="_shell.GuardAsync" OnChanged="LoadAsync"
                                    IsDerivedSection="IsDerived" DerivedContent="DerivedSection"
                                    IsMandatory="IsMandatory" Profile="SectionProfile.Airport"
                                    IsRenderModeToggleable="IsRenderModeToggleable"
                                    IsSectionDirty="IsSectionDirty"
                                    ShowToc="true" ExtraTocItems="_tocExtra" Wide="_wide"
                                    TocFooter="@TocCommands">
                <RightRail>
                    @if (_shell.Save == SaveState.Saving) { <span class="save-badge saving"><span class="spin"></span> @L["Ed_Saving"]</span> }
                    else if (_shell.Save == SaveState.Saved) { <span class="save-badge saved"><Icon Name="check-circle" Size="13" /> @L["Ed_Saved"]</span> }
                    @if (_canEdit)
                    {
                        @* Presente sempre, spento a zero: comparendo col contatore spostava in giù tutti i
                           comandi del rail proprio mentre ci si mirava. *@
                        <button class="btn primary" data-tour="save" disabled="@(_busy || _dirtySections.Count == 0)" @onclick="SaveAllClicked" title="@L["Ape_SaveAllTitle"]">
                            <Icon Name="check-circle" Size="14" /> @L["Ape_SaveAllN", _dirtySections.Count]
                        </button>
                        <HelpHint Href="/services/vsop/guide#editor-salva" AriaLabel="@L["Ape_SaveHelpAria"]">
                            @((MarkupString)L["Ape_SaveHelpBody"].Value)
                        </HelpHint>
                    }
                    <DraftPreviewLink Href="@(DocRoutes.For(ReleaseTargetType.Airport).DraftUrl(Acc.ToLowerInvariant(), _icao, null))" />
                    @* ---- Il ponte verso l'ALTRA edizione dello stesso scalo (carta vSOP militari §5-bis) ----
                       Su un campo con presenza militare il vSOP militare si crea DA QUI, dopo la vIPI civile:
                       è il punto in cui si è già, e l'unica alternativa era ricordarsi che esiste
                       /services/vsop/mil e cercarci dentro il proprio scalo.
                       ⚠️ Il tasto compare solo dove ha senso: niente presenza militare, niente tasto. E
                       «crea» solo a chi può editare — a chi guarda resta il collegamento, se il documento
                       c'è. *@
                    @if (_milState?.HasMilitaryPresence == true)
                    {
                        @if (_milState.MilDocumentId is not null)
                        {
                            <a class="btn ghost" href="@MilEditorUrl()"><Icon Name="book-open" Size="14" /> @L["Mil_OpenFromCivil"]</a>
                        }
                        else if (_canEdit)
                        {
                            <button class="btn ghost" disabled="@_busy" @onclick="CreaVsopMilitare" title="@L["Mil_CreateFromCivil"]">
                                <Icon Name="plus" Size="14" /> @L["Mil_CreateFromCivil"]
                            </button>
                        }
                    }
                    @* ✎ Modifica / ✓ Fine modifica: lo stesso gesto degli altri tre editor. Prende il lock e,
                       se la versione di lavoro è pubblicata, apre una bozza. *@
                    @if (_shell.IsEditing)
                    {
                        @* ⚠️ Non `FinishEditingAsync` diretto: prima si salva quel che è in sospeso.
                           Vedi FineModificaAsync. *@
                        <button class="btn ghost" disabled="@_busy" @onclick="FineModificaAsync">✓ @L["Lock_FinishEdit"]</button>
                    }
                    else if (_shell.Lock is { Locked: true, IsMine: false })
                    {
                        <button class="btn ghost" disabled title="@L["Ed_LockedByOther"]">✎ @L["Ed_Edit"]</button>
                    }
                    else
                    {
                        <button class="btn ghost" @onclick="() => _shell.StartEditingAsync(LoadAsync)">✎ @L["Ed_Edit"]</button>
                    }
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="Reimport" title="@L["Ape_ReimportIvaoTitle"]"><Icon Name="refresh" Size="14" /> @L["Ape_ReimportIvao"]</button>
                    @if (LastImport() is DateTime li)
                    {
                        <span class="ed-rail-meta" title="@L["Ape_LastImportTitle"]">↧ @($"{li:dd/MM HH:mm}Z")</span>
                    }
                </RightRail>
                @* ⚠️ Dentro la colonna centrale, non dopo il componente: qui sotto ci sono i due pannelli
                   che NON sono contenuto del documento — il catalogo dei settori e le release — e devono
                   essere larghi quanto le sezioni. Resi fuori da <DocumentSectionsEditor> finivano fuori
                   dalla griglia, quindi larghi quanto la pagina. *@
                <AfterSections>
                    @* ===================== SETTORI ATC =====================
                       ⚠️ NON è una sezione del documento: è amministrazione della struttura, non testo pubblicato.
                       Non passa quindi da `DocumentSectionsEditor` — non si riordina, non si nasconde, non finisce
                       nella vIPI pubblicata — ma sta nella sua STESSA colonna, e si aggancia all'indice come voce
                       extra, la strada che l'editor APP usa già per il pannello Release. *@
                    <div id="sec-settori" class="block">
                            <div class="section-title" style="margin-top:0">
                                <h2 class="h-sect" style="margin:0">@L["Ape_AtcSectors"] <span class="pill blue">@_sectors.Count</span></h2>
                                <HelpHint Href="/services/vsop/guide#editor-aeroporto" AriaLabel="@L["Ape_SectorsNoteAria"]" ExtraClass="wide">@L["Ape_SectorsNote"]</HelpHint><span class="ln"></span>
                                @if (LastImport() is DateTime lastImp)
                                {
                                    @* La "Z": il timbro è UTC. Senza, chi importa alle 17 locali legge 15:11 e crede
                                       che il bottone non abbia fatto nulla — è esattamente l'equivoco da cui è nata
                                       questa modifica. Stessa convenzione della vista live (orari in Z). *@
                                    <span class="muted" style="font-size:11.5px" title="@L["Ape_LastImportTitle"]">↧ @($"{lastImp:dd/MM/yyyy HH:mm}Z")</span>
                                }
                                <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="ImportSectors" title="@L["Ape_ImportSectorsTitle"]">⟳ @L["Ape_ImportSectors"]</button>
                                @if (_sectors.Any(s => (s.Position ?? "").Trim().ToUpperInvariant() == "TWR"))
                                {
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="ImportTwrShapes" title="@L["Ape_ImportTwrShapesTitle"]">⬡ @L["Ape_ImportTwrShapes"]</button>
                                }
                            </div>
                            @if (_sectors.Count == 0)
                            {
                                <p class="help">@L["Ape_NoSectors"]</p>
                            }
                            else
                            {
                                <table class="res-table">
                                    <thead><tr><th>Callsign</th><th>ACC</th><th>Pos</th><th>Mid</th><th title="@L["Ape_AccQTitle"]">ACC?</th><th>Freq</th><th>@L["Ape_PrimaryCol"]</th><th>Shape</th><th>@L["AccAdmin_LowerLimit"] <span class="muted" style="font-weight:400">(GND=0)</span></th><th>@L["AccAdmin_UpperLimit"] <span class="muted" style="font-weight:400">(UNL=@L["AccAdmin_Unlimited"])</span></th><th>@L["Common_State"]</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var s in _sectors)
                                        {
                                            var hasLimits = SupportsLimits(s.Position);
                                            <tr style="@(s.IsHidden ? "opacity:.5" : "")">
                                                <td><b>@s.ComposePosition</b></td>
                                                <td><span class="pill blue">@s.AccCode</span></td>
                                                <td>@(s.Position ?? "—")</td>
                                                <td>@(s.MiddleIdentifier ?? "—")</td>
                                                <td style="text-align:center">
                                                    @if (IsApp(s.Position))
                                                    {
                                                        <input type="checkbox" checked="@s.IsAccApp" disabled="@(_busy || !_canEdit)" @onchange="e => SetSectorAccApp(s.Id, (bool)(e.Value ?? false))" title="@L["Ape_AccAppTitle"]" />
                                                    }
                                                    else { <span class="muted">—</span> }
                                                </td>
                                                <td>@(s.Frequency ?? "—")</td>
                                                <td style="text-align:center">
                                                    @if (CanBePrimary(s.Position))
                                                    {
                                                        <input type="radio" name="primaryFreq-@((s.Position ?? "").Trim().ToUpperInvariant())" checked="@s.IsPrimary" disabled="@(_busy || !_canEdit)" @onchange="() => SetSectorPrimary(s.Id)" title="@L["Ape_PrimaryFreqTitle"]" />
                                                    }
                                                    else { <span class="muted">—</span> }
                                                </td>
                                                <td>@if (hasLimits) { <ShapeSourcePill Shape="@FormaDi(s.ComposePosition)" /> } else { <span class="muted">—</span> }</td>
                                                @if (hasLimits)
                                                {
                                                    @* ⚠️ Con la forma agganciata all'AIP le quote le portano i PEZZI: queste due caselle
                                                       restano quelle dell'anagrafica e non le usa nessuno finché l'aggancio dura. *@
                                                    <td class="@(Scavalcati(s.ComposePosition) ? "lim-overridden" : null)"
                                                        title="@(Scavalcati(s.ComposePosition) ? L["Shape_LimitsOverridden"].Value : null)">
                                                        <input style="width:70px" value="@FmtLower(_secLower.GetValueOrDefault(s.Id))" @onchange="e => LimiteDigitato(s.Id, () => _secLower[s.Id] = ParseLower(e.Value))" title="@L["AccAdmin_LowerHint"]" disabled="@(!_canEdit || s.LimitsFromSource)" />
                                                        @if (s.LimitsFromSource) { <span class="pill" style="background:var(--surface-muted);color:var(--ink-soft);margin-left:4px" title="@L["Ape_LimitsFromSourceTitle"]">🔒</span> }
                                                    </td>
                                                    <td class="@(Scavalcati(s.ComposePosition) ? "lim-overridden" : null)"
                                                        title="@(Scavalcati(s.ComposePosition) ? L["Shape_LimitsOverridden"].Value : null)">
                                                        <input style="width:70px" value="@FmtUpper(_secUpper.GetValueOrDefault(s.Id))" @onchange="e => LimiteDigitato(s.Id, () => _secUpper[s.Id] = ParseUpper(e.Value))" title="@L["AccAdmin_UpperHint"]" disabled="@(!_canEdit || s.LimitsFromSource)" /></td>
                                                }
                                                else
                                                {
                                                    <td class="muted">—</td>
                                                    <td class="muted">—</td>
                                                }
                                                <td>
                                                    @if (s.IsHidden)
                                                    {
                                                        <span class="pill neutral">@L["AccAdmin_Hidden"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pill green">@L["AccAdmin_Active"]</span>
                                                    }
                                                </td>
                                                <td style="white-space:nowrap">
                                                    @if (hasLimits && !s.LimitsFromSource)
                                                    {
                                                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => SaveSectorLimits(s.Id)" title="@L["AccAdmin_SaveLimits"]" aria-label="@L["AccAdmin_SaveLimits"]"><Icon Name="check-circle" /></button>
                                                    }
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => ToggleSectorHidden(s.Id, !s.IsHidden)" title="@L["AccAdmin_ToggleHide"]" aria-label="@L["AccAdmin_ToggleHide"]"><Icon Name="@(s.IsHidden ? "eye" : "eye-off")" /></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                    </div>
                    @* ===================== VERSIONI (release AIRAC) =====================
                       ⚠️ L'ancora `sec-versioni` è la stessa nei QUATTRO editor: è dove atterra «Ripubblica» dalla lista
                       «Da fare» (carta 2026-08-26-da-fare-una-lista-sola.md §3). *@
                    <div id="sec-versioni">
                        @if (!_canEdit)
                        {
                            <div class="block"><div class="callout warning" style="margin:0"><span class="cic">🔒</span><div>@(string.Format(L["Ape_ReadOnlyPublish"].Value, _icao))</div></div></div>
                        }
                        else
                        {
                            @* Involucro, titolo, aiuto, diff, annulla e anteprima li porta il pannello condiviso
                               (doc 13 §3i): prima questa pagina si costruiva il proprio contorno, ed era per questo
                               che la sezione «Versioni» dell'aeroporto non somigliava a quella degli altri tre.
                               Published ricarica tutto: BeforePublishAsync ha già avvisato sulle sezioni non salvate. *@
                            <ReleasePanel Target="ReleaseTargetType.Airport" Key="@_icao"
                                          ShowDiff="true" AllowCancel="Authz.IsEditor"
                                          BeforePublishAsync="BeforePublishAsync"
                                          PreviewUrlFactory="ReleasePreviewUrl"
                                          Published="LoadAsync" />
                        }
                    </div>
                </AfterSections>
            </DocumentSectionsEditor>
        }
    </div>

    @* Toast d'errore fisso: sempre visibile anche in fondo a tabelle lunghe (SID/Settori). Il successo è nel badge header. *@
    <div class="editor-toast">
        @if (_shell.Error is not null)
        {
            <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div style="flex:1">@_shell.Error</div><button class="btn ghost" style="padding:0 6px" @onclick="() => _shell.Error = null" title="@L["Common_Close"]">✕</button></div>
        }
        @if (_saveInfo is not null)
        {
            <div class="callout @(_saveInfoWarn ? "warning" : "success")"><span class="cic">@(_saveInfoWarn ? "⚠️" : "✓")</span><div style="flex:1">@_saveInfo</div><button class="btn ghost" style="padding:0 6px" @onclick="() => _saveInfo = null" title="@L["Common_Close"]">✕</button></div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }
    private AccInfo? _acc;
    private string _icao = "LIRF";
    // Anagrafica militare dello scalo, per l'etichetta in testata. Dal resolver, la cui mappa è già in cache
    // e scaldata dal layout: una testata non deve interrogare il database mentre si disegna.
    private Vipi.Application.Content.AirportStation? _mil;

    /// <summary>Anagrafica militare LETTA DAL DATABASE (non dalla cache delle stazioni): decide se questa
    /// pagina deve esistere per questo scalo, e se offre il ponte verso il vSOP militare.</summary>
    private AirportMilitaryState? _milState;
    private string? _loadedIcao;
    /// <summary>Chiavi di SEZIONE con modifiche non salvate (la pagina è a scroll unico e ogni sezione ha il suo
    /// «Salva»). Erano nomi italiani di pannello — «Regole piste», «Quote transizione» —: un secondo vocabolario
    /// accanto a quello del catalogo, per indicare le stesse cose.</summary>
    private readonly HashSet<string> _dirtySections = new();

    /// <summary>
    /// I settori di cui sono stati digitati dei limiti e non ancora salvati (il ✓ è per RIGA).
    ///
    /// <para>⚠️ Prima il pannello si marcava sporco con un <c>@onchange</c> sul contenitore, e <b>nessuno lo
    /// puliva mai</b>: bastava toccare un interruttore che salva da sé — nascondi, primario — perché la
    /// guardia del browser restasse accesa per il resto della sessione, e la pagina chiedesse «vuoi
    /// davvero uscire?» con tutto salvato. Un avviso che si accende sempre è un avviso che si impara a
    /// ignorare. Ora la marcatura è sui DUE campi che si compilano, e si spegne quando la riga si salva.</para>
    /// </summary>
    private readonly HashSet<int> _dirtyLimiti = new();

    private DotNetObjectReference<AeroportoEditorPage>? _selfRef;
    private AirportData? _data;
    private IReadOnlyList<LinkableFrequencyRow> _linkable = Array.Empty<LinkableFrequencyRow>();

    // ---- documento, lock, bozza: lo stesso workflow degli altri tre editor (carta 2026-08-26 §1b) ----
    // Non è una scelta di stile: le mutazioni del motore condiviso passano da IEditingService, che pretende il
    // lock. ⚠️ Sotto lock c'è il DOCUMENTO — sezioni, ordine, nascondi, Live/Frozen, blocchi. I dati
    // strutturati (regole, TA/TL, piste, SID, link, limiti settori) restano a salvataggio diretto ACC-gated:
    // li scrivono anche i servizi d'import che girano in background, e quelli un lock non possono prenderlo.
    private bool _canEdit;
    private bool _busy;

    /// <summary>Il guscio comune dei quattro editor (doc 14 §3d): documento, modifica, errore, lock, badge di
    /// salvataggio, e i gesti che li muovono. Qui resta ciò che è solo dell'aeroporto — in particolare il
    /// «Salva tutto» sulle sezioni sporche, che è l'unico modello di salvataggio diverso dei quattro.</summary>
    private DocumentEditorShell _shell = default!;

    protected override void OnInitialized() =>
        _shell = new DocumentEditorShell(Editing, JS, L, Logger, "aeroporto", "Ape_NoEditPerm",
            () => InvokeAsync(StateHasChanged));

    private ImportPolicySnapshot _policy = ImportPolicySnapshot.AllImported;
    private int? _ta;
    private List<TlEdit> _tls = new();
    private List<RwEdit> _rwys = new();
    private List<RuleEdit> _rules = new();
    /// <summary>
    /// Il catalogo dei punti della divisione: suggerisce i nomi nei campi FIX/Transition e dice quali non
    /// esistono. Vuoto finché non arriva (e per sempre, se la sorgente non risponde): in quel caso i campi
    /// restano scrivibili come prima e non si segnala nulla — vedi <see cref="NavaidCheck"/>.
    /// </summary>
    private NavaidCatalog _navaids = NavaidCatalog.Empty;

    private List<SidEdit> _sids = new();
