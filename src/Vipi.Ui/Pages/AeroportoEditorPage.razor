    // Espande/comprime tutte le sezioni <details> (lato JS: niente stato C# da sincronizzare col toggle del browser).
        protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _icao = string.IsNullOrWhiteSpace(Icao) ? "LIRF" : Icao.ToUpperInvariant();
        _mil = Stations.Airport(_icao);

        // Ricarica i buffer solo quando cambia l'aeroporto.
        if (_loadedIcao != _icao)
        {
            _dirtySections.Clear();
            _dirtyLimiti.Clear();
            _loadedIcao = _icao;
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vipiAirportEditorInit", _selfRef);
            _shell.JsReady = true;
            await LoadNavaidsAsync();
        }
    }

    /// <summary>
    /// Carica il catalogo dei punti DOPO il primo disegno, non prima: è una discesa da GitHub con quindici
    /// secondi di timeout, e metterla in apertura significherebbe una pagina bianca quando la sorgente è lenta.
    /// Dal secondo aeroporto in poi la risposta è già in cache di processo.
    /// </summary>
    private async Task LoadNavaidsAsync()
    {
        try
        {
            _navaids = await Navaids.GetAsync();
            if (_navaids.Entries.Count > 0) StateHasChanged();
        }
        catch (Exception ex)
        {
            // La sorgente muta non è un errore dell'editor: si perdono i suggerimenti, non si blocca la modifica.
            Logger.LogWarning(ex, "Catalogo punti non disponibile: i campi punto restano senza suggerimenti.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        // I due badge che si spengono da soli: fermarli PRIMA di tutto il resto, o restano in volo su un
        // renderer che sta sparendo.
        _shell.Dispose();
        _dismissInfo.Dispose();
        _selfRef?.Dispose();
        // Rilascia la guardia beforeunload lasciando la pagina. Salta se il render interattivo non è mai avvenuto
        // (dispose durante il prerender statico → JS interop illecito, InvalidOperationException). Il circuito può
        // anche essere già chiuso (navigazione/refresh): ignora JSDisconnectedException.
        if (!_shell.JsReady) return;
        try { await JS.InvokeVoidAsync("vipiSetDirty", false); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    // --- Stato "sporco" per sezione (scroll unico): la guardia beforeunload è attiva se c'è qualcosa da salvare ---

    /// <summary>
    /// C'è qualcosa che il server non ha ancora: una sezione in blocco, dei limiti di settore digitati, o delle
    /// righe SID importate e non salvate.
    ///
    /// <para>⚠️ <b>I buffer sono TRE, non uno.</b> Fino al 30 agosto 2026 la guardia guardava le sole sezioni:
    /// chi correggeva delle SID importate e chiudeva la scheda le perdeva <b>senza il prompt del browser</b> —
    /// il conteggio c'era (<c>_sidNonSalvate</c>) ma non accendeva niente. Una guardia che copre due terzi di
    /// quel che protegge è peggio di nessuna guardia, perché la si crede accesa.</para>
    /// </summary>
    private bool CeQualcosaDaSalvare => _dirtySections.Count > 0 || _dirtyLimiti.Count > 0 || _sidNonSalvate > 0;

    /// <summary>Accende o spegne la guardia del browser secondo <see cref="CeQualcosaDaSalvare"/>. È l'UNICA
    /// porta: chi cambia uno dei tre buffer chiama questa, e non decide da sé.</summary>
    private async Task AggiornaGuardiaAsync()
    {
        if (!_shell.JsReady) return;
        try { await JS.InvokeVoidAsync("vipiSetDirty", CeQualcosaDaSalvare); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task MarkDirty(string section)
    {
        _dirtySections.Add(section);
        await AggiornaGuardiaAsync();
    }

    private async Task ClearDirty(string section)
    {
        _dirtySections.Remove(section);
        await AggiornaGuardiaAsync();
    }

    /// <summary>Il conteggio delle SID importate non salvate, che lo tiene <c>AirportSidsEditor</c>.</summary>
    private async Task SidNonSalvateAsync(int quante)
    {
        _sidNonSalvate = quante;
        await AggiornaGuardiaAsync();
    }

    private async Task<bool> Confirm(string message) => await JS.InvokeAsync<bool>("confirm", message);

    // --- Aggiunte/rimozioni con marcatura dirty per-sezione (rimozioni con conferma) ---
                // Il segno di «punto che il catalogo non conosce»: tinge il CAMPO invece di aggiungergli accanto un'icona.
    // La colonna del fix è larga 76px misurati e un'icona ne prenderebbe quattordici — cioè la quinta lettera
    // dei nomi, che è dove stanno i 5/6 dei fix veri. Sul tabellone delle importate questo segno NON c'è: là il
    // ⚠ di `NeedsFixReview` dice già la stessa cosa, e misurando l'archivio le due condizioni coincidono riga
    // per riga (332 su 332). Due segni per un fatto solo sono un segno di troppo.
        // Ctrl/Cmd+S da JS o bottone «Salva tutto»: salva TUTTE le sezioni sporche valide (scroll unico).
    // «Settori» salva per riga (fuori dal blocco). Al termine mostra il riepilogo salvate/saltate.
    [JSInvokable]
    public async Task SaveAllDirty() => await SaveAllClicked();

    private async Task SaveAllClicked()
    {
        if (_busy || !_canEdit) return;
        var saved = new List<string>();
        var skipped = new List<string>();
        foreach (var s in _dirtySections.ToList())
        {
            // Blocchi di validazione: non salvare e segnalare come saltata.
            // ⚠️ Stessa regola del tasto dentro la sezione: con un errore aperto non si salva. La domanda la
                // fa il cuore condiviso, non una copia (doc 14 §3g).
                if (s == "runwayrules" && AirportRuleValidation.Issues(_rules, RwIdents()).Errors.Count > 0) { skipped.Add(s); continue; }

            Func<Task>? save = s switch
            {
                "runwayrules" => SaveRules,
                "transition" => SaveTls,
                "frequencies" => SaveLinks,
                "runways" => SaveRwys,
                "sids" => SaveSids,
                _ => null,
            };
            if (save is null) continue;
            await save();
            // SaveSection pulisce il dirty solo a successo: se è ancora sporca, il salvataggio è fallito (errore già a video).
            if (_dirtySections.Contains(s)) skipped.Add(s); else saved.Add(s);
        }
        ShowSaveSummary(saved, skipped);
    }

    /// <summary>
    /// «Fine modifica»: <b>salva quel che è in sospeso</b>, e solo dopo molla il lock.
    ///
    /// <para>⚠️ Prima usciva e basta. Il lock se ne andava, i pannelli tornavano in sola lettura e i valori
    /// digitati restavano <b>a schermo, non salvabili</b> — «Salva tutto» spento perché non si tiene più il
    /// lock — per sparire al primo ricarico. Non dava nessun errore: dava una pagina che tornava com'era.</para>
    ///
    /// <para>⚠️ <b>I buffer sono tre</b> e vanno tutti e tre: le sezioni in blocco, i limiti di settore (che si
    /// salvano per RIGA) e le SID importate (che le possiede il loro editor). Salvarne due su tre lascerebbe
    /// il terzo a perdersi, con l'aggravante che adesso l'utente si fida.</para>
    ///
    /// <para>⚠️ <b>Se qualcosa non passa, NON si esce.</b> Una sezione con un errore di validazione non si
    /// salva — è la regola del tasto «Salva tutto», non un'invenzione di qui — e uscire lo stesso vorrebbe dire
    /// buttarla via dopo aver detto che si salvava. Il riepilogo dice già che cosa è rimasto indietro.</para>
    /// </summary>
    private async Task FineModificaAsync()
    {
        if (_busy) return;

        if (_dirtySections.Count > 0) await SaveAllClicked();
        foreach (var id in _dirtyLimiti.ToList()) await SaveSectorLimits(id);
        if (_editorSid is not null) await _editorSid.SalvaSporcheAsync();

        if (CeQualcosaDaSalvare)
        {
            // Il perché sta già nel riepilogo di SaveAllClicked quando è lui ad aver saltato qualcosa; se il
            // resto è altrove (limiti o SID) lo si dice qui, o la pressione sul tasto sembrerebbe non aver
            // fatto niente.
            if (_saveInfo is null)
            {
                _saveInfo = L["Ape_ExitBlocked"].Value;
                _saveInfoWarn = true;
                ProgrammaChiusuraInformativa();
            }
            return;
        }

        await _shell.FinishEditingAsync();
    }

    private void ShowSaveSummary(List<string> saved, List<string> skipped)
    {
        if (saved.Count == 0 && skipped.Count == 0) return;
        var parts = new List<string>();
        if (saved.Count > 0) parts.Add($"Salvate: {string.Join(", ", saved.Select(DirtyLabel))}");
        if (skipped.Count > 0) parts.Add($"non salvate (errori): {string.Join(", ", skipped.Select(DirtyLabel))}");
        _saveInfo = string.Join(" · ", parts);
        _saveInfoWarn = skipped.Count > 0;
        ProgrammaChiusuraInformativa();
    }


    // Ultimo import dei settori da IVAO (il più recente del catalogo); null se mai importati.
    private DateTime? LastImport() => _sectors.Count == 0 ? null : _sectors.Max(s => s.ImportedAtUtc);

    // --- Tester regole (Prova vento): mappa i buffer correnti in DTO e valuta senza salvare ---
            // --- DnD riordino regole: enter riordina live, drop marca dirty ---
            private async Task LoadAsync()
    {
        _shell.Error = null;
        // Reload totale = i buffer tornano allo stato server: non c'è più niente di "sporco".
        _dirtySections.Clear();
        _dirtyLimiti.Clear();
        _sidNonSalvate = 0;
        await AggiornaGuardiaAsync();
        try
        {
            _data = await Profile.LoadForEditAsync(_icao);
            _canEdit = _data is not null;
        }
        catch (EditNotAllowedException)
        {
            _data = await Profile.LoadForViewAsync(_icao);
            _canEdit = false;
        }
        if (_data is null) return;

        _linkable = await Profile.ListLinkableFrequenciesAsync();
        _policy = await Profile.GetImportPolicyAsync();
        _ta = _data.TransitionAltitudeFt;
        _tls = _data.TransitionLevels.Select(t => new TlEdit { Id = t.Id, From = t.QnhFrom, To = t.QnhTo, Level = t.Level }).ToList();
        _rwys = _data.Runways.Select(r => new RwEdit
        {
            Id = r.Id, Ident = r.Ident, LengthM = r.LengthM, Bearing = r.Bearing,
            Tora = r.ToraM, Lda = r.LdaM, App = r.AppProcedures, Patterns = r.Patterns, Circling = r.Circling,
        }).ToList();
        _rules = _data.Rules.Select(r => new RuleEdit
        {
            Name = r.Name,
            Dep = SplitCsv(r.DepRunways), Arr = SplitCsv(r.ArrRunways), Note = r.Note,
            MaxTail = r.MaxTailwindKt, MaxCross = r.MaxCrosswindKt,
            Surface = r.Surface switch { RunwaySurface.Dry => "dry", RunwaySurface.Wet => "wet", _ => "any" },
            TimeFrom = MinToTime(r.TimeFromLocalMin), TimeTo = MinToTime(r.TimeToLocalMin),
            DaysMask = r.DaysOfWeekMask ?? 0,
            Parity = r.DateParity switch { DateParity.Even => "even", DateParity.Odd => "odd", _ => "" },
            DateFromDay = MdDay(r.DateFromMonthDay), DateFromMonth = MdMonth(r.DateFromMonthDay),
            DateToDay = MdDay(r.DateToMonthDay), DateToMonth = MdMonth(r.DateToMonthDay),
        }).ToList();
        var cyc = Airac.GetCycle(DateTime.UtcNow);
        _sids = _data.Sids.Where(s => !s.IsImported).Select(s => new SidEdit
        {
            Runway = s.Runway, Fix = s.Fix, Name = s.Name, Transition = s.Transition, InitialClimb = s.InitialClimb,
            InitialClimbByApp = s.InitialClimbByApp, Type = s.Type, Cat = s.Cat, Wtc = s.Wtc, Condition = s.Condition,
            Priority = s.Priority, IsPublicNow = s.IsPublicAt(cyc, Airac), PublishFromCycle = NextCycleOf(s.SourceAiracCycle),
        }).ToList();
        _imported = _data.Sids.Where(s => s.IsImported)
            .OrderBy(s => s.Fix).ThenBy(s => s.Priority ?? int.MaxValue).ThenBy(s => s.Name)
            .Select(s => new ImportedSidEdit
            {
                Id = s.Id, Fix = s.Fix, Name = s.Name, Runway = s.Runway, Transition = s.Transition, Type = s.Type,
                Priority = s.Priority, ForcePublished = s.ForcePublished, NeedsReview = s.NeedsFixReview,
                IsPublicNow = s.IsPublicAt(cyc, Airac), PublishFromCycle = NextCycleOf(s.SourceAiracCycle),
                InitialClimb = s.InitialClimb, InitialClimbByApp = s.InitialClimbByApp, Cat = s.Cat, Wtc = s.Wtc, Condition = s.Condition,
            }).ToList();
        // ⚠️ La selezione e le righe non salvate NON si azzerano qui: le possiede <AirportSidsEditor>, che
        // se ne accorge da sé quando i buffer cambiano (doc 14 §3g).
        _linkIds = _data.Links.Select(l => l.SourceSectorId).ToList();

        _sectors = await Sectors.ListByAirportAsync(_icao);
        _secLower.Clear(); _secUpper.Clear();
        foreach (var s in _sectors) { _secLower[s.Id] = s.LowerLimit; _secUpper[s.Id] = s.UpperLimit; }
        // Da dove viene la forma di ognuno: UNA domanda per tutta la tabella, in sequenza col resto del
        // caricamento (il DbContext del circuito è uno solo).
        _formeSettori = await Forme.ResolveAsync(_sectors.Select(x => x.ComposePosition).ToList());

        // ---- l'edizione giusta per questo scalo (carta vSOP militari §5-bis) ----
        // ⚠️ Si legge dal DATABASE e non da `Stations.Airport` (che è la cache di circuito usata per
        // l'etichetta in testata): qui la risposta decide se restare o andarsene, e una risposta vecchia di
        // ore manderebbe qualcuno a scrivere nel documento sbagliato.
        _milState = await Profile.GetMilitaryStateAsync(_icao);

        // Campo SOLO militare e nessuna vIPI civile: l'edizione è un'altra. Si va lì invece di aprire un
        // editor che non potrebbe far nascere niente (`EnsureDocumentAsync` lo rifiuterebbe), lasciando a
        // schermo un errore che non spiega dove andare.
        if (_milState is { IsMilitaryOnly: true, DocumentId: null } && MilEditorUrl() is { } milUrl)
        {
            Nav.NavigateTo(milUrl, forceLoad: true);
            return;
        }

        // ---- il documento ----
        // ⚠️ Ensure e NON «se manca crealo» scritto qui: garantisce il documento e le sue sezioni di catalogo in
        // un colpo solo, ed è idempotente. È ACC-gated, quindi solo chi può editare lo fa nascere; a chi guarda
        // in sola lettura il documento serve già esistente, e se non c'è la pagina lo dice.
        if (_canEdit) _shell.DocumentId = await Profile.EnsureDocumentAsync(_icao);
        else _shell.DocumentId = await Profile.GetDocumentIdAsync(_icao);

        if (_shell.DocumentId is int docId)
        {
            try
            {
                _shell.Doc = await Editing.LoadForEditAsync(docId);
                _shell.Lock = await Editing.InspectLockAsync(docId);
            }
            catch (EditNotAllowedException) { _shell.Doc = null; }
            // Il lock può essere scaduto o preso da un altro mentre si stava qui: la modifica finisce con lui.
            _shell.IsEditing = _shell.IsEditing && _shell.Doc?.IsEditable == true && _shell.Lock.IsMine;
        }
    }

    /// <summary>L'indirizzo dell'editor del vSOP militare di questo scalo. Dal registry, non scritto a mano:
    /// è la stessa rotta che usano l'elenco militare e «Nuovo documento».</summary>
    private string? MilEditorUrl() =>
        DocRoutes.For(ReleaseTargetType.AirportMil).EditorUrl(Acc.ToLowerInvariant(), _icao, null, null);

    /// <summary>
    /// Crea il vSOP militare di questo scalo e ci porta. ⚠️ La guardia («prima la vIPI civile») sta nel
    /// SERVIZIO: qui si mostra soltanto il suo rifiuto, che è già scritto per essere letto da una persona.
    /// </summary>
    private async Task CreaVsopMilitare()
    {
        _busy = true;
        _shell.Error = null;
        try
        {
            await Militari.CreaAsync(_icao);
            if (MilEditorUrl() is { } url) Nav.NavigateTo(url, forceLoad: true);
        }
        catch (ValidationException ex) { _shell.Error = ex.Message; }
        catch (EditNotAllowedException ex) { _shell.Error = ex.Message; }
        finally { _busy = false; }
    }

    // ---- bozza e lock: lo stesso gesto degli altri tre editor ----
        /// <summary>Rilascia il lock subito, così il documento è libero per gli altri senza aspettare il TTL.</summary>
        /// <summary>Guardia passata come <c>Run=</c> al motore condiviso: mostra il badge di salvataggio e cattura
    /// gli errori. Firma a un parametro perché è quella che <c>DocumentSectionsEditor</c> si aspetta.</summary>

            // Combobox enti: click su una voce = aggiunge il link; il campo di ricerca resta pronto per il prossimo.
        private Task SaveTa() => Guarded(() => Profile.SetTransitionAltitudeAsync(_icao, _ta));
    private Task SaveTls() => SaveSection("transition", () => Profile.SaveTransitionLevelsAsync(_icao,
        _tls.Select(t => new TlRow(t.Id, t.From, t.To, t.Level ?? "")).ToList()));
    private Task SaveRwys() => SaveSection("runways", () => Profile.SaveRunwaysAsync(_icao,
        _rwys.Select(r => new RunwayRow(r.Id, r.Ident ?? "", r.LengthM, r.Bearing, r.Tora, r.Lda, r.App, r.Patterns, r.Circling)).ToList()));
    private Task SaveRules() => SaveSection("runwayrules", () => Profile.SaveRunwayRulesAsync(_icao,
        _rules.Select(AirportRuleMapping.ToRow).ToList()));
    private Task SaveSids() => SaveSection("sids", () => Profile.SaveSidsAsync(_icao,
        _sids.Select(s => new SidRow(0, s.Runway, s.Fix ?? "", s.Name ?? "", s.Transition, s.InitialClimb, s.Type,
            s.Cat, s.Wtc, s.Condition, Priority: s.Priority, InitialClimbByApp: s.InitialClimbByApp)).ToList()));
    private Task SaveLinks() => SaveSection("frequencies", () => Profile.SaveFrequencyLinksAsync(_icao, _linkIds.ToList()));

    /// <summary>«Re-import from IVAO»: tutto quello che l'aeroporto prende dalla sorgente, in un colpo —
    /// piste + Transition Altitude (secondo la policy «Sorgenti dati») E catalogo settori. Prima faceva solo
    /// le prime due e non lasciava traccia: il ↧ accanto al bottone è la data d'import dei SETTORI, quindi
    /// non si muoveva mai e sembrava che il bottone non facesse niente. L'esito ora è scritto nel callout.</summary>
    private async Task Reimport()
    {
        // ⚠️ Il reimport riscrive anche le SID: chi ha righe importate non salvate le perderebbe. Il
        // conteggio lo tiene <AirportSidsEditor>, che è chi possiede quello stato, e ce lo comunica.
        if (_sidNonSalvate > 0
            && !await Confirm(Plural(_sidNonSalvate, "Ape_SidDiscardConfirm", _sidNonSalvate)))
            return;
        if (!await Confirm(L["Ape_ReimportConfirm"].Value))
            return;

        AirportSectorImportResult? sectors = null;
        var ok = await Guarded(async () =>
        {
            await Profile.ReimportFromSourceAsync(_icao);
            sectors = await Sectors.ImportFromSourceAsync(_icao);
        });
        if (!ok) return;

        await LoadAsync();
        _saveInfo = L["Ape_ReimportDone", _rwys.Count, sectors?.Created ?? 0, sectors?.Updated ?? 0].Value;
        _saveInfoWarn = false;
        ProgrammaChiusuraInformativa();
    }

    // --- Import SID dal sectorfile: rimpiazza le importate, preserva manuali/priorità/forzatura ---
    // ImportForCurrentUserAsync e non ImportAsync: quest'ultimo è l'ingresso del job periodico, che gira
    // senza utente e quindi senza controllo di autorizzazione. Vedi ISidImporter.
    // ⚠️ Ricarica i buffer dal DB: le righe toccate e non salvate sparirebbero in silenzio. Prima si chiede.
    private async Task ReimportSids()
    {
        if (await Guarded(() => SidImporter.ImportForCurrentUserAsync(_icao))) await LoadAsync();
    }

    // «Salvate 1 SID» è il genere di dettaglio che fa sembrare la pagina scritta da nessuno: le chiavi con un
    // contatore hanno la loro forma singolare, con lo stesso nome più «One».
    private string Plural(int n, string key, params object[] args) => L[n == 1 ? key + "One" : key, args].Value;

    private async Task PersistImported(ImportedSidEdit e)
    {
        string? resolvedFix = null;
        if (e.NeedsReview && !string.IsNullOrWhiteSpace(e.FixOverride))
        {
            resolvedFix = e.FixOverride!.Trim();
            if (e.CreateAlias) await SidAliases.UpsertAsync(e.Fix, resolvedFix);   // e.Fix = prefisso grezzo
        }
        await Profile.UpdateImportedSidAsync(_icao, e.Id, e.Priority, e.ForcePublished, resolvedFix,
            e.InitialClimb, e.InitialClimbByApp, e.Cat, e.Wtc, e.Condition);
        e.IsPublicNow = e.IsPublicNow || e.ForcePublished;   // riflette subito la forzatura senza reload totale
    }

    // --- Arricchimenti multi-select su SID importate: CAT per VREF, WTC per scia; salvati come CSV nell'ordine canonico ---
        // Toggle di un token; ricompone la CSV nell'ordine canonico (order) così la resa è stabile a prescindere dai click.
    // Ogni modifica a una riga importata la auto-seleziona: così "Salva selezionate" raccoglie tutte le righe toccate.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // Chip Cat./WTC: clic = solo questo, doppio clic o Shift+clic = anche i precedenti
    //
    // Una procedura per categoria E vale anche per le più piccole, e quasi sempre si accendono a scala.
    // ⚠️ Il doppio clic del browser arriva DOPO due clic singoli: i due toggle si annullano fra loro, quindi
    // quando `TokScale` parte lo stato è quello di partenza e la regola si applica su quello giusto. Si vede
    // un lampeggio del chip: toglierlo vorrebbe dire ritardare ogni clic singolo di un quarto di secondo, e
    // qui di clic se ne fanno a centinaia.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // Shift+clic (e Shift+Invio, che il browser consegna come clic con lo shift premuto) fa quello che fa il
    // doppio clic: è la via da tastiera, e i chip sono già bottoni raggiungibili con Tab.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // Scelta di gruppo: tutte le righe con lo stesso punto o la stessa transition
    //
    // Le varianti per pista e transizione della stessa procedura sono un gruppo naturale (su LIRF «NENIG»
    // sono nove righe): sceglierle una per una prima di «Pubblica scelte» è lavoro inutile. Agisce su ciò che
    // è A SCHERMO: scegliere righe nascoste da un filtro sarebbe una sorpresa, non una comodità.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // I due gesti valgono anche dai tasti della barra, che agiscono sulla riga del campo toccato per ultimo:
    // il doppio clic è una scorciatoia, non l'unico modo di arrivarci.
    // ──────────────────────────────────────────────────────────────────────────────────────────────
    // «Applica alle scelte»: copia il valore della cella toccata per ultimo nelle righe scelte
    //
    // L'unità è la CELLA, non il campo: la quota porta con sé il tasto APP (sono la stessa informazione), e
    // Cat./WTC copiano il gruppo intero di chip. Fix, nome, pista e transition non si propagano mai: sono
    // l'identità della riga. Si scrive nei buffer, quindi le righe restano «modificate» e un errore si annulla
    // ricaricando la pagina senza salvare.
    // ──────────────────────────────────────────────────────────────────────────────────────────────

    // --- Tabella manuali: filtro + clona riga ---
    // Ciclo di prima pubblicazione automatica = ciclo successivo a quello di prelievo.
    private string NextCycleOf(string? sourceCycle)
    {
        if (string.IsNullOrWhiteSpace(sourceCycle)) return "—";
        try { return Airac.GetCycle(Airac.EffectiveUtcForCycle(sourceCycle).AddDays(28)); }
        catch (ArgumentException) { return "—"; }
    }

    // --- Release AIRAC (pannello «Versioni»). Callback di ReleasePanel: false = annulla il publish. ---
    private async Task<bool> BeforePublishAsync()
    {
        // ⚠️ Resta solo l'avviso sulle sezioni non salvate. La conferma «rigenero il documento?» è caduta con
        // la cosa che annunciava: non c'è più niente da rigenerare — le sezioni fisse non hanno un corpo cotto
        // da riscrivere, e la pubblicazione congela la derivazione di adesso.
        return _dirtySections.Count == 0
            || await Confirm(string.Format(L["Ape_UnsavedPublishConfirm"].Value, string.Join(", ", _dirtySections.Select(DirtyLabel))));
    }

