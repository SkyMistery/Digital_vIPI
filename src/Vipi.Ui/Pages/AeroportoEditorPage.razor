@page "/vsop/{Acc}/airports/editor"
@page "/vsop/{Acc}/aeroporto/editor"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Content
@using Vipi.Application.Aor
@using Vipi.Application.Auth
@using Vipi.Application.Abstractions
@using Vipi.Domain
@inject IAirportEditingService Profile
@inject IAirportSectorService Sectors
@inject IReleaseService Releases
@inject IEditAuthorizationService Authz
@inject IStationResolver Stations
@inject ISidImporter SidImporter
@inject ISidFixAliasRepository SidAliases
@inject Vipi.Domain.Services.IAiracService Airac
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else
{
    <PageTitle>Editor aeroporto @_icao · vIPI</PageTitle>
    <div class="wrap struct">
        <div class="breadcrumb">
            <a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> ›
            <a href="/vsop/@Acc.ToLowerInvariant()/airports?icao=@_icao">@_icao</a> › <b>Editor</b>
        </div>

        <div class="doc-head">
            <div><h2 style="margin-bottom:2px">✎ Editor aeroporto @_icao</h2><span class="muted">@_acc.Name</span></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/airports?icao=@_icao&as=draft" target="_blank" rel="noopener" title="Apri la bozza live in una nuova scheda (non la versione pubblica)">👁 Anteprima bozza</a>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="Reimport">↻ Re-importa da IVAO</button>
            </div>
        </div>

        @if (_data is null)
        {
            <div class="callout warning"><span class="cic">⚠️</span><div>Aeroporto non trovato o nessun profilo. Genera prima il documento da «Gestione aeroporti».</div></div>
        }
        else
        {
            @if (!_canEdit)
            {
                <div class="callout warning"><span class="cic">🔒</span><div>Sola lettura: non hai i permessi per editare la ACC @_data.AccCode.</div></div>
            }

            <div class="wx-tabs" style="margin:10px 0 16px">
                @foreach (var p in _panels)
                {
                    <button class="wx-tab @(_panel == p ? "on" : "")" @onclick="() => SelectPanel(p)">@p@if (_dirtyPanel == p) { <span class="dirt" title="Modifiche non salvate"></span> }</button>
                }
            </div>

            @* ===================== REGOLE PISTE ===================== *@
            @if (_panel == "Regole piste")
            {
                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">Regole scelta pista</h3>
                    <p class="help">Ogni regola: quando le piste indicate hanno <b>vento in coda ≤</b> la soglia, <b>traverso ≤</b> la soglia (opzionale) e la <b>superficie</b> corrisponde, diventano preferenziali per partenze/arrivi. Coda e traverso si calcolano dal vento corrente. Si valutano in <b>ordine</b>: la prima che si applica vince (metti le più specifiche in alto). Se nessuna si applica, vale la pista con miglior vento di testa.</p>
                    <p class="help" style="margin-top:-4px">I chip DEP/ARR elencano le piste del pannello «Piste» in memoria: una pista appena aggiunta lì compare subito, ma diventa definitiva solo dopo «Salva piste».</p>

                    @{ var issues = RuleIssues(); }
                    @if (issues.Errors.Count > 0)
                    {
                        <div class="callout danger"><span class="cic">⛔</span><div>@foreach (var m in issues.Errors) { <div>@m</div> }</div></div>
                    }
                    @if (issues.Warnings.Count > 0)
                    {
                        <div class="callout warning"><span class="cic">⚠️</span><div>@foreach (var m in issues.Warnings) { <div>@m</div> }</div></div>
                    }

                    @foreach (var (r, idx) in _rules.Select((r, i) => (r, i)))
                    {
                        <div class="rule-card" @key="r">
                            <div class="rule-head">
                                <span class="rule-ord">#@(idx + 1)</span>
                                <div style="display:flex;gap:6px">
                                    <button class="btn ghost" disabled="@(idx == 0)" @onclick="() => Move(idx, -1)" title="Su">↑</button>
                                    <button class="btn ghost" disabled="@(idx == _rules.Count - 1)" @onclick="() => Move(idx, 1)" title="Giù">↓</button>
                                    <button class="btn ghost" @onclick="() => RemoveRule(r)">✕ Rimuovi</button>
                                </div>
                            </div>
                            <div class="rule-rwys">
                                <div><span class="muted">DEP:</span>
                                    @if (_rwys.Count == 0) { <i class="muted">nessuna pista definita</i> }
                                    @foreach (var ident in RwIdents())
                                    {
                                        var id = ident;
                                        <button type="button" class="pill" style="@RwChip(r.Dep, id)" @onclick="() => Toggle(r.Dep, id)">@id</button>
                                    }
                                </div>
                                <div><span class="muted">ARR:</span>
                                    @foreach (var ident in RwIdents())
                                    {
                                        var id = ident;
                                        <button type="button" class="pill" style="@RwChip(r.Arr, id)" @onclick="() => Toggle(r.Arr, id)">@id</button>
                                    }
                                </div>
                            </div>
                            <div class="rule-grid">
                                <label>Coda max (kt)<input type="number" min="0" max="40" @bind="r.MaxTail" /></label>
                                <label>Traverso max (kt, opz.)<input type="number" min="0" max="60" placeholder="—" @bind="r.MaxCross" /></label>
                                <label>Superficie<select @bind="r.Surface"><option value="any">indiff</option><option value="dry">asciutta</option><option value="wet">bagnata</option></select></label>
                                <label>Nome<input @bind="r.Name" placeholder="es. 35 asciutta" /></label>
                                <label>Note<input @bind="r.Note" placeholder="testo libero" /></label>
                            </div>
                            <details class="rule-adv">
                                <summary>Avanzate — orario · giorni · parità · validità (opzionali)</summary>
                                <div class="rule-grid" style="margin-top:8px">
                                    <label>Orario da (LT)<input type="time" @bind="r.TimeFrom" /></label>
                                    <label>a (LT)<input type="time" @bind="r.TimeTo" /></label>
                                    <label>Parità giorno<select @bind="r.Parity"><option value="">indiff</option><option value="even">pari</option><option value="odd">dispari</option></select></label>
                                    <label>Valida dal (giorno/mese)
                                        <span style="display:flex;gap:4px">
                                            <select @bind="r.DateFromDay" style="flex:1">@DayOptions()</select>
                                            <select @bind="r.DateFromMonth" style="flex:2">@MonthOptions()</select>
                                        </span>
                                    </label>
                                    <label>fino al (giorno/mese)
                                        <span style="display:flex;gap:4px">
                                            <select @bind="r.DateToDay" style="flex:1">@DayOptions()</select>
                                            <select @bind="r.DateToMonth" style="flex:2">@MonthOptions()</select>
                                        </span>
                                    </label>
                                </div>
                                <p class="help" style="margin:6px 0 0">Finestra di validità <b>stagionale ricorrente</b>: solo giorno e mese (nessun anno, si ripete ogni anno). Es. dal 1 gen al 31 mar. Lasciare vuoto = sempre valida.</p>
                                <div class="rule-days">
                                    <span class="muted">Giorni:</span>
                                    @for (var b = 0; b < 7; b++)
                                    {
                                        var bit = b;
                                        <button type="button" class="pill" style="@DayChip(r, bit)" @onclick="() => ToggleDay(r, bit)">@DayNames[bit]</button>
                                    }
                                </div>
                            </details>
                        </div>
                    }

                    <div style="margin-top:10px;display:flex;gap:8px">
                        <button class="btn ghost" @onclick="AddRule">+ Regola</button>
                        <button class="btn primary" disabled="@(_busy || !_canEdit || issues.Errors.Count > 0)" @onclick="SaveRules">Salva regole</button>
                    </div>
                </div>
            }

            @* ===================== QUOTE DI TRANSIZIONE ===================== *@
            @if (_panel == "Quote transizione")
            {
                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">Quote di transizione</h3>
                    <p class="help">Tabella di default <b>TL = TA + margine</b> per fascia QNH (QNH&lt;977 → +2500 ft; 977–994 → +2000; 995–1012 → +1500; QNH≥1013 → +1000), arrotondata al FL superiore. Salvando la TA le righe di default si ricalcolano; puoi comunque modificare fasce e livelli a mano.</p>
                    @if (_policy.TransitionAltitude)
                    {
                        <p class="help"><span class="pill" style="background:#eef1f6;color:#5b6470" title="Campo importato dalla sorgente: sola lettura. Modificabile solo se un amministratore esclude «TA» in /vsop/admin/sorgenti">🔒 da sorgente</span> La Transition Altitude è importata dalla sorgente (sola lettura).</p>
                    }
                    @{ var tlIssues = TlIssues(); }
                    @if (tlIssues.Count > 0)
                    {
                        <div class="callout warning"><span class="cic">⚠️</span><div>@foreach (var m in tlIssues) { <div>@m</div> }</div></div>
                    }
                    <div class="se-row">
                        <label><b>Transition Altitude (ft)</b></label>
                        <input type="number" style="width:100px" @bind="_ta" disabled="@(_policy.TransitionAltitude)" />
                        <button class="btn primary" disabled="@(_busy || !_canEdit || _policy.TransitionAltitude)" @onclick="SaveTa">Salva TA</button>
                    </div>
                    <table class="res-table" style="max-width:460px">
                        <thead><tr><th>QNH da (hPa)</th><th>QNH a (hPa)</th><th>Transition Level</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var t in _tls)
                            {
                                <tr @key="t">
                                    <td><input type="number" style="width:90px" @bind="t.From" placeholder="aperto" /></td>
                                    <td><input type="number" style="width:90px" @bind="t.To" placeholder="aperto" /></td>
                                    <td><input style="width:90px" @bind="t.Level" placeholder="FL75" /></td>
                                    <td><button class="btn ghost" @onclick="() => RemoveTl(t)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="margin-top:10px;display:flex;gap:8px">
                        <button class="btn ghost" @onclick="AddTl">+ Riga</button>
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SaveTls">Salva tabella</button>
                    </div>
                </div>
            }

            @* ===================== FREQUENZE ===================== *@
            @if (_panel == "Frequenze")
            {
                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">Frequenze</h3>
                    <p class="help">Le frequenze proprie vengono dal catalogo settori (pannello «Settori»): ATIS · Delivery · Ground · TWR · APP. La principale (★) si sceglie lì. Qui puoi aggiungere link a frequenze già nel DB (riferimento vivo).</p>
                    <table class="res-table freq-table">
                        <thead><tr><th>Nome</th><th>Callsign</th><th>Frequenza</th><th>Origine</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var f in FreqRows())
                            {
                                <tr class="@(f.IsPrimary ? "primary" : null)"><td>@if (f.IsPrimary) { <span class="freq-key">★</span> } @FreqName(f.Position)</td><td>@f.ComposePosition</td><td>@(f.Frequency ?? "—")</td><td class="muted">catalogo</td><td></td></tr>
                            }
                            @foreach (var id in _linkIds)
                            {
                                var lf = _linkable.FirstOrDefault(x => x.SectorId == id);
                                <tr @key="id">
                                    <td>@(lf?.Icao ?? "—")</td><td>@(lf?.Callsign ?? "—")</td><td>@(lf?.FrequencyMhz ?? "—")</td>
                                    <td class="muted">link</td>
                                    <td><button class="btn ghost" @onclick="() => RemoveLink(id)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="se-row" style="margin-top:10px">
                        <input style="width:200px" placeholder="cerca callsign/freq…" @bind="_freqSearch" @bind:event="oninput" />
                        <select @bind="_pickFreqId" style="min-width:240px">
                            <option value="0">— scegli frequenza —</option>
                            @foreach (var lf in FilteredLinkable())
                            {
                                <option value="@lf.SectorId">@lf.Callsign · @lf.FrequencyMhz @(lf.Icao is null ? "" : $"({lf.Icao})")</option>
                            }
                        </select>
                        <button class="btn ghost" @onclick="AddLink">+ Link</button>
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SaveLinks">Salva link</button>
                    </div>
                </div>
            }

            @* ===================== PISTE ===================== *@
            @if (_panel == "Piste")
            {
                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">Piste</h3>
                    @if (_policy.Runways)
                    {
                        <p class="help"><span class="pill" style="background:#eef1f6;color:#5b6470" title="Importate dalla sorgente: ident/lunghezza/bearing e l'insieme delle piste sono in sola lettura. Modificabili solo escludendo «Piste» in /vsop/admin/sorgenti">🔒 da sorgente</span> Pista, lunghezza e bearing sono importati dalla sorgente (sola lettura). Restano editabili solo le colonne TORA/LDA/APP/Patterns/Circling.</p>
                    }
                    else
                    {
                        <p class="help">Ident / lunghezza / bearing arrivano dalla sorgente (re-import li sovrascrive). Le altre colonne sono editoriali.</p>
                    }
                    @{ var rwIssues = RwIssues(); }
                    @if (rwIssues.Count > 0)
                    {
                        <div class="callout warning"><span class="cic">⚠️</span><div>@foreach (var m in rwIssues) { <div>@m</div> }</div></div>
                    }
                    <table class="res-table">
                        <thead><tr><th>Pista</th><th>Lung. (m)</th><th>TORA</th><th>LDA</th><th>APP procedures</th><th>Patterns</th><th>Circling</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var r in _rwys)
                            {
                                <tr @key="r">
                                    <td><input style="width:64px" @bind="r.Ident" disabled="@(_policy.Runways)" /></td>
                                    <td class="muted">@(r.LengthM?.ToString() ?? "—")</td>
                                    <td><input style="width:80px" @bind="r.Tora" /></td>
                                    <td><input style="width:80px" @bind="r.Lda" /></td>
                                    <td><input style="width:150px" @bind="r.App" /></td>
                                    <td><input style="width:70px" @bind="r.Patterns" /></td>
                                    <td><input style="width:70px" @bind="r.Circling" /></td>
                                    <td>@if (!_policy.Runways) { <button class="btn ghost" @onclick="() => RemoveRwy(r)">✕</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="margin-top:10px;display:flex;gap:8px">
                        @if (!_policy.Runways) { <button class="btn ghost" @onclick="AddRwy">+ Pista</button> }
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SaveRwys">Salva piste</button>
                    </div>
                </div>
            }

            @* ===================== SID ===================== *@
            @if (_panel == "SID")
            {
                @if (_imported.Count > 0)
                {
                    <div class="block">
                        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                            <h3 style="margin:0">SID importate dal sectorfile</h3>
                            <span class="ln" style="flex:1"></span>
                            <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="ReimportSids" title="Ripreleva le SID dal sectorfile GitHub">↻ Re-importa SID</button>
                        </div>
                        <p class="help">Righe da sorgente: non editabili nei dati, ma imposti <b>priorità per punto</b>, <b>fix</b> se «da verificare», e la <b>pubblicazione</b> (di default dal ciclo successivo al prelievo).</p>
                        <div style="overflow:auto">
                        <table class="res-table sid-table">
                            <thead><tr><th>Punto (FIX)</th><th>SID</th><th>Pista</th><th>Trans.</th><th>Type</th><th>Priorità</th><th>Pubblicazione</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var e in _imported)
                                {
                                    <tr>
                                        <td>
                                            @if (e.NeedsReview)
                                            {
                                                <span title="fix da verificare">⚠</span>
                                                <input style="width:70px" @bind="e.FixOverride" placeholder="@e.Fix" />
                                                <label style="font-size:11px" title="Aggiungi l'alias @e.Fix → per gli import futuri"><input type="checkbox" @bind="e.CreateAlias" /> alias</label>
                                            }
                                            else { <b>@e.Fix</b> }
                                        </td>
                                        <td>@e.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.Runway) ? "—" : e.Runway)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.Transition) ? "—" : e.Transition)</td>
                                        <td>@(string.IsNullOrWhiteSpace(e.Type) ? "—" : e.Type)</td>
                                        <td><input type="number" style="width:60px" @bind="e.Priority" /></td>
                                        <td style="white-space:nowrap">
                                            @if (e.IsPublicNow) { <span class="pill green">pubblica</span> }
                                            else { <span class="pill future" title="pubblica automaticamente dal ciclo @e.PublishFromCycle">🕒 @e.PublishFromCycle</span> }
                                            <label style="font-size:11px;margin-left:6px"><input type="checkbox" @bind="e.ForcePublished" /> ora</label>
                                        </td>
                                        <td><button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="() => SaveImported(e)">💾</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    </div>
                }

                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">SID manuali</h3>
                    <p class="help">Righe aggiunte a mano dallo staff: preservate dagli import. Campi non presenti nel sectorfile (Initial climb / Cat / WTC / Condition) vanno qui.</p>
                    <div style="overflow:auto">
                    <table class="res-table sid-table">
                        <thead><tr><th>Pista</th><th>FIX</th><th>SID</th><th>Transition</th><th>Initial climb</th><th>Type</th><th>Cat.</th><th>WTC</th><th>Condition</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in _sids)
                            {
                                <tr @key="s">
                                    <td><input style="width:56px" @bind="s.Runway" /></td>
                                    <td><input style="width:70px" @bind="s.Fix" /></td>
                                    <td><input style="width:90px" @bind="s.Name" /></td>
                                    <td><input style="width:80px" @bind="s.Transition" /></td>
                                    <td><input style="width:90px" @bind="s.InitialClimb" /></td>
                                    <td><input style="width:70px" @bind="s.Type" /></td>
                                    <td><input style="width:48px" @bind="s.Cat" /></td>
                                    <td><input style="width:48px" @bind="s.Wtc" /></td>
                                    <td><input style="width:120px" @bind="s.Condition" /></td>
                                    <td><button class="btn ghost" @onclick="() => RemoveSid(s)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <div style="margin-top:10px;display:flex;gap:8px">
                        <button class="btn ghost" @onclick="AddSid">+ SID</button>
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SaveSids">Salva SID manuali</button>
                    </div>
                </div>
            }

            @* ===================== SEZIONI EXTRA ===================== *@
            @if (_panel == "Sezioni extra")
            {
                <div class="block" @onchange="MarkDirty">
                    <h3 style="margin-top:0">Sezioni extra</h3>
                    <p class="help">Sezioni editoriali libere (titolo + testo). Nel documento compaiono nella <b>colonna libera di destra</b> su schermo desktop e <b>sotto le SID</b> su schermi stretti/cellulare. Si valutano nell'ordine in cui le metti.</p>
                    @foreach (var (s, idx) in _extras.Select((s, i) => (s, i)))
                    {
                        <div class="rule-card" @key="s">
                            <div class="rule-head">
                                <span class="rule-ord">#@(idx + 1)</span>
                                <div style="display:flex;gap:6px">
                                    <button class="btn ghost" disabled="@(idx == 0)" @onclick="() => MoveExtra(idx, -1)" title="Su">↑</button>
                                    <button class="btn ghost" disabled="@(idx == _extras.Count - 1)" @onclick="() => MoveExtra(idx, 1)" title="Giù">↓</button>
                                    <button class="btn ghost" @onclick="() => RemoveExtra(s)">✕ Rimuovi</button>
                                </div>
                            </div>
                            <label style="display:block">Titolo<input style="width:100%" @bind="s.Title" placeholder="es. Note operative" /></label>
                            <label style="display:block;margin-top:8px">Testo<textarea style="width:100%;min-height:120px" @bind="s.Body" @bind:event="oninput" placeholder="Testo libero (gli a capo vengono preservati)"></textarea></label>
                            <div class="help" style="margin-top:8px">Anteprima (a capo preservati):</div>
                            <div class="extra-preview">@s.Body</div>
                        </div>
                    }
                    <div style="margin-top:10px;display:flex;gap:8px">
                        <button class="btn ghost" @onclick="AddExtra">+ Sezione</button>
                        <button class="btn primary" disabled="@(_busy || !_canEdit || _extras.Any(s => string.IsNullOrWhiteSpace(s.Title)))" @onclick="SaveExtras">Salva sezioni</button>
                    </div>
                </div>
            }

            @* ===================== SETTORI ===================== *@
            @if (_panel == "Settori")
            {
                <div class="block" @onchange="MarkDirty">
                    <div class="section-title" style="margin-top:0">
                        <h3 style="margin:0">Settori ATC <span class="pill blue">@_sectors.Count</span></h3><span class="ln"></span>
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="ImportSectors" title="Importa/aggiorna i settori ATC (incl. APP) dalla sorgente">⟳ Importa settori da sorgente</button>
                    </div>
                    <p class="muted" style="font-size:11.5px;margin:0 0 8px">Settori ATC importati dalla sorgente (callsign · ACC · position · middle id · freq · shape), inclusi gli APP. I limiti di quota li imposti tu; puoi nascondere i settori che non vuoi mostrare.</p>
                    @if (_sectors.Count == 0)
                    {
                        <p class="help">Nessun settore importato. Premi «Importa settori da sorgente».</p>
                    }
                    else
                    {
                        <table class="res-table">
                            <thead><tr><th>Callsign</th><th>ACC</th><th>Pos</th><th>Mid</th><th title="Solo APP: di ACC (remotizzato) o avvicinamento proprio (doc dedicato)">ACC?</th><th>Freq</th><th>Princ.</th><th>Shape</th><th>Lim. inf. <span class="muted" style="font-weight:400">(GND=0)</span></th><th>Lim. sup. <span class="muted" style="font-weight:400">(UNL=illim.)</span></th><th>Stato</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var s in _sectors)
                                {
                                    var hasLimits = SupportsLimits(s.Position);
                                    <tr style="@(s.IsHidden ? "opacity:.5" : "")">
                                        <td><b>@s.ComposePosition</b></td>
                                        <td><span class="pill blue">@s.AccCode</span></td>
                                        <td>@(s.Position ?? "—")</td>
                                        <td>@(s.MiddleIdentifier ?? "—")</td>
                                        <td style="text-align:center">
                                            @if (IsApp(s.Position))
                                            {
                                                <input type="checkbox" checked="@s.IsAccApp" disabled="@(_busy || !_canEdit)" @onchange="e => SetSectorAccApp(s.Id, (bool)(e.Value ?? false))" title="Avvicinamento di ACC (remotizzato). Deseleziona se è l'APP proprio dell'aeroporto (documento dedicato)." />
                                            }
                                            else { <span class="muted">—</span> }
                                        </td>
                                        <td>@(s.Frequency ?? "—")</td>
                                        <td style="text-align:center">
                                            @if (CanBePrimary(s.Position))
                                            {
                                                <input type="radio" name="primaryFreq-@((s.Position ?? "").Trim().ToUpperInvariant())" checked="@s.IsPrimary" disabled="@(_busy || !_canEdit)" @onchange="() => SetSectorPrimary(s.Id)" title="Frequenza principale per questo tipo" />
                                            }
                                            else { <span class="muted">—</span> }
                                        </td>
                                        <td>@(hasLimits ? (s.HasPolygon ? "✓" : "—") : "—")</td>
                                        @if (hasLimits)
                                        {
                                            <td>
                                                <input style="width:70px" value="@FmtLower(_secLower.GetValueOrDefault(s.Id))" @onchange="e => _secLower[s.Id] = ParseLower(e.Value)" title="GND oppure quota in ft" disabled="@(!_canEdit || s.LimitsFromSource)" />
                                                @if (s.LimitsFromSource) { <span class="pill" style="background:#eef1f6;color:#5b6470;margin-left:4px" title="Limiti importati dalla sorgente (IVAO): sola lettura.">🔒</span> }
                                            </td>
                                            <td><input style="width:70px" value="@FmtUpper(_secUpper.GetValueOrDefault(s.Id))" @onchange="e => _secUpper[s.Id] = ParseUpper(e.Value)" title="UNL oppure quota in ft" disabled="@(!_canEdit || s.LimitsFromSource)" /></td>
                                        }
                                        else
                                        {
                                            <td class="muted">—</td>
                                            <td class="muted">—</td>
                                        }
                                        <td>
                                            @if (s.IsHidden)
                                            {
                                                <span class="pill" style="background:#eef1f7;color:#57606a">nascosto</span>
                                            }
                                            else
                                            {
                                                <span class="pill" style="background:#dafbe7;color:#1a7f37">attivo</span>
                                            }
                                        </td>
                                        <td style="white-space:nowrap">
                                            @if (hasLimits && !s.LimitsFromSource)
                                            {
                                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => SaveSectorLimits(s.Id)" title="Salva limiti">💾</button>
                                            }
                                            <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => ToggleSectorHidden(s.Id, !s.IsHidden)" title="Mostra/nascondi">@(s.IsHidden ? "👁" : "🚫")</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }

            @* ===================== VERSIONI (release AIRAC) ===================== *@
            @if (_panel == "Versioni")
            {
                <div class="block">
                    <h3 style="margin-top:0">Versioni &amp; release AIRAC</h3>
                    <p class="help">La pubblicazione avviene <b>solo da qui</b>. Pubblicare <b>rigenera il documento dalla bozza corrente</b> (regole, TL, piste, SID, sezioni, settori) e poi ne congela una fotografia. <b>Pubblica ora</b> = in vigore subito (review sul ciclo corrente); <b>Pubblica al ciclo</b> = pianificata a un ciclo AIRAC futuro, entra in vigore automaticamente a quella data. Il pubblico vede la release in vigore al ciclo corrente (@_currentCycle).</p>

                    @if (!_canEdit)
                    {
                        <div class="callout warning"><span class="cic">🔒</span><div>Sola lettura: non hai i permessi per pubblicare release per @_icao.</div></div>
                    }

                    @if (_rels.Count == 0)
                    {
                        <p class="help" style="margin:0 0 6px">Nessuna release: il pubblico vede lo stato pubblicato/live corrente (fallback).</p>
                    }
                    else
                    {
                        @foreach (var r in _rels)
                        {
                            <div class="ver-row @(r.IsEffectiveNow ? "current" : "")">
                                <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
                                <div style="flex:1">
                                    <b>@RelLabel(r)</b>
                                    <div class="vmeta">rel. v@r.VersionNumber · VID @r.CreatedByUserId · @r.CreatedUtc.ToString("dd MMM yyyy HH:mm") · in vigore dal @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.Note) ? "" : $" — \"{r.Note}\"")</div>
                                </div>
                                <span class="vact">
                                    <a class="btn ghost" href="@($"/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}&as=rel:{r.Id}")" target="_blank" rel="noopener" title="Anteprima del documento come sarà a questo ciclo">👁 Anteprima</a>
                                    <button class="btn ghost" disabled="@_busy" @onclick="() => ToggleDiff(r.Id)" title="Cosa cambia rispetto a quella in vigore">🔍 Differenze</button>
                                    @if (Authz.IsAdmin)
                                    {
                                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => CancelRelease(r.Id)" title="Annulla questa release">✕ Annulla</button>
                                    }
                                </span>
                            </div>
                            @if (_diffOpen.Contains(r.Id))
                            {
                                <div class="block" style="margin:2px 0 8px 24px">@DiffBlock(r.Id)</div>
                            }
                        }
                    }

                    @if (_canEdit)
                    {
                        <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px">
                            <select class="app-in" style="min-width:270px;max-width:340px" @bind="_relCycle">
                                @foreach (var c in _upcoming)
                                {
                                    <option value="@c.Cycle">AIRAC @c.Cycle — dal @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
                                }
                            </select>
                            <input class="app-in" style="max-width:240px" placeholder="Nota (facoltativa)…" @bind="_relNote" />
                            <button class="btn primary" disabled="@_busy" @onclick="PublishReleaseNow" title="Pubblica e rendi visibile al pubblico subito">📢 Pubblica ora</button>
                            <button class="btn ghost" disabled="@_busy" @onclick="PublishRelease" title="Programma la pubblicazione a un ciclo AIRAC futuro">📅 Programma al ciclo</button>
                        </div>
                    }
                </div>
            }
        }
    </div>

    @* Toast fissi: sempre visibili anche in fondo a tabelle lunghe (SID/Settori). Il successo si auto-chiude. *@
    <div class="editor-toast">
        @if (_error is not null)
        {
            <div class="callout danger"><span class="cic">⛔</span><div style="flex:1">@_error</div><button class="btn ghost" style="padding:0 6px" @onclick="() => _error = null" title="Chiudi">✕</button></div>
        }
        @if (_status is not null)
        {
            <div class="callout success"><span class="cic">✅</span><div style="flex:1">@_status</div></div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }
    [SupplyParameterFromQuery] public string? Panel { get; set; }

    private AccInfo? _acc;
    private string _icao = "LIRF";
    private string? _loadedIcao;                 // evita reload dei buffer quando cambia solo ?panel
    private string? _dirtyPanel;                 // invariante: al più il pannello corrente è "sporco"
    private int _statusSeq;                       // token per auto-chiusura del toast di successo
    private DotNetObjectReference<AeroportoEditorPage>? _selfRef;
    private AirportData? _data;
    private IReadOnlyList<LinkableFrequencyRow> _linkable = Array.Empty<LinkableFrequencyRow>();
    private bool _canEdit;
    private bool _busy;
    private string? _error, _status;

    private readonly string[] _panels = { "Regole piste", "Quote transizione", "Frequenze", "Piste", "SID", "Sezioni extra", "Settori", "Versioni" };
    private string _panel = "Regole piste";

    private ImportPolicySnapshot _policy = ImportPolicySnapshot.AllImported;
    private int? _ta;
    private List<TlEdit> _tls = new();
    private List<RwEdit> _rwys = new();
    private List<RuleEdit> _rules = new();
    private List<SidEdit> _sids = new();
    private List<ImportedSidEdit> _imported = new();
    private List<ExtraEdit> _extras = new();
    private List<int> _linkIds = new();
    private string _freqSearch = "";
    private int _pickFreqId;

    // Release AIRAC (tab Versioni): timeline + selettore ciclo/nota + diff.
    private IReadOnlyList<ReleaseInfo> _rels = Array.Empty<ReleaseInfo>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private string? _relCycle;
    private string? _relNote;
    private readonly HashSet<int> _diffOpen = new();
    private readonly Dictionary<int, ReleaseDiff> _diffs = new();

    // Settori ATC importati (catalogo): righe + buffer limiti editabili per id.
    private IReadOnlyList<AirportSectorRow> _sectors = Array.Empty<AirportSectorRow>();
    private readonly Dictionary<int, int?> _secLower = new();
    private readonly Dictionary<int, int?> _secUpper = new();

    protected override void OnInitialized()
    {
        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        _relCycle ??= _upcoming.FirstOrDefault()?.Cycle;
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _icao = string.IsNullOrWhiteSpace(Icao) ? "LIRF" : Icao.ToUpperInvariant();

        // ?panel deep-link: seleziona il pannello se valido (senza ricaricare i dati).
        if (!string.IsNullOrWhiteSpace(Panel) && _panels.Contains(Panel)) _panel = Panel!;

        // Ricarica i buffer solo quando cambia l'aeroporto: cambiare pannello via URL non deve
        // sovrascrivere le modifiche non salvate.
        if (_loadedIcao != _icao)
        {
            _dirtyPanel = null;
            _loadedIcao = _icao;
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vipiAirportEditorInit", _selfRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _selfRef?.Dispose();
        // Rilascia la guardia beforeunload lasciando la pagina. Il circuito può essere già chiuso
        // (navigazione/refresh): ignora JSDisconnectedException invece di lasciare un task non osservato.
        try { await JS.InvokeVoidAsync("vipiSetDirty", false); }
        catch (JSDisconnectedException) { }
    }

    // --- Stato "sporco" per pannello + navigazione tra pannelli ---
    private async Task MarkDirty()
    {
        if (_dirtyPanel != _panel)
        {
            _dirtyPanel = _panel;
            await JS.InvokeVoidAsync("vipiSetDirty", true);
        }
    }

    private async Task ClearDirty()
    {
        if (_dirtyPanel is not null)
        {
            _dirtyPanel = null;
            await JS.InvokeVoidAsync("vipiSetDirty", false);
        }
    }

    private async Task SelectPanel(string p)
    {
        if (p == _panel) return;
        if (_dirtyPanel == _panel)
        {
            if (!await Confirm($"Modifiche non salvate in «{_panel}». Scartarle e cambiare pannello?"))
                return;
            await LoadAsync();   // scarto reale: ripristina i buffer dal server, non solo il flag
        }
        await ClearDirty();
        _panel = p;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("panel", p), replace: true);
    }

    private async Task<bool> Confirm(string message) => await JS.InvokeAsync<bool>("confirm", message);

    // --- Aggiunte/rimozioni con marcatura dirty (rimozioni con conferma) ---
    private async Task AddRule() { _rules.Add(new RuleEdit()); await MarkDirty(); }
    private async Task AddTl() { _tls.Add(new TlEdit()); await MarkDirty(); }
    private async Task AddRwy() { _rwys.Add(new RwEdit()); await MarkDirty(); }
    private async Task AddSid() { _sids.Add(new SidEdit()); await MarkDirty(); }
    private async Task AddExtra() { _extras.Add(new ExtraEdit()); await MarkDirty(); }

    private async Task RemoveRule(RuleEdit r) { if (await Confirm("Rimuovere questa regola?")) { _rules.Remove(r); await MarkDirty(); } }
    private async Task RemoveTl(TlEdit t) { if (await Confirm("Rimuovere questa riga?")) { _tls.Remove(t); await MarkDirty(); } }
    private async Task RemoveRwy(RwEdit r) { if (await Confirm("Rimuovere questa pista?")) { _rwys.Remove(r); await MarkDirty(); } }
    private async Task RemoveSid(SidEdit s) { if (await Confirm("Rimuovere questa SID?")) { _sids.Remove(s); await MarkDirty(); } }
    private async Task RemoveExtra(ExtraEdit s) { if (await Confirm("Rimuovere questa sezione?")) { _extras.Remove(s); await MarkDirty(); } }
    private async Task RemoveLink(int id) { _linkIds.Remove(id); await MarkDirty(); }

    // Ctrl/Cmd+S da JS: salva il pannello corrente (se editabile). Pannello «Settori» non ha salvataggio in blocco.
    [JSInvokable]
    public Task SaveCurrentPanel()
    {
        if (_busy || !_canEdit) return Task.CompletedTask;
        return _panel switch
        {
            "Regole piste" => RuleIssues().Errors.Count == 0 ? SaveRules() : Task.CompletedTask,
            "Quote transizione" => SaveTls(),
            "Frequenze" => SaveLinks(),
            "Piste" => SaveRwys(),
            "SID" => SaveSids(),
            "Sezioni extra" => _extras.Any(s => string.IsNullOrWhiteSpace(s.Title)) ? Task.CompletedTask : SaveExtras(),
            _ => Task.CompletedTask,
        };
    }

    private async Task LoadAsync()
    {
        _error = _status = null;
        try
        {
            _data = await Profile.LoadForEditAsync(_icao);
            _canEdit = _data is not null;
        }
        catch (EditNotAllowedException)
        {
            _data = await Profile.LoadForViewAsync(_icao);
            _canEdit = false;
        }
        if (_data is null) return;

        _linkable = await Profile.ListLinkableFrequenciesAsync();
        _policy = await Profile.GetImportPolicyAsync();
        _ta = _data.TransitionAltitudeFt;
        _tls = _data.TransitionLevels.Select(t => new TlEdit { Id = t.Id, From = t.QnhFrom, To = t.QnhTo, Level = t.Level }).ToList();
        _rwys = _data.Runways.Select(r => new RwEdit
        {
            Id = r.Id, Ident = r.Ident, LengthM = r.LengthM, Bearing = r.Bearing,
            Tora = r.ToraM, Lda = r.LdaM, App = r.AppProcedures, Patterns = r.Patterns, Circling = r.Circling,
        }).ToList();
        _rules = _data.Rules.Select(r => new RuleEdit
        {
            Name = r.Name,
            Dep = SplitCsv(r.DepRunways), Arr = SplitCsv(r.ArrRunways), Note = r.Note,
            MaxTail = r.MaxTailwindKt, MaxCross = r.MaxCrosswindKt,
            Surface = r.Surface switch { RunwaySurface.Dry => "dry", RunwaySurface.Wet => "wet", _ => "any" },
            TimeFrom = MinToTime(r.TimeFromLocalMin), TimeTo = MinToTime(r.TimeToLocalMin),
            DaysMask = r.DaysOfWeekMask ?? 0,
            Parity = r.DateParity switch { DateParity.Even => "even", DateParity.Odd => "odd", _ => "" },
            DateFromDay = MdDay(r.DateFromMonthDay), DateFromMonth = MdMonth(r.DateFromMonthDay),
            DateToDay = MdDay(r.DateToMonthDay), DateToMonth = MdMonth(r.DateToMonthDay),
        }).ToList();
        _sids = _data.Sids.Where(s => !s.IsImported).Select(s => new SidEdit
        {
            Runway = s.Runway, Fix = s.Fix, Name = s.Name, Transition = s.Transition, InitialClimb = s.InitialClimb,
            Type = s.Type, Cat = s.Cat, Wtc = s.Wtc, Condition = s.Condition,
        }).ToList();
        var cyc = Airac.GetCycle(DateTime.UtcNow);
        _imported = _data.Sids.Where(s => s.IsImported)
            .OrderBy(s => s.Fix).ThenBy(s => s.Priority ?? int.MaxValue).ThenBy(s => s.Name)
            .Select(s => new ImportedSidEdit
            {
                Id = s.Id, Fix = s.Fix, Name = s.Name, Runway = s.Runway, Transition = s.Transition, Type = s.Type,
                Priority = s.Priority, ForcePublished = s.ForcePublished, NeedsReview = s.NeedsFixReview,
                IsPublicNow = s.IsPublicAt(cyc, Airac), PublishFromCycle = NextCycleOf(s.SourceAiracCycle),
            }).ToList();
        _linkIds = _data.Links.Select(l => l.SourceSectorId).ToList();
        _extras = _data.ExtraSections.Select(s => new ExtraEdit { Title = s.Title, Body = s.Body }).ToList();

        _sectors = await Sectors.ListByAirportAsync(_icao);
        _secLower.Clear(); _secUpper.Clear();
        foreach (var s in _sectors) { _secLower[s.Id] = s.LowerLimit; _secUpper[s.Id] = s.UpperLimit; }

        // Release AIRAC del target aeroporto (chiave = ICAO). I diff aperti si scartano: gli id possono cambiare.
        _rels = await Releases.ListAsync(ReleaseTargetType.Airport, _icao);
        _diffOpen.Clear(); _diffs.Clear();
    }

    private IEnumerable<LinkableFrequencyRow> FilteredLinkable()
    {
        var q = (_freqSearch ?? "").Trim();
        return _linkable.Where(f =>
            q.Length == 0 ||
            f.Callsign.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            f.FrequencyMhz.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (f.Icao?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(50);
    }

    private async Task AddLink()
    {
        if (_pickFreqId != 0 && !_linkIds.Contains(_pickFreqId)) { _linkIds.Add(_pickFreqId); await MarkDirty(); }
        _pickFreqId = 0;
    }

    private Task SaveTa() => Guarded(() => Profile.SetTransitionAltitudeAsync(_icao, _ta), "TA salvata.");
    private Task SaveTls() => Guarded(() => Profile.SaveTransitionLevelsAsync(_icao,
        _tls.Select(t => new TlRow(t.Id, t.From, t.To, t.Level ?? "")).ToList()), "Tabella TL salvata.");
    private Task SaveRwys() => Guarded(() => Profile.SaveRunwaysAsync(_icao,
        _rwys.Select(r => new RunwayRow(r.Id, r.Ident ?? "", r.LengthM, r.Bearing, r.Tora, r.Lda, r.App, r.Patterns, r.Circling)).ToList()),
        "Piste salvate.");
    private Task SaveRules() => Guarded(() => Profile.SaveRunwayRulesAsync(_icao,
        _rules.Select(r => new RunwayRuleRow(0, JoinCsv(r.Dep), JoinCsv(r.Arr), r.Name,
            r.MaxTail, r.MaxCross, r.Surface switch { "dry" => RunwaySurface.Dry, "wet" => RunwaySurface.Wet, _ => RunwaySurface.Any }, r.Note,
            TimeToMin(r.TimeFrom), TimeToMin(r.TimeTo), r.DaysMask == 0 ? null : r.DaysMask,
            r.Parity switch { "even" => DateParity.Even, "odd" => DateParity.Odd, _ => DateParity.Any },
            CombineMd(r.DateFromMonth, r.DateFromDay), CombineMd(r.DateToMonth, r.DateToDay))).ToList()),
        "Regole salvate.");
    private Task SaveSids() => Guarded(() => Profile.SaveSidsAsync(_icao,
        _sids.Select(s => new SidRow(0, s.Runway, s.Fix ?? "", s.Name ?? "", s.Transition, s.InitialClimb, s.Type, s.Cat, s.Wtc, s.Condition)).ToList()),
        "SID salvate.");
    private Task SaveLinks() => Guarded(() => Profile.SaveFrequencyLinksAsync(_icao, _linkIds.ToList()), "Link salvati.");
    private Task SaveExtras() => Guarded(() => Profile.SaveExtraSectionsAsync(_icao,
        _extras.Select(s => new ExtraSectionRow(0, s.Title ?? "", s.Body)).ToList()), "Sezioni extra salvate.");

    private async Task Reimport()
    {
        if (!await Confirm("Re-importare da IVAO? I campi importati dalla sorgente verranno sovrascritti."))
            return;
        await Guarded(() => Profile.ReimportFromSourceAsync(_icao), "Re-import completato (campi IVAO aggiornati).");
    }

    // --- Import SID dal sectorfile: rimpiazza le importate, preserva manuali/priorità/forzatura ---
    private Task ReimportSids() => Guarded(() => SidImporter.ImportAsync(_icao), "Re-import SID completato.");

    private Task SaveImported(ImportedSidEdit e) => Guarded(async () =>
    {
        string? resolvedFix = null;
        if (e.NeedsReview && !string.IsNullOrWhiteSpace(e.FixOverride))
        {
            resolvedFix = e.FixOverride!.Trim();
            if (e.CreateAlias) await SidAliases.UpsertAsync(e.Fix, resolvedFix);   // e.Fix = prefisso grezzo
        }
        await Profile.UpdateImportedSidAsync(_icao, e.Id, e.Priority, e.ForcePublished, resolvedFix);
    }, "SID importata aggiornata.");

    // Ciclo di prima pubblicazione automatica = ciclo successivo a quello di prelievo.
    private string NextCycleOf(string? sourceCycle)
    {
        if (string.IsNullOrWhiteSpace(sourceCycle)) return "—";
        try { return Airac.GetCycle(Airac.EffectiveUtcForCycle(sourceCycle).AddDays(28)); }
        catch (ArgumentException) { return "—"; }
    }

    // --- Release AIRAC (tab Versioni). Pubblicare rigenera prima il documento dalla bozza, poi congela lo snapshot. ---
    private async Task PublishRelease()
    {
        var cycle = _relCycle ?? _upcoming.FirstOrDefault()?.Cycle;
        if (cycle is null) return;
        if (_dirtyPanel is not null &&
            !await Confirm($"Modifiche non salvate in «{_dirtyPanel}»: non entreranno nella release. Continuare?"))
            return;
        if (!await Confirm($"Rigenerare dalla bozza e pianificare la release al ciclo AIRAC {cycle}?"))
            return;
        await Guarded(async () =>
        {
            await Profile.RebuildDocumentAsync(_icao);
            await Releases.PublishAsync(ReleaseTargetType.Airport, _icao, cycle, _relNote);
        }, $"Release pianificata al ciclo {cycle}.");
    }

    private async Task PublishReleaseNow()
    {
        if (_dirtyPanel is not null &&
            !await Confirm($"Modifiche non salvate in «{_dirtyPanel}»: non entreranno nella release. Continuare?"))
            return;
        if (!await Confirm("Rigenerare dalla bozza e pubblicare ORA (review sul ciclo corrente)? Sarà visibile pubblicamente."))
            return;
        await Guarded(async () =>
        {
            await Profile.RebuildDocumentAsync(_icao);
            await Releases.PublishNowAsync(ReleaseTargetType.Airport, _icao, _relNote);
        }, "Release pubblicata subito (review).");
    }

    private async Task CancelRelease(int releaseId)
    {
        if (!await Confirm("Annullare questa release? Il pubblico tornerà alla precedente in vigore."))
            return;
        await Guarded(() => Releases.CancelReleaseAsync(releaseId), "Release annullata.");
    }

    private async Task ToggleDiff(int releaseId)
    {
        if (!_diffOpen.Remove(releaseId))
        {
            _diffOpen.Add(releaseId);
            if (!_diffs.ContainsKey(releaseId))
            {
                try { _diffs[releaseId] = await Releases.DiffAsync(releaseId); }
                catch (EditNotAllowedException ex) { _error = ex.Message; }
            }
        }
    }

    private static string RelLabel(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 In vigore" : r.Status == ReleaseStatus.Scheduled ? "🕒 Schedulata" : "Superata";
    private static string DiffPill(string change) => change switch { "Aggiunta" => "green", "Rimossa" => "grey", _ => "blue" };

    private RenderFragment DiffBlock(int releaseId) => __builder =>
    {
        @if (_diffs.TryGetValue(releaseId, out var diff))
        {
            <div class="muted" style="font-size:12px;margin-bottom:4px">Confronto con: @diff.BaselineLabel</div>
            @if (diff.Rows.Count == 0)
            {
                <p class="help" style="margin:0">Nessuna differenza strutturale rilevata.</p>
            }
            else
            {
                <table class="cfg-table">
                    <thead><tr><th>Voce</th><th>Modifica</th><th>Dettaglio</th></tr></thead>
                    <tbody>
                        @foreach (var r in diff.Rows)
                        {
                            <tr>
                                <td>@r.Label</td>
                                <td><span class="pill @DiffPill(r.Change)">@r.Change</span></td>
                                <td class="muted" style="font-size:12px">@r.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else { <p class="help" style="margin:0">Caricamento differenze…</p> }
    };

    // --- Settori ATC importati (catalogo): import + limiti + mostra/nascondi ---
    private Task ImportSectors() => Guarded(async () =>
    {
        var r = await Sectors.ImportFromSourceAsync(_icao);
        _status = $"Import settori completato: {r.Created} creati, {r.Updated} aggiornati.";
    }, null);
    private Task SaveSectorLimits(int id) => Guarded(() =>
        Sectors.SetLimitsAsync(id, _secLower.GetValueOrDefault(id), _secUpper.GetValueOrDefault(id)), "Limiti settore salvati.");
    private Task ToggleSectorHidden(int id, bool hidden) => Guarded(() =>
        Sectors.SetHiddenAsync(id, hidden), hidden ? "Settore nascosto." : "Settore mostrato.");
    private Task SetSectorPrimary(int id) => Guarded(() => Sectors.SetPrimaryAsync(id), "Frequenza principale aggiornata.");
    private Task SetSectorAccApp(int id, bool v) => Guarded(() => Sectors.SetAccAppAsync(id, v),
        v ? "APP segnato come «di ACC» (remotizzato)." : "APP segnato come avvicinamento proprio (documento dedicato).");

    // Solo le posizioni APP/DEP hanno il flag "di ACC".
    private static bool IsApp(string? position) => (position ?? "").Trim().ToUpperInvariant() is "APP" or "DEP";

    // Frequenze dal catalogo settori, ordine ATIS·DEL·GND·TWR·APP/DEP (solo con frequenza, non nascosti).
    private IEnumerable<AirportSectorRow> FreqRows()
    {
        string[] order = { "ATIS", "DEL", "GND", "TWR", "APP", "DEP" };
        return _sectors
            .Where(s => !s.IsHidden && !string.IsNullOrWhiteSpace(s.Frequency))
            .OrderBy(s => { var i = Array.IndexOf(order, (s.Position ?? "").Trim().ToUpperInvariant()); return i < 0 ? 99 : i; })
            .ThenByDescending(s => s.IsPrimary)   // dentro il tipo: la principale (★) per prima
            .ThenBy(s => s.ComposePosition);
    }

    private static string FreqName(string? position) => (position ?? "").Trim().ToUpperInvariant() switch
    {
        "ATIS" => "ATIS",
        "DEL" => "Delivery",
        "GND" => "Ground",
        "TWR" => "Tower",
        "APP" => "Approach",
        "DEP" => "Departure",
        "CTR" => "Control",
        "FSS" => "Information",
        _ => position ?? "—",
    };

    // Una principale per tipo: Delivery/Ground/TWR/APP/DEP (ATIS escluso).
    private static bool CanBePrimary(string? position)
    {
        var p = (position ?? "").Trim().ToUpperInvariant();
        return p is "DEL" or "GND" or "TWR" or "APP" or "DEP";
    }

    // Limite inferiore: "GND"/vuoto = 0 (suolo); altrimenti la quota in ft.
    private static int ParseLower(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("GND", StringComparison.OrdinalIgnoreCase)) return 0;
        return int.TryParse(s, out var n) ? Math.Max(0, n) : 0;
    }
    // Limite superiore: "UNL"/vuoto = null (illimitato); altrimenti la quota in ft.
    private static int? ParseUpper(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("UNL", StringComparison.OrdinalIgnoreCase)) return null;
        return int.TryParse(s, out var n) ? n : (int?)null;
    }
    private static string FmtLower(int? v) => (v ?? 0) == 0 ? "GND" : v!.Value.ToString();
    private static string FmtUpper(int? v) => v is null ? "UNL" : v.Value.ToString();

    // Solo TWR/APP/DEP/CTR/FSS hanno un volume (limiti + shape); GND/DEL/ATIS no.
    private static bool SupportsLimits(string? position)
    {
        var p = (position ?? "").Trim().ToUpperInvariant();
        return p is "TWR" or "APP" or "DEP" or "CTR" or "FSS";
    }

    private async Task Guarded(Func<Task> action, string? ok)
    {
        _busy = true; _error = _status = null;
        try
        {
            await action();
            await LoadAsync();
            await ClearDirty();
            if (ok is not null) { _status = ok; _ = AutoDismissStatus(); }
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Il toast di successo si chiude da solo dopo qualche secondo (gli errori restano finché letti/chiusi).
    private async Task AutoDismissStatus()
    {
        var token = ++_statusSeq;
        await Task.Delay(4500);
        if (token == _statusSeq && _status is not null)
        {
            _status = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    // --- Configurazioni: piste reali + toggle CSV/giorni, riordino, conversioni tempo ---
    private static readonly string[] DayNames = { "Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom" };

    private IReadOnlyList<string> RwIdents() =>
        _rwys.Where(r => !string.IsNullOrWhiteSpace(r.Ident)).Select(r => r.Ident!.Trim()).Distinct().ToList();

    private async Task Toggle(HashSet<string> set, string id) { if (!set.Remove(id)) set.Add(id); await MarkDirty(); }
    private static string RwChip(HashSet<string> set, string id) => set.Contains(id)
        ? "background:var(--brand,#0D2C99);color:#fff;border-color:var(--brand,#0D2C99)" : "opacity:.6";

    private async Task ToggleDay(RuleEdit r, int bit) { r.DaysMask ^= (1 << bit); await MarkDirty(); }
    private static string DayChip(RuleEdit r, int bit) => (r.DaysMask & (1 << bit)) != 0
        ? "background:var(--brand,#0D2C99);color:#fff;border-color:var(--brand,#0D2C99)" : "opacity:.6";

    private async Task Move(int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= _rules.Count) return;
        (_rules[idx], _rules[j]) = (_rules[j], _rules[idx]);
        await MarkDirty();
    }

    private async Task MoveExtra(int idx, int dir)
    {
        var j = idx + dir;
        if (j < 0 || j >= _extras.Count) return;
        (_extras[idx], _extras[j]) = (_extras[j], _extras[idx]);
        await MarkDirty();
    }

    private static HashSet<string> SplitCsv(string? csv) => (csv ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    private static string JoinCsv(HashSet<string> set) => string.Join(",", set);

    private static TimeOnly? MinToTime(int? min) => min is int m ? new TimeOnly(m / 60, m % 60) : null;
    private static int? TimeToMin(TimeOnly? t) => t is TimeOnly v ? v.Hour * 60 + v.Minute : null;

    // Finestra stagionale ricorrente: in DB è MMDD (mese*100+giorno); nell'editor giorno e mese separati (nessun anno).
    private static int? MdDay(int? mmdd) => mmdd is int md and >= 101 ? md % 100 : null;
    private static int? MdMonth(int? mmdd) => mmdd is int md and >= 101 ? md / 100 : null;
    // Valida solo se ENTRAMBI valorizzati; altrimenti null (nessun estremo per quel lato).
    private static int? CombineMd(int? month, int? day) =>
        month is int m && day is int d ? m * 100 + d : null;

    private static readonly string[] MonthNames =
        { "gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre" };

    private static RenderFragment DayOptions() => builder =>
    {
        builder.AddMarkupContent(0, "<option value=\"\">—</option>");
        for (var d = 1; d <= 31; d++)
            builder.AddMarkupContent(d, $"<option value=\"{d}\">{d}</option>");
    };
    private static RenderFragment MonthOptions() => builder =>
    {
        builder.AddMarkupContent(0, "<option value=\"\">— mese —</option>");
        for (var m = 1; m <= 12; m++)
            builder.AddMarkupContent(m, $"<option value=\"{m}\">{MonthNames[m - 1]}</option>");
    };

    /// <summary>Avvisi sulla tabella TL: fasce QNH sovrapposte e livello mancante.</summary>
    private List<string> TlIssues()
    {
        var w = new List<string>();
        for (var i = 0; i < _tls.Count; i++)
        {
            if (string.IsNullOrWhiteSpace(_tls[i].Level))
                w.Add($"Riga #{i + 1}: Transition Level mancante.");
            var aLo = _tls[i].From ?? int.MinValue;
            var aHi = _tls[i].To ?? int.MaxValue;
            if (aLo > aHi) w.Add($"Riga #{i + 1}: «QNH da» maggiore di «QNH a».");
            for (var j = i + 1; j < _tls.Count; j++)
            {
                var bLo = _tls[j].From ?? int.MinValue;
                var bHi = _tls[j].To ?? int.MaxValue;
                if (aLo <= bHi && bLo <= aHi)
                    w.Add($"Fasce QNH sovrapposte tra riga #{i + 1} e #{j + 1}.");
            }
        }
        return w;
    }

    /// <summary>Avvisi sulle piste: ident duplicati (rompono i chip DEP/ARR delle regole).</summary>
    private List<string> RwIssues()
    {
        var w = new List<string>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in _rwys)
        {
            var id = (r.Ident ?? "").Trim();
            if (id.Length == 0) continue;
            if (!seen.Add(id)) w.Add($"Pista «{id}» duplicata: usa un ident unico.");
        }
        return w;
    }

    private sealed record RuleValidation(List<string> Errors, List<string> Warnings);

    /// <summary>Errori (bloccano il salvataggio) + avvisi (piste inesistenti / finestra orario incompleta) sulle regole correnti.</summary>
    private RuleValidation RuleIssues()
    {
        var errors = new List<string>();
        var warnings = new List<string>();
        var known = RwIdents().ToHashSet(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < _rules.Count; i++)
        {
            var r = _rules[i];
            var n = i + 1;
            if (r.Dep.Count == 0 && r.Arr.Count == 0)
                errors.Add($"Regola #{n}: seleziona almeno una pista DEP o ARR.");
            foreach (var id in r.Dep.Concat(r.Arr).Where(id => !known.Contains(id)).Distinct())
                warnings.Add($"Regola #{n}: pista «{id}» non è tra le piste dell'aeroporto.");
            if (r.TimeFrom is not null ^ r.TimeTo is not null)
                warnings.Add($"Regola #{n}: finestra orario incompleta (manca inizio o fine).");
        }
        return new RuleValidation(errors, warnings);
    }

