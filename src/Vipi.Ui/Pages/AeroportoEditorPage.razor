    // Solo le posizioni APP/DEP hanno il flag "di ACC".
    private static bool IsApp(string? position) => (position ?? "").Trim().ToUpperInvariant() is "APP" or "DEP";

    // Frequenze dal catalogo settori, ordine ATIS·DEL·GND·TWR·APP/DEP (solo con frequenza, non nascosti).
    private IEnumerable<AirportSectorRow> FreqRows()
    {
        string[] order = { "ATIS", "DEL", "GND", "TWR", "APP", "DEP" };
        return _sectors
            .Where(s => !s.IsHidden && !string.IsNullOrWhiteSpace(s.Frequency))
            .OrderBy(s => { var i = Array.IndexOf(order, (s.Position ?? "").Trim().ToUpperInvariant()); return i < 0 ? 99 : i; })
            .ThenByDescending(s => s.IsPrimary)   // dentro il tipo: la principale (★) per prima
            .ThenBy(s => s.ComposePosition);
    }

    /// <summary>Nome mostrato in tabella frequenze: AtcCallsign IVAO; fallback al nome-posizione (come nel documento).</summary>
    private static string FreqDisplayName(AirportSectorRow f) =>
        string.IsNullOrWhiteSpace(f.AtcCallsign) ? FreqName(f.Position) : f.AtcCallsign;

    private static string FreqName(string? position) => (position ?? "").Trim().ToUpperInvariant() switch
    {
        "ATIS" => "ATIS",
        "DEL" => "Delivery",
        "GND" => "Ground",
        "TWR" => "Tower",
        "APP" => "Approach",
        "DEP" => "Departure",
        "CTR" => "Control",
        "FSS" => "Information",
        _ => position ?? "—",
    };

    // Una principale per tipo: Delivery/Ground/TWR/APP/DEP (ATIS escluso).
    private static bool CanBePrimary(string? position)
    {
        var p = (position ?? "").Trim().ToUpperInvariant();
        return p is "DEL" or "GND" or "TWR" or "APP" or "DEP";
    }

    // Limite inferiore: "GND"/vuoto = 0 (suolo); altrimenti la quota in ft.
    private static int ParseLower(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("GND", StringComparison.OrdinalIgnoreCase)) return 0;
        return int.TryParse(s, out var n) ? Math.Max(0, n) : 0;
    }
    // Limite superiore: "UNL"/vuoto = null (illimitato); altrimenti la quota in ft.
    private static int? ParseUpper(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("UNL", StringComparison.OrdinalIgnoreCase)) return null;
        return int.TryParse(s, out var n) ? n : (int?)null;
    }
    private static string FmtLower(int? v) => (v ?? 0) == 0 ? "GND" : v!.Value.ToString();
    private static string FmtUpper(int? v) => v is null ? "UNL" : v.Value.ToString();

    // Solo TWR/APP/DEP/CTR/FSS hanno un volume (limiti + shape); GND/DEL/ATIS no.
    private static bool SupportsLimits(string? position)
    {
        var p = (position ?? "").Trim().ToUpperInvariant();
        return p is "TWR" or "APP" or "DEP" or "CTR" or "FSS";
    }

    // Esegue un'azione con badge Salvataggio/Salvato + gestione errori. NON ricarica i buffer (in scroll-unico un reload
    // totale cancellerebbe le modifiche non salvate di ALTRE sezioni): chi ha bisogno di refresh lo fa in modo mirato.
    // Ritorna true = azione riuscita.
    private async Task<bool> Guarded(Func<Task> action)
    {
        _busy = true; _error = null; _save = SaveState.Saving; StateHasChanged();
        try
        {
            await action();
            _save = SaveState.Saved;
            // Vedi DelayedUiAction: si ferma anche allo smontaggio, cosa che il contatore non faceva.
            _dismissSaved.Schedule(TimeSpan.FromSeconds(2), () =>
            {
                if (_save != SaveState.Saved) return Task.CompletedTask;
                _save = SaveState.Idle;
                return InvokeAsync(StateHasChanged);
            });
            return true;
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; _save = SaveState.Idle; }
        catch (ValidationException ex) { _error = ex.Message; _save = SaveState.Idle; }
        catch (InvalidOperationException ex) { _error = ex.Message; _save = SaveState.Idle; }
        // Rete di sicurezza: senza questo, un'eccezione non prevista (DbUpdateException, Npgsql…) sfuggiva,
        // abbatteva il circuito e lasciava il badge inchiodato su "Salvataggio". Meglio un errore visibile.
        catch (Exception ex)
        {
            _error = L["Common_UnexpectedError"] + ex.Message;
            _save = SaveState.Idle;
            Logger.LogError(ex, "Azione editor aeroporto fallita ({Icao}).", _icao);
        }
        finally { _busy = false; }
        return false;
    }

    // Salvataggio in blocco di una sezione: i buffer locali già riflettono lo stato salvato (repo = replace totale),
    // quindi niente reload; a successo si pulisce solo il dirty della sezione.
    private async Task SaveSection(string section, Func<Task> action)
    {
        if (await Guarded(action)) await ClearDirty(section);
    }


    // Ricarica il solo catalogo settori + i buffer limiti (non tocca gli altri buffer di sezione).
    private async Task ReloadSectorsAsync()
    {
        _sectors = await Sectors.ListByAirportAsync(_icao);
        _secLower.Clear(); _secUpper.Clear();
        foreach (var s in _sectors) { _secLower[s.Id] = s.LowerLimit; _secUpper[s.Id] = s.UpperLimit; }
    }

