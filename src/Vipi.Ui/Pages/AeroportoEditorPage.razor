@page "/services/vsop/{Acc}/airports/editor"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IDocRoutesRegistry DocRoutes
@inject IDocumentUnionService Unioni
@inject IStringLocalizer<SharedResource> L

@* La pagina dell'editor di una vIPI d'aeroporto: qui restano l'indirizzo, i MEMBRI dell'unione (se questo
   documento ne è l'ospite), il pannello dell'unione e quello di pubblicazione. Il CORPO editoriale — sezioni,
   i sei editor strutturati, i dati dello scalo, il catalogo dei settori — sta in <AirportSectionsEditor>
   (carta 2026-09-03-documenti-uniti.md §5b). *@

<AirportSectionsEditor @ref="_editor" Acc="@Acc" Icao="@Icao" Chrome="true"
                       VociIndiceExtra="_vociMembri"
                       SuModifica="@(Ospite ? ModificaTutti : null)"
                       SuFineModifica="@(Ospite ? FineModificaTutti : null)">
    <AfterSections>
        @if (_errore is { Length: > 0 })
        {
            <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_errore</div></div>
        }

        @if (Ospite)
        {
            <UnionMembersEditor @ref="_membri" Membri="_altri" Acc="@Acc"
                               StatoCambiato="Ridisegna" VociCambiate="AggiornaVoci" />
        }

        @* ===================== VERSIONI (release AIRAC) =====================
           ⚠️ L'ancora `sec-versioni` è la stessa nei cinque editor: è dove atterra «Ripubblica» dalla lista
           «Da fare» (carta 2026-08-26-da-fare-una-lista-sola.md §3). *@
        @* L'unione dei documenti: SOPRA il pannello di pubblicazione, perché e' cio' che decide QUANTI
           documenti quel tasto pubblichera'.
           ⚠️ Solo a chi puo' pubblicare questo scalo, come il pannello sotto: unire due documenti ne
           accoppia le pubblicazioni, ed e' un gesto dello stesso peso. *@
        @if (_editor?.PuoPubblicare == true)
        {
            <UnionPanel Target="ReleaseTargetType.Airport" Key="@Codice"
                        IsEditing="_editor.Guscio.IsEditing" Changed="UnioneCambiata" />
        }

        <div id="sec-versioni">
            @if (_editor?.PuoPubblicare != true)
            {
                <div class="block"><div class="callout warning" style="margin:0"><span class="cic">🔒</span><div>@(string.Format(L["Ape_ReadOnlyPublish"].Value, Codice))</div></div></div>
            }
            else
            {
                <ReleasePanel Revisione="_unioneRev" Target="ReleaseTargetType.Airport" Key="@Codice"
                              ShowDiff="true" AllowCancel="Authz.IsEditor"
                              BeforePublishAsync="_editor.BeforePublishAsync"
                              PreviewUrlFactory="ReleasePreviewUrl"
                              Published="Ricarica" />
            }
        </div>
    </AfterSections>
</AirportSectionsEditor>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }

    private AirportSectionsEditor? _editor;
    private UnionMembersEditor? _membri;
    private IReadOnlyList<UnionMemberView> _altri = Array.Empty<UnionMemberView>();
    private string? _errore;

    private string Codice => (Icao ?? "").Trim().ToUpperInvariant();

    /// <summary>Questo documento è l'OSPITE di un'unione: allora redige anche gli altri.</summary>
    private bool Ospite => _altri.Count > 0;

    /// <summary>Quante volte l'unione e' cambiata in questa sessione di pagina: alzarla costringe
    /// <c>ReleasePanel</c> a rileggere i suoi bersagli.</summary>
    private int _unioneRev;

    protected override async Task OnParametersSetAsync() => await LeggiUnioneAsync();

    private async Task LeggiUnioneAsync()
    {
        var unione = await Unioni.ForTargetAsync(ReleaseTargetType.Airport, Codice);
        _altri = unione is not null && unione.IsHostTarget(ReleaseTargetType.Airport, Codice)
            ? unione.Members.Where(m => m.DocumentId != unione.Host.DocumentId).ToList()
            : Array.Empty<UnionMemberView>();
    }

    /// <inheritdoc cref="AppEditorPage.ModificaTutti"/>
    private async Task ModificaTutti()
    {
        _errore = null;
        if (_editor is null) return;

        if (await _editor.PrendiLockAsync() is { } chiOspite)
        {
            _errore = L["Union_LockedBy", chiOspite];
            return;
        }
        if (_membri is not null && await _membri.PrendiLockAsync() is { } chiMembro)
        {
            await _editor.RilasciaLockAsync();
            _errore = L["Union_LockedBy", chiMembro];
        }
    }

    private async Task FineModificaTutti()
    {
        if (_membri is not null) await _membri.RilasciaLockAsync();
        if (_editor is not null) await _editor.RilasciaLockAsync();
    }

    private async Task UnioneCambiata()
    {
        _unioneRev++;
        await LeggiUnioneAsync();
        await Ricarica();
    }

    private Task Ricarica() => _editor?.RicaricaAsync() ?? Task.CompletedTask;

    private Task Ridisegna() { StateHasChanged(); return Task.CompletedTask; }

    /// <summary>Le voci d'indice dei membri, portate dal componente che li monta.
    /// <para>⚠️ Arrivano SPINTE e non si tirano con l'`@ref`: quello si assegna dopo il render, e i
    /// membri si registrano durante — tirarle lasciava l'indice con le sole voci dell'ospite.</para></summary>
    private IReadOnlyList<EditorTocItem> _vociMembri = Array.Empty<EditorTocItem>();

    private Task AggiornaVoci(IReadOnlyList<EditorTocItem> voci)
    {
        _vociMembri = voci;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? ReleasePreviewUrl(int releaseId) =>
        DocRoutes.For(ReleaseTargetType.Airport).ViewerUrl(Acc.ToLowerInvariant(), Codice, null, releaseId);
}
