@page "/services/vsop/admin/translations"
@layout SopLayout
@rendermode InteractiveServer
@inject Vipi.Application.Abstractions.ITranslationMemory Memoria
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L
@using Vipi.Application.Abstractions
@using Vipi.Domain.Entities

<PageTitle>@L["Tr_AdminTitle"] · IVAO Italy</PageTitle>

@* ---- La revisione delle traduzioni (carta bilingue §5) -----------------------------------------------

   ⚠️ QUI SI CORREGGE COME SI DICE UNA FRASE, MAI COSA DICE. Il testo sorgente è la chiave della memoria e
   non è modificabile da questa pagina: cambiare ciò che il documento afferma è un'edit del documento, che
   passa dall'editor e dalla release come qualunque altra modifica. È l'invariante del committente — le due
   lingue dicono la stessa cosa — reso strutturale invece che raccomandato.

   ⚠️ E SI CORREGGE LA FRASE, NON IL DOCUMENTO. La memoria è indicizzata sull'impronta del testo, quindi la
   correzione fatta qui vale per ogni documento che contiene quella frase, anche futuro. È il superpotere
   della forma e insieme il suo trabocchetto, e per questo il conto dei documenti toccati si mostra PRIMA
   che si salvi, non dopo. *@

<div class="wrap struct">
    <AdminNav />

    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Tr_AdminTitle"]
            @if (_conteggio is { } c)
            {
                <span>&nbsp;</span>
                <span class="pill @(c.DaRileggere > 0 ? "amber" : "blue")">@c.DaRileggere / @c.Totale</span>
            }
        </h1>
        <nav class="struct-nav">
            <select class="btn ghost" @onchange="CambiaCoppiaAsync" disabled="@_busy">
                <option value="en|it" selected="@(_da == "en")">EN → IT</option>
                <option value="it|en" selected="@(_da == "it")">IT → EN</option>
            </select>
            <button class="btn ghost @(_soloDaRileggere ? "on" : "")" disabled="@_busy" @onclick="AlternaFiltroAsync">
                <Icon Name="warning" Size="14" /> @L["Tr_OnlyUnreviewed"]
            </button>
            <button class="btn ghost" disabled="@_busy" @onclick="CaricaAsync">
                <Icon Name="refresh" Size="14" /> @L["Audit_Refresh"]
            </button>
        </nav>
        <LiveRegion>
            @if (_msg is { } m)
            {
                <span class="st-msg ok"><Icon Name="check-circle" Size="14" /><span class="st-msg-t">@m</span></span>
            }
        </LiveRegion>
    </div>

    @if (!Authz.IsEditor)
    {
        <p class="help">@L["Pend_AdminOnly"]</p>
    }
    else if (_righe is null)
    {
        <LoadingState />
    }
    else if (_righe.Count == 0)
    {
        <EmptyState Icon="check-circle" Title="@L["Tr_NothingToReview"].Value">
            <p style="margin:0">@L["Tr_NothingToReviewHint"]</p>
        </EmptyState>
    }
    else
    {
        <div class="panel">
            <table class="res-table">
                <thead>
                    <tr>
                        <th style="width:42%">@L["Tr_ColSource"]</th>
                        <th>@L["Tr_ColTarget"]</th>
                        <th style="width:120px">@L["Tr_ColOrigin"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in _righe)
                {
                    <tr class="@(r.Id == _apertaId ? "on" : "")">
                        <td><span class="muted">@r.SourceText</span></td>
                        <td>
                            @if (_apertaId == r.Id)
                            {
                                <textarea class="in" rows="3" @bind="_bozza" @bind:event="oninput"></textarea>

                                @* ⚠️ IL RAGGIO D'AZIONE, PRIMA DEL SALVATAGGIO. Chi corregge deve sapere che
                                   non sta toccando solo il documento che aveva in mente. *@
                                @if (_toccati > 1)
                                {
                                    <p class="st-msg warn" style="margin:6px 0 0">
                                        <Icon Name="warning" Size="14" />
                                        <span class="st-msg-t">@L["Tr_TouchesDocs", _toccati]</span>
                                    </p>
                                }
                                <div style="margin-top:6px;display:flex;gap:6px">
                                    <button class="btn" disabled="@(_busy || string.IsNullOrWhiteSpace(_bozza))"
                                            @onclick="() => SalvaAsync(r)">
                                        <Icon Name="check-circle" Size="14" /> @L["Common_Save"]
                                    </button>
                                    <button class="btn ghost" disabled="@_busy" @onclick="Chiudi">@L["Common_Cancel"]</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn ghost" style="text-align:left;width:100%"
                                        disabled="@_busy" @onclick="() => ApriAsync(r)">@r.TargetText</button>
                            }
                        </td>
                        <td>
                            @if (r.Origin == TranslationOrigin.Human)
                            {
                                <span class="pill blue">@L["Tr_OriginHuman"]</span>
                            }
                            else
                            {
                                <span class="pill amber">@L["Tr_OriginMachine"]</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    /// <summary>Quante righe per volta. La revisione si fa a lotti: una pagina con tutta la memoria non si legge.</summary>
    private const int PerPagina = 100;

    private IReadOnlyList<TranslationReviewRow>? _righe;
    private (int Totale, int DaRileggere)? _conteggio;
    private string _da = "en";
    private string _a = "it";
    private bool _soloDaRileggere = true;
    private bool _busy;
    private string? _msg;

    private int? _apertaId;
    private string _bozza = "";
    private int _toccati;

    // ⚠️ OnParametersSetAsync e non OnInitializedAsync: su @rendermode InteractiveServer il secondo gira UNA
    // VOLTA SOLA, e questa pagina si ricarica cambiando coppia di lingue e filtro.
    protected override Task OnParametersSetAsync() => CaricaAsync();

    private async Task CaricaAsync()
    {
        if (!Authz.IsEditor) return;
        _busy = true;
        try
        {
            _conteggio = await Memoria.ContaAsync(_da, _a);
            _righe = await Memoria.ListForReviewAsync(_da, _a, _soloDaRileggere, PerPagina);
            Chiudi();
        }
        finally { _busy = false; }
    }

    private async Task CambiaCoppiaAsync(ChangeEventArgs e)
    {
        var parti = (e.Value?.ToString() ?? "en|it").Split('|');
        _da = parti[0];
        _a = parti[1];
        await CaricaAsync();
    }

    private async Task AlternaFiltroAsync()
    {
        _soloDaRileggere = !_soloDaRileggere;
        await CaricaAsync();
    }

    /// <summary>
    /// Apre una riga in correzione. ⚠️ Il conto dei documenti toccati si chiede QUI e non nell'elenco: una
    /// query per riga su cento righe sarebbe cento query a ogni caricamento, e il numero serve solo a chi
    /// sta per salvare.
    /// </summary>
    private async Task ApriAsync(TranslationReviewRow r)
    {
        _apertaId = r.Id;
        _bozza = r.TargetText;
        _msg = null;
        _toccati = await Memoria.DocumentiToccatiAsync(r.SourceText);
    }

    private void Chiudi()
    {
        _apertaId = null;
        _bozza = "";
        _toccati = 0;
    }

    private async Task SalvaAsync(TranslationReviewRow r)
    {
        if (string.IsNullOrWhiteSpace(_bozza)) return;
        _busy = true;
        try
        {
            // Origin diventa Human: da qui in avanti la macchina non la tocca piu', nemmeno cambiando
            // motore o versione. E' la promessa su cui si regge la funzione.
            await Memoria.SaveHumanAsync(_da, _a, r.SourceText, _bozza.Trim(), Authz.CurrentUserId ?? 0);
            // ⚠️ Il conto adesso e' vero: la frase deve reggere anche a uno e a zero.
            _msg = (_toccati switch
            {
                0 => L["Tr_SavedNone"],
                1 => L["Tr_SavedOne"],
                _ => L["Tr_Saved", _toccati],
            }).Value;
        }
        finally { _busy = false; }
        await CaricaAsync();
    }
}
