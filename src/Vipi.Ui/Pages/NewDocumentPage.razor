@page "/vsop/editor/newdoc"
@layout SopLayout
@rendermode InteractiveServer
@inject IStructureEditingService Struct
@inject IEditingService Editing
@inject IEditAuthorizationService Authz
@inject Vipi.Ui.Shared.Routing.IDocRoutesRegistry DocRoutes
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nd_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/versioni">@L["Nd_Drafts"]</a> › <b>@L["Nd_Title"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Nd_Title"]</h2><span class="muted">@L["Nd_Subtitle"]</span></div>
    </div>

    @if (_msg is not null)
    {
        <div class="callout warning"><span class="cic">⚠️</span><div>@_msg</div></div>
    }

    @if (!Authz.IsAdmin)
    {
        <div class="callout warning"><span class="cic">⚠️</span><div>@L["Nd_StaffRequired"]</div></div>
    }
    else
    {
        <EditLockBar ResourceKey="@ResourceLockKeys.NewDoc" LockChanged="OnLockChanged" />

        <div class="seg" style="display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 16px">
            <button class="btn @(_kind == Kind.Vloa ? "primary" : "ghost")" @onclick="() => _kind = Kind.Vloa"><Icon Name="file" /> vLOA</button>
            <button class="btn @(_kind == Kind.Acc ? "primary" : "ghost")" @onclick="() => _kind = Kind.Acc"><Icon Name="map" /> @L["Nd_KindAcc"]</button>
            <button class="btn @(_kind == Kind.App ? "primary" : "ghost")" @onclick="() => _kind = Kind.App"><Icon Name="plane-landing" /> @L["Nd_KindApp"]</button>
            <button class="btn @(_kind == Kind.Airport ? "primary" : "ghost")" @onclick="() => _kind = Kind.Airport"><Icon Name="plane-takeoff" /> @L["Nd_KindAirport"]</button>
        </div>

        @if (_kind == Kind.Vloa)
        {
            <div class="block">
                <p class="muted" style="font-size:12px;margin:0 0 8px">@((MarkupString)L["Nd_VloaIntro"].Value)</p>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field"><label>@L["Nd_LblTitle"]</label><input placeholder="@L["Nd_TitlePh"]" @bind="_docTitle" /></div>
                    <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="CreateVloa">@L["Nd_CreateOpen"]</button>
                </div>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:12px">
                    <div class="field"><label>@L["Nd_HomeAcc"]</label>
                        <select value="@_homeAcc" @onchange="OnHomeAccChanged">
                            <option value="">@L["Nd_AccOption"]</option>
                            @foreach (var a in ItalianAccs()) { <option value="@a.Code">@a.Code · @a.Name</option> }
                        </select>
                    </div>
                    <div class="field"><label>@L["Nd_HomeSector"]</label>
                        <select @bind="_docHome" disabled="@(string.IsNullOrEmpty(_homeAcc))">
                            <option value="0">@L["Nd_SectorOption"]</option>
                            @foreach (var s in AreaSectorsOf(_homeAcc)) { <option value="@s.Id">@s.Callsign</option> }
                        </select>
                    </div>
                </div>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:6px">
                    <div class="field"><label>@L["Nd_NeighAcc"]</label>
                        <select value="@_neighAcc" @onchange="OnNeighAccChanged">
                            <option value="">@L["Nd_AccOption"]</option>
                            @foreach (var a in ForeignAccs()) { <option value="@a.Code">@a.Code · @a.Name</option> }
                        </select>
                    </div>
                    <div class="field"><label>@L["Nd_NeighSector"]</label>
                        <select @bind="_docNeighbour" disabled="@(string.IsNullOrEmpty(_neighAcc))">
                            <option value="0">@L["Nd_SectorOption"]</option>
                            @foreach (var s in AreaSectorsOf(_neighAcc)) { <option value="@s.Id">@s.Callsign</option> }
                        </select>
                    </div>
                </div>
                @if (ForeignAccs().Count == 0)
                {
                    <p class="muted" style="font-size:11px;margin-top:6px">@L["Nd_NoForeignAcc"]</p>
                }
                <p class="muted" style="font-size:12px;margin:12px 0 0">@L["Nd_VloaEmptyNote"]</p>
            </div>
        }
        else if (_kind == Kind.Acc)
        {
            <div class="block">
                <p class="muted" style="font-size:12px;margin:0 0 8px">@((MarkupString)L["Nd_AccIntro"].Value)</p>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field"><label>@L["Nd_ItalianAcc"]</label>
                        <select @bind="_selAcc">
                            <option value="">@L["Nd_AccOption"]</option>
                            @foreach (var a in ItalianAccs()) { <option value="@a.Code">@a.Code · @a.Name</option> }
                        </select>
                    </div>
                    <button class="btn primary" disabled="@(string.IsNullOrEmpty(_selAcc))" @onclick="OpenAcc">@L["Nd_OpenEditor"]</button>
                </div>
            </div>
        }
        else if (_kind == Kind.App)
        {
            <div class="block">
                <p class="muted" style="font-size:12px;margin:0 0 8px">@((MarkupString)L["Nd_AppIntro"].Value)</p>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field"><label>@L["Nd_Acc"]</label>
                        <select value="@_selAcc" @onchange="OnAppAccChanged">
                            <option value="">@L["Nd_AccOption"]</option>
                            @foreach (var a in ItalianAccs()) { <option value="@a.Code">@a.Code · @a.Name</option> }
                        </select>
                    </div>
                    <div class="field"><label>@L["Nd_StandaloneApp"]</label>
                        <select @bind="_selCallsign" disabled="@(string.IsNullOrEmpty(_selAcc))">
                            <option value="">@L["Nd_AppOption"]</option>
                            @foreach (var s in StandaloneAppsOf(_selAcc)) { <option value="@s.Callsign">@s.Callsign</option> }
                        </select>
                    </div>
                    <button class="btn primary" disabled="@(string.IsNullOrEmpty(_selCallsign))" @onclick="OpenApp">@L["Nd_OpenEditor"]</button>
                </div>
                @if (!string.IsNullOrEmpty(_selAcc) && StandaloneAppsOf(_selAcc).Count == 0)
                {
                    <p class="muted" style="font-size:11px;margin-top:6px">@((MarkupString)string.Format(L["Nd_NoStandalone"].Value, _selAcc))</p>
                }
            </div>
        }
        else if (_kind == Kind.Airport)
        {
            <div class="block">
                <p class="muted" style="font-size:12px;margin:0 0 8px">@L["Nd_AirportIntro"]</p>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field"><label>@L["Nd_Acc"]</label>
                        <select value="@_selAcc" @onchange="OnAirportAccChanged">
                            <option value="">@L["Nd_AccOption"]</option>
                            @foreach (var a in ItalianAccs()) { <option value="@a.Code">@a.Code · @a.Name</option> }
                        </select>
                    </div>
                    <div class="field"><label>@L["Nd_Airport"]</label>
                        <select @bind="_selIcao" disabled="@(string.IsNullOrEmpty(_selAcc))">
                            <option value="">@L["Nd_IcaoOption"]</option>
                            @foreach (var a in AirportsOf(_selAcc)) { <option value="@a.Icao">@a.Icao · @a.Name</option> }
                        </select>
                    </div>
                    <button class="btn primary" disabled="@(string.IsNullOrEmpty(_selIcao))" @onclick="OpenAirport">@L["Nd_OpenEditor"]</button>
                </div>
                @if (!string.IsNullOrEmpty(_selAcc) && AirportsOf(_selAcc).Count == 0)
                {
                    <p class="muted" style="font-size:11px;margin-top:6px">@((MarkupString)string.Format(L["Nd_NoAirports"].Value, _selAcc))</p>
                }
            </div>
        }
    }
</div>

@code {
    private enum Kind { Vloa, Acc, App, Airport }
    private Kind _kind = Kind.Vloa;

    private IReadOnlyList<AccRow> _accs = Array.Empty<AccRow>();
    private IReadOnlyList<GlobalSectorRow> _all = Array.Empty<GlobalSectorRow>();
    private IReadOnlyList<AirportAdminRow> _airports = Array.Empty<AirportAdminRow>();

    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock "nuovo documento" (EditLockBar)
    private string? _msg;
    private string _docTitle = "";

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // vLOA
    private string? _homeAcc, _neighAcc;
    private int _docHome, _docNeighbour;

    // ACC / APP / Aeroporto: bersaglio scelto
    private string _selAcc = "";
    private string _selCallsign = "";
    private string _selIcao = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        _accs = await Struct.ListAccsAsync();
        _all = await Struct.ListSectorNodesAsync();
        _airports = await Struct.ListAllAirportsAsync();
    }

    // Settore d'area = CTR o APP remotizzato (candidati Home/Neighbour di una vLOA).
    private static bool IsArea(GlobalSectorRow s) =>
        s.Type == SectorType.Ctr || (s.Type == SectorType.App && s.ApproachKind == ApproachKind.Remotized);

    private IReadOnlyList<AccRow> ItalianAccs() =>
        _accs.Where(a => string.Equals(a.CountryPrefix, "LI", StringComparison.OrdinalIgnoreCase) && a.Sectors > 0).ToList();
    private IReadOnlyList<AccRow> ForeignAccs() =>
        _accs.Where(a => !string.Equals(a.CountryPrefix, "LI", StringComparison.OrdinalIgnoreCase) && a.Sectors > 0).ToList();

    /// <summary>Settori d'area (CTR + APP di ACC) di un ACC, candidati Home/Neighbour vLOA.</summary>
    private IReadOnlyList<GlobalSectorRow> AreaSectorsOf(string? accCode) =>
        string.IsNullOrEmpty(accCode)
            ? Array.Empty<GlobalSectorRow>()
            : _all.Where(s => string.Equals(s.AccCode, accCode, StringComparison.OrdinalIgnoreCase) && IsArea(s))
                  .OrderBy(s => s.Callsign).ToList();

    /// <summary>APP non remotizzati (standalone) di un ACC: hanno documento proprio.</summary>
    private IReadOnlyList<GlobalSectorRow> StandaloneAppsOf(string? accCode) =>
        string.IsNullOrEmpty(accCode)
            ? Array.Empty<GlobalSectorRow>()
            : _all.Where(s => string.Equals(s.AccCode, accCode, StringComparison.OrdinalIgnoreCase)
                             && s.Type == SectorType.App && s.ApproachKind == ApproachKind.Standalone)
                  .OrderBy(s => s.Callsign).ToList();

    private IReadOnlyList<AirportAdminRow> AirportsOf(string? accCode) =>
        string.IsNullOrEmpty(accCode)
            ? Array.Empty<AirportAdminRow>()
            : _airports.Where(a => string.Equals(a.AccCode, accCode, StringComparison.OrdinalIgnoreCase))
                       .OrderBy(a => a.Icao).ToList();

    private void OnHomeAccChanged(ChangeEventArgs e)
    {
        _homeAcc = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _docHome = 0;
    }
    private void OnNeighAccChanged(ChangeEventArgs e)
    {
        _neighAcc = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _docNeighbour = 0;
    }

    private void OnAppAccChanged(ChangeEventArgs e)
    {
        _selAcc = e.Value?.ToString() ?? "";
        _selCallsign = "";
    }
    private void OnAirportAccChanged(ChangeEventArgs e)
    {
        _selAcc = e.Value?.ToString() ?? "";
        _selIcao = "";
    }

    // ACC/APP/Aeroporto: l'editor crea il documento all'apertura (EnsureAsync). Le rotte vengono dal registry doc 09.
    private void OpenAcc()
    {
        var url = DocRoutes.For(ManagedDocKind.AccVipi).EditorUrl(_selAcc.ToLowerInvariant(), "", null, null);
        if (url is not null) Nav.NavigateTo(url, forceLoad: true);
    }
    private void OpenApp()
    {
        var url = DocRoutes.For(ManagedDocKind.AppVipi).EditorUrl(_selAcc.ToLowerInvariant(), _selCallsign, null, null);
        if (url is not null) Nav.NavigateTo(url, forceLoad: true);
    }
    private void OpenAirport()
    {
        var url = DocRoutes.For(ManagedDocKind.AirportVipi).EditorUrl(_selAcc.ToLowerInvariant(), _selIcao, null, null);
        if (url is not null) Nav.NavigateTo(url, forceLoad: true);
    }

    private async Task CreateVloa()
    {
        _busy = true; _msg = null;
        try
        {
            if (_docHome == 0 || _docNeighbour == 0) { _msg = L["Nd_SelectHomeNeigh"]; return; }

            await Editing.CreateDocumentAsync(DocumentType.Vloa, _docTitle,
                scopeSectorIds: null, primarySectorId: null, homeSectorId: _docHome, neighbourSectorId: _docNeighbour);

            if (string.IsNullOrEmpty(_homeAcc)) { _msg = L["Nd_CannotResolveHome"]; return; }
            // La vLOA si edita dall'editor per coppia (keyed sull'ACC estero). forceLoad: versione appena creata.
            var neigh = _neighAcc?.ToUpperInvariant();
            Nav.NavigateTo($"/vsop/{_homeAcc.ToLowerInvariant()}/vloa/editor?acc={neigh}", forceLoad: true);
        }
        catch (ValidationException ex) { _msg = ex.Message; }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
}
