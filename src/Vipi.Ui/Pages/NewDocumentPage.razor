@page "/services/vsop/editor/new-document"
@layout SopLayout
@rendermode InteractiveServer
@* ⚠️ OwningComponentBase per lo SCOPE: il servizio di editing (e il suo DbContext) non viene dal circuito. *@
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@inject INewDocumentOptionsService Options
@inject IEditAuthorizationService Authz
@inject Vipi.Application.Routing.IDocRoutesRegistry DocRoutes
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Nd_Title"] · vIPI IVAO Italy</PageTitle>

<div class="wrap struct">
    @* ⚠️ La barra c'è, la voce nell'elenco no — e sono due decisioni diverse.
       La barra sì: è una pagina di lavoro admin come le altre dodici, e da qui si va spesso altrove
       (Struttura per un settore che manca, Aeroporti per assegnarne uno, Confinanti per le vLOA in blocco);
       prima ci si arrivava solo tornando indietro.
       La voce no: `AdminNav` è già a undici voci e sotto i 1 200px va su due righe. «Nuovo documento» non è
       una destinazione che si cerca — ci si arriva DA Documenti, che nella barra c'è già, col tasto che sta
       lì. Aggiungerla renderebbe la barra peggiore su tutte e tredici le pagine per servirne una.
       Regola generale: la barra mostra DOVE SI PUÒ ANDARE, non dove si è. La voce accesa non è un requisito. *@
    <AdminNav />

    @* ---- Testata in UNA riga: titolo · «?» · Documenti ---- *@
    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">@L["Nd_Title"]</h1>
        <HelpHint Href="/services/vsop/guide#nuovo-documento" AriaLabel="@L["Nd_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Nd_Subtitle"]</p>
            @((MarkupString)L["Nd_Intro"].Value)
        </HelpHint>
        <nav class="struct-nav">
            <a class="btn ghost" href="/services/vsop/versions"><Icon Name="file" Size="14" /> @L["Nd_Drafts"]</a>
        </nav>
    </div>

    @if (_opts is null)
    {
        <LoadingState />
    }
    else if (_opts.MyAccs.Count == 0)
    {
        @* ⚠️ Non «non sei admin»: la serratura di questa pagina è il GRANT sull'ACC, non il codice staff.
           I servizi che chiama autorizzano con EnsureCanEditAccAsync, quindi il responsabile di un ACC — che
           può creare e pubblicare i documenti di quell'ACC — trovava la porta chiusa pur avendo la chiave:
           bastava che arrivasse all'URL dell'editor per creare lo stesso il documento. È lo stesso difetto
           chiuso su /services/vsop/versions il 21 agosto. *@
        <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div>@L["Nd_StaffRequired"]</div></div>
    }
    else
    {
        <div class="panel st-pane nd-pane">
            @* ---- Le quattro schede ----
               L'ordine è ACC · APP · Aeroporto · vLOA: la vLOA apre il form più lungo ma è il documento più
               raro (uno per coppia, e per le confinanti li genera Confinanti in blocco). Le tre vIPI sono il
               lavoro di tutti i giorni.
               Le etichette hanno perso il prefisso «vIPI», vero per tre schede su quattro: non distingueva
               niente e pagava larghezza su ognuna. *@
            @* ⚠️ NON `.seg`: quella e' la classe di un segmented control che riempie la riga
               (`.seg button{flex:1}`), e qui stirava le quattro schede a 375px l'una su uno schermo largo.
               Stessa famiglia della trappola di `.se-row input{flex:1}` su Sorgenti: una classe pensata per
               un uso, riusata dove la sua regola non serve. *@
            <div class="nd-seg">
                <button class="btn @(_kind == Kind.Acc ? "primary" : "ghost")" @onclick="() => Scheda(Kind.Acc)"><Icon Name="map" Size="14" /> @L["Nd_KindAcc"]</button>
                <button class="btn @(_kind == Kind.App ? "primary" : "ghost")" @onclick="() => Scheda(Kind.App)"><Icon Name="plane-landing" Size="14" /> @L["Nd_KindApp"]</button>
                <button class="btn @(_kind == Kind.Airport ? "primary" : "ghost")" @onclick="() => Scheda(Kind.Airport)"><Icon Name="plane-takeoff" Size="14" /> @L["Nd_KindAirport"]</button>
                <button class="btn @(_kind == Kind.Vloa ? "primary" : "ghost")" @onclick="() => Scheda(Kind.Vloa)"><Icon Name="file" Size="14" /> vLOA</button>
            </div>

            @* La barra del lock si vede SOLO sulla scheda che crea davvero. Sulle altre tre non c'è niente da
               serializzare: aprire un editor prende il lock DI QUEL DOCUMENTO, che è un'altra cosa e la
               gestisce l'editor. Prima stava sopra le schede e prometteva di valere per tutte e quattro. *@
            @if (_kind == Kind.Vloa)
            {
                <EditLockBar ResourceKey="@ResourceLockKeys.NewDoc" LockChanged="OnLockChanged" />
            }

            @if (_msg is not null)
            {
                <div class="callout warning nd-msg">
                    <span class="cic"><Icon Name="warning" Size="18" /></span>
                    <div>
                        @_msg
                        @* Se il rifiuto è «esiste già», si offre di aprirla: dire di no senza dire dove è
                           mezza risposta. *@
                        @if (_vloaEsistente is { } coppia)
                        {
                            <span>&nbsp;</span><a class="lnk-mini" href="@VloaUrl(coppia.Home, coppia.Estero)">@L["Nd_OpenExisting"]</a>
                        }
                    </div>
                </div>
            }

            @if (_kind == Kind.Vloa)
            {
                <div class="nd-form">
                    <div class="nd-grid">
                        <div class="field"><label>@L["Nd_LblTitle"]</label>
                            <input placeholder="@L["Nd_TitlePh"]" @bind="_docTitle" @bind:event="oninput" />
                        </div>
                        <div class="field"></div>

                        <div class="field"><label>@L["Nd_HomeAcc"]</label>
                            <select value="@_homeAcc" @onchange="OnHomeAccChanged">
                                <option value="">@L["Nd_AccOption"]</option>
                                @foreach (var a in _opts.MyAccs) { <option value="@a.Code">@a.Code · @a.Name</option> }
                            </select>
                        </div>
                        <div class="field"><label>@L["Nd_HomeSector"]</label>
                            <select @bind="_docHome" disabled="@(string.IsNullOrEmpty(_homeAcc))">
                                <option value="0">@L["Nd_SectorOption"]</option>
                                @foreach (var s in SettoriHome()) { <option value="@s.Id">@s.Label</option> }
                            </select>
                        </div>

                        <div class="field"><label>@L["Nd_NeighAcc"]</label>
                            <select value="@_neighAcc" @onchange="OnNeighAccChanged">
                                <option value="">@L["Nd_AccOption"]</option>
                                @foreach (var a in _opts.ForeignAccs) { <option value="@a.Code">@a.Code · @a.Name</option> }
                            </select>
                        </div>
                        <div class="field"><label>@L["Nd_NeighSector"]</label>
                            <select @bind="_docNeighbour" disabled="@(string.IsNullOrEmpty(_neighAcc))">
                                <option value="0">@L["Nd_SectorOption"]</option>
                                @foreach (var s in SettoriNeighbour()) { <option value="@s.Id">@s.Label</option> }
                            </select>
                        </div>
                    </div>

                    @* ⚠️ Il tasto sta in FONDO, dove finisce quello che gli serve. Prima stava dopo il titolo e
                       sopra i quattro menu obbligatori: si leggeva come se «titolo + Crea» bastasse, e chi lo
                       premeva otteneva «Seleziona il settore Home e il settore Neighbour» — un errore che la
                       pagina causava con la propria disposizione. Nessuna misura lo trova. *@
                    <div class="nd-actions">
                        <button class="btn primary" disabled="@(_busy || !_canEdit || !VloaPronta)" @onclick="CreateVloa">
                            @L["Nd_CreateOpen"]
                        </button>
                        @if (!_canEdit)
                        {
                            @* Il perché del tasto spento sta ACCANTO al tasto, non solo nella barra in cima. *@
                            <span class="muted nd-hint">@L["Nd_NeedLock"]</span>
                        }
                        else if (!VloaPronta)
                        {
                            <span class="muted nd-hint">@L["Nd_SelectHomeNeigh"]</span>
                        }
                    </div>

                    @if (_opts.ForeignAccs.Count == 0)
                    {
                        @* I messaggi «non c'è niente qui» restano in pagina: non sono prosa d'aiuto, sono la
                           RISPOSTA a una tendina vuota, e dicono dove si rimedia. *@
                        <p class="help nd-vuoto">@L["Nd_NoForeignAcc"]</p>
                    }
                </div>
            }
            else
            {
                <div class="nd-form">
                    <div class="nd-grid">
                        <div class="field"><label>@L["Nd_Acc"]</label>
                            <select value="@_selAcc" @onchange="OnAccChanged">
                                <option value="">@L["Nd_AccOption"]</option>
                                @foreach (var a in _opts.MyAccs) { <option value="@a.Code">@a.Code · @a.Name</option> }
                            </select>
                        </div>
                        @if (_kind != Kind.Acc)
                        {
                            <div class="field"><label>@(_kind == Kind.App ? L["Nd_StandaloneApp"] : L["Nd_Airport"])</label>
                                <select value="@_selKey" @onchange="OnTargetChanged" disabled="@(string.IsNullOrEmpty(_selAcc))">
                                    <option value="">@(_kind == Kind.App ? L["Nd_AppOption"] : L["Nd_IcaoOption"])</option>
                                    @* ⚠️ L'etichetta dice «solo militare» nella TENDINA e non solo dopo aver
                                       scelto: è l'informazione che cambia quale documento nascerà, e chi
                                       sceglie deve averla PRIMA di scegliere, non come sorpresa dopo. *@
                                    @foreach (var t in Bersagli()) { <option value="@t.Key">@t.Label@(t.IsMilitaryOnly ? $" · {L["Mil_OnlyMilitary"].Value}" : "")</option> }
                                </select>
                            </div>
                        }
                    </div>

                    <div class="nd-actions">
                        @* ⚠️ Il tasto dice se CREA o se APRE. La pagina si chiama «Nuovo documento» e per tre
                           tipi su quattro apre l'esistente — l'editor crea solo se manca. Non è un divieto:
                           aprire ciò che c'è è quasi sempre quello che si vuole. È un'etichetta che smette di
                           mentire. *@
                        <button class="btn primary" disabled="@(_busy || !BersaglioScelto)" @onclick="ApriEditor">
                            @(EsisteGia ? L["Nd_OpenEditor"] : L["Nd_CreateOpen"])
                        </button>
                        @if (BersaglioScelto && EsisteGia)
                        {
                            <span class="pill blue nd-hint">@L["Nd_AlreadyExists"]</span>
                        }
                    </div>

                    @* ---- Cosa nascerà davvero, sui campi militari (carta vSOP militari §5-bis) ----------
                       Le due righe qui sotto non sono decorazione: la scheda si chiama «Aeroporto» e su un
                       campo solo militare NON crea una vIPI d'aeroporto. Senza dirlo, il tasto porterebbe a
                       un editor diverso da quello che il suo nome promette. *@
                    @if (Militare() is { IsMilitaryOnly: true })
                    {
                        @* ⚠️ MarkupString: queste due frasi portano un `<b>` e un collegamento, come già
                           `Nd_NoAirports` qui sotto. Senza, i tag si leggerebbero a schermo. *@
                        <p class="help nd-vuoto">@((MarkupString)L["Nd_MilOnlyHint"].Value)</p>
                    }
                    else if (Militare() is { HasMilitaryPresence: true } m)
                    {
                        <p class="help nd-vuoto">
                            @((MarkupString)(m.HasDocument ? L["Nd_MilAfterCivilReady"].Value : L["Nd_MilAfterCivilHint"].Value))
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(_selAcc) && _kind == Kind.App && Bersagli().Count == 0)
                    {
                        <p class="help nd-vuoto">@((MarkupString)string.Format(L["Nd_NoStandalone"].Value, _selAcc))</p>
                    }
                    @if (!string.IsNullOrEmpty(_selAcc) && _kind == Kind.Airport && Bersagli().Count == 0)
                    {
                        <p class="help nd-vuoto">@((MarkupString)string.Format(L["Nd_NoAirports"].Value, _selAcc))</p>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private enum Kind { Acc, App, Airport, Vloa }

    /// <summary>La scheda aperta. Parte da ACC: la vLOA è il documento più raro e apriva il form più lungo.</summary>
    private Kind _kind = Kind.Acc;

    private NewDocumentOptions? _opts;

    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock "nuovo documento" (EditLockBar)
    private string? _msg;
    private (string Home, string Estero)? _vloaEsistente;
    private string _docTitle = "";

    // vLOA
    private string? _homeAcc, _neighAcc;
    private int _docHome, _docNeighbour;

    // ACC / APP / Aeroporto: bersaglio scelto
    private string _selAcc = "";
    private string _selKey = "";

    /// <summary>
    /// Risolto dallo scope PROPRIO della pagina (<c>OwningComponentBase</c>): contesto isolato da quello del
    /// circuito, che la sessione condivide con barra, isole e pannelli. Due operazioni sovrapposte sullo
    /// stesso contesto danno «<c>A second operation was started on this context</c>» e uccidono il circuito.
    /// </summary>
    private IEditingService Editing = default!;

    /// <summary>
    /// L'edizione militare. ⚠️ Stesso scope proprio di <c>Editing</c>, e per lo stesso motivo: qui si passa
    /// da <c>CreaAsync</c>, che <b>crea il documento</b>. Con <c>@@inject</c> quella scrittura andava sul
    /// <c>DbContext</c> del circuito — è il difetto che il 3 settembre 2026 ha prodotto in produzione nove
    /// pagine d'errore, da un componente che chiamava esattamente questo metodo.
    /// </summary>
    private IMilitaryDocumentService Militari = default!;

    protected override async Task OnInitializedAsync()
    {
        Editing = ScopedServices.GetRequiredService<IEditingService>();
        Militari = ScopedServices.GetRequiredService<IMilitaryDocumentService>();
        _opts = await Options.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ⚠️ `vipiCapViewport` (max-height), non `vipiFitViewport` (height): il contenuto è corto e FISSO —
        // quattro schede e tendine che non crescono — quindi stirare il riquadro lascerebbe mezzo pannello
        // di bianco (lezione di Sorgenti, regola 150). Ma senza misura affatto **sotto zoom** non ci stava
        // più: a 1.25 la pagina tornava a scorrere di 50px, a 1.5 di 232. Il tetto fa entrambe le cose.
        // A ogni render: cambiare scheda cambia l'altezza, e il «?» aperto cambia ciò che sta sopra.
        try { await JS.InvokeVoidAsync("vipiCapViewport", ".nd-pane", 900); } catch (Exception) { }
    }

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    /// <summary>Cambiare scheda azzera la scelta: un bersaglio scelto per gli aeroporti non vale per gli APP,
    /// e lasciarlo lì farebbe apparire pronto un modulo che non lo è.</summary>
    private void Scheda(Kind k)
    {
        _kind = k;
        _selKey = "";
        _msg = null;
        _vloaEsistente = null;
    }

    // ---- vLOA ------------------------------------------------------------------------------------------

    private IReadOnlyList<NewDocumentTarget> SettoriHome() =>
        _opts?.MyAccs.FirstOrDefault(a => a.Code == _homeAcc)?.AreaSectors ?? Array.Empty<NewDocumentTarget>();

    private IReadOnlyList<NewDocumentTarget> SettoriNeighbour() =>
        _opts?.ForeignAccs.FirstOrDefault(a => a.Code == _neighAcc)?.AreaSectors ?? Array.Empty<NewDocumentTarget>();

    private bool VloaPronta => _docHome != 0 && _docNeighbour != 0 && !string.IsNullOrWhiteSpace(_docTitle);

    private void OnHomeAccChanged(ChangeEventArgs e)
    {
        _homeAcc = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _docHome = 0;
        _msg = null; _vloaEsistente = null;
    }

    private void OnNeighAccChanged(ChangeEventArgs e)
    {
        _neighAcc = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _docNeighbour = 0;
        _msg = null; _vloaEsistente = null;
    }

    private static string VloaUrl(string homeAcc, string esteroAcc) =>
        $"/services/vsop/{homeAcc.ToLowerInvariant()}/vloa/editor?acc={esteroAcc.ToUpperInvariant()}";

    private async Task CreateVloa()
    {
        _busy = true; _msg = null; _vloaEsistente = null;
        try
        {
            await Editing.CreateDocumentAsync(DocumentType.Vloa, _docTitle,
                scopeSectorIds: null, primarySectorId: null, homeSectorId: _docHome, neighbourSectorId: _docNeighbour);

            if (string.IsNullOrEmpty(_homeAcc) || string.IsNullOrEmpty(_neighAcc)) { _msg = L["Nd_CannotResolveHome"]; return; }
            // La vLOA si edita dall'editor per coppia (keyed sull'ACC estero). forceLoad: versione appena creata.
            Nav.NavigateTo(VloaUrl(_homeAcc, _neighAcc), forceLoad: true);
        }
        catch (ValidationException ex)
        {
            _msg = ex.Message;
            // «Esiste già» non è un vicolo cieco: si offre di aprirla. Il servizio è la guardia (un tasto
            // spento non lo è mai stato), la pagina aggiunge la via d'uscita.
            if (!string.IsNullOrEmpty(_homeAcc) && !string.IsNullOrEmpty(_neighAcc))
                _vloaEsistente = (_homeAcc, _neighAcc);
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // ---- ACC / APP / Aeroporto -------------------------------------------------------------------------

    private NewDocumentAcc? AccScelto() => _opts?.MyAccs.FirstOrDefault(a => a.Code == _selAcc);

    private IReadOnlyList<NewDocumentTarget> Bersagli() => _kind switch
    {
        Kind.App => AccScelto()?.StandaloneApps ?? Array.Empty<NewDocumentTarget>(),
        Kind.Airport => AccScelto()?.Airports ?? Array.Empty<NewDocumentTarget>(),
        _ => Array.Empty<NewDocumentTarget>(),
    };

    /// <summary>Per l'ACC il bersaglio è l'ACC stesso: scelto quello, si è pronti.</summary>
    private bool BersaglioScelto => _kind == Kind.Acc
        ? !string.IsNullOrEmpty(_selAcc)
        : !string.IsNullOrEmpty(_selKey);

    /// <summary>Il bersaglio scelto, quando ce n'è uno. Null sulla scheda ACC (il bersaglio è l'ACC).</summary>
    private NewDocumentTarget? Scelto() => Bersagli().FirstOrDefault(t => t.Key == _selKey);

    /// <summary>Il bersaglio scelto se è un AEROPORTO con qualcosa di militare da dire; null altrimenti.
    /// ⚠️ Filtra anche sulla scheda: un APP standalone non ha edizioni, e i suoi flag stanno a riposo.</summary>
    private NewDocumentTarget? Militare() =>
        _kind == Kind.Airport && Scelto() is { } t && (t.HasMilitaryPresence || t.IsMilitaryOnly) ? t : null;

    /// <summary>
    /// Vero se il documento del bersaglio scelto c'è già: allora il tasto dice «Apri».
    /// <para>⚠️ Su un campo SOLO MILITARE la domanda cambia documento: l'unica edizione è il vSOP militare,
    /// quindi è <c>HasMilDocument</c> a decidere. Guardando <c>HasDocument</c> il tasto direbbe «Crea» su un
    /// vSOP che esiste già, e «Apri» su una vIPI civile che non nascerà mai.</para>
    /// </summary>
    private bool EsisteGia => _kind switch
    {
        Kind.Acc => AccScelto()?.AreaSectors.Any(s => s.HasDocument) == true,
        Kind.Airport when Scelto() is { IsMilitaryOnly: true } t => t.HasMilDocument,
        _ => Scelto()?.HasDocument == true,
    };

    // ⚠️ Cambiare ACC o bersaglio spegne il messaggio: un rifiuto riguarda IL bersaglio che l'ha causato, e
    // lasciarlo acceso su un altro lo farebbe sembrare rifiutato anche lui.
    private void OnAccChanged(ChangeEventArgs e)
    {
        _selAcc = e.Value?.ToString() ?? "";
        _selKey = "";
        _msg = null;
    }

    private void OnTargetChanged(ChangeEventArgs e)
    {
        _selKey = e.Value?.ToString() ?? "";
        _msg = null;
    }

    // L'editor crea il documento all'apertura (EnsureAsync). Le rotte vengono dal registry doc 09.
    //
    // ⚠️ L'ECCEZIONE È IL CAMPO SOLO MILITARE. L'editor del vSOP militare non crea niente all'apertura — e
    // fa bene, è una pagina che si raggiunge anche in lettura — quindi qui il documento si crea PRIMA e poi
    // ci si va. È l'unica delle cinque famiglie in cui questa pagina scrive davvero, oltre alla vLOA.
    private async Task ApriEditor()
    {
        var acc = _selAcc.ToLowerInvariant();
        _msg = null;

        if (_kind == Kind.Airport && Scelto() is { IsMilitaryOnly: true })
        {
            _busy = true;
            try
            {
                // Idempotente: se il vSOP c'è già torna il suo id, e questa è anche la via dell'«Apri».
                await Militari.CreaAsync(_selKey);
            }
            catch (ValidationException ex) { _msg = ex.Message; return; }
            catch (EditNotAllowedException ex) { _msg = ex.Message; return; }
            finally { _busy = false; }

            var milUrl = DocRoutes.For(ReleaseTargetType.AirportMil).EditorUrl(acc, _selKey, null, null);
            if (milUrl is not null) Nav.NavigateTo(milUrl, forceLoad: true);
            return;
        }

        var url = _kind switch
        {
            Kind.Acc => DocRoutes.For(ReleaseTargetType.AccVipi).EditorUrl(acc, "", null, null),
            Kind.App => DocRoutes.For(ReleaseTargetType.App).EditorUrl(acc, _selKey, null, null),
            _ => DocRoutes.For(ReleaseTargetType.Airport).EditorUrl(acc, _selKey, null, null),
        };
        if (url is not null) Nav.NavigateTo(url, forceLoad: true);
    }
}
