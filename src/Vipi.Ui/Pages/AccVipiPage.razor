@page "/services/vsop/{Acc}/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IAccDerivationService Profile
@inject IAccViewDerivationService ViewDeriv
@inject IAccDocumentService AccDoc
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject IAiracService Airac
@inject IStringLocalizer<SharedResource> L
@inject StringheDelSito Sito
@inject Vipi.Application.Translation.AccVipiTranslator Translator
@inject Vipi.Application.Content.ReadingLanguageContext Lingua
@inject EnglishStrings En
@using System.Globalization
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@Sito["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_notAvailable)
{
    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>vIPI</b></div>
        <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@Sito["AccVipi_NotAvailTitle"]</p>@((MarkupString)string.Format(Sito["AccVipi_NotAvailBody"], _acc.Code, $"/services/vsop/{Acc.ToLowerInvariant()}/editor"))</div></div>
    </div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()vIPI @_data.AccName · IVAO Italy</PageTitle>
    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_data.AccCode</a> › <b>vIPI</b></div>
        <div class="doc-layout">
            <aside class="toc" aria-label="@Sito["Doc_TocAria"]">
                <p class="toc-h">@Sito["Common_Navigation"]</p>
                @foreach (var block in _data.Blocks)
                {
                    <p class="toc-grp">@(block.Kind == AccBlockKind.Aerovia ? L["AccVipi_AirwaySectors"] : block.Title)</p>
                    <ul>
                        @foreach (var s in VisibleSections(block))
                        {
                            <li><a class="lvl2" href="#@AnchorOf(block, s)">@s.Title</a></li>
                        }
                    </ul>
                }
            </aside>

            <div>
                <PrintMeta Title="@($"vIPI — {_data.AccName}")" Subtitle="@Sito["AccVipi_Subtitle"]"
                           AiracCycle="@Cycle()" />
                <div class="doc-head">
                    <div><h1 class="page-h1" style="margin-bottom:2px">vIPI — @_data.AccName</h1><span class="muted">@Sito["AccVipi_Subtitle"] · <SimDisclaimer /></span></div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@Sito["Common_Print"]</button>
                        <a class="btn ghost" href="/services/vsop/live">@Sito["Common_Operational"]</a>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/editor@(TreeQuery())">@Sito["Common_Editor"]</a>
                        }
                    </div>
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vipi")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vipi?as=draft")" />
                }

                @* Tradotto a macchina e non ancora riletto, o tradotto a metà: chi legge deve saperlo. *@
                <TranslationNotice Coverage="_copertura" />
                @* Oppure il contrario: NON tradotto, e voluto. *@
                <LinguaBloccataNotice Lingua="@_bloccata" />

                @* Il filtro di lettura pilota/ATC (carta vSOP militari §3). ⚠️ Vale su TUTTE le famiglie, non
                   solo sul vSOP militare: il flag è per-sezione e l'editor lo offre ovunque, quindi una
                   sezione marcata in una vIPI ACC deve poter essere filtrata dove si legge. La chip resta
                   invisibile finché nessuno ha marcato niente. *@
                <AudienceChip Visibile="_haMarcate" Vista="_vista"
                              BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vipi" + (_mode.Kind == PreviewKind.Draft ? "?as=draft" : ""))" />

                @* `lang` sul CONTENITORE dei blocchi: il chrome parla la lingua del sito, il documento la sua. *@
                <div lang="@_bloccata">
                @foreach (var block in _data.Blocks)
                {
                    <h2 class="acc-block-h">@(block.Kind == AccBlockKind.Aerovia ? L["AccVipi_AirwaySectors"] : block.Title)</h2>
                    @foreach (var s in VisibleSections(block))
                    {
                        var isHidden = s.IsHidden;
                        <CollapsibleBlock Id="@AnchorOf(block, s)" Style="@(isHidden ? "opacity:.65" : null)"
                                          InitiallyOpen="@(!SectionCatalog.IsInitiallyCollapsed(s.Key))">
                            <Header><h3>@s.Title @if (isHidden) { <span class="pill neutral" style="font-weight:500">@L["Common_HiddenNotPublic"]</span> }<AudienceBadge Audience="s.Audience" /></h3></Header>
                            <ChildContent>
                                <AccSectionBody Block="block" Key="@s.Key" Root="@_root" Acc="@Acc"
                                                ReleaseId="@(_mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null)"
                                                Editorial="s.Editorial"
                                                Freqs="_freqs.GetValueOrDefault(block.Key)"
                                                Coord="_coord.GetValueOrDefault(block.Key)"
                                                Aor="_aors.GetValueOrDefault(block.Key)"
                                                Areas="_areas.GetValueOrDefault(block.Key)"
                                                Minima="_minima.GetValueOrDefault(block.Key)"
                                                ConfigTables="_configTables.GetValueOrDefault(block.Key)" />
                            </ChildContent>
                        </CollapsibleBlock>
                    }
                }
                </div>
            </div>

            <aside class="doc-rail" aria-label="@Sito["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @Sito["Common_Summary"]</h5>
                    @* Il ciclo del DOCUMENTO che si sta guardando, non quello di oggi (doc 13 §3h): il corpo è lo
                       snapshot congelato di una release, e scriverci accanto il ciclo corrente è un dato falso. *@
                    <div class="rail-line"><span class="muted">@Sito["Common_AiracCycle"]</span><b>@Cycle()</b></div>
                    <div class="rail-line"><span class="muted">@Sito["Common_AtcOnline"]</span>
                        @{ var n = OnlineCount(); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @Sito["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@Sito["Common_Home"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @_data.AccCode</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/airports">@Sito["AccLanding_Airports"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/apps">@Sito["AccLanding_Apps"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/vloa">vLoA</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Tree { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero (carta vSOP
    /// militari §3). ⚠️ In QUERY STRING e non in stato d'isola: questa pagina è SSR statica, e un link
    /// filtrato è condivisibile.</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    private Vipi.Domain.SectionAudience? _vista;
    private bool _haMarcate;

    private AccInfo? _acc;
    private AccVipiData _data = new() { AccCode = "", AccName = "", Blocks = new() };
    private IReadOnlyList<AccAssembledBlock>? _blocks;   // blocchi con Id sezione (view/draft); null in anteprima release
    private bool _useFrozen;                              // vista pubblica: leggi frozen dalla release effettiva
    private bool _notAvailable;                           // vista pubblica senza release effettiva → "non disponibile" (doc 10 §S6b)
    private bool _canEdit;
    private IReadOnlyList<AccTreeRoot> _roots = Array.Empty<AccTreeRoot>();
    private string? _root;
    private PreviewMode _mode;
    private string? _relCycle;      // anteprima release: ciclo di quella release
    private string? _docCycle;      // vista pubblica: ciclo della release effettiva da cui viene lo snapshot

    // Lettura bilingue (carta 2026-08-27 §7): la lingua in cui il documento è REDATTO e le traduzioni che la
    // release ha congelato. Nulle in bozza — una bozza non ha ancora congelato niente, e la sorgente è quella
    // in cui la famiglia nasce.
    private Vipi.Domain.Language? _lingua;

    /// <summary>Vero se questa vIPI si legge SEMPRE nella lingua in cui è scritta (carta lingua-bloccata).</summary>
    private bool _bloccato;

    /// <summary>La lingua del blocco, o null se il documento segue chi legge: serve all'avviso e al
    /// <c>lang</c> del contenitore.</summary>
    private string? _bloccata;
    private Dictionary<string, Dictionary<string, FrozenTranslation>>? _congelate;
    private Vipi.Application.Translation.TranslationCoverage _copertura =
        Vipi.Application.Translation.TranslationCoverage.Nessuna;

    /// <summary>Ciclo AIRAC da mostrare: quello del documento mostrato; in lavorazione (bozza) quello corrente.</summary>
    private string Cycle() => _relCycle ?? _docCycle ?? Airac.GetCycle(DateTime.UtcNow);

    private readonly Dictionary<string, List<AppFreqRow>> _freqs = new();
    private readonly Dictionary<string, AccCoordination> _coord = new();
    private readonly Dictionary<string, AccAorView> _aors = new();
    private readonly Dictionary<string, MinimaView> _minima = new();
    private readonly Dictionary<string, IReadOnlyList<AccSpecialAreaView>> _areas = new();
    private readonly Dictionary<string, IReadOnlyList<AccConfigTableView>> _configTables = new();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        // Scalda le cache del resolver ORA (context libero): OnlineCount() nel render usa ResolveByCallsign
        // senza toccare il DB → niente crash "second operation" su Postgres.
        Stations.Prewarm();

        // vIPI ACC = una sola per ACC: sempre il CTR radice primario. Il parametro ?tree è ignorato (nessun selettore).
        _roots = await Profile.ListTreeRootsAsync(Acc);
        _root = ResolveTree(null, _roots);

        _mode = PreviewMode.Parse(As);
        _relCycle = null;
        _haMarcate = false;
        _docCycle = null;
        _blocks = null;
        _useFrozen = false;
        _notAvailable = false;
        _lingua = null;
        _bloccato = false;
        _congelate = null;
        _copertura = Vipi.Application.Translation.TranslationCoverage.Nessuna;
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                try { var m = await AccDoc.LoadForEditAsync(Acc); _data = m.Data; _blocks = m.Blocks; }
                catch (EditNotAllowedException) { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                catch (ValidationException) { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                break;
            case PreviewKind.Release:
                AccReleaseView? rv = null;
                try { rv = await AccDoc.LoadForReleaseAsync(Acc, _mode.ReleaseId); }
                catch (EditNotAllowedException) { }
                if (rv is not null) { _data = rv.Data; _relCycle = rv.AiracCycle; _lingua = rv.Language; _bloccato = rv.LanguageLocked; _congelate = rv.Translations; }   // anteprima release: derive live (no ids)
                else { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                break;
            default:
                LoadViewModel(await AccDoc.LoadForViewAsync(Acc));   // vista pubblica: frozen dalla release effettiva
                break;
        }
        _canEdit = Authz.IsEditor;

        // ---- In che lingua si legge QUESTA vIPI (carta 2026-08-31-lingua-bloccata.md §3-4) --------------
        // ⚠️ PRIMA delle derivazioni, che qui sono parecchie e compongono prosa: frasi di coordinamento,
        // etichette delle AoR, intestazioni. Deciderla in fondo, insieme alla traduzione, vorrebbe dire
        // derivare nella lingua di chi guarda e tradurre il resto nell'altra.
        var lettore = LinguaDelDocumento.Prepara(Lingua, _bloccato, _lingua, Vipi.Domain.Language.It);
        _bloccata = _bloccato ? lettore : null;

        _freqs.Clear(); _coord.Clear(); _aors.Clear(); _areas.Clear(); _configTables.Clear();
        if (_blocks is not null)
        {
            // freq/coord/aor risolti dal service (frozen se pubblica + release effettiva, sennò live); aree/config-table
            // sempre live (derivano da input già congelati). doc 10 §3d.
            var derived = await ViewDeriv.ResolveForViewAsync(Acc, _blocks, _useFrozen);
            foreach (var b in _data.Blocks)
            {
                _freqs[b.Key] = derived.Freqs.GetValueOrDefault(b.Key)?.ToList() ?? new();
                _coord[b.Key] = derived.Coord.GetValueOrDefault(b.Key) ?? AccCoordination.Empty;
                _aors[b.Key] = derived.Aor.GetValueOrDefault(b.Key) ?? AccAorView.Empty;
                _minima[b.Key] = derived.Minima.GetValueOrDefault(b.Key) ?? MinimaView.Empty;
                _areas[b.Key] = await Profile.GetAttachedSpecialAreasAsync(Acc, b);
                _configTables[b.Key] = await Profile.DeriveConfigTableAsync(Acc, b, _root);
            }
        }
        else
        {
            // Anteprima release (nessun Id sezione): deriva tutto live come prima.
            foreach (var b in _data.Blocks)
            {
                _freqs[b.Key] = (await Profile.DeriveFrequenciesAsync(Acc, b, _root)).ToList();
                _coord[b.Key] = await Profile.DeriveCoordinationAsync(Acc, b, _root);
                _aors[b.Key] = await Profile.DeriveAorViewAsync(Acc, b, _root);
                _minima[b.Key] = await Profile.DeriveMinimaAsync(Acc, b, _root);
                _areas[b.Key] = await Profile.GetAttachedSpecialAreasAsync(Acc, b);
                _configTables[b.Key] = await Profile.DeriveConfigTableAsync(Acc, b, _root);
            }
        }

        // ---- Lettura bilingue (carta 2026-08-27 §7) --------------------------------------------------
        // ⚠️ La lingua di lettura è quella dell'INTERFACCIA, non un secondo selettore: la sceglie la chip
        // della barra, che scrive il cookie di cultura — l'unico modo perché la scelta sopravviva al
        // circuito, che su /_blazor non porta ?culture=.
        //
        // ⚠️ IN FONDO, dopo TUTTE le derivazioni: quelle leggono dai blocchi i settori membri, le
        // configurazioni e le chiavi, e il traduttore i blocchi li modifica sul posto. Le sezioni derivate si
        // traducono per conto loro, dalla parte dell'anagrafica (TranslationLookup): qui passa solo la prosa
        // editoriale, che è la parte che questa pagina mostrava ancora in italiano soltanto.
        _copertura = await Translator.TranslateAsync(_data, _lingua, lettore, _congelate);

        // I titoli delle sezioni di CATALOGO nella lingua di lettura, DOPO la traduzione e sul posto come
        // lei.
        //
        // ⚠️ Non è un doppione: quei titoli stanno scritti nel documento nella lingua che aveva alla
        // NASCITA — l'assembler risolve dal catalogo solo le sezioni che il documento non ha MAI scritto —
        // e la passata li copre solo finché c'è una passata. Su una vIPI BLOCCATA la traduzione è spenta per
        // definizione (sorgente == bersaglio), e senza questo passo una vIPI dichiarata inglese mostrava
        // «Separazioni radar / Configurazioni / Aree regolamentate».
        // ⚠️ Il profilo lo dice il BLOCCO, non la pagina: Aerovia e gruppo-APP hanno cataloghi diversi.
        TitoliDiCatalogo.Applica(_data, lettore);

        // Il filtro di lettura, DOPO la traduzione: si filtra la vista che il lettore vedrà davvero.
        _vista = AudienceFilter.Leggi(Vista);
        _haMarcate = _data.Blocks.Any(b => b.Sections.Any(
            s => s.Audience != Vipi.Domain.SectionAudience.Both
                 || (s.Editorial is not null && AudienceFilter.HaSezioniMarcate(s.Editorial.Children))));
    }

    // Vista pubblica dal modello ACC: dati + blocchi con Id sezione, e abilita la lettura frozen. model null (nessuna
    // release effettiva, doc 10 §S6b) → "non disponibile".
    private void LoadViewModel(AccDocumentModel? model)
    {
        if (model is null) { _notAvailable = true; return; }
        _data = model.Data;
        _blocks = model.Blocks;
        _docCycle = model.AiracCycle;
        _lingua = model.Language;
        _bloccato = model.LanguageLocked;
        _congelate = model.Translations;
        _useFrozen = true;
    }

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => $"{Sito["Common_DraftTag"]} ",
        PreviewKind.Release => $"{Sito["Common_PreviewTag"]} ",
        _ => "",
    };

    // ATC online dell'ACC (include gli aeroporti sotto l'ACC), come sulla home /services/vsop.
    private int OnlineCount()
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
            Stations.ResolveByCallsign(cs)?.Code.Equals(_data.AccCode, StringComparison.OrdinalIgnoreCase) == true);
    }

    // Ancora di sezione: «s-{Id}», come in tutte le altre famiglie (doc 13 §3e). Serve ai deep-link della
    // ricerca, che indicizza le sezioni per Id e prima cadeva in cima alla pagina perché qui l'ancora era
    // «p-{blocco}-{chiave}». Le sezioni sintetizzate dall'assembler (di catalogo, assenti dal documento) non
    // hanno Id: là resta la chiave, e nessuno ci fa deep-link perché non hanno contenuto.
    private static string AnchorOf(AccBlock block, AccBlockSection s) =>
        s.SectionId > 0 ? $"s-{s.SectionId}" : $"p-{block.Key}-{s.Key}";

    // vIPI ACC unica per ACC: nessun ?tree nei link (il root primario è implicito).
    private string TreeQuery() => "";

    private static string? ResolveTree(string? tree, IReadOnlyList<AccTreeRoot> roots)
    {
        if (!string.IsNullOrWhiteSpace(tree))
        {
            var match = roots.FirstOrDefault(r => string.Equals(r.Callsign, tree, StringComparison.OrdinalIgnoreCase));
            if (match is not null) return match.Callsign;
        }
        return roots.Count > 0 ? roots[0].Callsign : null;
    }

    // Sezioni da mostrare, NELL'ORDINE del documento (doc 11 §3b: si itera la lista di sezioni, non un elenco di
    // chiavi riconciliato a view-time). Anteprima BOZZA: mostra anche le nascoste (stato editoriale in lavorazione),
    // marcate; pubblica/release: filtrate. Lo stato «nascosta» è sulla sezione e versionato (doc 11 §3c).
    // ⚠️ E il filtro pilota/ATC, che è una domanda DIVERSA da «nascosta»: nascosta vuol dire «non è
    // pubblica», filtrata vuol dire «non serve a chi sta leggendo adesso». Le sezioni «per tutti» non si
    // filtrano mai, e una sezione che se ne va porta via i suoi figli.
    private IReadOnlyList<AccBlockSection> VisibleSections(AccBlock b) =>
        b.Sections
            .Where(s => _mode.Kind == PreviewKind.Draft || !s.IsHidden)
            .Where(s => AudienceFilter.Mostra(s.Audience, _vista))
            .Select(s => s.Editorial is null ? s : s with { Editorial = AudienceFilter.FiltraFigli(s.Editorial, _vista) })
            .ToList();
}
