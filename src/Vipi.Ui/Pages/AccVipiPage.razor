@page "/vsop/{Acc}/vipi"
@layout SopLayout
@inject IStationResolver Stations
@inject IAccDerivationService Profile
@inject IAccViewDerivationService ViewDeriv
@inject IAccDocumentService AccDoc
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject IAiracService Airac
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()vIPI @_data.AccName · IVAO Italia</PageTitle>
    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_data.AccCode</a> › <b>vIPI</b></div>
        <div class="doc-layout">
            <aside class="toc">
                <p class="toc-h">Navigazione</p>
                @foreach (var block in _data.Blocks)
                {
                    <p class="toc-grp">@(block.Kind == AccBlockKind.Aerovia ? "Settori di aerovia" : block.Title)</p>
                    <ul>
                        @foreach (var key in OrderOf(block))
                        {
                            <li><a class="lvl2" href="#p-@(block.Key)-@key">@TitleOf(block, key)</a></li>
                        }
                    </ul>
                }
            </aside>

            <div>
                <div class="doc-head">
                    <div><h2 style="margin-bottom:2px">vIPI — @_data.AccName</h2><span class="muted">Istruzioni di posizione · settori di aerovia e avvicinamenti</span></div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/operativa">⚡ Operativa</a>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/vsop/@Acc.ToLowerInvariant()/editor@(TreeQuery())">✎ Editor</a>
                        }
                    </div>
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/vsop/{Acc.ToLowerInvariant()}/vipi")"
                                   DraftHref="@($"/vsop/{Acc.ToLowerInvariant()}/vipi?as=draft")" />
                }

                @foreach (var block in _data.Blocks)
                {
                    <h2 class="acc-block-h">@(block.Kind == AccBlockKind.Aerovia ? "Settori di aerovia" : block.Title)</h2>
                    @foreach (var key in OrderOf(block))
                    {
                        var isHidden = IsHiddenSection(block, key);
                        <CollapsibleBlock Id="@($"p-{block.Key}-{key}")" Style="@(isHidden ? "opacity:.65" : null)">
                            <Header><h3>@TitleOf(block, key) @if (isHidden) { <span class="pill" style="background:#eef1f7;color:#57606a;font-weight:500">🚫 nascosta (non nel pubblico)</span> }</h3></Header>
                            <ChildContent>
                                <AccSectionBody Block="block" Key="@key" Root="@_root"
                                                Freqs="_freqs.GetValueOrDefault(block.Key)"
                                                Coord="_coord.GetValueOrDefault(block.Key)"
                                                Aor="_aors.GetValueOrDefault(block.Key)"
                                                Areas="_areas.GetValueOrDefault(block.Key)"
                                                ConfigTables="_configTables.GetValueOrDefault(block.Key)" />
                            </ChildContent>
                        </CollapsibleBlock>
                    }
                }
            </div>

            <aside class="doc-rail">
                <div class="rail-card">
                    <h5>📋 Riepilogo</h5>
                    <div class="rail-line"><span class="muted">Ciclo AIRAC</span><b>@Airac.GetCycle(DateTime.UtcNow)</b></div>
                    <div class="rail-line"><span class="muted">ATC online</span>
                        @{ var n = OnlineCount(); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5>🔗 Collegamenti</h5>
                    <ul class="rail-links">
                        <li><a href="/vsop">Home</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()">ACC @_data.AccCode</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()/airports">Aeroporti</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()/apps">Avvicinamenti non remotizzati</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()/vloa">vLoA</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Tree { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    private AccInfo? _acc;
    private AccVipiData _data = new() { AccCode = "", AccName = "", Blocks = new() };
    private IReadOnlyList<AccAssembledBlock>? _blocks;   // blocchi con Id sezione (view/draft); null in anteprima release
    private bool _useFrozen;                              // vista pubblica: leggi frozen dalla release effettiva
    private bool _canEdit;
    private IReadOnlyList<AccTreeRoot> _roots = Array.Empty<AccTreeRoot>();
    private string? _root;
    private PreviewMode _mode;
    private string? _relCycle;

    private readonly Dictionary<string, List<AppFreqRow>> _freqs = new();
    private readonly Dictionary<string, AccCoordination> _coord = new();
    private readonly Dictionary<string, AccAorView> _aors = new();
    private readonly Dictionary<string, IReadOnlyList<AccSpecialAreaView>> _areas = new();
    private readonly Dictionary<string, IReadOnlyList<AccConfigTableView>> _configTables = new();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        // vIPI ACC = una sola per ACC: sempre il CTR radice primario. Il parametro ?tree è ignorato (nessun selettore).
        _roots = await Profile.ListTreeRootsAsync(Acc);
        _root = ResolveTree(null, _roots);

        _mode = PreviewMode.Parse(As);
        _relCycle = null;
        _blocks = null;
        _useFrozen = false;
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                try { var m = await AccDoc.LoadForEditAsync(Acc); _data = m.Data; _blocks = m.Blocks; }
                catch (EditNotAllowedException) { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                catch (ValidationException) { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                break;
            case PreviewKind.Release:
                AccReleaseView? rv = null;
                try { rv = await AccDoc.LoadForReleaseAsync(Acc, _mode.ReleaseId); }
                catch (EditNotAllowedException) { }
                if (rv is not null) { _data = rv.Data; _relCycle = rv.AiracCycle; }   // anteprima release: derive live (no ids)
                else { _mode = default; LoadViewModel(await AccDoc.LoadForViewAsync(Acc)); }
                break;
            default:
                LoadViewModel(await AccDoc.LoadForViewAsync(Acc));   // vista pubblica: frozen dalla release effettiva
                break;
        }
        _canEdit = await Authz.CanEditAccAsync(_data.AccCode);

        _freqs.Clear(); _coord.Clear(); _aors.Clear(); _areas.Clear(); _configTables.Clear();
        if (_blocks is not null)
        {
            // freq/coord/aor risolti dal service (frozen se pubblica + release effettiva, sennò live); aree/config-table
            // sempre live (derivano da input già congelati). doc 10 §3d.
            var derived = await ViewDeriv.ResolveForViewAsync(Acc, _blocks, _useFrozen);
            foreach (var b in _data.Blocks)
            {
                _freqs[b.Key] = derived.Freqs.GetValueOrDefault(b.Key)?.ToList() ?? new();
                _coord[b.Key] = derived.Coord.GetValueOrDefault(b.Key) ?? AccCoordination.Empty;
                _aors[b.Key] = derived.Aor.GetValueOrDefault(b.Key) ?? AccAorView.Empty;
                _areas[b.Key] = await Profile.GetAttachedSpecialAreasAsync(b);
                _configTables[b.Key] = await Profile.DeriveConfigTableAsync(Acc, b, _root);
            }
        }
        else
        {
            // Anteprima release (nessun Id sezione): deriva tutto live come prima.
            foreach (var b in _data.Blocks)
            {
                _freqs[b.Key] = (await Profile.DeriveFrequenciesAsync(Acc, b, _root)).ToList();
                _coord[b.Key] = await Profile.DeriveCoordinationAsync(Acc, b, _root);
                _aors[b.Key] = await Profile.DeriveAorViewAsync(Acc, b, _root);
                _areas[b.Key] = await Profile.GetAttachedSpecialAreasAsync(b);
                _configTables[b.Key] = await Profile.DeriveConfigTableAsync(Acc, b, _root);
            }
        }
    }

    // Vista pubblica dal modello ACC: dati + blocchi con Id sezione, e abilita la lettura frozen.
    private void LoadViewModel(AccDocumentModel? model)
    {
        if (model is null) return;
        _data = model.Data;
        _blocks = model.Blocks;
        _useFrozen = true;
    }

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => "[Bozza] ",
        PreviewKind.Release => "[Anteprima] ",
        _ => "",
    };

    // ATC online dell'ACC (include gli aeroporti sotto l'ACC), come sulla home /vsop.
    private int OnlineCount()
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
            Stations.ResolveByCallsign(cs)?.Code.Equals(_data.AccCode, StringComparison.OrdinalIgnoreCase) == true);
    }

    // vIPI ACC unica per ACC: nessun ?tree nei link (il root primario è implicito).
    private string TreeQuery() => "";

    private static string? ResolveTree(string? tree, IReadOnlyList<AccTreeRoot> roots)
    {
        if (!string.IsNullOrWhiteSpace(tree))
        {
            var match = roots.FirstOrDefault(r => string.Equals(r.Callsign, tree, StringComparison.OrdinalIgnoreCase));
            if (match is not null) return match.Callsign;
        }
        return roots.Count > 0 ? roots[0].Callsign : null;
    }

    // Blocco ACC → profilo del catalogo: Aerovia = settori CTR, AppGroup = gruppo APP. Doc 08d-acc §4(2).
    private static SectionProfile ProfileOf(AccBlockKind kind) =>
        kind == AccBlockKind.Aerovia ? SectionProfile.AccAerovia : SectionProfile.AccAppBlock;

    private IReadOnlyList<string> OrderOf(AccBlock b)
    {
        var customKeys = b.CustomSections.Select(c => c.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var hidden = b.HiddenSections.ToHashSet(StringComparer.OrdinalIgnoreCase);
        // Anteprima BOZZA: mostra anche le sezioni nascoste (stato editoriale in lavorazione). Pubblica/release: filtrate.
        return SectionCatalog.Reconcile(ProfileOf(b.Kind), b.SectionOrder, customKeys)
            .Where(k => _mode.Kind == PreviewKind.Draft || !hidden.Contains(k)).ToList();
    }

    private bool IsHiddenSection(AccBlock b, string key) =>
        _mode.Kind == PreviewKind.Draft && b.HiddenSections.Contains(key, StringComparer.OrdinalIgnoreCase);

    private static string TitleOf(AccBlock b, string key) =>
        SectionCatalog.Find(ProfileOf(b.Kind), key)?.Title ?? b.CustomSections.FirstOrDefault(c => c.Key == key)?.Title ?? key;

}
