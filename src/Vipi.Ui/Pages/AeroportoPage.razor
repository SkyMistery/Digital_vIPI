@page "/services/vsop/{Acc}/airports"
@layout SopLayout
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection

@* ⚠️ SCOPE PROPRIO (OwningComponentBase), come già sei componenti di questo repository dopo l'audit del
   30 luglio 2026. Il motivo è misurato, non teorico: alle 17:44 del 24 agosto questa pagina è morta sette
   volte con «A second operation was started on this context instance» — la sua query trovava il DbContext
   della richiesta già occupato da qualcun altro.

   Con uno scope proprio la pagina lavora su un DbContext SUO: nessuno può passarle davanti, e non serve
   sapere chi fosse l'altro — che è il punto, perché quello non si è ancora capito (voce E9).

   ⚠️ NON tutto si sposta nello scope proprio. `IStationResolver` resta quello della richiesta perché il
   layout l'ha già scaldato (`Prewarm`): riprendendolo dallo scope nuovo si ripagherebbe la stessa query,
   a freddo. Restano fuori anche le cose che il database non lo toccano: localizzazione, AIRAC, meteo,
   cache degli ATC online. *@
@* ⚠️ NIENTE `@rendermode` qui: questa pagina è SSR STATICA, come gli altri tre documenti pubblici.
   Era `InteractiveServer` e teneva un circuito aperto per OGNI lettore — l'unico dei quattro a farlo — per
   servire due sole cose: il filtro dell'elenco e il selettore di pista delle SID. Ora sono due ISOLE
   (<AirportListPanel> e <AirportSids>), e il circuito lo apre solo chi arriva davvero a quelle (doc 14 §3g). *@
@using System.Text.Json
@using System.Globalization
@using Vipi.Application.Content
@using Vipi.Application.Weather
@inject IStationResolver Stations
@inject Vipi.Application.Abstractions.IWeatherProvider Weather
@inject IOnlineAtcProvider Online
@using Vipi.Ui.Shared
@inject IStringLocalizer<SharedResource> L
@inject StringheDelSito Sito
@inject IMilitaryDocumentService Militari
@inject EnglishStrings En
@inject Vipi.Application.Content.ReadingLanguageContext Lingua

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@Sito["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_listMode)
{
    <PageTitle>@Sito["AccLanding_Airports"] @_acc.Code · vIPI IVAO Italy</PageTitle>
    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@En["AccLanding_Airports"]</b></div>
        <div class="doc-head">
            <div><h1 class="page-h1" style="margin-bottom:2px">@Sito["AccLanding_Airports"] — @_acc.Name - @_acc.Code</h1></div>
        </div>
        @* L'elenco è un'ISOLA interattiva: si carica da sé e porta il meteo che arriva dopo. Il resto di
           questa pagina è SSR statico, come gli altri tre documenti pubblici (doc 14 §3g). *@
        <AirportListPanel Acc="@_acc.Code" />
    </div>
}
else if (_view is null)
{
    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@_icao</b></div>
        <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@Sito["Airport_DocNotAvailTitle"]</p>@string.Format(Sito["Airport_DocNotAvailBody"], _icao)</div></div>
    </div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_view.Title · vIPI IVAO Italy</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/airports">@En["AccLanding_Airports"]</a> › <b>@_view.Title</b></div>

        <div class="doc-layout">
            <DocumentToc Sections="_sezioni" IsDraft="@(_mode.Kind == PreviewKind.Draft)" AnchorOf="AnchorOf" />

            <div>
                <PrintMeta Title="@_view.Title" Subtitle="@($"{Sito["Airport_SubtitlePrefix"]} · {_acc.Name}")"
                           AiracCycle="@(_relCycle ?? _view.AiracCycle)" />
                <div class="doc-head">
                    <div>
                        <h2 style="margin-bottom:2px">
                            @_view.Title
                            <MilitaryTag HasMilitaryPresence="_militaryPresence" IsMilitaryOnly="_militaryOnly" />
                        </h2>
                        <span class="muted">@Sito["Airport_SubtitlePrefix"] · @_acc.Name · <SimDisclaimer /></span>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@Sito["Common_Print"]</button>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/airports/editor?icao=@_icao">@Sito["Common_Editor"]</a>
                        }
                    </div>
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}&as=draft")" />
                }

                @* Tradotto a macchina e non ancora riletto, o tradotto a metà: chi legge deve saperlo. *@
                @* Il filtro di lettura pilota/ATC (carta vSOP militari §3): vale su tutte le famiglie,
                   perché il flag è per-sezione e l'editor lo offre ovunque. Invisibile finché nessuno ha
                   marcato niente. *@
                <AudienceChip Visibile="_haMarcate" Vista="_vista"
                              BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}" + (_mode.Kind == PreviewKind.Draft ? "&as=draft" : ""))" />

                <TranslationNotice Coverage="_copertura" />
                <LinguaBloccataNotice Lingua="@_bloccata" />

                @* ---------- Le sezioni, nell'ORDINE DEL DOCUMENTO ----------
                   Come nelle altre tre famiglie: si itera `_view.Sections` e si dispaccia per chiave. Fino alla
                   carta 2026-08-26 questa pagina aveva la sequenza CABLATA (meteo → TA+frequenze affiancate →
                   piste → SID → extra) e ritrovava le sezioni con `Title.Contains("transi")`. Per questo
                   riordinare, nascondere o infilare una sezione libera in mezzo non aveva alcun effetto: il
                   documento poteva dire quello che voleva, la pagina disegnava sempre la stessa cosa. *@
                @* Il ciclo delle sezioni lo fa il componente condiviso (doc 14 §3e). Fino alla carta del
                   26 agosto questa pagina aveva la sequenza CABLATA (meteo → TA+frequenze affiancate → piste
                   → SID → extra) e ritrovava le sezioni con `Title.Contains("transi")`: riordinare o
                   nascondere non aveva alcun effetto. Ora l'ordine è quello del documento, e le regole di
                   contorno sono le stesse delle altre famiglie perché sono lo STESSO componente. *@
                @* `lang` sul CONTENITORE: il chrome parla la lingua del sito, il documento la sua. *@
                <div lang="@_bloccata">
                    <DocumentSectionsView Sections="_sezioni" Profile="SectionProfile.Airport"
                                          IsDraft="@(_mode.Kind == PreviewKind.Draft)"
                                          AnchorOf="AnchorOf"
                                          ExtraClass="ClasseExtra" HeaderContent="Intestazione"
                                          DerivedContent="CorpoDerivato" />
                </div>
            </div>

            @* Colonna destra sticky (desktop ≥1500px): riepilogo + link + eventuali sezioni extra del profilo. *@
            <aside class="doc-rail" aria-label="@Sito["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @Sito["Common_Summary"]</h5>
                    <div class="rail-line"><span class="muted">@Sito["Common_AiracCycle"]</span><b>@_view.AiracCycle</b></div>
                    <div class="rail-line"><span class="muted">@Sito["Common_AtcOnline"]</span>
                        @{ var n = OnlineAt(_icao); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                    @* «Quanti» non dice a chi parlare: questa riga sì, ed è la stessa risposta della vista live. *@
                    <div class="rail-line"><span class="muted">@Sito["Live_AptPresidedLabel"]</span><b>@ChiPresiede()</b></div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @Sito["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@Sito["Common_Home"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/airports">@Sito["AccLanding_Airports"]</a></li>
                        @* Il ponte verso l'altra edizione dello stesso scalo: compare SOLO se il vSOP
                           militare esiste davvero, o sarebbe un collegamento a una pagina vuota. *@
                        @if (_haMilitare)
                        {
                            <li><a href="/services/vsop/@Acc.ToLowerInvariant()/mil?icao=@_icao">@Sito["Mil_LinkFromCivil"]</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero (carta vSOP
    /// militari §3).</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    private Vipi.Domain.SectionAudience? _vista;
    private bool _haMarcate;
    private PreviewMode _mode;
    private string? _relCycle;

    private AccInfo? _acc;
    private DocumentView? _view;

    /// <summary>La lingua in cui questo documento è BLOCCATO, o null se segue chi legge: serve all'avviso e
    /// all'attributo <c>lang</c> del contenitore (carta lingua-bloccata §5).</summary>
    private string? _bloccata;
    private Vipi.Application.Translation.TranslationCoverage _copertura =
        Vipi.Application.Translation.TranslationCoverage.Nessuna;
    // La passata di traduzione di QUESTA vista: serve una seconda volta sulle sezioni, dopo che
    // `AirportLegacySections.ForView` ha rimesso i titoli di catalogo (vedi il commento sul suo uso).
    private Vipi.Application.Translation.TranslationPass _passata =
        Vipi.Application.Translation.TranslationPass.Nessuna;
    private bool _listMode;
    private bool _canEdit;
    // Taglio militare/civile dell'elenco: uno alla volta, ricliccato torna a «tutti».
    // Anagrafica militare dell'aeroporto aperto. Campi a parte e non letti da `_profile`, che in anteprima di
    // release viene azzerato di proposito: la presenza di una base non è un dato di release, e sparire dalla
    // testata solo perché si guarda un ciclo passato sarebbe un'informazione persa senza motivo.
    private bool _militaryPresence;
    private bool _militaryOnly;
    /// <summary>L'anagrafica in cache dello scalo aperto: quota, variazione magnetica, IATA e coordinate per
    /// la scheda «Dati del campo». ⚠️ Non e' un dato di release — la riscrive il giro notturno — e per questo
    /// non passa dalle derivate congelate, come gia' i due flag militari qui sopra.</summary>
    private Vipi.Application.Content.AirportStation? _station;
    // Meteo mini per card (elenco): ICAO → (vento, QNH, piste suggerite decolli/atterraggi) dal METAR live.
    private string _icao = "";
    private Vipi.Application.Abstractions.WeatherReport? _wx;

    private ParsedMetar? _metar;
    private ParsedTaf? _taf;

    /// <summary>Vero se questo scalo ha anche un vSOP MILITARE pubblicato: allora nel riquadro dei
    /// collegamenti compare il ponte verso l'altra edizione. Senza il controllo, il collegamento porterebbe
    /// a una pagina vuota — peggio che non averlo.</summary>
    private bool _haMilitare;

    private List<string> _runways = new();
    private int? _windDir;
    private int _windKt;
    private RunwaySuggestionResult _sugg = new(null, Array.Empty<RunwayPick>(), "");
    private AirportData? _profile;
    private RunwayRuleResult? _ruleResult;
    private HashSet<string> _depIdents = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _arrIdents = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Le sezioni derivate risolte per QUESTA vista: frozen dalla release effettiva se c'è, sennò live.
    /// Un solo oggetto per tutte, come <c>AppViewDerived</c> sull'APP.</summary>
    private AirportDerived _derived = AirportDerived.Empty;

    // Pista da cui parte il filtro SID: la pista in uso in partenza. ⚠️ È solo un SEME per <AirportSids>, non
    // la scelta del lettore — quella vive nell'isola, perché questa pagina è statica e non si ridisegna.
    private string? _sidRwy;

    /// <summary>Chi presiede l'aeroporto: risolto nel ciclo di vita, MAI nel render (regola del progetto:
    /// nessuna I/O sul database mentre si disegna, o il circuito muore con «second operation»).</summary>
    private Vipi.Application.Live.AirportPresidency? _presidency;

    // I servizi che interrogano il database: presi dallo SCOPE DI QUESTA PAGINA, non da quello
    // della richiesta. Vedi il commento in testa al file.
    private IVipiViewService ViewService = default!;
    private IStructureEditingService Structure = default!;
    private IAirportEditingService Profile = default!;
    private IAirportViewDerivationService AirportView = default!;
    private IAirportSectorService AirportSectors = default!;
    private IDocumentAdminService Docs = default!;
    private Vipi.Application.Live.IAirportPresidencyService Presidency = default!;
    private IEditAuthorizationService Authz = default!;
    private IReleaseService Releases = default!;
    // ⚠️ Anche il traduttore legge il database (la memoria di traduzione): va preso dallo scope di QUESTA
    // pagina come tutti gli altri, o si rimette in coda sul DbContext della richiesta — vedi la nota in testa.
    private Vipi.Application.Translation.DocumentTranslator Translator = default!;

    protected override void OnInitialized()
    {
        ViewService = ScopedServices.GetRequiredService<IVipiViewService>();
        Structure = ScopedServices.GetRequiredService<IStructureEditingService>();
        Profile = ScopedServices.GetRequiredService<IAirportEditingService>();
        AirportView = ScopedServices.GetRequiredService<IAirportViewDerivationService>();
        AirportSectors = ScopedServices.GetRequiredService<IAirportSectorService>();
        Docs = ScopedServices.GetRequiredService<IDocumentAdminService>();
        Presidency = ScopedServices.GetRequiredService<Vipi.Application.Live.IAirportPresidencyService>();
        Authz = ScopedServices.GetRequiredService<IEditAuthorizationService>();
        Releases = ScopedServices.GetRequiredService<IReleaseService>();
        Translator = ScopedServices.GetRequiredService<Vipi.Application.Translation.DocumentTranslator>();
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) { _view = null; return; }

        // Senza ?icao= la pagina è l'elenco degli aeroporti della ACC; con ?icao= mostra il documento.
        // Senza ?icao= la pagina è l'elenco degli aeroporti della ACC; con ?icao= mostra il documento.
        // ⚠️ L'elenco non si carica più qui: se lo facesse, questa pagina resterebbe interattiva per servirlo.
        // Se lo carica l'isola <AirportListPanel>, che è l'unica parte che ne ha bisogno (doc 14 §3g).
        _listMode = string.IsNullOrWhiteSpace(Icao);
        if (_listMode) return;

        _icao = Icao!.ToUpperInvariant();
        _mode = PreviewMode.Parse(As);
        _relCycle = null;
        _copertura = Vipi.Application.Translation.TranslationCoverage.Nessuna;
        _haMarcate = false;
        _passata = Vipi.Application.Translation.TranslationPass.Nessuna;
        _presidency = await Presidency.ResolveAsync(_icao);
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (Authz.IsEditor)
                    _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            case PreviewKind.Release:
                var pv = await Releases.GetPreviewAsync(_mode.ReleaseId, ReleaseTargetType.Airport, _icao);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            default:
                _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false);
                break;
        }
        if (_view is null) return;
        _canEdit = Authz.IsEditor;   // tasto Editor solo a chi può editare l'ACC

        // ---- In che lingua si legge QUESTO documento (carta 2026-08-31-lingua-bloccata.md §3-4) ---------
        // ⚠️ SUBITO, appena si sa qual è il documento, e non in fondo insieme alla traduzione: se è
        // bloccato la lingua vale anche per le DERIVAZIONI, che partono qui sotto e compongono prosa ed
        // etichette. Deciderla in fondo vorrebbe dire derivare nella lingua di chi guarda e tradurre il resto
        // nell'altra — mezza schermata per lingua, e nessun errore da nessuna parte.
        // ⚠️ DUE contesti, e non è un di più: questa pagina possiede uno scope di DI suo
        // (OwningComponentBase), quindi i servizi presi da ScopedServices vedono un'istanza diversa da quella
        // iniettata nella pagina.
        var lettore = LinguaDelDocumento.Prepara(
            Lingua, _view.LanguageLocked, _view.Language, Vipi.Domain.Language.It,
            ScopedServices.GetService<Vipi.Application.Content.ReadingLanguageContext>());
        _bloccata = _view.LanguageLocked ? lettore : null;

        _wx = await Weather.GetAsync(_icao);
        _metar = string.IsNullOrWhiteSpace(_wx?.Metar) ? null : MetarParser.ParseMetar(_wx!.Metar!);
        _taf = string.IsNullOrWhiteSpace(_wx?.Taf) ? null : MetarParser.ParseTaf(_wx!.Taf!);

        // ⚠️ Il profilo serve solo alle regole piste, che decidono la pista IN USO ADESSO: quella si valuta
        // sempre sulle regole vive, anche mentre si guarda un ciclo passato — è la risposta a «dove atterro»,
        // non un dato di release. La tabella delle regole, invece, viene dalle derivate come tutto il resto.
        _profile = await Profile.LoadForViewAsync(_icao);
        // L'anagrafica del campo: presenza militare per la testata, quota/variazione/IATA/coordinate per la
        // scheda della sezione «Quote di transizione». Una lettura sola, e viene dalla mappa gia' in cache.
        _station = Stations.Airport(_icao);
        _militaryPresence = _station?.HasMilitaryPresence ?? false;
        _militaryOnly = _station?.IsMilitaryOnly ?? false;
        // ⚠️ Le sezioni derivate si risolvono INSIEME al documento e con lo stesso criterio (doc 11 §3d): frozen
        // solo in vista pubblica, live in bozza e in anteprima di release. Deciderlo sezione per sezione, o
        // lasciare che un ramo di fallback dimenticasse il flag, renderebbe il congelamento AIRAC aggirabile
        // da un `?as=` qualsiasi.
        var useFrozen = _mode.Kind is not (PreviewKind.Draft or PreviewKind.Release);
        // ⚠️ In anteprima di release si guarda al CICLO DI QUELLA RELEASE, non a quello di oggi. Le derivate
        // qui si rendono live (useFrozen è false), e una di loro — le SID — ha una regola che dipende dal
        // ciclo: una SID importata compare dal ciclo successivo al prelievo. Chiedendo sempre «adesso»,
        // l'anteprima di una release programmata al 2608 mostrava la tabella di oggi e non quella che
        // uscirà: le SID prelevate nel ciclo in corso mancavano dall'anteprima e poi comparivano da sole
        // in pubblico. Fuori dall'anteprima `_relCycle` è nullo e non cambia niente.
        _derived = await AirportView.ResolveForViewAsync(_icao, useFrozen, ReleaseTargetType.Airport, _relCycle);
        // Il ponte verso l'altra edizione. Al PUBBLICO solo se il vSOP militare è pubblicato: un
        // collegamento a un documento che non c'è è peggio di nessun collegamento.
        // ⚠️ Allo STAFF anche se è solo una bozza. Dal 29 agosto 2026 il vSOP militare nasce QUI, dall'editor
        // della vIPI civile, e nasce in bozza: senza questo, chi l'ha appena creato non avrebbe da questa
        // pagina alcun modo di tornarci — il ponte comparirebbe solo dopo la pubblicazione, cioè quando non
        // serve più.
        _haMilitare = await Militari.HasPublishedAsync(_icao)
                      || (_canEdit && await Militari.GetDocumentIdAsync(_icao) is not null);
        _runways = _derived.Runways.Rows.Count > 0
            ? _derived.Runways.Rows.Select(r => r.Ident).ToList()
            : ExtractRunways(_view);
        // Vento iniziale dal METAR, se noto.
        _windDir = _metar?.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        _windKt = _metar?.Wind?.SpeedKt ?? 0;
        Recompute();

        // ---- Lettura bilingue (carta 2026-08-27 §7) --------------------------------------------------
        // ⚠️ La lingua di lettura è quella dell'INTERFACCIA, non un secondo selettore: un documento italiano
        // dentro una pagina inglese è una schermata mezza tradotta. La sceglie la chip della barra, che
        // scrive il cookie di cultura — l'unico modo perché la scelta sopravviva al circuito, che su
        // /_blazor non porta ?culture=.
        //
        // ⚠️ La sorgente la dice il DOCUMENTO, non questa pagina: un aeroporto nasce in italiano, ma se un
        // giorno ne nascesse uno inglese cablare «it» qui vorrebbe dire tradurre l'inglese come italiano —
        // e il lettore vedrebbe la memoria mancare su ogni frase senza capire perché.
        //
        // ⚠️ IN FONDO, non appena caricato il documento: le sezioni derivate e le piste si leggono
        // dall'originale (ids, identificatori, JSON dei blocchi), la traduzione porta la PROSA. È la stessa
        // sequenza del vSOP militare, ed è misurata: tradurre prima significherebbe cercare «regulated» in
        // un documento che nel frattempo dice altro.
        var tradotto = await Translator.TranslateAsync(_view, Vipi.Domain.Language.It, lettore);
        _view = tradotto.View;
        _copertura = tradotto.Coverage;
        _passata = tradotto.Pass;   // serve ai titoli di catalogo, che al traduttore non passano davanti

        // Le sezioni da rendere si ricavano DOPO la traduzione, e si RITRADUCONO.
        //
        // ⚠️ Il secondo giro non è per scrupolo: `ForView` riporta ogni sezione di catalogo al suo titolo di
        // CATALOGO — che è una stringa italiana cablata — e quindi butta via il titolo appena tradotto. Visto
        // a schermo su LIBC il 28 agosto 2026: indice e testate dicevano «Regole piste» in mezzo a una pagina
        // inglese, con la copertura che dichiarava «tutto tradotto». Ripassare la sezione dalla stessa passata
        // costa zero query (la memoria è già in mano) e ritraduce dalla stessa impronta; su un testo già
        // tradotto non trova nulla e lo lascia dov'è.
        // ⚠️ `ForView` vuole la LINGUA: i titoli di catalogo non sono segmenti del documento, quindi la
        // passata non li conosce e ripassarli da lì non basta — su un aeroporto importato, che ha titoli di
        // sezione inglesi, il catalogo li riportava comunque in italiano. Ora il catalogo li porta in tutte e
        // due le lingue e si sceglie qui (carta lingua-bloccata §4; chiude anche §Q18a della carta bilingue).
        _sezioni = AirportLegacySections.ForView(_view.Sections, lettore).Select(_passata.Sezione).ToList();

        // Il filtro di lettura, DOPO la traduzione e DOPO i titoli di catalogo: si filtra la vista che il
        // lettore vedrà davvero, e la chip si accende solo se c'è qualcosa da filtrare.
        _vista = AudienceFilter.Leggi(Vista);
        _haMarcate = AudienceFilter.HaSezioniMarcate(_sezioni);
        _sezioni = AudienceFilter.Filtra(_sezioni, _vista);
    }

                /// <summary>Gli ATC su questo scalo, ATIS escluso: un ATIS acceso non è una posizione presidiata.
    /// ⚠️ Resta qui perché serve anche al DOCUMENTO, non solo all'elenco — la stessa domanda la fa da sé
    /// l'isola <AirportListPanel> per le sue schede.</summary>
    private int OnlineAt(string icao) => Online.GetCurrent().Callsigns.Count(cs =>
        cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase)
        && !cs.EndsWith("_ATIS", StringComparison.OrdinalIgnoreCase));

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => $"{Sito["Common_DraftTag"]} ",
        PreviewKind.Release => $"{Sito["Common_PreviewTag"]} ",
        _ => "",
    };

    // Carica il METAR (HTTP, in parallelo) di tutti gli aeroporti dell'elenco e ne deriva vento/QNH/pista.
    // Fuori dal percorso di render: la lista è già visibile, il meteo compare appena pronto.
        // Piste suggerite dal profilo (decolli, atterraggi): regole piste se presenti, altrimenti miglior vento di testa.
        private static string? Norm(string? rwy) => string.IsNullOrWhiteSpace(rwy) ? null : rwy.Trim();

    // ATC online per l'aeroporto: callsign il cui primo token (prima del "_") è l'ICAO (es. LIRF_TWR, LIRF_S_APP).
    // ⚠️ L'ATIS è escluso: nell'elenco delle postazioni c'è, ma è una frequenza registrata, non qualcuno che
    // controlla — contarlo faceva apparire «1 online» un aeroporto dove non risponde nessuno.
        /// <summary>
    /// Chi presiede questo aeroporto adesso, in una riga: posizioni sue online dal gate in su e, per ciò che
    /// non è presidiato in loco, chi lo copre risalendo. Stessa risposta della vista live, stesso risolutore.
    /// </summary>
    private string ChiPresiede()
    {
        if (_presidency is not { } p) return "—";
        if (p.Unicom) return Sito["Live_AptPresidedNobody"];

        var locali = string.Join(" · ", p.Local.Select(s => s.Callsign));
        if (p.Covering is null) return locali;
        return locali.Length == 0
            ? Sito.Formatta("Live_AptCoveredBy", p.Covering.Callsign)
            : $"{locali} — {Sito.Formatta("Live_AptCoveredBy", p.Covering.Callsign)}";
    }

    // Sezioni il cui corpo lo rende questa pagina; le altre passano da SectionNode. Chi siano lo dice il
    // catalogo, per profilo (doc 13 §3a) — non un insieme scritto qui dentro.
    /// <summary>Il corpo che questa pagina disegna, per chiave di sezione.</summary>
    private RenderFragment<SectionView> CorpoDerivato => sec => __builder =>
    {
        @switch (sec.SectionKey)
        {
            case "weather": <AirportWeather Icao="@_icao" Report="_wx" Metar="_metar" Taf="_taf" Lingua="@_bloccata" />; break;
            case "runwayrules":
                <AirportRunwayRules View="_derived.Rules" ActivePosition="@(_ruleResult is null ? null : _ruleResult.RuleIndex + 1)" />;
                break;
            case "transition":
                <AirportTransition View="_derived.Transition" CurrentQnh="_metar?.QnhHpa"
                                   MetarTimeRaw="@_metar?.TimeRaw" Station="_station" />;
                break;
            case "frequencies": <AirportFrequencies View="_derived.Frequencies" />; break;
            case "runways":
                <AirportRunways View="_derived.Runways" DepIdents="_depIdents" ArrIdents="_arrIdents"
                                RuleName="@(_ruleResult is null ? null : _ruleResult.RuleName ?? $"#{_ruleResult.RuleIndex + 1}")"
                                RuleNote="@_ruleResult?.Note" WindDir="_windDir" WindKt="_windKt"
                                HasRain="@(_metar?.HasRain == true)" HasSnow="@(_metar?.HasSnow == true)" />;
                break;
            case "sids":
                <AirportSids View="_derived.Sids" InitialRunway="@_sidRwy" Lingua="@_bloccata"
                             DepIdents="_depIdents.ToArray()" TransitionAltitudeFt="_derived.Transition.TransitionAltitudeFt" />;
                break;
            case "validity": <ValidityStamp Target="ReleaseTargetType.Airport" Key="@_icao" ReleaseId="@ReleaseIdShown()" />; break;
        }
    };

    /// <summary>⚠️ Il meteo non va in stampa: è un dato live, e su carta sarebbe un'istantanea già scaduta
    /// quando la si legge. È anche l'unica sezione che non si congela mai.</summary>
    private static string? ClasseExtra(SectionView sec) =>
        sec.SectionKey == "weather" ? "noprint" : null;

    /// <summary>L'intestazione del meteo porta l'emoji, l'ICAO e la nota «live NOAA»: non è decorazione, dice
    /// DI CHI è il tempo che si sta leggendo e che è vivo — le due cose che quella sezione ha da dire prima di
    /// essere aperta. Le altre sezioni hanno il titolo e basta, e per quelle il componente fa da sé.</summary>
    private RenderFragment<SectionView> Intestazione => sec => __builder =>
    {
        @if (sec.SectionKey == "weather")
        {
            <text>🌦️ </text>
            @sec.Title
            <text> · @_icao </text>
            <span class="muted" style="font-weight:400;font-size:13px">@L["Airport_LiveNoaa"]</span>
        }
        else
        {
            @sec.Title
        }
    };


    /// <summary>
    /// Le sezioni da rendere: quelle del documento mostrato, con le <b>cotte</b> riportate alla loro chiave di
    /// catalogo e con il <b>meteo</b> aggiunto se manca (<see cref="AirportLegacySections.ForView"/>).
    /// <para>⚠️ Serve agli snapshot di release anteriori alla carta 2026-08-26, che non si riscrivono mai: senza,
    /// la pagina pubblica di ogni aeroporto non ancora ripubblicato perde le tabelle vere e il meteo.</para>
    /// </summary>
    private IReadOnlyList<SectionView> _sezioni = Array.Empty<SectionView>();

    // Ancora di sezione: «s-{Id}» per TUTTE, anche per quelle rese dalla pagina (doc 13 §3e), così i deep-link
    // della ricerca — che indicizza per Id — atterrano dove devono e non in cima alla pagina.
    private static string AnchorOf(SectionView s) => s.Id;

    /// <summary>La release che questa vista mostra: quella dell'anteprima, o null = la effettiva adesso.</summary>
    private int? ReleaseIdShown() => _mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null;

    /// <summary>
    /// Titolo mostrato per una sezione di catalogo. ⚠️ Uno snapshot di release scritto PRIMA della carta
    /// 2026-08-26 porta i titoli in inglese («Transition levels»), perché li scriveva la cottura: chi legge
    /// un ciclo passato deve vedere il documento com'era, ma le sezioni riconciliate hanno il titolo nuovo e
    /// devono leggersi uguali alle altre. Quindi: titolo del catalogo se la chiave è del catalogo.
    /// </summary>

    private void Recompute()
    {
        // Le regole pista (se presenti) scelgono DEP/ARR dal vento in coda/traverso + superficie; altrimenti fallback headwind.
        // ⚠️ Si valutano sulle regole VIVE, non su quelle eventualmente congelate: «quale pista è in uso adesso»
        // è una domanda sul presente, e resta tale anche mentre si sfoglia un ciclo passato.
        var wet = (_metar?.HasRain ?? false) || (_metar?.HasSnow ?? false);
        _ruleResult = _profile is { Rules.Count: > 0 }
            ? RunwaySuggestion.EvaluateRules(_profile.Rules.Select(MapRule).ToList(), _windDir, _windKt, wet, DateTime.UtcNow)
            : null;
        _sugg = RunwaySuggestion.Suggest(_runways, _windDir, _windKt);

        // Pista consigliata DEP/ARR (la selezione NON cambia: cambia solo come la mostriamo nella tabella Piste).
        _depIdents = new(StringComparer.OrdinalIgnoreCase);
        _arrIdents = new(StringComparer.OrdinalIgnoreCase);
        if (_ruleResult is not null)
        {
            foreach (var id in SplitIdents(_ruleResult.Dep)) _depIdents.Add(id);
            foreach (var id in SplitIdents(_ruleResult.Arr)) _arrIdents.Add(id);
        }
        else if (_sugg.Best is not null)
        {
            _depIdents.Add((_sugg.DepIdent ?? _sugg.Best.Ident).Trim());
            _arrIdents.Add((_sugg.ArrIdent ?? _sugg.Best.Ident).Trim());
        }

        // Seme del filtro SID = pista in uso in partenza (se ha SID), altrimenti la prima pista con SID.
        // ⚠️ Qui non c'è più nessun «se l'utente ha già scelto»: la scelta del lettore non passa di qui, e
        // fingere di conoscerla è esattamente ciò che teneva le chip ferme.
        var sidRwys = AirportSids.RunwaysOf(_derived.Sids);
        _sidRwy = sidRwys.FirstOrDefault(r => _depIdents.Contains(r)) ?? sidRwys.FirstOrDefault();
    }

    private static IEnumerable<string> SplitIdents(string? csv) => (csv ?? "")
        .Split(new[] { ',', ' ', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string RwyRowClass(bool dep, bool arr) =>
        dep && arr ? "rwy-both" : arr ? "rwy-arr" : dep ? "rwy-dep" : "";

    private static RunwayRuleEval MapRule(RunwayRuleRow r) => AirportViewFormat.MapRule(r);

    /// <summary>
    /// Ripiego: estrae gli identificativi pista dalla tabella «Piste» COTTA nel documento. Serve solo agli
    /// snapshot di release anteriori alla carta 2026-08-26 — un documento di lavoro le piste le ha nel profilo,
    /// e la derivazione le porta gia'. Per questo cerca ancora per titolo: quelle sezioni hanno chiavi casuali.
    /// </summary>
    private static List<string> ExtractRunways(DocumentView view)
    {
        var idents = new List<string>();
        foreach (var s in view.Sections)
        {
            if (!s.Title.Contains("pist", StringComparison.OrdinalIgnoreCase) && !s.Title.Contains("runway", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var b in s.Blocks)
            {
                if (b.Format != BlockFormat.Table || string.IsNullOrWhiteSpace(b.BodyJson)) continue;
                try
                {
                    using var doc = JsonDocument.Parse(b.BodyJson!);
                    if (!doc.RootElement.TryGetProperty("rows", out var rows)) continue;
                    foreach (var row in rows.EnumerateArray())
                    {
                        if (row.TryGetProperty("cells", out var cells) && cells.GetArrayLength() > 0)
                        {
                            var ident = cells[0].GetString();
                            if (!string.IsNullOrWhiteSpace(ident)) idents.Add(ident!.Trim());
                        }
                    }
                }
                catch (JsonException) { /* tabella non standard: ignora */ }
            }
        }
        return idents;
    }
}
