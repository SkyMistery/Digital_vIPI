@page "/vsop/{Acc}/airports"
@layout SopLayout
@rendermode InteractiveServer
@using System.Text.Json
@using Vipi.Application.Content
@using Vipi.Application.Weather
@inject IVipiViewService ViewService
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject Vipi.Application.Abstractions.IWeatherProvider Weather
@inject IAirportProfileService Profile
@inject IAirportSectorService AirportSectors
@inject IDocumentAdminService Docs
@inject IOnlineAtcProvider Online
@inject IEditAuthorizationService Authz
@inject IReleaseService Releases
@using Vipi.Ui.Shared

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else if (_listMode)
{
    <PageTitle>Aeroporti @_acc.Code · vIPI IVAO Italia</PageTitle>
    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>Aeroporti</b></div>
        <div class="doc-head">
            <div><h2 style="margin-bottom:2px">Aeroporti — @_acc.Name - @_acc.Code</h2></div>
        </div>
        @if (_allAirports.Count == 0)
        {
            <div class="callout info"><span class="cic">📭</span><div><p class="ct">Nessun aeroporto</p>Nessun aeroporto con documento pubblicato sotto questa ACC.</div></div>
        }
        else
        {
            <div class="choice-grid" style="margin-top:14px">
                @foreach (var ap in _allAirports)
                {
                    var n = OnlineAt(ap.Icao);
                    <a class="choice apt-card" href="/vsop/@Acc.ToLowerInvariant()/airports?icao=@ap.Icao" style="text-decoration:none;color:inherit">
                        <div class="apt-top">
                            <h4>@ap.Icao</h4>
                            <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n} online" : "offline")</span>
                        </div>
                        <p class="muted">@ap.Name</p>
                        @if (_wxMini.TryGetValue(ap.Icao, out var wx))
                        {
                            <div class="apt-wx">
                                <span><span class="wx-k">Vento</span><b>@(string.IsNullOrWhiteSpace(wx.Wind) ? "—" : wx.Wind)</b></span>
                                <span><span class="wx-k">QNH</span><b>@(wx.Qnh is int q ? $"{q}" : "—")</b></span>
                                @if (!string.IsNullOrEmpty(wx.Dep) || !string.IsNullOrEmpty(wx.Arr))
                                {
                                    <span><span class="wx-k">Decolli</span><b>@(wx.Dep ?? "—")</b></span>
                                    <span><span class="wx-k">Atterraggi</span><b>@(wx.Arr ?? "—")</b></span>
                                }
                            </div>
                        }
                        else if (_wxLoading)
                        {
                            <div class="apt-wx loading"><span class="muted" style="font-size:12.5px">Meteo in caricamento…</span></div>
                        }
                    </a>
                }
            </div>
        }
    </div>
}
else if (_view is null)
{
    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@_icao</b></div>
        <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">Documento non disponibile</p>Nessuna vIPI aeroporto pubblicata per @_icao.</div></div>
    </div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_view.Title · vIPI IVAO Italia</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/vsop/@Acc.ToLowerInvariant()/airports">Aeroporti</a> › <b>@_view.Title</b></div>

        <div class="doc-layout">
            <aside class="toc">
                <p class="toc-h">Sommario</p>
                <ul>
                    @foreach (var (id, title) in TocEntries())
                    {
                        <li><a href="#@id">@title</a></li>
                    }
                </ul>
            </aside>

            <div>
                <div class="doc-head">
                    <div><h2 style="margin-bottom:2px">@_view.Title</h2><span class="muted">Aeroporto · @_acc.Name</span></div>
                    @if (_canEdit)
                    {
                        <a class="btn primary" href="/vsop/@Acc.ToLowerInvariant()/airports/editor?icao=@_icao">✎ Editor</a>
                    }
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}")"
                                   DraftHref="@($"/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}&as=draft")" />
                }

                @* ---------- METAR / TAF live + parse ---------- *@
                <div class="block" id="a-meteo">
                    <h3 style="margin-top:0">🌦️ METAR &amp; TAF · @_icao <span class="muted" style="font-weight:400;font-size:13px">(live · NOAA)</span></h3>

                    @if (_wx is not null && _wx.HasData)
                    {
                        <div class="wx-tabs">
                            <button class="wx-tab @(_tab == "metar" ? "on" : "")" @onclick='() => _tab = "metar"'>METAR</button>
                            <button class="wx-tab @(_tab == "taf" ? "on" : "")" @onclick='() => _tab = "taf"' disabled="@(_taf is null)">TAF</button>
                        </div>

                        @if (_tab == "metar" && _metar is not null)
                        {
                            <div class="wx-view">
                                <div class="metar"><span class="metar-live"><span class="dot"></span> LIVE</span> @_metar.Raw</div>
                                <div class="metar-parse">
                                    <span class="mp"><span class="muted">Vento</span><b>@(_metar.Wind?.Label ?? "—")</b></span>
                                    <span class="mp"><span class="muted">Visibilità</span><b>@(_metar.Visibility ?? "—")</b></span>
                                    <span class="mp"><span class="muted">Nubi</span><b>@_metar.CloudsLabel</b></span>
                                    <span class="mp"><span class="muted">QNH</span><b>@(_metar.QnhHpa is int q ? $"{q} hPa" : "—")</b></span>
                                    <span class="mp"><span class="muted">Temp/DP</span><b>@(_metar.TempC is int t ? $"{t} / {_metar.DewpointC} °C" : "—")</b></span>
                                    @if (_metar.Weather is not null)
                                    {
                                        <span class="mp"><span class="muted">Tempo</span><b>@_metar.Weather</b></span>
                                    }
                                    @if (_metar.Trend is not null)
                                    {
                                        <span class="mp"><span class="muted">Tendenza</span><b>@_metar.Trend</b></span>
                                    }
                                </div>
                            </div>
                        }
                        else if (_tab == "metar")
                        {
                            <div class="empty-ph"><span class="ei">🌫️</span><div><b>METAR non disponibile per @_icao</b></div></div>
                        }

                        @if (_tab == "taf" && _taf is not null)
                        {
                            <div class="wx-view">
                                <div class="metar"><span class="metar-live"><span class="dot"></span> LIVE</span> @_taf.Raw</div>
                                @if (_taf.ValidityRaw is not null)
                                {
                                    <div class="taf-valid">⏱️ Validità: <b style="margin:0 4px">@_taf.ValidityRaw</b></div>
                                }
                                <div class="taf-tl">
                                    @foreach (var seg in _taf.Segments)
                                    {
                                        var cls = TafCss(seg.Kind);
                                        <div class="taf-row @cls">
                                            <div class="taf-head">
                                                <span class="taf-kind @cls">@TafLabel(seg)</span>
                                                <span class="taf-when">@(seg.PeriodRaw ?? "dall'inizio validità")</span>
                                                <span class="taf-raw">@seg.Raw</span>
                                            </div>
                                            <div class="taf-parse">
                                                @if (seg.Wind is not null)
                                                {
                                                    <span class="mp"><span class="muted">Vento</span><b>@seg.Wind.Label</b></span>
                                                }
                                                @if (seg.Wind?.GustKt is int g)
                                                {
                                                    <span class="mp"><span class="muted">Raffiche</span><b>@g kt</b></span>
                                                }
                                                @if (seg.Visibility is not null)
                                                {
                                                    <span class="mp"><span class="muted">Visibilità</span><b>@seg.Visibility</b></span>
                                                }
                                                @if (seg.Clouds.Count > 0)
                                                {
                                                    <span class="mp"><span class="muted">Nubi</span><b>@string.Join(" · ", seg.Clouds.Select(c => c.Label))</b></span>
                                                }
                                                @if (seg.Weather is not null)
                                                {
                                                    <span class="mp"><span class="muted">Tempo</span><b>@seg.Weather</b></span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <p class="muted" style="font-size:12px;margin:10px 0 0">Aggiornato @(_wx.AsOf?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</p>
                    }
                    else
                    {
                        <div class="empty-ph"><span class="ei">🌫️</span><div><b>METAR/TAF non disponibile per @_icao</b></div><div class="muted" style="font-size:12.5px">Servizio meteo non raggiungibile o ICAO senza bollettino. Riprova più tardi.</div></div>
                    }
                </div>

                @* ---------- Transizione + Frequenze affiancate ---------- *@
                @if (_taSection is not null || _freqSection is not null || _profile is not null)
                {
                    <div class="apt-2col">
                        @if (_taSection is not null)
                        {
                            <div class="block" id="@_taSection.Id">
                                <h3 style="margin-top:0">@_taSection.Title</h3>
                                <div class="ta-badge"><span class="muted">Transition Altitude</span><b>@(_ta is int ta ? $"{ta} ft" : "N/A")</b></div>
                                @if (_tlRows.Count > 0)
                                {
                                    <p class="muted" style="font-size:13.5px;margin:14px 0 6px">Transition Level in base al QNH@(_metar?.QnhHpa is int ? $" (attuale {_metar!.QnhHpa} hPa)" : ""):</p>
                                    <table class="tl-table">
                                        <thead><tr>@foreach (var c in _tlCols) { <th>@c</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var r in _tlRows)
                                            {
                                                var now = _metar?.QnhHpa is int q && QnhRowMatches(r.Range, q);
                                                <tr class="@(now ? "tl-now" : "")">
                                                    <td>@r.Range</td>
                                                    <td>@(_ta is null ? "N/A" : r.Level) @if (now) { <span class="pref-tag">QNH attuale</span> }</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        }
                        @if (FreqRows().Any() || _profile is not null)
                        {
                            <div class="block" id="a-freq">
                                <h3 style="margin-top:0">Frequenze</h3>
                                <table class="freq-table">
                                    <thead><tr><th>Nome</th><th>Callsign</th><th>Frequenza</th></tr></thead>
                                    <tbody>
                                        @foreach (var f in FreqRows())
                                        {
                                            <tr class="@(f.IsPrimary ? "primary" : null)">
                                                <td>@(f.IsPrimary ? (MarkupString)$"<span class=\"freq-key\">★</span> {FreqName(f.Position)}" : (MarkupString)FreqName(f.Position))</td><td>@f.ComposePosition</td>
                                                <td>@(f.Frequency ?? "—")</td>
                                            </tr>
                                        }
                                        @foreach (var l in _profile?.Links ?? Array.Empty<FrequencyLinkRow>())
                                        {
                                            <tr><td>@l.Label</td><td>@l.Callsign</td><td>@l.FrequencyMhz</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else if (_freqSection is not null)
                        {
                            <SectionNode Section="_freqSection" />
                        }
                    </div>
                }

                @* ---------- Piste: tabella con evidenza pista consigliata dal vento/regole ---------- *@
                @if (_profile is { Runways.Count: > 0 })
                {
                    <div class="block" id="a-piste">
                        <h3 style="margin-top:0">Piste</h3>
                        <p class="muted" style="font-size:12.5px;margin:0 0 8px">
                            In <span class="rwy-key arr">verde gli arrivi</span> e <span class="rwy-key dep">blu le partenze</span> consigliati
                            @if (_ruleResult is not null) { <text>dalla regola attiva «@(_ruleResult.RuleName ?? $"#{_ruleResult.RuleIndex + 1}")»</text> } else { <text>dal vento METAR</text> }.
                            @if (_windDir is int wd) { <text> Vento @wd° / @_windKt kt.</text> }
                            @if (_metar?.HasRain == true) { <span class="pill">🌧️ pioggia</span> }
                            @if (_metar?.HasSnow == true) { <span class="pill">❄️ neve</span> }
                            @if (_ruleResult?.Note is string rn) { <span class="pill" style="background:#fff4e5;color:#9a6700">@rn</span> }
                        </p>
                        <table class="rwy-table">
                            <thead><tr><th>Pista</th><th>Uso</th><th>Lung. (m)</th><th>TORA</th><th>LDA</th><th>APP procedures</th><th>Patterns</th><th>Circling</th></tr></thead>
                            <tbody>
                                @foreach (var r in _profile.Runways)
                                {
                                    var dep = _depIdents.Contains(r.Ident.Trim());
                                    var arr = _arrIdents.Contains(r.Ident.Trim());
                                    <tr class="@RwyRowClass(dep, arr)">
                                        <td><b>@r.Ident</b></td>
                                        <td style="white-space:nowrap;font-size:15px">
                                            @if (dep) { <span title="Consigliata per le partenze">🛫</span> }
                                            @if (arr) { <span title="Consigliata per gli arrivi">🛬</span> }
                                            @if (!dep && !arr) { <span class="muted" style="font-size:12px">—</span> }
                                        </td>
                                        <td>@(r.LengthM?.ToString() ?? "—")</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.ToraM) ? "—" : r.ToraM)</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.LdaM) ? "—" : r.LdaM)</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.AppProcedures) ? "—" : r.AppProcedures)</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.Patterns) ? "—" : r.Patterns)</td>
                                        <td>@(string.IsNullOrWhiteSpace(r.Circling) ? "—" : r.Circling)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @foreach (var s in _otherSections)
                {
                    <SectionNode Section="s" />
                }

                @* Sezioni extra — copia inline sotto le SID, visibile solo su schermi stretti (su desktop usa il rail di destra). *@
                @if (ExtraSections().Any())
                {
                    <div class="extra-inline">
                        @foreach (var s in ExtraSections())
                        {
                            <div class="block" id="extra-@s.Id">
                                <h3 style="margin-top:0">@s.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(s.Body)) { <div style="white-space:pre-wrap">@s.Body</div> }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Colonna destra sticky (desktop ≥1500px): riepilogo + link + eventuali sezioni extra del profilo. *@
            <aside class="doc-rail">
                <div class="rail-card">
                    <h5>📋 Riepilogo</h5>
                    <div class="rail-line"><span class="muted">Ciclo AIRAC</span><b>@_view.AiracCycle</b></div>
                    <div class="rail-line"><span class="muted">ATC online</span>
                        @{ var n = OnlineAt(_icao); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5>🔗 Collegamenti</h5>
                    <ul class="rail-links">
                        <li><a href="/vsop">Home</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/vsop/@Acc.ToLowerInvariant()/airports">Aeroporti</a></li>
                    </ul>
                </div>
                @foreach (var s in ExtraSections())
                {
                    <div class="rail-card" id="extra-rail-@s.Id">
                        <h5>@s.Title</h5>
                        @if (!string.IsNullOrWhiteSpace(s.Body)) { <div style="white-space:pre-wrap;font-size:13px">@s.Body</div> }
                    </div>
                }
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }
    private PreviewMode _mode;
    private string? _relCycle;

    private AccInfo? _acc;
    private DocumentView? _view;
    private bool _listMode;
    private bool _canEdit;
    private IReadOnlyList<AirportRow> _allAirports = Array.Empty<AirportRow>();
    // Meteo mini per card (elenco): ICAO → (vento, QNH, piste suggerite decolli/atterraggi) dal METAR live.
    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, (string? Wind, int? Qnh, string? Dep, string? Arr)> _wxMini = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, AirportProfileData?> _profiles = new(StringComparer.OrdinalIgnoreCase);
    private int _wxGen;          // token anti-corsa: scarta i caricamenti meteo di ACC ormai cambiate
    private bool _wxLoading;     // true finché il meteo di questo elenco non è arrivato
    private string _icao = "";
    private Vipi.Application.Abstractions.WeatherReport? _wx;

    private ParsedMetar? _metar;
    private ParsedTaf? _taf;
    private string _tab = "metar";

    private List<string> _runways = new();
    private int? _windDir;
    private int _windKt;
    private RunwaySuggestionResult _sugg = new(null, Array.Empty<RunwayPick>(), "");
    private AirportProfileData? _profile;
    private RunwayRuleResult? _ruleResult;
    private IReadOnlyList<AirportSectorRow> _airportSectors = Array.Empty<AirportSectorRow>();
    private HashSet<string> _depIdents = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _arrIdents = new(StringComparer.OrdinalIgnoreCase);

    private SectionView? _taSection;
    private SectionView? _freqSection;
    private List<SectionView> _otherSections = new();
    private List<SectionView> _extraSections = new();
    private int? _ta;
    private IReadOnlyList<string> _tlCols = Array.Empty<string>();
    private List<(string Range, string Level)> _tlRows = new();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) { _view = null; return; }

        // Senza ?icao= la pagina è l'elenco degli aeroporti della ACC; con ?icao= mostra il documento.
        _listMode = string.IsNullOrWhiteSpace(Icao);
        if (_listMode)
        {
            var data = await Structure.LoadAsync(_acc.Code);
            // Solo aeroporti con documento vIPI PUBBLICATO (non basta l'import: lo staff deve pubblicare a mano).
            var published = (await Docs.ListAsync())
                .Where(m => m.Kind == ManagedDocKind.AirportVipi && m.IsPublished
                            && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.Scope)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _allAirports = data?.Airports
                .Where(x => x.IsPublic && published.Contains(x.Icao))
                .OrderBy(x => x.Icao).ToList()
                ?? (IReadOnlyList<AirportRow>)Array.Empty<AirportRow>();

            // Profili piste (DB, veloci) — servono per la pista consigliata. Il METAR (HTTP, lento) NON viene
            // atteso qui: la lista si renderizza subito e il meteo arriva in background (LoadMeteoAsync).
            _profiles.Clear();
            foreach (var ap in _allAirports) _profiles[ap.Icao] = await Profile.LoadForViewAsync(ap.Icao);
            _wxMini.Clear();
            _wxLoading = _allAirports.Count > 0;
            var gen = ++_wxGen;
            _ = LoadMeteoAsync(gen);
            return;
        }

        _icao = Icao!.ToUpperInvariant();
        _mode = PreviewMode.Parse(As);
        _relCycle = null;
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (await Authz.CanEditAccAsync(_acc.Code))
                    _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false, ignoreRelease: true);
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            case PreviewKind.Release:
                var pv = await TryPreviewAsync(_mode.ReleaseId, ReleaseTargetType.Airport, _icao);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            default:
                _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false);
                break;
        }
        if (_view is null) return;
        _canEdit = await Authz.CanEditAccAsync(_acc.Code);   // tasto Editor solo a chi può editare l'ACC

        _wx = await Weather.GetAsync(_icao);
        _metar = string.IsNullOrWhiteSpace(_wx?.Metar) ? null : MetarParser.ParseMetar(_wx!.Metar!);
        _taf = string.IsNullOrWhiteSpace(_wx?.Taf) ? null : MetarParser.ParseTaf(_wx!.Taf!);

        _profile = await Profile.LoadForViewAsync(_icao);
        // Anteprima RELEASE: il profilo strutturato è sempre live (non congelato nello snapshot) → in release lo
        // ignoriamo e mostriamo piste/TA/TL dal DocumentView CONGELATO del ciclo, coerente col resto del documento.
        if (_mode.Kind == PreviewKind.Release) _profile = null;
        _airportSectors = (await AirportSectors.ListByAirportAsync(_icao)).Where(s => !s.IsHidden).ToList();
        _runways = _profile is { Runways.Count: > 0 }
            ? _profile.Runways.Select(r => r.Ident).ToList()
            : ExtractRunways(_view);
        SplitSections(_view);
        // Anteprima BOZZA: TA/TL derivati dal profilo strutturato LIVE (working), non dall'ultimo rebuild pubblicato
        // nel DocumentView — così la bozza riflette le modifiche editoriali non ancora rigenerate/pubblicate.
        if (_mode.Kind == PreviewKind.Draft && _profile is not null) ApplyProfileTransition(_profile);
        // Vento iniziale dal METAR, se noto.
        _windDir = _metar?.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        _windKt = _metar?.Wind?.SpeedKt ?? 0;
        Recompute();
    }

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => "[Bozza] ",
        PreviewKind.Release => "[Anteprima] ",
        _ => "",
    };

    private async Task<ReleasePreview?> TryPreviewAsync(int releaseId, ReleaseTargetType expectedType, string? expectedKey)
    {
        try
        {
            var pv = await Releases.GetPreviewAsync(releaseId);
            if (pv is null || pv.Type != expectedType
                || (expectedKey is not null && !string.Equals(pv.TargetKey, expectedKey, StringComparison.OrdinalIgnoreCase)))
                return null;
            return pv;
        }
        catch (EditNotAllowedException) { return null; }
        catch (Vipi.Application.Aor.ValidationException) { return null; }
    }

    // Carica il METAR (HTTP, in parallelo) di tutti gli aeroporti dell'elenco e ne deriva vento/QNH/pista.
    // Fuori dal percorso di render: la lista è già visibile, il meteo compare appena pronto.
    private async Task LoadMeteoAsync(int gen)
    {
        var results = await Task.WhenAll(_allAirports.Select(async ap =>
        {
            try
            {
                var wx = await Weather.GetAsync(ap.Icao);
                var m = string.IsNullOrWhiteSpace(wx?.Metar) ? null : MetarParser.ParseMetar(wx!.Metar!);
                return (ap.Icao, Metar: m);
            }
            catch { return (ap.Icao, Metar: (ParsedMetar?)null); }
        }));

        if (gen != _wxGen) return;   // l'utente ha cambiato ACC: questo risultato è obsoleto
        foreach (var (icao, m) in results)
            if (m is not null)
            {
                var (dep, arr) = SuggestRwy(icao, m);
                _wxMini[icao] = (m.Wind?.Label, m.QnhHpa, dep, arr);
            }
        _wxLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    // Piste suggerite dal profilo (decolli, atterraggi): regole piste se presenti, altrimenti miglior vento di testa.
    private (string? Dep, string? Arr) SuggestRwy(string icao, ParsedMetar m)
    {
        var profile = _profiles.GetValueOrDefault(icao);
        int? windDir = m.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        int windKt = m.Wind?.SpeedKt ?? 0;
        if (profile is { Rules.Count: > 0 })
        {
            var wet = m.HasRain || m.HasSnow;
            var rr = RunwaySuggestion.EvaluateRules(profile.Rules.Select(MapRule).ToList(), windDir, windKt, wet, DateTime.UtcNow);
            if (rr is not null) return (Norm(rr.Dep), Norm(rr.Arr));
        }
        var runways = profile?.Runways.Select(r => r.Ident).ToList() ?? new List<string>();
        if (runways.Count > 0)
        {
            var s = RunwaySuggestion.Suggest(runways, windDir, windKt);
            if (s.Best is not null) return (Norm(s.DepIdent ?? s.Best.Ident), Norm(s.ArrIdent ?? s.Best.Ident));
        }
        return (null, null);
    }

    private static string? Norm(string? rwy) => string.IsNullOrWhiteSpace(rwy) ? null : rwy.Trim();

    // ATC online per l'aeroporto: callsign il cui primo token (prima del "_") è l'ICAO (es. LIRF_TWR, LIRF_S_APP).
    private int OnlineAt(string icao)
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
            cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Voci del sommario, nello stesso ordine e con gli stessi ancoraggi (id) dei blocchi realmente renderizzati.</summary>
    private IEnumerable<(string Id, string Title)> TocEntries()
    {
        yield return ("a-meteo", "METAR & TAF");
        if (_taSection is not null) yield return (_taSection.Id, _taSection.Title);
        if (FreqRows().Any() || _profile is not null) yield return ("a-freq", "Frequenze");
        else if (_freqSection is not null) yield return (_freqSection.Id, _freqSection.Title);
        if (_profile is { Runways.Count: > 0 }) yield return ("a-piste", "Piste");
        foreach (var s in _otherSections) yield return (s.Id, s.Title);
        foreach (var s in ExtraSections()) yield return ($"extra-{s.Id}", s.Title);
    }

    /// <summary>Sezioni editoriali libere del profilo (colonna destra desktop / sotto le SID su schermi stretti).</summary>
    // Sezioni editoriali libere. In anteprima RELEASE si leggono dal documento congelato (_view, dove _profile è null);
    // in live/bozza dal profilo (entità fresca, il documento si rigenera solo alla pubblicazione). Doc 08e-airport.
    private IReadOnlyList<(string Id, string Title, string? Body)> ExtraSections() =>
        _mode.Kind == PreviewKind.Release
            ? _extraSections.Select(s => (
                Id: s.Id, s.Title,
                Body: s.Blocks.FirstOrDefault(b => b.Format == BlockFormat.Prose)?.Body)).ToList()
            : (_profile?.ExtraSections ?? Array.Empty<ExtraSectionRow>())
                .Select(r => ($"extra-doc-{r.Id}", r.Title, r.Body)).ToList();

    private void Recompute()
    {
        // Le regole pista (se presenti) scelgono DEP/ARR dal vento in coda/traverso + superficie; altrimenti fallback headwind.
        var wet = (_metar?.HasRain ?? false) || (_metar?.HasSnow ?? false);
        _ruleResult = _profile is { Rules.Count: > 0 }
            ? RunwaySuggestion.EvaluateRules(_profile.Rules.Select(MapRule).ToList(), _windDir, _windKt, wet, DateTime.UtcNow)
            : null;
        _sugg = RunwaySuggestion.Suggest(_runways, _windDir, _windKt);

        // Pista consigliata DEP/ARR (la selezione NON cambia: cambia solo come la mostriamo nella tabella Piste).
        _depIdents = new(StringComparer.OrdinalIgnoreCase);
        _arrIdents = new(StringComparer.OrdinalIgnoreCase);
        if (_ruleResult is not null)
        {
            foreach (var id in SplitIdents(_ruleResult.Dep)) _depIdents.Add(id);
            foreach (var id in SplitIdents(_ruleResult.Arr)) _arrIdents.Add(id);
        }
        else if (_sugg.Best is not null)
        {
            _depIdents.Add((_sugg.DepIdent ?? _sugg.Best.Ident).Trim());
            _arrIdents.Add((_sugg.ArrIdent ?? _sugg.Best.Ident).Trim());
        }
    }

    private static IEnumerable<string> SplitIdents(string? csv) => (csv ?? "")
        .Split(new[] { ',', ' ', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string RwyRowClass(bool dep, bool arr) =>
        dep && arr ? "rwy-both" : arr ? "rwy-arr" : dep ? "rwy-dep" : "";

    /// <summary>Frequenze d'aeroporto dal catalogo settori, ordinate ATIS · DEL · GND · TWR · APP/DEP (solo con frequenza).</summary>
    private IEnumerable<AirportSectorRow> FreqRows()
    {
        string[] order = { "ATIS", "DEL", "GND", "TWR", "APP", "DEP" };
        return _airportSectors
            .Where(s => !string.IsNullOrWhiteSpace(s.Frequency))
            .OrderBy(s => { var i = Array.IndexOf(order, (s.Position ?? "").Trim().ToUpperInvariant()); return i < 0 ? 99 : i; })
            .ThenByDescending(s => s.IsPrimary)   // dentro il tipo: la principale (★) per prima
            .ThenBy(s => s.ComposePosition);
    }

    private static string FreqName(string? position) => (position ?? "").Trim().ToUpperInvariant() switch
    {
        "ATIS" => "ATIS",
        "DEL" => "Delivery",
        "GND" => "Ground",
        "TWR" => "Tower",
        "APP" => "Approach",
        "DEP" => "Departure",
        "CTR" => "Control",
        "FSS" => "Information",
        _ => position ?? "—",
    };

    private static RunwayRuleEval MapRule(RunwayRuleRow r) =>
        new(r.DepRunways, r.ArrRunways, r.Name, r.Note, r.MaxTailwindKt, r.MaxCrosswindKt, r.Surface,
            r.TimeFromLocalMin, r.TimeToLocalMin, r.DaysOfWeekMask, r.DateParity,
            r.DateFromMonthDay, r.DateToMonthDay);

    private static string TafCss(TafChangeKind k) => k switch
    {
        TafChangeKind.Base => "base",
        TafChangeKind.Becmg => "becmg",
        TafChangeKind.Tempo => "tempo",
        _ => "becmg",
    };

    private static string TafLabel(TafSegment s) => s.Kind switch
    {
        TafChangeKind.Base => "Base",
        TafChangeKind.Becmg => "BECMG",
        TafChangeKind.Tempo => "TEMPO",
        TafChangeKind.From => "FM",
        TafChangeKind.Prob => $"PROB{s.Probability}",
        _ => s.Kind.ToString().ToUpperInvariant(),
    };

    /// <summary>Separa le sezioni: transizione (custom + badge TA) e frequenze affiancate, il resto generico.</summary>
    private void SplitSections(DocumentView view)
    {
        _taSection = _freqSection = null;
        _otherSections = new();
        _extraSections = new();
        _ta = null; _tlRows = new(); _tlCols = Array.Empty<string>();

        foreach (var s in view.Sections)
        {
            if (_taSection is null && s.Title.Contains("transizione", StringComparison.OrdinalIgnoreCase))
                _taSection = s;
            else if (_freqSection is null &&
                     (s.SectionKey == "frequencies" || s.Title.Contains("Frequenz", StringComparison.OrdinalIgnoreCase)))
                _freqSection = s;
            // La sezione Piste è resa custom (con evidenza pista consigliata) quando c'è il profilo strutturato.
            else if (_profile is { Runways.Count: > 0 } && s.Title.Contains("Pist", StringComparison.OrdinalIgnoreCase))
                continue;
            // Sezioni editoriali libere: rese con layout dedicato (inline + rail) da _extraSections, non tra le "altre".
            else if (s.SectionKey == "airportextra")
                _extraSections.Add(s);
            else
                _otherSections.Add(s);
        }

        if (_taSection is not null)
        {
            foreach (var b in _taSection.Blocks)
            {
                if (b.Format == BlockFormat.Prose && b.Body is not null && _ta is null)
                {
                    var m = System.Text.RegularExpressions.Regex.Match(b.Body, @"Altitude[^0-9]*(\d{3,5})");
                    if (m.Success) _ta = int.Parse(m.Groups[1].Value);
                }
                else if (b.Format == BlockFormat.Table && b.BodyJson is not null && _tlRows.Count == 0)
                    ParseTlTable(b.BodyJson);
            }
        }
    }

    private void ParseTlTable(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("columns", out var cols))
                _tlCols = cols.EnumerateArray().Select(c => c.GetString() ?? "").ToList();
            if (root.TryGetProperty("rows", out var rows))
                foreach (var row in rows.EnumerateArray())
                    if (row.TryGetProperty("cells", out var cells) && cells.GetArrayLength() >= 2)
                        _tlRows.Add((cells[0].GetString() ?? "", cells[1].GetString() ?? ""));
        }
        catch (JsonException) { _tlRows = new(); }
    }

    /// <summary>Vero se il QNH ricade nell'intervallo testuale della riga (es. "1014 – 1030", "≥ 1031", "&lt; 984").</summary>
    // Sovrascrive TA e tabella TL con i valori del profilo strutturato LIVE (anteprima bozza). Il formato range QNH
    // usa i simboli riconosciuti da QnhRowMatches (≤/≥/–) per l'evidenziazione della riga col QNH corrente.
    private void ApplyProfileTransition(AirportProfileData p)
    {
        _ta = p.TransitionAltitudeFt;
        if (p.TransitionLevels.Count == 0) return;
        _tlCols = new[] { "QNH (hPa)", "Transition Level" };
        _tlRows = p.TransitionLevels.Select(t => (Range: QnhRangeLabel(t.QnhFrom, t.QnhTo), t.Level)).ToList();
    }

    private static string QnhRangeLabel(int? from, int? to) => (from, to) switch
    {
        (null, null) => "Tutti",
        (null, int t) => $"≤ {t}",
        (int f, null) => $"≥ {f}",
        (int f, int t) => $"{f}–{t}",
    };

    private static bool QnhRowMatches(string range, int qnh)
    {
        var nums = System.Text.RegularExpressions.Regex.Matches(range, @"\d+")
            .Select(m => int.Parse(m.Value)).ToList();
        if (nums.Count == 0) return false;
        if (range.Contains('≥') || range.Contains(">=")) return qnh >= nums[0];
        if (range.Contains('≤') || range.Contains("<=")) return qnh <= nums[0];
        if (range.Contains('>')) return qnh > nums[0];
        if (range.Contains('<')) return qnh < nums[0];
        return nums.Count >= 2 && qnh >= Math.Min(nums[0], nums[1]) && qnh <= Math.Max(nums[0], nums[1]);
    }

    /// <summary>Estrae gli identificativi pista dalla tabella "Piste" del documento (prima colonna).</summary>
    private static List<string> ExtractRunways(DocumentView view)
    {
        var idents = new List<string>();
        foreach (var s in view.Sections)
        {
            if (!s.Title.Contains("Pist", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var b in s.Blocks)
            {
                if (b.Format != BlockFormat.Table || string.IsNullOrWhiteSpace(b.BodyJson)) continue;
                try
                {
                    using var doc = JsonDocument.Parse(b.BodyJson!);
                    if (!doc.RootElement.TryGetProperty("rows", out var rows)) continue;
                    foreach (var row in rows.EnumerateArray())
                    {
                        if (row.TryGetProperty("cells", out var cells) && cells.GetArrayLength() > 0)
                        {
                            var ident = cells[0].GetString();
                            if (!string.IsNullOrWhiteSpace(ident)) idents.Add(ident!.Trim());
                        }
                    }
                }
                catch (JsonException) { /* tabella non standard: ignora */ }
            }
        }
        return idents;
    }
