@page "/services/vsop/{Acc}/airports"
@layout SopLayout
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection

@* ⚠️ SCOPE PROPRIO (OwningComponentBase), come già sei componenti di questo repository dopo l'audit del
   30 luglio 2026. Il motivo è misurato, non teorico: alle 17:44 del 24 agosto questa pagina è morta sette
   volte con «A second operation was started on this context instance» — la sua query trovava il DbContext
   della richiesta già occupato da qualcun altro.

   Con uno scope proprio la pagina lavora su un DbContext SUO: nessuno può passarle davanti, e non serve
   sapere chi fosse l'altro — che è il punto, perché quello non si è ancora capito (voce E9).

   ⚠️ NON tutto si sposta nello scope proprio. `IStationResolver` resta quello della richiesta perché il
   layout l'ha già scaldato (`Prewarm`): riprendendolo dallo scope nuovo si ripagherebbe la stessa query,
   a freddo. Restano fuori anche le cose che il database non lo toccano: localizzazione, AIRAC, meteo,
   cache degli ATC online. *@
@rendermode InteractiveServer
@using System.Text.Json
@using Vipi.Application.Content
@using Vipi.Application.Weather
@inject IStationResolver Stations
@inject Vipi.Application.Abstractions.IWeatherProvider Weather
@inject IOnlineAtcProvider Online
@using Vipi.Ui.Shared
@inject IStringLocalizer<SharedResource> L

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_listMode)
{
    <PageTitle>@L["AccLanding_Airports"] @_acc.Code · vIPI IVAO Italia</PageTitle>
    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@L["AccLanding_Airports"]</b></div>
        <div class="doc-head">
            <div><h1 class="page-h1" style="margin-bottom:2px">@L["AccLanding_Airports"] — @_acc.Name - @_acc.Code</h1></div>
        </div>
        @if (_allAirports.Count == 0)
        {
            <EmptyState Title="@L["Common_NoAirport"]">@L["Airport_NoneBody"]</EmptyState>
        }
        else
        {
            @* Il chip c'è solo dove c'è qualcosa da filtrare: su una ACC di soli scali civili sarebbe un
               comando che non fa niente. Ricliccato torna a «tutti», come i chip della pagina Aeroporti. *@
            @if (MilitaryCount() > 0 && MilitaryCount() < _allAirports.Count)
            {
                <div class="struct-bar" style="margin-top:14px">
                    <span class="sb-chips">
                        <button class="sh-chip @(_milFilter == MilFilter.Military ? "on" : "")"
                                title="@L["Airport_ChipMilitaryTitle"]" @onclick="() => ToggleMil(MilFilter.Military)">@L["Apt_ChipMilitary", MilitaryCount()]</button>
                        <button class="sh-chip @(_milFilter == MilFilter.Civil ? "on" : "")"
                                title="@L["Airport_ChipCivilTitle"]" @onclick="() => ToggleMil(MilFilter.Civil)">@L["Airport_ChipCivil", _allAirports.Count - MilitaryCount()]</button>
                    </span>
                </div>
            }
            <div class="choice-grid" style="margin-top:14px">
                @foreach (var ap in ShownAirports())
                {
                    var n = OnlineAt(ap.Icao);
                    <a class="choice apt-card" href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@ap.Icao">
                        <div class="apt-top">
                            <h2 class="h-card">@ap.Icao</h2>
                            <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? L["Common_OnlineN", n] : L["Common_Offline"])</span>
                        </div>
                        <p class="muted">@ap.Name</p>
                        @if (ap.HasMilitaryPresence)
                        {
                            <p class="apt-mil"><MilitaryTag HasMilitaryPresence="ap.HasMilitaryPresence" IsMilitaryOnly="ap.IsMilitaryOnly" /></p>
                        }
                        @if (_wxMini.TryGetValue(ap.Icao, out var wx))
                        {
                            <div class="apt-wx">
                                <span><span class="wx-k">@L["Airport_Wind"]</span><b>@(string.IsNullOrWhiteSpace(wx.Wind) ? "—" : wx.Wind)</b></span>
                                <span><span class="wx-k">QNH</span><b>@(wx.Qnh is int q ? $"{q}" : "—")</b></span>
                                @if (!string.IsNullOrEmpty(wx.Dep) || !string.IsNullOrEmpty(wx.Arr))
                                {
                                    <span><span class="wx-k">@L["Airport_Departures"]</span><b>@(wx.Dep ?? "—")</b></span>
                                    <span><span class="wx-k">@L["Airport_Arrivals"]</span><b>@(wx.Arr ?? "—")</b></span>
                                }
                            </div>
                        }
                        else if (_wxLoading)
                        {
                            <div class="apt-wx loading"><span class="muted" style="font-size:12.5px">@L["Airport_WxLoading"]</span></div>
                        }
                    </a>
                }
            </div>
        }
    </div>
}
else if (_view is null)
{
    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@_icao</b></div>
        <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["Airport_DocNotAvailTitle"]</p>@string.Format(L["Airport_DocNotAvailBody"], _icao)</div></div>
    </div>
}
else
{
    <PageTitle>@PreviewTitlePrefix()@_view.Title · vIPI IVAO Italia</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/airports">@L["AccLanding_Airports"]</a> › <b>@_view.Title</b></div>

        <div class="doc-layout">
            <aside class="toc" aria-label="@L["Doc_TocAria"]">
                <p class="toc-h">@L["Common_Contents"]</p>
                <ul>
                    @foreach (var sec in VisibleSections())
                    {
                        <li><a href="#@AnchorOf(sec)">@sec.Title</a></li>
                    }
                </ul>
            </aside>

            <div>
                <PrintMeta Title="@_view.Title" Subtitle="@($"{L["Airport_SubtitlePrefix"]} · {_acc.Name}")"
                           AiracCycle="@(_relCycle ?? _view.AiracCycle)" />
                <div class="doc-head">
                    <div>
                        <h2 style="margin-bottom:2px">
                            @_view.Title
                            <MilitaryTag HasMilitaryPresence="_militaryPresence" IsMilitaryOnly="_militaryOnly" />
                        </h2>
                        <span class="muted">@L["Airport_SubtitlePrefix"] · @_acc.Name</span>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@L["Common_Print"]</button>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="/services/vsop/@Acc.ToLowerInvariant()/airports/editor?icao=@_icao">@L["Common_Editor"]</a>
                        }
                    </div>
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}&as=draft")" />
                }

                @* ---------- Le sezioni, nell'ORDINE DEL DOCUMENTO ----------
                   Come nelle altre tre famiglie: si itera `_view.Sections` e si dispaccia per chiave. Fino alla
                   carta 2026-08-26 questa pagina aveva la sequenza CABLATA (meteo → TA+frequenze affiancate →
                   piste → SID → extra) e ritrovava le sezioni con `Title.Contains("transi")`. Per questo
                   riordinare, nascondere o infilare una sezione libera in mezzo non aveva alcun effetto: il
                   documento poteva dire quello che voleva, la pagina disegnava sempre la stessa cosa. *@
                @foreach (var sec in _sezioni)
                {
                    var nascosta = sec.IsHidden;
                    @if (nascosta && _mode.Kind != PreviewKind.Draft)
                    {
                        <text></text>   @* nascosta: fuori dal pubblico e dall'anteprima release *@
                    }
                    else if (IsSpecial(sec.SectionKey))
                    {
                        @* ⚠️ Il meteo non va in stampa: è un dato live, e su carta sarebbe un'istantanea già
                           scaduta quando la si legge. È anche l'unica sezione che non si congela mai. *@
                        <CollapsibleBlock Id="@AnchorOf(sec)" ExtraClass="@(sec.SectionKey == "weather" ? "noprint" : null)"
                                          Style="@(nascosta ? "opacity:.65" : null)"
                                          InitiallyOpen="@(!SectionCatalog.IsInitiallyCollapsed(sec.SectionKey))">
                            <Header>
                                <h2 class="h-sect" style="margin-top:0">
                                    @* ⚠️ Il meteo porta l'intestazione che aveva quando era un riquadro a sé:
                                       l'emoji, l'ICAO e la nota «live NOAA». Non è decorazione — dice DI CHI è
                                       il tempo che si sta leggendo e che è vivo, e sono le due cose che questa
                                       sezione ha da dire prima di essere aperta. *@
                                    @if (sec.SectionKey == "weather") { <text>🌦️ </text> }
                                    @SectionHeading(sec)
                                    @if (sec.SectionKey == "weather")
                                    {
                                        <text> · @_icao </text>
                                        <span class="muted" style="font-weight:400;font-size:13px">@L["Airport_LiveNoaa"]</span>
                                    }
                                    @if (nascosta) { <span class="pill neutral" style="font-weight:500">@L["Common_HiddenNotPublic"]</span> }
                                </h2>
                            </Header>
                            <ChildContent>
                                @* Sotto-sezioni «prima» del corpo derivato (doc 11 §3g). *@
                                @if (SectionBody.HasChildren(sec, SectionSlot.Before))
                                {
                                    <SectionBody Section="sec" ShowBlocks="false" Slot="SectionSlot.Before" />
                                }
                                @switch (sec.SectionKey)
                                {
                                    case "weather":
                                        <AirportWeather Icao="@_icao" Report="_wx" Metar="_metar" Taf="_taf" />
                                        break;
                                    case "runwayrules":
                                        <AirportRunwayRules View="_derived.Rules" ActivePosition="@(_ruleResult is null ? null : _ruleResult.RuleIndex + 1)" />
                                        break;
                                    case "transition":
                                        <AirportTransition View="_derived.Transition" CurrentQnh="_metar?.QnhHpa" />
                                        break;
                                    case "frequencies":
                                        <AirportFrequencies View="_derived.Frequencies" />
                                        break;
                                    case "runways":
                                        <AirportRunways View="_derived.Runways" DepIdents="_depIdents" ArrIdents="_arrIdents"
                                                        RuleName="@(_ruleResult is null ? null : _ruleResult.RuleName ?? $"#{_ruleResult.RuleIndex + 1}")"
                                                        RuleNote="@_ruleResult?.Note" WindDir="_windDir" WindKt="_windKt"
                                                        HasRain="@(_metar?.HasRain == true)" HasSnow="@(_metar?.HasSnow == true)" />
                                        break;
                                    case "sids":
                                        <AirportSids View="_derived.Sids" Selected="@_sidRwy" SelectedChanged="SelectSidRwy"
                                                     DepIdents="_depIdents" TransitionAltitudeFt="_derived.Transition.TransitionAltitudeFt" />
                                        break;
                                    case "validity":
                                        <ValidityStamp Target="ReleaseTargetType.Airport" Key="@_icao" ReleaseId="@ReleaseIdShown()" />
                                        break;
                                }
                                @* La sezione tiene ANCHE i suoi blocchi: il timbro sopra, il testo scritto a mano sotto. *@
                                @if (SectionCatalog.KeepsOwnBlocks(SectionProfile.Airport, sec.SectionKey))
                                {
                                    <SectionBody Section="sec" ShowBlocks="true" />
                                }
                                @if (SectionBody.HasChildren(sec, SectionSlot.After))
                                {
                                    <SectionBody Section="sec" ShowBlocks="false" Slot="SectionSlot.After" />
                                }
                            </ChildContent>
                        </CollapsibleBlock>
                    }
                    else if (nascosta)
                    {
                        @* Editoriale nascosta in anteprima bozza: stessa marcatura delle speciali, o non si
                           capirebbe che è fuori dal pubblico. *@
                        <CollapsibleBlock Id="@AnchorOf(sec)" Style="opacity:.65"
                                          InitiallyOpen="@(!SectionCatalog.IsInitiallyCollapsed(sec.SectionKey))">
                            <Header><h2 class="h-sect" style="margin-top:0">@sec.Title <span class="pill neutral" style="font-weight:500">@L["Common_HiddenNotPublic"]</span></h2></Header>
                            <ChildContent><SectionBody Section="sec" /></ChildContent>
                        </CollapsibleBlock>
                    }
                    else
                    {
                        <SectionNode Section="sec" />   @* editoriale/libera: prosa/tabella/callout + sotto-sezioni *@
                    }
                }
            </div>

            @* Colonna destra sticky (desktop ≥1500px): riepilogo + link + eventuali sezioni extra del profilo. *@
            <aside class="doc-rail" aria-label="@L["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @L["Common_Summary"]</h5>
                    <div class="rail-line"><span class="muted">@L["Common_AiracCycle"]</span><b>@_view.AiracCycle</b></div>
                    <div class="rail-line"><span class="muted">@L["Common_AtcOnline"]</span>
                        @{ var n = OnlineAt(_icao); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                    @* «Quanti» non dice a chi parlare: questa riga sì, ed è la stessa risposta della vista live. *@
                    <div class="rail-line"><span class="muted">@L["Live_AptPresidedLabel"]</span><b>@ChiPresiede()</b></div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @L["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@L["Common_Home"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @_acc.Code</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()/airports">@L["AccLanding_Airports"]</a></li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Icao { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }
    private PreviewMode _mode;
    private string? _relCycle;

    private AccInfo? _acc;
    private DocumentView? _view;
    private bool _listMode;
    private bool _canEdit;
    private IReadOnlyList<AirportRow> _allAirports = Array.Empty<AirportRow>();
    // Taglio militare/civile dell'elenco: uno alla volta, ricliccato torna a «tutti».
    private enum MilFilter { All, Military, Civil }
    private MilFilter _milFilter = MilFilter.All;
    // Anagrafica militare dell'aeroporto aperto. Campi a parte e non letti da `_profile`, che in anteprima di
    // release viene azzerato di proposito: la presenza di una base non è un dato di release, e sparire dalla
    // testata solo perché si guarda un ciclo passato sarebbe un'informazione persa senza motivo.
    private bool _militaryPresence;
    private bool _militaryOnly;
    // Meteo mini per card (elenco): ICAO → (vento, QNH, piste suggerite decolli/atterraggi) dal METAR live.
    private readonly System.Collections.Concurrent.ConcurrentDictionary<string, (string? Wind, int? Qnh, string? Dep, string? Arr)> _wxMini = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, AirportData?> _profiles = new(StringComparer.OrdinalIgnoreCase);
    private int _wxGen;          // token anti-corsa: scarta i caricamenti meteo di ACC ormai cambiate
    private bool _wxLoading;     // true finché il meteo di questo elenco non è arrivato
    private string _icao = "";
    private Vipi.Application.Abstractions.WeatherReport? _wx;

    private ParsedMetar? _metar;
    private ParsedTaf? _taf;

    private List<string> _runways = new();
    private int? _windDir;
    private int _windKt;
    private RunwaySuggestionResult _sugg = new(null, Array.Empty<RunwayPick>(), "");
    private AirportData? _profile;
    private RunwayRuleResult? _ruleResult;
    private HashSet<string> _depIdents = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _arrIdents = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Le sezioni derivate risolte per QUESTA vista: frozen dalla release effettiva se c'è, sennò live.
    /// Un solo oggetto per tutte, come <c>AppViewDerived</c> sull'APP.</summary>
    private AirportDerived _derived = AirportDerived.Empty;

    private string? _sidRwy;             // pista selezionata nel filtro SID (default: pista in uso in partenza)
    private bool _sidRwyUserPicked;      // l'utente ha scelto una pista → non sovrascrivere col default al Recompute

    /// <summary>Chi presiede l'aeroporto: risolto nel ciclo di vita, MAI nel render (regola del progetto:
    /// nessuna I/O sul database mentre si disegna, o il circuito muore con «second operation»).</summary>
    private Vipi.Application.Live.AirportPresidency? _presidency;

    // I servizi che interrogano il database: presi dallo SCOPE DI QUESTA PAGINA, non da quello
    // della richiesta. Vedi il commento in testa al file.
    private IVipiViewService ViewService = default!;
    private IStructureEditingService Structure = default!;
    private IAirportEditingService Profile = default!;
    private IAirportViewDerivationService AirportView = default!;
    private IAirportSectorService AirportSectors = default!;
    private IDocumentAdminService Docs = default!;
    private Vipi.Application.Live.IAirportPresidencyService Presidency = default!;
    private IEditAuthorizationService Authz = default!;
    private IReleaseService Releases = default!;

    protected override void OnInitialized()
    {
        ViewService = ScopedServices.GetRequiredService<IVipiViewService>();
        Structure = ScopedServices.GetRequiredService<IStructureEditingService>();
        Profile = ScopedServices.GetRequiredService<IAirportEditingService>();
        AirportView = ScopedServices.GetRequiredService<IAirportViewDerivationService>();
        AirportSectors = ScopedServices.GetRequiredService<IAirportSectorService>();
        Docs = ScopedServices.GetRequiredService<IDocumentAdminService>();
        Presidency = ScopedServices.GetRequiredService<Vipi.Application.Live.IAirportPresidencyService>();
        Authz = ScopedServices.GetRequiredService<IEditAuthorizationService>();
        Releases = ScopedServices.GetRequiredService<IReleaseService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) { _view = null; return; }

        // Senza ?icao= la pagina è l'elenco degli aeroporti della ACC; con ?icao= mostra il documento.
        _listMode = string.IsNullOrWhiteSpace(Icao);
        if (_listMode)
        {
            var data = await Structure.LoadAsync(_acc.Code);
            // Solo aeroporti con release AIRAC effettiva e non nascosti (doc 10 §3f: visibilità pubblica = release effettiva).
            var published = (await Docs.ListAsync())
                .Where(m => m.Kind == ManagedDocKind.AirportVipi && m.HasEffectiveRelease && !m.IsHidden
                            && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.Scope)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _allAirports = data?.Airports
                .Where(x => x.IsPublic && published.Contains(x.Icao))
                .OrderBy(x => x.Icao).ToList()
                ?? (IReadOnlyList<AirportRow>)Array.Empty<AirportRow>();

            // Profili piste (DB, veloci) — servono per la pista consigliata. Il METAR (HTTP, lento) NON viene
            // atteso qui: la lista si renderizza subito e il meteo arriva in background (LoadMeteoAsync).
            _profiles.Clear();
            foreach (var ap in _allAirports) _profiles[ap.Icao] = await Profile.LoadForViewAsync(ap.Icao);
            _wxMini.Clear();
            _wxLoading = _allAirports.Count > 0;
            var gen = ++_wxGen;
            _ = LoadMeteoAsync(gen);
            return;
        }

        _icao = Icao!.ToUpperInvariant();
        _mode = PreviewMode.Parse(As);
        _relCycle = null;
        _presidency = await Presidency.ResolveAsync(_icao);
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (await Authz.CanEditAccAsync(_acc.Code))
                    _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            case PreviewKind.Release:
                var pv = await TryPreviewAsync(_mode.ReleaseId, ReleaseTargetType.Airport, _icao);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false); }
                break;
            default:
                _view = await ViewService.BuildAirportVipiAsync(_icao, BlockTier.Extended, live: false);
                break;
        }
        if (_view is null) return;
        _sezioni = AirportLegacySections.ForView(_view.Sections);
        _canEdit = await Authz.CanEditAccAsync(_acc.Code);   // tasto Editor solo a chi può editare l'ACC

        _wx = await Weather.GetAsync(_icao);
        _metar = string.IsNullOrWhiteSpace(_wx?.Metar) ? null : MetarParser.ParseMetar(_wx!.Metar!);
        _taf = string.IsNullOrWhiteSpace(_wx?.Taf) ? null : MetarParser.ParseTaf(_wx!.Taf!);

        // ⚠️ Il profilo serve solo alle regole piste, che decidono la pista IN USO ADESSO: quella si valuta
        // sempre sulle regole vive, anche mentre si guarda un ciclo passato — è la risposta a «dove atterro»,
        // non un dato di release. La tabella delle regole, invece, viene dalle derivate come tutto il resto.
        _profile = await Profile.LoadForViewAsync(_icao);
        var anagrafica = Stations.Airport(_icao);
        _militaryPresence = anagrafica?.HasMilitaryPresence ?? false;
        _militaryOnly = anagrafica?.IsMilitaryOnly ?? false;
        // ⚠️ Le sezioni derivate si risolvono INSIEME al documento e con lo stesso criterio (doc 11 §3d): frozen
        // solo in vista pubblica, live in bozza e in anteprima di release. Deciderlo sezione per sezione, o
        // lasciare che un ramo di fallback dimenticasse il flag, renderebbe il congelamento AIRAC aggirabile
        // da un `?as=` qualsiasi.
        var useFrozen = _mode.Kind is not (PreviewKind.Draft or PreviewKind.Release);
        _derived = await AirportView.ResolveForViewAsync(_icao, useFrozen);
        _runways = _derived.Runways.Rows.Count > 0
            ? _derived.Runways.Rows.Select(r => r.Ident).ToList()
            : ExtractRunways(_view);
        // Vento iniziale dal METAR, se noto.
        _windDir = _metar?.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        _windKt = _metar?.Wind?.SpeedKt ?? 0;
        Recompute();
    }

    private int MilitaryCount() => _allAirports.Count(x => x.HasMilitaryPresence);

    private List<AirportRow> ShownAirports() => _milFilter switch
    {
        MilFilter.Military => _allAirports.Where(x => x.HasMilitaryPresence).ToList(),
        MilFilter.Civil => _allAirports.Where(x => !x.HasMilitaryPresence).ToList(),
        _ => _allAirports.ToList(),
    };

    private void ToggleMil(MilFilter f) => _milFilter = _milFilter == f ? MilFilter.All : f;

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => $"{L["Common_DraftTag"]} ",
        PreviewKind.Release => $"{L["Common_PreviewTag"]} ",
        _ => "",
    };

    private async Task<ReleasePreview?> TryPreviewAsync(int releaseId, ReleaseTargetType expectedType, string? expectedKey)
    {
        try
        {
            var pv = await Releases.GetPreviewAsync(releaseId);
            if (pv is null || pv.Type != expectedType
                || (expectedKey is not null && !string.Equals(pv.TargetKey, expectedKey, StringComparison.OrdinalIgnoreCase)))
                return null;
            return pv;
        }
        catch (EditNotAllowedException) { return null; }
        catch (Vipi.Application.Aor.ValidationException) { return null; }
    }

    // Carica il METAR (HTTP, in parallelo) di tutti gli aeroporti dell'elenco e ne deriva vento/QNH/pista.
    // Fuori dal percorso di render: la lista è già visibile, il meteo compare appena pronto.
    private async Task LoadMeteoAsync(int gen)
    {
        var results = await Task.WhenAll(_allAirports.Select(async ap =>
        {
            try
            {
                var wx = await Weather.GetAsync(ap.Icao);
                var m = string.IsNullOrWhiteSpace(wx?.Metar) ? null : MetarParser.ParseMetar(wx!.Metar!);
                return (ap.Icao, Metar: m);
            }
            catch { return (ap.Icao, Metar: (ParsedMetar?)null); }
        }));

        if (gen != _wxGen) return;   // l'utente ha cambiato ACC: questo risultato è obsoleto
        foreach (var (icao, m) in results)
            if (m is not null)
            {
                var (dep, arr) = SuggestRwy(icao, m);
                _wxMini[icao] = (m.Wind?.Label, m.QnhHpa, dep, arr);
            }
        _wxLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    // Piste suggerite dal profilo (decolli, atterraggi): regole piste se presenti, altrimenti miglior vento di testa.
    private (string? Dep, string? Arr) SuggestRwy(string icao, ParsedMetar m)
    {
        var profile = _profiles.GetValueOrDefault(icao);
        int? windDir = m.Wind is { Calm: false, DirectionDeg: int d } ? d : null;
        int windKt = m.Wind?.SpeedKt ?? 0;
        if (profile is { Rules.Count: > 0 })
        {
            var wet = m.HasRain || m.HasSnow;
            var rr = RunwaySuggestion.EvaluateRules(profile.Rules.Select(MapRule).ToList(), windDir, windKt, wet, DateTime.UtcNow);
            if (rr is not null) return (Norm(rr.Dep), Norm(rr.Arr));
        }
        var runways = profile?.Runways.Select(r => r.Ident).ToList() ?? new List<string>();
        if (runways.Count > 0)
        {
            var s = RunwaySuggestion.Suggest(runways, windDir, windKt);
            if (s.Best is not null) return (Norm(s.DepIdent ?? s.Best.Ident), Norm(s.ArrIdent ?? s.Best.Ident));
        }
        return (null, null);
    }

    private static string? Norm(string? rwy) => string.IsNullOrWhiteSpace(rwy) ? null : rwy.Trim();

    // ATC online per l'aeroporto: callsign il cui primo token (prima del "_") è l'ICAO (es. LIRF_TWR, LIRF_S_APP).
    // ⚠️ L'ATIS è escluso: nell'elenco delle postazioni c'è, ma è una frequenza registrata, non qualcuno che
    // controlla — contarlo faceva apparire «1 online» un aeroporto dove non risponde nessuno.
    private int OnlineAt(string icao)
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
            cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase) &&
            !cs.EndsWith("_ATIS", StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Chi presiede questo aeroporto adesso, in una riga: posizioni sue online dal gate in su e, per ciò che
    /// non è presidiato in loco, chi lo copre risalendo. Stessa risposta della vista live, stesso risolutore.
    /// </summary>
    private string ChiPresiede()
    {
        if (_presidency is not { } p) return "—";
        if (p.Unicom) return L["Live_AptPresidedNobody"];

        var locali = string.Join(" · ", p.Local.Select(s => s.Callsign));
        if (p.Covering is null) return locali;
        return locali.Length == 0
            ? L["Live_AptCoveredBy", p.Covering.Callsign].Value
            : $"{locali} — {L["Live_AptCoveredBy", p.Covering.Callsign].Value}";
    }

    // Sezioni il cui corpo lo rende questa pagina; le altre passano da SectionNode. Chi siano lo dice il
    // catalogo, per profilo (doc 13 §3a) — non un insieme scritto qui dentro.
    private static bool IsSpecial(string key) => SectionCatalog.IsHostRendered(SectionProfile.Airport, key);

    /// <summary>
    /// Le sezioni da rendere: quelle del documento mostrato, con le <b>cotte</b> riportate alla loro chiave di
    /// catalogo e con il <b>meteo</b> aggiunto se manca (<see cref="AirportLegacySections.ForView"/>).
    /// <para>⚠️ Serve agli snapshot di release anteriori alla carta 2026-08-26, che non si riscrivono mai: senza,
    /// la pagina pubblica di ogni aeroporto non ancora ripubblicato perde le tabelle vere e il meteo.</para>
    /// </summary>
    private IReadOnlyList<SectionView> _sezioni = Array.Empty<SectionView>();

    // Ancora di sezione: «s-{Id}» per TUTTE, anche per quelle rese dalla pagina (doc 13 §3e), così i deep-link
    // della ricerca — che indicizza per Id — atterrano dove devono e non in cima alla pagina.
    private static string AnchorOf(SectionView s) => s.Id;

    /// <summary>La release che questa vista mostra: quella dell'anteprima, o null = la effettiva adesso.</summary>
    private int? ReleaseIdShown() => _mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null;

    private IEnumerable<SectionView> VisibleSections() =>
        _sezioni.Where(s => _mode.Kind == PreviewKind.Draft || !s.IsHidden);

    /// <summary>
    /// Titolo mostrato per una sezione di catalogo. ⚠️ Uno snapshot di release scritto PRIMA della carta
    /// 2026-08-26 porta i titoli in inglese («Transition levels»), perché li scriveva la cottura: chi legge
    /// un ciclo passato deve vedere il documento com'era, ma le sezioni riconciliate hanno il titolo nuovo e
    /// devono leggersi uguali alle altre. Quindi: titolo del catalogo se la chiave è del catalogo.
    /// </summary>
    private static string SectionHeading(SectionView s) =>
        SectionCatalog.Find(SectionProfile.Airport, s.SectionKey)?.Title ?? s.Title;

    private void Recompute()
    {
        // Le regole pista (se presenti) scelgono DEP/ARR dal vento in coda/traverso + superficie; altrimenti fallback headwind.
        // ⚠️ Si valutano sulle regole VIVE, non su quelle eventualmente congelate: «quale pista è in uso adesso»
        // è una domanda sul presente, e resta tale anche mentre si sfoglia un ciclo passato.
        var wet = (_metar?.HasRain ?? false) || (_metar?.HasSnow ?? false);
        _ruleResult = _profile is { Rules.Count: > 0 }
            ? RunwaySuggestion.EvaluateRules(_profile.Rules.Select(MapRule).ToList(), _windDir, _windKt, wet, DateTime.UtcNow)
            : null;
        _sugg = RunwaySuggestion.Suggest(_runways, _windDir, _windKt);

        // Pista consigliata DEP/ARR (la selezione NON cambia: cambia solo come la mostriamo nella tabella Piste).
        _depIdents = new(StringComparer.OrdinalIgnoreCase);
        _arrIdents = new(StringComparer.OrdinalIgnoreCase);
        if (_ruleResult is not null)
        {
            foreach (var id in SplitIdents(_ruleResult.Dep)) _depIdents.Add(id);
            foreach (var id in SplitIdents(_ruleResult.Arr)) _arrIdents.Add(id);
        }
        else if (_sugg.Best is not null)
        {
            _depIdents.Add((_sugg.DepIdent ?? _sugg.Best.Ident).Trim());
            _arrIdents.Add((_sugg.ArrIdent ?? _sugg.Best.Ident).Trim());
        }

        // Default filtro SID = pista in uso in partenza (se ha SID), altrimenti la prima pista con SID. Se l'utente ha
        // già scelto una pista la rispettiamo; se la sua scelta non è più valida ricade sul default.
        var sidRwys = AirportSids.RunwaysOf(_derived.Sids);
        if (!_sidRwyUserPicked || _sidRwy is null || !sidRwys.Contains(_sidRwy, StringComparer.OrdinalIgnoreCase))
            _sidRwy = sidRwys.FirstOrDefault(r => _depIdents.Contains(r)) ?? sidRwys.FirstOrDefault();
    }

    private void SelectSidRwy(string rw) { _sidRwy = rw; _sidRwyUserPicked = true; }

    private static IEnumerable<string> SplitIdents(string? csv) => (csv ?? "")
        .Split(new[] { ',', ' ', '/' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string RwyRowClass(bool dep, bool arr) =>
        dep && arr ? "rwy-both" : arr ? "rwy-arr" : dep ? "rwy-dep" : "";

    private static RunwayRuleEval MapRule(RunwayRuleRow r) => AirportViewFormat.MapRule(r);

    /// <summary>
    /// Ripiego: estrae gli identificativi pista dalla tabella «Piste» COTTA nel documento. Serve solo agli
    /// snapshot di release anteriori alla carta 2026-08-26 — un documento di lavoro le piste le ha nel profilo,
    /// e la derivazione le porta gia'. Per questo cerca ancora per titolo: quelle sezioni hanno chiavi casuali.
    /// </summary>
    private static List<string> ExtractRunways(DocumentView view)
    {
        var idents = new List<string>();
        foreach (var s in view.Sections)
        {
            if (!s.Title.Contains("pist", StringComparison.OrdinalIgnoreCase) && !s.Title.Contains("runway", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (var b in s.Blocks)
            {
                if (b.Format != BlockFormat.Table || string.IsNullOrWhiteSpace(b.BodyJson)) continue;
                try
                {
                    using var doc = JsonDocument.Parse(b.BodyJson!);
                    if (!doc.RootElement.TryGetProperty("rows", out var rows)) continue;
                    foreach (var row in rows.EnumerateArray())
                    {
                        if (row.TryGetProperty("cells", out var cells) && cells.GetArrayLength() > 0)
                        {
                            var ident = cells[0].GetString();
                            if (!string.IsNullOrWhiteSpace(ident)) idents.Add(ident!.Trim());
                        }
                    }
                }
                catch (JsonException) { /* tabella non standard: ignora */ }
            }
        }
        return idents;
    }
}
