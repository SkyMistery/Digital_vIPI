@page "/services/vsop/admin/attachments"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Abstractions
@using Vipi.Application.Content
@using Vipi.Domain
@using Vipi.Domain.Entities
@inject IEditAuthorizationService Authz
@inject IAttachmentLibrary Biblioteca
@inject IAttachmentUsage Uso
@inject IAttachmentCuration Cura
@inject IStringLocalizer<SharedResource> L

@* La biblioteca degli allegati: i PDF caricati in un posto solo e citabili dai documenti
   (carta docs/feature/2026-08-25-biblioteca-allegati.md, slice 2).

   ⚠️ Perché esiste. I byte NON stanno da noi — il piano di hosting non ammette il formato PDF (vincolo
   contrattuale) e IVAO HQ vuole i documenti sul Drive di divisione. Quel che manca, oggi, è il registro: i
   link a Drive stanno sparsi dentro i documenti, nessuno sa quali siano né dove, e quando uno muore non se
   ne accorge nessuno.

   ⚠️ L'elenco mostra TUTTO, comprese le voci che non cita nessuno. È il catch-22 della regola 3 del gate:
   un elenco che mostrasse solo le voci citate renderebbe irraggiungibile la PRIMA voce caricata — è già
   successo con gli APP, dove si vedevano solo i pubblicati e il primo non si poteva creare.

   ⚠️ «Citato da» si RICAVA leggendo i quattro posti in cui un riferimento può comparire — blocchi (bozze
   comprese), sezioni extra, payload delle release e blocchi condivisi — non da una tabella di join, che si
   desincronizza al primo percorso di scrittura che dimentica di aggiornarla e mente proprio qui.
   ⚠️ E il chip «mai usata» è il modo di tenere pulita la biblioteca: senza, una voce caricata per sbaglio non
   si distingue più da una che serve.

   ⚠️ La sostituzione è una CONFERMA INFORMATA, non un «sei sicuro?»: prima di premere si vede l'elenco dei
   documenti che cambiano, con lo stato di ciascuno. È l'unica informazione con cui si decide, e il link segue
   sempre la versione corrente — quindi un documento già PUBBLICATO mostra il file nuovo senza che nessuno
   l'abbia toccato.

   ⚠️ L'eliminazione NON si rifiuta quando la voce è citata, e non è una svista: rifiutare avrebbe senso se
   ci fosse un modo automatico di rimediare, e non c'è — le citazioni stanno dentro testo scritto da persone.
   Si vede QUALI documenti resteranno col link morto, si conferma, e quei documenti vengono segnalati.

   ⚠️ Tutto ciò che entra qui è PUBBLICO: il file su Drive è condiviso «chiunque abbia il link». Allegati
   riservati non esistono, e la pagina lo dice invece di lasciarlo scoprire.

   ⚠️ Il tasto «Apri» passa dalla NOSTRA rotta, /vsop/files/{slug}, non dall'indirizzo del deposito — come
   ogni altro link a un allegato, qui e nei documenti. Provarla di qui è anche l'unico modo di accorgersi
   che un link è morto senza aprire il documento che lo cita. *@

<PageTitle>@L["Att_Title"] · IVAO Italy</PageTitle>

<div class="wrap struct">
    <AdminNav />

    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Att_Title"]&nbsp;<span class="pill blue">@_righe.Count</span>
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-allegati" AriaLabel="@L["Att_Title"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Att_Subtitle"]</p>
            @((MarkupString)L["Att_Intro"].Value)
        </HelpHint>
        <LiveRegion>
            @if (_messaggio is not null)
            {
                <span class="st-msg @(_ok ? "ok" : "warn")">
                    <Icon Name="@(_ok ? "check-circle" : "warning")" Size="14" />
                    <span class="st-msg-t">@_messaggio</span>
                    <button class="tclose" title="@L["Common_Close"]" @onclick="() => _messaggio = null">✕</button>
                </span>
            }
        </LiveRegion>
    </div>

    @if (!PuoScrivere)
    {
        <div class="callout danger"><span class="cic">🔒</span><div>@L["Vle_Unauthorized"]</div></div>
    }
    else
    {
        <div class="block">
            @* I due assi della biblioteca sono DUE FILTRI, non una cartella: «le LoA di Roma» si ottengono
               scegliendo un tipo e un ambito. Un albero di cartelle a 50+ file si riempie di roba archiviata
               male e nessuno la ritrova. *@
            <div class="struct-bar">
                <input class="htree-search" placeholder="@L["Att_SearchPh"]" aria-label="@L["Att_Search"]"
                       @bind="_cerca" @bind:event="oninput" />
                <span class="sb-chips">
                    @foreach (var k in Enum.GetValues<AttachmentKind>())
                    {
                        <button type="button" class="sh-chip @(_tipo == k ? "on" : "")"
                                @onclick="() => _tipo = _tipo == k ? null : k">
                            @L["AttKind_" + k] <span class="chip-n">@_righe.Count(r => r.Kind == k)</span>
                        </button>
                    }
                </span>
                <span class="sb-chips">
                    @foreach (var s in Enum.GetValues<AttachmentScope>())
                    {
                        <button type="button" class="sh-chip @(_ambito == s ? "on" : "")"
                                @onclick="() => _ambito = _ambito == s ? null : s">
                            @L["AttScope_" + s] <span class="chip-n">@_righe.Count(r => r.Scope == s)</span>
                        </button>
                    }
                </span>
                <span class="sb-chips">
                    @* ⚠️ Resta a schermo anche a zero: un chip che compare col contatore sposta quel che gli
                       sta accanto, e chi stava per cliccare clicca un'altra cosa. *@
                    <button type="button" class="sh-chip @(_soloMaiUsate ? "on" : "")" disabled="@(MaiUsate == 0)"
                            title="@L["Att_UnusedTitle"]" @onclick="() => _soloMaiUsate = !_soloMaiUsate">
                        @L["Att_Unused"] <span class="chip-n">@MaiUsate</span>
                    </button>
                </span>
            </div>

            <table class="res-table">
                <thead>
                    <tr>
                        <th>@L["Att_ColTitle"]</th>
                        <th>@L["Att_ColSlug"]</th>
                        <th>@L["Att_ColKind"]</th>
                        <th>@L["Att_ColScope"]</th>
                        <th>@L["Att_ColVersion"]</th>
                        <th>@L["Att_ColUpdated"]</th>
                        <th>@L["Att_ColUsed"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Filtrate)
                    {
                        <tr>
                            <td><b>@r.Title</b></td>
                            @* Lo slug si mostra come si scrive dentro un documento: è quello che si copia. *@
                            <td><code>@AttachmentRules.TokenDi(r.Slug)</code></td>
                            <td class="muted">@L["AttKind_" + r.Kind]</td>
                            <td class="muted">@(r.Scope == AttachmentScope.Division ? L["AttScope_Division"].Value : r.ScopeLabel)</td>
                            @* ⚠️ Le parentesi ci vogliono: `v@r.VersionNumber` Razor lo prende per un
                               INDIRIZZO EMAIL — la regola vale quando la chiocciola ha un carattere
                               attaccato a sinistra e qualcosa che somiglia a un dominio a destra — e lo
                               stampa alla lettera. Ogni riga della biblioteca diceva «v@@r.VersionNumber». *@
                            <td class="muted">v@(r.VersionNumber)</td>
                            <td class="muted">@VipiTime.Z(r.VersionCreatedUtc)</td>
                            <td>
                                @* Il conteggio è un COMANDO quando c'è qualcosa da vedere: chi sta per
                                   sostituire o cancellare deve sapere QUALI documenti cambiano, e saperlo
                                   senza cambiare pagina. *@
                                @if (Citazioni(r.Slug).Count > 0)
                                {
                                    <button type="button" class="btn ghost"
                                            @onclick="() => _aperta = _aperta == r.Slug ? null : r.Slug">
                                        @L["Att_UsedBy", Citazioni(r.Slug).Count]
                                    </button>
                                }
                                else
                                {
                                    <span class="muted">@L["Att_NeverUsed"]</span>
                                }
                            </td>
                            <td>
                                <a class="btn ghost" target="_blank" rel="noopener"
                                   href="@AttachmentRules.UrlDi(r.Slug)"
                                   title="@L["Att_Open"]">@L["Att_Open"]</a>
                                <button type="button" class="btn ghost" disabled="@_busy"
                                        title="@L["Att_Replace"]" @onclick="() => ApriSostituzione(r)">
                                    @L["Att_Replace"]
                                </button>
                                <button type="button" class="btn ghost" disabled="@_busy"
                                        title="@L["Att_Delete"]" @onclick="() => ApriEliminazione(r)">
                                    <Icon Name="trash" Size="13" />
                                </button>
                            </td>
                        </tr>
                        @if (_elimina == r.Slug)
                        {
                            <tr class="mil-note">
                                <td colspan="8">
                                    <div class="att-replace">
                                        <p class="att-replace-h"><b>@L["Att_DeleteTitle", r.Title]</b></p>

                                        @* ⚠️ Prima si dice che cosa RESTA rotto, poi si chiede conferma. Un
                                           «sei sicuro?» senza questo elenco è una domanda a cui non si può
                                           rispondere. *@
                                        @if (Citazioni(r.Slug).Count > 0)
                                        {
                                            <div class="callout warning">
                                                <span class="cic"><Icon Name="warning" Size="18" /></span>
                                                <div>@L["Att_DeleteImpact", Citazioni(r.Slug).Count]</div>
                                            </div>
                                            <ul class="att-cited">
                                                @foreach (var c in Citazioni(r.Slug))
                                                {
                                                    <li>
                                                        <span class="pill neutral">@L["AttSrc_" + c.Source]</span>
                                                        @if (c.Url is { Length: > 0 } durl)
                                                        {
                                                            <a href="@durl">@c.Title</a>
                                                        }
                                                        else
                                                        {
                                                            <b>@c.Title</b>
                                                        }
                                                        <span class="muted">@Stato(c)</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="muted">@L["Att_DeleteNoImpact"]</p>
                                        }

                                        <p class="help">@L["Att_DeleteKeepsFile"]</p>

                                        <div class="att-replace-actions">
                                            <button type="button" class="btn danger" disabled="@_busy"
                                                    @onclick="() => Elimina(r)">@L["Att_DeleteConfirm"]</button>
                                            <button type="button" class="btn ghost" disabled="@_busy"
                                                    @onclick="() => _elimina = null">@L["Common_Cancel"]</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_sostituisce == r.Slug)
                        {
                            <tr class="mil-note">
                                <td colspan="8">
                                    <div class="att-replace">
                                        <p class="att-replace-h">
                                            <b>@L["Att_ReplaceTitle", r.Title, r.VersionNumber, r.VersionNumber + 1]</b>
                                        </p>

                                        @* ⚠️ L'elenco viene PRIMA dei campi, e non è impaginazione: chi apre
                                           questo pannello deve leggere che cosa cambia mentre decide, non
                                           dopo aver già incollato il link. *@
                                        @if (Citazioni(r.Slug).Count > 0)
                                        {
                                            <p class="muted">@L["Att_ReplaceImpact", Citazioni(r.Slug).Count]</p>
                                            <ul class="att-cited">
                                                @foreach (var c in Citazioni(r.Slug))
                                                {
                                                    <li>
                                                        <span class="pill neutral">@L["AttSrc_" + c.Source]</span>
                                                        @if (c.Url is { Length: > 0 } curl)
                                                        {
                                                            <a href="@curl">@c.Title</a>
                                                        }
                                                        else
                                                        {
                                                            <b>@c.Title</b>
                                                        }
                                                        <span class="muted">@Stato(c)</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <p class="muted">@L["Att_ReplaceNoImpact"]</p>
                                        }

                                        <div class="att-replace-fields">
                                            <label class="att-field">
                                                <span class="muted">@L["Att_Link"]</span>
                                                <input class="app-in" @bind="_nuovoLink" placeholder="@L["Att_LinkPh"]" />
                                            </label>
                                            <label class="att-field">
                                                <span class="muted">@L["Att_ReplaceNote"]</span>
                                                <input class="app-in" @bind="_nuovaNota" placeholder="@L["Att_ReplaceNotePh"]" />
                                            </label>
                                        </div>

                                        <div class="att-replace-actions">
                                            <button type="button" class="btn primary" disabled="@_busy"
                                                    @onclick="() => Sostituisci(r)">@L["Att_Replace"]</button>
                                            <button type="button" class="btn ghost" disabled="@_busy"
                                                    @onclick="ChiudiSostituzione">@L["Common_Cancel"]</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (_aperta == r.Slug)
                        {
                            <tr class="mil-note">
                                <td colspan="8">
                                    <ul class="att-cited">
                                        @foreach (var c in Citazioni(r.Slug))
                                        {
                                            <li>
                                                <span class="pill neutral">@L["AttSrc_" + c.Source]</span>
                                                @if (c.Url is { Length: > 0 } url)
                                                {
                                                    <a href="@url">@c.Title</a>
                                                }
                                                else
                                                {
                                                    <b>@c.Title</b>
                                                }
                                                <span class="muted">@Stato(c)</span>
                                            </li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                    @if (Filtrate.Count == 0)
                    {
                        <tr><td colspan="8" class="muted">@L["Att_Empty"]</td></tr>
                    }
                </tbody>
            </table>

            @* La voce nuova. Lo slug si propone dal titolo ma resta modificabile: è DEFINITIVO, e una volta
               citato in un documento non si cambia più — cambiarlo spegnerebbe ogni citazione già scritta. *@
            <div class="mil-add">
                <label>
                    @L["Att_ColTitle"]
                    <input value="@_nTitolo" placeholder="@L["Att_TitlePh"]"
                           @oninput="e => TitoloCambiato(e.Value?.ToString())" />
                </label>
                <label>
                    @L["Att_ColSlug"]
                    <input value="@_nSlug" placeholder="loa-lirr-lfmm"
                           @oninput="e => SlugCambiato(e.Value?.ToString())" />
                </label>
                <label>
                    @L["Att_ColKind"]
                    <select @bind="_nTipo">
                        @foreach (var k in Enum.GetValues<AttachmentKind>()) { <option value="@k">@L["AttKind_" + k]</option> }
                    </select>
                </label>
                <label>
                    @L["Att_ColScope"]
                    <select @bind="_nAmbito">
                        @foreach (var s in Enum.GetValues<AttachmentScope>()) { <option value="@s">@L["AttScope_" + s]</option> }
                    </select>
                </label>
                @if (_nAmbito != AttachmentScope.Division)
                {
                    <label>
                        @L["Att_ScopeKey"]
                        <input class="w-code" @bind="_nChiave" placeholder="LIRR" />
                    </label>
                }
                <label>
                    @L["Att_Link"]
                    <input @bind="_nLink" placeholder="@L["Att_LinkPh"]" />
                </label>
                <button type="button" class="btn primary" disabled="@_busy" @onclick="Aggiungi">+ @L["Att_Add"]</button>
            </div>
            <p class="help mil-hint">@L["Att_AddHint"]</p>
        </div>
    }
</div>

@code {
    private IReadOnlyList<AttachmentRow> _righe = Array.Empty<AttachmentRow>();
    private IReadOnlyDictionary<string, AttachmentUsage> _uso =
        new Dictionary<string, AttachmentUsage>(StringComparer.Ordinal);

    private string _cerca = "";
    private AttachmentKind? _tipo;
    private AttachmentScope? _ambito;
    private bool _soloMaiUsate;
    private string? _aperta;
    private string? _sostituisce;
    private string? _elimina;
    private string _nuovoLink = "";
    private string _nuovaNota = "";

    private string _nTitolo = "";
    private string _nSlug = "";
    private bool _slugToccato;
    private AttachmentKind _nTipo = AttachmentKind.Loa;
    private AttachmentScope _nAmbito = AttachmentScope.Division;
    private string _nChiave = "";
    private string _nLink = "";

    private string? _messaggio;
    private bool _ok;
    private bool _busy;

    /// <summary>La pagina è degli Editor: chi ha meno vede il rifiuto, non una tabella che non risponde.</summary>
    private bool PuoScrivere => Authz.Role >= VipiRole.Editor;

    /// <summary>Le righe da mostrare: i due assi in AND, più una ricerca che guarda tutto quel che si legge —
    /// così «Marseille» trova la LoA tanto quanto «loa-lirr».</summary>
    private IReadOnlyList<AttachmentRow> Filtrate
    {
        get
        {
            var q = _righe.AsEnumerable();
            if (_tipo is { } k) q = q.Where(r => r.Kind == k);
            if (_ambito is { } s) q = q.Where(r => r.Scope == s);
            if (_soloMaiUsate) q = q.Where(r => Citazioni(r.Slug).Count == 0);

            var testo = _cerca.Trim();
            if (testo.Length > 0)
                q = q.Where(r => new[] { r.Title, r.Slug, r.ScopeKey, r.Notes }
                    .Any(c => c is not null && c.Contains(testo, StringComparison.OrdinalIgnoreCase)));
            return q.ToList();
        }
    }

    // ⚠️ OnParametersSetAsync e non OnInitializedAsync: su InteractiveServer il secondo gira una volta sola.
    protected override async Task OnParametersSetAsync() => await CaricaAsync();

    /// <summary>Chi cita questa voce. Vuoto = nessuno, ed è il filtro «mai usata».</summary>
    private IReadOnlyList<AttachmentCitation> Citazioni(string slug) =>
        _uso.TryGetValue(slug, out var u) ? u.Citations : Array.Empty<AttachmentCitation>();

    /// <summary>Le voci che non cita nessuno: è il numero del chip, ed è il senso della pulizia.</summary>
    private int MaiUsate => _righe.Count(r => Citazioni(r.Slug).Count == 0);

    /// <summary>
    /// Lo stato di una citazione, composto QUI e non nel servizio: la frase dipende dalla lingua, e il
    /// servizio non sa in che lingua sta parlando chi guarda.
    /// </summary>
    private string Stato(AttachmentCitation c) =>
        c.EffectiveCycle is { Length: > 0 } ciclo ? L["Att_CitedAirac", ciclo].Value
        : c.IsPublished ? L["Att_CitedPublished"].Value
        : L["Att_CitedDraft"].Value;

    private async Task CaricaAsync()
    {
        _righe = await Biblioteca.ListAsync();
        // ⚠️ Una passata sola sulle quattro sorgenti, non una per riga: con una lettura per voce la pagina
        // farebbe una scansione di tutti i blocchi e di tutte le release per OGNI allegato in elenco.
        _uso = await Uso.AllAsync();
    }

    /// <summary>Lo slug battuto a mano: da qui in poi il titolo non lo tocca più.</summary>
    private void SlugCambiato(string? valore)
    {
        _slugToccato = true;
        _nSlug = valore ?? "";
    }

    /// <summary>Il titolo propone lo slug finché nessuno l'ha scritto a mano: dopo, comanda la persona.</summary>
    private void TitoloCambiato(string? valore)
    {
        _nTitolo = valore ?? "";
        if (!_slugToccato) _nSlug = AttachmentRules.SlugDa(_nTitolo);
    }

    /// <summary>Apre la conferma informata. ⚠️ I campi si svuotano a ogni apertura: un link rimasto da una
    /// sostituzione annullata verrebbe confermato su un'altra voce senza che nessuno lo rilegga.</summary>
    private void ApriSostituzione(AttachmentRow r)
    {
        _messaggio = null;
        _aperta = null;
        _elimina = null;
        _sostituisce = r.Slug;
        _nuovoLink = "";
        _nuovaNota = "";
    }

    /// <summary>Apre la guardia. ⚠️ Chiude l'altro pannello: due conferme aperte insieme sulla stessa riga
    /// sono due domande diverse che sembrano una sola.</summary>
    private void ApriEliminazione(AttachmentRow r)
    {
        _messaggio = null;
        _aperta = null;
        _sostituisce = null;
        _elimina = r.Slug;
    }

    private async Task Elimina(AttachmentRow r)
    {
        if (!PuoScrivere) return;
        _busy = true; _messaggio = null;
        try
        {
            var esito = await Cura.DeleteAsync(r.Slug, Authz.CurrentUserId ?? 0);

            _ok = esito.Esito == AttachmentDelete.Ok;
            _messaggio = esito.Esito == AttachmentDelete.Ok
                ? L["Att_Deleted", r.Title, esito.Orfani.Count(c => c.DocumentId is not null)].Value
                : L["Att_ReplaceGone"].Value;

            _elimina = null;
            await CaricaAsync();
        }
        catch (Exception ex) { _ok = false; _messaggio = ex.Message; }
        finally { _busy = false; }
    }

    private void ChiudiSostituzione()
    {
        _sostituisce = null;
        _nuovoLink = "";
        _nuovaNota = "";
    }

    private async Task Sostituisci(AttachmentRow r)
    {
        if (!PuoScrivere) return;
        _busy = true; _messaggio = null;
        try
        {
            var esito = await Cura.ReplaceAsync(r.Slug, _nuovoLink, _nuovaNota, Authz.CurrentUserId ?? 0);

            _ok = esito.Esito == AttachmentReplace.Ok;
            _messaggio = esito.Esito switch
            {
                // Il conteggio dei documenti segnalati è la METÀ utile del messaggio: dice che di quel
                // cambiamento è rimasta una traccia su cui qualcuno tornerà.
                AttachmentReplace.Ok => L["Att_Replaced", r.Title, esito.Riga!.VersionNumber,
                    esito.Impattati.Count(c => c.DocumentId is not null)].Value,
                AttachmentReplace.LinkNonValido => L["Att_ErrLink"].Value,
                AttachmentReplace.Invariato => L["Att_ReplaceSame"].Value,
                _ => L["Att_ReplaceGone"].Value,
            };

            if (esito.Esito == AttachmentReplace.Ok)
            {
                ChiudiSostituzione();
                await CaricaAsync();
            }
        }
        catch (Exception ex) { _ok = false; _messaggio = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Aggiungi()
    {
        if (!PuoScrivere) return;
        _busy = true; _messaggio = null;
        try
        {
            var draft = new AttachmentDraft(_nSlug, _nTitolo, _nTipo, _nAmbito, _nChiave, null, _nLink);
            var (esito, riga) = await Biblioteca.CreateAsync(draft, Authz.CurrentUserId ?? 0);

            _ok = esito == AttachmentCreate.Ok;
            // ⚠️ I rifiuti restano distinti: chi ha incollato un link sbagliato e chi ha scelto uno slug già
            // preso devono correggere due cose diverse, e un «non valido» solo li manda a indovinare.
            _messaggio = esito switch
            {
                AttachmentCreate.Ok => string.Format(L["Att_Added"].Value, riga!.Title, riga.Slug),
                AttachmentCreate.SlugNonValido => L["Att_ErrSlug"].Value,
                AttachmentCreate.SlugOccupato => string.Format(L["Att_ErrSlugTaken"].Value, _nSlug.Trim()),
                AttachmentCreate.TitoloMancante => L["Att_ErrTitle"].Value,
                AttachmentCreate.LinkNonValido => L["Att_ErrLink"].Value,
                _ => L["Att_ErrScope"].Value,
            };

            if (esito == AttachmentCreate.Ok)
            {
                _nTitolo = ""; _nSlug = ""; _nChiave = ""; _nLink = ""; _slugToccato = false;
                await CaricaAsync();
            }
        }
        catch (Exception ex) { _ok = false; _messaggio = ex.Message; }
        finally { _busy = false; }
    }
}
