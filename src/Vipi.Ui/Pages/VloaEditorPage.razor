@page "/services/vsop/{Acc}/vloa/editor"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject IStringLocalizer<SharedResource> L
@inject EnglishStrings En

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Vle_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_foreign.Length > 0)
{
    <PageTitle>@L["Vle_EditorTitle"] @Acc.ToUpperInvariant() ↔ @_foreign · vIPI</PageTitle>
    <div class="wrap struct">
        <div class="breadcrumb">
            <a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> ›
            <a href="/services/vsop/@Acc.ToLowerInvariant()/vloa">vLOA</a> › <b>@_foreign · @En["Common_Editor"]</b>
        </div>
        <VloaEditor Home="@Acc.ToUpperInvariant()" Foreign="@_foreign" />
    </div>
}
else
{
    <PageTitle>@L["Vle_EditorTitle"] @_acc.Code · vIPI</PageTitle>
    <div class="wrap">
        <div class="breadcrumb"><a href="/services/vsop">@En["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Name</a> › <b>@En["Vle_EditorVloa"]</b></div>
        <div class="doc-head">
            <div><h1 class="page-h1" style="margin-bottom:2px">@L["Vle_EditorVloa"] — @_acc.Name</h1><p class="muted" style="margin:0">@(string.Format(L["Vle_ChooseLoa"].Value, _acc.Code))</p></div>
        </div>
        @if (_vloas.Count == 0)
        {
            <EmptyState Title="@L["Vle_NoVloa"]">@((MarkupString)L["Vle_NoVloaBody"].Value)</EmptyState>
        }
        else
        {
            <div class="choice-grid" style="margin-top:14px">
                @foreach (var v in _vloas)
                {
                    <a class="choice" href="/services/vsop/@Acc.ToLowerInvariant()/vloa/editor?acc=@v.NeighbourCode">
                        <h2 class="h-card"><span class="ic">🤝</span> @v.Title</h2>
                        <p class="muted">@(v.Neighbour ?? v.NeighbourCode ?? L["Vle_BilateralLoa"].Value)</p>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "acc")] public string? Neighbour { get; set; }

    private AccInfo? _acc;
    private string _foreign = "";
    private IReadOnlyList<VloaRow> _vloas = Array.Empty<VloaRow>();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        _foreign = (Neighbour ?? "").Trim().ToUpperInvariant();
        if (_foreign.Length > 0) return;

        // Nessun ?acc= → chooser: elenca le vLOA della ACC.
        var data = await Structure.LoadAsync(_acc.Code);
        _vloas = data?.Vloas.Where(v => v.NeighbourCode is { Length: > 0 })
            .OrderBy(v => v.FeaturedRank ?? int.MaxValue).ThenBy(v => v.Title).ToList()
            ?? (IReadOnlyList<VloaRow>)Array.Empty<VloaRow>();
    }
}
