@page "/services/vsop/admin/airspace"
@layout SopLayout
@rendermode InteractiveServer
@using Vipi.Application.Abstractions
@using Vipi.Application.Airspace
@using Vipi.Domain
@inject IEditAuthorizationService Authz
@inject IAirspaceCatalog Catalogo
@inject ISectorAirspaceBindings Agganci
@inject Vipi.Application.Content.ISectorShapeRepository Settori
@inject Vipi.Application.Abstractions.INavaidCatalog Radioassistenze
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Content.INeighbourImportService Confinanti
@inject Microsoft.Extensions.Logging.ILogger<AdminAirspacePage> Logger

@* Gli spazi aerei dell'AIP: il caricamento del file e il catalogo che ne esce (carta del 29 agosto 2026).

   ⚠️ Il file non arriva da una sorgente che si interroga: lo porta una persona. Non c'è nessun giro notturno
   da premere, c'è un file da scegliere — e per questo il comando in testata è un `<InputFile>` e non un
   bottone «importa».

   ⚠️ Il ciclo AIRAC lo DICHIARA chi carica, perché il file non lo porta: dice solo la data in cui è stato
   generato, che infatti la pagina mostra da sola. Non è un cancello — il file dell'AIP descrive quel che è
   già pubblicato — è la risposta a «di quando è questo confine».

   ⚠️ Le famiglie non utilizzabili si vedono lo stesso, con scritto perché. Nasconderle darebbe un catalogo
   che dice 362 dove il file ne ha 1 536, e la prima domanda di chiunque sarebbe «e le altre?». *@

<PageTitle>@L["Asp_AdminTitle"] · IVAO Italy</PageTitle>

<div class="wrap struct">
    <AdminNav />

    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Asp_AdminTitle"]&nbsp;<span class="pill blue">@_volumi.Count</span>
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-spazi-aerei" AriaLabel="@L["Asp_AdminTitle"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@L["Asp_AdminSubtitle"]</p>
            @((MarkupString)L["Asp_AdminIntro"].Value)
        </HelpHint>
        @if (PuoScrivere)
        {
            <nav class="struct-nav asp-upload">
                @* ⚠️ `@bind:event="oninput"`, non il `change` di default: il `change` scatta al FUOCO PERSO,
                   e qui il gesto successivo è scegliere un file — che apre una finestra di sistema. La
                   verifica dal vivo del 29 agosto ha caricato il file col ciclo digitato e l'ha salvato
                   NULLO. Lo stesso motivo per cui il campo di ricerca, due righe più sotto, lo fa già. *@
                <input class="asp-cycle" maxlength="8" placeholder="@L["Asp_CyclePh"]"
                       aria-label="@L["Asp_Cycle"]" title="@L["Asp_CycleTitle"]"
                       @bind="_ciclo" @bind:event="oninput" />
                <label class="btn ghost btn-file">
                    <Icon Name="file" Size="14" /> @L["Asp_Upload"]
                    <InputFile OnChange="CaricaAsync" accept=".kmz,.kml" disabled="@_busy"
                               aria-label="@L["Asp_Upload"]" />
                </label>
            </nav>
            <LiveRegion>
                @if (_busy)
                {
                    <span class="st-msg prog"><span class="spin"></span><span class="st-msg-t">@_attesa</span></span>
                }
                else if (_messaggio is not null)
                {
                    <span class="st-msg @(_ok ? "ok" : "warn")">
                        <Icon Name="@(_ok ? "check-circle" : "warning")" Size="14" />
                        <span class="st-msg-t">@_messaggio</span>
                        <button class="tclose" title="@L["Common_Close"]" @onclick="() => _messaggio = null">✕</button>
                    </span>
                }
            </LiveRegion>
        }
    </div>

    @if (!PuoScrivere)
    {
        <div class="callout danger"><span class="cic">🔒</span><div>@L["Vle_Unauthorized"]</div></div>
    }
    else if (_corrente is null)
    {
        <div class="callout"><span class="cic">🗺️</span><div>@L["Asp_NoImport"]</div></div>
    }
    else
    {
        @* ⚠️ Comprimibile come ogni altra card del sito (CollapsibleBlock = <details> nativo): la pagina ha
           cinque blocchi e quello dei volumi ne vale cinquecento righe: chi viene qui per agganciare un
           settore o per leggere il rapporto se lo scorreva tutto. `data-persist` (l'Id) ricorda aperto e
           chiuso fra una visita e l'altra. *@
        @* Le correzioni a mano sotto cui il file è cambiato (carta 2026-09-30-correzioni-spazi-aerei). Sta IN CIMA e
           c'è solo quando serve: è la domanda che un caricamento nuovo fa a chi l'ha portato. *@
        @if (_revisione.Count > 0)
        {
            <CollapsibleBlock Id="asp-revisione">
                <Header>
                    <h2 class="h-sect">@L["Asp_Fix_Review"]&nbsp;<span class="pill amber">@_revisione.Count</span></h2>
                </Header>
                <ChildContent>
                <p class="muted asp-scope">@L["Asp_Fix_ReviewScope"]</p>
                <table class="res-table mil-table asp-review">
                    <thead>
                        <tr>
                            <th class="c-name">@L["Asp_Name"]</th>
                            <th class="c-what">@L["Asp_Fix_ColWhat"]</th>
                            <th class="c-diff">@L["Asp_Fix_ColFields"]</th>
                            <th class="c-act2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _revisione)
                        {
                            <tr>
                                <td class="c-name">
                                    <b>@f.Correction.Name</b>
                                    @if (f.KeyChanged)
                                    {
                                        <div class="asp-missing"><Icon Name="warning" Size="12" /> @L["Asp_Fix_KeyChanged"]</div>
                                    }
                                </td>
                                <td class="c-what">@L[$"Asp_Fix_Kind_{f.Kind}"]</td>
                                <td class="c-diff">
                                    @foreach (var d in f.Diffs)
                                    {
                                        <div>
                                            <b>@L[$"Asp_Fix_Field_{d.Field}"]</b>:
                                            @L["Asp_Fix_Diff", Valore(d.Field, d.FileBefore), Valore(d.Field, d.FileNow), Valore(d.Field, d.Corrected)]
                                        </div>
                                    }
                                </td>
                                <td class="c-act2">
                                    <button type="button" class="btn" disabled="@_busy"
                                            title="@L[$"Asp_Fix_OkTitle_{f.Kind}"]" @onclick="() => VaBene(f)">
                                        @L["Asp_Fix_Ok"]
                                    </button>
                                    @if (f.Kind == AirspaceCorrectionFindingKind.FileChanged)
                                    {
                                        <button type="button" class="btn ghost" disabled="@_busy"
                                                title="@L["Asp_Fix_TakeFileTitle"]" @onclick="() => PrendiIlFile(f)">
                                            @L["Asp_Fix_TakeFile"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </ChildContent>
            </CollapsibleBlock>
        }

        <CollapsibleBlock Id="asp-volumi">
            <Header>
                <h2 class="h-sect">
                    @* ⚠️ La pastiglia c'è SOLO filtrando, e dice quante se ne stanno guardando su quante ce
                       n'è: a filtri spenti ripeteva parola per parola quella del titolo di pagina. *@
                    @L["Asp_Volumes"]@if (Filtrando) { <text>&nbsp;</text><span class="pill blue">@Filtrati.Count / @_volumi.Count</span> }
                </h2>
            </Header>
            <ChildContent>
            <div class="struct-bar asp-bar">
                <input class="htree-search" placeholder="@L["Asp_SearchPh"]" aria-label="@L["Asp_Search"]"
                       @bind="_cerca" @bind:event="oninput" />
                <span class="sb-chips">
                    @foreach (var f in _perFamiglia.OrderByDescending(k => AirspaceFamilies.IsUsable(k.Key)).ThenBy(k => (int)k.Key))
                    {
                        var famiglia = f.Key;
                        var usabile = AirspaceFamilies.IsUsable(famiglia);
                        <button type="button" class="sh-chip @(_famiglie.Contains(famiglia) ? "on" : "") @(usabile ? "" : "off")"
                                title="@(usabile ? L["Asp_FamilyUsable"] : L["Asp_FamilyNotUsable"])"
                                @onclick="() => Alterna(famiglia)">
                            @Nome(famiglia) <span class="chip-n">@f.Value</span>
                        </button>
                    }
                    @if (_correzioni.Count > 0)
                    {
                        <button type="button" class="sh-chip @(_soloCorretti ? "on" : "")"
                                @onclick="() => _soloCorretti = !_soloCorretti">
                            @L["Asp_Fix_OnlyCorrected"] <span class="chip-n">@_correzioni.Count</span>
                        </button>
                    }
                    @* Con un filtro acceso serve la strada per tornare indietro: è lo stesso tasto della barra
                       di Struttura, delle SID e dell'anagrafica radioassistenze. Qui mancava, e con dodici
                       chip di famiglia più il testo si finiva per ricaricare la pagina. *@
                    @if (Filtrando)
                    {
                        <button type="button" class="lnk-mini" @onclick="PulisciFiltri">@L["Gt_ClearSearch"]</button>
                    }
                </span>
                <span class="muted asp-count">@L["Asp_UsableOf", _corrente.VolumesUsable, _corrente.VolumesRead]</span>
            </div>

            @* `sticky-head`: fino a cinquecento righe, e la colonna che si guarda è quasi sempre l'ultima
               («utilizzabile»). Senza, scorrendo si perde di vista quale colonna si sta leggendo. *@
            <table class="res-table mil-table asp-table sticky-head">
                <thead>
                    <tr>
                        <th class="c-pick"></th>
                        <th class="c-fam">@L["Asp_Family"]</th>
                        <th class="c-name">@L["Asp_Name"]</th>
                        <th class="c-band">@L["Asp_Band"]</th>
                        <th class="c-class">@L["Asp_Class"]</th>
                        <th class="c-pts">@L["Asp_Points"]</th>
                        <th class="c-use">@L["Asp_Usable"]</th>
                        <th class="c-fix"><span class="sr-only">@L["Asp_Fix_Col"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Filtrati)
                    {
                        var chiave = Chiave(v);
                        <tr class="@(_scelti.Contains(Chiave(v)) ? "asp-picked" : null)">
                            <td class="c-pick">
                                @* La spunta c'e' solo dove puo' servire: un'area regolamentata non si aggancia. *@
                                @if (v.IsUsable)
                                {
                                    <input type="checkbox" aria-label="@v.Name"
                                           checked="@_scelti.Contains(Chiave(v))"
                                           @onchange="e => Spunta(v, (bool?)e.Value == true)" />
                                }
                            </td>
                            <td class="c-fam muted">@Nome(v.Family)</td>
                            <td class="c-name">
                                <b>@v.Name</b>
                                @if (v.IsCorrected)
                                {
                                    @* Il volume si legge corretto ovunque; qui si dice anche che cosa diceva il file. *@
                                    <span class="pill amber asp-fixed" title="@DalFile(v)">@L["Asp_Fix_Corrected"]</span>
                                }
                            </td>
                            <td class="c-band c-nowrap">@v.BandLabel</td>
                            <td class="c-class muted">@(v.AirspaceClass ?? "—")</td>
                            <td class="c-pts">@v.PointCount</td>
                            <td class="c-use">
                                @if (v.IsUsable)
                                {
                                    <span class="pill green">@L["Asp_Yes"]</span>
                                }
                                else
                                {
                                    <span class="muted" title="@L["Asp_FamilyNotUsable"]">@L["Asp_No"]</span>
                                }
                            </td>
                            <td class="c-fix">
                                <button type="button" class="btn ghost btn-icon" disabled="@_busy"
                                        title="@L["Asp_Fix_Edit"]" aria-label="@L["Asp_Fix_Edit"]"
                                        aria-expanded="@(_inModifica == chiave ? "true" : "false")"
                                        @onclick="() => ApriModifica(v)">
                                    <Icon Name="pencil" Size="13" />
                                </button>
                            </td>
                        </tr>
                        @if (_inModifica == chiave)
                        {
                            @* La correzione si scrive sotto la sua riga: il nome resta sopra, e non si tocca. *@
                            <tr class="asp-edit">
                                <td colspan="8">
                                    <div class="asp-edit-row">
                                        <label>
                                            <span>@L["Asp_Family"]</span>
                                            <select class="htree-select" @bind="_fFamiglia">
                                                @foreach (var f in Enum.GetValues<AirspaceFamily>())
                                                {
                                                    <option value="@f">@Nome(f)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>
                                            <span>@L["Asp_Class"]</span>
                                            <input class="asp-in asp-in-class" maxlength="1" placeholder="@L["Asp_Fix_ClassPh"]"
                                                   @bind="_fClasse" @bind:event="oninput" />
                                        </label>
                                        <label>
                                            <span>@L["Asp_Fix_Field_Base"]</span>
                                            <input class="asp-in" maxlength="32" placeholder="@L["Asp_Fix_BasePh"]"
                                                   @bind="_fBase" @bind:event="oninput" />
                                        </label>
                                        <label>
                                            <span>@L["Asp_Fix_Field_Top"]</span>
                                            <input class="asp-in" maxlength="32" placeholder="@L["Asp_Fix_TopPh"]"
                                                   @bind="_fTetto" @bind:event="oninput" />
                                        </label>
                                        <span class="asp-edit-act">
                                            <button type="button" class="btn" disabled="@_busy" @onclick="() => SalvaModifica(v)">
                                                @L["Common_Save"]
                                            </button>
                                            <button type="button" class="btn ghost" @onclick="() => _inModifica = null">
                                                @L["Common_Cancel"]
                                            </button>
                                            @if (CorrezioneDi(v) is { } c)
                                            {
                                                <InlineConfirm TriggerClass="btn ghost" Disabled="@_busy"
                                                               Prompt="@string.Format(L["Asp_Fix_RevertPrompt"].Value, v.Name)"
                                                               TriggerTitle="@L["Asp_Fix_Revert"]" AriaLabel="@L["Asp_Fix_Revert"]"
                                                               ConfirmLabel="@L["Asp_Fix_RevertConfirm"]" Danger="false"
                                                               OnConfirm="() => TornaAlFile(c)">
                                                    <Trigger>@L["Asp_Fix_Revert"]</Trigger>
                                                </InlineConfirm>
                                            }
                                        </span>
                                    </div>
                                    <p class="muted asp-edit-hint">
                                        @if (v.IsCorrected)
                                        {
                                            @DalFile(v)<br />
                                        }
                                        @L["Asp_Fix_Hint"]
                                    </p>
                                </td>
                            </tr>
                        }
                    }
                    @if (Filtrati.Count == 0)
                    {
                        <tr><td colspan="8" class="muted">@L["Asp_Empty"]</td></tr>
                    }
                </tbody>
            </table>
            @if (_volumi.Count >= Tetto)
            {
                <p class="muted asp-more">@L["Asp_Truncated", Tetto]</p>
            }

            @* La barra dell'aggancio compare solo quando c'e' qualcosa di scelto: una barra sempre a schermo
               con una tendina vuota sarebbe un comando che non fa niente per il 99% del tempo. *@
            @if (_scelti.Count > 0)
            {
                <div class="struct-bar asp-bind">
                    <span class="muted">@L["Asp_Picked", _scelti.Count]</span>
                    @* `htree-select` e non un <select> nudo: è la tendina di casa (bordo, freccia, fondo che
                       segue il tema). Nuda, era l'unico controllo della pagina disegnato dal browser. *@
                    <select class="htree-select" @bind="_settore" aria-label="@L["Asp_BindSector"]">
                        <option value="">@L["Asp_BindPick"]</option>
                        @foreach (var st in _settori)
                        {
                            <option value="@st.Catalog|@st.Id|@st.Callsign">@st.Callsign</option>
                        }
                    </select>
                    <button type="button" class="btn" disabled="@(_busy || _settore.Length == 0)"
                            title="@L["Asp_BindTitle"]" @onclick="Aggancia">@L["Asp_Bind"]</button>
                    <button type="button" class="btn ghost" @onclick="() => _scelti.Clear()">@L["Asp_ClearPick"]</button>
                </div>
            }
            </ChildContent>
        </CollapsibleBlock>

        <CollapsibleBlock Id="asp-agganci">
            <Header>
                <h2 class="h-sect">@L["Asp_Bindings"]&nbsp;<span class="pill">@_agganci.Count</span></h2>
            </Header>
            <ChildContent>
            @* La riga che dice il perimetro, e non e' pignoleria: chi aggancia deve sapere che cambia la
               MAPPA pubblicata, non chi confina con chi ne' quali voli contano per quella postazione. *@
            <p class="muted asp-scope">@L["Asp_BindScope"]</p>
            @if (_agganci.Count == 0)
            {
                <p class="muted">@L["Asp_NoBindings"]</p>
            }
            else
            {
                <table class="res-table mil-table asp-bindings">
                    <thead>
                        <tr>
                            <th class="c-sec">@L["Asp_Sector"]</th>
                            <th class="c-vols">@L["Asp_BoundVolumes"]</th>
                            <th class="c-who">@L["Asp_ChosenBy"]</th>
                            <th class="c-act2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _agganci)
                        {
                            <tr>
                                <td class="c-sec"><b>@a.Callsign</b></td>
                                <td class="c-vols">
                                    @string.Join(", ", a.Volumes.Select(v => v.Name))
                                    @if (a.Missing.Count > 0)
                                    {
                                        @* Un aggancio scoperto NON si cancella da se': il settore torna alla
                                           forma di IVAO e qui si vede quale volume e' sparito dal file. *@
                                        <div class="asp-missing">
                                            <Icon Name="warning" Size="12" />
                                            @L["Asp_Missing", a.Missing.Count]:
                                            @string.Join("; ", a.Missing.Select(m => m.Key))
                                        </div>
                                    }
                                </td>
                                <td class="c-who muted">
                                    @(a.ChosenByName ?? "—")
                                    @if (a.ChosenUtc is { } q)
                                    {
                                        <text> · </text><span data-utc="@VipiTime.Iso(q)" data-utc-fmt="dhm">@VipiTime.DayZ(q)</span>
                                    }
                                </td>
                                <td class="c-act2">
                                    <InlineConfirm TriggerClass="btn ghost" Disabled="@_busy"
                                                   Prompt="@string.Format(L["Asp_UnbindPrompt"].Value, a.Callsign)"
                                                   TriggerTitle="@L["Asp_Unbind"]" AriaLabel="@L["Asp_Unbind"]"
                                                   OnConfirm="() => Sgancia(a)">
                                        <Trigger>@L["Asp_Unbind"]</Trigger>
                                    </InlineConfirm>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </ChildContent>
        </CollapsibleBlock>

        <CollapsibleBlock Id="asp-caricamenti">
            <Header>
                <h2 class="h-sect">@L["Asp_Imports"]&nbsp;<span class="pill">@_caricamenti.Count</span></h2>
            </Header>
            <ChildContent>
            <table class="res-table mil-table asp-imports">
                <thead>
                    <tr>
                        <th class="c-file">@L["Asp_File"]</th>
                        <th class="c-cycle">@L["Asp_Cycle"]</th>
                        <th class="c-gen">@L["Asp_Generated"]</th>
                        <th class="c-up">@L["Asp_Uploaded"]</th>
                        <th class="c-vol">@L["Asp_Volumes"]</th>
                        <th class="c-act2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in _caricamenti)
                    {
                        <tr class="@(i.IsCurrent ? "asp-current" : null)">
                            <td class="c-file">
                                <b>@i.FileName</b>
                                @if (i.IsCurrent)
                                {
                                    <span class="pill green">@L["Asp_InForce"]</span>
                                }
                            </td>
                            <td class="c-cycle c-nowrap">@(i.AiracCycle ?? "—")</td>
                            <td class="c-gen c-nowrap muted">@(i.GeneratedUtc is { } g ? VipiTime.DayZ(g) : "—")</td>
                            <td class="c-up muted">
                                <span data-utc="@VipiTime.Iso(i.UploadedUtc)" data-utc-fmt="dhm">@VipiTime.DayZ(i.UploadedUtc)</span>
                                @if (!string.IsNullOrWhiteSpace(i.UploadedByName))
                                {
                                    <text> · @i.UploadedByName</text>
                                }
                            </td>
                            <td class="c-vol c-nowrap">@i.VolumesUsable / @i.VolumesRead</td>
                            <td class="c-act2">
                                @if (!i.IsCurrent)
                                {
                                    <button type="button" class="btn ghost" disabled="@_busy"
                                            title="@L["Asp_SetCurrentTitle"]" @onclick="() => MettiInVigore(i.Id)">
                                        @L["Asp_SetCurrent"]
                                    </button>
                                    <InlineConfirm TriggerClass="btn ghost" Disabled="@_busy"
                                                   Prompt="@string.Format(L["Asp_DeletePrompt"].Value, i.FileName)"
                                                   TriggerTitle="@L["Asp_Delete"]" AriaLabel="@L["Asp_Delete"]"
                                                   OnConfirm="() => Elimina(i.Id)">
                                        <Trigger><Icon Name="trash" Size="13" /></Trigger>
                                    </InlineConfirm>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </ChildContent>
        </CollapsibleBlock>

        @if (_segnalazioni.Count > 0)
        {
            <CollapsibleBlock Id="asp-segnalazioni">
                <Header>
                    <h2 class="h-sect">@L["Asp_Issues"]&nbsp;<span class="pill">@_segnalazioni.Count</span></h2>
                </Header>
                <ChildContent>
                <ul class="asp-issues">
                    @foreach (var s in _segnalazioni.Take(50))
                    {
                        <li><b>@Nome(s.Kind)</b> — @s.Volume @(s.Dettaglio is null ? "" : $"({s.Dettaglio})")</li>
                    }
                </ul>
                </ChildContent>
            </CollapsibleBlock>
        }

        @* ⚠️ Nasce CHIUSO, ed è l'unico: è il blocco più lungo (fino a duecento righe) e non è quello per cui
           si apre questa pagina — chi carica un file o aggancia un settore se lo trovava davanti ogni volta.
           Chi lo apre, poi, se lo ritrova aperto: `data-persist` ricorda la scelta. *@
        <CollapsibleBlock Id="asp-rapporto" InitiallyOpen="false">
            <Header>
                <h2 class="h-sect">
                    @L["Asp_NavReport"]&nbsp;<span class="pill">@_rapporto.Count</span>
                </h2>
            </Header>
            <ChildContent>
            @* ⚠️ La riga che dice a che cosa serve, e che cosa NON fa. Il committente e' stato esplicito: si
               segnala, e la correzione si fa nel SECTORFILE — da cui poi si reimporta. Un tasto «applica» qui
               farebbe nascere le radioassistenze da un secondo posto, che e' la seconda anagrafica che il
               modello ha gia' pagato una volta. *@
            <p class="muted asp-scope">@L["Asp_NavReportScope"]</p>

            @if (!_rapportoFatto)
            {
                <button type="button" class="btn ghost" disabled="@_busy" @onclick="Confronta">
                    <Icon Name="radio" Size="14" /> @L["Asp_NavReportRun"]
                </button>
            }
            else if (_rapporto.Count == 0)
            {
                <p class="muted">@L["Asp_NavReportNone"]</p>
            }
            else
            {
                <table class="res-table mil-table asp-nav">
                    <thead>
                        <tr>
                            <th class="c-what">@L["Asp_NavWhat"]</th>
                            <th class="c-code">@L["Asp_NavCode"]</th>
                            <th class="c-aip">@L["Asp_NavAip"]</th>
                            <th class="c-ours">@L["Asp_NavOurs"]</th>
                            <th class="c-note"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _rapporto.Take(200))
                        {
                            <tr>
                                <td class="c-what">@Nome(d.Kind)</td>
                                <td class="c-code c-nowrap"><b>@d.Code</b> <span class="muted">@d.Family</span></td>
                                <td class="c-aip">@(d.Aip ?? "—")</td>
                                <td class="c-ours">@(d.Nostro ?? "—")</td>
                                <td class="c-note muted">@d.Nota</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </ChildContent>
        </CollapsibleBlock>

        @* ⚠️ L'attribuzione non è cortesia: il file porta un disclaimer esplicito e vieta l'uso commerciale
           del dato. Sta dove il dato si vede — qui, e nelle mappe pubbliche che ne mostrano un confine. *@
        <p class="muted asp-credit">@L["Asp_Attribution"]</p>
    }
</div>

@code {
    /// <summary>Quanti volumi si mostrano: la tabella è per guardare, non per scorrere 1 536 righe.</summary>
    private const int Tetto = 500;

    private AirspaceImportRow? _corrente;
    private IReadOnlyList<AirspaceImportRow> _caricamenti = Array.Empty<AirspaceImportRow>();
    private IReadOnlyList<AirspaceVolumeRow> _volumi = Array.Empty<AirspaceVolumeRow>();
    private IReadOnlyList<AirspaceIssue> _segnalazioni = Array.Empty<AirspaceIssue>();
    private IReadOnlyDictionary<AirspaceFamily, int> _perFamiglia = new Dictionary<AirspaceFamily, int>();
    private readonly HashSet<AirspaceFamily> _famiglie = new();
    private readonly HashSet<string> _scelti = new(StringComparer.Ordinal);
    private IReadOnlyList<SectorAirspaceBindingRow> _agganci = Array.Empty<SectorAirspaceBindingRow>();
    private IReadOnlyList<Vipi.Application.Content.SectorShapeRow> _settori =
        Array.Empty<Vipi.Application.Content.SectorShapeRow>();
    private string _settore = "";
    private IReadOnlyList<NavaidDiff> _rapporto = Array.Empty<NavaidDiff>();
    private bool _rapportoFatto;
    private string _cerca = "";
    private string _ciclo = "";
    private string? _messaggio;
    private bool _ok;
    private bool _busy;

    /// <summary>Che cosa sta facendo il gesto in corso: la riga con la rotella in testata. Prima diceva sempre
    /// «Sto leggendo il file», anche mentre si spostavano agganci e si rifacevano i confinanti (visto a schermo il
    /// 30 settembre 2026: 18 secondi di «leggo il file» dopo un «Va bene»).</summary>
    private string _attesa = "";

    // Le correzioni a mano (carta docs/feature/2026-09-30-correzioni-spazi-aerei.md).
    private IReadOnlyList<AirspaceCorrectionRow> _correzioni = Array.Empty<AirspaceCorrectionRow>();
    private IReadOnlyList<AirspaceCorrectionFinding> _revisione = Array.Empty<AirspaceCorrectionFinding>();
    private bool _soloCorretti;
    private string? _inModifica;
    private AirspaceFamily _fFamiglia;
    private string _fClasse = "";
    private string _fBase = "";
    private string _fTetto = "";

    /// <summary>La pagina è degli Editor, come le altre che toccano dati di tutti.</summary>
    private bool PuoScrivere => Authz.Role >= VipiRole.Editor;

    /// <summary>C'è un filtro acceso? Decide la pastiglia «visti / totali» sulla testata del blocco e la
    /// comparsa del tasto che li spegne.</summary>
    private bool Filtrando => _famiglie.Count > 0 || _cerca.Trim().Length > 0 || _soloCorretti;

    private void PulisciFiltri()
    {
        _famiglie.Clear();
        _cerca = "";
        _soloCorretti = false;
    }

    private IReadOnlyList<AirspaceVolumeRow> Filtrati
    {
        get
        {
            var q = _volumi.AsEnumerable();
            if (_famiglie.Count > 0) q = q.Where(v => _famiglie.Contains(v.Family));
            if (_soloCorretti) q = q.Where(v => v.IsCorrected);
            var testo = _cerca.Trim();
            if (testo.Length > 0)
                q = q.Where(v => v.Name.Contains(testo, StringComparison.OrdinalIgnoreCase)
                              || v.Category.Contains(testo, StringComparison.OrdinalIgnoreCase));
            return q.ToList();
        }
    }

    // ⚠️ OnParametersSetAsync e non OnInitializedAsync: su InteractiveServer il secondo gira una volta sola.
    protected override async Task OnParametersSetAsync() => await RicaricaAsync();

    private async Task RicaricaAsync()
    {
        if (!PuoScrivere) return;

        _caricamenti = await Catalogo.ListImportsAsync();
        _corrente = _caricamenti.FirstOrDefault(i => i.IsCurrent);
        _volumi = _corrente is null
            ? Array.Empty<AirspaceVolumeRow>()
            : await Catalogo.ListVolumesAsync(new AirspaceVolumeQuery(Take: Tetto));
        _perFamiglia = _corrente is null
            ? new Dictionary<AirspaceFamily, int>()
            : await Catalogo.CountByFamilyAsync();
        _segnalazioni = _corrente is null
            ? Array.Empty<AirspaceIssue>()
            : await Catalogo.GetIssuesAsync(_corrente.Id);
        _agganci = await Agganci.ListAsync();
        _correzioni = await Catalogo.ListCorrectionsAsync();
        _revisione = _corrente is null
            ? Array.Empty<AirspaceCorrectionFinding>()
            : await Catalogo.ReviewCorrectionsAsync();

        // I settori che possono avere un'area: CTR e FSS dai subcenter, APP e DEP dalle postazioni.
        // Le TWR restano fuori — hanno il loro ripiego, e agganciarle a mano qui vorrebbe dire due strade
        // che scrivono la stessa cosa con regole diverse.
        _settori = (await Settori.ListShapeCandidatesAsync())
            .OrderBy(x => x.Callsign, StringComparer.OrdinalIgnoreCase).ToList();
    }

    /// <summary>L'identita' di un volume in una stringa: e' quel che l'aggancio cita.</summary>
    private static string Chiave(AirspaceVolumeRow v) => $"{v.NaturalKey}#{v.Ordinal}";

    private void Spunta(AirspaceVolumeRow v, bool acceso)
    {
        if (acceso) _scelti.Add(Chiave(v));
        else _scelti.Remove(Chiave(v));
    }

    private async Task Aggancia()
    {
        var pezzi = _settore.Split('|');
        if (pezzi.Length != 3 || !Enum.TryParse<SourceCatalog>(pezzi[0], out var catalogo)
            || !int.TryParse(pezzi[1], out var id)) return;

        await Gesto(async () =>
        {
            // Nell'ORDINE IN CUI SONO IN TABELLA, non in quello in cui sono stati spuntati: la tabella e'
            // ordinata per famiglia e nome, ed e' l'ordine che chi guarda si aspetta di ritrovare in mappa.
            var volumi = _volumi.Where(v => _scelti.Contains(Chiave(v)))
                .Select(v => new AirspaceVolumeKey(v.NaturalKey, v.Ordinal)).ToList();

            await Agganci.SetAsync(catalogo, id, pezzi[2], volumi, Authz.CurrentUserId, Authz.CurrentName);
            await RifaiConfinantiAsync();
            _scelti.Clear();
            _settore = "";
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(L["Asp_Bound"].Value, pezzi[2], volumi.Count);
        }, L["Asp_Rebinding"]);
    }

    /// <summary>
    /// 🔴 U-049 (revisione totale 3): la porta di ogni gesto della pagina. I servizi vengono dal circuito, quindi due
    /// gesti sovrapposti sono due operazioni sullo stesso DbContext: la sentinella sta PRIMA del primo await, e un
    /// doppio clic (o un secondo tasto premuto mentre il primo lavora) non parte. Un guasto che il servizio non
    /// traduce resta un messaggio: prima c'era un <c>finally</c> e basta, e l'eccezione abbatteva il circuito.
    /// </summary>
    private async Task Gesto(Func<Task> lavoro, string? attesa = null)
    {
        if (_busy) return;
        _attesa = attesa ?? L["Asp_Working"];
        _busy = true;
        _messaggio = null;
        try
        {
            // ⚠️ Si cede il passo UNA volta prima del lavoro, o la rotella non si disegna: Blazor ridisegna al primo
            // await che non finisce subito, e su SQLite le query finiscono tutte subito. Visto a schermo il 30
            // settembre 2026: 23 secondi di «Prendi il file» (confinanti rifatti) con la pagina muta.
            await Task.Yield();
            await lavoro();
        }
        catch (Vipi.Application.Aor.ValidationException ex)
        {
            _ok = false;
            _messaggio = ex.Message;
        }
        catch (Exception ex)
        {
            _ok = false;
            _messaggio = L["Common_UnexpectedError"] + ex.Message;
            Logger.LogError(ex, "Spazi aerei: gesto non riuscito.");
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// Il confronto fra le radioassistenze dell'AIP e la nostra anagrafica. ⚠️ Si preme, non gira da solo:
    /// rilegge il KMZ in archivio (1,3 MB da spacchettare) e il suo esito non serve a nessuna pagina finché
    /// qualcuno non lo chiede.
    /// </summary>
    private async Task Confronta()
    {
        if (_corrente is null) return;
        var corrente = _corrente;

        await Gesto(async () =>
        {
            var file = await Catalogo.GetFileAsync(corrente.Id);
            if (file is null) return;

            // 🔴 U-136: il lettore si sceglie dai byte (KMZ o KML), e un file che non si legge si dice: un rapporto
            // vuoto direbbe che mancano tutte le radioassistenze, e manderebbe a correggere dati giusti.
            var daAip = AirspaceNavaidReader.Leggi(file.Value.Content);
            if (daAip is null)
            {
                _ok = false;
                _messaggio = L["Asp_NavUnreadable"];
                return;
            }
            _rapporto = NavaidAipReport.Confronta(daAip, await Radioassistenze.ListAsync());
            _rapportoFatto = true;
        }, L["Asp_Reading"]);
    }

    private async Task Sgancia(SectorAirspaceBindingRow a)
    {
        await Gesto(async () =>
        {
            await Agganci.SetAsync(a.Catalog, a.SectorId, a.Callsign, Array.Empty<AirspaceVolumeKey>(),
                Authz.CurrentUserId, Authz.CurrentName);
            await RifaiConfinantiAsync();
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(L["Asp_Unbound"].Value, a.Callsign);
        }, L["Asp_Rebinding"]);
    }

    /// <summary>
    /// Rifà le adiacenze dei confinanti dopo un aggancio o uno sgancio, <b>senza chiamare IVAO</b>: i settori
    /// nostri hanno cambiato forma, gli esteri no.
    ///
    /// <para>⚠️ Le adiacenze sono <b>calcolate e salvate</b>, non derivate al volo: senza questa riga un
    /// aggancio si sarebbe visto sui confinanti al prossimo giro notturno — fino a 24 ore dopo (carta refactor
    /// 15 §3g). E ⚠️ se fallisce, l'aggancio resta: è un ricalcolo, non parte del gesto, e il giro notturno
    /// lo rifà comunque.</para>
    /// </summary>
    private async Task RifaiConfinantiAsync()
    {
        try { await Confinanti.RecomputeFromArchiveAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Ricalcolo confinanti dopo l'aggancio non riuscito."); }
    }

    private AirspaceCorrectionRow? CorrezioneDi(AirspaceVolumeRow v) =>
        _correzioni.FirstOrDefault(c => c.VolumeKey == v.NaturalKey && c.VolumeOrdinal == v.Ordinal);

    /// <summary>Che cosa diceva il file, per un volume corretto: la riga sotto la pastiglia «corretto».</summary>
    private string DalFile(AirspaceVolumeRow v) => CorrezioneDi(v) is { } c
        ? string.Format(L["Asp_Fix_FromFile"].Value, Nome(c.FileFamily), c.FileBaseRaw, c.FileTopRaw, c.FileClass ?? "—")
        : "";

    /// <summary>Un valore di una segnalazione come si legge: il tipo col suo nome, il vuoto con la lineetta.</summary>
    private string Valore(AirspaceCorrectionField campo, string? s) =>
        string.IsNullOrWhiteSpace(s) ? "—"
        : campo == AirspaceCorrectionField.Family && Enum.TryParse<AirspaceFamily>(s, out var f) ? Nome(f)
        : s;

    /// <summary>Il modulo parte dai valori che si vedono (già corretti, se c'è una correzione).</summary>
    private void ApriModifica(AirspaceVolumeRow v)
    {
        if (_inModifica == Chiave(v)) { _inModifica = null; return; }
        _inModifica = Chiave(v);
        _fFamiglia = v.Family;
        _fClasse = v.AirspaceClass ?? "";
        _fBase = v.BaseRaw;
        _fTetto = v.TopRaw;
    }

    private async Task SalvaModifica(AirspaceVolumeRow v)
    {
        await Gesto(async () =>
        {
            await Catalogo.CorrectAsync(new AirspaceVolumeKey(v.NaturalKey, v.Ordinal),
                new AirspaceCorrectionInput(_fFamiglia, _fClasse, _fBase, _fTetto),
                Authz.CurrentUserId, Authz.CurrentName, DateTime.UtcNow);
            _inModifica = null;
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(
                (CorrezioneDi(v) is null ? L["Asp_Fix_Same"] : L["Asp_Fix_Saved"]).Value, v.Name);
        });
    }

    private async Task TornaAlFile(AirspaceCorrectionRow c)
    {
        await Gesto(async () =>
        {
            await Catalogo.RemoveCorrectionAsync(c.Id);
            _inModifica = null;
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(L["Asp_Fix_Removed"].Value, c.Name);
        });
    }

    private async Task VaBene(AirspaceCorrectionFinding f)
    {
        await Gesto(async () =>
        {
            await Catalogo.AcknowledgeCorrectionAsync(f.Correction.Id, Authz.CurrentUserId, Authz.CurrentName,
                DateTime.UtcNow);
            // Ritrovato per nome = gli agganci hanno cambiato chiave: i confinanti si rifanno come dopo un aggancio.
            if (f.KeyChanged) await RifaiConfinantiAsync();
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(L["Asp_Fix_Acked"].Value, f.Correction.Name);
        }, f.KeyChanged ? L["Asp_Rebinding"].Value : null);
    }

    private async Task PrendiIlFile(AirspaceCorrectionFinding f)
    {
        await Gesto(async () =>
        {
            await Catalogo.RemoveCorrectionAsync(f.Correction.Id);
            if (f.KeyChanged) await RifaiConfinantiAsync();
            await RicaricaAsync();
            _ok = true;
            _messaggio = string.Format(L["Asp_Fix_Removed"].Value, f.Correction.Name);
        }, f.KeyChanged ? L["Asp_Rebinding"].Value : null);
    }

    private void Alterna(AirspaceFamily f)
    {
        if (!_famiglie.Remove(f)) _famiglie.Add(f);
    }

    private async Task CaricaAsync(InputFileChangeEventArgs e)
    {
        if (!PuoScrivere) return;

        await Gesto(async () =>
        {
            try
            {
                var file = e.File;

                // ⚠️ Il tetto sta qui E nel lettore, e non è una ripetizione oziosa: qui evita di tirare in
                // memoria un file enorme, là protegge chiunque altro chiami il lettore.
                await using var flusso = file.OpenReadStream(Vipi.Application.Coordinates.KmlReader.MaxByteFile);
                using var memoria = new MemoryStream();
                await flusso.CopyToAsync(memoria);
                var byteFile = memoria.ToArray();

                memoria.Position = 0;
                var lettura = file.Name.EndsWith(".kml", StringComparison.OrdinalIgnoreCase)
                    ? AirspaceKmlReader.LeggiKml(System.Text.Encoding.UTF8.GetString(byteFile))
                    : AirspaceKmlReader.LeggiKmz(memoria);

                if (lettura.Volumes.Count == 0)
                {
                    _ok = false;
                    _messaggio = L["Asp_NothingRead"];
                    return;
                }

                var salvato = await Catalogo.SaveAsync(
                    new NewAirspaceImport(file.Name, byteFile, _ciclo, Authz.CurrentUserId, Authz.CurrentName),
                    lettura, DateTime.UtcNow);

                _ok = true;
                _messaggio = string.Format(L["Asp_Loaded"].Value,
                    salvato.VolumesRead, salvato.VolumesUsable, salvato.DuplicateKeys);
                await RicaricaAsync();
            }
            catch (IOException ex)
            {
                // Il tetto di `OpenReadStream` esce di qui: è la risposta a un file troppo grosso, non un guasto.
                _ok = false;
                _messaggio = $"{L["Asp_TooBig"]} ({ex.Message})";
            }
        }, L["Asp_Reading"]);
    }

    private async Task MettiInVigore(int id)
    {
        await Gesto(async () =>
        {
            await Catalogo.SetCurrentAsync(id);
            await RicaricaAsync();
            _ok = true;
            _messaggio = L["Asp_SetCurrentDone"];
        });
    }

    private async Task Elimina(int id)
    {
        await Gesto(async () =>
        {
            await Catalogo.DeleteAsync(id);
            await RicaricaAsync();
            _ok = true;
            _messaggio = L["Asp_Deleted"];
        });
    }

    /// <summary>Il nome della famiglia nelle due lingue. Le sigle restano sigle: CTR è CTR ovunque.</summary>
    private string Nome(AirspaceFamily f) => L[$"Asp_Fam_{f}"];

    private string Nome(AirspaceIssueKind k) => L[$"Asp_Issue_{k}"];

    private string Nome(NavaidDiffKind k) => L[$"Asp_Nav_{k}"];
}
