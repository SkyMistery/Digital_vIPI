@* Il quadro vAWOS: il pannello meteo che un torrista tiene aperto mentre controlla.
   Carta: docs/feature/2026-09-12-vawos-e-minimi-lvp.md

   ⚠️ **SSR STATICA, e non è una dimenticanza.** Questa pagina resta aperta per ore su un secondo monitor:
   è esattamente il caso in cui un circuito Blazor si stacca e non torna. I dati arrivano già dentro l'HTML
   al primo disegno, e da lì in poi li rilegge un modulo JS da `/services/vawos/api/{icao}`, che è una
   richiesta HTTP qualunque — sopravvive a un riavvio del processo, a una rete che va e viene, e a un
   portatile che si chiude. Un'isola interattiva darebbe dodici diff al secondo per ogni controllore
   collegato e un riquadro «riconnessione» al primo singhiozzo.

   🔴 IL VENTO PARTE DAL BOLLETTINO. Qui il server lo scrive tale e quale; dal 15 settembre 2026 il modulo JS
   gli dà una PICCOLA variazione attorno al METAR ogni 45-200 s per pannello (±10°, ±1-3 kt, dentro settore e
   raffica), su richiesta del committente. Non è l'animazione continua tolta il 12: la storia e i limiti
   stanno in vipi-awos.js, `vento()`.

   ⚠️ Le etichette sono in INGLESE e non passano dai .resx (decisione del committente, 12 settembre 2026):
   DIR, SPEED, GUST, CROSS, TAIL, RVR, QNH, TL sono sigle ICAO, uguali in ogni torre del mondo. Le uniche
   parole vere — i codici di tempo presente — le traduce WxText, che c'è già.

   ⚠️ Il METAR di prova (`?test=`) è per lo STAFF: inietta un bollettino che non esiste, e su una pagina
   pubblica dev'essere impossibile per sbaglio. La guardia è qui, alla porta, e il servizio non ne ha una
   seconda. *@
@page "/services/vawos"
@page "/services/vawos/{Icao}"
@layout AwosLayout
@using Vipi.Application.Awos
@using Vipi.Application.Content
@using Vipi.Application.Weather
@inject IAwosService Awos
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L

<PageTitle>@(_vista is null ? "vAWOS" : $"vAWOS {_vista.Icao}")</PageTitle>

<div class="awos @(_vista?.Piste.Count >= 2 ? "awos-multi" : "")" data-awos-theme="night" data-awos-icao="@(_vista?.Icao)">

    <div class="awos-barra">
        <svg class="awos-vita" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            @for (var i = 0; i < 8; i++)
            {
                var a = i * Math.PI / 4 - Math.PI / 2;
                <circle data-vita="@i" cx="@((12 + 10 * Math.Cos(a)).ToString("0.0", Inv))"
                        cy="@((12 + 10 * Math.Sin(a)).ToString("0.0", Inv))" r="2" />
            }
        </svg>
        <span class="awos-marchio">vAWOS</span>
        @if (_vista is not null)
        {
            <span class="awos-scalo">@_vista.Icao · @_vista.Nome</span>
        }

        @* Il selettore è un form GET: senza circuito non c'è nessun `onchange` da agganciare, e un form
           funziona anche col JavaScript spento. Elenca SOLO gli scali che il quadro sa aprire. *@
        @if (_scali.Count > 0)
        {
            <form method="get" action="/services/vawos" class="awos-sel">
                <select name="icao" aria-label="Airport">
                    @foreach (var s in _scali)
                    {
                        <option value="@s.Icao" selected="@(s.Icao == _vista?.Icao)">@s.Icao — @s.Nome</option>
                    }
                </select>
                <button class="awos-btn" type="submit">GO</button>
            </form>
        }

        <span class="awos-sp"></span>

        @if (_vista is not null)
        {
            @if (_diProva is not null)
            {
                <span class="awos-pastiglia bozza">TEST METAR</span>
            }
            else if (_vista.MetarSource is { Length: > 0 } sorgente && Authz.IsDivisionStaff)
            {
                @* Come nel riquadro METAR delle vIPI: la provenienza si scrive solo quando NON è la
                   principale, e la si mostra da DivisionStaff in su — è meccanica di servizio. *@
                <span class="awos-pastiglia sorgente" title="METAR from @sorgente">@sorgente</span>
            }
            @* Il METAR di un altro campo si dice a tutti, come nel riquadro delle vIPI: è parte del dato. *@
            @if (_diProva is null && _vista.MetarStation is { Length: > 0 } stazione)
            {
                <span class="awos-pastiglia sorgente" title="METAR/TAF from @stazione: @_vista.Icao has no report of its own">METAR @stazione</span>
            }
            @if (!_vista.HaVipi && !_vista.HaVsop)
            {
                <span class="awos-pastiglia bozza" title="No published document: the public cannot open this">NOT PUBLIC</span>
            }
            @* 🔴 Lo stato LVP è SUGGERITO: attivare le procedure di bassa visibilità è una decisione
               dell'aeroporto, dentro cui stanno cose che il METAR non sa. La pastiglia dice sempre da dove
               viene la soglia — «(standard)» quando lo scalo non ha minimi suoi. *@
            <span class="awos-pastiglia lvp @AwosTesto.LvpClasse(_vista.Lvp.Valutazione)" data-awos="lvp"
                  title="@AwosTesto.LvpTitolo(_vista.Lvp.Valutazione)">@AwosTesto.LvpTesto(_vista.Lvp.Valutazione)</span>
            <span class="awos-pastiglia sim">ONLY FOR SIMULATION</span>
            <span class="awos-eta" data-awos-eta title="Age of the bulletin on screen">—</span>
            <button type="button" class="awos-btn" data-awos-tema title="Day / night">DAY</button>
            <button type="button" class="awos-btn" data-awos-mask="report">LOCAL REP.</button>
            <button type="button" class="awos-btn" data-awos-mask="atis">ATIS MSG</button>
            <button type="button" class="awos-btn" data-awos-mask="ext">EXT. DATA</button>
            @if (Authz.IsDivisionStaff)
            {
                <button type="button" class="awos-btn" data-awos-mask="prova">TEST METAR</button>
            }
        }
        <span class="awos-orologio" data-awos-clock>--:--:--Z</span>
    </div>

    @if (_vista is null)
    {
        <div class="awos-vuoto">
            <h1>@(_esito == AwosOutcome.NonPubblicato ? $"{Icao?.ToUpperInvariant()} — no published document" : "vAWOS")</h1>
            <p>
                @if (_esito == AwosOutcome.NonPubblicato)
                {
                    <text>The panel opens for airports that have a published vIPI — or a published vSOP, for military-only fields.</text>
                }
                else if (_esito == AwosOutcome.ScaloIgnoto && !string.IsNullOrWhiteSpace(Icao))
                {
                    <text>@Icao!.ToUpperInvariant() is not in the airport directory.</text>
                }
                else
                {
                    <text>Pick an airport.</text>
                }
            </p>
            <div class="awos-elenco">
                @foreach (var s in _scali)
                {
                    <a href="/services/vawos/@s.Icao.ToLowerInvariant()" title="@s.Nome">@s.Icao</a>
                }
            </div>
        </div>
    }
    else
    {
        var m = _vista.Metar;
        // ⚠️ Le scritte fisse le compone `AwosTesto`, lo stesso pezzo che usa l'endpoint a ogni giro: erano
        // scritte due volte — qui e nel JavaScript — e una delle due coppie era già divergita a schermo
        // (revisione del 12 settembre 2026, sera).
        var scritte = AwosTesto.Scritte(_vista, Authz.IsDivisionStaff);

        @if (Authz.IsDivisionStaff)
        {
            @* Il pannello del METAR di prova vive nella pagina ma nasce spento: lo accende il tasto. È un
               form GET, quindi l'indirizzo che ne esce si può incollare in una nota di verifica. *@
            <form method="get" action="/services/vawos/@_vista.Icao.ToLowerInvariant()" class="awos-prova"
                  data-awos-pan="prova" hidden>
                <label for="awos-test">TEST METAR</label>
                <input id="awos-test" name="test" value="@_diProva"
                       placeholder="LIRF 121250Z 24018G32KT 200V280 0500 R16R/0350U -SHRA FG VV002 09/08 Q0998" />
                <button class="awos-btn" type="submit">APPLY</button>
                <a class="awos-btn" href="/services/vawos/@_vista.Icao.ToLowerInvariant()">CLEAR</a>
            </form>
        }

        @if (_vista.Piste.Count < 2)
        {
            @* ── UNA PISTA (prototipo `awos_selector`): il MET REPORT in una fascia sopra, la striscia sotto. *@
            <div class="awos-met">
                <div class="awos-mc awos-qnh">
                    <div class="awos-mc-t">QNH (hPa)</div>
                    <div class="awos-qnh-n" data-awos="qnh">@(m?.QnhHpa?.ToString() ?? "----")</div>
                    <div class="awos-sub">
                        <div class="awos-cella"><div class="awos-sl">AIR TEMP (°C)</div><div class="awos-sv" data-awos="temp">@N(m?.TempC)</div></div>
                        <div class="awos-cella"><div class="awos-sl">DEW POINT (°C)</div><div class="awos-sv" data-awos="dew">@N(m?.DewpointC)</div></div>
                    </div>
                    <div class="awos-cella" style="margin-top:2px">
                        <div class="awos-sl">TL@(_vista.TransitionAltitudeFt is int ta ? $" · TA {ta} ft" : "")</div>
                        <div class="awos-sv" data-awos="tl">@(_vista.TransitionLevel ?? "—")</div>
                    </div>
                </div>

                @Visibilita()

                @Wx()

                <div class="awos-mc awos-cloud">
                    <div class="awos-mc-t">CLOUD</div>
                    @Nubi(3)
                </div>

                <div class="awos-mc awos-atis">
                    <div class="awos-mc-t">ATIS INFO</div>
                    @AtisBlocco()
                </div>

                @Trend()
            </div>

            <div class="awos-blocchi">
                @if (_vista.Piste.Count == 0)
                {
                    <div class="awos-vuoto"><p>No runways in the airport directory for @_vista.Icao.</p></div>
                }
                else
                {
                    <div class="awos-blocco" data-awos-blocco="0">
                        @Striscia(0)
                        <div class="awos-sorgente" data-awos="attiva">@scritte.RigaAttiva</div>
                        @Vento(0)
                        @Rvr(0, scritte)
                    </div>
                }
            </div>
        }
        else
        {
            @* ── DUE O PIU' PISTE (prototipi `awos_2rwy` e a tre piste): una COLONNA a sinistra col dato di
               scalo (QNH, ATIS, WX, trend) e a destra un blocco per pista, tutti della stessa altezza.
               ⚠️ Visibilità e nubi stanno DENTRO ogni blocco, come nel prototipo, anche se il METAR è uno:
               è l'impianto del quadro reale, dove ogni pista ha i suoi sensori — qui ripetono lo stesso
               bollettino, e nessuna cella finge una misura per pista che non c'è. *@
            <div class="awos-corpo">
                <div class="awos-sx">
                    <div class="awos-mc awos-qnh">
                        <div class="awos-qnh-t">QNH (hPa)</div>
                        <div class="awos-qnh-n" data-awos="qnh">@(m?.QnhHpa?.ToString() ?? "----")</div>
                        <div class="awos-sub tre">
                            <div class="awos-cella"><div class="awos-sl">AIR TEMP (°C)</div><div class="awos-sv" data-awos="temp">@N(m?.TempC)</div></div>
                            <div class="awos-cella"><div class="awos-sl">DEW POINT (°C)</div><div class="awos-sv" data-awos="dew">@N(m?.DewpointC)</div></div>
                            <div class="awos-cella" title="@(_vista.TransitionAltitudeFt is int ta2 ? $"TA {ta2} ft" : null)">
                                <div class="awos-sl">TL</div>
                                <div class="awos-sv" data-awos="tl">@(_vista.TransitionLevel ?? "—")</div>
                            </div>
                        </div>
                    </div>

                    <div class="awos-mc awos-atis">
                        @AtisBlocco()
                    </div>

                    <div class="awos-divider">MET REPORT / SPECIAL DATA</div>

                    @Wx()

                    @Trend()
                </div>

                <div class="awos-blocchi multi" style="--awos-blocchi:@_vista.Piste.Count">
                    @for (var i = 0; i < _vista.Piste.Count; i++)
                    {
                        var striscia = _vista.Piste[i];
                        <div class="awos-blocco" data-awos-blocco="@i">
                            <div class="awos-rwybar">
                                <span>RWY @striscia.Left.Ident@(striscia.Right is null ? "" : "/" + striscia.Right.Ident)</span>
                                @* La riga «RWY IN USE» sta nella barra del PRIMO blocco: il prototipo non ce l'ha, e
                                   dargli una fascia sua ruberebbe altezza a tutti i blocchi per una riga sola. *@
                                @if (i == 0)
                                {
                                    <span class="awos-rwybar-attiva" data-awos="attiva">@scritte.RigaAttiva</span>
                                }
                            </div>
                            <div class="awos-blocco-corpo">
                                <div class="awos-blocco-met">
                                    @Visibilita()
                                    <div class="awos-mc awos-cloud">
                                        <div class="awos-mc-t">CLOUD</div>
                                        @Nubi(4)
                                    </div>
                                </div>
                                <div class="awos-blocco-pista">
                                    @Striscia(i)
                                    @Vento(i)
                                    @Rvr(i, scritte)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Le tre finestrelle: scritte nell'HTML e spente, non fabbricate dal JavaScript come nel prototipo.
           Così esistono anche senza script, e il loro contenuto è nel documento. *@
        <div class="awos-mask" data-awos-pan="report" hidden>
            <button type="button" class="awos-x" data-awos-chiudi="report">✕</button>
            <h2>LOCAL REPORT — LAST METAR</h2>
            <div>@(_vista.MetarRaw ?? "No METAR available")</div>
        </div>
        <div class="awos-mask" data-awos-pan="atis" hidden>
            <button type="button" class="awos-x" data-awos-chiudi="atis">✕</button>
            <h2>ATIS MESSAGE</h2>
            <div data-awos="atis-text">@(_vista.Atis?.Testo ?? "No ATIS on frequency.")</div>
        </div>
        <div class="awos-mask dati" data-awos-pan="ext" hidden>
            <button type="button" class="awos-x" data-awos-chiudi="ext">✕</button>
            <h2>EXT. DATA — @_vista.Icao</h2>
            <table>
                <tbody>
                    <tr><td>QNH (inHg)</td><td>@(m?.QnhHpa is int q ? (q * 0.02953).ToString("0.00", Inv) : "—")</td></tr>
                    <tr><td>Ceiling</td><td>@(m?.CeilingFt is int c ? $"{c} ft" : "—")</td></tr>
                    <tr><td>Visibility</td><td>@(m?.VisibilityMeters is int v ? $"{v} m" : "—")</td></tr>
                    @foreach (var end in Testate())
                    {
                        <tr>
                            <td>QFE RWY @end.Ident @(end.ThresholdElevationFt is int e ? $"(thr {e} ft)" : "")</td>
                            <td>@(AwosComposition.Qfe(m?.QnhHpa, end.ThresholdElevationFt) is int qfe ? $"{qfe} hPa" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    /// <summary>ICAO dall'indirizzo. Manca = pagina di scelta.</summary>
    [Parameter] public string? Icao { get; set; }

    /// <summary>ICAO dalla query: è così che torna il form del selettore, che senza circuito non ha altro modo.</summary>
    [SupplyParameterFromQuery(Name = "icao")] public string? IcaoQuery { get; set; }

    /// <summary>Il bollettino iniettato a mano. Solo staff: qui è dove la guardia si applica.</summary>
    [SupplyParameterFromQuery(Name = "test")] public string? Test { get; set; }

    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private AwosView? _vista;
    private AwosOutcome _esito = AwosOutcome.Ok;
    private string? _diProva;
    private IReadOnlyList<AwosAirport> _scali = Array.Empty<AwosAirport>();

    protected override async Task OnParametersSetAsync()
    {
        _scali = await Awos.ElencoAsync();

        var id = string.IsNullOrWhiteSpace(Icao) ? IcaoQuery : Icao;
        if (string.IsNullOrWhiteSpace(id)) { _vista = null; _esito = AwosOutcome.Ok; return; }

        _diProva = Authz.IsDivisionStaff && !string.IsNullOrWhiteSpace(Test) ? Test!.Trim() : null;

        var esito = await Awos.BuildAsync(id!, Authz.IsEditor, _diProva);
        _vista = esito.Vista;
        _esito = esito.Esito;
    }

    private static string N(int? v) => v?.ToString(Inv) ?? "--";

    /// <summary>Sempre <paramref name="n"/> righe: il riquadro non deve cambiare altezza quando il tempo peggiora.</summary>
    private static IEnumerable<string> Righe(IEnumerable<string> righe, int n)
    {
        var l = righe.Take(n).ToList();
        while (l.Count < n) l.Add("");
        return l;
    }

    // ⚠️ I pezzi qui sotto li usano TUTT'E DUE gli impianti (una pista / più piste): cambia dove stanno, non
    // che cosa sono. Gli agganci `data-awos` restano gli stessi, e il modulo JS non sa quale impianto ha davanti.

    private RenderFragment Visibilita() => __builder =>
    {
        <div class="awos-mc awos-vis">
            <div class="awos-mc-t">VISIBILITY</div>
            <div class="awos-vis-n" data-awos="vis">@(_vista?.Metar?.Visibility ?? "----")</div>
        </div>
    };

    private RenderFragment Wx() => __builder =>
    {
        <div class="awos-mc awos-wx">
            <div class="awos-mc-t">WX</div>
            <div class="awos-righe" data-awos="wx">
                @foreach (var riga in Righe(AwosTesto.TempoPresente(_vista?.Metar, k => L[k].Value), 3))
                {
                    <div class="awos-riga">@riga</div>
                }
            </div>
        </div>
    };

    private RenderFragment Nubi(int n) => __builder =>
    {
        <div class="awos-righe" data-awos="cloud">
            @foreach (var riga in Righe(AwosTesto.Nubi(_vista?.Metar), n))
            {
                <div class="awos-riga">@riga</div>
            }
        </div>
    };

    private RenderFragment Trend() => __builder =>
    {
        <div class="awos-mc awos-trend">
            <div class="awos-mc-t">SUPPLEMENTARY INFO / TREND</div>
            <div class="awos-trend-box" data-awos="trend">@(_vista?.Metar?.Trend ?? "")</div>
        </div>
    };

    /// <summary>Nessun ATIS in onda ⇒ «—» e basta. Una lettera vecchia tenuta lì perché faceva scena sarebbe la
    /// bugia peggiore di questo riquadro: la lettera è ciò che il pilota ripete.</summary>
    private RenderFragment AtisBlocco() => __builder =>
    {
        <div class="awos-atis-blk">
            <div class="awos-atis-t" data-awos="atis-chi">@(_vista?.Atis?.Callsign ?? "— ATIS —")</div>
            <div class="awos-atis-v" data-awos="atis">@(_vista?.Atis?.Lettera ?? "—")</div>
            <div class="awos-atis-ts" data-awos="atis-ts">@(_vista?.Atis?.Orario ?? "--:--")</div>
        </div>
    };

    private RenderFragment Striscia(int i) => __builder =>
    {
        var striscia = _vista!.Piste[i];
        var attivaSx = Attiva(striscia.Left.Ident);
        var attivaDx = striscia.Right is not null && Attiva(striscia.Right.Ident);

        @* ⚠️ Le testate sono SEMPRE arancioni (committente, 15 settembre 2026): la pista in uso la dice la
           freccia, e basta. Una testata che diventava verde era un secondo segnale per la stessa cosa. *@
        <div class="awos-strip">
            <div class="awos-testata" data-awos-end="0">@striscia.Left.Ident</div>
            <div class="awos-pettine"><i></i><i></i><i></i><i></i></div>
            <div class="awos-nastro">
                <div class="awos-tratteggio"></div>
                @* La freccia va nel SENSO DI MARCIA della pista in uso: in uso la 06 su 06/24, la freccia va
                   da 06 verso 24 (committente, 15 settembre 2026 — prima puntava VERSO la testata in uso, cioè
                   al contrario). È un tasto: il clic sceglie a mano, e la riga della pista in uso lo dice. *@
                <button type="button" class="awos-freccia" data-awos-inverti="@i"
                        title="Invert the active direction">
                    <svg width="66" height="34" viewBox="0 0 70 40" data-awos-arrow="@i"
                         style="transform:@(PuntaADestra(attivaSx, attivaDx, InPartenza(striscia.Right?.Ident)) ? "scaleX(1)" : "scaleX(-1)")">
                        <polygon points="0,8 46,8 46,0 70,20 46,40 46,32 0,32"
                                 fill="@(attivaSx || attivaDx ? "#2a8a3a" : "#8a8a8a")" stroke="#000" stroke-width="2" />
                    </svg>
                </button>
            </div>
            <div class="awos-pettine"><i></i><i></i><i></i><i></i></div>
            <div class="awos-testata" data-awos-end="1">@(striscia.Right?.Ident ?? "—")</div>
        </div>
    };

    /// <summary>
    /// La freccia va a destra quando si decolla/atterra dalla testata di SINISTRA.
    /// <para>⚠️ Le DUE testate in uso — arrivi da una, partenze dall'altra — la freccia segue le PARTENZE
    /// (committente, 15 settembre 2026). Nessuna delle due in uso (freccia grigia): a destra, per convenzione.
    /// Stessa regola in vipi-awos.js (`striscia_`).</para>
    /// </summary>
    private static bool PuntaADestra(bool attivaSx, bool attivaDx, bool destraInPartenza) =>
        attivaSx && attivaDx ? !destraInPartenza : attivaSx || !attivaDx;

    private bool InPartenza(string? ident) =>
        ident is not null && _vista?.Attiva.Dep.Contains(ident, StringComparer.OrdinalIgnoreCase) == true;

    private RenderFragment Vento(int i) => __builder =>
    {
        var striscia = _vista!.Piste[i];
        <div class="awos-vento">
            <div class="awos-vento-wrap">
                @PannelloVento(i, 0, striscia.Left)
                <div class="awos-divisore"></div>
                @PannelloVento(i, 1, striscia.Right)
            </div>
        </div>
    };

    /// <summary>
    /// La fascia RVR di una striscia. Una cella PER TESTATA, col suo ident: il METAR dà l'RVR per testata,
    /// non i tre sensori TDZ/MID/END del quadro reale — una cella «MID» sarebbe la media delle due, cioè un
    /// numero che nessuno ha misurato sotto il nome di un sensore che non c'è.
    /// </summary>
    private RenderFragment Rvr(int i, AwosScritte scritte) => __builder =>
    {
        var acceso = _vista!.Lvp.Valutazione.Stato is LvpStato.Preparazione or LvpStato.InVigore or LvpStato.Cancellabile;
        <div class="awos-rvr @(acceso ? "lvp" : "")" data-awos-rvr="@i">
            @for (var k = 0; k < scritte.Rvr[i].Count; k++)
            {
                var cella = scritte.Rvr[i][k];
                <div class="awos-rvr-f">
                    <div class="awos-rvr-l">RVR @cella.Testata (m)</div>
                    <div class="awos-rvr-v" data-awos-rvrv="@i-@k">@cella.Valore</div>
                </div>
            }
        </div>
    };

    /// <summary>Questa testata è in uso. ⚠️ Lo chiede al MODELLO: le piste in uso sono un elenco — un ATIS
    /// che dice «arrival runway 16L 16R» ne dichiara due — e confrontarle a una a una qui vorrebbe dire
    /// riscrivere la stessa regola in una pagina.</summary>
    private bool Attiva(string? ident) => _vista?.Attiva.Comprende(ident) == true;

    private IEnumerable<AwosEnd> Testate() =>
        _vista is null ? Array.Empty<AwosEnd>()
                       : _vista.Piste.SelectMany(s => s.Right is null ? new[] { s.Left } : new[] { s.Left, s.Right });

    /// <summary>
    /// Un pannello vento. I due di una striscia hanno la STESSA sorgente — il vento è uno — e cambiano solo
    /// per la testata su cui si proiettano: è tutto il senso di averne due.
    /// <para>⚠️ Al primo disegno tutti i valori vengono dal bollettino, compresi traverso e coda. Le piccole
    /// variazioni periodiche le aggiunge il modulo JS, pannello per pannello.</para>
    /// </summary>
    private RenderFragment PannelloVento(int blocco, int lato, AwosEnd? end) => __builder =>
    {
        var w = _vista?.Metar?.Wind;
        var hdg = end?.HeadingDeg ?? 0;
        var comp = Componenti(w, hdg);

        <div class="awos-pannello" data-awos-wind="@blocco-@lato" data-awos-hdg="@hdg">
            <div class="awos-pannello-t">WIND @(end?.Ident ?? "—")</div>
            <div class="awos-wrow">
                <div class="awos-wf"><div class="awos-wl">DIR (°)</div><div class="awos-box-lg"><div class="awos-n-lg" data-awos-w="dir">@Dir(w)</div></div></div>
                <div class="awos-wf"><div class="awos-wl">SPEED (kt)</div><div class="awos-box-lg"><div class="awos-n-lg" data-awos-w="spd">@Spd(w)</div></div></div>
            </div>
            <div class="awos-wrow">
                <div class="awos-wf">
                    <div class="awos-wl">EXTREMES (°)</div>
                    <div class="awos-wpair">
                        <div class="awos-box-sm"><div class="awos-n-sm" data-awos-w="vmin">@Deg(w?.VarFromDeg)</div></div>
                        <div class="awos-box-sm"><div class="awos-n-sm" data-awos-w="vmax">@Deg(w?.VarToDeg)</div></div>
                    </div>
                </div>
                <div class="awos-wf">
                    <div class="awos-wl">GUST (kt)</div>
                    <div class="awos-box-sm"><div class="awos-n-sm ambra" data-awos-w="gust">@(w?.GustKt is int g ? g.ToString("00", Inv) : "--")</div></div>
                </div>
            </div>
            <div class="awos-wrow">
                <div class="awos-wf"><div class="awos-wl">CROSS (kt)</div><div class="awos-box-sm"><div class="awos-n-sm @Colore(comp.Cross, 8, 15)" data-awos-w="cross">@Kt(comp.Cross, w)</div></div></div>
                <div class="awos-wf"><div class="awos-wl">TAIL (kt)</div><div class="awos-box-sm"><div class="awos-n-sm @(comp.Tail > 0 ? "rosso" : "")" data-awos-w="tail">@Kt(comp.Tail, w)</div></div></div>
            </div>
        </div>
    };

    /// <summary>
    /// La direzione come la scrive un quadro: <c>VRB</c> se variabile, <c>CALM</c> se calmo, altrimenti i tre
    /// gradi (con 360 al posto di 000, che è la convenzione).
    /// <para>⚠️ <c>CALM</c> e non «360»: <c>00000KT</c> vuol dire vento calmo, non «da nord a zero nodi», e
    /// un 360 in quella casella si legge come una direzione misurata.</para>
    /// </summary>
    private static string Dir(ParsedWind? w) =>
        w is null ? "---" : w.Calm ? "CALM" : w.Variable ? "VRB"
        : w.DirectionDeg is int d ? ((d + 359) % 360 + 1).ToString("000", Inv) : "---";

    private static string Spd(ParsedWind? w) => w is null ? "--" : w.SpeedKt.ToString("00", Inv);
    private static string Deg(int? v) => v is int d ? d.ToString("000", Inv) : "--";
    private static string Kt(int v, ParsedWind? w) => w is null ? "--" : v.ToString("00", Inv);
    private static string Colore(int v, int ambra, int rosso) => v >= rosso ? "rosso" : v >= ambra ? "ambra" : "";

    /// <summary>Traverso e coda sulla testata. Vento calmo o sconosciuto ⇒ zero, e la casella dice `--`.</summary>
    private static (int Cross, int Tail) Componenti(ParsedWind? w, int hdg)
    {
        if (w is null || w.Calm || w.DirectionDeg is not int dir) return (0, 0);
        var delta = (dir - hdg) * Math.PI / 180.0;
        var testa = (int)Math.Round(w.SpeedKt * Math.Cos(delta));
        return ((int)Math.Round(Math.Abs(w.SpeedKt * Math.Sin(delta))), testa < 0 ? -testa : 0);
    }
}
