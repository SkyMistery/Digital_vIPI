@page "/services/vsop/{Acc}/apps/editor"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IDocRoutesRegistry DocRoutes

@* La pagina dell'editor di un APP non remotizzato: qui restano l'indirizzo, il pannello dell'unione e
   quello di pubblicazione. Il CORPO editoriale — sezioni, corpo derivato, lock, salvataggi — sta in
   <AppSectionsEditor>, perche' lo stesso editor va montato anche nell'editor UNITO (carta
   2026-09-03-documenti-uniti.md §5b). *@

<AppSectionsEditor @ref="_editor" Acc="@Acc" App="@App" Chrome="true">
    <AfterSections>
        @* L'unione dei documenti: SOPRA il pannello di pubblicazione, perche' e' cio' che decide QUANTI
           documenti quel tasto pubblichera'. *@
        <UnionPanel Target="ReleaseTargetType.App" Key="@Callsign"
                    IsEditing="_editor?.Guscio.IsEditing ?? false" Changed="UnioneCambiata" />

        @* ⚠️ L'ancora `sec-versioni` è la stessa nei cinque editor: è dove atterra «Ripubblica» dalla lista
           «Da fare» (carta 2026-08-26-da-fare-una-lista-sola.md §3). *@
        <div id="sec-versioni">
            <ReleasePanel Revisione="_unioneRev" Target="ReleaseTargetType.App" Key="@Callsign"
                          ShowDiff="true" AllowCancel="Authz.IsEditor"
                          PreviewUrlFactory="ReleasePreviewUrl"
                          Published="Ricarica" />
        </div>
    </AfterSections>
</AppSectionsEditor>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    private AppSectionsEditor? _editor;

    private string Callsign => (App ?? "").Trim().ToUpperInvariant();

    /// <summary>Quante volte l'unione e' cambiata in questa sessione di pagina. Alzarla e' cio' che
    /// costringe <c>ReleasePanel</c> a rileggere i suoi bersagli: la sua memoizzazione e' su bersaglio e
    /// chiave, e quelle non cambiano quando si unisce un documento.</summary>
    private int _unioneRev;

    private async Task UnioneCambiata()
    {
        _unioneRev++;
        await Ricarica();
    }

    private Task Ricarica() => _editor?.RicaricaAsync() ?? Task.CompletedTask;

    // ---- release AIRAC (target App) ----
    private string? ReleasePreviewUrl(int releaseId) =>
        DocRoutes.For(ReleaseTargetType.App).ViewerUrl(Acc.ToLowerInvariant(), Callsign, null, releaseId);
}
