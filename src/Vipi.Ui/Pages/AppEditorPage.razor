@page "/vsop/{Acc}/apps/editor"
@layout SopLayout
@rendermode InteractiveServer
@using System.Text.Json
@inject IAppDocumentService AppDoc
@inject IEditingService Editing
@inject IStationResolver Stations
@inject IReleaseService Releases
@inject IEditAuthorizationService Authz
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Vle_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@L["App_EditorTitle"] @_app · vIPI</PageTitle>
    <div class="wrap struct">
        <div class="breadcrumb">
            <a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> ›
            <a href="/vsop/@Acc.ToLowerInvariant()/apps">@L["App_NonRemotized"]</a> ›
            <a href="/vsop/@Acc.ToLowerInvariant()/apps/vipi?app=@_app">@_app</a> › <b>@L["Common_Editor"]</b>
        </div>

        @if (_notFound)
        {
            <div class="doc-head"><div><h2 style="margin-bottom:2px">✎ @L["App_EditorTitle"] @_app</h2><span class="muted">@_acc.Name</span></div></div>
            <div class="callout warning"><span class="cic">⚠️</span><div>@((MarkupString)L["App_NotFound"].Value)</div></div>
        }
        else if (_denied)
        {
            <div class="callout danger"><span class="cic">🔒</span><div><p class="ct">@L["Vle_Unauthorized"]</p>@(string.Format(L["App_DeniedBody"].Value, _acc.Code))</div></div>
        }
        else if (_doc is null)
        {
            <p class="help">@L["App_LoadingEditor"]</p>
        }
        else
        {
            <div class="editor-bar">
                <div class="doc-head" style="margin:0">
                    <div><h2 style="margin-bottom:2px">✎ @L["App_EditorTitle"] @_displayName</h2><span class="muted">@_app · @_acc.Name</span></div>
                </div>
            </div>

            <DocReviewBar DocumentId="_docId" />

            @if (_lock is { Locked: true, IsMine: false })
            {
                <div class="callout danger"><span class="cic">🔒</span><div><p class="ct">@L["Ed_LockedByOther"]</p>
                    @(string.Format(L["Ed_LockedByOtherBody"].Value, _lock.ByName ?? L["Lock_AnotherEditor"].Value, _lock.ExpiresUtc is { } e ? $" (→ {e:HH:mm})" : ""))</div></div>
            }
            @if (_error is not null) { <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div style="flex:1">@_error</div><button class="btn ghost" style="padding:0 6px" @onclick="() => _error = null">✕</button></div> }

            <DocumentSectionsEditor Doc="_doc" IsEditing="_editing" Run="Guard" OnChanged="LoadAsync"
                                    IsDerivedSection="IsDerived" DerivedContent="DerivedSection"
                                    IsMandatory="IsMandatory" IsHiddenSection="IsHidden"
                                    OnToggleHidden="ToggleHidden"
                                    IsRenderModeToggleable="IsRenderModeToggleable"
                                    ShowToc="true" ExtraTocItems="_tocExtra">
                <RightRail>
                    @if (_save == SaveState.Saving) { <span class="save-badge saving">💾 @L["Ed_Saving"]</span> }
                    else if (_save == SaveState.Saved) { <span class="save-badge saved">✓ @L["Ed_Saved"]</span> }
                    <span class="pill @(_doc.VersionStatus == DocumentStatus.Draft ? "grey" : "green")">
                        @(_doc.VersionStatus == DocumentStatus.Draft ? string.Format(L["Ed_DraftVN"].Value, _doc.VersionNumber) : string.Format(L["Ed_PublishedVN"].Value, _doc.VersionNumber))
                    </span>
                    <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/apps/vipi?app=@_app&as=draft" target="_blank" rel="noopener" title="@L["Ed_PreviewDraftTitle"]"><Icon Name="eye" /> @L["Ed_PreviewDraft"]</a>
                    @if (_editing)
                    {
                        <span class="save-badge lock-mine" title="@L["Lock_Editing"]">🔒 @L["Lock_Editing"]@(_lock.ExpiresUtc is { } e ? string.Format(L["Lock_UntilSuffix"].Value, e.ToString("HH:mm")) : "")</span>
                        <button class="btn ghost" @onclick="FinishEditing">✓ @L["Lock_FinishEdit"]</button>
                    }
                    else if (_lock is { Locked: true, IsMine: false })
                    {
                        <span class="save-badge lock-badge" title="@L["Ed_LockedByOther"]">🔒 @(_lock.ByName ?? L["Lock_AnotherEditor"].Value)@(_lock.ExpiresUtc is { } e ? $" · → {e:HH:mm}" : "")</span>
                        <button class="btn ghost" disabled title="@L["Ed_LockedByOther"]">✎ @L["Ed_Edit"]</button>
                    }
                    else
                    {
                        <button class="btn ghost" @onclick="StartEditing">✎ @L["Ed_Edit"]</button>
                    }
                </RightRail>
            </DocumentSectionsEditor>

            @Release()
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    private AccInfo? _acc;
    private string _app = "";
    private string _displayName = "";
    private string _accCode = "";

    private int? _docId;
    private EditableDocument? _doc;
    private LockInfo _lock = LockInfo.Free();
    private bool _notFound, _denied, _editing;
    private string? _error;

    private enum SaveState { Idle, Saving, Saved }
    private SaveState _save = SaveState.Idle;
    private int _saveTick;

    // Derivate/editoriali-strutturate (data-driven), rese via DerivedContent per SectionKey.
    private List<AppSeparationRow> _separations = new();
    private AppVfrContent _vfr = AppVfrContent.Empty;
    private List<AppFreqRow> _freqs = new();
    private List<int> _linkIds = new();
    private AppCoordination _coord = AppCoordination.Empty;
    private AccAorView _aorView = AccAorView.Empty;   // AoR multi-settore (primario + figli del dominio), come il viewer
    private HashSet<string> _hiddenKeys = new(StringComparer.OrdinalIgnoreCase);

    // Configurazioni (APP multi-settore, es. LIPE_APP con LIPE_W/LIPE_E). Pool + salvate + accorpamento derivato.
    private IReadOnlyList<AccSectorPick> _sectorPool = Array.Empty<AccSectorPick>();
    private List<AccConfiguration> _configs = new();
    private IReadOnlyList<AccConfigTableView> _configTable = Array.Empty<AccConfigTableView>();

    private IReadOnlyList<LinkableFrequencyRow> _linkable = Array.Empty<LinkableFrequencyRow>();
    private string _freqSearch = "";
    private int? _freqDragIndex;

    // Release AIRAC (target App).
    private IReadOnlyList<ReleaseInfo> _rels = Array.Empty<ReleaseInfo>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private string? _relCycle;
    private string? _relNote;
    private readonly HashSet<int> _diffOpen = new();
    private readonly Dictionary<int, ReleaseDiff> _diffs = new();
    private const string _releaseAnchor = "p-release";
    // Voce TOC per il blocco Release (reso fuori da DocumentSectionsEditor).
    private IReadOnlyList<EditorTocItem> _tocExtra => new[] { new EditorTocItem(_releaseAnchor, L["App_VersionsReleases"]) };

    protected override void OnInitialized()
    {
        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        _relCycle ??= _upcoming.FirstOrDefault()?.Cycle;
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        _notFound = _denied = false;
        _error = null;
        _doc = null;
        _docId = null;
        _app = (App ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrWhiteSpace(_app)) { _notFound = true; return; }

        var identity = await AppDoc.GetIdentityAsync(_app);
        if (identity is null) { _notFound = true; return; }
        _displayName = string.IsNullOrWhiteSpace(identity.Title) ? _app : identity.Title;
        _accCode = identity.AccCode;

        try
        {
            _docId = await AppDoc.EnsureAsync(_app);   // ACC-gated: crea il Document se manca
        }
        catch (EditNotAllowedException) { _denied = true; return; }
        catch (ValidationException) { _notFound = true; return; }

        _linkable = await AppDoc.ListLinkableFrequenciesAsync();
        _sectorPool = await AppDoc.ListSectorsAsync(_app);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_docId is not int id) return;
        try
        {
            _doc = await Editing.LoadForEditAsync(id);
            _lock = await Editing.InspectLockAsync(id);
            if (_doc is null) { _notFound = true; return; }
            _editing = _editing && _doc.IsEditable;

            _separations = (await AppDoc.GetSeparationsAsync(_app)).ToList();
            _vfr = await AppDoc.GetVfrAsync(_app);
            var overrides = await AppDoc.GetOverridesAsync(_app);
            _hiddenKeys = overrides.HiddenSections.ToHashSet(StringComparer.OrdinalIgnoreCase);
            _linkIds = overrides.FreqLinkSectorIds.ToList();
            await RefreshDerivedAsync();

            _rels = await Releases.ListAsync(ReleaseTargetType.App, _app);
            _diffOpen.Clear(); _diffs.Clear();
        }
        catch (EditNotAllowedException) { _denied = true; }
    }

    private async Task RefreshDerivedAsync()
    {
        _freqs = (await AppDoc.DeriveFrequenciesAsync(_app)).ToList();
        _coord = await AppDoc.DeriveCoordinationAsync(_app);
        _aorView = await AppDoc.GetAorViewAsync(_app);
        _configs = (await AppDoc.GetConfigurationsAsync(_app)).ToList();
        _configTable = await AppDoc.DeriveConfigTableAsync(_app);
    }

    // ---- workflow bozza/lock/pubblicazione (come VloaEditor) ----
    private async Task StartEditing()
    {
        if (_docId is not int id) return;
        await GuardCore(async () =>
        {
            if (_doc is { IsEditable: false }) await Editing.CreateDraftAsync(id);
            else await Editing.AcquireLockAsync(id);
            await LoadAsync();
            _editing = _doc?.IsEditable == true;
        }, silent: true);
    }

    // Fine modifica: rilascia il lock così il documento è subito libero per gli altri (non aspetta i 30 min di TTL).
    private async Task FinishEditing()
    {
        _editing = false;
        if (_docId is int id)
        {
            await GuardCore(() => Editing.ReleaseLockAsync(id), silent: true);
            _lock = await Editing.InspectLockAsync(id);
        }
    }

    // ---- sezioni derivate / editoriali-strutturate ----
    private static readonly HashSet<string> Special = new(StringComparer.OrdinalIgnoreCase)
        { "separations", "configurations", "aor", "frequencies", "vfr", "minima", "coordination" };

    private static bool IsDerived(EditableSection s) => s.Depth == 0 && Special.Contains(s.SectionKey);

    // Sezioni fisse del catalogo (non custom): bloccate a rinomina/sposta/elimina.
    private bool IsMandatory(EditableSection s) => SectionCatalog.Find(SectionProfile.App, s.SectionKey) is not null;
    // Solo le sezioni DERIVATE (aor/frequencies/coordination/minima) espongono il toggle Live/Frozen (doc 10 §3a).
    private static bool IsRenderModeToggleable(EditableSection s) => SectionCatalog.KindOf(s.SectionKey) == SectionKind.Derived;
    private bool IsHidden(EditableSection s) => _hiddenKeys.Contains(s.SectionKey);

    private Task ToggleHidden(EditableSection s) => Guard(async () =>
    {
        if (!_hiddenKeys.Add(s.SectionKey)) _hiddenKeys.Remove(s.SectionKey);
        await AppDoc.SaveHiddenSectionsAsync(_app, _hiddenKeys.ToList());
    });

    // ---- editoriali-strutturate (persist immediato via AppDocumentService) ----
    private Task SaveSeparations(IReadOnlyList<AppSeparationRow> rows) => Guard(async () =>
    {
        _separations = rows.ToList();
        await AppDoc.SaveSeparationsAsync(_app, _separations);
    });

    private Task SaveVfr(AppVfrContent content) => Guard(async () =>
    {
        _vfr = content;
        await AppDoc.SaveVfrAsync(_app, content);
    });

    // ---- configurazioni ----
    private Task SaveConfigs(IReadOnlyList<AccConfiguration> configs) => Guard(async () =>
    {
        _configs = configs.ToList();
        await AppDoc.SaveConfigurationsAsync(_app, _configs);
        _configTable = await AppDoc.DeriveConfigTableAsync(_app);   // ri-deriva l'accorpamento
        _aorView = await AppDoc.GetAorViewAsync(_app);              // e i selettori config sulla mappa
    });

    private async Task<bool> ConfirmRemoveConfig(AccConfiguration c) =>
        await JS.InvokeAsync<bool>("confirm", string.Format(L["App_RemoveConfigConfirm"].Value, c.Name));

    // ---- frequenze (derivate + override/link) ----
    private Task MoveFreq((int Index, int Dir) m) => Guard(async () =>
    {
        var j = m.Index + m.Dir;
        if (j < 0 || j >= _freqs.Count) return;
        (_freqs[m.Index], _freqs[j]) = (_freqs[j], _freqs[m.Index]);
        await AppDoc.SaveFrequencyOrderAsync(_app, _freqs.Select((r, i) => new AppFreqOrderOverride(r.Callsign, i)).ToList());
    });

    private void FreqDragOver(int idx)
    {
        if (_freqDragIndex is not int from || from == idx) return;
        var item = _freqs[from];
        _freqs.RemoveAt(from);
        _freqs.Insert(idx, item);
        _freqDragIndex = idx;
    }

    private Task FreqDragDrop() => _freqDragIndex is null ? Task.CompletedTask : Guard(async () =>
    {
        _freqDragIndex = null;
        await AppDoc.SaveFrequencyOrderAsync(_app, _freqs.Select((r, i) => new AppFreqOrderOverride(r.Callsign, i)).ToList());
    });

    private Task RemoveLink(int sourceSectorId) => Guard(async () =>
    {
        _linkIds.Remove(sourceSectorId);
        await AppDoc.SaveFrequencyLinksAsync(_app, _linkIds);
        await RefreshDerivedAsync();
    });

    private Task AddLink(int sourceSectorId) => Guard(async () =>
    {
        if (sourceSectorId <= 0 || _linkIds.Contains(sourceSectorId)) return;
        _linkIds.Add(sourceSectorId);
        _freqSearch = "";
        await AppDoc.SaveFrequencyLinksAsync(_app, _linkIds);
        await RefreshDerivedAsync();
    });

    // ---- infra ----
    // Firma a 1 parametro preservata: passata come Run= a DocumentSectionsEditor (Func<Func<Task>,Task>).
    private Task Guard(Func<Task> action) => GuardCore(action, silent: false);
    private async Task GuardCore(Func<Task> action, bool silent)
    {
        _error = null;
        if (!silent) { _save = SaveState.Saving; StateHasChanged(); }
        try
        {
            await action();
            if (!silent)
            {
                _save = SaveState.Saved;
                var tick = ++_saveTick;
                _ = DismissSavedAsync(tick);
            }
        }
        catch (EditNotAllowedException) { _error = L["App_NoEditPerm"]; _save = SaveState.Idle; }
        catch (EditConflictException ex) { _error = ex.Message; _save = SaveState.Idle; if (_docId is int id) _lock = await Editing.InspectLockAsync(id); }
        catch (ValidationException ex) { _error = ex.Message; _save = SaveState.Idle; }
    }

    private async Task DismissSavedAsync(int tick)
    {
        await Task.Delay(2000);
        if (tick == _saveTick && _save == SaveState.Saved) { _save = SaveState.Idle; await InvokeAsync(StateHasChanged); }
    }

    private static string AsString(object? v) => v as string ?? "";

    // ---- render sezioni derivate ----
    private RenderFragment DerivedSection(EditableSection s) => __builder =>
    {
        switch (s.SectionKey)
        {
            case "separations":
                <AppSeparations Rows="_separations" Editing="_editing" RowsChanged="SaveSeparations" />
                break;
            case "configurations":
                <AppConfigurations Configs="_configs" Pool="_sectorPool" Tables="_configTable" Editing="_editing"
                                   MapScope="@($"app-aor-{_app}")" ConfigsChanged="SaveConfigs" ConfirmRemove="ConfirmRemoveConfig" />
                break;
            case "aor":
                <AccAor View="_aorView" Id="@($"app-aor-{_app}")" />
                break;
            case "frequencies":
                <AppFrequencies Rows="_freqs" Editing="_editing" OnMove="MoveFreq" OnRemoveLink="RemoveLink"
                                DragIndex="_freqDragIndex" OnDragStart="i => _freqDragIndex = i"
                                OnDragEnter="FreqDragOver" OnDrop="FreqDragDrop" OnDragEnd="FreqDragDrop" />
                @if (_editing) { @FreqLinkPicker() }
                break;
            case "vfr":
                <AppVfr Content="_vfr" Editing="_editing" ContentChanged="SaveVfr" />
                break;
            case "minima":
                <AppMinima />
                break;
            case "coordination":
                <AppCoordinationView Coord="_coord" />
                break;
        }
    };

    private RenderFragment FreqLinkPicker() => __builder =>
    {
        <div class="app-linkpick">
            <input class="app-in" placeholder="@L["App_LinkFreqPh"]" value="@_freqSearch"
                   @oninput="e => _freqSearch = AsString(e.Value)" />
            @if (!string.IsNullOrWhiteSpace(_freqSearch))
            {
                <div class="sector-pick">
                    @foreach (var l in _linkable
                        .Where(l => !_linkIds.Contains(l.SectorId))
                        .Where(l => l.Callsign.Contains(_freqSearch, StringComparison.OrdinalIgnoreCase)
                                 || (l.Icao ?? "").Contains(_freqSearch, StringComparison.OrdinalIgnoreCase))
                        .Take(8))
                    {
                        var row = l;
                        <button type="button" class="sp-item" @onclick="() => AddLink(row.SectorId)">
                            <b>@row.Callsign</b> <span class="muted">@row.FrequencyMhz</span>
                        </button>
                    }
                </div>
            }
        </div>
    };

    // ---- release AIRAC (target App): timeline + selettore + diff ----
    private RenderFragment Release() => __builder =>
    {
        <div class="block" id="@_releaseAnchor">
            <h3 style="margin-top:0"><Icon Name="calendar" /> @L["App_VersionsReleases"]</h3>
            <p class="help">@((MarkupString)string.Format(L["App_ReleaseHelp"].Value, _currentCycle))</p>

            @if (_rels.Count == 0)
            {
                <p class="help" style="margin:0 0 6px">@L["Rel_NoRelease"]</p>
            }
            else
            {
                @foreach (var r in _rels)
                {
                    <div class="ver-row @(r.IsEffectiveNow ? "current" : "")">
                        <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
                        <div style="flex:1">
                            <b>@RelLabel(r)</b>
                            <div class="vmeta">rel. v@r.VersionNumber · VID @r.CreatedByUserId · @r.CreatedUtc.ToString("dd MMM yyyy HH:mm") · @L["Rel_EffectiveFrom"] @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.Note) ? "" : $" — \"{r.Note}\"")</div>
                        </div>
                        <span class="vact">
                            <a class="btn ghost" href="@($"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}&as=rel:{r.Id}")" target="_blank" rel="noopener"><Icon Name="eye" /> @L["Rel_Preview"]</a>
                            <button class="btn ghost" @onclick="() => ToggleDiff(r.Id)"><Icon Name="search" /> @L["Rel_Diff"]</button>
                            @if (Authz.IsAdmin)
                            {
                                <button class="btn ghost" @onclick="() => CancelRelease(r.Id)">✕ @L["Common_Cancel"]</button>
                            }
                        </span>
                    </div>
                    @if (_diffOpen.Contains(r.Id))
                    {
                        <div class="block" style="margin:2px 0 8px 24px">@DiffBlock(r.Id)</div>
                    }
                }
            }

            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px">
                <select class="app-in" style="min-width:270px;max-width:340px" @bind="_relCycle">
                    @foreach (var c in _upcoming)
                    {
                        <option value="@c.Cycle">AIRAC @c.Cycle — @L["Rel_From"] @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
                    }
                </select>
                <input class="app-in" style="max-width:240px" placeholder="@L["Rel_NotePh"]" @bind="_relNote" />
                <button class="btn primary" @onclick="PublishReleaseNow" title="@L["Rel_PublishNowTitle"]"><Icon Name="megaphone" /> @L["Rel_PublishNow"]</button>
                <button class="btn ghost" @onclick="PublishRelease" title="@L["Rel_ScheduleTitle"]"><Icon Name="calendar" /> @L["Rel_ScheduleAtCycle"]</button>
            </div>
        </div>
    };

    private async Task ReloadReleases()
    {
        _rels = await Releases.ListAsync(ReleaseTargetType.App, _app);
        _diffOpen.Clear(); _diffs.Clear();
    }

    private async Task PublishRelease()
    {
        var cycle = _relCycle ?? _upcoming.FirstOrDefault()?.Cycle;
        if (cycle is null) return;
        await Guard(async () =>
        {
            await Releases.PublishAsync(ReleaseTargetType.App, _app, cycle, _relNote);
            await ReloadReleases();
        });
    }

    private Task PublishReleaseNow() => Guard(async () =>
    {
        await Releases.PublishNowAsync(ReleaseTargetType.App, _app, _relNote);
        await ReloadReleases();
    });

    private Task CancelRelease(int releaseId) => Guard(async () =>
    {
        await Releases.CancelReleaseAsync(releaseId);
        await ReloadReleases();
    });

    private async Task ToggleDiff(int releaseId)
    {
        if (!_diffOpen.Remove(releaseId))
        {
            _diffOpen.Add(releaseId);
            if (!_diffs.ContainsKey(releaseId))
            {
                try { _diffs[releaseId] = await Releases.DiffAsync(releaseId); }
                catch (EditNotAllowedException ex) { _error = ex.Message; }
            }
        }
    }

    private string RelLabel(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 " + L["Rel_Effective"] : r.Status == ReleaseStatus.Scheduled ? "🕒 " + L["Rel_Scheduled"] : L["Rel_Superseded"];
    private static string DiffPill(string change) => change switch { "Aggiunta" => "green", "Rimossa" => "grey", _ => "blue" };
    private string ChangeLabel(string change) => change switch
    {
        "Aggiunta" => L["Rel_ChangeAdded"], "Rimossa" => L["Rel_ChangeRemoved"], "Modificata" => L["Rel_ChangeModified"], _ => change,
    };

    private RenderFragment DiffBlock(int releaseId) => __builder =>
    {
        @if (_diffs.TryGetValue(releaseId, out var diff))
        {
            <div class="muted" style="font-size:12px;margin-bottom:4px">@L["Rel_ComparedWith"] @diff.BaselineLabel</div>
            @if (diff.Rows.Count == 0)
            {
                <p class="help" style="margin:0">@L["Rel_NoDiff"]</p>
            }
            else
            {
                <table class="cfg-table">
                    <thead><tr><th>@L["Rel_ColItem"]</th><th>@L["Rel_ColChange"]</th><th>@L["Rel_ColDetail"]</th></tr></thead>
                    <tbody>
                        @foreach (var r in diff.Rows)
                        {
                            <tr>
                                <td>@r.Label</td>
                                <td><span class="pill @DiffPill(r.Change)">@ChangeLabel(r.Change)</span></td>
                                <td class="muted" style="font-size:12px">@r.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else { <p class="help" style="margin:0">@L["Rel_LoadingDiff"]</p> }
    };
}
