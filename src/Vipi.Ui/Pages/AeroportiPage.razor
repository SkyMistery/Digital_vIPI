@page "/vsop/admin/airports"
@page "/vsop/admin/aeroporti"
@layout SopLayout
@rendermode InteractiveServer
@using Microsoft.Extensions.Logging
@inject IStructureEditingService Struct
@inject IAirportEditingService AptEdit
@inject IAirportDirectory AirportDir
@inject IEditAuthorizationService Authz
@inject ILogger<AeroportiPage> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Apt_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <a href="/vsop/admin/sectorstructure">@L["Struct_Title"]</a> › <b>@L["Apt_Title"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Apt_Title"]</h2><span class="muted">@L["Apt_Subtitle"]</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="callout warning"><span class="cic">⚠️</span><div>@_msg</div></div>
        }
        @if (_ok is not null)
        {
            <div class="callout"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@_ok</div></div>
        }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" />

        <div class="topo-layout">
            @* --- SINISTRA: aeroporti assegnati a una ACC --- *@
            <div class="panel">
                <div class="section-title"><h3>@L["Apt_AssignedTitle"] <span class="pill blue">@_assigned.Count</span></h3><span class="ln"></span>
                    @if (_assigned.Count > 0)
                    {
                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="ReimportAll" title="@L["Apt_ReimportTitle"]">@if (_busy) { <span class="spin"></span> }↻ @L["Apt_ReimportBtn"]</button>
                    }
                </div>
                <div class="block">
                    <div class="se-row">
                        <input style="flex:1" placeholder="@L["Apt_FilterIcaoName"]" @bind="_qAssigned" @bind:event="oninput" />
                        <select @bind="_filterAcc" title="@L["Apt_FilterAccTitle"]">
                            <option value="">@L["Apt_AllAccs"]</option>
                            @foreach (var f in _accs) { <option value="@f.Code">@f.Code</option> }
                        </select>
                    </div>
                    @if (_assigned.Count == 0)
                    {
                        <p class="help">@L["Apt_NoAssigned"]</p>
                    }
                    else if (ShownAssigned().Count == 0)
                    {
                        <p class="help">@NoAssignedResults()</p>
                    }
                    else
                    {
                        @if (_selAssigned.Count > 0)
                        {
                            <div class="bulk-bar">
                                <b>@string.Format(L["Apt_NSelected"].Value, _selAssigned.Count)</b>
                                <select @bind="_bulkMoveAcc">
                                    <option value="">@L["Apt_MoveToAcc"]</option>
                                    @foreach (var f in _accs) { <option value="@f.Code">@f.Code</option> }
                                </select>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit || string.IsNullOrEmpty(_bulkMoveAcc))" @onclick="BulkMoveAssigned">@L["Apt_Move"]</button>
                                <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="GenerateDocs" title="@L["Apt_GenDocsTitle"]">@if (_busy) { <span class="spin"></span> }<Icon Name="file" /> @L["Apt_GenDocs"]</button>
                                <InlineConfirm TriggerClass="btn ghost danger" AriaLabel="@L["Apt_DeleteSelectedAria"]"
                                               Prompt="@(string.Format(L["Apt_DeleteSelectedPrompt"].Value, _selAssigned.Count))" Disabled="@(_busy || !_canEdit)" OnConfirm="BulkDeleteAssigned">
                                    <Trigger><Icon Name="trash" /> @L["Apt_DeleteSelected"]</Trigger>
                                </InlineConfirm>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _selAssigned.Clear()">@L["Apt_Deselect"]</button>
                            </div>
                        }
                        <table class="res-table">
                            <thead><tr>
                                <th class="col-chk"><input type="checkbox" aria-label="@L["Apt_SelectAll"]" checked="@(ShownAssigned().Count > 0 && ShownAssigned().All(a => _selAssigned.Contains(a.Id)))" @onchange="e => ToggleAllAssigned((bool)e.Value!)" /></th>
                                <th class="col-icao">ICAO</th><th>ACC</th><th>@L["Apt_ColSectors"]</th><th>@L["Common_State"]</th><th></th>
                            </tr></thead>
                            <tbody>
                                @foreach (var a in ShownAssigned())
                                {
                                    <tr class="@(_selAssigned.Contains(a.Id) ? "row-sel" : null)">
                                        <td class="col-chk"><input type="checkbox" aria-label="@L["Apt_SelectRow", a.Icao]" checked="@_selAssigned.Contains(a.Id)" @onchange="e => ToggleAssigned(a.Id, (bool)e.Value!)" /></td>
                                        <td class="col-icao"><a href="/vsop/@a.AccCode.ToLowerInvariant()/airports/editor?icao=@a.Icao" title="@(string.Format(L["Apt_OpenEditorTitle"].Value, a.Icao))"><b>@a.Icao</b></a><br /><span class="muted" style="font-size:11px">@a.Name</span></td>
                                        <td>
                                            <select disabled="@(_busy || !_canEdit)" @onchange="e => ChangeAcc(a.Id, a.AccCode, e.Value?.ToString())">
                                                @foreach (var f in _accs)
                                                {
                                                    <option value="@f.Code" selected="@(f.Code == a.AccCode)">@f.Code</option>
                                                }
                                            </select>
                                        </td>
                                        @* aria-hidden no: il contenuto (numero di settori, avviso «senza torre») va letto. Il click è
                                           una comodità che duplica la checkbox della riga, la quale È raggiungibile da
                                           tastiera e ora ha un nome. Dare il fuoco anche alla cella creerebbe tre fermate
                                           di tabulazione per un solo comando: peggio, non meglio. *@
                                        <td class="sel-cell" @onclick="() => ClickAssigned(a.Id)">
                                            @a.Sectors
                                            @if (!a.HasTower)
                                            {
                                                <span class="pill" style="background:#ffe9c7;color:#9a6700;margin-left:6px" title="@L["Apt_NoTwrTitle"]">⚠ @L["Apt_NoTwr"]</span>
                                            }
                                        </td>
                                        <td style="white-space:nowrap">
                                            @if (a.Sectors == 0)
                                            {
                                                <span class="pill" style="background:#eee;color:#666" title="@L["Apt_HiddenNoSectorsTitle"]">🚫 @L["Apt_HiddenNoSectors"]</span>
                                            }
                                            else if (a.IsHidden)
                                            {
                                                <span class="pill" style="background:#ffe0e0;color:#b42318" title="@L["Apt_HiddenAdminTitle"]">🙈 @L["Apt_HiddenState"]</span>
                                            }
                                            else
                                            {
                                                <span class="pill" style="background:#dafbe7;color:#1a7f37" title="@L["Apt_VisibleTitle"]">👁 @L["Apt_Visible"]</span>
                                            }
                                        </td>
                                        <td style="white-space:nowrap">
                                            <a class="btn ghost" href="/vsop/@a.AccCode.ToLowerInvariant()/airports/editor?icao=@a.Icao" title="@L["Apt_EditorProfileTitle"]">✎</a>
                                            @if (a.Sectors > 0)
                                            {
                                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => ToggleHidden(a)" title="@(a.IsHidden ? L["Apt_ShowTitle"] : L["Apt_HideTitle"])"><Icon Name="@(a.IsHidden ? "eye" : "eye-off")" /> @(a.IsHidden ? L["AccAdmin_Show"] : L["AccAdmin_Hide"])</button>
                                            }
                                            <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Apt_DeleteAria"]" TriggerTitle="@L["Apt_DeleteTriggerTitle"]"
                                                           Disabled="@(_busy || !_canEdit)" OnConfirm="() => Remove(a.Id, a.AccCode)"><Trigger><Icon Name="trash" /></Trigger></InlineConfirm>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* --- DESTRA: anagrafica aeroporti IVAO (DB) --- *@
            <div class="panel">
                <div class="section-title"><h3>@L["Apt_IvaoDirTitle"] <span class="pill blue">@(_ivao is null ? "…" : _ivao.Count.ToString())</span></h3><span class="ln"></span>
                    @if (_ivao is not null)
                    {
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="AutoAssign" title="@L["Apt_AutoAssignTitle"]">@if (_busy) { <span class="spin"></span> }⟳ @L["Apt_AutoAssignBtn"]</button>
                    }
                </div>
                <div class="block">
                    @if (_ivaoErr is not null)
                    {
                        <div class="callout warning" style="margin-top:0"><span class="cic">🔒</span><div>@L["Apt_IvaoUnavailable"] @_ivaoErr</div></div>
                    }
                    else if (_ivao is null)
                    {
                        <p class="help">@L["Apt_LoadingIvao"]</p>
                    }
                    else
                    {
                        <p class="muted" style="font-size:11.5px;margin:0 0 8px">@((MarkupString)L["Apt_IvaoIntro"].Value)</p>
                        <div class="field"><input placeholder="@L["Apt_FilterIcaoName"]" @bind="_qIvao" @bind:event="oninput" /></div>
                        @if (!_ivao.Any(a => Match(a.Icao, a.Name, _qIvao)))
                        {
                            <p class="help">@(string.Format(L["Apt_NoResultsFor"].Value, _qIvao))</p>
                        }
                        else
                        {
                            @if (_selIvao.Count > 0)
                            {
                                <div class="bulk-bar">
                                    <b>@string.Format(L["Apt_NSelected"].Value, _selIvao.Count)</b>
                                    <select @bind="_bulkAssignAcc">
                                        <option value="">@L["Apt_AssignToAcc"]</option>
                                        @foreach (var f in _accs) { <option value="@f.Code">@f.Code</option> }
                                    </select>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || string.IsNullOrEmpty(_bulkAssignAcc))" @onclick="BulkAssignIvao">@L["Apt_AssignSelected"]</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _selIvao.Clear()">@L["Apt_Deselect"]</button>
                                </div>
                            }
                            <table class="res-table">
                                <thead><tr>
                                    <th class="col-chk"><input type="checkbox" aria-label="@L["Apt_SelectAll"]" checked="@(ShownIvaoUnassigned().Count > 0 && ShownIvaoUnassigned().All(a => _selIvao.Contains(a.Icao)))" @onchange="e => ToggleAllIvao((bool)e.Value!)" /></th>
                                    <th class="col-icao">ICAO</th><th>@L["Apt_ColAccFromDb"]</th><th>@L["Apt_ColAssignment"]</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var ap in ShownIvao())
                                    {
                                        var assignedAcc = AssignedAccOf(ap.Icao);
                                        var selectable = assignedAcc is null;
                                        <tr class="@(selectable && _selIvao.Contains(ap.Icao) ? "row-sel" : null)" style="@(assignedAcc is not null ? "background:#dafbe7" : "")">
                                            <td class="col-chk">
                                                @if (selectable)
                                                {
                                                    <input type="checkbox" aria-label="@L["Apt_SelectRow", ap.Icao]" checked="@_selIvao.Contains(ap.Icao)" @onchange="e => ToggleIvao(ap.Icao, (bool)e.Value!)" />
                                                }
                                            </td>
                                            <td class="col-icao @(selectable ? "sel-cell" : null)" @onclick="() => ClickIvao(ap.Icao)"><b>@ap.Icao</b><br /><span class="muted" style="font-size:11px">@ap.Name</span></td>
                                            <td class="@(selectable ? "sel-cell" : null)" @onclick="() => ClickIvao(ap.Icao)"><span class="muted" style="font-size:12px">@(ap.AccCode ?? "—")</span></td>
                                            <td>
                                                @if (assignedAcc is not null)
                                                {
                                                    <span style="color:#1a7f37;font-weight:700">✓ @assignedAcc</span>
                                                }
                                                else
                                                {
                                                    var pick = _assignAcc.GetValueOrDefault(ap.Icao, "");
                                                    <div class="assign-cell">
                                                        <select disabled="@(_busy || !_canEdit)" value="@pick" @onchange="e => SetAssignAcc(ap.Icao, e.Value?.ToString())">
                                                            <option value="">@L["Apt_AccOption"]</option>
                                                            @foreach (var f in _accs) { <option value="@f.Code">@f.Code</option> }
                                                        </select>
                                                        <button class="btn ghost" disabled="@(_busy || !_canEdit || string.IsNullOrEmpty(pick))" @onclick="() => Assign(ap)">@L["Apt_Assign"]</button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<AccRow> _accs = Array.Empty<AccRow>();
    private IReadOnlyList<AirportAdminRow> _assigned = Array.Empty<AirportAdminRow>();
    private IReadOnlyList<SourceAirport>? _ivao;
    private string? _ivaoErr;
    private readonly Dictionary<string, string> _assignAcc = new(StringComparer.OrdinalIgnoreCase);
    private string _qAssigned = "", _qIvao = "";
    private string _filterAcc = "";   // filtro ACC sulla tabella di sinistra ("" = tutte)
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _msg;
    private string? _ok;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // selezione multipla (azioni bulk)
    private readonly HashSet<int> _selAssigned = new();
    private readonly HashSet<string> _selIvao = new(StringComparer.OrdinalIgnoreCase);
    private string _bulkMoveAcc = "", _bulkAssignAcc = "";

    private List<AirportAdminRow> ShownAssigned() =>
        _assigned.Where(a => Match(a.Icao, a.Name, _qAssigned)
            && (string.IsNullOrEmpty(_filterAcc) || string.Equals(a.AccCode, _filterAcc, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    private List<SourceAirport> ShownIvao() =>
        (_ivao ?? Enumerable.Empty<SourceAirport>()).Where(a => Match(a.Icao, a.Name, _qIvao)).ToList();
    private List<SourceAirport> ShownIvaoUnassigned() =>
        ShownIvao().Where(a => AssignedAccOf(a.Icao) is null).ToList();

    private void ToggleAssigned(int id, bool on) { if (on) _selAssigned.Add(id); else _selAssigned.Remove(id); }
    private void ToggleAllAssigned(bool on)
    {
        foreach (var a in ShownAssigned()) { if (on) _selAssigned.Add(a.Id); else _selAssigned.Remove(a.Id); }
    }
    private void ToggleIvao(string icao, bool on) { if (on) _selIvao.Add(icao); else _selIvao.Remove(icao); }
    private void ToggleAllIvao(bool on)
    {
        foreach (var a in ShownIvaoUnassigned()) { if (on) _selIvao.Add(a.Icao); else _selIvao.Remove(a.Icao); }
    }

    // Click sulle celle non editabili (ICAO, ecc.) = toggle della selezione di riga.
    private void ClickAssigned(int id) => ToggleAssigned(id, !_selAssigned.Contains(id));
    private void ClickIvao(string icao)
    {
        if (AssignedAccOf(icao) is not null) return;   // le righe già assegnate non sono selezionabili
        ToggleIvao(icao, !_selIvao.Contains(icao));
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        await ReloadAsync();
        _ = LoadIvaoAsync();
    }

    private async Task ReloadAsync()
    {
        _accs = await Struct.ListAccsAsync();
        _assigned = await Struct.ListAllAirportsAsync();
    }

    private async Task LoadIvaoAsync()
    {
        try { _ivao = await AirportDir.GetAirportsAsync(); }
        catch (Exception ex) { _ivaoErr = ex.Message.Split('—')[0].Trim(); }
        await InvokeAsync(StateHasChanged);
    }

    private string NoAssignedResults() =>
        L["Apt_NoResults"].Value
        + (string.IsNullOrEmpty(_filterAcc) ? "" : string.Format(L["Apt_NoResultsAccPart"].Value, _filterAcc))
        + (string.IsNullOrWhiteSpace(_qAssigned) ? "" : string.Format(L["Apt_NoResultsQPart"].Value, _qAssigned))
        + ".";

    private static bool Match(string icao, string name, string q) =>
        string.IsNullOrWhiteSpace(q)
        || icao.Contains(q, StringComparison.OrdinalIgnoreCase)
        || name.Contains(q, StringComparison.OrdinalIgnoreCase);

    private string? AssignedAccOf(string icao) =>
        _assigned.FirstOrDefault(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase))?.AccCode;

    private async Task Guarded(Func<Task> action)
    {
        _busy = true; _msg = null; _ok = null;
        try { await action(); await ReloadAsync(); }
        catch (ValidationException ex) { _msg = ex.Message; }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private void SetAssignAcc(string icao, string? acc) => _assignAcc[icao] = acc ?? "";

    private Task Assign(SourceAirport ap) => Guarded(async () =>
    {
        var acc = _assignAcc.GetValueOrDefault(ap.Icao, "");
        if (string.IsNullOrEmpty(acc)) return;
        await Struct.CreateAirportAsync(acc, ap.Icao, ap.Name);
        _assignAcc.Remove(ap.Icao);
    });

    private Task AutoAssign() => Guarded(async () =>
    {
        var r = await Struct.AutoAssignKnownAirportsAsync();
        foreach (var f in r.Failures)
            Logger.LogWarning(f.Error, "Import settori aeroporto {Icao} saltato in auto-assegnazione.", f.Icao);
        _ok = r.Assigned == 0
            ? L["Apt_AutoAssignNone"].Value
            : L["Apt_AutoAssignOk", r.Assigned].Value
              + (r.Failures.Count > 0 ? L["Apt_AutoAssignSkipped", r.Failures.Count].Value : "");
    });

    private Task ChangeAcc(int id, string fromAcc, string? toAcc) =>
        string.IsNullOrEmpty(toAcc) || toAcc == fromAcc ? Task.CompletedTask
            : Guarded(() => Struct.MoveAirportAsync(id, fromAcc, toAcc));

    private Task Remove(int id, string accCode) => Guarded(() => Struct.DeleteAirportAsync(accCode, id));

    private Task ToggleHidden(AirportAdminRow a) =>
        Guarded(() => Struct.SetAirportHiddenAsync(a.AccCode, a.Id, !a.IsHidden));

    // --- Azioni bulk: continuano oltre i fallimenti per-riga e riassumono il risultato. ---
    private async Task RunBulk(Func<Task> body)
    {
        _busy = true; _msg = null; _ok = null;
        try { await body(); await ReloadAsync(); }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private Task BulkMoveAssigned() => RunBulk(async () =>
    {
        if (string.IsNullOrEmpty(_bulkMoveAcc)) { _msg = L["Apt_ChooseTargetAcc"]; return; }
        var target = _bulkMoveAcc;
        int ok = 0, fail = 0;
        foreach (var id in _selAssigned.ToList())
        {
            var a = _assigned.FirstOrDefault(x => x.Id == id);
            if (a is null || a.AccCode == target) continue;
            try { await Struct.MoveAirportAsync(id, a.AccCode, target); ok++; }
            catch { fail++; }
        }
        _selAssigned.Clear(); _bulkMoveAcc = "";
        _ok = L["Apt_MovedOk", ok, target].Value + (fail > 0 ? L["Apt_MovedFail", fail].Value : ".");
    });

    private Task GenerateDocs() => RunBulk(async () =>
    {
        int created = 0, sectors = 0, skipped = 0, fail = 0;
        foreach (var id in _selAssigned.ToList())
        {
            var a = _assigned.FirstOrDefault(x => x.Id == id);
            if (a is null) continue;
            try
            {
                var r = await Struct.GenerateAirportDocumentAsync(a.Icao);
                if (r.Created) { created++; sectors += r.SectorsCreated; } else skipped++;
            }
            catch { fail++; }
        }
        _selAssigned.Clear();
        _ok = L["Apt_DocsGenerated", created, sectors].Value
            + (skipped > 0 ? L["Apt_DocsSkipped", skipped].Value : "")
            + (fail > 0 ? L["Apt_DocsFailed", fail].Value : "") + ".";
    });

    // Re-import da IVAO (piste + Transition Altitude) per TUTTI gli aeroporti assegnati: una chiamata sorgente per
    // aeroporto (best-effort, prosegue oltre i fallimenti). Rispetta la policy import (categorie escluse = nessun tocco).
    private Task ReimportAll() => RunBulk(async () =>
    {
        int ok = 0, fail = 0;
        foreach (var a in _assigned.ToList())
        {
            try { await AptEdit.ReimportFromSourceAsync(a.Icao); ok++; }
            catch { fail++; }
        }
        _ok = L["Apt_ReimportOk", ok].Value + (fail > 0 ? L["Apt_ReimportFail", fail].Value : ".");
    });

    private Task BulkDeleteAssigned() => RunBulk(async () =>
    {
        int ok = 0, fail = 0;
        foreach (var id in _selAssigned.ToList())
        {
            var a = _assigned.FirstOrDefault(x => x.Id == id);
            if (a is null) continue;
            try { await Struct.DeleteAirportAsync(a.AccCode, id); ok++; }
            catch { fail++; }
        }
        _selAssigned.Clear();
        _ok = L["Apt_DeletedOk", ok].Value + (fail > 0 ? L["Apt_DeletedFail", fail].Value : ".");
    });

    private Task BulkAssignIvao() => RunBulk(async () =>
    {
        if (string.IsNullOrEmpty(_bulkAssignAcc)) { _msg = L["Apt_ChooseAcc"]; return; }
        var target = _bulkAssignAcc;
        int ok = 0, fail = 0;
        foreach (var icao in _selIvao.ToList())
        {
            var ap = _ivao?.FirstOrDefault(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase));
            if (ap is null || AssignedAccOf(icao) is not null) continue;
            try { await Struct.CreateAirportAsync(target, ap.Icao, ap.Name); ok++; }
            catch { fail++; }
        }
        _selIvao.Clear(); _bulkAssignAcc = "";
        _ok = L["Apt_AssignedOk", ok, target].Value + (fail > 0 ? L["Apt_AssignedFail", fail].Value : ".");
    });
}
