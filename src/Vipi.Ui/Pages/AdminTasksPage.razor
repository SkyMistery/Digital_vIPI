@page "/vsop/admin/tasks"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditorTaskService Tasks
@inject IEditAuthorizationService Authz
@inject IStaffRosterService Roster
@inject IEditingService Editing
@inject IEditorTaskLinksService TaskLinks
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Grants_TasksTitle"] · IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1200px">
    @* ---- Le pagine admin, dove stava la briciola di pane ----
       La barra è al posto della briciola perché ne faceva già il lavoro e meglio: «Home › Staff Area ›
       Structure › Airports» portava a tre posti che sono tutti qui dentro (o nel logo in topbar), diceva
       «sei in Airports» come lo dice la voce accesa, e inventava una gerarchia — Aeroporti NON sta sotto
       Struttura, sono pagine sorelle, e la barra le mostra per quello che sono. Le briciole erano anche già
       divergenti fra loro: «Admin» portava a due indirizzi diversi a seconda della pagina.
       Sopra il titolo e non sotto: il titolo deve toccare il contenuto che intitola. Da sotto, la barra si
       infilava fra l'H2 e la sua prima sezione e li staccava.
       ⚠️ Resta nuda, senza `@if` intorno: il filtro per autorizzazione lo fa il componente. *@
    <AdminNav />

    <div class="doc-head">
        <div><h2 style="margin-bottom:2px"><Icon Name="clipboard" Size="22" /> @L["Grants_TasksTitle"]</h2><span class="muted">@string.Format(L["AdminTasks_Subtitle"], _currentCycle)</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_AccessReserved"]</p>@L["AdminTasks_StaffOnly"]</div></div>
    }
    else
    {
        @if (_error is not null) { <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div></div> }
        @if (_status is not null) { <div class="callout success"><span class="cic">✓</span><div>@_status</div></div> }

        <div class="section-title"><h3>@L["AdminTasks_NewTask"]</h3><span class="ln"></span></div>
        <div class="xfe-form" style="max-width:none">
            <div style="display:flex;flex-wrap:wrap;gap:10px">
                @* `oninput` e non il solo `onchange`: il tasto si accende mentre si scrive, non alla perdita
                   del fuoco — altrimenti sembra spento per sempre a chi ha appena finito di digitare. *@
                <div class="field" style="flex:2;min-width:240px"><label>@L["AdminTasks_TitleLabel"]</label><input placeholder="@L["AdminTasks_TitlePlaceholder"]" @bind="_title" @bind:event="oninput" /></div>
                <div class="field" style="flex:1;min-width:180px"><label>@L["AdminTasks_AssignTo"]</label>
                    <select @bind="_assignee">
                        <option value="0">@L["Grants_Select"]</option>
                        @if (_members is not null)
                        {
                            @foreach (var m in _members)
                            {
                                <option value="@m.UserId">@m.UserId@(string.IsNullOrWhiteSpace(m.DisplayName) ? "" : $" — {m.DisplayName}")</option>
                            }
                        }
                    </select>
                </div>
                <div class="field" style="flex:1;min-width:130px"><label>@L["AdminTasks_Priority"]</label>
                    <select @bind="_priority">@foreach (var p in Enum.GetValues<EditorTaskPriority>()) { <option value="@p">@PrioLabel(p)</option> }</select>
                </div>
                <div class="field" style="flex:1;min-width:150px"><label>@L["AdminTasks_DueAirac"]</label>
                    <select @bind="_due"><option value="">@L["AdminTasks_None"]</option>@foreach (var c in _upcoming) { <option value="@c.Cycle">@c.Cycle</option> }</select>
                </div>
                <div class="field" style="flex:2;min-width:240px"><label>@L["AdminTasks_DocOptional"]</label>
                    <select @bind="_docKey">
                        <option value="">@L["AdminTasks_FreeTask"]</option>
                        @foreach (var d in _docs)
                        {
                            <option value="@DocKey(d)">@d.Type · @d.Title (@d.Scope)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field"><label>@L["AdminTasks_DescOptional"]</label><textarea rows="2" @bind="_desc" placeholder="@L["AdminTasks_DescPlaceholder"]"></textarea></div>
            @* Il tasto è spento finché mancano le due cose che il service pretende, e il PERCHÉ gli sta
               accanto (regola 170). Senza, «Seleziona» valeva VID 0 e l'incarico nasceva di nessuno. *@
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <button class="btn primary" disabled="@(_busy || !PuoCreare)" @onclick="Create">@L["AdminTasks_CreateBtn"]</button>
                @if (!PuoCreare) { <span class="muted" style="font-size:12px">@L["AdminTasks_NeedTitleAndAssignee"]</span> }
            </div>
        </div>

        <div class="section-title"><h3>@L["AdminTasks_AllTasks"]</h3><span class="ln"></span></div>
        @if (_tasks is null) { <LoadingState /> }
        else if (_tasks.Count == 0) { <p class="help">@L["AdminTasks_NoneCreated"]</p> }
        else
        {
            <table>
                <thead><tr><th>@L["AdminTasks_TitleLabel"]</th><th>@L["AdminTasks_Assignee"]</th><th>@L["Common_State"]</th><th>@L["AdminTasks_Priority"]</th><th>@L["AdminTasks_Due"]</th><th>@L["AdminTasks_Document"]</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in _tasks)
                    {
                        var overdue = Tasks.IsOverdue(t);
                        <tr style="@(overdue ? "background:rgba(209,36,47,.06)" : "")">
                            <td><b>@t.Title</b>@if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="muted" style="font-size:11px">@t.Description</div> }</td>
                            <td>@t.AssigneeUserId@(string.IsNullOrWhiteSpace(t.AssigneeName) ? "" : $" — {t.AssigneeName}")</td>
                            <td>
                                <select class="app-in" style="max-width:150px" @onchange="e => SetStatus(t.Id, e.Value?.ToString())">
                                    @foreach (var s in Enum.GetValues<EditorTaskStatus>()) { <option value="@s" selected="@(s == t.Status)">@ColLabel(s)</option> }
                                </select>
                            </td>
                            <td><span class="pill @PrioPill(t.Priority)">@PrioLabel(t.Priority)</span></td>
                            <td>@(t.DueAiracCycle is null ? "—" : $"AIRAC {t.DueAiracCycle}")@(overdue ? " ⚠" : "")</td>
                            @* Il documento collegato si APRE anche da qui: chi assegna e controlla aveva
                               solo l'etichetta, mentre la card dell'utente aveva il tasto. Quello che si fa
                               in una pagina si fa anche nell'altra (regola 68). *@
                            <td class="muted" style="font-size:11px">
                                @if (Link(t)?.Url is { } url)
                                {
                                    <a href="@url" title="@Link(t)!.TitoloCorrente">@(t.TargetLabel ?? t.TargetKey)</a>
                                }
                                else
                                {
                                    @(t.TargetLabel ?? (t.TargetKey is null ? "—" : t.TargetKey))
                                }
                            </td>
                            <td><InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["AdminTasks_DeleteTask"]" Disabled="@_busy" OnConfirm="() => Delete(t.Id)"><Trigger><Icon Name="trash" /></Trigger></InlineConfirm></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="section-title" style="margin-top:18px"><h3>@L["AdminTasks_ProgressByEditor"]</h3><span class="ln"></span></div>
            <div class="choice-grid">
                @foreach (var grp in _tasks.GroupBy(t => (t.AssigneeUserId, t.AssigneeName)).OrderBy(g => g.Key.AssigneeUserId))
                {
                    var done = grp.Count(t => t.Status == EditorTaskStatus.Done);
                    var late = grp.Count(Tasks.IsOverdue);
                    <div class="choice">
                        <h4>@grp.Key.AssigneeUserId@(string.IsNullOrWhiteSpace(grp.Key.AssigneeName) ? "" : $" — {grp.Key.AssigneeName}")</h4>
                        <p class="muted">@string.Format(L["AdminTasks_DoneCount"], done, grp.Count())@(late > 0 ? string.Format(L["AdminTasks_LateCount"], late) : "")</p>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<EditorTask>? _tasks;
    private IReadOnlyDictionary<(ReleaseTargetType Type, string Key), EditorTaskLink> _links =
        new Dictionary<(ReleaseTargetType, string), EditorTaskLink>();
    private IReadOnlyList<StaffRosterEntry>? _members;
    private IReadOnlyList<DocumentSummary> _docs = Array.Empty<DocumentSummary>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private bool _busy;
    private string? _status, _error;

    private string _title = "", _desc = "", _due = "", _docKey = "";
    private int _assignee;
    private EditorTaskPriority _priority = EditorTaskPriority.Normal;

    // Le due condizioni che il service pretende, lette qui per spegnere il tasto invece di far sbagliare
    // e poi spiegare. ⚠️ Non sostituiscono la guardia: la porta non può essere più larga della serratura.
    private bool PuoCreare => !string.IsNullOrWhiteSpace(_title) && _assignee > 0;

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        _currentCycle = Tasks.CurrentCycle();
        _upcoming = Tasks.UpcomingCycles(14);
        _members = await Roster.ListActiveAsync();
        _docs = await Editing.ListDocumentsAsync();
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _tasks = await Tasks.ListAllAsync();
            // Una risoluzione per CARICAMENTO, non una per riga (regola 136).
            _links = await TaskLinks.ForAsync(_tasks);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    /// <summary>Dove porta il documento collegato, se c'è ancora un posto dove andare.</summary>
    private EditorTaskLink? Link(EditorTask t) =>
        t.TargetType is { } tipo && !string.IsNullOrWhiteSpace(t.TargetKey)
            && _links.TryGetValue((tipo, t.TargetKey!), out var l) ? l : null;

    private async Task Create()
    {
        _busy = true; _status = _error = null;
        try
        {
            var (type, key, label) = ParseDocKey(_docKey);
            var name = _members?.FirstOrDefault(m => m.UserId == _assignee)?.DisplayName;
            var input = new EditorTaskInput(_title, string.IsNullOrWhiteSpace(_desc) ? null : _desc,
                _assignee, name, _priority, string.IsNullOrWhiteSpace(_due) ? null : _due, type, key, label);
            await Tasks.CreateAsync(input);
            _title = ""; _desc = ""; _due = ""; _docKey = ""; _assignee = 0;
            await Load();
            _status = L["AdminTasks_CreatedMsg"];
        }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ServiceErrorNarrator.Testo(ex, L); }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetStatus(int id, string? s)
    {
        if (s is null || !Enum.TryParse<EditorTaskStatus>(s, out var status)) return;
        _busy = true; _status = _error = null;
        try { await Tasks.UpdateStatusAsync(id, status); await Load(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete(int id)
    {
        _busy = true; _status = _error = null;
        try { await Tasks.DeleteAsync(id); await Load(); _status = L["AdminTasks_DeletedMsg"]; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // Chiave documento per il picker: "{type}:{key}" con etichetta ricavata dal DocumentSummary.
    private static string DocKey(DocumentSummary d)
    {
        if (d.Type == DocumentType.Vloa) return $"Vloa:{d.Id}";
        if (d.IsAirport) return $"Airport:{d.Scope}";
        if (d.IsStandaloneApp) return $"App:{d.Scope}";
        return $"AccVipi:{(d.AccCode ?? d.Scope)}|";   // ACC vIPI: root primario (vuoto)
    }

    private (ReleaseTargetType?, string?, string?) ParseDocKey(string dk)
    {
        if (string.IsNullOrWhiteSpace(dk)) return (null, null, null);
        var idx = dk.IndexOf(':');
        if (idx < 0) return (null, null, null);
        var type = Enum.Parse<ReleaseTargetType>(dk[..idx]);
        var key = dk[(idx + 1)..];
        var label = _docs.FirstOrDefault(d => DocKey(d) == dk) is { } d ? $"{d.Type} · {d.Title}" : key;
        return (type, key, label);
    }

    private string ColLabel(EditorTaskStatus s) => s switch
    {
        EditorTaskStatus.Todo => L["TaskStatus_Todo"], EditorTaskStatus.InProgress => L["TaskStatus_InProgress"],
        EditorTaskStatus.InReview => L["TaskStatus_InReview"], EditorTaskStatus.Done => L["TaskStatus_Done"],
        EditorTaskStatus.Blocked => L["TaskStatus_Blocked"], _ => s.ToString(),
    };

    private string PrioLabel(EditorTaskPriority p) => p switch
    {
        EditorTaskPriority.Low => L["TaskPrio_Low"], EditorTaskPriority.Normal => L["TaskPrio_Normal"], EditorTaskPriority.High => L["TaskPrio_High"], _ => p.ToString(),
    };

    private static string PrioPill(EditorTaskPriority p) => p switch
    {
        EditorTaskPriority.High => "future", EditorTaskPriority.Normal => "blue", _ => "grey",
    };
}
