@page "/services/vsop/{Acc}/vloa"
@layout SopLayout
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject IVipiViewService ViewService
@inject IReleaseService Releases
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject IDocumentAdminService Docs
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Translation.DocumentTranslator Translator
@using Vipi.Ui.Shared
@using System.Globalization
@using Vipi.Application.Content

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_foreign.Length > 0)
{
    @* ---- documento singolo: /services/vsop/{acc}/vloa?acc=<vicino> ---- *@
    @if (_view is null)
    {
        <div class="wrap">
            <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/vloa">@L["Vloa_Title"]</a> › <b>—</b></div>
            @* Stesse stringhe già localizzate del vecchio viewer vLOA su AppnPage (rotta rimossa, doc 11 §3f). *@
            <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["Appn_VloaNotAvailTitle"]</p>@((MarkupString)string.Format(L["Appn_VloaNotAvailBody"], $"{_acc.Code} ↔ {_foreign}"))</div></div>
        </div>
    }
    else
    {
        <PageTitle>@PreviewTitlePrefix()@_view.Title · IVAO Italia</PageTitle>
        <div class="wrap">
            <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()/vloa">@L["Vloa_Title"]</a> › <b>@_view.Title</b></div>
            @if (_mode.IsPreview)
            {
                <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                               PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vloa?acc={_foreign}")"
                               DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vloa?acc={_foreign}&as=draft")" />
            }
            <AudienceChip Visibile="_haMarcate" Vista="_vista"
                          BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/vloa?acc={_foreign}")" />
            <TranslationNotice Coverage="_copertura" />
            <VloaDocumentView View="_view" DocId="_viewDocId" UseFrozen="_useFrozen" IsDraft="@(_mode.Kind == PreviewKind.Draft)"
                              ReleaseId="@(_mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null)"
                              Subtitle="@_viewSubtitle" HomeAcc="@_acc.Code" ForeignAcc="@_foreign" />
        </div>
    }
}
else
{
    @* ---- elenco vLOA della ACC ---- *@
    <PageTitle>@L["Vloa_Title"] @_acc.Code · vIPI IVAO Italia</PageTitle>
    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@L["Vloa_Title"]</b></div>
        <div class="doc-head">
            <div><h1 class="page-h1" style="margin-bottom:2px">@L["Vloa_Title"] — @_acc.Name - @_acc.Code</h1></div>
        </div>
        @if (_visibleVloas.Count == 0)
        {
            <EmptyState Title="@L["Vloa_EmptyTitle"]">@L["Vloa_EmptyBody"]</EmptyState>
        }
        else
        {
            var homeOnline = HomeOnline();
            @foreach (var g in _visibleVloas.GroupBy(v => Prefix(v.NeighbourCode)).OrderBy(g => Country(g.Key)))
            {
                <div class="section-title" style="margin-top:22px"><h2 class="h-sect">@Country(g.Key)</h2><span class="ln"></span></div>
                <div class="choice-grid">
                    @foreach (var v in g)
                    {
                        var neigh = v.NeighbourCode ?? v.Title;
                        var neighOnline = NeighOnline(v.NeighbourCode);
                        <a class="choice apt-card" href="/services/vsop/@Acc.ToLowerInvariant()/vloa?acc=@v.NeighbourCode">
                            <div class="apt-top">
                                <h3 class="h-card">@neigh</h3>
                                <span class="country-tag">@g.Key</span>
                            </div>
                            <p class="muted">@(v.Neighbour ?? L["Vloa_BilateralDefault"].Value)</p>
                            <div class="vloa-online">
                                <span class="onl-badge @(homeOnline > 0 ? "on" : "off")"><span class="dot"></span> @_acc.Code@(homeOnline > 0 ? $" · {homeOnline}" : "")</span>
                                <span class="onl-badge @(neighOnline > 0 ? "on" : "off")"><span class="dot"></span> @neigh@(neighOnline > 0 ? $" · {neighOnline}" : "")</span>
                            </div>
                        </a>
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "acc")] public string? Neighbour { get; set; }
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero (carta vSOP §3).</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    private AccInfo? _acc;
    private string _foreign = "";
    private DocumentView? _view;
    private int? _viewDocId;
    private string? _viewSubtitle;
    private bool _useFrozen;   // vista pubblica vLOA: derivate frozen dalla release effettiva (doc 10 §3d)
    private Vipi.Application.Translation.TranslationCoverage _copertura =
        Vipi.Application.Translation.TranslationCoverage.Nessuna;
    private Vipi.Domain.SectionAudience? _vista;
    private bool _haMarcate;
    private PreviewMode _mode;
    private string? _relCycle;
    private IReadOnlyList<VloaRow> _vloas = Array.Empty<VloaRow>();          // tutte (per la risoluzione doc: preview/draft editor)
    private IReadOnlyList<VloaRow> _visibleVloas = Array.Empty<VloaRow>();   // solo pubblicate e non nascoste (elenco pubblico)

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        // Scalda le cache prima del render: HomeOnline() usa ResolveByCallsign senza query durante il render
        // (evita "second operation" sul DbContext condiviso su Postgres).
        Stations.Prewarm();

        var data = await Structure.LoadAsync(_acc.Code);
        _vloas = data?.Vloas.OrderBy(v => v.FeaturedRank ?? int.MaxValue).ThenBy(v => v.Title).ToList()
            ?? (IReadOnlyList<VloaRow>)Array.Empty<VloaRow>();

        // Elenco pubblico: solo vLOA con release AIRAC effettiva e non nascoste (stessa regola di aeroporti/APP, doc 10 §3f).
        var publishedVloas = (await Docs.ListAsync())
            .Where(m => m.Kind == ReleaseTargetType.Vloa && m.HasEffectiveRelease && !m.IsHidden && m.DocumentId is not null)
            .Select(m => m.DocumentId!.Value)
            .ToHashSet();
        _visibleVloas = _vloas.Where(v => publishedVloas.Contains(v.DocId)).ToList();

        _foreign = (Neighbour ?? "").Trim().ToUpperInvariant();
        _view = null; _viewDocId = null; _viewSubtitle = null;
        if (_foreign.Length == 0) return;

        // Risolve il documento per coppia (Home ACC dalla route + vicino dal ?acc=).
        var row = _vloas.FirstOrDefault(v => string.Equals(v.NeighbourCode, _foreign, StringComparison.OrdinalIgnoreCase));
        if (row is not null)
        {
            _mode = PreviewMode.Parse(As);
            _relCycle = null;
            _useFrozen = false;
            switch (_mode.Kind)
            {
                case PreviewKind.Draft:
                    if (await Authz.CanEditAccAsync(_acc.Code))
                        _view = await ViewService.BuildVloaByIdAsync(row.DocId, BlockTier.Extended, live: false, ignoreRelease: true, preferWorking: true);
                    else { _mode = default; await LoadPublicAsync(row.DocId); }
                    break;
                case PreviewKind.Release:
                    var pv = await Releases.GetPreviewAsync(_mode.ReleaseId, ReleaseTargetType.Vloa, row.DocId.ToString());
                    if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                    else { _mode = default; await LoadPublicAsync(row.DocId); }
                    break;
                default:
                    await LoadPublicAsync(row.DocId);
                    break;
            }
            // ---- Lettura bilingue (carta 2026-08-27 §7) --------------------------------------------
            // ⚠️ La lingua di lettura e' quella dell'INTERFACCIA, non un secondo selettore: un documento
            // inglese dentro una pagina italiana e' una schermata mezza tradotta. La sceglie la chip della
            // barra, che scrive il cookie di cultura -- ed e' l'unico modo perche' la scelta sopravviva al
            // circuito, che su /_blazor non porta ?culture=.
            //
            // ⚠️ La vLOA nasce in INGLESE: per lei l'italiano e' il BERSAGLIO, non la sorgente — il verso
            // opposto a quello delle vIPI. Ma la lingua la dice il DOCUMENTO, non questa pagina: «en» resta
            // solo come lingua di nascita della famiglia, per gli snapshot salvati prima che il campo
            // esistesse. Cablarla qui vorrebbe dire tradurre una vLOA redatta in italiano come se fosse
            // inglese, e far mancare la memoria su ogni frase senza che si capisca perche'.
            _copertura = Vipi.Application.Translation.TranslationCoverage.Nessuna;
            if (_view is not null)
            {
                var lettore = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
                var tradotto = await Translator.TranslateAsync(_view, Vipi.Domain.Language.En, lettore);
                _view = tradotto.View;
                _copertura = tradotto.Coverage;
            }

            // ---- Filtro pilota / ATC (carta vSOP militari §3) ---------------------------------------
            // ⚠️ DOPO la traduzione, non prima: si filtra la vista che il lettore vedra' davvero, e la
            // marcatura viaggia sulla sezione, quindi sopravvive alla traduzione intatta.
            _vista = AudienceFilter.Leggi(Vista);
            _haMarcate = false;
            if (_view is not null)
            {
                _haMarcate = AudienceFilter.HaSezioniMarcate(_view.Sections);
                var filtrate = AudienceFilter.Filtra(_view.Sections, _vista);
                if (!ReferenceEquals(filtrate, _view.Sections))
                    _view = new DocumentView
                    {
                        Title = _view.Title, AiracCycle = _view.AiracCycle, Sections = filtrate,
                        Language = _view.Language, Translations = _view.Translations,
                    };
            }

            _viewDocId = row.DocId;
            _viewSubtitle = $"{_acc.Name} ↔ {row.Neighbour ?? _foreign}";
        }
    }

    // Vista PUBBLICA (doc 11 §3d): documento + derivate frozen si impostano INSIEME, così il degrado di
    // un'anteprima non autorizzata/non corrispondente produce esattamente la pubblica (prima restava _useFrozen=false
    // → derivate LIVE al pubblico). DocId ⇒ AoR/Frequenze/Coordinamenti derivati (data-driven): senza, si vedrebbero
    // i blocchi statici salvati, stesso documento e resa diversa.
    private async Task LoadPublicAsync(int docId)
    {
        _view = await ViewService.BuildVloaByIdAsync(docId, BlockTier.Extended, live: false);
        _useFrozen = true;
    }

    // ATC online dell'ACC nazionale (home): stessa regola della home /services/vsop (include gli aeroporti sotto l'ACC).
    private int HomeOnline()
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs => Stations.ResolveByCallsign(cs)?.Code.Equals(_acc!.Code, StringComparison.OrdinalIgnoreCase) == true);
    }

    // ATC online dell'ACC confinante (estero): callsign la cui testa (prima del "_") è il codice ICAO dell'ACC vicino.
    private int NeighOnline(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return 0;
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs => cs.Split('_', 2)[0].Equals(code, StringComparison.OrdinalIgnoreCase));
    }

    private string PreviewTitlePrefix() => _mode.Kind switch
    {
        PreviewKind.Draft => $"{L["Common_DraftTag"]} ",
        PreviewKind.Release => $"{L["Common_PreviewTag"]} ",
        _ => "",
    };

    private static string Prefix(string? code) => code is { Length: >= 2 } ? code[..2].ToUpperInvariant() : "??";

    // Paese dal prefisso ICAO dell'ACC confinante (per raggruppamento + tag), dalle risorse: i nomi dei paesi
    // cambiano con la lingua della pagina. Prefisso senza traduzione = si mostra il prefisso stesso.
    //
    // Si chiede al localizzatore se la chiave esiste (ResourceNotFound) invece di tenere qui una lista dei
    // prefissi noti. Quella lista era una seconda copia dei nomi paese che stanno nel .resx, e le due
    // potevano scollarsi in un modo silenzioso e a senso unico: aggiungere un paese SOLO nelle risorse dava
    // una pagina che mostra «LB» invece di «Libano», senza che niente lo segnalasse.
    private string Country(string prefix)
    {
        var tradotto = L["Country_" + prefix];
        return tradotto.ResourceNotFound ? prefix : tradotto.Value;
    }
}
