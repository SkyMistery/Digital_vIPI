@page "/vsop/screens"
@layout SopLayout

<PageTitle>Tutte le schermate · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/vsop">Home</a> › <b>Tutte le schermate</b></div>
    <div class="doc-head"><div><h2 style="margin-bottom:2px">Tutte le schermate</h2><span class="muted">Indice di navigazione — tutte le pagine del mockup v2 implementate</span></div></div>

    @foreach (var g in Groups)
    {
        <div class="section-title"><h3>@g.Title</h3><span class="ln"></span></div>
        <div class="choice-grid">
            @foreach (var (label, href) in g.Links)
            {
                <a class="choice" href="@href" style="text-decoration:none;color:inherit"><h4 style="font-size:1rem">@label</h4><p class="muted" style="font-size:12px;margin:0">@href</p></a>
            }
        </div>
    }
</div>

@code {
    private record Grp(string Title, (string Label, string Href)[] Links);

    private static readonly Grp[] Groups =
    {
        new("Navigazione", new[]
        {
            ("🏠 Home (4 ACC)", "/vsop"),
            ("📂 Landing ACC — Roma", "/vsop/lirr"),
        }),
        new("Consultazione", new[]
        {
            ("📘 vIPI ACC — Estesa", "/vsop/lirr/vipi"),
            ("🛫 Aeroporti (elenco)", "/vsop/lirr/airports"),
            ("🛫 vIPI Aeroporto (LIRF)", "/vsop/lirr/airports?icao=LIRF"),
            ("📡 APP non remotizzati (elenco)", "/vsop/lirr/apps"),
            ("📡 APP non remotizzato (Pisa)", "/vsop/lirr/apps/vipi?app=LIRP_APP"),
        }),
        new("Pagine", new[]
        {
            ("🆕 Cosa è cambiato", "/vsop/changed"),
            ("🔎 Ricerca full-text", "/vsop/search"),
        }),
        new("Admin / Editor (Staff)", new[]
        {
            ("✏️ Editor vIPI", "/vsop/lirr/editor"),
            ("🔄 Trasferimenti", "/vsop/admin/trasferimenti"),
            ("🤝 Editor vLOA", "/vsop/lirr/vloa/editor"),
            ("🗂️ Bozze & versioni", "/vsop/versioni"),
        }),
    };
}
