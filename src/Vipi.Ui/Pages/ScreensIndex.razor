@page "/sop/screens"
@layout SopLayout

<PageTitle>Tutte le schermate · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/sop">Home</a> › <b>Tutte le schermate</b></div>
    <div class="doc-head"><div><h2 style="margin-bottom:2px">Tutte le schermate</h2><span class="muted">Indice di navigazione — tutte le pagine del mockup v2 implementate</span></div></div>

    @foreach (var g in Groups)
    {
        <div class="section-title"><h3>@g.Title</h3><span class="ln"></span></div>
        <div class="choice-grid">
            @foreach (var (label, href) in g.Links)
            {
                <a class="choice" href="@href" style="text-decoration:none;color:inherit"><h4 style="font-size:1rem">@label</h4><p class="muted" style="font-size:12px;margin:0">@href</p></a>
            }
        </div>
    }
</div>

@code {
    private record Grp(string Title, (string Label, string Href)[] Links);

    private static readonly Grp[] Groups =
    {
        new("Navigazione", new[]
        {
            ("🏠 Home (4 ACC)", "/sop"),
            ("📂 Landing ACC — Roma", "/sop/lirr"),
        }),
        new("Consultazione", new[]
        {
            ("📘 vIPI ACC — Estesa", "/sop/lirr/vipi"),
            ("⚡ Vista ridotta (live)", "/sop/lirr/ridotta"),
            ("🛫 vIPI Aeroporto (LIRF)", "/sop/lirr/aeroporto"),
            ("📡 APP non remotizzato (Pisa)", "/sop/lirr/app"),
            ("🌍 vLOA estera (DTTC)", "/sop/lirr/vloa"),
            ("⚡ Ridotta APP", "/sop/lirr/ridotta-app"),
            ("🧊 AoR 3D", "/sop/lirr/aor3d"),
            ("📄 Export PDF", "/sop/lirr/export"),
        }),
        new("Pagine", new[]
        {
            ("🆕 Cosa è cambiato", "/sop/changed"),
            ("🔎 Ricerca full-text", "/sop/search"),
            ("🚦 Stati & messaggi", "/sop/stati"),
        }),
        new("Admin / Editor (CH/AOD)", new[]
        {
            ("✏️ Editor vIPI", "/sop/lirr/editor"),
            ("🧭 Topologia settori", "/sop/lirr/topologia"),
            ("🔄 Editor trasferimenti", "/sop/lirr/editor-trasferimenti"),
            ("🤝 Editor vLOA", "/sop/lirr/editor-vloa"),
            ("🗂️ Bozze & versioni", "/sop/versioni"),
        }),
    };
}
