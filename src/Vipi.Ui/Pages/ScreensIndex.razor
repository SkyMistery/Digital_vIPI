@page "/services/vsop/screens"
@layout SopLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Home_ScreensTitle"] · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <b>@L["Home_ScreensTitle"]</b></div>
    <div class="doc-head"><div><h1 class="page-h1" style="margin-bottom:2px">@L["Home_ScreensTitle"]</h1><span class="muted">@L["Screens_Subtitle"]</span></div></div>

    @foreach (var g in Groups)
    {
        <div class="section-title"><h2 class="h-sect">@g.Title</h2><span class="ln"></span></div>
        <div class="choice-grid">
            @foreach (var (label, href) in g.Links)
            {
                <a class="choice" href="@href"><h3 class="h-card" style="font-size:1rem">@label</h3><p class="muted" style="font-size:12px;margin:0">@href</p></a>
            }
        </div>
    }
</div>

@code {
    private record Grp(string Title, (string Label, string Href)[] Links);

    private static readonly Grp[] Groups =
    {
        new("Navigazione", new[]
        {
            ("🏠 Home (4 ACC)", "/services/vsop"),
            ("📂 Landing ACC — Roma", "/services/vsop/lirr"),
        }),
        new("Consultazione", new[]
        {
            ("📘 vIPI ACC — Estesa", "/services/vsop/lirr/vipi"),
            ("🛫 Aeroporti (elenco)", "/services/vsop/lirr/airports"),
            ("🛫 vIPI Aeroporto (LIRF)", "/services/vsop/lirr/airports?icao=LIRF"),
            ("📡 APP non remotizzati (elenco)", "/services/vsop/lirr/apps"),
            ("📡 APP non remotizzato (Pisa)", "/services/vsop/lirr/apps/vipi?app=LIRP_APP"),
        }),
        new("Pagine", new[]
        {
            ("🆕 Cosa è cambiato", "/services/vsop/changed"),
            ("🔎 Ricerca full-text", "/services/vsop/search"),
        }),
        new("Admin / Editor (Staff)", new[]
        {
            ("✏️ Editor vIPI", "/services/vsop/lirr/editor"),
            ("🔄 Trasferimenti", "/services/vsop/admin/transfers"),
            ("🤝 Editor vLOA", "/services/vsop/lirr/vloa/editor"),
            ("🗂️ Bozze & versioni", "/services/vsop/versions"),
        }),
    };
}
