@* Guida in-app bilingue (IT/EN): come si consulta e come si modifica vIPI/vLOA. Contenuto statico (static SSR):
   usa CollapsibleBlock (<details> nativo) → nessun circuito, cercabile con Ctrl+F, ancore deep-link.
   La lingua è scelta dal parametro di query ?lang=it|en (toggle in cima); default = cultura corrente del browser.
   Contenuto DATA-DRIVEN (liste _consult/_modify): un'unica sorgente per corpo pagina e indice. *@
@page "/vsop/guida"
@layout SopLayout
@using System.Globalization

<PageTitle>@T("Guida","Guide") · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1000px">
    <div class="breadcrumb"><a href="/vsop">Home</a> › <b>@T("Guida","Guide")</b></div>
    <div class="doc-head">
        <div>
            <h2 style="margin-bottom:2px"><Icon Name="book-open" /> @T("Guida a vIPI / vLOA","vIPI / vLOA Guide")</h2>
            <span class="muted">@T("Come consultare le procedure e come usare gli strumenti di modifica","How to consult the procedures and how to use the editing tools")</span>
        </div>
        <div class="apt-quick" style="margin:0" role="group" aria-label="@T("Lingua","Language")">
            <a class="ch @(_en ? "" : "on")" href="/vsop/guida?lang=it">IT</a>
            <a class="ch @(_en ? "on" : "")" href="/vsop/guida?lang=en">EN</a>
        </div>
    </div>
    <p class="guida-lead">@T("Questa pagina è il riferimento completo. Dentro l'app trovi anche piccoli","This page is the complete reference. Inside the app you'll also find small")
        <Icon Name="help-circle" Size="14" /> @T("accanto ai controlli: cliccali per un aiuto al volo che rimanda qui. Usa","next to the controls: click them for quick help that links back here. Use")
        <code>Ctrl+F</code> @T("per cercare.","to search.")</p>

    @* ── Indice (derivato dalle stesse liste) ──────────────────────────────── *@
    <nav class="guida-toc" aria-label="@T("Indice guida","Guide index")">
        <h3>@T("Consultare","Reading")</h3>
        @foreach (var s in _consult)
        {
            <a href="#@s.Anchor">@T(s.TitleIt, s.TitleEn)</a>
        }
        <h3>@T("Modificare","Editing")</h3>
        @foreach (var s in _modify)
        {
            <a href="#@s.Anchor">@T(s.TitleIt, s.TitleEn)</a>
        }
    </nav>

    @* ══════════════════════ PARTE 1 · CONSULTARE ══════════════════════ *@
    <div class="guida-part"><Icon Name="eye" Size="14" /> @T("Consultare","Reading") <span class="ln"></span></div>
    @foreach (var s in _consult)
    {
        <CollapsibleBlock Id="@s.Anchor" ExtraClass="guida-sec">
            <Header><Icon Name="@s.Icon" /> &nbsp;@T(s.TitleIt, s.TitleEn)</Header>
            <ChildContent>@((MarkupString)T(s.BodyIt, s.BodyEn))</ChildContent>
        </CollapsibleBlock>
    }

    @* ══════════════════════ PARTE 2 · MODIFICARE ══════════════════════ *@
    <div class="guida-part"><Icon Name="pencil" Size="14" /> @T("Modificare","Editing") <span class="ln"></span></div>
    @foreach (var s in _modify)
    {
        <CollapsibleBlock Id="@s.Anchor" ExtraClass="guida-sec">
            <Header><Icon Name="@s.Icon" /> &nbsp;@T(s.TitleIt, s.TitleEn)</Header>
            <ChildContent>@((MarkupString)T(s.BodyIt, s.BodyEn))</ChildContent>
        </CollapsibleBlock>
    }

    <p class="muted" style="margin:22px 0 40px;font-size:13px">
        @T("Manca qualcosa o qualcosa non torna? Segnalalo allo staff così aggiorniamo questa guida.",
           "Missing something or something wrong? Let the staff know so we can update this guide.")
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "lang")] public string? Lang { get; set; }

    private bool _en;

    protected override void OnParametersSet()
    {
        // Esplicito ?lang= vince; altrimenti segue la cultura negoziata (browser Accept-Language / cookie).
        _en = Lang is not null
            ? Lang.Equals("en", StringComparison.OrdinalIgnoreCase)
            : CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);
    }

    private string T(string it, string en) => _en ? en : it;

    // Sezione localizzata: ancora, icona, titolo (it/en) e corpo HTML (it/en). Corpi senza attributi con virgolette
    // così restano stringhe verbatim leggibili; niente <Icon> nel corpo (usa unicode) perché sono MarkupString.
    private sealed record Sec(string Anchor, string Icon, string TitleIt, string TitleEn, string BodyIt, string BodyEn);

    private static readonly List<Sec> _consult = new()
    {
        new Sec("nav", "map", "Navigare tra le pagine", "Navigating the pages",
            @"<p>Tutto vive sotto <code>/vsop</code>. La barra in alto ha i codici <b>ACC</b> (LIRR, LIMM, …),
               la ricerca e, se sei ATC/staff, i tasti Editor e Incarichi.</p>
              <ul>
                <li><b>Home</b> (<code>/vsop</code>) → card degli ACC con quanti controllori sono online.</li>
                <li><b>Landing ACC</b> (<code>/vsop/{acc}</code>) → il <b>vIPI di ACC</b>, gli <b>aeroporti</b>,
                    gli <b>APP non remotizzati</b> e le <b>vLOA</b> in evidenza.</li>
                <li>Da lì apri il documento specifico: vIPI ACC, vIPI aeroporto (con le SID), APP, o vLOA verso un vicino.</li>
              </ul>",
            @"<p>Everything lives under <code>/vsop</code>. The top bar has the <b>ACC</b> codes (LIRR, LIMM, …),
               search and, if you are ATC/staff, the Editor and Tasks buttons.</p>
              <ul>
                <li><b>Home</b> (<code>/vsop</code>) → ACC cards with how many controllers are online.</li>
                <li><b>ACC landing</b> (<code>/vsop/{acc}</code>) → the <b>ACC vIPI</b>, the <b>airports</b>,
                    the <b>non-remoted APPs</b> and the featured <b>vLOAs</b>.</li>
                <li>From there open the specific document: ACC vIPI, airport vIPI (with SIDs), APP, or a vLOA to a neighbour.</li>
              </ul>"),

        new Sec("ricerca", "search", "Cercare", "Searching",
            @"<p>La barra di ricerca in alto (o <code>/vsop/search</code>) è full-text: cerca <b>CoP, FIX, callsign,
               frequenze</b> e testo dei documenti. Servono almeno 2 caratteri. I filtri (chip) restringono l'ambito;
               ogni risultato porta al punto esatto del documento. Anche le sezioni di questa Guida compaiono nei risultati.</p>",
            @"<p>The search bar at the top (or <code>/vsop/search</code>) is full-text: it searches <b>CoPs, FIXes,
               callsigns, frequencies</b> and document text. At least 2 characters are needed. The chips narrow the scope;
               each result jumps to the exact point in the document. Sections of this Guide appear in the results too.</p>"),

        new Sec("live", "radio", "Stato live e ATC online", "Live status and online ATC",
            @"<p>Il badge in alto a destra mostra se sei <b>connesso</b> come ATC (col tuo callsign) o disconnesso.
               Le card ACC in Home contano i controllori online. Alcune viste (Coordinamenti/Trasferimenti) risolvono
               <b>in tempo reale</b> chi è collegato, risalendo la gerarchia dei settori fino a UNICOM.</p>",
            @"<p>The badge at the top right shows whether you are <b>connected</b> as ATC (with your callsign) or offline.
               The ACC cards on Home count online controllers. Some views (Coordinations/Transfers) resolve
               <b>in real time</b> who is connected, climbing the sector hierarchy up to UNICOM.</p>"),

        new Sec("changed", "activity", "Cosa è cambiato", "What changed",
            @"<p><code>/vsop/changed</code> elenca i documenti <b>nuovi</b> o <b>aggiornati</b> nel ciclo AIRAC corrente,
               con quante sezioni/blocchi sono cambiati e chi ha pubblicato. Filtra per ACC. È il primo posto da
               guardare quando entra in vigore un nuovo ciclo.</p>",
            @"<p><code>/vsop/changed</code> lists the <b>new</b> or <b>updated</b> documents in the current AIRAC cycle,
               with how many sections/blocks changed and who published. Filter by ACC. It's the first place to
               check when a new cycle comes into effect.</p>"),

        new Sec("anteprime", "file", "Anteprime e badge bozza", "Previews and draft badge",
            @"<p>Ogni documento può essere visto in tre modi, controllati dal parametro <code>?as=</code> nell'URL:</p>
              <ul>
                <li><b>Pubblica</b> (default, nessun parametro): quello che vede tutti — la release in vigore, o il live se non c'è release.</li>
                <li><b>Bozza</b> (<code>?as=draft</code>): le modifiche non ancora pubblicate. Solo per chi può modificare quell'ACC.</li>
                <li><b>Release congelata</b> (<code>?as=rel:{id}</code>): lo snapshot esatto di una pubblicazione passata.</li>
              </ul>
              <p>Una fascia colorata in cima segnala quando <b>non</b> stai vedendo la versione pubblica. Se non sei
               autorizzato, la vista <b>degrada a pubblica</b> senza rivelare la bozza.</p>",
            @"<p>Every document can be viewed in three ways, controlled by the <code>?as=</code> URL parameter:</p>
              <ul>
                <li><b>Public</b> (default, no parameter): what everyone sees — the effective release, or the live version if there's no release.</li>
                <li><b>Draft</b> (<code>?as=draft</code>): changes not yet published. Only for who can edit that ACC.</li>
                <li><b>Frozen release</b> (<code>?as=rel:{id}</code>): the exact snapshot of a past publication.</li>
              </ul>
              <p>A coloured banner at the top flags when you are <b>not</b> looking at the public version. If you are
               not authorized, the view <b>degrades to public</b> without revealing the draft.</p>"),
    };

    private static readonly List<Sec> _modify = new()
    {
        new Sec("editor-accesso", "key", "Chi può modificare e da dove", "Who can edit and from where",
            @"<p>Puoi modificare se sei <b>admin</b> o hai un <b>permesso (grant)</b> su un ACC. In quel caso in alto
               a destra compaiono due tasti:</p>
              <ul>
                <li><b>Editor</b> → <code>/vsop/versioni</code>, l'<b>hub documenti</b>: elenco di tutti i documenti
                    (vIPI ACC/APP, aeroporti, vLOA) con ricerca/filtri, «Apri editor» per riga, «Nuovo documento»,
                    storico versioni e release.</li>
                <li><b>Incarichi</b> → <code>/vsop/tasks</code>, i lavori assegnati a te.</li>
              </ul>
              <p>Puoi anche aprire l'editor direttamente dal documento che stai guardando, col tasto <b>✎ Editor</b>
               (compare solo se sei autorizzato su quell'ACC).</p>
              <p class=""muted"">Al <b>primo accesso</b> a un editor parte un breve <b>tour guidato</b> che indica i
               comandi principali (indice, salva, anteprima, pubblica). Per rivederlo, aggiungi <code>?tour=1</code>
               all'URL dell'editor.</p>",
            @"<p>You can edit if you are an <b>admin</b> or hold a <b>grant</b> on an ACC. In that case two buttons
               appear at the top right:</p>
              <ul>
                <li><b>Editor</b> → <code>/vsop/versioni</code>, the <b>documents hub</b>: a list of all documents
                    (ACC/APP vIPI, airports, vLOA) with search/filters, ""Open editor"" per row, ""New document"",
                    version history and releases.</li>
                <li><b>Tasks</b> → <code>/vsop/tasks</code>, the jobs assigned to you.</li>
              </ul>
              <p>You can also open the editor straight from the document you're viewing, with the <b>✎ Editor</b> button
               (it appears only if you are authorized on that ACC).</p>
              <p class=""muted"">On your <b>first visit</b> to an editor a short <b>guided tour</b> starts, pointing out
               the main controls (index, save, preview, publish). To see it again, add <code>?tour=1</code>
               to the editor URL.</p>"),

        new Sec("editor-lock", "key", "Prendere in carico (lock)", "Taking the lock",
            @"<p>Per evitare che due persone si sovrascrivano, alcune pagine si aprono in <b>sola lettura</b> finché
               non premi <b>«Inizia modifica»</b> nella barra in alto. Da quel momento il documento è tuo:</p>
              <ul>
                <li>Un <b>heartbeat</b> ogni 60 s tiene vivo il lock; se chiudi la scheda si libera da solo.</li>
                <li>Se resti inattivo, scade dopo ~3 minuti.</li>
                <li>Chi arriva dopo vede «in modifica da …»; un admin può <b>«Forzare lo sblocco»</b>.</li>
              </ul>
              <p>Finito, premi <b>«Fine modifica»</b> per liberarlo subito. Le pagine di struttura admin condividono
               un unico lock (una persona alla volta).</p>",
            @"<p>To keep two people from overwriting each other, some pages open <b>read-only</b> until you press
               <b>""Start editing""</b> in the top bar. From then on the document is yours:</p>
              <ul>
                <li>A <b>heartbeat</b> every 60 s keeps the lock alive; closing the tab releases it by itself.</li>
                <li>If you stay idle, it expires after ~3 minutes.</li>
                <li>Whoever comes later sees ""being edited by …""; an admin can <b>""Force unlock""</b>.</li>
              </ul>
              <p>When done, press <b>""Finish editing""</b> to release it right away. The admin structure pages share
               a single lock (one person at a time).</p>"),

        new Sec("editor-documento", "file", "Editor documento: sezioni e blocchi", "Document editor: sections and blocks",
            @"<p>Un documento è fatto di <b>sezioni</b> (i capitoli) che contengono <b>blocchi</b> (i contenuti).
               Nell'editor puoi:</p>
              <ul>
                <li><b>Aggiungere</b> una sezione o un blocco (＋).</li>
                <li><b>Riordinare</b> con le frecce ↑ / ↓ (o trascinando, dove supportato).</li>
                <li><b>Rinominare</b> il titolo e <b>eliminare</b> (🗑).</li>
                <li><b>Comprimere</b> le sezioni cliccando l'intestazione: lo stato resta memorizzato.</li>
              </ul>
              <p>Le sezioni <b>derivate</b> (frequenze, AOR, coordinamenti) si compilano da sole dai dati di sorgente:
               le vedi ma non le editi a mano.</p>",
            @"<p>A document is made of <b>sections</b> (the chapters) that contain <b>blocks</b> (the content).
               In the editor you can:</p>
              <ul>
                <li><b>Add</b> a section or a block (＋).</li>
                <li><b>Reorder</b> with the ↑ / ↓ arrows (or by dragging, where supported).</li>
                <li><b>Rename</b> the title and <b>delete</b> (🗑).</li>
                <li><b>Collapse</b> sections by clicking the header: the state is remembered.</li>
              </ul>
              <p><b>Derived</b> sections (frequencies, AOR, coordinations) fill themselves from source data:
               you see them but don't edit them by hand.</p>"),

        new Sec("editor-blocchi", "grid", "I tipi di blocco", "Block types",
            @"<p>Ogni blocco ha un tipo, scelto quando lo aggiungi:</p>
              <ul>
                <li><b>Prosa</b> — testo libero (paragrafi, elenchi).</li>
                <li><b>Tabella</b> — righe/colonne, per limiti, frequenze, quote.</li>
                <li><b>Callout / Tip</b> — riquadro evidenziato (nota, attenzione, suggerimento).</li>
                <li><b>Immagine</b> — una foto o uno schema: scegli il file dal dispositivo <b>oppure trascinalo</b>
                    sull'area tratteggiata. Aggiungi il <b>testo alternativo</b> (descrive l'immagine a chi non la
                    vede e finisce nella ricerca) e, se serve, una <b>didascalia</b>. Formati ammessi PNG, JPEG,
                    WebP e GIF; le foto grandi vengono rimpicciolite dal browser prima di partire, e oltre il limite
                    indicato sotto l'area il caricamento viene rifiutato.</li>
                <li><b>Separazioni</b> — regole di separazione formattate.</li>
                <li><b>Mappa AOR / Area</b> — porzione di spazio aereo resa graficamente.</li>
              </ul>
              <p>Scrivi contenuti brevi e verificabili: un lettore in frequenza deve trovare la risposta a colpo d'occhio.</p>",
            @"<p>Each block has a type, chosen when you add it:</p>
              <ul>
                <li><b>Prose</b> — free text (paragraphs, lists).</li>
                <li><b>Table</b> — rows/columns, for limits, frequencies, altitudes.</li>
                <li><b>Callout / Tip</b> — a highlighted box (note, warning, tip).</li>
                <li><b>Image</b> — a photo or diagram: pick the file from your device <b>or drag it</b> onto the
                    dashed area. Add the <b>alternative text</b> (it describes the image to those who can't see it
                    and feeds the search) and, if useful, a <b>caption</b>. PNG, JPEG, WebP and GIF are accepted;
                    large photos are shrunk by the browser before upload, and anything above the limit shown under
                    the area is rejected.</li>
                <li><b>Separations</b> — formatted separation rules.</li>
                <li><b>AOR / Area map</b> — a portion of airspace rendered graphically.</li>
              </ul>
              <p>Write short, verifiable content: a reader on frequency must find the answer at a glance.</p>"),

        new Sec("editor-minime", "layers", "Minime di vettoramento", "Minimum vectoring altitudes",
            @"<p>La sezione <b>Minime di vettoramento</b> si compila <b>a mano</b>, come qualsiasi altra sezione
               editoriale: aggiungi prosa, tabelle o immagini delle carte.</p>
              <p>Non arrivano dall'import e non arriveranno: nel sectorfile la struttura dei file MVA <b>non dice a
               quale settore appartenga</b> ciascuna area, e attribuire una minima al settore sbagliato è peggio che
               non averla — è un dato operativo che qualcuno userebbe. L'associazione la dichiara una persona.</p>",
            @"<p>The <b>Minimum vectoring altitudes</b> section is filled in <b>by hand</b>, like any other editorial
               section: add prose, tables or images of the charts.</p>
              <p>They are not imported and will not be: in the sectorfile the MVA files <b>do not say which sector</b>
               each area belongs to, and assigning a minimum to the wrong sector is worse than not having it — it is
               operational data someone would act on. A person declares the association.</p>"),

        new Sec("editor-salva", "check-circle", "Indice laterale e salvataggio", "Side index and saving",
            @"<p>L'<b>indice laterale</b> (TOC) elenca le sezioni: cliccane una per saltarci. Un pallino segnala le
               sezioni con <b>modifiche non salvate</b>.</p>
              <p>Salva con <b>«Salva tutto»</b>: scrive le modifiche nella <b>bozza</b>, non ancora al pubblico
               (anche con <code>Ctrl+S</code>). Il pubblico vedrà i cambiamenti solo dopo la <b>pubblicazione</b>.</p>",
            @"<p>The <b>side index</b> (TOC) lists the sections: click one to jump to it. A dot marks the sections with
               <b>unsaved changes</b>.</p>
              <p>Save with <b>""Save all""</b>: it writes the changes to the <b>draft</b>, not yet to the public
               (also with <code>Ctrl+S</code>). The public sees the changes only after <b>publishing</b>.</p>"),

        new Sec("editor-anteprima", "eye", "Vedere la bozza in anteprima", "Preview the draft",
            @"<p>Il tasto <b>«Anteprima»</b> apre il documento come <code>?as=draft</code>: vedi la bozza esattamente
               come apparirà, con una fascia che ricorda che <b>non</b> è ancora pubblica. Controlla sempre qui prima
               di pubblicare.</p>",
            @"<p>The <b>""Preview""</b> button opens the document as <code>?as=draft</code>: you see the draft exactly
               as it will look, with a banner reminding you it is <b>not</b> public yet. Always check here before
               publishing.</p>"),

        new Sec("editor-release", "megaphone", "Pubblicare (release AIRAC)", "Publishing (AIRAC release)",
            @"<p>La bozza diventa pubblica con una <b>release</b>, legata a un ciclo <b>AIRAC</b>. Nel pannello release:</p>
              <ul>
                <li><b>Pubblica ora</b> — la bozza corrente entra in vigore <b>subito</b>.</li>
                <li><b>Programma al ciclo</b> — scegli un AIRAC futuro: la release entra in vigore <b>alla data</b> di quel ciclo.</li>
              </ul>
              <p>Ogni release è uno <b>snapshot congelato</b>: resta consultabile anche dopo. Aggiungi una <b>nota</b>
               per spiegare cosa cambia (comparirà in «Cosa è cambiato»). Gli admin possono vedere le <b>differenze</b>
               e <b>annullare</b> una release.</p>
              <p><b>Regola pratica:</b> salva → anteprima bozza → pubblica. Non pubblicare senza aver guardato l'anteprima.</p>",
            @"<p>The draft goes public with a <b>release</b>, tied to an <b>AIRAC</b> cycle. In the release panel:</p>
              <ul>
                <li><b>Publish now</b> — the current draft takes effect <b>immediately</b>.</li>
                <li><b>Schedule at cycle</b> — pick a future AIRAC: the release takes effect <b>on the date</b> of that cycle.</li>
              </ul>
              <p>Each release is a <b>frozen snapshot</b>: it stays consultable afterwards. Add a <b>note</b>
               to explain what changes (it shows up in ""What changed""). Admins can see the <b>differences</b>
               and <b>cancel</b> a release.</p>
              <p><b>Rule of thumb:</b> save → preview draft → publish. Don't publish without checking the preview.</p>"),

        new Sec("editor-aeroporto", "building", "Editor aeroporto (SID, frequenze, piste)", "Airport editor (SIDs, frequencies, runways)",
            @"<p>Apre il profilo dell'aeroporto: dati generali, sezioni a blocchi condivise, più le parti specifiche.</p>
              <ul>
                <li><b>Piste</b> — importate da IVAO per singolo aeroporto; le regole pista/area guidano le condizioni
                    di trasferimento.</li>
                <li><b>Frequenze</b> — sezione derivata dai settori ATC dell'aeroporto.</li>
                <li><b>SID</b> — importate da Aurora al primo prelievo del ciclo AIRAC; i fix aggiunti a mano vengono
                    riportati. L'import è bloccato per-ICAO durante l'operazione.</li>
                <li><b>Settori ATC</b> — mostra/nascondi i settori importati e imposta i limiti.</li>
              </ul>
              <p>La tabella delle <b>SID importate</b> è il posto dove si lavora di più, e ha regole sue:</p>
              <ul>
                <li>Le celle si modificano una dietro l'altra: la riga toccata diventa <b>gialla</b> e il contatore
                    <b>«N modificate»</b> sale. Si conferma tutto insieme con <b>Salva modificate</b>.</li>
                <li>La <b>scelta</b> (colonna di sinistra, riga blu) è un'altra cosa: serve a <b>Pubblica scelte</b>.
                    Si sceglie col clic, con Shift o Ctrl+clic per un intervallo, trascinando, oppure con
                    <b>Invio</b> o <b>Spazio</b> da tastiera.</li>
                <li>I chip filtrano: <b>da verificare</b> mostra le SID il cui punto va confermato a mano, i chip
                    <b>pista</b> lasciano solo quella pista. Il numero accanto al titolo dice quante ne stai vedendo
                    sul totale.</li>
                <li><b>Larghezza piena</b> (⤢) nasconde indice e rail: su una tabella a dodici colonne è la
                    differenza fra vederle tutte e scorrere di lato.</li>
                <li>I chip <b>Cat.</b> e <b>WTC</b> si accendono a scala: un <b>doppio clic</b> (o <b>Shift+clic</b>,
                    che funziona anche da tastiera) accende anche tutti quelli prima — una procedura per cat. E
                    vale anche per le più piccole. Rifatto sullo stesso chip, li spegne.</li>
                <li><b>Doppio clic su SID, RWY, Type</b> sceglie tutte le righe con lo <b>stesso punto</b>; sul
                    <b>Trans.</b> tutte quelle con la <b>stessa transition</b> (nelle SID manuali il gesto sta
                    sulla casella di scelta). Rifatto, le lascia. Gli stessi due gesti sono anche tasti nella
                    barra, e agiscono sulla riga del campo toccato per ultimo.</li>
                <li><b>Applica alle scelte</b> (⤓, o <b>Ctrl+Invio</b> dentro la cella) copia il valore della
                    cella toccata per ultimo in tutte le righe scelte: quota (col suo APP), Cat., WTC, condizione
                    o priorità. Non copia mai punto, nome, pista e transition: sono l'identità della riga. Le
                    righe restano <b>modificate</b> finché non salvi, quindi un errore si annulla ricaricando.</li>
                <li>Il <b>ri-prelievo</b> rifà la tabella dalla sorgente: se hai righe modificate e non salvate, te
                    lo dice prima di scartarle.</li>
              </ul>
              <p>Come per gli altri, salvi nella bozza e pubblichi col pannello release.</p>",
            @"<p>Opens the airport profile: general data, shared block sections, plus the specific parts.</p>
              <ul>
                <li><b>Runways</b> — imported from IVAO per single airport; the runway/area rules drive the transfer
                    conditions.</li>
                <li><b>Frequencies</b> — a section derived from the airport's ATC sectors.</li>
                <li><b>SIDs</b> — imported from Aurora on the first fetch of the AIRAC cycle; manually added fixes are
                    carried over. The import is locked per-ICAO during the operation.</li>
                <li><b>ATC sectors</b> — show/hide the imported sectors and set the limits.</li>
              </ul>
              <p>The <b>imported SIDs</b> table is where most of the work happens, and it has its own rules:</p>
              <ul>
                <li>You edit cell after cell: a touched row turns <b>yellow</b> and the <b>""N changed""</b> counter
                    goes up. You confirm them all at once with <b>Save changed</b>.</li>
                <li><b>Picking</b> (left column, blue row) is a different thing: it feeds <b>Publish picked</b>.
                    You pick with a click, Shift or Ctrl+click for a range, by dragging, or with <b>Enter</b> or
                    <b>Space</b> from the keyboard.</li>
                <li>The chips filter: <b>to verify</b> shows the SIDs whose point must be confirmed by hand, the
                    <b>runway</b> chips leave only that runway. The number next to the title says how many you are
                    seeing out of the total.</li>
                <li><b>Full width</b> (⤢) hides the index and the rail: on a twelve-column table that is the
                    difference between seeing them all and scrolling sideways.</li>
                <li>The <b>Cat.</b> and <b>WTC</b> chips light up as a scale: a <b>double click</b> (or
                    <b>Shift+click</b>, which works from the keyboard too) also turns on every chip before it —
                    a procedure for cat. E applies to the smaller ones as well. Done again on the same chip, it
                    turns them off.</li>
                <li><b>Double click on SID, RWY, Type</b> picks every row with the <b>same point</b>; on
                    <b>Trans.</b> every row with the <b>same transition</b> (in the manual SIDs the gesture lives
                    on the pick cell). Done again, it unpicks them. Both gestures are also buttons in the bar,
                    acting on the row of the last cell you touched.</li>
                <li><b>Apply to picked</b> (⤓, or <b>Ctrl+Enter</b> inside the cell) copies the value of the last
                    cell you touched into every picked row: altitude (with its APP), Cat., WTC, condition or
                    priority. It never copies point, name, runway or transition: those are the row's identity.
                    The rows stay <b>changed</b> until you save, so a mistake is undone by reloading.</li>
                <li>The <b>re-import</b> rebuilds the table from the source: if you have changed and unsaved rows,
                    it tells you before discarding them.</li>
              </ul>
              <p>As with the others, you save to the draft and publish with the release panel.</p>"),

        new Sec("editor-app", "radio", "Editor APP non remotizzato", "Non-remoted APP editor",
            @"<p>Per gli APP che non sono remotizzati esiste un editor dedicato (<code>/vsop/{acc}/apps/editor</code>),
               con 6 sezioni fisse — <b>Separazioni · AOR · Frequenze · VFR · Minime · Coordinamenti</b> — più sezioni
               personalizzate. Frequenze, coordinamenti e AOR sono <b>derivati live</b>. Riordini e nascondi le sezioni;
               i documenti APP vengono instradati qui automaticamente.</p>",
            @"<p>For APPs that are not remoted there is a dedicated editor (<code>/vsop/{acc}/apps/editor</code>),
               with 6 fixed sections — <b>Separations · AOR · Frequencies · VFR · Minima · Coordinations</b> — plus
               custom sections. Frequencies, coordinations and AOR are <b>derived live</b>. You reorder and hide the
               sections; APP documents are routed here automatically.</p>"),

        new Sec("editor-vloa", "globe", "Editor vLOA", "vLOA editor",
            @"<p>Una vLOA è l'accordo tra un ACC <b>italiano</b> e un <b>vicino estero</b> (es. Roma ↔ Marsiglia).
               L'editor (<code>/vsop/{acc}/vloa/editor?acc=YYYY</code>) apre la <b>coppia</b>; senza <code>?acc=</code>
               mostra un elenco da cui sceglierla. I <b>Coordinamenti</b> includono anche i <b>sorvoli senza aeroporto</b>
               e i punti di trasferimento (CoP).</p>",
            @"<p>A vLOA is the agreement between an <b>Italian</b> ACC and a <b>foreign neighbour</b> (e.g. Rome ↔ Marseille).
               The editor (<code>/vsop/{acc}/vloa/editor?acc=YYYY</code>) opens the <b>pair</b>; without <code>?acc=</code>
               it shows a list to pick from. The <b>Coordinations</b> also include <b>overflights with no airport</b>
               and the transfer points (CoP).</p>"),

        new Sec("editor-acc", "map", "Editor vIPI ACC", "ACC vIPI editor",
            @"<p>L'editor del vIPI di ACC (<code>/vsop/{acc}/editor</code>) è fatto di <b>blocchi</b>: i
               <b>settori di aerovia</b> e un blocco per ogni <b>gruppo APP</b>. Ogni blocco copre il suo albero di
               settori, anche cross-ACC.</p>
              <ul>
                <li><b>Un blocco per volta.</b> Il titolo del blocco è la maniglia: si apre e si chiude, e aprendone
                    uno gli altri si chiudono. Accanto al nome, quante sezioni contiene.</li>
                <li><b>Le sezioni si aprono e si chiudono</b> una per una; «Espandi tutto / Comprimi tutto» in fondo
                    all'indice agisce su blocchi e sezioni insieme.</li>
                <li><b>Si salva a ogni gesto</b>, nella <b>bozza</b>: il pubblico vede solo dopo «Pubblica ora».
                    Lo stato del documento e il lock stanno nella riga del titolo.</li>
                <li><b>⤢ Larghezza piena</b> toglie indice e rail quando serve spazio alle tabelle.</li>
              </ul>",
            @"<p>The ACC vIPI editor (<code>/vsop/{acc}/editor</code>) is made of <b>blocks</b>: the
               <b>airway sectors</b> and one block per <b>APP group</b>. Each block covers its own sector tree, even
               across ACCs.</p>
              <ul>
                <li><b>One block at a time.</b> The block title is the handle: it opens and closes, and opening one
                    closes the others. Next to the name, how many sections it holds.</li>
                <li><b>Sections open and close</b> one by one; «Expand all / Collapse all» at the bottom of the index
                    acts on blocks and sections together.</li>
                <li><b>Every gesture is saved</b>, in the <b>draft</b>: the public only sees it after «Publish now».
                    Document status and lock live in the title row.</li>
                <li><b>⤢ Full width</b> hides index and rail when the tables need the room.</li>
              </ul>"),

        new Sec("editor-frequenze", "radio", "Frequenze (derivate)", "Frequencies (derived)",
            @"<p>Le frequenze <b>si derivano dall'albero dei settori</b>: cambia la gerarchia in «Struttura» e
               cambiano qui. Nell'editor puoi <b>riordinarle</b> trascinando ⠿ o con ↑/↓, e <b>collegare</b> la
               frequenza di un altro ente (resta un riferimento vivo: se cambia là, cambia qui).</p>",
            @"<p>Frequencies are <b>derived from the sector tree</b>: change the hierarchy in «Structure» and they
               change here. In the editor you can <b>reorder</b> them by dragging ⠿ or with ↑/↓, and <b>link</b>
               another unit's frequency (it stays a live reference: if it changes there, it changes here).</p>"),

        new Sec("editor-configurazioni", "grid", "Configurazioni di settore", "Sector configurations",
            @"<p>Una <b>configurazione</b> è un assetto di apertura: le dai un nome e scegli quali settori sono
               <b>aperti</b>. Il sistema calcola l'<b>accorpamento</b> — chi assorbe chi — e la tabella che ne esce è
               quella che si legge nel documento. Center Point e Range si impostano per settore unificato.</p>",
            @"<p>A <b>configuration</b> is an opening layout: you name it and choose which sectors are <b>open</b>.
               The system computes the <b>merging</b> — who absorbs whom — and the resulting table is the one read in
               the document. Center Point and Range are set per unified sector.</p>"),

        new Sec("editor-aor", "map", "AOR: shape extra e colori", "AOR: extra shapes and colours",
            @"<p>La mappa AOR mostra gli anelli dei settori del blocco. Puoi <b>aggiungere shape di altri enti</b>
               presi dal database (anche esteri o torri): compaiono come anelli accendibili e sono selezionabili
               nelle configurazioni. Il <b>colore</b> è per tipo di ente (le torri in rosso, ecc.) e si può cambiare
               per singolo settore; «default» rimette quello del tipo.</p>",
            @"<p>The AOR map shows the rings of the block's sectors. You can <b>add shapes of other units</b> taken
               from the database (foreign ones or towers too): they appear as toggleable rings and can be selected in
               the configurations. The <b>colour</b> comes from the unit type (towers in red, and so on) and can be
               changed per sector; «default» restores the type's colour.</p>"),

        new Sec("accordi", "refresh", "Accordi di coordinamento", "Coordination agreements",
            @"<p>Un <b>accordo</b> lega <b>due elenchi di enti</b> per un tipo di traffico, su <b>tutti gli
               aeroporti</b> elencati. Dentro ci sono le <b>clausole</b>: ognuna dice su quali <b>punti</b> vale,
               a quale quota, dove avviene il trasferimento e a quali condizioni.</p>
              <ul>
                <li><b>Un accordo, non un flusso per aeroporto.</b> Gli arrivi su Fiumicino, Ciampino, Urbe e
                    Pratica con lo stesso punto e la stessa quota sono <i>un</i> accordo con quattro aeroporti.
                    Nel documento la riga porta la colonna «Anche per», che lo dice.</li>
                <li><b>Una clausola, non una riga per punto.</b> «EKMUR, PISIP» si scrive in una clausola sola:
                    il documento la rende come due righe, ma tu ne scrivi una.</li>
                <li><b>I due versi si vedono sempre entrambi</b>, uno sotto l'altro — «noi &#8594; loro» prima,
                    «loro &#8594; noi» dopo — come nelle LoA vere, che di tabelle ne hanno due. Un verso vuoto resta
                    a vista: dice che il reciproco non è ancora scritto. Il tasto «copia dall'altro verso» dà un
                    <i>punto di partenza</i>: le quote vanno riviste, quasi mai coincidono.</li>
                <li><b>Un accordo ha due capi, ed entrambi sono obbligatori.</b> Se il traffico deve finire a
                    UNICOM non c'è niente da scrivere: lo fa la vista operativa quando nessuno è online. Gli
                    <b>aeroporti</b> si aggiungono e si tolgono direttamente dalla testata dell'accordo, e il
                    campo compare dove serve — arrivi e partenze ne pretendono almeno uno, i sorvoli no.</li>
                <li><b>L'elenco a sinistra è per ACC controparte, poi per relazione</b> (<i>noi ⇄ loro</i>): sotto
                    ogni coppia di enti stanno i suoi accordi, distinti dal <b>gruppo di aeroporti</b> e dal tipo
                    di traffico. Due righe identiche sotto la stessa coppia sono la stessa cosa scritta due
                    volte, e il cruscotto le chiama «relazione spezzata».</li>
                <li><b>«Noi» e «loro» dipendono dalla ACC che hai aperto</b>, non da come l'accordo è stato scritto:
                    lo stesso accordo di confine si legge dai due capi, e si modifica da entrambi. Se un punto sta
                    in un verso e non nell'altro, un avviso sopra le tabelle te lo dice.</li>
                <li><b>Le varianti</b> restano un elenco rientrato: alternative pari-grado (pista 07 · pista 25)
                    ed eccezioni annidate. Muovendo una riga si muove tutto il suo rientro.</li>
              </ul>
              <p><b>Per riempire in fretta:</b> il picker del lato che riceve <b>propone</b> gli enti probabili
                 col loro perché; «Incolla tabella» legge una tabella copiata da una LoA o da un IPI e te la fa
                 rileggere riga per riga prima di scrivere; <b>«Lacune»</b> dice dove lavorare — a partire dagli
                 accordi che mandano traffico a UNICOM e dai confini scritti in un verso solo.</p>
              <p>La prosa sopra ogni tabella si sceglie per sezione: <b>distesa</b> (una frase per clausola) o
                 <b>capofila</b> (una frase che introduce la tabella, come nelle LoA vere).</p>",
            @"<p>An <b>agreement</b> binds <b>two lists of units</b> for one kind of traffic, over <b>every
               airport</b> listed. Inside are the <b>clauses</b>: each says which <b>points</b> it applies to, at
               what level, where the transfer happens and under which conditions.</p>
              <ul>
                <li><b>One agreement, not one flow per airport.</b> Arrivals into Fiumicino, Ciampino, Urbe and
                    Pratica over the same point at the same level are <i>one</i> agreement with four airports.
                    In the document the row carries an «Also for» column that says so.</li>
                <li><b>One clause, not one row per point.</b> «EKMUR, PISIP» is a single clause: the document
                    renders it as two rows, but you write one.</li>
                <li><b>Both directions are always visible</b>, one below the other — «us &#8594; them» first,
                    «them &#8594; us» after — as in real LoAs, which have two tables. An empty direction stays in
                    view: it says the reciprocal is not written yet. «Copy from the other direction» gives you a
                    <i>starting point</i>: the levels must be reviewed, they hardly ever match.</li>
                <li><b>An agreement has two ends, and both are required.</b> If the traffic must end up on
                    UNICOM there is nothing to write: the operational view does that when nobody is online.
                    <b>Airports</b> are added and removed straight from the agreement header, and the field shows
                    where it matters — arrivals and departures need at least one, overflights don't.</li>
                <li><b>The list on the left is by counterpart ACC, then by relation</b> (<i>us ⇄ them</i>): under
                    each pair of units sit its agreements, told apart by <b>airport group</b> and kind of traffic.
                    Two identical rows under the same pair are the same thing written twice, and the dashboard
                    calls that a «relation split».</li>
                <li><b>«Us» and «them» depend on the ACC you opened</b>, not on how the agreement was written: the
                    same border agreement reads from both ends, and can be edited from either. If a point is in one
                    direction and not the other, a warning above the tables tells you.</li>
                <li><b>Variants</b> are still an indented list: same-rank alternatives (runway 07 · runway 25)
                    and nested exceptions. Moving a row moves everything indented under it.</li>
              </ul>
              <p><b>To fill in quickly:</b> the receiving-side picker <b>suggests</b> the likely units with the
                 reason why; «Paste table» reads a table copied from a LoA or an IPI and makes you review it row
                 by row before writing; <b>«Gaps»</b> tells you where to work — starting from agreements that
                 send traffic to UNICOM and borders written one way only.</p>
              <p>The prose above each table is chosen per section: <b>spread</b> (one sentence per clause) or
                 <b>lead</b> (one sentence introducing the table, as in real LoAs).</p>"),

        new Sec("struttura", "link", "Struttura: la gerarchia di copertura", "Structure: the coverage hierarchy",
            @"<p>La pagina <b>Struttura</b> (<code>/vsop/admin/sectorstructure</code>) tiene l'<b>albero di fallback
               unico</b> di tutta la divisione, anche fra ACC diversi: <b>Aeroporto → APP → settore ACC</b>.
               L'aeroporto è la <b>foglia</b> (DEL/GND/TWR condividono la sua vista rapida): quando un ente è
               chiuso, la vista live risale questa catena fino al primo online, altrimenti UNICOM.</p>
              <p>Qui si imposta <b>soltanto il padre</b> di ogni nodo — il fallback immediato. Settori e
               aeroporti si <b>importano</b> dalle loro pagine (<code>/admin/acc</code>,
               <code>/admin/airports</code>): quello che si vede qui è la proiezione dei cataloghi.</p>
              <ul>
                <li>Il padre si cambia in due modi: <b>trascinando</b> un nodo su un altro, oppure dal pannello
                    di <b>dettaglio</b> a destra (elenco dei padri ammessi, poi <b>Applica</b>).</li>
                <li>Chi non ha padre scritto eredita dalla <b>scaletta d'aeroporto</b> (DEL → GND → TWR → APP) ed
                    è marcato <b>«ereditato»</b>: assegnarne uno lo fissa.</li>
                <li>Il chip <b>«da agganciare»</b> conta aeroporti e APP senza padre risolvibile e, cliccato,
                    mostra solo quelli. A zero resta lì, spento.</li>
                <li>Torri, ground e delivery sono spenti di default (sono ~110 nodi su ~250): si accendono col
                    chip <b>Posizioni aeroporto</b>.</li>
              </ul>
              <p>Il <b>lock</b> è quello condiviso delle pagine di struttura: una persona alla volta, Accordi di
               coordinamento compresi.</p>",
            @"<p>The <b>Structure</b> page (<code>/vsop/admin/sectorstructure</code>) holds the <b>single fallback
               tree</b> for the whole division, across ACCs too: <b>Airport → APP → ACC sector</b>. The airport is
               the <b>leaf</b> (DEL/GND/TWR share its quick view): when a unit is closed, the live view climbs this
               chain up to the first online one, otherwise UNICOM.</p>
              <p>Here you set <b>only the parent</b> of each node — the immediate fallback. Sectors and airports are
               <b>imported</b> from their own pages (<code>/admin/acc</code>, <code>/admin/airports</code>): what you
               see here is the projection of those catalogues.</p>
              <ul>
                <li>The parent changes in two ways: <b>drag</b> a node onto another, or use the <b>detail</b> panel
                    on the right (list of eligible parents, then <b>Apply</b>).</li>
                <li>Nodes with no parent set inherit from the <b>airport ladder</b> (DEL → GND → TWR → APP) and are
                    marked <b>""inherited""</b>: assigning one pins it.</li>
                <li>The <b>""to attach""</b> chip counts airports and APPs with no resolvable parent and, when
                    clicked, shows only those. At zero it stays put, switched off.</li>
                <li>Towers, ground and delivery are off by default (~110 nodes out of ~250): the <b>Airport
                    positions</b> chip turns them on.</li>
              </ul>
              <p>The <b>lock</b> is the shared one of the structure pages: one person at a time, coordination
               agreements included.</p>"),

        new Sec("admin-aeroporti", "plane-takeoff", "Aeroporti: assegnazione alle ACC", "Airports: assignment to ACCs",
            @"<p>La pagina <b>Aeroporti</b> (<code>/vsop/admin/airports</code>) decide la <b>ACC di competenza</b>
               di ogni aeroporto: da lì discendono la gerarchia di settori, il documento e la pagina pubblica.
               A sinistra gli aeroporti già assegnati, a destra l'<b>anagrafica IVAO</b> da cui si pescano.</p>
              <ul>
                <li><b>Auto-assegna</b> crea in un colpo gli aeroporti la cui ACC di competenza è già nel DB e
                    ne importa i settori dalla sorgente. È il primo gesto su un database nuovo.</li>
                <li>Per gli altri: spunta le righe nell'anagrafica, scegli la ACC nella barra e premi
                    <b>Assegna selezionati</b>. L'anagrafica mostra i <b>non assegnati</b>; il chip
                    «già assegnati» riporta gli altri, in verde e non selezionabili.</li>
                <li><b>Re-importa tutti</b> ripreleva piste e Transition Altitude per tutti gli assegnati:
                    sono decine di chiamate in fila, l'<b>avanzamento</b> si vede in testata e si può
                    <b>interrompere</b>. Rispetta la policy di <code>/vsop/admin/sorgenti</code>.</li>
                <li>Le azioni di gruppo (sposta, genera documenti, elimina, assegna) lavorano sulle righe
                    spuntate, proseguono oltre i fallimenti e lasciano <b>selezionato chi è fallito</b>: quello
                    che resta nel contatore è quello che non è passato.</li>
                <li>I chip <b>nascosti</b>, <b>no settori</b> e <b>no TWR</b> filtrano l'elenco: sono lo stato
                    che altrimenti si legge solo scorrendo. A zero restano lì, spenti.</li>
                <li>Un aeroporto <b>senza settori</b> resta nascosto al pubblico finché non genera i documenti;
                    l'occhio barrato di ogni riga lo nasconde o lo mostra a mano.</li>
              </ul>
              <p>Il <b>lock</b> è quello condiviso delle pagine di struttura: una persona alla volta.</p>",
            @"<p>The <b>Airports</b> page (<code>/vsop/admin/airports</code>) decides each airport's
               <b>owning ACC</b>: the sector hierarchy, the document and the public page follow from it.
               On the left the already assigned airports, on the right the <b>IVAO directory</b> to pick from.</p>
              <ul>
                <li><b>Auto-assign</b> creates in one go the airports whose owning ACC is already in the DB and
                    imports their sectors from the source. It is the first move on a fresh database.</li>
                <li>For the others: tick the rows in the directory, pick the ACC in the bar and press
                    <b>Assign selected</b>. The directory shows the <b>unassigned</b> ones; the
                    ""already assigned"" chip brings the others back, in green and not selectable.</li>
                <li><b>Re-import all</b> re-fetches runways and Transition Altitude for every assigned airport:
                    dozens of calls in a row, <b>progress</b> is shown in the header and can be <b>stopped</b>.
                    It respects the <code>/vsop/admin/sorgenti</code> policy.</li>
                <li>Group actions (move, generate documents, delete, assign) work on the ticked rows, carry on
                    past failures and leave <b>whatever failed still selected</b>: what stays in the counter is
                    what did not go through.</li>
                <li>The <b>hidden</b>, <b>no sectors</b> and <b>no TWR</b> chips filter the list: they are the
                    state you would otherwise only find by scrolling. At zero they stay put, switched off.</li>
                <li>An airport <b>with no sectors</b> stays hidden from the public until it generates its
                    documents; the crossed-out eye on each row hides or shows it by hand.</li>
              </ul>
              <p>The <b>lock</b> is the shared one of the structure pages: one person at a time.</p>"),

        new Sec("admin-confinanti", "globe", "Confinanti: coppie e vLOA", "Neighbours: pairs and vLOAs",
            @"<p>La pagina <b>Confinanti</b> (<code>/vsop/admin/confinanti</code>) tiene le <b>coppie</b>
               ACC italiano ↔ ACC estero da cui nascono le <b>vLOA</b>. I paesi da cui pescare stanno in
               <code>Neighbours:CountryIds</code>; confinano i settori la cui distanza minima fra i bordi sta
               sotto <code>AdjacencyThresholdNm</code>. Le coppie non confinanti non vengono salvate.</p>
              <ul>
                <li><b>Import &amp; calcola</b> scarica gli ACC dei paesi vicini e ricalcola l'adiacenza: è
                    il primo gesto: crea le coppie <b>da valutare</b>.</li>
                <li>Scegliendo una <b>riga</b> il pannello di destra mostra la coppia. <b>Verifica
                    adiacenza</b> ricalcola i settori confinanti riscaricandoli dalla sorgente — è lenta e si
                    può <b>interrompere</b> — e disegna le due aree sulla mappa.</li>
                <li><b>Conferma</b> la coppia quando il confine è reale, poi <b>Genera vLOA</b>: nasce il
                    documento con Home = ACC italiano (editabile) e Neighbour = estero (sola lettura).</li>
                <li>Una coppia <b>rifiutata</b> resta in elenco, spenta: è la memoria di un falso positivo
                    già valutato.</li>
                <li><b>Aggiungi settore</b> (solo su coppie confermate) materializza a mano un settore estero
                    verificandolo sulla sorgente: compare fra i settori dell'ACC estero e nei picker dei
                    coordinamenti.</li>
                <li><b>Poligono</b> è il rimedio quando la sorgente non dà la shape dell'ACC estero: senza,
                    la coppia non ha mappa né adiacenza calcolabile.</li>
                <li><b>Coppia a mano</b> serve quando IVAO non fornisce affatto l'ACC estero.</li>
              </ul>
              <p>Il <b>lock</b> è quello condiviso delle pagine di struttura: una persona alla volta.</p>",
            @"<p>The <b>Neighbours</b> page (<code>/vsop/admin/confinanti</code>) holds the <b>pairs</b>
               Italian ACC ↔ foreign ACC the <b>vLOAs</b> are born from. The countries to draw from live in
               <code>Neighbours:CountryIds</code>; sectors are neighbours when the minimum distance between
               their edges is below <code>AdjacencyThresholdNm</code>. Non-adjacent pairs are not saved.</p>
              <ul>
                <li><b>Import &amp; compute</b> fetches the ACCs of the neighbouring countries and recomputes
                    adjacency: it is the first move, and it creates the <b>pending</b> pairs.</li>
                <li>Picking a <b>row</b> shows the pair in the right-hand panel. <b>Verify adjacency</b>
                    recomputes the bordering sectors by re-fetching them from the source — it is slow and can
                    be <b>stopped</b> — and draws both areas on the map.</li>
                <li><b>Confirm</b> the pair when the border is real, then <b>Generate vLOA</b>: the document
                    is created with Home = the Italian ACC (editable) and Neighbour = foreign (read-only).</li>
                <li>A <b>rejected</b> pair stays in the list, dimmed: it is the memory of a false positive
                    that has already been assessed.</li>
                <li><b>Add sector</b> (on confirmed pairs only) materialises a foreign sector by hand after
                    checking it against the source: it then shows up among the foreign ACC's sectors and in
                    the coordination pickers.</li>
                <li><b>Polygon</b> is the remedy when the source has no shape for the foreign ACC: without
                    one the pair has neither a map nor computable adjacency.</li>
                <li><b>Pair by hand</b> is for when IVAO does not provide the foreign ACC at all.</li>
              </ul>
              <p>The <b>lock</b> is the shared one of the structure pages: one person at a time.</p>"),

        new Sec("admin", "grid", "Aree admin", "Admin areas",
            @"<p>Solo per gli admin, sotto <code>/vsop/admin</code>:</p>
