@* Guida in-app bilingue (IT/EN): come si consulta e come si modifica vIPI/vLOA. Contenuto statico (static SSR):
   usa CollapsibleBlock (<details> nativo) → nessun circuito, cercabile con Ctrl+F, ancore deep-link.
   La lingua è scelta dal parametro di query ?lang=it|en (toggle in cima); default = cultura corrente del browser.
   Contenuto DATA-DRIVEN (liste _consult/_modify): un'unica sorgente per corpo pagina e indice. *@
@page "/services/vsop/guide"
@layout SopLayout
@inject NavigationManager Nav
@using System.Globalization

<PageTitle>@T("Guida","Guide") · vIPI IVAO Italy</PageTitle>

<div class="wrap" style="max-width:1000px">
    @* ⚠️ La briciola è in INGLESE anche qui, come in tutto il sito (regole-lingua R3): scriveva
       @T("Guida","Guide") e seguiva la lingua della pagina — l'unica del sito a farlo. *@
    <div class="breadcrumb"><a href="/services/vsop">Home</a> › <b>Guide</b></div>
    <div class="doc-head">
        <div>
            <h1 class="page-h1" style="margin-bottom:2px"><Icon Name="book-open" /> @T("Guida a vIPI / vLOA","vIPI / vLOA Guide")</h1>
            <span class="muted">@T("Come consultare le procedure e come usare gli strumenti di modifica","How to consult the procedures and how to use the editing tools")</span>
        </div>
    </div>
    <p class="guida-lead">@T("Questa pagina è il riferimento completo. Dentro l'app trovi anche piccoli","This page is the complete reference. Inside the app you'll also find small")
        <Icon Name="help-circle" Size="14" /> @T("accanto ai controlli: cliccali per un aiuto al volo che rimanda qui. Usa","next to the controls: click them for quick help that links back here. Use")
        <code>Ctrl+F</code> @T("per cercare.","to search.")</p>

    @* ── Indice (derivato dalle stesse liste) ──────────────────────────────── *@
    <nav class="guida-toc" aria-label="@T("Indice guida","Guide index")">
        <h2 class="h-sect">@T("Consultare","Reading")</h2>
        @foreach (var s in _consult)
        {
            <a href="#@s.Anchor">@Titolo(s)</a>
        }
        <h2 class="h-sect">@T("Modificare","Editing")</h2>
        @foreach (var s in _modify)
        {
            <a href="#@s.Anchor">@Titolo(s)</a>
        }
    </nav>

    @* ══════════════════════ PARTE 1 · CONSULTARE ══════════════════════ *@
    <div class="guida-part"><Icon Name="eye" Size="14" /> @T("Consultare","Reading") <span class="ln"></span></div>
    @foreach (var s in _consult)
    {
        <CollapsibleBlock Id="@s.Anchor" ExtraClass="guida-sec">
            <Header><Icon Name="@s.Icon" /> &nbsp;@Titolo(s)</Header>
            <ChildContent>@((MarkupString)T(s.BodyIt, s.BodyEn))</ChildContent>
        </CollapsibleBlock>
    }

    @* ══════════════════════ PARTE 2 · MODIFICARE ══════════════════════ *@
    <div class="guida-part"><Icon Name="pencil" Size="14" /> @T("Modificare","Editing") <span class="ln"></span></div>
    @foreach (var s in _modify)
    {
        <CollapsibleBlock Id="@s.Anchor" ExtraClass="guida-sec">
            <Header><Icon Name="@s.Icon" /> &nbsp;@Titolo(s)</Header>
            <ChildContent>@((MarkupString)T(s.BodyIt, s.BodyEn))</ChildContent>
        </CollapsibleBlock>
    }

    <p class="muted" style="margin:22px 0 40px;font-size:13px">
        @T("Manca qualcosa o qualcosa non torna? Segnalalo allo staff così aggiorniamo questa guida.",
           "Missing something or something wrong? Let the staff know so we can update this guide.")
    </p>
</div>

@code {
    /// <summary>
    /// Vecchio modo di chiedere la lingua a QUESTA pagina, tenuto per i collegamenti già in giro.
    /// <para>⚠️ Non decide più niente: rimanda a <c>?culture=</c>, che è il selettore di TUTTA
    /// l'applicazione (docs/design/regole-lingua.md). Fino al 28 agosto 2026 la Guida aveva la sua chip
    /// IT/EN accanto al titolo, e con quella del selettore in barra facevano due comandi sulla stessa
    /// schermata che dicevano cose diverse: <c>?lang=</c> cambiava questa pagina e non scriveva il cookie,
    /// quindi bastava andare altrove per ritrovare l'altra lingua.</para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "lang")] public string? Lang { get; set; }

    private bool _en;

    protected override void OnParametersSet()
    {
        // ⚠️ Il vecchio `?lang=` non si limita a essere ignorato: REINDIRIZZA. Onorarlo qui e basta darebbe
        // la Guida in inglese dentro un'interfaccia italiana — la schermata mezza tradotta che questa
        // funzione esiste per evitare.
        if (LinguaDiLettura.Supportata(Lang))
        {
            Nav.NavigateTo($"/services/vsop/guide?{LinguaDiLettura.ChiaveQuery}={Lang!.ToLowerInvariant()}");
            return;
        }

        _en = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);
    }

    private string T(string it, string en) => _en ? en : it;

    // Sezione localizzata: ancora, icona, titolo (it/en) e corpo HTML (it/en). Corpi senza attributi con virgolette
    // così restano stringhe verbatim leggibili; niente <Icon> nel corpo (usa unicode) perché sono MarkupString.
    /// <summary>
    /// Il titolo del capitolo, <b>dal catalogo di ricerca</b> — non da qui.
    ///
    /// <para>⚠️ Fino al 28 agosto 2026 i titoli stavano in DUE posti: qui e in
    /// <see cref="GuideSearchCatalog"/>, ciascuno con la sua coppia italiano/inglese. Gli italiani
    /// combaciavano (scritti una volta e copiati); gli <b>inglesi no, in 11 casi su 38</b> — «Live status
    /// and online ATC» qui e «Live status and ATC online» nel risultato di ricerca, «What changed» e «What
    /// has changed». Chi cerca leggeva un titolo e ne apriva un altro, e nessuno se ne accorgeva perché
    /// nessuna delle due copie è sbagliata da sola. È il <b>vocabolario parallelo</b> che le regole della
    /// lingua vietano per la briciola di pane, arrivato qui dalla porta di servizio.</para>
    ///
    /// <para>⚠️ La direzione è obbligata: il catalogo vive in <c>Vipi.Application</c> (lo legge
    /// <c>SearchService</c>, che è backend) e l'applicazione non può dipendere dalla UI. Quindi è la pagina
    /// a chiedere al catalogo, non il contrario.</para>
    ///
    /// <para>Se un capitolo non fosse nel catalogo si vedrebbe la sua ancora al posto del titolo — brutto e
    /// evidente, che è il modo giusto di fallire. Non succede: c'è una guardia
    /// (<c>GuidaAncoreTests</c>).</para>
    /// </summary>
    private string Titolo(Sec s) =>
        GuideSearchCatalog.Entries.FirstOrDefault(e => e.Anchor == s.Anchor) is { } voce
            ? voce.Title(_en)
            : s.Anchor;

    private sealed record Sec(string Anchor, string Icon, string BodyIt, string BodyEn);

    private static readonly List<Sec> _consult = new()
    {
        new Sec("nav", "map",
            @"<p>Tutto vive sotto <code>/services/vsop</code>. La barra in alto ha i codici <b>ACC</b> (LIRR, LIMM, …),
               la ricerca e, se sei ATC/staff, i tasti Editor e Incarichi.</p>
              <ul>
                <li><b>Home</b> (<code>/services/vsop</code>) → card degli ACC con quanti controllori sono online.</li>
                <li><b>Landing ACC</b> (<code>/services/vsop/{acc}</code>) → il <b>vIPI di ACC</b>, gli <b>aeroporti</b>,
                    gli <b>APP non remotizzati</b> e le <b>vLOA</b> in evidenza.</li>
                <li>Da lì apri il documento specifico: vIPI ACC, vIPI aeroporto (con le SID), APP, o vLOA verso un vicino.</li>
              </ul>",
            @"<p>Everything lives under <code>/services/vsop</code>. The top bar has the <b>ACC</b> codes (LIRR, LIMM, …),
               search and, if you are ATC/staff, the Editor and Tasks buttons.</p>
              <ul>
                <li><b>Home</b> (<code>/services/vsop</code>) → ACC cards with how many controllers are online.</li>
                <li><b>ACC landing</b> (<code>/services/vsop/{acc}</code>) → the <b>ACC vIPI</b>, the <b>airports</b>,
                    the <b>non-remoted APPs</b> and the featured <b>vLOAs</b>.</li>
                <li>From there open the specific document: ACC vIPI, airport vIPI (with SIDs), APP, or a vLOA to a neighbour.</li>
              </ul>"),

        new Sec("ricerca", "search",
            @"<p>La barra di ricerca in alto (o <code>/services/vsop/search</code>) è full-text: cerca <b>CoP, FIX, callsign,
               frequenze</b> e testo dei documenti. Servono almeno 2 caratteri. I filtri (chip) restringono l'ambito;
               ogni risultato porta al punto esatto del documento. Anche le sezioni di questa Guida compaiono nei risultati.</p>",
            @"<p>The search bar at the top (or <code>/services/vsop/search</code>) is full-text: it searches <b>CoPs, FIXes,
