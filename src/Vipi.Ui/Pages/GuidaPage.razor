        new Sec("accordi", "refresh",
            @"<p>Un <b>accordo</b> lega <b>due elenchi di enti</b> per un tipo di traffico, su <b>tutti gli
               aeroporti</b> elencati. Dentro ci sono le <b>clausole</b>: ognuna dice su quali <b>punti</b> vale,
