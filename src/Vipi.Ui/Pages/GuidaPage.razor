        new Sec("aree", "map",
            @"<p>La sezione <b>Aree regolamentate</b> di una vIPI ha <b>una mappa sola</b> e una
               <b>pastiglia per ogni area</b> sopra di essa. All'apertura sono tutte accese: spegnendone una
