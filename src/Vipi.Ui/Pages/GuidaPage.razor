        new Sec("anteprime", "file",
            @"<p>Ogni documento può essere visto in tre modi, controllati dal parametro <code>?as=</code> nell'URL:</p>
              <ul>
                <li><b>Pubblica</b> (default, nessun parametro): quello che vede tutti — la release in vigore, o il live se non c'è release.</li>
