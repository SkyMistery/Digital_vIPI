@page "/services/vsop/{Acc}/editor"
@layout SopLayout
@rendermode InteractiveServer
@implements IDisposable
@using System.Text.Json
@inject IAccDocumentService AccDoc
@inject IAccDerivationService Profile
@inject IEditingService Editing
@inject IStationResolver Stations
@inject IEditAuthorizationService Authz
@inject IJSRuntime JS
@inject ILogger<AccEditorPage> Logger
@inject IStringLocalizer<SharedResource> L

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Vle_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@L["Acc_EditorTitle"] @_accName</PageTitle>
    <div class="wrap struct">
        <div class="breadcrumb">
            <a href="/services/vsop">@L["Common_Home"]</a> › <a href="/services/vsop/@Acc.ToLowerInvariant()">@_accName</a> ›
            <a href="/services/vsop/@Acc.ToLowerInvariant()/vipi">vIPI</a> › <b>@L["Common_Editor"]</b>
        </div>

        @if (_denied)
        {
            <div class="callout danger"><span class="cic">🔒</span><div><p class="ct">@L["Vle_Unauthorized"]</p>@(string.Format(L["Acc_DeniedBody"].Value, _accName))</div></div>
        }
        else if (_doc is null || _model is null)
        {
            <p class="help">@L["Acc_LoadingEditor"]</p>
        }
        else
        {
            @* ---- Testata in UNA riga: titolo · «?» · stato · lock ----
               Come sull'editor aeroporto i comandi di scrittura restano nel rail (già appiccicato) e la riga
               porta solo DOVE sei e COME sta il documento. Il sottotitolo è dentro il «?» con la sua chiave
               (regola 8), e il lock è uno STATO in riga, non una fascia (regola 1). *@
            <div class="editor-bar">
                <div class="doc-head st-head" style="margin:0">
                    <h1 class="st-h2 page-h1">✎ @L["Acc_EditorTitle"] @_accName</h1>
                    <HelpHint Href="/services/vsop/guide#editor-acc" AriaLabel="@L["Acc_HelpAria"]" ExtraClass="wide">
                        <p>@L["Acc_Subtitle"]</p>
                        @((MarkupString)L["Acc_HelpBody"].Value)
                    </HelpHint>
                    <span class="pill @(_doc.VersionStatus == DocumentStatus.Draft ? "grey" : "green")">
                        @(_doc.VersionStatus == DocumentStatus.Draft ? L["Ed_DraftVN", _doc.VersionNumber] : L["Ed_PublishedVN", _doc.VersionNumber])
                    </span>
                    @if (_editing)
                    {
                        @* ⚠️ Il chip dice l'ORA, la frase intera sta nel `title`: misurato, «Stai modificando ·
                           lock fino alle 21:06» sono 266px, e a 1024 la testata andava a capo per nove pixel.
                           E' la stessa cura gia' pagata sul giro Versioni (la frase del lock, 647 → 289). *@
                        <span class="sh-chip ok" data-utc-title="@VipiTime.Iso(_lock.ExpiresUtc)" title="@(L["Lock_Editing"].Value + (_lock.ExpiresUtc is { } mt ? L["Lock_UntilSuffix", VipiTime.Z(mt)].Value : ""))">
                            🔒 @(_lock.ExpiresUtc is { } me ? L["Lock_EditingShort", VipiTime.Z(me)].Value : L["Lock_EditingNoTime"].Value)
                        </span>
                    }
                    else if (_lock is { Locked: true, IsMine: false })
                    {
                        <span class="sh-chip warn" data-utc-title="@VipiTime.Iso(_lock.ExpiresUtc)" title="@(string.Format(L["Acc_LockedByOtherBody"].Value, _lock.ByName ?? L["Lock_AnotherEditor"].Value, _lock.ExpiresUtc is { } ot ? L["Lock_UntilSuffix", VipiTime.Z(ot)].Value : ""))">
                            🔒 @(_lock.ByName ?? L["Lock_AnotherEditor"].Value)@(_lock.ExpiresUtc is { } oe ? L["Lock_UntilSuffix", VipiTime.Z(oe)].Value : "")
                        </span>
                    }
                    @* ⤢ Larghezza piena: stesso comando dell'editor aeroporto, stessa classe (.sid-wide) e stesse
                       chiavi — qui serve alle tabelle larghe (frequenze, coordinamenti). *@
                    <button type="button" class="btn ghost st-head-end" @onclick="() => _wide = !_wide"
                            aria-pressed="@_wide.ToString().ToLowerInvariant()"
                            title="@(_wide ? L["Ed_NarrowTitle"] : L["Ed_WideTitle"])">@(_wide ? "⤡" : "⤢") @(_wide ? L["Ed_Narrow"] : L["Ed_Wide"])</button>
                </div>
            </div>

            <DocReviewBar DocumentId="_docId" />

            <div class="ed-layout with-rail @(_wide ? "sid-wide" : null)">
            @* Espandi/comprimi tutto: stessi tasti e stesse chiavi dell'editor aeroporto — quello che si fa in
               un editor si fa anche nell'altro (regola 68). Agiscono su blocchi E sezioni. *@
            <EditorToc Items="BuildToc()">
                <Footer>
                    <button type="button" class="btn ghost" @onclick="() => ToggleAllSections(true)" title="@L["Ed_ExpandAllTitle"]">@L["Common_ExpandAll"]</button>
                    <button type="button" class="btn ghost" @onclick="() => ToggleAllSections(false)" title="@L["Ed_CollapseAllTitle"]">@L["Common_CollapseAll"]</button>
                </Footer>
            </EditorToc>
            <div>
            @{ var blockIndex = 0; }
            @foreach (var bs in _doc.Sections)
            {
                var blockSection = bs;
                var blk = _model.Blocks.FirstOrDefault(b => b.BlockSectionId == blockSection.Id);
                if (blk is null) { continue; }
                var isGroup = blk.Block.Kind == AccBlockKind.AppGroup;
                var firstBlock = blockIndex++ == 0;

                @* Il blocco si CHIUDE: e' la cosa che vale di piu' su questa pagina (un gruppo APP aperto sono
                   dieci sezioni e una mappa, ~3 700px). <details> nativo, quindi collassa senza circuito;
                   `data-persist` ricorda lo stato fra le navigazioni (wireCollapse) e la fisarmonica sta nel JS
                   (vipi-editor.js), non qui: chiudere i fratelli non e' un'informazione del documento.
                   Nasce aperto SOLO il primo: e' una decisione, non l'esito di quale `toggle` arriva prima. *@
                <details class="acc-block" id="@($"blk-{blockSection.Id}")" data-persist="@($"accblk-{blockSection.Id}")" open="@firstBlock">
                    <summary class="acc-block-head">
                        <span class="cb-chev" aria-hidden="true">▸</span>
                        @if (_editing && isGroup)
                        {
                            @* In modifica il titolo e' un campo: qui dentro il clic NON deve collassare (e il
                               doppio clic deve restare quello di chi scrive). Il toggle resta al chevron e al
                               resto del summary. *@
                            <span class="acc-block-edit" @onclick:preventDefault="true" @onclick:stopPropagation="true">
                                <input class="app-in" style="font-weight:700;max-width:320px" value="@blockSection.Title"
                                       @onchange="e => RenameGroup(blockSection.Id, AsString(e.Value))" />
                                <button class="btn ghost" title="@L["Acc_RemoveGroupTitle"]" @onclick="() => RemoveGroup(blockSection.Id)">✕ @L["Xfer_Group"]</button>
                            </span>
                        }
                        else
                        {
                            <h2 class="acc-block-h">@(isGroup ? blockSection.Title : L["Acc_AirwaySectors"])</h2>
                        }
                        <span class="acc-block-n">@Plural(blockSection.Children.Count, "Acc_BlockSections", blockSection.Children.Count)</span>
                    </summary>

                    @if (_editing && isGroup)
                    {
                        <div class="block" style="border-style:dashed">
                            <p class="app-lbl" style="margin:0 0 4px">@L["Acc_GroupAppSectors"]</p>
                            <div class="sector-pick">
                                @foreach (var s in _appSectors)
                                {
                                    var sec = s;
                                    var on = blk.Block.MemberCallsigns.Contains(sec.Callsign, StringComparer.OrdinalIgnoreCase);
                                    <button type="button" class="sp-item @(on ? "on" : "")" @onclick="() => ToggleMember(blk, sec.Callsign)">
                                        @(on ? "✓ " : "")<b>@sec.Callsign</b> <span class="muted">@sec.Name</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @* Profilo di catalogo del blocco: decide sia chi rende il corpo sia quali sezioni sono
                       obbligatorie — un blocco Aerovia non ha il VFR, un gruppo APP sì. *@
                    @{ var profile = SectionCatalog.ProfileOfAccBlock(blk.Block.Kind); }
                    <DocumentSectionsEditor Doc="_doc" RootSections="blockSection.Children" AddParentId="blockSection.Id"
                                            AddLabel="@("+ " + L["Acc_AddCustomSection"].Value)" IsEditing="_editing" Run="Guard" OnChanged="LoadAsync"
                                            IsDerivedSection="s => SectionCatalog.IsHostRendered(profile, s.SectionKey)" DerivedContent="DerivedFor(blk)"
                                            IsMandatory="s => SectionCatalog.IsFixed(profile, s.SectionKey)"
                                            IsRenderModeToggleable="IsRenderModeToggleable" />
                </details>
            }

            @if (_editing)
            {
                <div class="block" style="border-style:dashed">
                    <button class="btn primary" @onclick="AddGroup">+ @L["Acc_AddAppGroup"]</button>
                </div>
            }

            @* Published: dopo «Pubblica ora» la bozza è promossa a versione pubblicata — ricarichiamo, o la pill
               «Bozza vN» del rail resta quella letta all'apertura. Stessi parametri degli altri editor (doc 13
               §3i): qui mancavano involucro, voce di menu, differenze e annullo. *@
            <ReleasePanel Target="ReleaseTargetType.AccVipi" Key="@($"{Acc.Trim().ToUpperInvariant()}|{_root}")"
                          ShowDiff="true" AllowCancel="Authz.IsAdmin"
                          PreviewUrlFactory="ReleasePreviewUrl"
                          Published="LoadAsync" />
            </div>
            <aside class="ed-rail">
                @* Stato e lock stanno in TESTATA (riga unica): qui restano i comandi. I badge del lock che
                   stavano in questo rail scrivevano l'ora in UTC, mentre la lockbar delle altre pagine la
                   scrive locale — la stessa scadenza compariva a due ore diverse. *@
                @if (_save == SaveState.Saving) { <span class="save-badge saving"><span class="spin"></span> @L["Ed_Saving"]</span> }
                else if (_save == SaveState.Saved) { <span class="save-badge saved"><Icon Name="check-circle" Size="13" /> @L["Ed_Saved"]</span> }
                <DraftPreviewLink Href="@($"/services/vsop/{Acc.ToLowerInvariant()}/vipi?as=draft")" />
                @if (_editing)
                {
                    <button class="btn ghost" @onclick="FinishEditing">✓ @L["Lock_FinishEdit"]</button>
                }
                else if (_lock is { Locked: true, IsMine: false })
                {
                    <button class="btn ghost" disabled title="@L["Ed_LockedByOther"]">✎ @L["Ed_Edit"]</button>
                }
                else
                {
                    <button class="btn ghost" @onclick="StartEditing">✎ @L["Ed_Edit"]</button>
                }
            </aside>
            </div>
        }
    </div>

    @* Errore: toast fisso, non una fascia sopra il contenuto (regola 5). In una pagina da migliaia di pixel una
       fascia in cima è un messaggio che nessuno vede — e che intanto spinge in giù la sezione su cui si lavora. *@
    <div class="editor-toast">
        @if (_error is not null)
        {
            <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div style="flex:1">@_error</div>
                <button class="btn ghost" style="padding:0 6px" @onclick="() => _error = null" title="@L["Common_Close"]">✕</button></div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;

    private AccInfo? _acc;
    private string _accName = "";
    private string _accCode = "";
    private string? _root;

    private int? _docId;
    private EditableDocument? _doc;
    private AccDocumentModel? _model;
    private LockInfo _lock = LockInfo.Free();
    private bool _denied, _editing;
    private bool _wide;   // ⤲ larghezza piena: indice e rail via, per le tabelle larghe
    private string? _error;

    private enum SaveState { Idle, Saving, Saved }
    private SaveState _save = SaveState.Idle;
    private readonly DelayedUiAction _dismissSaved = new();

    // Menu-sezioni laterale (TOC): raggruppato per blocco (Aerovia / gruppi APP); voci = sezioni figlie (anchor s-{Id}).
    private IReadOnlyList<EditorTocItem> BuildToc()
    {
        var items = new List<EditorTocItem>();
        if (_doc is null || _model is null) return items;
        foreach (var bs in _doc.Sections)
        {
            var blk = _model.Blocks.FirstOrDefault(b => b.BlockSectionId == bs.Id);
            if (blk is null) { continue; }
            var group = blk.Block.Kind == AccBlockKind.AppGroup ? bs.Title : L["Acc_AirwaySectors"].Value;
            if (bs.Children.Count == 0)
            {
                items.Add(new EditorTocItem($"blk-{bs.Id}", group));
            }
            else
            {
                foreach (var c in bs.Children)
                    items.Add(new EditorTocItem($"s-{c.Id}", c.Title, GroupLabel: group));
            }
        }
        // Il blocco Release è reso fuori dall'editor di sezioni: la sua voce si accoda a mano, come in APP/vLOA.
        items.Add(new EditorTocItem(ReleasePanel.SectionAnchor, L["Rel_SectionTitle"]));
        return items;
    }

    private string ReleasePreviewUrl(int releaseId) => $"/services/vsop/{Acc.ToLowerInvariant()}/vipi?as=rel:{releaseId}";

    // Espandi/comprimi tutto: lo fa il JS sui <details> (blocchi e sezioni), non un flag Blazor — il collasso
    // è nativo e vive fuori dal circuito. Prima del primo render interattivo l'interop non è lecita.
    private bool _jsReady;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { _jsReady = true; }
    }

    private async Task ToggleAllSections(bool open)
    {
        if (_jsReady) await JS.InvokeVoidAsync("vipiEditorSections", open);
    }

    private string Plural(int n, string key, params object[] args) => L[n == 1 ? key + "One" : key, args].Value;

    // Derivate per blocco (chiave = BlockSectionId).
    private readonly Dictionary<int, List<AppFreqRow>> _freqs = new();
    private readonly Dictionary<int, AccCoordination> _coord = new();
    private readonly Dictionary<int, AccAorView> _aors = new();
    private readonly Dictionary<int, MinimaView> _minima = new();
    private readonly Dictionary<int, IReadOnlyList<AccConfigTableView>> _configTables = new();

    private IReadOnlyList<AccSectorPick> _ctrSectors = Array.Empty<AccSectorPick>();
    private IReadOnlyList<AccSectorPick> _appSectors = Array.Empty<AccSectorPick>();
    private IReadOnlyList<LinkableFrequencyRow> _linkable = Array.Empty<LinkableFrequencyRow>();
    private IReadOnlyList<SpecialAreaPick> _specialAreaPicks = Array.Empty<SpecialAreaPick>();   // aree del proprio ACC
    private IReadOnlyList<SpecialAreaPick> _otherAreaPicks = Array.Empty<SpecialAreaPick>();     // aree di altri ACC (extra)
    private IReadOnlyList<SectorShapePick> _shapeCatalog = Array.Empty<SectorShapePick>();       // settori con shape (picker shape extra AoR)
    private readonly Dictionary<int, string> _freqSearch = new();   // per blocco (BlockSectionId)
    private (int Block, int Index)? _freqDrag;

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _denied = false; _error = null; _doc = null; _model = null; _docId = null;

        var id = await AccDoc.GetIdentityAsync(Acc);
        if (id is null) { _denied = true; return; }
        _accName = id.AccName; _accCode = id.AccCode; _root = id.RootCallsign;

        try { _docId = await AccDoc.EnsureAsync(Acc); }
        catch (EditNotAllowedException) { _denied = true; return; }
        catch (ValidationException) { _denied = true; return; }

        _appSectors = await Profile.ListAppSectorsAsync(Acc);
        _ctrSectors = await Profile.GetBlockPoolAsync(Acc, new AccBlock { Key = "aerovia", Kind = AccBlockKind.Aerovia }, _root);
        _linkable = await Profile.ListLinkableFrequenciesAsync();
        _specialAreaPicks = await Profile.ListSpecialAreasByAccAsync(Acc);
        _otherAreaPicks = await Profile.ListOtherAccSpecialAreasAsync(Acc);
        _shapeCatalog = await Profile.ListSelectableSectorShapesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_docId is not int id) return;
        try
        {
            _doc = await Editing.LoadForEditAsync(id);
            _model = await AccDoc.LoadForEditAsync(Acc);
            _lock = await Editing.InspectLockAsync(id);
            if (_doc is null || _model is null) { _denied = true; return; }
            _editing = _editing && _doc.IsEditable;

            _freqs.Clear(); _coord.Clear(); _aors.Clear(); _configTables.Clear(); _minima.Clear();
            foreach (var b in _model.Blocks) await RefreshBlockDerived(b);
        }
        catch (EditNotAllowedException) { _denied = true; }
    }

    private async Task RefreshBlockDerived(AccAssembledBlock b)
    {
        _freqs[b.BlockSectionId] = (await Profile.DeriveFrequenciesAsync(Acc, b.Block, _root)).ToList();
        _coord[b.BlockSectionId] = await Profile.DeriveCoordinationAsync(Acc, b.Block, _root);
        _aors[b.BlockSectionId] = await Profile.DeriveAorViewAsync(Acc, b.Block, _root);
        _minima[b.BlockSectionId] = await Profile.DeriveMinimaAsync(Acc, b.Block, _root);
        _configTables[b.BlockSectionId] = await Profile.DeriveConfigTableAsync(Acc, b.Block, _root);
    }

    // ---- workflow bozza/lock/pubblicazione (come AppEditorPage) ----
    private async Task StartEditing()
    {
        if (_docId is not int id) return;
        await GuardCore(async () =>
        {
            if (_doc is { IsEditable: false }) await Editing.CreateDraftAsync(id);
            else await Editing.AcquireLockAsync(id);
            await LoadAsync();
            _editing = _doc?.IsEditable == true;
        }, silent: true);
    }

    // Fine modifica: rilascia il lock così il documento è subito libero per gli altri (non aspetta i 30 min di TTL).
    private async Task FinishEditing()
    {
        _editing = false;
        if (_docId is int id)
        {
            await GuardCore(() => Editing.ReleaseLockAsync(id), silent: true);
            _lock = await Editing.InspectLockAsync(id);
        }
    }

    // ---- gruppi (blocchi appgroup) ----
    private Task AddGroup() => Guard(async () =>
    {
        if (_doc is null) return;
        await AccDoc.AddGroupAsync(Acc, _doc.VersionId, "Nuovo gruppo APP");
        await LoadAsync();
    });

    private Task RenameGroup(int blockSectionId, string title) => Guard(async () =>
    {
        await Editing.RenameSectionAsync(blockSectionId, title);
        await LoadAsync();
    });

    private async Task RemoveGroup(int blockSectionId)
    {
        if (!await Confirm(L["Acc_RemoveGroupConfirm"].Value)) return;
        await Guard(async () =>
        {
            await AccDoc.RemoveGroupAsync(Acc, blockSectionId);
            await LoadAsync();
        });
    }

    private Task ToggleMember(AccAssembledBlock blk, string cs) => Guard(async () =>
    {
        var members = blk.Block.MemberCallsigns;
        if (members.Contains(cs, StringComparer.OrdinalIgnoreCase))
            members.RemoveAll(x => string.Equals(x, cs, StringComparison.OrdinalIgnoreCase));
        else members.Add(cs);
        await SaveMeta(blk);
        await LoadAsync();
    });

    // ---- meta blocco (override + membri) ----
    private static AccBlockMeta MetaOf(AccBlock b) => new()
    {
        Key = b.Key, Kind = b.Kind, MemberCallsigns = b.MemberCallsigns,
        FreqOrder = b.FreqOrder, FreqLinkCallsigns = b.FreqLinkCallsigns,
    };
    private Task SaveMeta(AccAssembledBlock blk) => AccDoc.SaveBlockMetaAsync(Acc, blk.BlockSectionId, MetaOf(blk.Block));

    private int ChildId(AccAssembledBlock blk, string key) => blk.ChildSectionIdsByKey.GetValueOrDefault(key);

    // ---- struttura sezioni ----
    // «Chi rende il corpo» e «è obbligatoria» sono domande al catalogo, per profilo (doc 13 §3a): qui stavano un
    // insieme di chiavi copiato e una lista scritta a mano che il catalogo già conosceva.
    // Solo le sezioni DERIVATE (aor/frequencies/coordination) espongono il toggle Live/Frozen (doc 10 §3a).
    private static bool IsRenderModeToggleable(EditableSection s) => SectionCatalog.IsRenderModeToggleable(s.SectionKey);

    // ---- editoriali-strutturate ----
    private Task SaveSeparations(AccAssembledBlock blk, IReadOnlyList<AppSeparationRow> rows) => Guard(async () =>
    {
        await AccDoc.SaveSeparationsAsync(Acc, ChildId(blk, "separations"), rows);
        await LoadAsync();
    });

    private Task SaveVfr(AccAssembledBlock blk, AppVfrContent content) => Guard(async () =>
    {
        await AccDoc.SaveVfrAsync(Acc, ChildId(blk, "vfr"), content);
        await LoadAsync();
    });

    // ---- frequenze (override ordine + link, nel blockmeta) ----
    private Task MoveFreq(AccAssembledBlock blk, (int Index, int Dir) m) => Guard(async () =>
    {
        var rows = _freqs.GetValueOrDefault(blk.BlockSectionId) ?? new();
        var j = m.Index + m.Dir;
        if (j < 0 || j >= rows.Count) return;
        (rows[m.Index], rows[j]) = (rows[j], rows[m.Index]);
        blk.Block.FreqOrder = rows.Select((r, i) => new AppFreqOrderOverride(r.Callsign, i)).ToList();
        await SaveMeta(blk);
        await LoadAsync();
    });
    private void FreqDragOver(AccAssembledBlock blk, int idx)
    {
        if (_freqDrag is not (int b, int from) || b != blk.BlockSectionId || from == idx) return;
        var rows = _freqs.GetValueOrDefault(blk.BlockSectionId);
        if (rows is null || idx >= rows.Count) return;
        var item = rows[from];
        rows.RemoveAt(from); rows.Insert(idx, item);
        _freqDrag = (blk.BlockSectionId, idx);
    }
    private Task FreqDragDrop(AccAssembledBlock blk) => _freqDrag?.Block != blk.BlockSectionId ? Task.CompletedTask : Guard(async () =>
    {
        _freqDrag = null;
        var rows = _freqs.GetValueOrDefault(blk.BlockSectionId) ?? new();
        blk.Block.FreqOrder = rows.Select((r, i) => new AppFreqOrderOverride(r.Callsign, i)).ToList();
        await SaveMeta(blk);
        await LoadAsync();
    });
    private Task AddLink(AccAssembledBlock blk, string callsign) => Guard(async () =>
    {
        if (string.IsNullOrWhiteSpace(callsign) || blk.Block.FreqLinkCallsigns.Contains(callsign, StringComparer.OrdinalIgnoreCase)) return;
        blk.Block.FreqLinkCallsigns.Add(callsign);
        _freqSearch[blk.BlockSectionId] = "";
        await SaveMeta(blk);
        await LoadAsync();
    });
    private Task RemoveLink(AccAssembledBlock blk, string callsign) => Guard(async () =>
    {
        blk.Block.FreqLinkCallsigns.RemoveAll(c => string.Equals(c, callsign, StringComparison.OrdinalIgnoreCase));
        await SaveMeta(blk);
        await LoadAsync();
    });

    // ---- configurazioni (editor condiviso AppConfigurations: emette l'intera lista, l'host salva) ----
    private Task SaveConfigs(AccAssembledBlock blk, IReadOnlyList<AccConfiguration> configs) => Guard(async () =>
    {
        blk.Block.Configurations = configs.ToList();
        await AccDoc.SaveConfigurationsAsync(Acc, ChildId(blk, "configurations"), blk.Block.Configurations);
        await LoadAsync();
    });

    private Task<bool> ConfirmRemoveConfig(AccConfiguration c) => Confirm(string.Format(L["App_RemoveConfigConfirm"].Value, c.Name));

    // ---- shape AoR extra (settori DB scelti a mano) + colori ----
    private Task SaveAorExtras(AccAssembledBlock blk, IReadOnlyList<string> callsigns) => Guard(async () =>
    {
        blk.Block.ExtraAorCallsigns = callsigns.ToList();
        await SaveAorCustomization(blk);
    });

    private Task SaveAorColor(AccAssembledBlock blk, (string Callsign, string? Hex) pick) => Guard(async () =>
    {
        if (pick.Hex is null) blk.Block.AorColorOverrides.Remove(pick.Callsign);
        else blk.Block.AorColorOverrides[pick.Callsign] = pick.Hex;
        await SaveAorCustomization(blk);
    });

    private async Task SaveAorCustomization(AccAssembledBlock blk)
    {
        await AccDoc.SaveAorCustomizationAsync(Acc, ChildId(blk, "aor"),
            new AorExtraShapes { Callsigns = blk.Block.ExtraAorCallsigns, Colors = blk.Block.AorColorOverrides });
        await LoadAsync();
    }

    // ---- aree regolamentate (picker condiviso RegulatedAreasEditor: qui resta solo il salvataggio) ----
    private Task SaveRegulated(AccAssembledBlock blk, RegulatedSelection sel) => Guard(async () =>
    {
        await AccDoc.SaveRegulatedAsync(Acc, ChildId(blk, "regulated"), sel);
        await LoadAsync();
    });

    private IReadOnlyList<AccSectorPick> PoolOf(AccAssembledBlock blk) =>
        blk.Block.Kind == AccBlockKind.Aerovia ? _ctrSectors
            : _appSectors.Where(a => blk.Block.MemberCallsigns.Contains(a.Callsign, StringComparer.OrdinalIgnoreCase)).ToList();

    // ---- infra ----
    // Firma a 1 parametro preservata: passata come Run= a DocumentSectionsEditor (Func<Func<Task>,Task>).
    private Task Guard(Func<Task> action) => GuardCore(action, silent: false);
    // silent = azione non-di-contenuto (es. acquisizione/rilascio lock): nessun badge "Saved", ma stessa gestione errori.
    private async Task GuardCore(Func<Task> action, bool silent)
    {
        _error = null;
        if (!silent) { _save = SaveState.Saving; StateHasChanged(); }
        try
        {
            await action();
            if (!silent)
            {
                _save = SaveState.Saved;
                // Il badge «Salvato» si spegne da solo. Programmato con DelayedUiAction, che annulla il
                // precedente e — a differenza del contatore che c'era prima — si ferma anche allo smontaggio
                // del componente: senza, chi salvava e cambiava pagina entro due secondi lasciava un
                // InvokeAsync su un renderer che non c'era più, dentro un task che nessuno osserva.
                _dismissSaved.Schedule(TimeSpan.FromSeconds(2), () =>
                {
                    if (_save != SaveState.Saved) return Task.CompletedTask;
                    _save = SaveState.Idle;
                    return InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (EditNotAllowedException) { _error = L["Acc_NoPerm"]; _save = SaveState.Idle; }
        catch (EditConflictException ex) { _error = ex.Message; _save = SaveState.Idle; if (_docId is int id) _lock = await Editing.InspectLockAsync(id); }
        catch (ValidationException ex) { _error = ex.Message; _save = SaveState.Idle; }
        // Rete di sicurezza: senza questo, un'eccezione non prevista (DbUpdateException, Npgsql…) sfuggiva,
        // abbatteva il circuito e lasciava il badge inchiodato su "Salvataggio". Meglio un errore visibile.
        catch (Exception ex)
        {
            _error = L["Common_UnexpectedError"] + ex.Message;
            _save = SaveState.Idle;
            Logger.LogError(ex, "Azione editor ACC fallita (documento {DocId}).", _docId);
        }
    }
    /// <summary>Ferma il badge che si spegne da solo: dopo lo smontaggio non c'è più un renderer da avvisare.</summary>
    public void Dispose() => _dismissSaved.Dispose();
    private static string AsString(object? v) => v as string ?? "";
    private async Task<bool> Confirm(string message) => await JS.InvokeAsync<bool>("confirm", message);

    // ---- render sezioni strutturate (per blocco) ----
    private RenderFragment<EditableSection> DerivedFor(AccAssembledBlock blk) => section => __builder =>
    {
        var bsId = blk.BlockSectionId;
        switch (section.SectionKey)
        {
            case "separations":
                <AppSeparations Rows="blk.Block.Separations" Editing="_editing" RowsChanged="rows => SaveSeparations(blk, rows)" />
                break;
            case "configurations":
                <AppConfigurations Configs="blk.Block.Configurations" Pool="PoolOf(blk)"
                                   Tables="_configTables.GetValueOrDefault(bsId) ?? Array.Empty<AccConfigTableView>()"
                                   Editing="_editing" MapScope="@($"b{bsId}")" ConfigsChanged="configs => SaveConfigs(blk, configs)"
                                   ConfirmRemove="ConfirmRemoveConfig" />
                break;
            case "aor":
                <AccAor @key="@($"aor-{bsId}")" View="_aors.GetValueOrDefault(bsId) ?? AccAorView.Empty" Id="@($"b{bsId}")" />
                @if (_editing)
                {
                    @* Titolo e «?» in riga: il paragrafo che stava sempre a schermo si legge al clic, con la sua
                       chiave (regola 8). Due pannelli per blocco, quindi due paragrafi per blocco. *@
                    <div class="block" style="margin-top:10px">
                        <div class="ed-h3">
                            <h3 class="h-card" style="margin:0">@L["Aor_ExtraShapesTitle"]</h3>
                            <HelpHint Href="/services/vsop/guide#editor-aor" AriaLabel="@L["Aor_ExtraShapesAria"]" ExtraClass="wide">
                                @L["Aor_ExtraShapesHelp"]
                            </HelpHint>
                        </div>
                        <AorExtraShapePicker Selected="blk.Block.ExtraAorCallsigns" Catalog="_shapeCatalog" Editing="_editing"
                                             SelectedChanged="cs => SaveAorExtras(blk, cs)" />
                    </div>
                    <div class="block" style="margin-top:10px">
                        <div class="ed-h3">
                            <h3 class="h-card" style="margin:0">@L["Aor_ColorsTitle"]</h3>
                            <HelpHint Href="/services/vsop/guide#editor-aor" AriaLabel="@L["Aor_ColorsAria"]" ExtraClass="wide">
                                @L["Aor_ColorsHelp"]
                            </HelpHint>
                        </div>
                        <AorColorEditor Sectors="(_aors.GetValueOrDefault(bsId) ?? AccAorView.Empty).Sectors" Editing="_editing"
                                        ColorChanged="pick => SaveAorColor(blk, pick)" />
                    </div>
                }
                break;
            case "frequencies":
                <AppFrequencies Rows="_freqs.GetValueOrDefault(bsId) ?? new()" Editing="_editing" OnMove="m => MoveFreq(blk, m)"
                                DragIndex="@(_freqDrag?.Block == bsId ? _freqDrag.Value.Index : null)"
                                OnDragStart="i => _freqDrag = (bsId, i)" OnDragEnter="i => FreqDragOver(blk, i)"
                                OnDrop="() => FreqDragDrop(blk)" OnDragEnd="() => FreqDragDrop(blk)" />
                @if (_editing) { @FreqLinkEditor(blk) }
                break;
            case "vfr":
                <AppVfr Content="ParseVfr(blk.Block.VfrJson)" Editing="_editing" ContentChanged="c => SaveVfr(blk, c)" />
                break;
            case "minima":
                @* Sola lettura anche in modifica: la carta viene dal sectorfile, non si scrive da qui. Ciò che
                   l'editor decide è se resti Live o venga congelata alla release (toggle del pannello sezione). *@
                <MinimaSection @key="@($"mva-{bsId}")" View="_minima.GetValueOrDefault(bsId) ?? MinimaView.Empty"
                               Aor="_aors.GetValueOrDefault(bsId)" />
                break;
            case "coordination":
                <AccCoordinationView Coord="_coord.GetValueOrDefault(bsId) ?? AccCoordination.Empty" />
                break;
            case "regulated":
                @* Aerovia: modo automatico + aree di altri ACC. Gruppo APP: sole aree proprie, scelte a mano. *@
                var isAerovia = blk.Block.Kind == AccBlockKind.Aerovia;
                <RegulatedAreasEditor @key="@($"reg-{bsId}")" Selection="blk.Block.Regulated"
                                      OwnPicks="_specialAreaPicks" OtherPicks="_otherAreaPicks"
                                      Editing="_editing" AllowAuto="isAerovia" ShowExtra="isAerovia"
                                      SelectionChanged="sel => SaveRegulated(blk, sel)" />
                break;
        }
    };

    private RenderFragment FreqLinkEditor(AccAssembledBlock blk) => __builder =>
    {
        var search = _freqSearch.GetValueOrDefault(blk.BlockSectionId, "");
        <div class="block" style="border-style:dashed;margin-top:8px">
            <p class="app-lbl" style="margin:0 0 4px">@L["Acc_LinkedFreqs"] <span class="muted">@L["Acc_LinkedFreqsHint"]</span></p>
            @if (blk.Block.FreqLinkCallsigns.Count > 0)
            {
                <div class="sector-pick" style="margin-bottom:6px">
                    @foreach (var cs in blk.Block.FreqLinkCallsigns)
                    {
                        var callsign = cs;
                        <button type="button" class="sp-item on" title="@L["Acc_RemoveLink"]" @onclick="() => RemoveLink(blk, callsign)"><Icon Name="link" /> <b>@callsign</b> ✕</button>
                    }
                </div>
            }
            @* Campo + risultati dentro `.app-linkpick`, come l'editor APP: e' quel contenitore a rendere
               l'elenco un menu a tendina ancorato al campo. Senza, i risultati escono come chip in riga —
               due forme diverse per lo stesso gesto in due editor gemelli. *@
            <div class="app-linkpick">
            <input class="app-in" placeholder="@L["App_LinkFreqPh"]" value="@search"
                   @oninput="e => _freqSearch[blk.BlockSectionId] = AsString(e.Value)" />
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <div class="sector-pick">
                    @foreach (var l in _linkable
                        .Where(l => !blk.Block.FreqLinkCallsigns.Contains(l.Callsign, StringComparer.OrdinalIgnoreCase))
                        .Where(l => l.Callsign.Contains(search, StringComparison.OrdinalIgnoreCase) || (l.Icao ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))
                        .Take(8))
                    {
                        var row = l;
                        <button type="button" class="sp-item" @onclick="() => AddLink(blk, row.Callsign)"><b>@row.Callsign</b> <span class="muted">@row.FrequencyMhz</span></button>
                    }
                </div>
            }
            </div>
        </div>
    };

    private static AppVfrContent ParseVfr(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return AppVfrContent.Empty;
        try { return JsonSerializer.Deserialize<AppVfrContent>(json) ?? AppVfrContent.Empty; }
        catch (JsonException) { return AppVfrContent.Empty; }
    }
}
