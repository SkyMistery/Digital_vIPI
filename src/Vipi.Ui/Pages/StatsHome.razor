@page "/services/stats"
@page "/services/stats/user/{Vid:int}"
@layout SopLayout
@using Vipi.Application.Abstractions
@using Vipi.Application.Auth
@using Vipi.Application.Stats
@inject IAtcStatsQueries Stats
@inject IStatsSettingsStore Impostazioni
@inject ICurrentUserProvider Utenti
@inject IEditAuthorizationService Authz
@inject IStaffRosterRepository Roster
@inject IStatsAccessLog RegistroAccessi
@inject IStringLocalizer<SharedResource> L

@* Le statistiche ATC di una persona. SSR statico: è un elenco di numeri, non c'è niente da aggiornare da
   solo — come l'hub dei servizi. Il periodo sta nell'INDIRIZZO (?p=30) e non in un componente interattivo:
   così la pagina resta statica, il tasto «indietro» funziona e un periodo si può mandare a qualcuno.

   ⚠️ DUE indirizzi, una pagina sola. «/services/stats» sono le PROPRIE; «/services/stats/user/{vid}» sono
   quelle di un altro e le apre solo lo staff (`Authz.IsAdmin`) — con la fascia in testa che lo dice e una
   riga nel registro di audit, perché la griglia ora×giorno racconta QUANDO una persona è online e un dato
   così non si guarda in silenzio. Due pagine gemelle si sarebbero scollate al primo grafico aggiunto a una
   sola delle due: qui cambia il VID di partenza, non il contenuto.

   Gli orari si scrivono in UTC col suffisso Z e l'ora locale la aggiunge il browser. *@

<PageTitle>@L["Stats_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap stats">
    <div class="doc-head stat-hero">
        <div class="sh-main">
            @* Anche il divieto porta il titolo neutro: «Le mie statistiche ATC» sopra un «non ti è
               permesso» direbbe che sono le PROPRIE a essere negate, che è il contrario. *@
            <h1 class="page-h1">@(_altrui || _vietato ? L["Stats_UserTitle"] : L["Stats_Title"])</h1>
            @* Nome e VID di chi è guardato. Il VID è staccato dal resto — prima era il «{1}» dentro la
               chiave Stats_Subtitle («{0} · VID {1}») — perché è un link al profilo IVAO: dentro una
               frase già formattata non c'era modo di renderlo premibile. Il «·» è punteggiatura, non
               testo da tradurre, e la parola «VID» resta tradotta una volta sola in Audit_VidN. *@
            @if (_altrui)
            {
                @* ⚠️ Il nome lo sa solo il roster, che raccoglie gli STAFFISTI ai login: di un controllore
                   qualunque abbiamo il VID e basta. Nessun ripiego inventato — il VID è già un link al
                   profilo IVAO, dove il nome c'è. *@
                <p class="muted">
                    @if (!string.IsNullOrWhiteSpace(_nomeSoggetto)) { <text>@_nomeSoggetto · </text> }
                    <VidLink Vid="_soggetto" />
                </p>
            }
            else if (_utente is not null && !_vietato)
            {
                <p class="muted">@_utente.Name · <VidLink Vid="_utente.UserId" /></p>
            }
        </div>

        @if (_utente is not null && _totali is { Sessions: > 0 })
        {
            <div class="sh-side">
                @if (_posizione is { Position: > 0 } r)
                {
                    <div class="sh-fact" title="@L["Stats_TopPercent", r.TopPercent]">
                        <b>@L["Stats_YourRank", r.Position, r.Total]</b>
                        @L["Stats_YourRankLabel"]
                    </div>
                }
                <div class="sh-fact @(_striscia.CurrentWeeks >= 4 ? "gold" : "")"
                     title="@L["Stats_StreakBest", _striscia.BestWeeks]">
                    <b>@(_striscia.CurrentWeeks > 0 ? _striscia.CurrentWeeks.ToString() : "—")</b>
                    @(_striscia.CurrentWeeks > 0 ? L["Stats_StreakLabel"].Value : L["Stats_StreakNone"].Value)
                </div>
                @if (_perPostazione.Count > 0)
                {
                    <div class="sh-fact">
                        <b>@_perPostazione[0].Key</b>
                        @L["Stats_FavPosition"]
                    </div>
                }
            </div>
        }
    </div>

    @if (_altrui)
    {
        <div class="callout info" style="margin:10px 0 16px">
            <span class="cic"><Icon Name="eye" Size="18" /></span>
            <div>
                <p class="ct">@L["Stats_StaffViewingTitle"]</p>
                @L["Stats_StaffViewingBody"] ·
                <a href="/services/stats/division">@L["Stats_BackToDivision"]</a>
            </div>
        </div>
    }

    @if (_vietato)
    {
        <p class="muted">@L["Stats_ProfileForbidden"]</p>
    }
    else if (_utente is null)
    {
        <p class="muted">@L["Stats_LoginNeeded"]</p>
    }
    else
    {
        <StatsChipBar Voci="_periodi" Titolo="@L["Stats_Period"].Value" />

        if (_totali is null || _totali.Sessions == 0)
        {
            <div class="stat-empty">
                <b>@L["Stats_EmptyTitle"]</b>
                <p>
                    @if (_altrui) { <text>@L["Stats_UserEmpty"]</text> }
                    else { <text>@(_inizioArchivio is null ? L["Stats_Empty"] : L["Stats_EmptyPeriod"])</text> }
                </p>
                @if (_inizioArchivio is { } inizio)
                {
                    <p class="muted">@L["Stats_ArchiveFrom", inizio.ToString("yyyy-MM-dd")]</p>
                }
            </div>
        }
        else
        {
            <div class="kpi-grid">
                <StatsKpi Valore="@StatsView.Ore(_totali.Seconds)" Unita="h" Etichetta="@L["Stats_Hours"].Value"
                          Delta="_dOre" DeltaHint="@_confronto" Serie="_serieOre" />
                <StatsKpi Valore="@_totali.Shifts.ToString()" Etichetta="@L["Stats_Shifts"].Value"
                          Delta="_dTurni" DeltaHint="@_confronto" />
                <StatsKpi Valore="@_totali.Movements.ToString()" Etichetta="@L["Stats_Movements"].Value"
                          Delta="_dMovimenti" DeltaHint="@_confronto" Serie="_serieMovimenti" />
                <StatsKpi Valore="@_totali.Presences.ToString()" Etichetta="@L["Stats_Presences"].Value" />
            </div>

            <div class="stats-cols">
                <section>
                    <h2 class="h-sect">@L["Stats_MonthChart"]</h2>
                    <StatsBars Barre="_barreMesi" Titolo="@L["Stats_MonthChart"].Value" />
                </section>
                <section>
                    <h2 class="h-sect">@L["Stats_PositionShare"]</h2>
                    <StatsDonut Fette="_fette" Titolo="@L["Stats_PositionShare"].Value"
                                Centro="@StatsView.Ore(_totali.Seconds)" CentroLabel="@L["Stats_Hours"].Value" />
                </section>
            </div>

            <h2 class="h-sect">@_titoloGriglia</h2>
            <CoverageHeatmap Celle="_griglia" Copertura="false" Titolo="@_titoloGriglia" />
            <div class="cov-legend">
                <span>@L["Stats_CovLegend"]</span>
                <span>@L["Stats_CovNone"]</span>
                <i class="cov-q0"></i><i class="cov-q1"></i><i class="cov-q2"></i><i class="cov-q3"></i><i class="cov-q4"></i>
                <span>@L["Stats_CovFull"]</span>
            </div>

            @* ⚠️ Le due domande sugli aeroporti sono OPPOSTE e stanno affiancate apposta: a sinistra i campi
               che si coprivano, a destra quelli che passano davanti. Separate su due righe della pagina
               sarebbero state lette come «la stessa tabella, due volte, con numeri diversi». *@
            <div class="stats-cols">
                <section>
                    <h2 class="h-sect">@L["Stats_ManagedAirports"]</h2>
                    <p class="muted">@L["Stats_ManagedAirportsHint"]</p>
                    @if (_aeroportiGestiti.Count == 0)
                    {
                        @* Vuoto per un motivo, non per un buco: un settore d'area non dichiara un campo. *@
                        <p class="muted">@L["Stats_ManagedAirportsNone"]</p>
                    }
                    else
                    {
                        <table class="res-table tbl-cards">
                            <thead>
                                <tr><th>@L["Stats_Airport"]</th><th>@L["Stats_Flights"]</th><th>@L["Stats_Movements"]</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _aeroportiGestiti)
                                {
                                    <tr>
                                        <td data-l="@L["Stats_Airport"]">@r.Key</td>
                                        <td class="cb" data-l="@L["Stats_Flights"]"
                                            style="--cb:@StatsView.Quota(r.Sessions, _maxVoliGestiti)">@r.Sessions</td>
                                        <td data-l="@L["Stats_Movements"]">@r.Movements</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
                <section>
                    <h2 class="h-sect">@L["Stats_TopAirports"]</h2>
                    <p class="muted">@L["Stats_SeenAirportsHint"]</p>
                    <table class="res-table tbl-cards">
                        <thead>
                            <tr><th>@L["Stats_Airport"]</th><th>@L["Stats_Flights"]</th><th>@L["Stats_Movements"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _aeroporti)
                            {
                                <tr>
                                    <td data-l="@L["Stats_Airport"]">@r.Key</td>
                                    <td class="cb" data-l="@L["Stats_Flights"]"
                                        style="--cb:@StatsView.Quota(r.Sessions, _maxVoliAeroporto)">@r.Sessions</td>
                                    <td data-l="@L["Stats_Movements"]">@r.Movements</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </div>

            <div class="stats-cols">
                <section>
                    <h2 class="h-sect">@L["Stats_ByPosition"]</h2>
                    <table class="res-table tbl-cards">
                        <thead>
                            <tr>
                                <th>@L["Stats_Position"]</th><th>@L["Stats_Sessions"]</th>
                                <th>@L["Stats_Hours"]</th><th>@L["Stats_Movements"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _perPostazione)
                            {
                                <tr>
                                    <td data-l="@L["Stats_Position"]">
                                        <i class="dot @StatsView.PosClass(r.Key)"></i> @r.Key
                                    </td>
                                    <td data-l="@L["Stats_Sessions"]">@r.Sessions</td>
                                    <td class="cb" data-l="@L["Stats_Hours"]"
                                        style="--cb:@StatsView.Quota(r.Seconds, _maxOrePostazione)">@StatsView.Ore(r.Seconds)</td>
                                    <td data-l="@L["Stats_Movements"]">@r.Movements</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
                <section>
                    <h2 class="h-sect">@L["Stats_TopAircraft"]</h2>
                    <table class="res-table tbl-cards">
                        <thead>
                            <tr><th>@L["Stats_Aircraft"]</th><th>@L["Stats_Flights"]</th><th>@L["Stats_Movements"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _tipi)
                            {
                                <tr>
                                    <td data-l="@L["Stats_Aircraft"]">@r.Key</td>
                                    <td class="cb" data-l="@L["Stats_Flights"]"
                                        style="--cb:@StatsView.Quota(r.Sessions, _maxVoliTipo)">@r.Sessions</td>
                                    <td data-l="@L["Stats_Movements"]">@r.Movements</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </div>

            <div class="stats-cols">
                <section>
                    <h2 class="h-sect">@L["Stats_ByMonth"]</h2>
                    <table class="res-table tbl-cards">
                        <thead>
                            <tr>
                                <th>@L["Stats_Month"]</th><th>@L["Stats_Sessions"]</th>
                                <th>@L["Stats_Hours"]</th><th>@L["Stats_Movements"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _perMese)
                            {
                                <tr>
                                    <td data-l="@L["Stats_Month"]">@r.Key</td>
                                    <td data-l="@L["Stats_Sessions"]">@r.Sessions</td>
                                    <td class="cb" data-l="@L["Stats_Hours"]"
                                        style="--cb:@StatsView.Quota(r.Seconds, _maxOreMese)">@StatsView.Ore(r.Seconds)</td>
                                    <td data-l="@L["Stats_Movements"]">@r.Movements</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </div>

            @* ⚠️ Un TURNO per riga, non una connessione: sul dato vero il 38% delle connessioni sono
               spezzoni di una caduta di linea, e in elenco sembravano turni distinti. Gli spezzoni stanno
               dentro il loro turno, aperti da chi li vuole vedere. *@
            <h2 class="h-sect">@L["Stats_Shifts"]</h2>
            <table class="res-table tbl-cards">
                <thead>
                    <tr>
                        <th>@L["Stats_Start"]</th><th>@L["Stats_Position"]</th><th>@L["Stats_Duration"]</th>
                        <th>@L["Stats_Movements"]</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _turni)
                    {
                        <tr>
                            <td data-l="@L["Stats_Start"]">@t.Inizio.ToString("yyyy-MM-dd HH:mm")Z</td>
                            <td data-l="@L["Stats_Position"]">
                                <i class="dot @StatsView.PosClass(t.Callsign)"></i> @t.Callsign
                            </td>
                            <td class="cb" data-l="@L["Stats_Duration"]"
                                style="--cb:@StatsView.Quota(t.Secondi, _maxDurataTurno)">@StatsView.Durata(t.Secondi)</td>
                            <td data-l="@L["Stats_Movements"]">@t.Movimenti</td>
                            <td>
                                @if (t.Pezzi.Count == 1)
                                {
                                    <a href="/services/stats/session/@t.Pezzi[0].SessionId">@L["Stats_Detail"]</a>
                                }
                                else
                                {
                                    <details>
                                        <summary title="@L["Stats_ShiftHint"]">@L["Stats_ShiftPieces", t.Pezzi.Count]</summary>
                                        @foreach (var p in t.Pezzi)
                                        {
                                            <div>
                                                <a href="/services/stats/session/@p.SessionId">
                                                    @p.StartUtc.ToString("HH:mm")Z · @StatsView.Durata(p.DurationSeconds)
                                                </a>
                                            </div>
                                        }
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <p class="muted" style="margin-top:22px">
        @* L'esportazione è solo la PROPRIA anche per lo staff: l'endpoint legge il VID dall'identità e non
           prende parametri, di proposito (vedi il commento in VipiModuleExtensions). *@
        @if (_utente is not null && !_altrui)
        {
            <a href="/services/stats/export.csv">@L["Stats_Export"]</a><text> · </text>
        }
        @L["Stats_Disclaimer"]
        @if (Authz.IsAdmin || _classificaPubblica)
        {
            <text> · </text><a href="/services/stats/division">@L["Stats_DivisionLink"]</a>
        }
    </p>
</div>

@code {
    /// <summary>Periodo scelto dall'indirizzo (<c>?p=30</c>). Vuoto = dodici mesi.</summary>
    [SupplyParameterFromQuery(Name = "p")] public string? P { get; set; }

    /// <summary>VID guardato, dalla rotta <c>/services/stats/user/{vid}</c>. Zero sulle proprie.</summary>
    [Parameter] public int Vid { get; set; }

    /// <summary>Un turno: gli spezzoni della stessa seduta, già sommati.</summary>
    private sealed record Turno(
        DateTimeOffset Inizio, string Callsign, int Secondi, int Movimenti, IReadOnlyList<StatsSessionRow> Pezzi);

    private CurrentUser? _utente;

    /// <summary>Di CHI sono i numeri in pagina: il VID della rotta, oppure il proprio.</summary>
    private int _soggetto;

    /// <summary>Vero quando il soggetto non è chi guarda: cambia le frasi, accende la fascia, scrive l'audit.</summary>
    private bool _altrui;

    /// <summary>Ha chiesto le statistiche di un altro senza essere staff.</summary>
    private bool _vietato;

    private string? _nomeSoggetto;
    private string _titoloGriglia = "";
    private StatsTotals? _totali;
    private StatsRank? _posizione;
    private StatsStreak _striscia = new(0, 0, null);
    private IReadOnlyList<StatsByKey> _perPostazione = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _tuttePostazioni = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _perMese = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _aeroporti = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _aeroportiGestiti = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _tipi = Array.Empty<StatsByKey>();
    private IReadOnlyList<Turno> _turni = Array.Empty<Turno>();
    private IReadOnlyList<Vipi.Application.Stats.CoverageCell> _griglia = Array.Empty<Vipi.Application.Stats.CoverageCell>();
    private IReadOnlyList<StatsChipBar.Voce> _periodi = Array.Empty<StatsChipBar.Voce>();
    private IReadOnlyList<StatsBar> _barreMesi = Array.Empty<StatsBar>();
    private IReadOnlyList<StatsSlice> _fette = Array.Empty<StatsSlice>();
    private IReadOnlyList<double> _serieOre = Array.Empty<double>();
    private IReadOnlyList<double> _serieMovimenti = Array.Empty<double>();
    private DateTimeOffset? _inizioArchivio;
    private bool _classificaPubblica;
    private int? _dOre, _dTurni, _dMovimenti;
    private string _confronto = "";

    private double _maxOrePostazione, _maxOreMese, _maxVoliAeroporto, _maxVoliGestiti, _maxVoliTipo, _maxDurataTurno;

    protected override async Task OnInitializedAsync()
    {
        _utente = Utenti.Get();
        _classificaPubblica = (await Impostazioni.GetAsync()).PublicLeaderboard;

        // Chiedere il PROPRIO vid per indirizzo non è «guardare un altro»: niente fascia e niente audit.
        _soggetto = Vid > 0 ? Vid : _utente?.UserId ?? 0;
        var chiesteAltrui = Vid > 0 && Vid != _utente?.UserId;

        // La guardia sta QUI, prima di ogni query: le statistiche di un altro non si aprono indovinando il
        // VID. ⚠️ Vale anche per l'anonimo — che non è staff — e per lui il divieto è la risposta giusta:
        // «entra e poi vedrai» prometterebbe a chiunque una pagina che quasi nessuno può aprire.
        if (chiesteAltrui && !Authz.IsAdmin)
        {
            _vietato = true;
            return;
        }

        _altrui = chiesteAltrui;

        _titoloGriglia = (_altrui ? L["Stats_WhenControls"] : L["Stats_WhenYouControl"]).Value;

        var periodo = StatsView.Period(P);
        // ⚠️ I chip del periodo devono tornare sulla pagina che si sta guardando: con l'indirizzo fisso
        // «/services/stats» il primo chip premuto riportava lo staff sulle PROPRIE statistiche.
        var baseUrl = _altrui ? $"/services/stats/user/{_soggetto}" : "/services/stats";
        _periodi = StatsView.Periods
            .Select(p => new StatsChipBar.Voce(L[p.LabelKey], $"{baseUrl}?p={p.Key}", p.Key == periodo.Key))
            .ToList();

        if (_utente is null) return;

        if (_altrui)
        {
            _nomeSoggetto = (await Roster.GetDisplayNamesAsync(new[] { _soggetto }))
                .TryGetValue(_soggetto, out var nome) ? nome : null;
            await RegistroAccessi.RecordProfileViewAsync(_utente.UserId, _soggetto);
        }

        var a = DateTimeOffset.UtcNow;
        var da = a.AddDays(-periodo.Days);
        var vid = _soggetto;

        _inizioArchivio = await Stats.ArchiveStartAsync(vid);
        _totali = await Stats.TotalsAsync(vid, da, a);
        if (_totali.Sessions == 0) return;

        // ⚠️ Le prime venti in tabella, ma la CIAMBELLA si calcola su tutte: con la lista tagliata le
        // percentuali sono la ripartizione delle prime venti, non del tempo — e nessuno se ne accorge.
        _tuttePostazioni = await Stats.ByPositionAsync(vid, da, a, limit: 500);
        _perPostazione = _tuttePostazioni.Take(20).ToList();
        _perMese = await Stats.ByMonthAsync(vid, da, a);
        _aeroporti = await Stats.TopAirportsAsync(vid, da, a);
        _aeroportiGestiti = await Stats.ManagedAirportsAsync(vid, da, a);
        _tipi = await Stats.TopAircraftAsync(vid, da, a);
        _griglia = await Stats.CoverageAsync(vid, da, a);
        _striscia = await Stats.StreakAsync(vid, da, a);
        _posizione = await Stats.RankAsync(vid, da, a);

        // ⚠️ Il periodo prima è lungo QUANTO questo, e finisce dove questo comincia: confrontare trenta
        // giorni con un anno darebbe un «−96%» che non vuol dire niente.
        var prima = await Stats.TotalsAsync(vid, da.AddDays(-periodo.Days), da);
        _dOre = StatsView.Delta(_totali.Seconds, prima.Seconds);
        _dTurni = StatsView.Delta(_totali.Shifts, prima.Shifts);
        _dMovimenti = StatsView.Delta(_totali.Movements, prima.Movements);
        _confronto = L["Stats_VsPrev", periodo.Days];

        var sessioni = await Stats.SessionsAsync(vid, da, a, limit: 200);
        _turni = Turni(sessioni);

        _barreMesi = _perMese
            .Select(m => new StatsBar(
                Mese(m.Key), m.Seconds / 3600.0,
                L["Stats_MonthTitle", m.Key, StatsView.Ore(m.Seconds), m.Movements]))
            .ToList();

        _fette = _tuttePostazioni
            .GroupBy(p => StatsView.Tipo(p.Key))
            .Select(g => new StatsSlice(
                g.Key, g.Sum(x => x.Seconds), StatsView.PosClass(g.Key),
                L["Stats_SliceTitle", g.Key, StatsView.Ore(g.Sum(x => x.Seconds)), g.Sum(x => x.Sessions)]))
            .OrderByDescending(f => f.Value)
            .ToList();

        _serieOre = _perMese.Select(m => m.Seconds / 3600.0).ToList();
        _serieMovimenti = _perMese.Select(m => (double)m.Movements).ToList();

        _maxOrePostazione = _perPostazione.Count == 0 ? 0 : _perPostazione.Max(r => r.Seconds);
        _maxOreMese = _perMese.Count == 0 ? 0 : _perMese.Max(r => r.Seconds);
        _maxVoliAeroporto = _aeroporti.Count == 0 ? 0 : _aeroporti.Max(r => r.Sessions);
        _maxVoliGestiti = _aeroportiGestiti.Count == 0 ? 0 : _aeroportiGestiti.Max(r => r.Sessions);
        _maxVoliTipo = _tipi.Count == 0 ? 0 : _tipi.Max(r => r.Sessions);
        _maxDurataTurno = _turni.Count == 0 ? 0 : _turni.Max(t => t.Secondi);
    }

    /// <summary>
    /// Le connessioni raccolte nei loro turni. La chiave la porta già l'archivio (<c>ShiftKey</c>): qui si
    /// somma, si prende il callsign dello spezzone più lungo e si tiene l'ordine dal più recente.
    /// </summary>
    private static IReadOnlyList<Turno> Turni(IReadOnlyList<StatsSessionRow> sessioni) =>
        sessioni
            .GroupBy(s => s.ShiftKey)
            .Select(g => new Turno(
                g.Min(s => s.StartUtc),
                g.OrderByDescending(s => s.DurationSeconds).First().Callsign,
                g.Sum(s => s.DurationSeconds),
                g.Sum(s => s.MovementCount),
                g.OrderBy(s => s.StartUtc).ToList()))
            .OrderByDescending(t => t.Inizio)
            .ToList();

    /// <summary>«2026-08» → «08/26»: l'etichetta di una barra deve stare in trentaquattro pixel.</summary>
    private static string Mese(string chiave) =>
        chiave.Length == 7 ? $"{chiave[5..]}/{chiave[2..4]}" : chiave;
}
