@page "/services/stats"
@page "/services/stats/user/{Vid:int}"
@layout SopLayout
@using Vipi.Application.Abstractions
@using Vipi.Application.Auth
@using Vipi.Application.Stats
@inject IAtcStatsQueries Stats
@inject IStatsSettingsStore Impostazioni
@inject ICurrentUserProvider Utenti
@inject IEditAuthorizationService Authz
@inject IStaffRosterRepository Roster
@inject IStatsAccessLog RegistroAccessi
@inject IRegistroAccessi Accessi
@inject IStringLocalizer<SharedResource> L

@* Le statistiche ATC di una persona. SSR statico: è un elenco di numeri, non c'è niente da aggiornare da
   solo — come l'hub dei servizi. Il periodo sta nell'INDIRIZZO (?p=30) e non in un componente interattivo:
   così la pagina resta statica, il tasto «indietro» funziona e un periodo si può mandare a qualcuno.

   ⚠️ DUE indirizzi, una pagina sola. «/services/stats» sono le PROPRIE; «/services/stats/user/{vid}» sono
   quelle di un altro e le apre solo lo staff (`Authz.IsDivisionStaff`) — con la fascia in testa che lo dice e una
   riga nel registro di audit, perché la griglia ora×giorno racconta QUANDO una persona è online e un dato
   così non si guarda in silenzio. Due pagine gemelle si sarebbero scollate al primo grafico aggiunto a una
   sola delle due: qui cambia il VID di partenza, non il contenuto.

   Gli orari si scrivono in UTC col suffisso Z e l'ora locale la aggiunge il browser. *@

<PageTitle>@L["Stats_Title"] · vIPI IVAO Italy</PageTitle>

@* ---- La veste del 30 settembre 2026 ------------------------------------------------------------------------
   Tavole approvate dal committente (carta docs/feature/2026-09-30-statistiche-nuova-grafica.md): prima era
   un titolo grande e una tabella dopo l'altra, undici sezioni tutte uguali. Ora: chi è, cinque numeri CON il
   loro contesto, due grafici affiancati, la mappa di quando controlla, riquadri compatti, turni ripiegati.
   Ogni dato di prima ha ancora un posto (confronto campo per campo nella carta). *@

<div class="wrap stats">
    <div class="sx-top">
        @* Anche il divieto porta il titolo neutro: «Le mie statistiche ATC» sopra un «non ti è permesso» direbbe
           che sono le PROPRIE a essere negate, che è il contrario. Il tasto alla divisione ha lo stesso gate della
           pagina di destinazione — staff sempre, gli altri se la classifica è pubblica — e non è una guardia. *@
        <div class="sh-title">
            <h1 class="page-h1">@(_altrui || _vietato ? L["Stats_UserTitle"] : L["Stats_Title"])</h1>
            @if (_utente is not null && !_vietato && (Authz.IsDivisionStaff || _classificaPubblica))
            {
                <a class="btn ghost sh-go" href="/services/stats/division">
                    <Icon Name="grid" Size="15" /> @L["Stats_DivisionLink"]
                </a>
            }
        </div>
        @if (_utente is not null && !_vietato)
        {
            <StatsChipBar Voci="_periodi" Titolo="@L["Stats_Period"].Value" />
        }
    </div>

    @if (_altrui)
    {
        <div class="callout info" style="margin:14px 0 0">
            <span class="cic"><Icon Name="eye" Size="18" /></span>
            <div>
                <p class="ct">@L["Stats_StaffViewingTitle"]</p>
                @L["Stats_StaffViewingBody"] ·
                <a href="/services/stats/division">@L["Stats_BackToDivision"]</a>
            </div>
        </div>
    }

    @if (_vietato)
    {
        <p class="muted">@L["Stats_ProfileForbidden"]</p>
    }
    else if (_utente is null)
    {
        <p class="muted">@L["Stats_LoginNeeded"]</p>
    }
    else
    {
        @* Chi è. Il nome: il proprio per intero; di un altro il nome breve del registro degli accessi (chi è entrato
           nel sito), poi quello del roster (staff), e se non c'è nessuno dei due il solo VID — nessun ripiego
           inventato, il VID è già un link al profilo IVAO dove il nome c'è. *@
        <section class="sx-card sx-id">
            <span class="sx-av" aria-hidden="true">@Iniziali(_nomeMostrato)</span>
            <div class="sx-who">
                @* Senza nome il VID È il nome, ed è il link al profilo: scritto due volte diceva la stessa cosa. *@
                <div class="sx-name">
                    @if (_nomeMostrato is null) { <VidLink Vid="_soggetto" /> } else { @_nomeMostrato }
                </div>
                <div class="sx-tags">
                    @if (_nomeMostrato is not null) { <VidLink Vid="_soggetto" /> }
                    @if (_perPostazione.Count > 0)
                    {
                        <span class="sx-tag" title="@L["Stats_FavPosition"]">@L["Stats_FavPosition"] @_perPostazione[0].Key</span>
                    }
                    @if (_totali is { Sessions: > 0 })
                    {
                        <span class="sx-tag @(_striscia.CurrentWeeks >= 4 ? "gold" : "")" title="@L["Stats_StreakBest", _striscia.BestWeeks]">
                            @L["Stats_StreakLabel"]: @(_striscia.CurrentWeeks > 0 ? _striscia.CurrentWeeks.ToString() : L["Stats_StreakNone"].Value)
                        </span>
                    }
                </div>
            </div>
            @if (_posizione is { Position: > 0 } rango)
            {
                <div class="sx-rank" title="@L["Stats_TopPercent", rango.TopPercent]">
                    <b>@(rango.Position)°</b>
                    <span>@L["Stats_RankOf", rango.Total]</span>
                </div>
            }
        </section>

        if (_totali is null || _totali.Sessions == 0)
        {
            <div class="stat-empty">
                <b>@L["Stats_EmptyTitle"]</b>
                <p>
                    @if (_altrui) { <text>@L["Stats_UserEmpty"]</text> }
                    else { <text>@(_inizioArchivio is null ? L["Stats_Empty"] : L["Stats_EmptyPeriod"])</text> }
                </p>
                @if (_inizioArchivio is { } inizio)
                {
                    <p class="muted">@L["Stats_ArchiveFrom", inizio.ToString("yyyy-MM-dd")]</p>
                }
            </div>
        }
        else
        {
            @* Cinque numeri, ognuno col suo contesto. Su 30 e 90 giorni il confronto col periodo prima (la freccia);
               su 12 mesi e «tutto» il periodo prima non esiste — la sorgente conserva dodici mesi — e il riferimento
               è la media della divisione per controllore (decisione del committente, 30 settembre 2026). *@
            <div class="kpi-grid">
                <StatsKpi Valore="@StatsView.Ore(_totali.Seconds)" Unita="h" Etichetta="@L["Stats_Hours"].Value"
                          Delta="@(_confrontoPrima ? _dOre : null)" DeltaHint="@_confronto"
                          Nota="@(_confrontoPrima ? null : L["Stats_AvgDivision", _mediaOre].Value)" />
                <StatsKpi Valore="@_totali.Shifts.ToString()" Etichetta="@L["Stats_Shifts"].Value"
                          Delta="@(_confrontoPrima ? _dTurni : null)" DeltaHint="@_confronto"
                          Nota="@(_confrontoPrima ? null : L["Stats_AvgDivision", _mediaTurni].Value)" />
                <StatsKpi Valore="@_totali.Movements.ToString()" Etichetta="@L["Stats_Movements"].Value"
                          Delta="@(_confrontoPrima ? _dMovimenti : null)" DeltaHint="@_confronto"
                          Nota="@(_confrontoPrima ? null : L["Stats_AvgDivision", _mediaMovimenti].Value)" />
                <StatsKpi Valore="@_totali.Presences.ToString()" Etichetta="@L["Stats_Presences"].Value"
                          Nota="@L["Stats_PresencesHint"].Value" />
                <StatsKpi Valore="@_durataMedia" Etichetta="@L["Stats_AvgShift"].Value"
                          Nota="@(_durataMediaDivisione is null ? null : L["Stats_AvgShiftDivision", _durataMediaDivisione].Value)" />
            </div>

            <div class="sx-row">
                <section class="sx-card">
                    <div class="sx-head">
                        <h2 class="sx-h">@L["Stats_MonthChart"]</h2>
                        <span class="muted">@L["Stats_MonthHover"]</span>
                    </div>
                    <StatsBars Barre="_barreMesi" Titolo="@L["Stats_MonthChart"].Value" />
                </section>
                <section class="sx-card">
                    <h2 class="sx-h">@(_altrui ? L["Stats_WhereOther"] : L["Stats_Where"])</h2>
                    @* La ripartizione per tipo: una barra sola al posto della ciambella, sul tempo di TUTTE le
                       postazioni — con la lista tagliata le quote sarebbero delle prime venti, non del tempo. *@
                    <div class="sx-split" role="img" aria-label="@L["Stats_PositionShare"]">
                        @foreach (var f in _fette)
                        {
                            <i class="@f.CssClass" style="width:@StatsView.Quota(f.Value, _totaleFette)" title="@f.Title"></i>
                        }
                    </div>
                    <div class="sx-legend">
                        @foreach (var f in _fette)
                        {
                            <span><i class="@f.CssClass"></i><b>@f.Label</b> @Percento(f.Value, _totaleFette)</span>
                        }
                    </div>
                    <ul class="sx-list">
                        @foreach (var p in _perPostazione.Take(6))
                        {
                            <li class="sx-hr">
                                <span class="k">@p.Key</span>
                                <span class="sx-bar"><i class="@StatsView.PosClass(p.Key)" style="width:@StatsView.Quota(p.Seconds, _maxOrePostazione)"></i></span>
                                <span class="v">@StatsView.Ore(p.Seconds) h</span>
                                <span class="d">@L["Stats_PositionDetail", p.Sessions, p.Movements]</span>
                            </li>
                        }
                    </ul>
                    @if (_perPostazione.Count > 6)
                    {
                        <details>
                            <summary>@L["Stats_AllPositions", _tuttePostazioni.Count]</summary>
                            <ul class="sx-list">
                                @foreach (var p in _perPostazione.Skip(6))
                                {
                                    <li class="sx-hr">
                                        <span class="k">@p.Key</span>
                                        <span class="sx-bar"><i class="@StatsView.PosClass(p.Key)" style="width:@StatsView.Quota(p.Seconds, _maxOrePostazione)"></i></span>
                                        <span class="v">@StatsView.Ore(p.Seconds) h</span>
                                        <span class="d">@L["Stats_PositionDetail", p.Sessions, p.Movements]</span>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </section>
            </div>

            @* ⚠️ La griglia ora × giorno era stata tolta di qui il 25 agosto 2026 (illeggibile con i numeri dentro) e
               sostituita dai due grafici «a che ora» e «che giorno». Il 30 settembre il committente l'ha riportata:
               senza numeri nelle caselle, con le ore di ogni giorno a destra. La frase in testa resta il riassunto. *@
            <section class="sx-card sx-block">
                <div class="sx-head">
                    <h2 class="sx-h">@_titoloGriglia</h2>
                    @if (_profilo.HasPeak)
                    {
                        <span class="muted">
                            @(_altrui
                                ? L["Stats_TypicalOther", _profilo.PeakFromHour, _profilo.PeakToHour, _nomeGiornoPieno]
                                : L["Stats_TypicalYou", _profilo.PeakFromHour, _profilo.PeakToHour, _nomeGiornoPieno])
                        </span>
                    }
                </div>
                <CoverageHeatmap Celle="_griglia" Copertura="false" Numeri="false" Titolo="@_titoloGriglia"
                                 Totali="_oreGiorno" TitoloTotali="@L["Stats_DayTotal"].Value" />
                <div class="cov-legend">
                    <span>@L["Stats_HeatLess"]</span>
                    <i class="cov-q1"></i><i class="cov-q2"></i><i class="cov-q3"></i><i class="cov-q4"></i>
                    <span>@L["Stats_HeatMore"]</span>
                </div>
            </section>

            @* ⚠️ Le due domande sugli aeroporti sono OPPOSTE e stanno nello stesso riquadro, una sopra l'altra con la
               loro spiegazione: i campi che si coprivano, e quelli che passano davanti. *@
            <div class="sx-row half">
                <section class="sx-card">
                    <h2 class="sx-h">@L["Stats_AirportsCard"]</h2>
                    <div class="sx-sub">@L["Stats_ManagedAirports"]</div>
                    <p class="muted">@L["Stats_ManagedAirportsHint"]</p>
                    @if (_aeroportiGestiti.Count == 0)
                    {
                        <p class="muted">@L["Stats_ManagedAirportsNone"]</p>
                    }
                    else
                    {
                        <ul class="sx-list">
                            @foreach (var r in _aeroportiGestiti)
                            {
                                <li class="sx-hr">
                                    <span class="k">@r.Key</span>
                                    <span class="sx-bar"><i style="width:@StatsView.Quota(r.Sessions, _maxVoliGestiti)"></i></span>
                                    <span class="v">@L["Stats_FlightsMov", r.Sessions, r.Movements]</span>
                                </li>
                            }
                        </ul>
                    }
                    <div class="sx-sub">@L["Stats_TopAirports"]</div>
                    <p class="muted">@L["Stats_SeenAirportsHint"]</p>
                    <div class="sx-chips">
                        @foreach (var r in _aeroporti)
                        {
                            <span title="@L["Stats_FlightsMov", r.Sessions, r.Movements]">@r.Key @r.Sessions · @r.Movements</span>
                        }
                    </div>
                </section>
                <section class="sx-card">
                    <h2 class="sx-h">@L["Stats_TopAircraft"]</h2>
                    <ul class="sx-list">
                        @foreach (var r in _tipi)
                        {
                            <li class="sx-hr">
                                <span class="k">@r.Key</span>
                                <span class="sx-bar"><i style="width:@StatsView.Quota(r.Sessions, _maxVoliTipo)"></i></span>
                                <span class="v">@L["Stats_FlightsMov", r.Sessions, r.Movements]</span>
                            </li>
                        }
                    </ul>
                </section>
            </div>

            @* ⚠️ Un TURNO per riga, non una connessione: sul dato vero il 38% delle connessioni sono spezzoni di una
               caduta di linea. Gli ultimi dieci in vista, gli altri sotto «Mostra tutti»: prima erano oltre cento
               righe aperte in fondo alla pagina. *@
            <section class="sx-card sx-block">
                <div class="sx-head">
                    <h2 class="sx-h">@L["Stats_LastShifts"]</h2>
                    <span class="muted">@L["Stats_ShiftsInPeriod", _totali.Shifts]</span>
                </div>
                @TabellaTurni(_turni.Take(10))
                @if (_turni.Count > 10)
                {
                    <details>
                        <summary>@L["Stats_ShowAllShifts", _turni.Count]</summary>
                        @TabellaTurni(_turni.Skip(10))
                    </details>
                }
            </section>
        }
    }

    @* ⚠️ Qui c'era l'esportazione CSV delle proprie sessioni, tolta il 25 agosto 2026 su richiesta del
       committente — tasto E meccanismo. *@
    <p class="muted" style="margin-top:22px">@L["Stats_Disclaimer"]</p>
</div>

@code {
    /// <summary>Periodo scelto dall'indirizzo (<c>?p=30</c>). Vuoto = dodici mesi.</summary>
    [SupplyParameterFromQuery(Name = "p")] public string? P { get; set; }

    /// <summary>VID guardato, dalla rotta <c>/services/stats/user/{vid}</c>. Zero sulle proprie.</summary>
    [Parameter] public int Vid { get; set; }

    /// <summary>Un turno: gli spezzoni della stessa seduta, già sommati.</summary>
    private sealed record Turno(
        DateTimeOffset Inizio, string Callsign, int Secondi, int Movimenti, IReadOnlyList<StatsSessionRow> Pezzi);

    private CurrentUser? _utente;

    /// <summary>Di CHI sono i numeri in pagina: il VID della rotta, oppure il proprio.</summary>
    private int _soggetto;

    /// <summary>Vero quando il soggetto non è chi guarda: cambia le frasi, accende la fascia, scrive l'audit.</summary>
    private bool _altrui;

    /// <summary>Ha chiesto le statistiche di un altro senza essere staff.</summary>
    private bool _vietato;

    private string? _nomeSoggetto;
    private string _titoloGriglia = "";
    private StatsTotals? _totali;
    private StatsRank? _posizione;
    private StatsStreak _striscia = new(0, 0, null);
    private IReadOnlyList<StatsByKey> _perPostazione = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _tuttePostazioni = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _perMese = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _aeroporti = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _aeroportiGestiti = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _tipi = Array.Empty<StatsByKey>();
    private IReadOnlyList<Turno> _turni = Array.Empty<Turno>();
    private IReadOnlyList<Vipi.Application.Stats.CoverageCell> _griglia = Array.Empty<Vipi.Application.Stats.CoverageCell>();
    private HourDayProfile _profilo = new(Array.Empty<int>(), Array.Empty<int>(), -1, -1, 0, 0);
    private string _nomeGiornoPieno = "";
    private IReadOnlyList<StatsBar> _barreOre = Array.Empty<StatsBar>();
    private IReadOnlyList<StatsBar> _barreGiorni = Array.Empty<StatsBar>();
    private IReadOnlyList<StatsChipBar.Voce> _periodi = Array.Empty<StatsChipBar.Voce>();
    private IReadOnlyList<StatsBar> _barreMesi = Array.Empty<StatsBar>();
    private IReadOnlyList<StatsSlice> _fette = Array.Empty<StatsSlice>();
    private DateTimeOffset? _inizioArchivio;
    private bool _classificaPubblica;
    private int? _dOre, _dTurni, _dMovimenti;
    private string _confronto = "";

    private double _maxOrePostazione, _maxOreMese, _maxVoliAeroporto, _maxVoliGestiti, _maxVoliTipo, _maxDurataTurno;

    /// <summary>Il nome in testata: il proprio per intero, di un altro il nome breve o quello del roster.</summary>
    private string? _nomeMostrato;

    /// <summary>Vero su 30 e 90 giorni: lì il periodo prima esiste e si confronta. Su 12 mesi e «tutto» no — la
    /// sorgente conserva dodici mesi — e il riferimento è la media della divisione per controllore.</summary>
    private bool _confrontoPrima;

    private string _mediaOre = "", _mediaTurni = "", _mediaMovimenti = "", _durataMedia = "—";
    private string? _durataMediaDivisione;
    private double _totaleFette;

    /// <summary>Le ore di ogni giorno, lunedì prima, per la colonna in fondo alla mappa.</summary>
    private IReadOnlyList<string> _oreGiorno = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        _utente = Utenti.Get();
        _classificaPubblica = (await Impostazioni.GetAsync()).PublicLeaderboard;

        // Chiedere il PROPRIO vid per indirizzo non è «guardare un altro»: niente fascia e niente audit.
        _soggetto = Vid > 0 ? Vid : _utente?.UserId ?? 0;
        var chiesteAltrui = Vid > 0 && Vid != _utente?.UserId;

        // La guardia sta QUI, prima di ogni query: le statistiche di un altro non si aprono indovinando il
        // VID. ⚠️ Vale anche per l'anonimo — che non è staff — e per lui il divieto è la risposta giusta:
        // «entra e poi vedrai» prometterebbe a chiunque una pagina che quasi nessuno può aprire.
        if (chiesteAltrui && !Authz.IsDivisionStaff)
        {
            _vietato = true;
            return;
        }

        _altrui = chiesteAltrui;

        _titoloGriglia = (_altrui ? L["Stats_WhenControls"] : L["Stats_WhenYouControl"]).Value;

        var periodo = StatsView.Period(P);
        // ⚠️ I chip del periodo devono tornare sulla pagina che si sta guardando: con l'indirizzo fisso
        // «/services/stats» il primo chip premuto riportava lo staff sulle PROPRIE statistiche.
        var baseUrl = _altrui ? $"/services/stats/user/{_soggetto}" : "/services/stats";
        _periodi = StatsView.Periods
            .Select(p => new StatsChipBar.Voce(L[p.LabelKey], $"{baseUrl}?p={p.Key}", p.Key == periodo.Key))
            .ToList();

        if (_utente is null) return;

        if (_altrui)
        {
            _nomeSoggetto = (await Roster.GetDisplayNamesAsync(new[] { _soggetto }))
                .TryGetValue(_soggetto, out var nome) ? nome : null;
            await RegistroAccessi.RecordProfileViewAsync(_utente.UserId, _soggetto);
            // Il nome breve di chi è entrato nel sito prima di quello del roster: vale per chiunque, non solo staff.
            var brevi = await Accessi.NomiBreviAsync(new[] { _soggetto });
            _nomeMostrato = brevi.TryGetValue(_soggetto, out var breve) ? breve : _nomeSoggetto;
        }
        else
        {
            _nomeMostrato = _utente.Name;
        }

        var a = DateTimeOffset.UtcNow;
        var da = a.AddDays(-periodo.Days);
        var vid = _soggetto;

        _inizioArchivio = await Stats.ArchiveStartAsync(vid);
        _totali = await Stats.TotalsAsync(vid, da, a);
        if (_totali.Sessions == 0) return;

        // ⚠️ Le prime venti in tabella, ma la CIAMBELLA si calcola su tutte: con la lista tagliata le
        // percentuali sono la ripartizione delle prime venti, non del tempo — e nessuno se ne accorge.
        _tuttePostazioni = await Stats.ByPositionAsync(vid, da, a, limit: 500);
        _perPostazione = _tuttePostazioni.Take(20).ToList();
        _perMese = await Stats.ByMonthAsync(vid, da, a);
        _aeroporti = await Stats.TopAirportsAsync(vid, da, a);
        _aeroportiGestiti = await Stats.ManagedAirportsAsync(vid, da, a);
        _tipi = await Stats.TopAircraftAsync(vid, da, a);
        _griglia = await Stats.CoverageAsync(vid, da, a);
        _profilo = HourDayProfileBuilder.Build(_griglia);
        _nomeGiornoPieno = _profilo.BusiestDay > 0 ? L[$"Day_{_profilo.BusiestDay}_Full"].Value : "";
        // ⚠️ L'etichetta dell'ora si scrive solo ogni tre colonne: ventiquattro numeri in fila su mezza
        // pagina si sovrappongono, e un'etichetta illeggibile è peggio di nessuna etichetta.
        _barreOre = Enumerable.Range(0, 24)
            .Select(h => new StatsBar(
                h % 3 == 0 ? h.ToString("00") : "",
                _profilo.PerHour[h] / 60.0,
                L["Stats_HourTitle", h.ToString("00"), ((h + 1) % 24).ToString("00"),
                  StatsView.Ore(_profilo.PerHour[h] * 60L)]))
            .ToList();
        _barreGiorni = Enumerable.Range(1, 7)
            .Select(g => new StatsBar(
                L[$"Day_{g}"].Value,
                _profilo.PerDay[g - 1] / 60.0,
                L["Stats_DayTitle", L[$"Day_{g}_Full"].Value, StatsView.Ore(_profilo.PerDay[g - 1] * 60L)],
                Highlight: g == _profilo.BusiestDay))
            .ToList();
        _striscia = await Stats.StreakAsync(vid, da, a);
        _posizione = await Stats.RankAsync(vid, da, a);

        // ⚠️ Il periodo prima è lungo QUANTO questo, e finisce dove questo comincia: confrontare trenta
        // giorni con un anno darebbe un «−96%» che non vuol dire niente.
        var prima = await Stats.TotalsAsync(vid, da.AddDays(-periodo.Days), da);
        _confrontoPrima = periodo.Days <= 90;
        _dOre = StatsView.Delta(_totali.Seconds, prima.Seconds);
        _dTurni = StatsView.Delta(_totali.Shifts, prima.Shifts);
        _dMovimenti = StatsView.Delta(_totali.Movements, prima.Movements);
        _confronto = L["Stats_VsPrev", periodo.Days];

        // La media della divisione per controllore, e la durata media di un turno: il contesto dei numeri. ⚠️ I
        // controllori sono quelli della classifica (almeno un turno nel periodo), non tutti i membri.
        var divisione = await Stats.TotalsAsync(null, da, a);
        var controllori = Math.Max(1, _posizione.Total);
        _mediaOre = StatsView.Ore(divisione.Seconds / controllori);
        _mediaTurni = Math.Round(divisione.Shifts / (double)controllori).ToString("0");
        _mediaMovimenti = (divisione.Movements / (double)controllori).ToString("0.#");
        _durataMedia = _totali.Shifts > 0 ? StatsView.Durata((int)(_totali.Seconds / _totali.Shifts)) : "—";
        _durataMediaDivisione = divisione.Shifts > 0 ? StatsView.Durata((int)(divisione.Seconds / divisione.Shifts)) : null;
        _oreGiorno = Enumerable.Range(0, 7).Select(g => StatsView.Ore(_profilo.PerDay[g] * 60L) + " h").ToList();

        var sessioni = await Stats.SessionsAsync(vid, da, a, limit: 200);
        _turni = Turni(sessioni);

        _barreMesi = _perMese
            .Select(m => new StatsBar(
                StatsView.Mese(m.Key), m.Seconds / 3600.0,
                L["Stats_MonthTitle", m.Key, StatsView.Ore(m.Seconds), m.Sessions, m.Movements]))
            .ToList();

        _fette = _tuttePostazioni
            .GroupBy(p => StatsView.Tipo(p.Key))
            .Select(g => new StatsSlice(
                g.Key, g.Sum(x => x.Seconds), StatsView.PosClass(g.Key),
                L["Stats_SliceTitle", g.Key, StatsView.Ore(g.Sum(x => x.Seconds)), g.Sum(x => x.Sessions)]))
            .OrderByDescending(f => f.Value)
            .ToList();
        _totaleFette = _fette.Sum(f => f.Value);

        // ⚠️ Etichetta e frase stanno sul PUNTO, non in un elenco a parte: la sparkline deve poter dire
        // «08/26: 12,4 h» senza che due liste debbano restare allineate a mano.

        _maxOrePostazione = _perPostazione.Count == 0 ? 0 : _perPostazione.Max(r => r.Seconds);
        _maxOreMese = _perMese.Count == 0 ? 0 : _perMese.Max(r => r.Seconds);
        _maxVoliAeroporto = _aeroporti.Count == 0 ? 0 : _aeroporti.Max(r => r.Sessions);
        _maxVoliGestiti = _aeroportiGestiti.Count == 0 ? 0 : _aeroportiGestiti.Max(r => r.Sessions);
        _maxVoliTipo = _tipi.Count == 0 ? 0 : _tipi.Max(r => r.Sessions);
        _maxDurataTurno = _turni.Count == 0 ? 0 : _turni.Max(t => t.Secondi);
    }

    private static string Percento(double v, double tot) =>
        tot <= 0 ? "0%" : Math.Round(v / tot * 100).ToString("0") + "%";

    /// <summary>Due iniziali per il tondo della testata: «Mario Rossi» → «MR», «Mario R.» → «MR»; senza nome, «#».</summary>
    private static string Iniziali(string? nome)
    {
        var parole = (nome ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(w => char.IsLetter(w[0])).ToList();
        return parole.Count == 0 ? "#"
            : string.Concat(parole.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    /// <summary>La tabella dei turni: la stessa per i primi dieci e per quelli sotto «Mostra tutti».</summary>
    private RenderFragment TabellaTurni(IEnumerable<Turno> turni) => @<table class="res-table tbl-cards">
        <thead>
            <tr>
                <th>@L["Stats_Start"]</th><th>@L["Stats_Position"]</th><th>@L["Stats_Duration"]</th>
                <th>@L["Stats_Movements"]</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in turni)
            {
                <tr>
                    <td data-l="@L["Stats_Start"]">@t.Inizio.ToString("yyyy-MM-dd HH:mm")Z</td>
                    <td data-l="@L["Stats_Position"]"><i class="dot @StatsView.PosClass(t.Callsign)"></i> @t.Callsign</td>
                    <td class="cb" data-l="@L["Stats_Duration"]"
                        style="--cb:@StatsView.Quota(t.Secondi, _maxDurataTurno)">@StatsView.Durata(t.Secondi)</td>
                    <td data-l="@L["Stats_Movements"]">@t.Movimenti</td>
                    <td>
                        @if (t.Pezzi.Count == 1)
                        {
                            <a href="/services/stats/session/@t.Pezzi[0].SessionId">@L["Stats_Detail"]</a>
                        }
                        else
                        {
                            <details>
                                <summary title="@L["Stats_ShiftHint"]">@L["Stats_ShiftPieces", t.Pezzi.Count]</summary>
                                @foreach (var p in t.Pezzi)
                                {
                                    <div>
                                        <a href="/services/stats/session/@p.SessionId">
                                            @p.StartUtc.ToString("HH:mm")Z · @StatsView.Durata(p.DurationSeconds)
                                        </a>
                                    </div>
                                }
                            </details>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>;

    /// <summary>
    /// Le connessioni raccolte nei loro turni. La chiave la porta già l'archivio (<c>ShiftKey</c>): qui si
    /// somma, si prende il callsign dello spezzone più lungo e si tiene l'ordine dal più recente.
    /// </summary>
    private static IReadOnlyList<Turno> Turni(IReadOnlyList<StatsSessionRow> sessioni) =>
        sessioni
            .GroupBy(s => s.ShiftKey)
            .Select(g => new Turno(
                g.Min(s => s.StartUtc),
                g.OrderByDescending(s => s.DurationSeconds).First().Callsign,
                g.Sum(s => s.DurationSeconds),
                g.Sum(s => s.MovementCount),
                g.OrderBy(s => s.StartUtc).ToList()))
            .OrderByDescending(t => t.Inizio)
            .ToList();
}
