@page "/vsop/{Acc}/live-app"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject IAppDocumentService AppDoc
@inject IAccDerivationService AccProfile
@inject IAccDocumentService AccDoc
@inject ITopologyProvider Topology
@inject IOnlineAtcProvider Online
@inject ITransferService Transfers
@inject ICurrentUserProvider Users
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else if (_app.Length == 0)
{
    <div class="wrap"><div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["AppLive_MissingPosTitle"]</p>@((MarkupString)L["AppLive_MissingPosBody"].Value)</div></div></div>
}
else
{
    <PageTitle>@_displayName — @L["Live_Tab"] · vIPI IVAO Italia</PageTitle>
    <div class="wrap">
        <div class="breadcrumb">
            <a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_acc.Code</a> › <b>@L["Live_Tab"] · @_app</b>
        </div>

        <div class="reduced-top">
            <h2 style="margin:0">@_displayName — @L["Live_Tab"]</h2>
            <span class="live-badge" style="display:inline-flex;align-items:center;gap:6px;margin-left:auto;background:#dafbe7;color:#1a7f37;padding:3px 10px;border-radius:999px;font-size:13px;font-weight:700">
                <span class="dot" style="width:8px;height:8px;border-radius:50%;background:#1a7f37;display:inline-block"></span>
                Live · @_app
            </span>
        </div>

        <div class="reduced-controls" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:8px 0 14px">
            @if (_myCallsign is not null)
            {
                <span class="xo-chip on" style="background:#dafbe7;color:#1a7f37;padding:3px 10px;border-radius:999px;font-size:13px;font-weight:700"
                      title="@L["Live_DetectedFromIvao"]">🟢 @L["Common_ConnectedAsN", _myCallsign]</span>
            }
            <span class="muted" style="font-size:13px">
                @L["Live_AtcOnlineN", _snapshot.Callsigns.Count] ·
                @L["AppLive_UpdatedAt", (_snapshot.AsOf == DateTimeOffset.MinValue ? "—" : _snapshot.AsOf.ToLocalTime().ToString("HH:mm:ss"))]
            </span>
            <a class="btn ghost" href="@_extendedHref" style="margin-left:auto">@L["Live_ExtendedDoc"]</a>
        </div>

        @if (!_standalone && _remBlock is null)
        {
            @* Come sulla vista live ACC: nessun documento non vuol dire nessuna informazione. Trasferimenti e
               frequenza della posizione escono dai cataloghi; manca solo il contenuto editoriale. *@
            <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["Appn_AppNotFoundTitle"]</p>@((MarkupString)string.Format(L["AppLive_NoDocBody"], _app))</div></div>
        }
        else
        {
            <div class="callout info"><span class="cic">⚡</span><div><p class="ct">@L["AppLive_InfoTitle"]</p>@L["AppLive_InfoBody"] @(_standalone ? L["AppLive_Standalone"] : L["AppLive_Remotized"])</div></div>
        }

        <div class="red-top-grid">
            @* Chiuse alla prima apertura, poi data-persist ricorda la scelta (come sulla vista live ACC). *@
            <details class="acc-item" data-persist="live-app-freq">
                <summary><span>📻 @L["Common_Frequencies"]</span><span class="tag-state tag-covered">@(_standalone ? _freqs.Count : _remFreqs?.Count ?? 0)</span></summary>
                <div class="body">
                    @if (_standalone)
                    {
                        <AppFrequencies Rows="_freqs" />
                    }
                    else if (_remBlock is not null)
                    {
                        <AccSectionBody Block="_remBlock" Key="frequencies" Root="_root" Freqs="_remFreqs" />
                    }
                    else if (_remFreqs is { Count: > 0 })
                    {
                        @* Senza blocco non c'è sezione documentale da rendere: solo le righe derivate. *@
                        <AppFrequencies Rows="_remFreqs" />
                    }
                </div>
            </details>

            @if (_airportIcao is not null)
            {
                <details class="acc-item" open data-persist="live-app-apt">
                    <summary><span><Icon Name="plane-landing" /> @L["Common_AptQuickView"]</span><span class="tag-state tag-covered">@_airportIcao</span></summary>
                    <div class="body">
                        <p class="muted" style="font-size:13px;margin-top:0">@L["AppLive_AptDocHint"]</p>
                        <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/airports?icao=@_airportIcao">@L["AppLive_OpenAptVipi", _airportIcao]</a>
                    </div>
                </details>
            }
        </div>

        <details class="acc-item" data-persist="live-app-coord">
            <summary><span>🤝 @L["Common_Coordination"]</span></summary>
            <div class="body">
                @if (_standalone)
                {
                    <AppCoordinationView Coord="_coord" />
                }
                else if (_remBlock is not null)
                {
                    <AccSectionBody Block="_remBlock" Key="coordination" Root="_root" Coord="_remCoord" />
                }
            </div>
        </details>

        <div class="block">
            <h3 style="margin-top:0"><Icon Name="refresh" /> @L["Live_TransfersTitle"]</h3>
            <TransfersLive Flows="_resolved" EmptyText="@L["AppLive_NoCoordToPos"]" />
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? App { get; set; }

    private AccInfo? _acc;
    private string _app = "";
    private string _displayName = "";
    private string? _airportIcao;
    private string _extendedHref = "";
    private bool _standalone;
    private string? _root;

    // standalone
    private List<AppFreqRow> _freqs = new();
    private AppCoordination _coord = AppCoordination.Empty;

    // remotized (blocco della vIPI ACC)
    private AccBlock? _remBlock;
    private List<AppFreqRow>? _remFreqs;
    private AccCoordination? _remCoord;

    private Topology? _topo;
    private OnlineAtcSnapshot _snapshot = OnlineAtcSnapshot.Empty;
    private IReadOnlyList<ResolvedTransferFlow> _resolved = Array.Empty<ResolvedTransferFlow>();
    private string? _myCallsign;

    private DotNetObjectReference<AppLivePage>? _ref;

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _app = (App ?? "").Trim().ToUpperInvariant();
        if (_app.Length == 0) return;

        // Tipo di APP (standalone vs remotizzato) dalla struttura settori dell'ACC.
        var data = await Structure.LoadAsync(_acc.Code);
        var sectors = data?.Sectors ?? (IReadOnlyList<SectorRow>)Array.Empty<SectorRow>();
        var row = sectors.FirstOrDefault(s => string.Equals(s.Callsign, _app, StringComparison.OrdinalIgnoreCase));
        _standalone = row is { Type: SectorType.App, ApproachKind: ApproachKind.Standalone };
        _airportIcao = row?.AirportIcao ?? (_app.Contains('_') ? _app.Split('_', 2)[0] : null);

        var roots = await AccProfile.ListTreeRootsAsync(Acc);
        _root = roots.Count > 0 ? roots[0].Callsign : null;

        _topo = await Topology.BuildByAccCodeAsync(_acc.Code);

        _snapshot = Online.GetCurrent();
        _myCallsign = Users.Get() is { } u
            ? _snapshot.Details.FirstOrDefault(d => d.UserId == u.UserId)?.Callsign
            : null;

        if (_standalone)
        {
            var identity = await AppDoc.GetIdentityAsync(_app);
            _displayName = identity is null || string.IsNullOrWhiteSpace(identity.Title) ? _app : identity.Title;
            _extendedHref = $"/vsop/{Acc.ToLowerInvariant()}/apps/vipi?app={_app}";
        }
        else
        {
            // Remotizzato: cerca il blocco gruppo-APP che contiene questo callsign nella vIPI di ACC (storage su Document).
            var acc = await AccDoc.LoadForViewAsync(_acc.Code);
            _remBlock = acc?.Blocks.Select(b => b.Block).FirstOrDefault(b => b.Kind == AccBlockKind.AppGroup
                && b.MemberCallsigns.Contains(_app, StringComparer.OrdinalIgnoreCase));
            _displayName = _remBlock?.Title ?? _app;
            _extendedHref = $"/vsop/{Acc.ToLowerInvariant()}/vipi";
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_acc is null || _app.Length == 0) return;

        _snapshot = Online.GetCurrent();
        var online = new HashSet<string>(_snapshot.Callsigns, StringComparer.OrdinalIgnoreCase);

        if (_standalone)
        {
            _freqs = (await AppDoc.DeriveFrequenciesAsync(_app)).ToList();
            _coord = await AppDoc.DeriveCoordinationAsync(_app);
        }
        else if (_remBlock is not null)
        {
            _remFreqs = (await AccProfile.DeriveFrequenciesAsync(_acc.Code, _remBlock, _root)).ToList();
            _remCoord = await AccProfile.DeriveCoordinationAsync(_acc.Code, _remBlock, _root);
        }
        else
        {
            // Remotizzato ma non ancora messo in nessun gruppo-APP della vIPI: almeno la propria frequenza,
            // derivata dal catalogo con un blocco sintetico (stessa derivazione, raggruppamento assente).
            var solo = new AccBlock { Key = "fallback:self", Kind = AccBlockKind.AppGroup, MemberCallsigns = { _app } };
            _remFreqs = (await AccProfile.DeriveFrequenciesAsync(_acc.Code, solo, _root)).ToList();
        }

        // Trasferimenti dell'ACC filtrati al dominio della posizione APP (i suoi settori + eventuali torri sotto).
        var all = await Transfers.ResolveForAccAsync(_acc.Code, online);
        var domain = _topo?.DomainOf(_app) ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase) { _app };
        _resolved = all.Where(r => domain.Contains(r.Flow.OwningSectorCallsign)).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vipiLive.subscribe", _ref);
        }

        // Vedi AccLivePage: i <details> ricreati a un tick live perderebbero la persistenza del collasso.
        try { await JS.InvokeVoidAsync("vipiWireCollapse"); } catch (JSDisconnectedException) { /* circuito chiuso */ }
    }

    [JSInvokable]
    public async Task OnLiveUpdate()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("vipiLive.unsubscribe"); } catch { /* circuito chiuso */ }
        _ref?.Dispose();
    }
}
