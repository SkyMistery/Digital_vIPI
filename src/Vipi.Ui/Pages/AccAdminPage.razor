    }

    private async Task SaveLimits(int id)
    {
        _busy = true; _msg = null; _ok = null;
        try
        {
            await Acc.SetSubcenterLimitsAsync(id, _lower.GetValueOrDefault(id), _upper.GetValueOrDefault(id));
            _dirtyLimits.Remove(id);   // prima del ricarico: è lui a decidere cosa resta pendente
            await ReloadAsync();
            _ok = L["AccAdmin_LimitsSaved"];
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Salva in un giro tutti i limiti modificati. Una riga che fallisce non ferma le altre e RESTA
    /// pendente: sparire dal contatore senza essere stata scritta sarebbe la stessa perdita silenziosa di prima.</summary>
    private async Task SaveAllLimits()
    {
        _busy = true; _msg = null; _ok = null;
        var saved = 0;
        try
        {
            foreach (var id in _dirtyLimits.ToList())
            {
                try
                {
                    await Acc.SetSubcenterLimitsAsync(id, _lower.GetValueOrDefault(id), _upper.GetValueOrDefault(id));
                    _dirtyLimits.Remove(id);
                    saved++;
                }
                catch (EditNotAllowedException ex) { _msg = ex.Message; break; }
                catch (InvalidOperationException ex) { _msg = ex.Message; }
            }
            await ReloadAsync();
            // «1 settori salvati» è il genere di dettaglio che fa sembrare la pagina scritta da nessuno:
            // a uno solo vale il messaggio del salvataggio per riga, che è già la frase giusta.
            if (saved == 1) _ok = L["AccAdmin_LimitsSaved"];
            else if (saved > 1) _ok = string.Format(L["AccAdmin_LimitsSavedN"].Value, saved);
        }
        finally { _busy = false; }
    }
}
