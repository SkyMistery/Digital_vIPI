@page "/vsop/admin/acc"
@layout SopLayout
@rendermode InteractiveServer
@using Microsoft.Extensions.Logging
@inject IAccAdminService Acc
@inject IEditAuthorizationService Authz
@inject ILogger<AccAdminPage> Logger
@inject IStringLocalizer<SharedResource> L

<PageTitle>ACC · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <a href="/vsop/admin/sectorstructure">@L["Struct_Title"]</a> › <b>ACC</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">ACC</h2><span class="muted">@L["AccAdmin_Subtitle"]</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else
    {
        @if (_msg is not null)
        {
            <div class="callout warning"><span class="cic">⚠️</span><div>@_msg</div></div>
        }
        @if (_ok is not null)
        {
            <div class="callout"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@_ok</div></div>
        }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" />

        <div class="section-title">
            <h3>ACC <span class="pill blue">@_accs.Count</span></h3><span class="ln"></span>
            <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="Import" title="@L["AccAdmin_ImportTitle"]">@if (_busy) { <span class="spin"></span> }⟳ @L["AccAdmin_ImportBtn"]</button>
            <a class="btn ghost" href="/vsop/admin/sectorstructure">@L["Home_StructTitle"] →</a>
        </div>
        <div class="block">
            <div class="field" style="display:flex;gap:8px;align-items:center">
                <input placeholder="@L["AccAdmin_FilterAcc"]" @bind="_q" @bind:event="oninput" style="flex:1" />
                <select @bind="_country" title="@L["AccAdmin_FilterCountryTitle"]" style="width:auto;flex:none;min-width:160px">
                    <option value="">@L["AccAdmin_AllCountries"]</option>
                    @foreach (var c in CountryOptions()) { <option value="@c.Prefix">@c.Name</option> }
                </select>
            </div>
            @if (_accs.Count == 0)
            {
                <p class="help">@L["AccAdmin_NoAcc"]</p>
            }
            else if (!ShownAccs().Any())
            {
                <p class="help">@NoResultsMsg(_q)</p>
            }
            else
            {
                <table class="res-table">
                    <thead><tr><th>@L["AccAdmin_ColCode"]</th><th>@L["Airport_Name"]</th><th>@L["AccAdmin_ColMilitary"]</th><th>@L["Common_State"]</th><th>@L["AccAdmin_ColAreas"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in ShownAccs())
                        {
                            <tr style="@(a.IsHidden ? "opacity:.5" : "")">
                                <td><b>@a.Code</b></td>
                                <td>@a.Name</td>
                                <td>@(a.IsMilitary ? "🪖 " + L["Common_Yes"] : "—")</td>
                                <td>
                                    @if (a.IsHidden)
                                    {
                                        <span class="pill neutral">@L["AccAdmin_Hidden"]</span>
                                    }
                                    else
                                    {
                                        <span class="pill" style="background:#dafbe7;color:#1a7f37">@L["AccAdmin_Active"]</span>
                                    }
                                </td>
                                @* Aree regolamentate: gli ACC esteri nascono spenti (sono centinaia di aree che
                                   quasi nessun documento italiano usa). Il primo scarico è manuale e li accende. *@
                                <td style="white-space:nowrap">
                                    @if (a.SpecialAreasEnabled)
                                    {
                                        <span class="pill" style="background:#dafbe7;color:#1a7f37" title="@L["AccAdmin_AreasOnHint"]">@L["AccAdmin_AreasOn", a.SpecialAreaCount]</span>
                                    }
                                    else
                                    {
                                        <span class="pill neutral" title="@L["AccAdmin_AreasOffHint"]">@L["AccAdmin_AreasOff"]</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => ImportAreas(a.Code)"
                                            title="@L["AccAdmin_ImportAreasTitle"]">⟳ @L["AccAdmin_ImportAreas"]</button>
                                    @if (a.SpecialAreasEnabled)
                                    {
                                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => SetAreasEnabled(a.Id, false)"
                                                title="@L["AccAdmin_AreasDisableTitle"]">🚫 @L["AccAdmin_AreasDisable"]</button>
                                    }
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => SetHidden(a.Id, !a.IsHidden)">
                                        @(a.IsHidden ? "👁 " + L["AccAdmin_Show"] : "🚫 " + L["AccAdmin_Hide"])
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="section-title"><h3>@L["AccAdmin_SubsTitle"] <span class="pill blue">@_subs.Count</span></h3><span class="ln"></span></div>
        <div class="block">
            <p class="muted" style="font-size:11.5px;margin:0 0 8px">@L["AccAdmin_SubsNote"]</p>
            <div class="field" style="display:flex;gap:8px;align-items:center">
                <input placeholder="@L["AccAdmin_FilterSub"]" @bind="_qSub" @bind:event="oninput" style="flex:1" />
                <select @bind="_country" title="@L["AccAdmin_FilterCountryTitle"]" style="width:auto;flex:none;min-width:160px">
                    <option value="">@L["AccAdmin_AllCountries"]</option>
                    @foreach (var c in CountryOptions()) { <option value="@c.Prefix">@c.Name</option> }
                </select>
            </div>
            @if (_subs.Count == 0)
            {
                <p class="help">@L["AccAdmin_NoSubs"]</p>
            }
            else if (!ShownSubs().Any())
            {
                <p class="help">@NoResultsMsg(_qSub)</p>
            }
            else
            {
                <table class="res-table">
                    <thead><tr><th>Callsign</th><th>ACC</th><th>Pos</th><th>Mid</th><th>Freq</th><th>Shape</th><th>@L["AccAdmin_LowerLimit"] <span class="muted" style="font-weight:400">(GND=0)</span></th><th>@L["AccAdmin_UpperLimit"] <span class="muted" style="font-weight:400">(UNL=@L["AccAdmin_Unlimited"])</span></th><th>@L["Common_State"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in ShownSubs())
                        {
                            var eff = s.IsHidden || s.AccHidden;
                            <tr style="@(eff ? "opacity:.5" : "")">
                                <td><b>@s.ComposePosition</b></td>
                                <td><span class="pill blue">@s.CenterId</span></td>
                                <td>@(s.Position ?? "—")</td>
                                <td>@(s.MiddleIdentifier ?? "—")</td>
                                <td>@(s.Frequency ?? "—")</td>
                                <td>@(s.HasPolygon ? "✓" : "—")</td>
                                <td><input style="width:70px" disabled="@(!_canEdit)" value="@FmtLower(_lower.GetValueOrDefault(s.Id))" @onchange="e => _lower[s.Id] = ParseLower(e.Value)" title="@L["AccAdmin_LowerHint"]" /></td>
                                <td><input style="width:70px" disabled="@(!_canEdit)" value="@FmtUpper(_upper.GetValueOrDefault(s.Id))" @onchange="e => _upper[s.Id] = ParseUpper(e.Value)" title="@L["AccAdmin_UpperHint"]" /></td>
                                <td>
                                    @if (s.AccHidden)
                                    {
                                        <span class="pill neutral" title="@L["AccAdmin_AccHiddenTitle"]">@L["AccAdmin_HiddenAcc"]</span>
                                    }
                                    else if (s.IsHidden)
                                    {
                                        <span class="pill neutral">@L["AccAdmin_Hidden"]</span>
                                    }
                                    else
                                    {
                                        <span class="pill" style="background:#dafbe7;color:#1a7f37">@L["AccAdmin_Active"]</span>
                                    }
                                </td>
                                <td style="white-space:nowrap">
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => SaveLimits(s.Id)" title="@L["AccAdmin_SaveLimits"]">💾</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || s.AccHidden)" @onclick="() => SetSubHidden(s.Id, !s.IsHidden)"
                                            title="@(s.AccHidden ? L["AccAdmin_ShowAccFirst"] : L["AccAdmin_ToggleHide"])">
                                        @(s.IsHidden ? "👁" : "🚫")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<AccAdminRow> _accs = Array.Empty<AccAdminRow>();
    private IReadOnlyList<AccSectorRow> _subs = Array.Empty<AccSectorRow>();
    private readonly Dictionary<int, int?> _lower = new();
    private readonly Dictionary<int, int?> _upper = new();
    private string _q = "";
    private string _qSub = "";
    private string _country = "";   // filtro nazione (prefisso ICAO, "" = tutte) condiviso dalle due tabelle
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _msg;
    private string? _ok;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _accs = await Acc.ListAccsAsync();
        _subs = await Acc.ListSubcentersAsync();
        _lower.Clear(); _upper.Clear();
        foreach (var s in _subs) { _lower[s.Id] = s.LowerLimit; _upper[s.Id] = s.UpperLimit; }
    }

    private IEnumerable<AccAdminRow> ShownAccs() =>
        _accs.Where(a => (string.IsNullOrEmpty(_country) || PrefixOf(a.Code) == _country)
            && (string.IsNullOrWhiteSpace(_q)
                || a.Code.Contains(_q, StringComparison.OrdinalIgnoreCase)
                || a.Name.Contains(_q, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<AccSectorRow> ShownSubs() =>
        _subs.Where(s => (string.IsNullOrEmpty(_country) || PrefixOf(s.CenterId) == _country)
            && (string.IsNullOrWhiteSpace(_qSub)
                || s.ComposePosition.Contains(_qSub, StringComparison.OrdinalIgnoreCase)
                || s.CenterId.Contains(_qSub, StringComparison.OrdinalIgnoreCase)
                || (s.Position ?? "").Contains(_qSub, StringComparison.OrdinalIgnoreCase)
                || (s.MiddleIdentifier ?? "").Contains(_qSub, StringComparison.OrdinalIgnoreCase)));

    // --- Filtro per nazione: prefisso ICAO (primi 2 char del codice ACC / CenterId) → nome ---
    private sealed record CountryOption(string Prefix, string Name);

    private static string PrefixOf(string code)
    {
        var c = code ?? "";
        return (c.Length >= 2 ? c.Substring(0, 2) : c).ToUpperInvariant();
    }

    private List<CountryOption> CountryOptions() =>
        _accs.Select(a => PrefixOf(a.Code))
             .Concat(_subs.Select(s => PrefixOf(s.CenterId)))
             .Where(p => !string.IsNullOrWhiteSpace(p))
             .Distinct(StringComparer.OrdinalIgnoreCase)
             .Select(p => new CountryOption(p, CountryName(p)))
             .OrderBy(c => c.Prefix.Equals("LI", StringComparison.OrdinalIgnoreCase) ? "" : c.Name)   // Italia prima
             .ToList();

    private string CountryName(string prefix) => prefix.ToUpperInvariant() switch
    {
        "LI" => "🇮🇹 " + L["Country_LI"],
        "LF" => "🇫🇷 " + L["Country_LF"],
        "LS" => "🇨🇭 " + L["Country_LS"],
        "LO" => "🇦🇹 " + L["Country_LO"],
        "LD" => "🇭🇷 " + L["Country_LD"],
        "LJ" => "🇸🇮 " + L["Country_LJ"],
        "LG" => "🇬🇷 " + L["Country_LG"],
        "LM" => "🇲🇹 " + L["Country_LM"],
        "LA" => "🇦🇱 " + L["Country_LA"],
        "LQ" => "🇧🇦 " + L["Country_LQ"],
        "LY" => "🇷🇸 " + L["Country_LY"],
        "LW" => "🇲🇰 " + L["Country_LW"],
        "DT" => "🇹🇳 " + L["Country_DT"],
        "DA" => "🇩🇿 " + L["Country_DA"],
        _ => prefix.ToUpperInvariant(),
    };

    private string NoResultsMsg(string q) =>
        string.IsNullOrWhiteSpace(q) ? L["AccAdmin_NoResults"] : L["AccAdmin_NoResultsFor", q];

    // Limite inferiore: "GND"/vuoto = 0 (suolo); altrimenti la quota in ft.
    private static int ParseLower(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("GND", StringComparison.OrdinalIgnoreCase)) return 0;
        return int.TryParse(s, out var n) ? Math.Max(0, n) : 0;
    }

    // Limite superiore: "UNL"/vuoto = null (illimitato); altrimenti la quota in ft.
    private static int? ParseUpper(object? v)
    {
        var s = v?.ToString()?.Trim() ?? "";
        if (s.Length == 0 || s.Equals("UNL", StringComparison.OrdinalIgnoreCase)) return null;
        return int.TryParse(s, out var n) ? n : (int?)null;
    }

    private static string FmtLower(int? v) => (v ?? 0) == 0 ? "GND" : v!.Value.ToString();
    private static string FmtUpper(int? v) => v is null ? "UNL" : v.Value.ToString();

    private async Task Import()
    {
        _busy = true; _msg = null; _ok = null;
        try
        {
            var r = await Acc.ImportFromSourceAsync();
            foreach (var f in r.SpecialAreaFailures)
                Logger.LogWarning(f.Error, "Import aree speciali {Acc} saltato (import manuale).", f.AccCode);
            await ReloadAsync();
            _ok = L["AccAdmin_ImportOk", r.Acc.AccsCreated, r.Acc.AccsUpdated, r.Acc.SubcentersCreated, r.Acc.SubcentersUpdated]
                  + (r.SpecialAreaFailures.Count > 0 ? L["AccAdmin_ImportSpecialFailures", r.SpecialAreaFailures.Count].Value : "");
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    // Primo scarico manuale delle aree di un ACC: se porta a casa qualcosa, il service lo abilita al giro periodico.
    private async Task ImportAreas(string accCode)
    {
        _busy = true; _msg = null; _ok = null;
        try
        {
            var r = await Acc.ImportSpecialAreasAsync(accCode);
            foreach (var f in r.Failures)
                Logger.LogWarning(f.Error, "Import aree speciali {Acc} fallito (import per-ACC).", f.AccCode);
            await ReloadAsync();
            _msg = r.Failures.Count > 0 ? L["AccAdmin_AreasImportFailed", accCode] : null;
            if (_msg is null) _ok = L["AccAdmin_AreasImportOk", accCode, r.Created, r.Updated, r.Removed];
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }   // credenziali sorgente assenti
        finally { _busy = false; }
    }

    private async Task SetAreasEnabled(int accId, bool enabled)
    {
        _busy = true; _msg = null; _ok = null;
        try
        {
            var freed = await Acc.SetSpecialAreasEnabledAsync(accId, enabled);
            await ReloadAsync();
            if (!enabled) _ok = L["AccAdmin_AreasDisabled", freed];
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetHidden(int accId, bool hidden)
    {
        _busy = true; _msg = null; _ok = null;
        try { await Acc.SetHiddenAsync(accId, hidden); await ReloadAsync(); }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (ValidationException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        catch (Exception ex) { _msg = L["Common_UnexpectedError"] + ex.Message; Logger.LogError(ex, "Nascondi ACC fallito"); }
        finally { _busy = false; }
    }

    private async Task SetSubHidden(int id, bool hidden)
    {
        _busy = true; _msg = null; _ok = null;
        try { await Acc.SetSubcenterHiddenAsync(id, hidden); await ReloadAsync(); }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (ValidationException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        catch (Exception ex) { _msg = L["Common_UnexpectedError"] + ex.Message; Logger.LogError(ex, "Nascondi settore fallito"); }
        finally { _busy = false; }
    }

    private async Task SaveLimits(int id)
    {
        _busy = true; _msg = null; _ok = null;
        try
        {
            await Acc.SetSubcenterLimitsAsync(id, _lower.GetValueOrDefault(id), _upper.GetValueOrDefault(id));
            await ReloadAsync();
            _ok = L["AccAdmin_LimitsSaved"];
        }
        catch (EditNotAllowedException ex) { _msg = ex.Message; }
        catch (InvalidOperationException ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
}
