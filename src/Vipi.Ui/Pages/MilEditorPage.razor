@page "/services/vsop/{Acc}/mil/editor"
@layout SopLayout
@rendermode InteractiveServer
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@inject IEditAuthorizationService Authz
@inject IDocRoutesRegistry DocRoutes
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Nav

@* La pagina dell'editor di un vSOP militare: qui restano l'indirizzo, i MEMBRI dell'unione (se questo
   documento ne è l'ospite), il pannello dell'unione e quello di pubblicazione. Il CORPO editoriale sta in
   <MilSectionsEditor> (carta 2026-09-03-documenti-uniti.md §5b). *@

<MilSectionsEditor @ref="_editor" Acc="@Acc" Icao="@Icao" Chrome="true"
                   VociIndiceExtra="_vociMembri"
                   SuModifica="@(Unito ? ModificaTutti : null)"
                   SuFineModifica="@(Unito ? FineModificaTutti : null)">
    <AfterSections>
        @if (_errore is { Length: > 0 })
        {
            <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_errore</div></div>
        }

        @if (Unito)
        {
            <UnionMembersEditor @ref="_membri" Membri="_altri" Acc="@Acc"
                               StatoCambiato="Ridisegna" VociCambiate="AggiornaVoci"
                               InModifica="@(_editor?.Guscio.IsEditing == true)" LockNegato="MembroBloccato" />
        }

        @* L'unione dei documenti: SOPRA il pannello di pubblicazione, perché e' cio' che decide QUANTI
           documenti quel tasto pubblichera'. *@
        <UnionPanel Target="ReleaseTargetType.AirportMil" Key="@Codice"
                    IsEditing="_editor?.Guscio.IsEditing ?? false" Changed="UnioneCambiata" />

        @* L'ancora `sec-versioni` è la stessa nei cinque editor: è dove atterra «Ripubblica». *@
        <div id="sec-versioni">
            <ReleasePanel Revisione="_unioneRev" Target="ReleaseTargetType.AirportMil" Key="@Codice"
                          ShowDiff="true" AllowCancel="Authz.IsEditor"
                          BeforePublishAsync="Prepubblicazione"
                          PreviewUrlFactory="ReleasePreviewUrl"
                          Published="Ricarica" />
        </div>
    </AfterSections>
</MilSectionsEditor>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "icao")] public string? Icao { get; set; }

    private MilSectionsEditor? _editor;
    private UnionMembersEditor? _membri;
    private IReadOnlyList<UnionMemberView> _altri = Array.Empty<UnionMemberView>();
    private string? _errore;

    private string Codice => (Icao ?? "").Trim().ToUpperInvariant();

    /// <summary>Questo documento è l'OSPITE di un'unione: allora redige anche gli altri.</summary>
    private bool Unito => _altri.Count > 0;

    /// <summary>Quante volte l'unione e' cambiata in questa sessione di pagina: alzarla costringe
    /// <c>ReleasePanel</c> a rileggere i suoi bersagli.</summary>
    private int _unioneRev;

    /// <summary>
    /// Il servizio dell'unione, dallo scope PROPRIO di questa pagina (<c>OwningComponentBase</c>) e non da
    /// quello del circuito: preso dal circuito correva contro il caricamento di <c>MilSectionsEditor</c>,
    /// che parte nello stesso momento e usa lo stesso <c>DbContext</c>. Il ragionamento per esteso sta su
    /// <c>AeroportoEditorPage</c>, che ha la stessa riga per la stessa ragione.
    /// </summary>
    private IDocumentUnionService Unioni = default!;


    /// <summary>
    /// ⚠️ <b>Dallo scope PROPRIO, non da <c>@@inject</c></b>: questi servizi leggono dal database, e con
    /// <c>@@inject</c> il loro <c>DbContext</c> sarebbe quello del <b>circuito</b> — condiviso con la barra,
    /// le isole, i pannelli e quel che la pagina precedente ha lasciato in volo. Dichiarare lo scope proprio
    /// sopra e poi iniettare qui sotto è la forma peggiore del difetto: la difesa c'è, scritta, e non copre.
    ///
    /// <para>🔴 Non è una precauzione: il registro di produzione del 4-7 settembre 2026 porta dodici
    /// «<c>A second operation was started on this context instance</c>», e due delle ultime nascono proprio
    /// dentro un componente che lo scope proprio ce l'aveva. Vedi <c>docs/lavori-aperti.md</c> §CD.</para>
    /// </summary>
    private IStationResolver Stations = default!;
    protected override void OnInitialized()
    {
        Unioni = ScopedServices.GetRequiredService<IDocumentUnionService>();
        Stations = ScopedServices.GetRequiredService<IStationResolver>();
    }

    /// <summary>
    /// L'indirizzo porta un ACC che non è più quello dello scalo: si rimanda a quello giusto, sostituendo la
    /// voce nella cronologia. La domanda la fa il catalogo in cache (<see cref="RottaAeroporto"/>), non il
    /// database.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var icao = (Icao ?? "").Trim().ToUpperInvariant();
        if (RottaAeroporto.AccDaCorreggere(Stations, Acc, icao) is { } giusto)
        {
            Nav.NavigateTo($"/services/vsop/{giusto.ToLowerInvariant()}/mil/editor?icao={icao}", replace: true);
            return;
        }
        await LeggiUnioneAsync();
    }

    private async Task LeggiUnioneAsync()
    {
        // ⚠️ `AirportMil` e non `Airport`: le due edizioni dello stesso scalo hanno la STESSA chiave di
        // release (l'ICAO) e si distinguono per il tipo. Chiedere con l'altro darebbe l'unione del civile.
        // ⚠️ §13: questo editor è una PORTA dell'unione, non l'ospite di nessuno — vedi
        // <see cref="AeroportoEditorPage"/>.
        var unione = await Unioni.ForTargetAsync(ReleaseTargetType.AirportMil, Codice);
        _altri = unione?.Di(ReleaseTargetType.AirportMil, Codice) is { } mio
            ? unione.AltriDa(mio.DocumentId)
            : Array.Empty<UnionMemberView>();
    }

    /// <inheritdoc cref="AppEditorPage.ModificaTutti"/>
    private async Task ModificaTutti()
    {
        _errore = null;
        if (_editor is null) return;

        if (await _editor.PrendiLockAsync() is { } chiLoTiene)
        {
            _errore = L["Union_LockedBy", chiLoTiene];
            return;
        }
        if (_membri is not null && await _membri.PrendiLockAsync() is { } chiMembro)
        {
            await _editor.RilasciaLockAsync();
            _errore = L["Union_LockedBy", chiMembro];
        }
    }

    private async Task FineModificaTutti()
    {
        if (_membri is not null) await _membri.RilasciaLockAsync();
        if (_editor is not null) await _editor.RilasciaLockAsync();
    }

    /// <summary>Un membro unito a modifica aperta non ha potuto prendere il suo lock: si dice CHI lo tiene —
    /// «non puoi modificare» da solo è un muro, il nome è una risposta.</summary>
    private void MembroBloccato(string chi) => _errore = L["Union_LockedBy", chi];

    private async Task UnioneCambiata()
    {
        _unioneRev++;
        await LeggiUnioneAsync();
        await Ricarica();
    }

    /// <summary>
    /// L'ultima domanda prima di pubblicare, per QUESTO documento e per tutti i membri dell'unione.
    ///
    /// <para>🔴 Il pannello di pubblicazione sta solo sull'ospite, e con lui la sua guardia: prima di
    /// questa riga l'avviso «sezioni non salvate» di un MEMBRO non veniva chiesto, e la sua fotografia
    /// usciva senza le modifiche aperte — in silenzio, e la fotografia è quel che il pubblico legge.</para>
    /// </summary>
    private async Task<bool> Prepubblicazione()
    {
        // ⚠️ Attraverso l'INTERFACCIA: `IMembroEditor.BeforePublishAsync` ha un'implementazione di
        // default, e un membro di default si raggiunge solo dal tipo dell'interfaccia — dal tipo concreto
        // il compilatore non lo vede. Le famiglie che non hanno niente da chiedere cosi' non lo scrivono.
        if (_editor is IMembroEditor mio && !await mio.BeforePublishAsync()) return false;
        return _membri is null || await _membri.BeforePublishAsync();
    }

    private Task Ricarica() => _editor?.RicaricaAsync() ?? Task.CompletedTask;

    private Task Ridisegna() { StateHasChanged(); return Task.CompletedTask; }

    /// <summary>Le voci d'indice dei membri, portate dal componente che li monta.
    /// <para>⚠️ Arrivano SPINTE e non si tirano con l'`@ref`: quello si assegna dopo il render, e i
    /// membri si registrano durante — tirarle lasciava l'indice con le sole voci dell'ospite.</para></summary>
    private IReadOnlyList<EditorTocItem> _vociMembri = Array.Empty<EditorTocItem>();

    private Task AggiornaVoci(IReadOnlyList<EditorTocItem> voci)
    {
        _vociMembri = voci;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? ReleasePreviewUrl(int releaseId) =>
        DocRoutes.For(ReleaseTargetType.AirportMil).ViewerUrl(Acc.ToLowerInvariant(), Codice, null, releaseId);
}
