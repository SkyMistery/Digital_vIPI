@page "/services/vsop/{Acc}/mil/editor"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditAuthorizationService Authz
@inject IDocRoutesRegistry DocRoutes

@* La pagina dell'editor di un vSOP militare: qui restano l'indirizzo, il pannello dell'unione e quello di
   pubblicazione. Il CORPO editoriale sta in <MilSectionsEditor>, perche' lo stesso editor va montato anche
   nell'editor UNITO (carta 2026-09-03-documenti-uniti.md §5b). *@

<MilSectionsEditor @ref="_editor" Acc="@Acc" Icao="@Icao" Chrome="true">
    <AfterSections>
        @* L'unione dei documenti: SOPRA il pannello di pubblicazione, perche' e' cio' che decide QUANTI
           documenti quel tasto pubblichera'. *@
        <UnionPanel Target="ReleaseTargetType.AirportMil" Key="@Codice"
                    IsEditing="_editor?.Guscio.IsEditing ?? false" Changed="UnioneCambiata" />

        @* L'ancora `sec-versioni` è la stessa nei cinque editor: è dove atterra «Ripubblica». *@
        <div id="sec-versioni">
            <ReleasePanel Revisione="_unioneRev" Target="ReleaseTargetType.AirportMil" Key="@Codice"
                          ShowDiff="true" AllowCancel="Authz.IsEditor"
                          PreviewUrlFactory="ReleasePreviewUrl"
                          Published="Ricarica" />
        </div>
    </AfterSections>
</MilSectionsEditor>

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "icao")] public string? Icao { get; set; }

    private MilSectionsEditor? _editor;

    private string Codice => (Icao ?? "").Trim().ToUpperInvariant();

    /// <summary>Quante volte l'unione e' cambiata in questa sessione di pagina: alzarla costringe
    /// <c>ReleasePanel</c> a rileggere i suoi bersagli.</summary>
    private int _unioneRev;

    private async Task UnioneCambiata()
    {
        _unioneRev++;
        await Ricarica();
    }

    private Task Ricarica() => _editor?.RicaricaAsync() ?? Task.CompletedTask;

    private string? ReleasePreviewUrl(int releaseId) =>
        DocRoutes.For(ReleaseTargetType.AirportMil).ViewerUrl(Acc.ToLowerInvariant(), Codice, null, releaseId);
}
