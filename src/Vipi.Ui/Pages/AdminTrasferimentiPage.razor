    private string GapLabel(AgreementGapKind k) => k switch
    {
        AgreementGapKind.AsymmetricDirections => L["Xfer_GapAsymmetric"],
        AgreementGapKind.MissingReverse => L["Xfer_GapMissingReverse"],
        AgreementGapKind.TwinSections => L["Xfer_GapTwinSections"],
        AgreementGapKind.ToReview => L["Xfer_ToReview"],
        AgreementGapKind.EmptySection => L["Xfer_GapEmptySection"],
        AgreementGapKind.NeighbourWithoutAgreement => L["Xfer_GapNeighbour"],
        AgreementGapKind.AirportWithoutArrivals => L["Xfer_GapAirport"],
        _ => L["Xfer_GapSector"],
    };

    /// <summary>Il colore dice la gravita': giallo = una verita' a meta', neutro = una scrittura che manca.
    /// <para>⚠️ Il rosso non c'è più, e non è una svista: la voce che lo portava era «accordo senza ricevente»,
    /// cioè il traffico che finisce a UNICOM ADESSO. Dal 18 agosto 2026 non può più esistere — i due capi sono
    /// colonne NOT NULL — e tenere il colore per qualcos'altro sarebbe alzare la voce a tutte le altre.</para></summary>
    private static string GapPill(AgreementGapKind k) => k switch
    {
        // Le classi sono quelle del tema, non inventate qui: «future» e' l'unica gialla che esiste, e la usa
        // gia' la pill di una release programmata. Un colore nuovo per questa tabella sarebbe un secondo
        // vocabolario di gravita' accanto a quello che il resto del sito ha gia'.
        AgreementGapKind.AsymmetricDirections or AgreementGapKind.MissingReverse => "future",
        AgreementGapKind.ToReview or AgreementGapKind.TwinSections or AgreementGapKind.EmptySection => "grey",
        _ => "neutral",
    };

