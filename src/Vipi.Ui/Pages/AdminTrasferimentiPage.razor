@page "/vsop/admin/trasferimenti"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject ITransferService Transfers
@inject IStructureEditingService Struct
@inject IEditAuthorizationService Authz
@inject INeighbourReader Neighbours
@inject IAirportEditingService Airports
@inject IAccDerivationService AccDeriv
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Xfer_Title"] · vIPI IVAO Italia</PageTitle>

<style>
    .sector-pick-wrap { position: relative; }
    .sector-pick { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; margin-top: 2px; max-height: 200px; overflow-y: auto; border: 1px solid #c4cadb; border-radius: 6px; background: #fff; box-shadow: 0 6px 18px rgba(13,44,153,.14); }
    .sector-pick .sp-item { display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid #eef1f7; background: transparent; padding: 5px 9px; font-size: 13px; cursor: pointer; }
    .sector-pick .sp-item:last-child { border-bottom: 0; }
    .sector-pick .sp-item:hover { background: #f2f5ff; }
    .sector-pick .sp-item.on { background: #0D2C99; color: #fff; font-weight: 600; }
    .sector-pick .sp-empty { display: block; padding: 6px 9px; color: #8a90a2; font-size: 12px; }
    .toast-fixed { position: fixed; right: 18px; bottom: 18px; z-index: 60; max-width: 380px; box-shadow: 0 8px 24px rgba(13,44,153,.22); border-radius: 8px; }
    .toast-fixed .callout { margin: 0; }
    .toast-fixed .tclose { margin-left: auto; border: 0; background: transparent; cursor: pointer; font-size: 15px; line-height: 1; color: inherit; opacity: .6; }
    .toast-fixed .tclose:hover { opacity: 1; }
</style>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <a href="/vsop/admin/sectorstructure">@L["Struct_Title"]</a> › <b>@L["Xfer_Title"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Xfer_Heading"]</h2><span class="muted">@((MarkupString)L["Xfer_Subtitle"].Value)</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else
    {
        @if (_error is not null || _status is not null)
        {
            <div class="toast-fixed">
                @if (_error is not null)
                {
                    <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div><button class="tclose" title="@L["Common_Close"]" @onclick="() => _error = null">✕</button></div>
                }
                else
                {
                    <div class="callout success"><span class="cic">✓</span><div>@_status</div><button class="tclose" title="@L["Common_Close"]" @onclick="() => _status = null">✕</button></div>
                }
            </div>
        }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" />

        @* ---- Scelta ACC ---- *@
        <div class="section-title"><h3>ACC</h3><span class="ln"></span></div>
        <div class="block">
            @if (Stations.Accs.Count == 0)
            {
                <p class="help">@((MarkupString)L["Xfer_NoAccImport"].Value)</p>
            }
            else
            {
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                    @foreach (var a in Stations.Accs)
                    {
                        var active = string.Equals(_accCode, a.Code, StringComparison.OrdinalIgnoreCase);
                        <button class="btn @(active ? "primary" : "ghost")" disabled="@(_busy)" title="@a.Name" @onclick="() => SelectAcc(a.Code)">@a.Code</button>
                    }
                </div>
            }
        </div>

        @if (_acc is null)
        {
            <p class="help">@L["Xfer_ChooseAcc"]</p>
        }
        else
        {
            @* ---- Nuovo gruppo (settore · aeroporto · tipo) ---- *@
            <div class="block">
                <h5 style="margin-top:0">@L["Xfer_NewGroup"]</h5>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field sector-pick-wrap"><label>@L["Xfer_SenderSector"]</label>
                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_fSectorText" @bind:event="oninput" @bind:after="ResolveFSector"
                               @onfocus="() => _fOpen = true" @onblur="() => _fOpen = false" />
                        @if (_fOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var s in OwnSectors().Where(s => Match(s, _fSectorText)).Take(50))
                                {
                                    <button type="button" class="sp-item @(s.Id == _fSector ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickFSector(s)">@s.Callsign@(IsForeignSender(s) ? $" · {s.AccCode} ({L["Xfer_Foreign"]})" : "")</button>
                                }
                                @if (!OwnSectors().Any(s => Match(s, _fSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                            </div>
                        }
                    </div>
                    <div class="field sector-pick-wrap"><label>@L["Xfer_Airport"] <span class="muted" style="font-weight:400">@L["Xfer_AirportNewForeign"]</span></label>
                        <input placeholder="LIRF / LFPG" @bind="_fApt" @bind:event="oninput" title="@L["Xfer_IcaoForeignTitle"]" autocomplete="off"
                               @onfocus="() => _aOpen = true" @onblur="OnAptBlur" />
                        @if (_aOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var ap in _airports.Where(a => MatchApt(a, _fApt)).Take(50))
                                {
                                    <button type="button" class="sp-item @(string.Equals(ap.Icao, _fApt, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickApt(ap)"><b>@ap.Icao</b> <span class="muted" style="font-size:11px">@ap.Name · @ap.AccCode</span></button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_fApt) && !_airports.Any(a => string.Equals(a.Icao, _fApt.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <span class="sp-empty">↵ @(string.Format(L["Xfer_UseNewApt"].Value, _fApt.Trim().ToUpperInvariant()))</span>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_fApt) && !IsKnownApt(_fApt))
                    {
                        <div class="field"><label>@L["Xfer_AptName"] <span class="muted" style="font-weight:400">@L["Xfer_OutOfDb"]</span></label>
                            <div style="display:flex;gap:6px">
                                <input placeholder="@L["Xfer_AptNamePh"]" @bind="_fAptName" title="@L["Xfer_AptNameTitle"]" />
                                <button type="button" class="btn ghost" style="white-space:nowrap" disabled="@_busy" @onclick="() => LookupApt(false)" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_fAptMsg)) { <span class="muted" style="font-size:11.5px">@_fAptMsg</span> }
                        </div>
                    }
                    <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                        <select @bind="_fKind">
                            <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                            <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                            <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                            <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                            <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                        </select>
                    </div>
                    <div class="field"><label>@L["Xfer_DescOpt"]</label><input placeholder="@L["Xfer_DescPh"]" @bind="_fDesc" @bind:event="oninput" @onkeydown="TrySubmitGroup" /></div>
                    <button class="btn primary" disabled="@(_busy || !_canEdit || _fSector == 0 || NewAptMissingName(_fApt, _fAptName))" @onclick="AddFlow">+ @L["Xfer_Group"]</button>
                    @if (_canEdit && _fSector == 0) { <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_SelectSenderHint"]</span> }
                    else if (_canEdit && AirportRequiredMissing(_fKind, _fApt)) { <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_AirportRequired"]</span> }
                    else if (_canEdit && NewAptMissingName(_fApt, _fAptName)) { <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_AptNeedsName"]</span> }
                </div>
                <p class="help" style="margin:6px 0 0">@((MarkupString)L["Xfer_NewGroupHelp"].Value)</p>
            </div>

            @if (_flows.Count == 0)
            {
                <p class="help">@L["Xfer_NoFlows"]</p>
            }
            else
            {
                var shown = FilteredFlows();
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:6px 0 12px">
                    <input class="htree-search" style="flex:1;min-width:180px" placeholder="@L["Xfer_FilterPh"]"
                           @bind="_flowFilter" @bind:event="oninput" />
                    <select @bind="_kindFilter" style="width:130px">
                        <option value="">@L["Xfer_AllKinds"]</option>
                        <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                        <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                        <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                        <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                        <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                    </select>
                    <span class="muted" style="font-size:12px;white-space:nowrap">@GroupsCountLabel(shown.Count) · @(string.Format(L["Xfer_RowsCount"].Value, shown.Sum(f => f.Points.Count)))</span>
                    @* Le righe ACC→APP scritte prima della faccetta non dicono dove avviene il trasferimento e
                       vanno riviste a mano: senza un modo di elencarle, la revisione si perde per strada. *@
                    @{ var toReview = ToReviewCount(); }
                    @if (toReview > 0 || _toReviewOnly)
                    {
                        <button class="btn @(_toReviewOnly ? "primary" : "ghost")" style="white-space:nowrap"
                                title="@L["Xfer_ToReviewTitle"]" @onclick="() => _toReviewOnly = !_toReviewOnly">
                            ⚠ @L["Xfer_ToReview"] (@toReview)
                        </button>
                    }
                    @if (_filtering) { <button class="btn ghost" @onclick="() => { _flowFilter = string.Empty; _kindFilter = null; _toReviewOnly = false; }">↺ @L["Xfer_Reset"]</button> }
                    <span class="ln" style="flex:1"></span>
                    <button class="btn ghost" title="@L["Xfer_ExpandAll"]" @onclick="ExpandAll">⊞ @L["Xfer_ExpandAll"]</button>
                    <button class="btn ghost" title="@L["Xfer_CollapseAll"]" @onclick="CollapseAll">⊟ @L["Xfer_CollapseAll"]</button>
                    <label class="muted" style="font-size:12px;display:flex;align-items:center;gap:4px;white-space:nowrap;cursor:pointer" title="@L["Xfer_ShowPreviewsTitle"]">
                        <input type="checkbox" @bind="_showPreviews" /> @L["Xfer_ShowPreviews"]
                    </label>
                </div>
                @if (shown.Count == 0)
                {
                    <p class="help">@L["Xfer_NoFilterMatch"]</p>
                }

            @* ---- Settore ▸ Aeroporto ▸ Tipo ▸ righe ---- *@
            @foreach (var secGroup in shown.GroupBy(f => f.OwningSectorCallsign).OrderBy(g => g.Key))
            {
                var secKey = secGroup.Key;
                var secOpen = _filtering || !_collapsedSec.Contains(secKey);
                <div class="section-title" style="margin-bottom:4px;cursor:pointer" role="button" tabindex="0"
                     aria-expanded="@secOpen" @onclick="() => ToggleSec(secKey)"
                     @onkeydown="e => { if (IsActivationKey(e)) ToggleSec(secKey); }">
                    <h3 style="margin:0"><span style="display:inline-block;width:1em">@(secOpen ? "▾" : "▸")</span> @secKey</h3>
                    <span class="ln"></span>
                    <span class="muted" style="font-size:12px">@(string.Format(L["Xfer_GroupsN"].Value, secGroup.Count()))</span>
                </div>
                @if (!secOpen) { continue; }
                @foreach (var aptGroup in secGroup.GroupBy(f => f.AirportIcao).OrderBy(g => g.Key ?? "~"))
                {
                    var aptKey = $"{secKey}|{aptGroup.Key}";
                    var aptOpen = _filtering || !_collapsedApt.Contains(aptKey);
                    <div class="block">
                        <h5 style="margin:0;cursor:pointer" role="button" tabindex="0" aria-expanded="@aptOpen"
                            @onclick="() => ToggleApt(aptKey)" @onkeydown="e => { if (IsActivationKey(e)) ToggleApt(aptKey); }">
                            <span style="display:inline-block;width:1em">@(aptOpen ? "▾" : "▸")</span>
                            @AptHeader(aptGroup.Key)
                        </h5>
                        @if (aptOpen)
                        {
                        @foreach (var f in aptGroup.OrderBy(x => x.Kind))
                        {
                            var flowOpen = _filtering || !_collapsedFlow.Contains(f.Id);
                            <div class="section-title" style="margin:6px 0">
                                <h4 style="margin:0;cursor:pointer" role="button" tabindex="0" aria-expanded="@flowOpen"
                                    @onclick="() => ToggleFlow(f.Id)" @onkeydown="e => { if (IsActivationKey(e)) ToggleFlow(f.Id); }">
                                    <span style="display:inline-block;width:1em">@(flowOpen ? "▾" : "▸")</span>
                                    <span class="pill blue">@KindLabel(f.Kind)</span>
                                    <span class="muted" style="font-size:12px;font-weight:400">@(string.Format(L["Xfer_RowsCount"].Value, f.Points.Count))</span>
                                    @if (!string.IsNullOrWhiteSpace(f.Description))
                                    {
                                        <span class="muted" style="font-size:12.5px;font-weight:400;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:38ch;display:inline-block;vertical-align:bottom" title="@f.Description">— @f.Description</span>
                                    }
                                    @if (f.Points.Count > 0 && f.Points.All(p => string.IsNullOrWhiteSpace(p.NextSectorCallsign)))
                                    {
                                        <button type="button" class="pill" style="background:#f4c542;color:#3a2f00;border:0;cursor:pointer"
                                                title="@L["Xfer_UnicomTitle"]"
                                                @onclick:stopPropagation="true" disabled="@(_busy || !_canEdit)" @onclick="() => FixUnicom(f)">⚠ @L["Xfer_NoReceiver"]</button>
                                    }
                                </h4>
                                <span class="ln"></span>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_CloneGroupTitle"]" @onclick="() => OpenCloneFlow(f)">⧉ @L["Xfer_Group"]</button>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => EditFlow(f)">✎ @L["Xfer_Group"]</button>
                                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteGroupAria"]" Disabled="@(_busy || !_canEdit)"
                                               Prompt="@(string.Format(L["Xfer_DeleteGroupPrompt"].Value, f.Points.Count))" OnConfirm="() => DeleteFlow(f.Id)"><Trigger><Icon Name="x" /> @L["Xfer_Group"]</Trigger></InlineConfirm>
                            </div>
                            @if (!flowOpen) { continue; }
                            @if (_editFlowId == f.Id)
                            {
                                <div class="inline-form" style="margin:0 0 8px">
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_SenderSector"]</label>
                                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_efSectorText" @bind:event="oninput" @bind:after="ResolveEfSector"
                                               @onfocus="() => _efOpen = true" @onblur="() => _efOpen = false" />
                                        @if (_efOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in OwnSectors().Where(s => Match(s, _efSectorText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _efSector ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEfSector(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode@(IsForeignSender(s) ? " (" + L["Xfer_Foreign"] + ")" : "")</span></button>
                                                }
                                                @if (!OwnSectors().Any(s => Match(s, _efSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                            </div>
                                        }
                                    </div>
                                    <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                                        <select @bind="_efKind">
                                            <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                                            <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                                            <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                                            <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                                            <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                                        </select>
                                    </div>
                                    <div class="field narrow"><label>@L["Xfer_Airport"]</label><input placeholder="LIRF / —" @bind="_efApt" @onblur="() => MaybeAutoLookup(true)" /></div>
                                    @if (!string.IsNullOrWhiteSpace(_efApt) && !IsKnownApt(_efApt))
                                    {
                                        <div class="field"><label>@L["Xfer_AptName"] <span class="muted" style="font-weight:400">@L["Xfer_OutOfDb"]</span></label>
                                            <div style="display:flex;gap:6px">
                                                <input placeholder="@L["Xfer_AptNamePh"]" @bind="_efAptName" />
                                                <button type="button" class="btn ghost" style="white-space:nowrap" disabled="@_busy" @onclick="() => LookupApt(true)" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_efAptMsg)) { <span class="muted" style="font-size:11.5px">@_efAptMsg</span> }
                                        </div>
                                    }
                                    <div class="field"><label>@L["Xfer_DescOpt"]</label><input placeholder="@L["Xfer_DescPh"]" @bind="_efDesc" /></div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || NewAptMissingName(_efApt, _efAptName))" @onclick="() => SaveFlow(f.Id)">💾 @L["Common_Save"]</button>
                                    @if (_canEdit && AirportRequiredMissing(_efKind, _efApt)) { <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_AirportRequired"]</span> }
                                    else if (_canEdit && NewAptMissingName(_efApt, _efAptName)) { <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_AptNeedsName"]</span> }
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editFlowId = null">@L["Common_Cancel"]</button>
                                </div>
                            }
                            @if (_cloneFlowId == f.Id)
                            {
                                <div class="inline-form" style="margin:0 0 8px;background:#f2f5ff;border-radius:6px;padding:8px">
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_CloneToSender"]</label>
                                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_cloneSectorText" @bind:event="oninput" @bind:after="ResolveCloneSector"
                                               @onfocus="() => _cloneOpen = true" @onblur="() => _cloneOpen = false" />
                                        @if (_cloneOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in OwnSectors().Where(s => Match(s, _cloneSectorText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _cloneSector ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickCloneSector(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode@(IsForeignSender(s) ? " (" + L["Xfer_Foreign"] + ")" : "")</span></button>
                                                }
                                                @if (!OwnSectors().Any(s => Match(s, _cloneSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                            </div>
                                        }
                                    </div>
                                    <span class="muted" style="font-size:12px;align-self:center">@L["Xfer_Copy"] <b>@KindLabel(f.Kind)</b>@(string.IsNullOrWhiteSpace(f.AirportIcao) ? "" : $" · {f.AirportIcao}") @(string.Format(L["Xfer_WithRows"].Value, f.Points.Count))</span>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || _cloneSector == 0)" @onclick="() => ConfirmCloneFlow(f)">⧉ @L["Xfer_CloneHere"]</button>
                                    <button class="btn ghost" disabled="@_busy" @onclick="() => _cloneFlowId = null">@L["Common_Cancel"]</button>
                                </div>
                            }

                            @* Avviso NON bloccante: un gruppo di varianti senza «negli altri casi» lascia scoperti i
                               casi che nessuna condizione copre, e chi legge non sa che fare. Può essere legittimo
                               (le condizioni possono essere esaustive), quindi si segnala, non si impedisce. *@
                            @foreach (var g in GroupsWithoutOtherwise(f))
                            {
                                <div class="callout" style="margin:0 0 6px;font-size:12.5px">
                                    <span class="cic">⚠</span>
                                    <div>@(string.Format(L["Xfer_GroupNoOtherwise"].Value, g))</div>
                                </div>
                            }

                            <table class="res-table">
                                <thead><tr><th>@L["Xfer_ColCop"]</th><th>@L["Xfer_ColLevel"]</th><th>@L["Xfer_ColReceiver"]</th><th>@L["Xfer_ColRunway"]</th><th>@L["Xfer_ColArea"]</th><th>@L["Xfer_ColCustom"]</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var p in f.Points)
                                    {
                                        @if (_editPointId == p.Id)
                                        {
                                            <tr>
                                                <td><input style="width:90px" placeholder="VALMA / —" @bind="_epCop" @bind:event="oninput" @onkeydown="e => TrySavePoint(p.Id, e)" /></td>
                                                <td>
                                                    <select @bind="_epConstraint" style="width:78px">
                                                        <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                                                        <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                                                        <option value="@LevelConstraint.Exact">@L["Xfer_Exact"]</option>
                                                        <option value="@LevelConstraint.Special">@L["Xfer_Special"]</option>
                                                    </select>
                                                    @if (_epConstraint == LevelConstraint.Special)
                                                    {
                                                        <input style="width:120px" placeholder="@L["Xfer_PerAirway"]" @bind="_epSpecial" @bind:event="oninput" @onkeydown="e => TrySavePoint(p.Id, e)" />
                                                    }
                                                    else
                                                    {
                                                        <input type="number" style="width:70px" @bind="_epValue" @bind:event="oninput" @onkeydown="e => TrySavePoint(p.Id, e)" />
                                                        <select @bind="_epUnit" style="width:56px"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                                                    }
                                                    <select @bind="_epParity" style="width:78px" title="@L["Xfer_SemicircLevels"]">
                                                        <option value="@LevelParity.Any">@L["Xfer_ParityAny"]</option>
                                                        <option value="@LevelParity.Even">@L["Xfer_ParityEven"]</option>
                                                        <option value="@LevelParity.Odd">@L["Xfer_ParityOdd"]</option>
                                                    </select>
                                                    <select @bind="_epVState" style="width:96px" title="@L["Xfer_VState"]">
                                                        <option value="@TransferVerticalState.Unspecified">@L["Xfer_VStateNone"]</option>
                                                        <option value="@TransferVerticalState.Level">@L["Xfer_VStateLevel"]</option>
                                                        <option value="@TransferVerticalState.Descending">@L["Xfer_VStateDescending"]</option>
                                                        <option value="@TransferVerticalState.Climbing">@L["Xfer_VStateClimbing"]</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <div class="sector-pick-wrap">
                                                        <input style="width:150px" placeholder="UNICOM" @bind="_epNextText" @bind:event="oninput" @bind:after="ResolveEpNext"
                                                               @onkeydown="e => TrySavePoint(p.Id, e)"
                                                               @onfocus="() => _epOpen = true" @onblur="() => _epOpen = false" />
                                                        @if (_epOpen)
                                                        {
                                                            <div class="sector-pick">
                                                                @foreach (var s in _all.Where(s => Match(s, _epNextText)).Take(50))
                                                                {
                                                                    <button type="button" class="sp-item @(s.Id == _epNext ? "on" : "")"
                                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEpNext(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode</span></button>
                                                                }
                                                                @if (!_all.Any(s => Match(s, _epNextText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (_condRunways.Count > 0)
                                                    {
                                                        <select multiple size="3" style="width:88px" title="@L["Xfer_RunwaysInUseTitle"]" @bind="_epCondRwys">@foreach (var r in _condRunways) { <option value="@r.Ident">@RwyLabel(r)</option> }</select>
                                                    }
                                                    else { <span class="muted" style="font-size:11px">@L["Xfer_NoRunway"]</span> }
                                                </td>
                                                <td>
                                                    <div class="sector-pick-wrap">
                                                        <input style="width:120px" placeholder="@L["Xfer_SearchArea"]" @bind="_epAreaText" @bind:event="oninput" @bind:after="ResolveEpArea"
                                                               @onfocus="() => _epAreaOpen = true" @onblur="() => _epAreaOpen = false" />
                                                        @if (_epAreaOpen)
                                                        {
                                                            <div class="sector-pick">
                                                                <button type="button" class="sp-item" @onmousedown:preventDefault="true" @onmousedown="() => PickEpArea(null)"><span class="muted">@L["Xfer_AreaNone"]</span></button>
                                                                @foreach (var a in MatchAreas(_epAreaText).Take(50))
                                                                {
                                                                    <button type="button" class="sp-item @(string.Equals(a.Name, _epCondAreaLabel, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEpArea(a)">@a.Name @if (!string.IsNullOrWhiteSpace(a.Type)) { <span class="muted" style="font-size:11px">@a.Type</span> }</button>
                                                                }
                                                                @if (!MatchAreas(_epAreaText).Any()) { <span class="sp-empty">@L["Xfer_NoArea"]</span> }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td><input style="width:120px" placeholder="@L["Xfer_Custom"]" @bind="_epCondCustomLabel" @bind:event="oninput" @onkeydown="e => TrySavePoint(p.Id, e)" /></td>
                                                <td style="white-space:nowrap">
                                                    <button class="btn primary" disabled="@(_busy || !_canEdit)" title="@L["Xfer_SaveRowTitle"]" @onclick="() => SavePoint(p.Id)">💾</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_CancelEsc"]" @onclick="() => _editPointId = null">✕</button>
                                                </td>
                                            </tr>
                                            @* Faccetta trasferimento su una riga a sé: in linea sarebbero sei controlli
                                               in più su una tabella che ne ha già sette, e non ci starebbero. *@
                                            <tr class="xfer-facet-row"><td colspan="7" style="border-top:0;padding:2px 6px 4px 6px">
                                                @FacetFields(_epFacet, p.VariantGroup is not null)
                                            </td></tr>
                                            var prevEdit = PreviewEdit(f);
                                            <tr class="xfer-prev"><td colspan="7" style="border-top:0;padding:0 6px 6px 6px">
                                                <span class="muted" style="font-size:11.5px"><b>@L["Xfer_PreviewLabel"]:</b> <span style="font-style:italic">@(string.IsNullOrWhiteSpace(prevEdit) ? L["Xfer_PreviewIncomplete"].Value : $"“{prevEdit}”")</span></span>
                                            </td></tr>
                                        }
                                        else
                                        {
                                            <tr class="@(p.VariantGroup is null ? null : "xfer-variant")">
                                                <td>
                                                    <b>@(string.IsNullOrWhiteSpace(p.Cop) ? "—" : p.Cop)</b>
                                                    @if (p.VariantGroup is not null)
                                                    {
                                                        <span class="pill neutral" style="margin-left:4px" title="@L["Xfer_VariantTitle"]">@L["Xfer_Variant"] @p.VariantGroup</span>
                                                    }
                                                </td>
                                                <td>
                                                    @p.LevelText
                                                    @* La faccetta si legge sotto il livello autorizzato: sono due livelli,
                                                       e metterli sulla stessa riga confonde proprio ciò che distingue. *@
                                                    @{ var facetSummary = FacetSummary(p); }
                                                    @if (facetSummary.Length > 0)
                                                    {
                                                        <div class="muted" style="font-size:11.5px">→ @facetSummary</div>
                                                    }
                                                </td>
                                                <td>@(p.NextSectorCallsign ?? "—")</td>
                                                <td>@if (!string.IsNullOrWhiteSpace(p.ConditionLabel)) { <span class="pill neutral" title="@L["Xfer_RunwayInUse"]">@p.ConditionLabel</span> } else { <span class="muted">—</span> }</td>
                                                <td>@if (!string.IsNullOrWhiteSpace(p.ConditionAreaLabel)) { <span class="pill neutral" title="@L["Xfer_ActiveArea"]">@p.ConditionAreaLabel</span> } else { <span class="muted">—</span> }</td>
                                                <td>
                                                    @if (p.IsOtherwise) { <span class="pill neutral" title="@L["Xfer_OtherwiseTitle"]">@L["Xfer_Otherwise"]</span> }
                                                    else if (!string.IsNullOrWhiteSpace(p.ConditionCustomLabel)) { <span class="pill neutral" title="@L["Xfer_CustomCond"]">@p.ConditionCustomLabel</span> }
                                                    else { <span class="muted">—</span> }
                                                </td>
                                                <td style="white-space:nowrap">
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_AddVariantTitle"]" @onclick="() => AddVariant(p.Id)">⑂</button>
                                                    @if (p.VariantGroup is not null)
                                                    {
                                                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DetachVariantTitle"]" @onclick="() => DetachVariant(p.Id)">⇤</button>
                                                    }
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[0].Id)" title="@L["Xfer_MoveTop"]" @onclick="() => MoveToEnd(p.Id, true)">⤒</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[0].Id)" title="@L["Xfer_MoveUp"]" @onclick="() => Move(p.Id, true)">▲</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[^1].Id)" title="@L["Xfer_MoveDown"]" @onclick="() => Move(p.Id, false)">▼</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[^1].Id)" title="@L["Xfer_MoveBottom"]" @onclick="() => MoveToEnd(p.Id, false)">⤓</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DuplicateRow"]" @onclick="() => CloneRow(f, p)">⧉</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => EditPoint(f, p)">✎</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => DeletePoint(p.Id)">✕</button>
                                                </td>
                                            </tr>
                                            @if (_showPreviews)
                                            {
                                                var prev = PreviewRow(f, p);
                                                @if (!string.IsNullOrWhiteSpace(prev))
                                                {
                                                    <tr class="xfer-prev"><td colspan="7" style="border-top:0;padding:0 6px 6px 6px"><span class="muted" style="font-size:11.5px;font-style:italic">“@prev”</span></td></tr>
                                                }
                                            }
                                        }
                                    }
                                </tbody>
                            </table>

                            @if (_addPointFlowId == f.Id)
                            {
                                <div class="inline-form" style="margin-top:8px">
                                    <div class="field narrow"><label>CoP <span class="muted" style="font-weight:400">@L["Xfer_CopListHint"]</span></label><input placeholder="VALMA / VALMA, ELB, TOP" @bind="_pCop" @bind:event="oninput" @onkeydown="e => TrySubmitPoint(f.Id, e)" /></div>
                                    <div class="field narrow"><label>@L["Xfer_Constraint"]</label>
                                        <select @bind="_pConstraint">
                                            <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                                            <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                                            <option value="@LevelConstraint.Exact">@L["Xfer_Exact"]</option>
                                            <option value="@LevelConstraint.Special">@L["Xfer_Special"]</option>
                                        </select>
                                    </div>
                                    @if (_pConstraint == LevelConstraint.Special)
                                    {
                                        <div class="field"><label>@L["Xfer_LevelText"]</label><input placeholder="@L["Xfer_PerAirway"]" @bind="_pSpecial" /></div>
                                    }
                                    else
                                    {
                                        <div class="field narrow"><label>@L["Xfer_Value"]</label><input type="number" @bind="_pValue" /></div>
                                        <div class="field narrow"><label>@L["Xfer_Unit"]</label>
                                            <select @bind="_pUnit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                                        </div>
                                    }
                                    <div class="field narrow"><label>@L["Xfer_Levels"] <span class="muted" style="font-weight:400">@L["Xfer_SemicircHint"]</span></label>
                                        <select @bind="_pParity">
                                            <option value="@LevelParity.Any">@L["Xfer_ParityAny"]</option>
                                            <option value="@LevelParity.Even">@L["Xfer_ParityEven"]</option>
                                            <option value="@LevelParity.Odd">@L["Xfer_ParityOdd"]</option>
                                        </select>
                                    </div>
                                    <div class="field narrow"><label>@L["Xfer_VState"]</label>
                                        <select @bind="_pVState">
                                            <option value="@TransferVerticalState.Unspecified">@L["Xfer_VStateNone"]</option>
                                            <option value="@TransferVerticalState.Level">@L["Xfer_VStateLevel"]</option>
                                            <option value="@TransferVerticalState.Descending">@L["Xfer_VStateDescending"]</option>
                                            <option value="@TransferVerticalState.Climbing">@L["Xfer_VStateClimbing"]</option>
                                        </select>
                                    </div>
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_ColReceiver"] <span class="muted" style="font-weight:400">@L["Xfer_EmptyUnicom"]</span></label>
                                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_pNextText" @bind:event="oninput" @bind:after="ResolvePNext"
                                               @onfocus="() => _pOpen = true" @onblur="() => _pOpen = false" />
                                        @if (_pOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in _all.Where(s => Match(s, _pNextText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _pNext ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickPNext(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode</span></button>
                                                }
                                                @if (!_all.Any(s => Match(s, _pNextText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                            </div>
                                        }
                                    </div>
                                    @* --- Condizioni: tre dimensioni indipendenti (pista/e · area · personalizzata), tutte opzionali --- *@
                                    <div class="field"><label>@L["Xfer_RunwaysInUse"] <span class="muted" style="font-weight:400">@L["Xfer_MultiSelectHint"]</span></label>
                                        @if (_condRunways.Count > 0)
                                        {
                                            <select multiple size="4" @bind="_pCondRwys">@foreach (var r in _condRunways) { <option value="@r.Ident">@RwyLabel(r)</option> }</select>
                                        }
                                        else { <span class="muted" style="font-size:11.5px">@L["Xfer_NoRunwaysForApt"]</span> }
                                    </div>
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_ActiveArea"] <span class="muted" style="font-weight:400">@L["Xfer_SearchHint"]</span></label>
                                        <input placeholder="@L["Xfer_SearchArea"]" @bind="_pAreaText" @bind:event="oninput" @bind:after="ResolvePArea"
                                               @onfocus="() => _pAreaOpen = true" @onblur="() => _pAreaOpen = false" />
                                        @if (_pAreaOpen)
                                        {
                                            <div class="sector-pick">
                                                <button type="button" class="sp-item" @onmousedown:preventDefault="true" @onmousedown="() => PickPArea(null)"><span class="muted">@L["Xfer_AreaNone"]</span></button>
                                                @foreach (var a in MatchAreas(_pAreaText).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(string.Equals(a.Name, _pCondAreaLabel, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickPArea(a)">@a.Name @if (!string.IsNullOrWhiteSpace(a.Type)) { <span class="muted" style="font-size:11px">@a.Type</span> }</button>
                                                }
                                                @if (!MatchAreas(_pAreaText).Any()) { <span class="sp-empty">@L["Xfer_NoArea"]</span> }
                                            </div>
                                        }
                                    </div>
                                    <div class="field"><label>@L["Xfer_ColCustom"] <span class="muted" style="font-weight:400">@L["Xfer_FreeTextHint"]</span></label>
                                        <input placeholder="@L["Xfer_CustomPh"]" @bind="_pCondCustomLabel" @bind:event="oninput" @onkeydown="e => TrySubmitPoint(f.Id, e)" />
                                    </div>
                                    <div style="flex-basis:100%">@FacetFields(_pFacet, inGroup: false)</div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="() => AddPoint(f.Id)">@L["Xfer_AddRow"]</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_AddRowContinueTitle"]" @onclick="() => AddPoint(f.Id, true)">＋ @L["Xfer_AddRowContinue"]</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _addPointFlowId = null">@L["Common_Cancel"]</button>
                                    @{ var prevAdd = PreviewAdd(f); }
                                    <div style="flex-basis:100%;margin-top:2px">
                                        <span class="muted" style="font-size:11.5px"><b>@L["Xfer_PreviewLabel"]:</b> <span style="font-style:italic">@(string.IsNullOrWhiteSpace(prevAdd) ? L["Xfer_PreviewIncomplete"].Value : $"“{prevAdd}”")</span></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button class="btn ghost" style="margin-top:8px" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddPoint(f)">+ @L["Xfer_AddRowFull"]</button>
                            }
                        }
                        }
                    </div>
                }
            }
            }
        }
    }
</div>

@code {
    private string _accCode = "";
    private AccInfo? _acc;
    private IReadOnlyList<TransferFlowRow> _flows = Array.Empty<TransferFlowRow>();
    private IReadOnlyList<GlobalSectorRow> _all = Array.Empty<GlobalSectorRow>();
    private IReadOnlyList<AirportAdminRow> _airports = Array.Empty<AirportAdminRow>();
    private IReadOnlyList<NeighbourCandidateRow> _candidates = Array.Empty<NeighbourCandidateRow>();
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _status, _error;

    // Anteprima frasi: contesto (mappe + template) caricato alla scelta dell'ACC; compone in locale (nessun round-trip
    // per tasto). _showPreviews = mostra la frase risultante sotto ogni riga in lettura (default on).
    private CoordinationPreviewContext? _preview;
    private bool _showPreviews = true;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // Stato collasso (chiavi presenti = collassate): settore, aeroporto (settore|icao), gruppo arrivi/partenze (flowId).
    private readonly HashSet<string> _collapsedSec = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _collapsedApt = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<int> _collapsedFlow = new();

    // form nuovo gruppo (flusso). _fSectorText = ricerca callsign; _fSector = id risolto.
    private int _fSector;
    private string _fSectorText = "";
    private TransferFlowKind _fKind = TransferFlowKind.Arrival;
    private string _fApt = "", _fAptName = "", _fDesc = "";
    private string? _fAptMsg, _efAptMsg;   // esito lookup IVAO del nome aeroporto fuori DB (add / edit)

    // form nuova riga (punto) del gruppo _addPointFlowId. _pNextText = ricerca callsign; _pNext = id risolto (0 = UNICOM).
    private int? _addPointFlowId;
    private string _pCop = "";
    private LevelConstraint _pConstraint = LevelConstraint.AtOrBelow;
    private int? _pValue;
    private LevelUnit _pUnit = LevelUnit.Fl;
    private string _pSpecial = "";
    private LevelParity _pParity = LevelParity.Any;
    private TransferVerticalState _pVState = TransferVerticalState.Unspecified;
    private int _pNext;
    private string _pNextText = "";
    // Condizione: tre dimensioni indipendenti (tutte opzionali).
    private string[] _pCondRwys = Array.Empty<string>();   // piste selezionate (ident)
    private string _pCondAreaLabel = "";                   // area attiva (nome)
    private string _pAreaText = "";                        // testo ricerca area (typeahead)
    private bool _pAreaOpen;                               // dropdown area aperto
    private string _pCondCustomLabel = "";                 // condizione personalizzata

    // Piste reali dell'aeroporto del flusso in editing (opzioni condizione «Pista»); vuoto se fuori DB / non importate.
    private IReadOnlyList<RunwayRow> _condRunways = Array.Empty<RunwayRow>();

    // Aree speciali dell'ACC corrente (opzioni condizione «Area»); caricate alla scelta dell'ACC.
    private IReadOnlyList<SpecialAreaPick> _areas = Array.Empty<SpecialAreaPick>();

    // form edit gruppo (flusso) in-place. _efSector = id mittente risolto (editabile).
    private int? _editFlowId;
    private TransferFlowKind _efKind = TransferFlowKind.Arrival;
    private string _efApt = "", _efAptName = "", _efDesc = "";
    private int _efSector;
    private string _efSectorText = "";
    private bool _efOpen;

    // form clona gruppo (righe incluse) verso un altro settore mittente. _cloneSector = id destinazione risolto.
    private int? _cloneFlowId;
    private int _cloneSector;
    private string _cloneSectorText = "";
    private bool _cloneOpen;

    // Filtro elenco esistente.
    private string _flowFilter = "";
    private TransferFlowKind? _kindFilter;

    // Un filtro attivo espande l'albero: quello che resta va visto, non ricercato a mano cliccando.
    private bool _filtering => !string.IsNullOrWhiteSpace(_flowFilter) || _kindFilter is not null || _toReviewOnly;

    /// <summary>Filtro «da rivedere»: mostra solo i flussi con almeno una riga da rivedere.</summary>
    private bool _toReviewOnly;

    /// <summary>
    /// Una riga «da rivedere» è una riga che consegna a un APP e non dice ancora dove avviene il trasferimento.
    /// Prima della faccetta quel dato non esisteva, quindi il suo livello poteva voler dire due cose diverse
    /// (autorizzato o al trasferimento) e solo chi ha scritto la riga lo sa: vanno riaperte a mano.
    /// </summary>
    private bool NeedsReview(TransferPointRow p) =>
        p.HandoffKind == TransferHandoffKind.Unspecified
        && p.NextSectorId is int id
        && _all.FirstOrDefault(s => s.Id == id)?.Type == SectorType.App;

    private int ToReviewCount() => _flows.Sum(f => f.Points.Count(NeedsReview));

    /// <summary>Flussi filtrati per testo (settore/aeroporto/descrizione/CoP/ricevente), per tipo e «da rivedere».</summary>
    private IReadOnlyList<TransferFlowRow> FilteredFlows()
    {
        var q = _flowFilter.Trim();
        return _flows.Where(f =>
            (_kindFilter is null || f.Kind == _kindFilter)
            && (!_toReviewOnly || f.Points.Any(NeedsReview))
            && (q.Length == 0
                || (f.OwningSectorCallsign?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.AirportIcao?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || f.Points.Any(p =>
                    (p.Cop?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (p.NextSectorCallsign?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))))
            .ToList();
    }

    private void ResolveEfSector() =>
        _efSector = OwnSectors().FirstOrDefault(s => string.Equals(s.Callsign, _efSectorText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
    private void PickEfSector(GlobalSectorRow s) { _efSector = s.Id; _efSectorText = s.Callsign; _efOpen = false; }

    // form edit riga (punto) in-place. _epNext = id risolto (0 = UNICOM).
    private int? _editPointId;
    private string _epCop = "";
    private LevelConstraint _epConstraint = LevelConstraint.AtOrBelow;
    private int? _epValue;
    private LevelUnit _epUnit = LevelUnit.Fl;
    private string _epSpecial = "";
    private LevelParity _epParity = LevelParity.Any;
    private TransferVerticalState _epVState = TransferVerticalState.Unspecified;
    private int _epNext;
    private string _epNextText = "";
    private string[] _epCondRwys = Array.Empty<string>();   // piste selezionate (ident)
    private string _epCondAreaLabel = "";                   // area attiva (nome)
    private string _epAreaText = "";                        // testo ricerca area (typeahead)
    private bool _epAreaOpen;                               // dropdown area aperto
    private string _epCondCustomLabel = "";                 // condizione personalizzata

    /// <summary>
    /// Stato del form per la faccetta TRASFERIMENTO di una riga (dove passa il controllo, a che livello, dove
    /// passano le comunicazioni, velocità, «negli altri casi»).
    /// <para>Un oggetto e non dieci campi sciolti per form: i form sono due (modifica in-place e nuova riga) e
    /// la faccetta ha dieci pezzi — venti campi paralleli con prefisso diverso sono venti occasioni di
    /// aggiornarne uno solo dei due.</para>
    /// </summary>
    private sealed class FacetForm
    {
        public TransferHandoffKind Kind { get; set; } = TransferHandoffKind.Unspecified;
        public string Label { get; set; } = "";
        public int? LevelValue { get; set; }
        public LevelUnit LevelUnit { get; set; } = LevelUnit.Fl;
        public LevelConstraint LevelConstraint { get; set; } = LevelConstraint.Exact;
        public TransferHandoffKind CommsKind { get; set; } = TransferHandoffKind.Unspecified;
        public string CommsLabel { get; set; } = "";
        public int? SpeedValue { get; set; }
        public SpeedConstraint SpeedConstraint { get; set; } = SpeedConstraint.Unspecified;
        public bool IsOtherwise { get; set; }

        public void LoadFrom(TransferPointRow p)
        {
            Kind = p.HandoffKind; Label = p.HandoffLabel ?? "";
            LevelValue = p.HandoffLevelValue; LevelUnit = p.HandoffLevelUnit;
            // Su una riga che la faccetta non l'ha mai usata, il vincolo salvato è il valore di riposo della
            // colonna (AtOrAbove, lo zero dell'enum) e non una scelta di nessuno: caricarlo farebbe partire il
            // form da «o superiore» e la prima faccetta scritta direbbe la forma sbagliata. Trovato guidando
            // l'editor: la frase usciva «al confine dell'AoR a FL110 o superiore» invece di «passando FL110».
            LevelConstraint = p.HandoffKind == TransferHandoffKind.Unspecified
                ? LevelConstraint.Exact
                : p.HandoffLevelConstraint;
            CommsKind = p.CommsHandoffKind; CommsLabel = p.CommsHandoffLabel ?? "";
            SpeedValue = p.SpeedValue; SpeedConstraint = p.SpeedConstraint;
            IsOtherwise = p.IsOtherwise;
        }

        /// <summary>Svuota il form. Con <paramref name="preset"/> apre già la faccetta sul caso più comune —
        /// «al confine dell'AoR, passando un livello» — che è la forma di un accordo ACC→APP.</summary>
        public void Reset(bool preset = false)
        {
            Kind = preset ? TransferHandoffKind.AorBoundary : TransferHandoffKind.Unspecified;
            Label = ""; LevelValue = null; LevelUnit = LevelUnit.Fl; LevelConstraint = LevelConstraint.Exact;
            CommsKind = TransferHandoffKind.Unspecified; CommsLabel = "";
            SpeedValue = null; SpeedConstraint = SpeedConstraint.Unspecified;
            IsOtherwise = false;
        }

        public TransferHandoffFacet ToFacet() => new(
            Kind, Label, LevelValue, LevelUnit, LevelConstraint,
            CommsKind, CommsLabel, SpeedValue, SpeedConstraint, IsOtherwise);

        /// <summary>Riversa la faccetta nell'input di salvataggio (l'input è un record: <c>with</c> tiene
        /// insieme i campi senza ricopiare gli altri quindici).</summary>
        public TransferPointInput Apply(TransferPointInput input) => input with
        {
            HandoffKind = Kind,
            HandoffLabel = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim(),
            HandoffLevelValue = LevelValue,
            HandoffLevelUnit = LevelUnit,
            HandoffLevelConstraint = LevelConstraint,
            CommsHandoffKind = CommsKind,
            CommsHandoffLabel = string.IsNullOrWhiteSpace(CommsLabel) ? null : CommsLabel.Trim(),
            SpeedValue = SpeedValue,
            SpeedConstraint = SpeedConstraint,
            IsOtherwise = IsOtherwise,
        };
    }

    private readonly FacetForm _epFacet = new();   // modifica in-place
    private readonly FacetForm _pFacet = new();    // nuova riga

    /// <summary>
    /// Campi della faccetta trasferimento, identici nei due form (modifica in-place e nuova riga). I campi
    /// dipendenti compaiono solo quando servono: l'etichetta non si chiede per il confine dell'AoR, che si
    /// descrive da sé, e il valore di velocità non si chiede senza vincolo.
    /// <para><paramref name="inGroup"/> = la riga sta in un gruppo di varianti: solo lì «negli altri casi»
    /// significa qualcosa, perché solo lì esistono «gli altri casi».</para>
    /// </summary>
    private RenderFragment FacetFields(FacetForm ff, bool inGroup) => __builder =>
    {
        <div class="xfer-facet">
            <label>@L["Xfer_Handoff"]</label>
            <select @bind="ff.Kind" title="@L["Xfer_HandoffTitle"]">
                <option value="@TransferHandoffKind.Unspecified">@L["Xfer_HandoffNone"]</option>
                <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
            </select>
            @if (ff.Kind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
            {
                <input style="width:130px" placeholder="@L["Xfer_HandoffLabelPh"]" @bind="ff.Label" @bind:event="oninput" />
            }

            @if (ff.Kind != TransferHandoffKind.Unspecified)
            {
                <label>@L["Xfer_HandoffLevel"]</label>
                <select @bind="ff.LevelConstraint" style="width:96px" title="@L["Xfer_HandoffLevelTitle"]">
                    <option value="@LevelConstraint.Exact">@L["Xfer_HandoffPassing"]</option>
                    <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                    <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                </select>
                <input type="number" style="width:70px" @bind="ff.LevelValue" @bind:event="oninput" />
                <select @bind="ff.LevelUnit" style="width:56px"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>

                <label>@L["Xfer_Comms"]</label>
                <select @bind="ff.CommsKind" title="@L["Xfer_CommsTitle"]">
                    <option value="@TransferHandoffKind.Unspecified">@L["Xfer_CommsSame"]</option>
                    <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                    <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                    <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                </select>
                @if (ff.CommsKind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
                {
                    <input style="width:130px" placeholder="@L["Xfer_HandoffLabelPh"]" @bind="ff.CommsLabel" @bind:event="oninput" />
                }
            }

            <label>@L["Xfer_Speed"]</label>
            <select @bind="ff.SpeedConstraint" style="width:96px">
                <option value="@SpeedConstraint.Unspecified">@L["Xfer_SpeedNone"]</option>
                <option value="@SpeedConstraint.AtOrBelow">≤</option>
                <option value="@SpeedConstraint.AtOrAbove">≥</option>
                <option value="@SpeedConstraint.Exact">=</option>
            </select>
            @if (ff.SpeedConstraint != SpeedConstraint.Unspecified)
            {
                <input type="number" style="width:70px" placeholder="250" @bind="ff.SpeedValue" @bind:event="oninput" />
                <span class="muted" style="font-size:11.5px">kt</span>
            }

            @if (inGroup)
            {
                <label class="xfer-otherwise" title="@L["Xfer_OtherwiseTitle"]">
                    <input type="checkbox" @bind="ff.IsOtherwise" /> @L["Xfer_Otherwise"]
                </label>
            }
        </div>
    };

    // Aree filtrate per testo (typeahead): match sul nome (case-insensitive); vuoto = tutte.
    private IEnumerable<SpecialAreaPick> MatchAreas(string text) =>
        string.IsNullOrWhiteSpace(text) ? _areas : _areas.Where(a => a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));

    // Risoluzione/scelta area per la form nuova riga e per l'edit in-place.
    private void ResolvePArea() =>
        _pCondAreaLabel = _areas.FirstOrDefault(a => string.Equals(a.Name, _pAreaText.Trim(), StringComparison.OrdinalIgnoreCase))?.Name ?? "";
    private void PickPArea(SpecialAreaPick? a) { _pCondAreaLabel = a?.Name ?? ""; _pAreaText = a?.Name ?? ""; _pAreaOpen = false; }
    private void ResolveEpArea() =>
        _epCondAreaLabel = _areas.FirstOrDefault(a => string.Equals(a.Name, _epAreaText.Trim(), StringComparison.OrdinalIgnoreCase))?.Name ?? "";
    private void PickEpArea(SpecialAreaPick? a) { _epCondAreaLabel = a?.Name ?? ""; _epAreaText = a?.Name ?? ""; _epAreaOpen = false; }

    // Etichetta piste combinata ("16R / 16L"), in ordine di pista dell'aeroporto; soft-ref pista solo se singola.
    private string RunwaysLabel(string[] idents)
    {
        var ordered = _condRunways.Count > 0
            ? _condRunways.Where(r => idents.Contains(r.Ident, StringComparer.OrdinalIgnoreCase)).Select(r => r.Ident)
            : idents;
        return string.Join(" / ", ordered);
    }

    private int? ResolveRwyRef(string[] idents) =>
        idents.Length == 1
            ? _condRunways.FirstOrDefault(r => string.Equals(r.Ident, idents[0], StringComparison.OrdinalIgnoreCase))?.Id
            : null;

    // Riporta un'etichetta piste ("16R / 16L", tollera il vecchio prefisso "RWY ") all'insieme di ident selezionati.
    private static string[] ParseRwys(string? label) =>
        (label ?? "").Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => s.StartsWith("RWY ", StringComparison.OrdinalIgnoreCase) ? s[4..].Trim() : s)
            .ToArray();

    // Dropdown ricerca aperto?
    private bool _fOpen, _pOpen, _aOpen, _epOpen;

    private void ResolveEpNext() =>
        _epNext = _all.FirstOrDefault(s => string.Equals(s.Callsign, _epNextText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private void PickEpNext(GlobalSectorRow s) { _epNext = s.Id; _epNextText = s.Callsign; _epOpen = false; }

    private void ResolveFSector() =>
        _fSector = OwnSectors().FirstOrDefault(s => string.Equals(s.Callsign, _fSectorText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private void ResolvePNext() =>
        _pNext = _all.FirstOrDefault(s => string.Equals(s.Callsign, _pNextText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private static bool Match(GlobalSectorRow s, string text) =>
        string.IsNullOrWhiteSpace(text) || s.Callsign.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private void PickFSector(GlobalSectorRow s) { _fSector = s.Id; _fSectorText = s.Callsign; _fOpen = false; }
    private void PickPNext(GlobalSectorRow s)
    {
        _pNext = s.Id; _pNextText = s.Callsign; _pOpen = false;
        // Preset: scegliendo un APP come ricevente, la riga è quasi sempre un accordo a due eventi. La faccetta
        // si apre già sulla forma tipica invece di restare chiusa e obbligare a un giro in più. Solo se l'utente
        // non l'ha già toccata — un preset che sovrascrive una scelta fatta è un bug, non una comodità.
        if (s.Type == SectorType.App && _pFacet.Kind == TransferHandoffKind.Unspecified) _pFacet.Reset(preset: true);
    }

    private static bool MatchApt(AirportAdminRow a, string text) =>
        string.IsNullOrWhiteSpace(text)
        || a.Icao.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)
        || a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private void PickApt(AirportAdminRow a) { _fApt = a.Icao; _fAptName = ""; _aOpen = false; }

    // Aeroporto fuori DB (nuovo/estero) senza nome: va bloccato, il nome è obbligatorio per gli aeroporti a mano.
    private bool NewAptMissingName(string icao, string name) =>
        !string.IsNullOrWhiteSpace(icao) && !IsKnownApt(icao) && string.IsNullOrWhiteSpace(name);

    // Aeroporto già nel catalogo DB? Se sì il nome viene da lì e non serve chiederlo.
    private bool IsKnownApt(string icao) =>
        _airports.Any(a => string.Equals(a.Icao, icao.Trim(), StringComparison.OrdinalIgnoreCase));

    // Cerca il nome dell'aeroporto fuori DB su IVAO (per-ICAO, anche estero) e riempie il campo nome.
    // NON lo aggiunge al catalogo: resta un nome libero sul flusso (così non compare nei picker «Nuovo documento»).
    private async Task LookupApt(bool edit)
    {
        var icao = ((edit ? _efApt : _fApt) ?? "").Trim().ToUpperInvariant();
        if (icao.Length < 3) { SetAptMsg(edit, L["Xfer_TypeIcaoFirst"]); return; }
        _busy = true;
        SetAptMsg(edit, L["Xfer_SearchingIvao"]);
        await InvokeAsync(StateHasChanged);
        try
        {
            var info = await Struct.LookupExternalAirportAsync(icao);
            if (info is null) { SetAptMsg(edit, string.Format(L["Xfer_NotFoundIvao"].Value, icao)); }
            else
            {
                if (edit) _efAptName = info.Name; else _fAptName = info.Name;
                var extra = string.Join(" · ", new[] { info.City, info.AccCode }.Where(s => !string.IsNullOrWhiteSpace(s)));
                SetAptMsg(edit, $"✓ {info.Icao} — {info.Name}{(extra.Length > 0 ? $" ({extra})" : "")}");
            }
        }
        catch (Exception ex) { SetAptMsg(edit, L["Common_Error"] + ex.Message); }
        finally { _busy = false; }
    }

    private void SetAptMsg(bool edit, string msg) { if (edit) _efAptMsg = msg; else _fAptMsg = msg; }

    // ICAO già cercati in auto (per non ripetere la chiamata IVAO a ogni blur dello stesso codice).
    private readonly HashSet<string> _autoLookedUp = new(StringComparer.OrdinalIgnoreCase);

    private async Task OnAptBlur()
    {
        _aOpen = false;
        await MaybeAutoLookup(false);
    }

    // Aeroporto fuori DB e senza nome ancora: cerca il nome su IVAO senza attendere il click sul bottone 🔍.
    // Una sola volta per ICAO; il bottone manuale resta come re-trigger (bypassa il guard).
    private async Task MaybeAutoLookup(bool edit)
    {
        var icao = ((edit ? _efApt : _fApt) ?? string.Empty).Trim().ToUpperInvariant();
        if (icao.Length < 4 || IsKnownApt(icao)) return;
        if (!string.IsNullOrWhiteSpace(edit ? _efAptName : _fAptName)) return;
        if (!_autoLookedUp.Add(icao)) return;
        await LookupApt(edit);
    }

    // Etichetta header aeroporto: «✈ ICAO — Nome» (catalogo DB o nome salvato sul flusso); «Senza aeroporto» se null.
    private string AptHeader(string? icao)
    {
        if (string.IsNullOrWhiteSpace(icao)) return L["Xfer_NoAirportHdr"];
        var name = _airports.FirstOrDefault(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase))?.Name
            ?? _flows.FirstOrDefault(f => string.Equals(f.AirportIcao, icao, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(f.AirportName))?.AirportName;
        return string.IsNullOrWhiteSpace(name) ? $"✈ {icao}" : $"✈ {icao} — {name}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        // Il selettore ACC legge Stations.Accs nel RENDER: va scaldato ORA, con il context libero e
        // sequenziale. Senza, il lazy-load parte durante il render e il circuito muore con «A second
        // operation was started» (verifica live A6 su MariaDB: la pagina non si apriva affatto).
        Stations.Prewarm();
        _all = await Struct.ListSectorNodesAsync();
        _airports = await Struct.ListAllAirportsAsync();
        // Coppie confinanti: abilitano i settori esteri come MITTENTI (direzione estero→home nelle vLOA).
        _candidates = await Neighbours.ListAsync();
    }

    private Task SelectAcc(string code)
    {
        _accCode = code;
        return OnAccChanged();
    }

    private async Task OnAccChanged()
    {
        _status = _error = null;
        _addPointFlowId = null; _cloneFlowId = null; _editFlowId = null; _editPointId = null;
        _fSector = 0; _fSectorText = ""; _fApt = ""; _fAptName = ""; _fDesc = "";
        _acc = string.IsNullOrWhiteSpace(_accCode) ? null : Stations.Resolve(_accCode);
        if (_acc is null) { _flows = Array.Empty<TransferFlowRow>(); _areas = Array.Empty<SpecialAreaPick>(); _preview = null; return; }
        _areas = await AccDeriv.ListSpecialAreasByAccAsync(_acc.Code);
        await LoadAsync();   // popola anche _preview
        CollapseAll();
    }

    private async Task LoadAsync()
    {
        _flows = await Transfers.ListFlowsByAccAsync(_acc!.Code);
        // Rinfresca il contesto anteprima (mappe aeroporti/nomi) così le frasi riflettono l'ultima modifica.
        _preview = await AccDeriv.GetPreviewContextAsync(_acc.Code);
    }

    // Su scelta ACC parti con tutto collassato: riempi i set di collasso con tutte le chiavi correnti.
    private void CollapseAll()
    {
        _collapsedSec.Clear(); _collapsedApt.Clear(); _collapsedFlow.Clear();
        foreach (var f in _flows)
        {
            _collapsedSec.Add(f.OwningSectorCallsign);
            _collapsedApt.Add($"{f.OwningSectorCallsign}|{f.AirportIcao}");
            _collapsedFlow.Add(f.Id);
        }
    }

    // Espandi tutto: svuota i set di collasso (tutti i livelli aperti).
    private void ExpandAll() { _collapsedSec.Clear(); _collapsedApt.Clear(); _collapsedFlow.Clear(); }

    // Apre il percorso (settore ▸ aeroporto ▸ flusso) fino a un flusso specifico: usato dopo add/clona/edit così il
    // gruppo toccato è subito visibile anche se il ramo era collassato.
    private void ExpandTo(int flowId)
    {
        var f = _flows.FirstOrDefault(x => x.Id == flowId);
        if (f is null) return;
        _collapsedSec.Remove(f.OwningSectorCallsign);
        _collapsedApt.Remove($"{f.OwningSectorCallsign}|{f.AirportIcao}");
        _collapsedFlow.Remove(f.Id);
    }

    // Anteprima frase di una riga esistente (lettura). Null = dati incompleti / UNICOM (nessuna frase, come la derivazione).
    private string? PreviewRow(TransferFlowRow f, TransferPointRow p) =>
        _preview?.Compose(f.OwningSectorCallsign, p.NextSectorCallsign, f.AirportIcao, f.Kind,
            p.LevelConstraint, p.LevelValue, p.LevelUnit, p.LevelSpecial, p.Parity, p.VerticalState, p.Cop,
            p.ConditionLabel, p.ConditionAreaLabel, p.ConditionCustomLabel,
            TransferHandoffFacet.From(p));

    // Anteprima live della riga in EDIT (dai campi _ep*). Usa la label piste combinata come nel salvataggio.
    private string? PreviewEdit(TransferFlowRow f) =>
        _preview?.Compose(f.OwningSectorCallsign, _epNext == 0 ? null : _epNextText, f.AirportIcao, f.Kind,
            _epConstraint, _epValue, _epUnit, _epSpecial, _epParity, _epVState, _epCop,
            _epCondRwys.Length == 0 ? null : RunwaysLabel(_epCondRwys),
            string.IsNullOrWhiteSpace(_epCondAreaLabel) ? null : _epCondAreaLabel,
            string.IsNullOrWhiteSpace(_epCondCustomLabel) ? null : _epCondCustomLabel,
            _epFacet.ToFacet());

    // Anteprima live della riga in AGGIUNTA (dai campi _p*). Per liste di CoP usa il primo come esempio.
    private string? PreviewAdd(TransferFlowRow f)
    {
        var cop = SplitCops(_pCop).FirstOrDefault() ?? "";
        return _preview?.Compose(f.OwningSectorCallsign, _pNext == 0 ? null : _pNextText, f.AirportIcao, f.Kind,
            _pConstraint, _pValue, _pUnit, _pSpecial, _pParity, _pVState, cop,
            _pCondRwys.Length == 0 ? null : RunwaysLabel(_pCondRwys),
            string.IsNullOrWhiteSpace(_pCondAreaLabel) ? null : _pCondAreaLabel,
            string.IsNullOrWhiteSpace(_pCondCustomLabel) ? null : _pCondCustomLabel,
            _pFacet.ToFacet());
    }

    /// <summary>Settori mittenti candidati: i settori di questo ACC + quelli degli ACC esteri confinanti (per la
    /// direzione estero→home nelle vLOA). Il flusso resta salvato sotto l'ACC italiano (lo gestisce lo staff IT).</summary>
    private IEnumerable<GlobalSectorRow> OwnSectors()
    {
        var home = _acc!.Code;
        var confining = _candidates
            .Where(c => string.Equals(c.HomeAccCode, home, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.ForeignAccCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _all
            .Where(s => string.Equals(s.AccCode, home, StringComparison.OrdinalIgnoreCase) || confining.Contains(s.AccCode))
            .OrderByDescending(s => string.Equals(s.AccCode, home, StringComparison.OrdinalIgnoreCase))
            .ThenBy(s => s.AccCode).ThenBy(s => s.Callsign);
    }

    private bool IsForeignSender(GlobalSectorRow s) =>
        _acc is not null && !string.Equals(s.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase);

    private string KindLabel(TransferFlowKind k) => k switch
    {
        TransferFlowKind.Arrival => L["Xfer_KindArrival"],
        TransferFlowKind.Departure => L["Xfer_KindDeparture"],
        TransferFlowKind.Overflight => L["Xfer_KindOverflight"],
        TransferFlowKind.Vfr => L["Xfer_KindVfr"],
        _ => L["Xfer_KindOther"],
    };

    // Etichetta conteggio gruppi con plurale IT (gruppo/gruppi).
    private string GroupsCountLabel(int n) =>
        string.Format((n == 1 ? L["Xfer_GroupsN_1"] : L["Xfer_GroupsN"]).Value, n);

    // Etichetta di una pista per il picker/label: «RWY 07».
    private static string RwyLabel(RunwayRow r) => $"RWY {r.Ident}";

    // Piste reali dell'aeroporto del flusso (read libero). Fuori DB / non importate → lista vuota (nessuna opzione).
    private async Task LoadCondRulesAsync(string? icao)
    {
        _condRunways = Array.Empty<RunwayRow>();
        if (string.IsNullOrWhiteSpace(icao)) return;
        try { var d = await Airports.LoadForViewAsync(icao); if (d is not null) _condRunways = d.Runways; }
        catch { /* aeroporto fuori DB o non proiettato: nessuna opzione pista */ }
    }

    // Arrivi/Partenze richiedono un aeroporto (destinazione/origine): specchia la validazione del service.
    private static bool AirportRequiredMissing(TransferFlowKind kind, string apt) =>
        kind is TransferFlowKind.Arrival or TransferFlowKind.Departure && string.IsNullOrWhiteSpace(apt);

    private void ToggleSec(string key) { if (!_collapsedSec.Add(key)) _collapsedSec.Remove(key); }
    private void ToggleApt(string key) { if (!_collapsedApt.Add(key)) _collapsedApt.Remove(key); }
    private void ToggleFlow(int id) { if (!_collapsedFlow.Add(id)) _collapsedFlow.Remove(id); }

    // Attivazione da tastiera per i toggle non-<button> (Invio/Spazio), per accessibilità.
    private static bool IsActivationKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
        => e.Key is "Enter" or " " or "Spacebar";

    // Submit da tastiera: Invio dai campi liberi conferma il form, ma non mentre un picker dropdown è aperto
    // (lì Invio non deve inviare: la scelta del settore/aeroporto avviene dal dropdown).
    private async Task TrySubmitGroup(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _fOpen || _aOpen) return;
        if (_busy || !_canEdit || _fSector == 0 || NewAptMissingName(_fApt, _fAptName)) return;
        await AddFlow();
    }

    private async Task TrySubmitPoint(int flowId, Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _addPointFlowId = null; return; }   // Esc = annulla aggiunta
        if (e.Key != "Enter") return;
        if (_busy || !_canEdit) return;
        // Ctrl+Invio = «Salva e aggiungi» (form aperto); Invio semplice aggiunge e chiude (non mentre un picker è aperto).
        if (e.CtrlKey) { await AddPoint(flowId, keepOpen: true); return; }
        if (_pOpen) return;
        await AddPoint(flowId);
    }

    // Invio (o Ctrl+Invio) salva l'edit in-place della riga; Esc annulla. Invio semplice non salva mentre il picker
    // ricevente è aperto (lì serve a scegliere); Ctrl+Invio salva comunque.
    private async Task TrySavePoint(int pointId, Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _editPointId = null; return; }   // Esc = annulla modifica
        if (e.Key != "Enter") return;
        if (_busy || !_canEdit) return;
        if (_epOpen && !e.CtrlKey) return;
        await SavePoint(pointId);
    }

    private async Task OpenAddPoint(TransferFlowRow f)
    {
        _editPointId = null; _editFlowId = null; _cloneFlowId = null;
        _addPointFlowId = f.Id;
        _pCop = ""; _pConstraint = LevelConstraint.AtOrBelow; _pValue = null; _pUnit = LevelUnit.Fl;
        _pSpecial = ""; _pParity = LevelParity.Any; _pVState = TransferVerticalState.Unspecified; _pNext = 0; _pNextText = "";
        _pCondRwys = Array.Empty<string>(); _pCondAreaLabel = ""; _pAreaText = ""; _pAreaOpen = false; _pCondCustomLabel = "";
        _pFacet.Reset();
        await LoadCondRulesAsync(f.AirportIcao);
    }

    private async Task AddFlow()
    {
        var newId = 0;
        await Guarded(async () =>
        {
            newId = await Transfers.AddFlowAsync(_acc!.Code, new TransferFlowInput
            {
                OwningSectorId = _fSector, Kind = _fKind,
                AirportIcao = string.IsNullOrWhiteSpace(_fApt) ? null : _fApt,
                AirportName = IsKnownApt(_fApt) ? null : _fAptName,
                Description = string.IsNullOrWhiteSpace(_fDesc) ? null : _fDesc,
            });
            _fSector = 0; _fSectorText = ""; _fApt = ""; _fAptName = ""; _fDesc = "";
        }, L["Xfer_GroupAdded"]);
        if (newId > 0) ExpandTo(newId);   // rendi subito visibile il gruppo appena creato
    }

    private Task DeleteFlow(int id) => Guarded(() =>
        Transfers.DeleteFlowAsync(_acc!.Code, id), L["Xfer_GroupDeleted"]);

    private Task Move(int pointId, bool up) => Guarded(() => Transfers.MovePointAsync(_acc!.Code, pointId, up), null);

    private Task MoveToEnd(int pointId, bool top) => Guarded(() => Transfers.MovePointToEndAsync(_acc!.Code, pointId, top), null);

    private void EditFlow(TransferFlowRow f)
    {
        _editPointId = null; _addPointFlowId = null;
        _editFlowId = f.Id; _efKind = f.Kind; _efApt = f.AirportIcao ?? ""; _efAptName = f.AirportName ?? ""; _efDesc = f.Description ?? "";
        _efSector = f.OwningSectorId; _efSectorText = f.OwningSectorCallsign; _efOpen = false;
    }

    private async Task SaveFlow(int flowId)
    {
        await Guarded(async () =>
        {
            await Transfers.UpdateFlowAsync(_acc!.Code, flowId, new TransferFlowInput
            {
                OwningSectorId = _efSector, Kind = _efKind,
                AirportIcao = string.IsNullOrWhiteSpace(_efApt) ? null : _efApt,
                AirportName = IsKnownApt(_efApt) ? null : _efAptName,
                Description = string.IsNullOrWhiteSpace(_efDesc) ? null : _efDesc,
            });
            _editFlowId = null;
        }, L["Xfer_GroupUpdated"]);
    }

    // Clona riga: precompila il form "nuova riga" del flusso coi valori della riga sorgente (utente conferma/modifica).
    private async Task CloneRow(TransferFlowRow f, TransferPointRow p)
    {
        _editPointId = null; _editFlowId = null; _cloneFlowId = null;
        _addPointFlowId = f.Id;
        _pCop = p.Cop; _pConstraint = p.LevelConstraint; _pValue = p.LevelValue; _pUnit = p.LevelUnit;
        _pSpecial = p.LevelSpecial ?? ""; _pParity = p.Parity; _pVState = p.VerticalState; _pNext = p.NextSectorId ?? 0; _pNextText = p.NextSectorCallsign ?? "";
        _pCondRwys = ParseRwys(p.ConditionLabel); _pCondAreaLabel = p.ConditionAreaLabel ?? ""; _pAreaText = p.ConditionAreaLabel ?? ""; _pAreaOpen = false;
        _pCondCustomLabel = p.ConditionCustomLabel ?? "";
        _pFacet.LoadFrom(p);
        await LoadCondRulesAsync(f.AirportIcao);
    }

    private void OpenCloneFlow(TransferFlowRow f)
    {
        _editFlowId = null; _editPointId = null; _addPointFlowId = null;
        _collapsedFlow.Remove(f.Id);
        _cloneFlowId = f.Id;
        _cloneSector = f.OwningSectorId; _cloneSectorText = f.OwningSectorCallsign; _cloneOpen = false;
    }

    private void ResolveCloneSector() =>
        _cloneSector = OwnSectors().FirstOrDefault(s => string.Equals(s.Callsign, _cloneSectorText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
    private void PickCloneSector(GlobalSectorRow s) { _cloneSector = s.Id; _cloneSectorText = s.Callsign; _cloneOpen = false; }

    // Clona l'intero gruppo (intestazione + tutte le righe) sul settore mittente scelto. Nome aeroporto: null se
    // in catalogo (viene da lì), altrimenti riporta il nome libero salvato sul flusso sorgente.
    private async Task ConfirmCloneFlow(TransferFlowRow f)
    {
        var icao = f.AirportIcao;
        var clonedId = 0;
        await Guarded(async () =>
        {
            clonedId = await Transfers.AddFlowAsync(_acc!.Code, new TransferFlowInput
            {
                OwningSectorId = _cloneSector, Kind = f.Kind,
                AirportIcao = string.IsNullOrWhiteSpace(icao) ? null : icao,
                AirportName = !string.IsNullOrWhiteSpace(icao) && !IsKnownApt(icao) ? f.AirportName : null,
                Description = f.Description,
            });
            foreach (var p in f.Points)
            {
                await Transfers.AddPointAsync(_acc!.Code, clonedId, new TransferPointInput
                {
                    Cop = p.Cop, LevelValue = p.LevelValue, LevelUnit = p.LevelUnit, LevelConstraint = p.LevelConstraint,
                    LevelSpecial = p.LevelSpecial, Parity = p.Parity, VerticalState = p.VerticalState, NextSectorId = p.NextSectorId,
                    ConditionLabel = p.ConditionLabel, ConditionRefId = p.ConditionRefId,
                    ConditionAreaLabel = p.ConditionAreaLabel, ConditionCustomLabel = p.ConditionCustomLabel,
                    // La faccetta segue la riga clonata; il GRUPPO di varianti no: appartiene al flusso di
                    // origine, e ricrearlo qui vorrebbe dire inventare legami fra righe che nessuno ha chiesto.
                    HandoffKind = p.HandoffKind, HandoffLabel = p.HandoffLabel,
                    HandoffLevelValue = p.HandoffLevelValue, HandoffLevelUnit = p.HandoffLevelUnit,
                    HandoffLevelConstraint = p.HandoffLevelConstraint,
                    CommsHandoffKind = p.CommsHandoffKind, CommsHandoffLabel = p.CommsHandoffLabel,
                    SpeedValue = p.SpeedValue, SpeedConstraint = p.SpeedConstraint,
                });
            }
            _cloneFlowId = null;
        }, string.Format(L["Xfer_GroupCloned"].Value, f.Points.Count));
        if (clonedId > 0) ExpandTo(clonedId);   // mostra il gruppo clonato
    }

    private async Task EditPoint(TransferFlowRow f, TransferPointRow p)
    {
        _editFlowId = null; _addPointFlowId = null; _cloneFlowId = null;
        _editPointId = p.Id;
        _epCop = p.Cop; _epConstraint = p.LevelConstraint; _epValue = p.LevelValue; _epUnit = p.LevelUnit;
        _epSpecial = p.LevelSpecial ?? ""; _epParity = p.Parity; _epVState = p.VerticalState; _epNext = p.NextSectorId ?? 0; _epNextText = p.NextSectorCallsign ?? "";
        _epCondRwys = ParseRwys(p.ConditionLabel); _epCondAreaLabel = p.ConditionAreaLabel ?? ""; _epAreaText = p.ConditionAreaLabel ?? ""; _epAreaOpen = false;
        _epCondCustomLabel = p.ConditionCustomLabel ?? "";
        _epFacet.LoadFrom(p);
        await LoadCondRulesAsync(f.AirportIcao);
    }

    /// <summary>Aggiunge una variante della riga: stesso accordo, condizione diversa. La nuova riga nasce
    /// copiata (tranne la condizione) e si apre subito in modifica, col cursore su ciò che deve cambiare.</summary>
    private async Task AddVariant(int pointId)
    {
        var newId = 0;
        await Guarded(async () => newId = await Transfers.AddVariantAsync(_acc!.Code, pointId), L["Xfer_VariantAdded"]);
        if (newId == 0) return;
        // Guarded ha già ricaricato i flussi: la riga nuova c'è, e si apre dove l'utente sta guardando.
        var f = _flows.FirstOrDefault(x => x.Points.Any(p => p.Id == newId));
        var p = f?.Points.FirstOrDefault(x => x.Id == newId);
        if (f is not null && p is not null) await EditPoint(f, p);
    }

    private Task DetachVariant(int pointId) =>
        Guarded(() => Transfers.DetachVariantAsync(_acc!.Code, pointId), L["Xfer_VariantDetached"]);

    /// <summary>Numeri dei gruppi di varianti del flusso che non hanno una riga «negli altri casi».</summary>
    private static IReadOnlyList<int> GroupsWithoutOtherwise(TransferFlowRow f) =>
        f.Points.Where(p => p.VariantGroup is not null)
            .GroupBy(p => p.VariantGroup!.Value)
            .Where(g => !g.Any(p => p.IsOtherwise))
            .Select(g => g.Key)
            .OrderBy(x => x)
            .ToList();

    /// <summary>Riassunto della faccetta per la riga in sola lettura: «al confine dell'AoR · passando FL110 ·
    /// com. su AVN · ≤250 kt». Vuoto se la riga non usa la faccetta. Usa il template italiano dell'anteprima,
    /// che è la stessa lingua della pagina.</summary>
    private string FacetSummary(TransferPointRow p)
    {
        var tpl = _preview?.Template ?? CoordinationSentenceTemplate.Default;
        var pezzi = new List<string>(4);
        var dove = TransferHandoffText.Place(tpl, p.HandoffKind, p.HandoffLabel);
        if (dove.Length > 0) pezzi.Add(dove);
        var liv = TransferHandoffText.Level(tpl, p.HandoffLevelValue, p.HandoffLevelUnit, p.HandoffLevelConstraint);
        if (liv.Length > 0) pezzi.Add(liv);
        var comms = TransferHandoffText.CommsPlace(tpl, TransferHandoffFacet.From(p));
        if (comms.Length > 0) pezzi.Add($"{L["Xfer_CommsShort"]} {comms}");
        var vel = LevelFormatting.FormatSpeed(p.SpeedValue, p.SpeedConstraint);
        if (vel.Length > 0) pezzi.Add(vel);
        return string.Join(" · ", pezzi);
    }

    // Warning UNICOM azionabile: espandi il gruppo e apri subito l'edit del primo punto per assegnargli un ricevente.
    private async Task FixUnicom(TransferFlowRow f)
    {
        _collapsedFlow.Remove(f.Id);
        if (f.Points.Count > 0) await EditPoint(f, f.Points[0]);
    }

    private async Task SavePoint(int pointId)
    {
        await Guarded(async () =>
        {
            await Transfers.UpdatePointAsync(_acc!.Code, pointId, _epFacet.Apply(new TransferPointInput
            {
                Cop = _epCop, LevelValue = _epValue, LevelUnit = _epUnit, LevelConstraint = _epConstraint,
                LevelSpecial = _epSpecial, Parity = _epParity, VerticalState = _epVState, NextSectorId = _epNext == 0 ? null : _epNext,
                ConditionLabel = _epCondRwys.Length == 0 ? null : RunwaysLabel(_epCondRwys),
                ConditionRefId = ResolveRwyRef(_epCondRwys),
                ConditionAreaLabel = string.IsNullOrWhiteSpace(_epCondAreaLabel) ? null : _epCondAreaLabel,
                ConditionCustomLabel = string.IsNullOrWhiteSpace(_epCondCustomLabel) ? null : _epCondCustomLabel,
            }));
            _editPointId = null;
        }, L["Xfer_RowUpdated"]);
    }

    // keepOpen = «Salva e aggiungi»: lascia il form aperto e conserva livello/ricevente/condizioni, azzera solo il CoP
    // (inserimento in serie di righe simili). false = comportamento classico: chiude il form.
    private async Task AddPoint(int flowId, bool keepOpen = false)
    {
        var cops = SplitCops(_pCop);
        await Guarded(async () =>
        {
            foreach (var cop in cops)
            {
                await Transfers.AddPointAsync(_acc!.Code, flowId, _pFacet.Apply(new TransferPointInput
                {
                    Cop = cop, LevelValue = _pValue, LevelUnit = _pUnit, LevelConstraint = _pConstraint,
                    LevelSpecial = _pSpecial, Parity = _pParity, VerticalState = _pVState, NextSectorId = _pNext == 0 ? null : _pNext,
                    ConditionLabel = _pCondRwys.Length == 0 ? null : RunwaysLabel(_pCondRwys),
                    ConditionRefId = ResolveRwyRef(_pCondRwys),
                    ConditionAreaLabel = string.IsNullOrWhiteSpace(_pCondAreaLabel) ? null : _pCondAreaLabel,
                    ConditionCustomLabel = string.IsNullOrWhiteSpace(_pCondCustomLabel) ? null : _pCondCustomLabel,
                }));
            }
            if (keepOpen) { _pCop = ""; }   // pronto per la riga successiva (stesso livello/ricevente/condizioni)
            else { _addPointFlowId = null; }
        }, cops.Count > 1 ? string.Format(L["Xfer_RowsAdded"].Value, cops.Count) : L["Xfer_RowAdded"].Value);
    }

    // CoP singolo o lista separata da virgola/punto-e-virgola; deduplica (case-insensitive), preserva ordine.
    // Nessun CoP -> una riga senza punto (Cop vuoto, reso "—" nella tabella).
    private static List<string> SplitCops(string raw)
    {
        var parts = (raw ?? string.Empty)
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return parts.Count == 0 ? new List<string> { string.Empty } : parts;
    }

    private Task DeletePoint(int id) => Guarded(() => Transfers.DeletePointAsync(_acc!.Code, id), L["Xfer_RowDeleted"]);

    private async Task Guarded(Func<Task> action, string? ok)
    {
        _busy = true; _status = _error = null;
        try { await action(); await LoadAsync(); if (ok is not null) _status = ok; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
