    /// <summary>
    /// Le alternative del flusso che non hanno una riga «senza condizioni proprie», cioè che non dicono cosa
    /// vale nel loro caso normale. Il lettore che non ricade in nessuna eccezione non trova un'istruzione.
    /// <para>Non è un errore — l'insieme delle eccezioni può essere esaustivo — ma è il buco che il dato reale
    /// aveva già: la riga «pista 25 + area R403B attiva» esiste, la riga «pista 25, normalmente» no.</para>
    /// </summary>
    private static IReadOnlyList<string> AlternativesWithoutNormalCase(TransferFlowRow f)
    {
        var mancanti = new List<string>();
        var points = f.Points;
        for (var i = 0; i < points.Count; i++)
        {
            var a = points[i];
            if (a.VariantGroup is null || a.VariantDepth != 0 || a.IsGroupWide) continue;
            if (string.IsNullOrWhiteSpace(a.ConditionDisplay)) continue;   // già il caso normale del gruppo

            // Ha almeno un'eccezione, e nessuna di esse è la sua «senza condizioni»?
            var hasChild = i + 1 < points.Count
                           && points[i + 1].VariantGroup == a.VariantGroup && points[i + 1].VariantDepth > 0;
            if (hasChild) mancanti.Add(a.ConditionDisplay!);
        }
        return mancanti;
    }

    /// <summary>Riassunto della faccetta per la riga in sola lettura: «al confine dell'AoR · passando FL110 ·
    /// com. su AVN · ≤250 kt». Vuoto se la riga non usa la faccetta. Usa il template italiano dell'anteprima,
    /// che è la stessa lingua della pagina.</summary>
    private string FacetSummary(TransferPointRow p)
    {
        var tpl = _preview?.Template ?? CoordinationSentenceTemplate.Default;
        var pezzi = new List<string>(4);
        var dove = TransferHandoffText.Place(tpl, p.HandoffKind, p.HandoffLabel);
        if (dove.Length > 0) pezzi.Add(dove);
        var liv = TransferHandoffText.Level(tpl, p.HandoffLevelValue, p.HandoffLevelUnit, p.HandoffLevelConstraint);
        if (liv.Length > 0) pezzi.Add(liv);
        var comms = TransferHandoffText.CommsPlace(tpl, TransferHandoffFacet.From(p));
        if (comms.Length > 0) pezzi.Add($"{L["Xfer_CommsShort"]} {comms}");
        var vel = LevelFormatting.FormatSpeed(p.SpeedValue, p.SpeedConstraint);
        if (vel.Length > 0) pezzi.Add(vel);
        return string.Join(" · ", pezzi);
    }

