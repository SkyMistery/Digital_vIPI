        @* --- Condizione operativa --- *@
        @PanelSection("condition", L["Xfer_GrpCondition"], ConditionSummary(form))
        @if (SectionOpen("condition"))
        {
        <div class="field">
            <label>@L["Xfer_CondRunway"] @if (_condRunways.Count == 0) { <span class="muted xt-hint">@L["Xfer_NoRunways"]</span> }</label>
            <select multiple size="4" @onchange="e => PickRunways(form, e)">
