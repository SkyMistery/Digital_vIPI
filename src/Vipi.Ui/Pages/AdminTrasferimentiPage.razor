    /// <summary>
    /// Chiede di portare il pannello in vista al PROSSIMO render. Non subito: dentro il gestore dell'evento il
    /// pannello a schermo è ancora quello di prima — spesso vuoto, senza piede — e la misura cadrebbe sul
    /// riquadro sbagliato. Il render arriva quando il gestore finisce, e <see cref="OnAfterRenderAsync"/> è il
    /// primo momento in cui il piede esiste davvero.
    /// </summary>
    private bool _revealPanel;

    // Firme dell'ultimo stato già scritto fuori (URL / preferenze): il confronto dice se c'è qualcosa da
    // scrivere. Un solo punto che sincronizza, invece di una chiamata sparsa in ognuno dei dodici gestori che
    // possono cambiare lo stato — e di dodici occasioni di dimenticarne una.
    private string _urlAs = "", _prefsAs = "";

    private string UrlSignature() =>
        $"{_accCode}|{_view}|{_selectedFlowId}|{_editPointId}|{_flowFilter}|{_kindFilter}|{_toReviewOnly}|{_noReceiverOnly}";

    private string PrefSignature() => $"{_showPreviews}|{_sort}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Le preferenze si leggono QUI e non in OnInitializedAsync: durante il prerender non c'è
            // JavaScript, e l'interop lì fallisce. È la trappola che le fa perdere «a volte».
            await RestorePreferences();
            _prefsAs = PrefSignature();
            _urlAs = UrlSignature();
            StateHasChanged();
        }
        else if (PrefSignature() != _prefsAs)
        {
            _prefsAs = PrefSignature();
            await SavePreferences();
        }

        if (UrlSignature() != _urlAs)
        {
            _urlAs = UrlSignature();
            SyncUrl();
        }

        // Il fuoco si mette QUI: dentro il gestore del clic il campo non esiste ancora — la cella a schermo è
        // ancora il testo. Vale anche dopo un Tab, dove il browser ha già spostato il fuoco per conto suo e
        // questo lo riporta sul campo appena aperto.
        if (_focusCell)
        {
            _focusCell = false;
            try { await _cellInput.FocusAsync(); }
            catch (JSDisconnectedException) { /* circuito chiuso: non c'è nessun campo da mettere a fuoco */ }
            catch (InvalidOperationException) { /* la cella si è già richiusa fra il render e qui */ }
        }

        if (!_revealPanel) return;
        _revealPanel = false;
        // Il JS è l'unico a sapere dov'è il pannello rispetto allo schermo: se il piede è già visibile non
        // muove niente. Sotto le soglie di collasso il pannello sta dopo le altre colonne, e senza questo si
        // scriveva in un form fuori campo.
        try { await JS.InvokeVoidAsync("vipiRevealPanel", "xt-panel"); }
        catch (JSDisconnectedException) { /* circuito chiuso mentre si apriva: non c'è nulla da mostrare */ }
    }

