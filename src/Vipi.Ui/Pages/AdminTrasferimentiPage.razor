    /// <summary>Il form → l'input di salvataggio. Un posto solo: prima la stessa mappatura stava in due metodi,
    /// e un campo aggiunto a uno solo dei due sarebbe sparito a seconda di come si apriva la riga.</summary>
    private TransferPointInput ToInput(PointForm form, string cop) => form.Facet.Apply(new TransferPointInput
    {
        Cop = cop, LevelValue = form.Value, LevelUnit = form.Unit, LevelConstraint = form.Constraint,
        LevelSpecial = form.Special, Parity = form.Parity, VerticalState = form.VState,
        NextSectorId = form.Next == 0 ? null : form.Next,
        ConditionLabel = form.Rwys.Length == 0 ? null : RunwaysLabel(form.Rwys),
        ConditionRefId = ResolveRwyRef(form.Rwys),
        ConditionAreaLabel = string.IsNullOrWhiteSpace(form.AreaLabel) ? null : form.AreaLabel,
        ConditionCustomLabel = string.IsNullOrWhiteSpace(form.CustomLabel) ? null : form.CustomLabel,
    });

    // keepOpen = «Salva e aggiungi»: lascia il form aperto e conserva livello/ricevente/condizioni, azzera solo il CoP
    // (inserimento in serie di righe simili). false = comportamento classico: chiude il form.
    // keepOpen = «Salva e aggiungi»: lascia il pannello aperto e conserva livello/ricevente/condizioni, azzera
    // solo il CoP (inserimento in serie di righe simili).
    private async Task AddPoint(int flowId, bool keepOpen = false)
    {
        var cops = SplitCops(_addForm.Cop);
        await Guarded(async () =>
        {
            foreach (var cop in cops) await Transfers.AddPointAsync(_acc!.Code, flowId, ToInput(_addForm, cop));
            if (keepOpen) _addForm.Cop = "";     // pronto per la riga successiva
            else _addPointFlowId = null;
        }, cops.Count > 1 ? string.Format(L["Xfer_RowsAdded"].Value, cops.Count) : L["Xfer_RowAdded"].Value);
    }

    // CoP singolo o lista separata da virgola/punto-e-virgola; deduplica (case-insensitive), preserva ordine.
    // Nessun CoP -> una riga senza punto (Cop vuoto, reso "—" nella tabella).
    private static List<string> SplitCops(string raw)
    {
        var parts = (raw ?? string.Empty)
            .Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return parts.Count == 0 ? new List<string> { string.Empty } : parts;
    }

    private Task DeletePoint(int id) => Guarded(() => Transfers.DeletePointAsync(_acc!.Code, id), L["Xfer_RowDeleted"]);

    private async Task Guarded(Func<Task> action, string? ok)
    {
        _busy = true; _status = _error = null;
        try { await action(); await LoadAsync(); if (ok is not null) _status = ok; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
