    // ---- Sezioni collassabili del pannello ----------------------------------------------------------
    // Richiuse solo se VUOTE, e col riassunto accanto al titolo: nascondere un dato senza dirlo è peggio di una
    // scheda lunga.
    private readonly HashSet<string> _closedSections = new(StringComparer.Ordinal);

    private bool SectionOpen(string key) => !_closedSections.Contains(key);

    private RenderFragment PanelSection(string key, string title, string summary) => __builder =>
    {
        var open = SectionOpen(key);
        <div class="xt-grp xt-clickable" role="button" tabindex="0" aria-expanded="@open"
             @onclick="() => ToggleSection(key)"
             @onkeydown="e => SectionKey(e, key)">
            <span>@title</span>
            @if (!open && summary.Length > 0) { <span class="muted xt-hint">@summary</span> }
            <span class="xt-chev">@(open ? "▾" : "▸")</span>
        </div>
    };

    /// <summary>Invio/Spazio sull'intestazione di sezione: senza, si apre solo col mouse.</summary>
    private void SectionKey(KeyboardEventArgs e, string key)
    {
        if (e.Key is "Enter" or " " or "Spacebar") ToggleSection(key);
    }

    private void ToggleSection(string key)
    {
        if (!_closedSections.Remove(key)) _closedSections.Add(key);
    }

    private void ResetPanelSections(ClauseForm form)
    {
        _closedSections.Clear();
        if (FacetSummaryOf(form).Length == 0) _closedSections.Add("handoff");
        if (ConditionSummary(form).Length == 0) _closedSections.Add("condition");
    }

    private string LevelSummary(ClauseForm f) =>
        LevelFormatting.Format(f.Constraint == LevelConstraint.Special ? null : f.Value, f.Unit, f.Constraint,
                               f.Special, f.Parity, f.VState);

    private string FacetSummaryOf(ClauseForm f)
    {
        var parts = new List<string>(3);
        if (f.Facet.Kind != TransferHandoffKind.Unspecified)
            parts.Add(LevelFormatting.FormatHandoffLevel(f.Facet.LevelValue, f.Facet.LevelUnit, f.Facet.LevelConstraint) is { Length: > 0 } lv
                ? lv : L["Xfer_HandoffSet"].Value);
        var speed = LevelFormatting.FormatSpeed(f.Facet.SpeedValue, f.Facet.SpeedConstraint);
        if (speed.Length > 0) parts.Add(speed);
        return string.Join(" · ", parts);
    }

    private static string ConditionSummary(ClauseForm f) =>
        TransferConditionText.Display(
            f.Rwys.Length == 0 ? null : string.Join(" / ", f.Rwys),
            string.IsNullOrWhiteSpace(f.AreaLabel) ? null : f.AreaLabel,
            string.IsNullOrWhiteSpace(f.CustomLabel) ? null : f.CustomLabel) ?? "";

    private string FacetSummary(AgreementClauseRow c)
    {
        var parts = new List<string>(3);
        var place = TransferHandoffText.Place(_preview?.Template ?? CoordinationSentenceTemplate.Default,
                                              c.HandoffKind, c.HandoffLabel);
        if (place.Length > 0) parts.Add(place);
        if (c.HandoffLevelText.Length > 0) parts.Add(c.HandoffLevelText);
        if (c.SpeedText.Length > 0) parts.Add(c.SpeedText);
        return string.Join(" · ", parts);
    }

    // ---- Anteprima ----------------------------------------------------------------------------------

    private string? PreviewOf(AgreementRow a, AgreementClauseRow c) =>
        _preview is null ? null : AgreementPreview.Compose(_preview, a, c);

    /// <summary>L'anteprima di ciò che si sta scrivendo <b>adesso</b>: la clausola del form, non quella salvata.
    /// Si costruisce una clausola finta e la si passa allo stesso composer del documento — un'anteprima che si
    /// compone da sé è l'anteprima che prima o poi mente.</summary>
    private string? PreviewForm(AgreementRow a, ClauseForm form)
    {
        if (_preview is null) return null;
        var draft = ToClauseInput(form);
        var fake = new AgreementClauseRow
        {
            Id = _editClauseId ?? 0,
            Direction = _direction,
            Cops = draft.Cops,
            LevelValue = draft.LevelValue, LevelUnit = draft.LevelUnit, LevelConstraint = draft.LevelConstraint,
            LevelSpecial = draft.LevelSpecial, Parity = draft.Parity, VerticalState = draft.VerticalState,
            ConditionLabel = draft.ConditionLabel, ConditionAreaLabel = draft.ConditionAreaLabel,
            ConditionCustomLabel = draft.ConditionCustomLabel,
            HandoffKind = draft.HandoffKind, HandoffLabel = draft.HandoffLabel,
            HandoffLevelValue = draft.HandoffLevelValue, HandoffLevelUnit = draft.HandoffLevelUnit,
            HandoffLevelConstraint = draft.HandoffLevelConstraint,
            CommsHandoffKind = draft.CommsHandoffKind, CommsHandoffLabel = draft.CommsHandoffLabel,
            SpeedValue = draft.SpeedValue, SpeedConstraint = draft.SpeedConstraint,
            IsGroupWide = draft.IsGroupWide,
            // La catena delle condizioni si legge sull'outline SALVATO: la clausola in scrittura sta dove sta,
            // e la sua profondità non cambia mentre si digita.
            VariantGroup = CurrentClause()?.VariantGroup,
            VariantDepth = CurrentClause()?.VariantDepth ?? 0,
            Order = CurrentClause()?.Order ?? int.MaxValue,
        };

        // La clausola finta prende il posto di quella salvata dentro l'accordo, così la risalita dell'outline
        // trova gli stessi antenati che troverà il documento.
        var clauses = a.Clauses.Where(x => x.Id != fake.Id).Append(fake).OrderBy(x => x.Order).ToList();
        return AgreementPreview.Compose(_preview, a with { Clauses = clauses }, fake);
    }

    // ---- Scrittura in cella -------------------------------------------------------------------------

    private XferCellRef? _cellEdit;
    private string _cellText = "";
    private int _cellEpoch;
    private ElementReference _cellInput;
    private bool _focusCell;

    private string CellPlaceholder(XferCell cell) => cell switch
    {
        XferCell.Points => "VALMA, ELB",
        _ => "FL130-",
    };

    private void OpenCell(XferCellRef cell)
    {
        var c = FindClause(cell.ClauseId);
        if (c is null) return;
        _cellEdit = cell;
        _cellText = XferRowsTable.Display(c, cell.Cell);
        _cellEpoch++;
        _focusCell = true;
    }

    private void CancelCell(int epoch)
    {
        if (epoch != _cellEpoch) return;
        _cellEdit = null;
        _cellEpoch++;
    }

    private async Task CellKey(KeyboardEventArgs e, int epoch)
    {
        if (e.Key == "Escape") { CancelCell(epoch); return; }
        if (e.Key is not ("Enter" or "Tab")) return;
        await CommitCell(epoch);
    }

    private async Task CommitCell(int epoch)
    {
        if (epoch != _cellEpoch || _cellEdit is not { } cell) return;
        _cellEpoch++;
        var c = FindClause(cell.ClauseId);
        _cellEdit = null;
        if (c is null) return;

        var input = CellInput(c, cell.Cell, _cellText);
        if (input is null) return;
        await Guarded(() => Agreements.UpdateClauseAsync(_acc!.Code, c.Id, input), null);
    }

    /// <summary>
    /// L'input di salvataggio di una cella. <b>Una casella scrive solo ciò che mostra</b>: tutto il resto della
    /// clausola si porta avanti tale e quale, o scrivere il livello cancellerebbe in silenzio lo stato verticale
    /// — che nel testo del livello non lascia segno.
    /// </summary>
    private AgreementClauseInput? CellInput(AgreementClauseRow c, XferCell cell, string text)
    {
        var input = EditableCopy(c);
        switch (cell)
        {
            case XferCell.Points:
                return input with { Cops = text.Trim() };
            case XferCell.Level:
                var level = LevelFormatting.Parse(text);
                return input with
                {
                    LevelConstraint = level.Constraint,
                    LevelValue = level.Constraint == LevelConstraint.Special ? null : level.Value,
                    LevelSpecial = level.Constraint == LevelConstraint.Special ? level.Special : null,
                    LevelUnit = level.Unit,
                    Parity = level.Parity,
                    // Lo stato verticale NON si tocca: LevelFormatting.Parse lo restituisce, ma la cella non lo
                    // mostra e quindi non lo può scrivere.
                    VerticalState = c.VerticalState,
                };
            default:
                return null;
        }
    }

    private AgreementClauseRow? FindClause(int clauseId) =>
        _agreements.SelectMany(a => a.Clauses).FirstOrDefault(c => c.Id == clauseId);

    private AgreementRow? AgreementOf(int clauseId) =>
        _agreements.FirstOrDefault(a => a.Clauses.Any(c => c.Id == clauseId));

    /// <summary>Una clausola esistente → input di modifica. Copia tutto: chi ne cambia un campo usa <c>with</c>.</summary>
    private static AgreementClauseInput EditableCopy(AgreementClauseRow c) => new()
    {
        Cops = c.Cops, LevelValue = c.LevelValue, LevelUnit = c.LevelUnit, LevelConstraint = c.LevelConstraint,
        LevelSpecial = c.LevelSpecial, Parity = c.Parity, VerticalState = c.VerticalState,
        ConditionLabel = c.ConditionLabel, ConditionRefId = c.ConditionRefId,
        ConditionAreaLabel = c.ConditionAreaLabel, ConditionCustomLabel = c.ConditionCustomLabel,
        HandoffKind = c.HandoffKind, HandoffLabel = c.HandoffLabel,
        HandoffLevelValue = c.HandoffLevelValue, HandoffLevelUnit = c.HandoffLevelUnit,
        HandoffLevelConstraint = c.HandoffLevelConstraint,
        CommsHandoffKind = c.CommsHandoffKind, CommsHandoffLabel = c.CommsHandoffLabel,
        SpeedValue = c.SpeedValue, SpeedConstraint = c.SpeedConstraint, IsGroupWide = c.IsGroupWide,
    };

    // ---- Picker e ausili ----------------------------------------------------------------------------

    /// <summary>Gli enti candidati a una PARTE. Un accordo esce dalla ACC per definizione — verso un altro ACC
    /// italiano o verso un confinante estero — quindi l'elenco non puo' fermarsi ai settori di casa; quelli di
    /// casa vengono comunque per primi.</summary>
    private IEnumerable<GlobalSectorRow> PartyCandidates()
    {
        var home = _acc?.Code ?? "";
        return _all
            .OrderByDescending(s => string.Equals(s.AccCode, home, StringComparison.OrdinalIgnoreCase))
            .ThenBy(s => s.AccCode).ThenBy(s => s.Callsign);
    }

    private IReadOnlyList<TypeaheadPicker.Item> SectorItems(string text) =>
        PartyCandidates().Where(s => Match(s, text)).Take(50)
            .Select(s => new TypeaheadPicker.Item(s.Callsign, s.AccCode))
            .ToList();

    private IReadOnlyList<TypeaheadPicker.Item> AirportItems(string text) =>
        _airports.Where(a => MatchApt(a, text)).Take(50)
            .Select(a => new TypeaheadPicker.Item(a.Icao, a.Name + " - " + a.AccCode, Strong: true))
            .ToList();

    private IReadOnlyList<TypeaheadPicker.Item> AreaItems(string text) =>
        (string.IsNullOrWhiteSpace(text) ? _areas : _areas.Where(a => a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)))
            .Take(50).Select(a => new TypeaheadPicker.Item(a.Name, a.Type)).ToList();

    private static bool Match(GlobalSectorRow s, string text) =>
        string.IsNullOrWhiteSpace(text) || s.Callsign.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool MatchApt(AirportAdminRow a, string text) =>
        string.IsNullOrWhiteSpace(text)
        || a.Icao.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)
        || a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool IsKnownApt(string icao) =>
        !string.IsNullOrWhiteSpace(icao)
        && _airports.Any(a => string.Equals(a.Icao, icao.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? NewAptFooter(string icao) =>
        !string.IsNullOrWhiteSpace(icao) && !IsKnownApt(icao)
            ? "\u21b5 " + string.Format(L["Xfer_UseNewApt"].Value, icao.Trim().ToUpperInvariant())
            : null;

    private void AddParty(HeaderForm form, AgreementSide side, string? callsign)
    {
        var cs = (callsign ?? "").Trim();
        if (cs.Length == 0) return;
        var list = side == AgreementSide.A ? form.SideA : form.SideB;
        if (!list.Contains(cs, StringComparer.OrdinalIgnoreCase)) list.Add(cs);
        if (side == AgreementSide.A) form.SideAText = ""; else form.SideBText = "";
    }

    private void AddAirport(HeaderForm form)
    {
        var icao = form.AirportText.Trim().ToUpperInvariant();
        if (icao.Length == 0) return;
        if (!form.Airports.Any(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase)))
            form.Airports.Add(new AgreementAirportInput(icao, IsKnownApt(icao) ? null : NullIfBlank(form.AirportName)));
        form.AirportText = ""; form.AirportName = "";
    }

    /// <summary>Il nome dell'aeroporto fuori catalogo, chiesto a IVAO. Riempie solo il campo libero: lo scalo
    /// NON entra nel catalogo, che è il vincolo — niente documenti su scali non italiani nei picker.</summary>
    private async Task LookupApt(HeaderForm form)
    {
        var icao = form.AirportText.Trim().ToUpperInvariant();
        if (icao.Length < 4) return;
        await Guarded(async () =>
        {
            var info = await Struct.LookupExternalAirportAsync(icao);
            form.AirportName = info?.Name ?? "";
            if (info is null) _error = string.Format(L["Xfer_NotFoundIvao"].Value, icao);
        }, null);
    }

    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static string Dash(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string KindLabel(TransferFlowKind k) => XferLabels.Kind(L, k);

    private string SenderOf(AgreementRow a) => Dash(SenderLabelForDirection(a, _direction));
    private string ReceiverOf(AgreementRow a)
    {
        var side = _direction == AgreementDirection.AtoB ? AgreementSide.B : AgreementSide.A;
        var s = XferLabels.Side(a, side);
        return s.Length > 0 ? s : L["Xfer_Unicom"];
    }

    private static string SenderLabelForDirection(AgreementRow a, AgreementDirection d) =>
        XferLabels.Side(a, d == AgreementDirection.AtoB ? AgreementSide.A : AgreementSide.B);

    /// <summary>L'etichetta di un verso: «da → a», coi callsign veri. «A→B» non direbbe niente a nessuno.</summary>
    private string DirectionLabel(AgreementRow a, AgreementDirection d)
    {
        var from = Dash(SenderLabelForDirection(a, d));
        var to = XferLabels.Side(a, d == AgreementDirection.AtoB ? AgreementSide.B : AgreementSide.A);
        var n = a.Clauses.Count(c => c.Direction == d);
        return $"{from} → {(to.Length > 0 ? to : L["Xfer_Unicom"].Value)} ({n})";
    }

    private string AgreementsCountLabel(int n) => string.Format(L["Xfer_AgreementsN"].Value, n);

    private static bool AirportRequiredMissing(HeaderForm f) =>
        f.Kind is TransferFlowKind.Arrival or TransferFlowKind.Departure && f.Airports.Count == 0;

    private void PickRunways(ClauseForm form, ChangeEventArgs e) =>
        form.Rwys = e.Value is string[] v ? v : Array.Empty<string>();

    private void ResolveArea(ClauseForm form) =>
        form.AreaLabel = _areas.FirstOrDefault(a => string.Equals(a.Name, form.AreaText.Trim(), StringComparison.OrdinalIgnoreCase))?.Name ?? form.AreaText.Trim();

    private void PickArea(ClauseForm form, string? name) { form.AreaLabel = name ?? ""; form.AreaText = name ?? ""; }

    private static string[] ParseRwys(string? label) =>
        string.IsNullOrWhiteSpace(label)
            ? Array.Empty<string>()
            : label.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// Le piste selezionabili per la condizione: l'unione di quelle degli aeroporti dell'accordo.
    /// <para>⚠️ Con più di uno scalo la sigla porta il proprio ICAO: «16R» su Fiumicino e su Malpensa sono due
    /// piste diverse, e un elenco che le confondesse produrrebbe condizioni che valgono per l'aeroporto
    /// sbagliato.</para>
    /// </summary>
    private async Task LoadRunwaysAsync(AgreementRow? a)
    {
        if (a is null || a.Airports.Count == 0) { _condRunways = Array.Empty<RunwayOption>(); return; }

        var many = a.Airports.Count > 1;
        var list = new List<RunwayOption>();
        foreach (var apt in a.Airports.OrderBy(x => x.Order))
        {
            if (!IsKnownApt(apt.Icao)) continue;
            try
            {
                var d = await Airports.LoadForViewAsync(apt.Icao);
                if (d is null) continue;
                foreach (var r in d.Runways)
                    list.Add(new RunwayOption(many ? apt.Icao + " " + r.Ident : r.Ident, r.Ident, r.Id));
            }
            catch (Exception)
            {
                // Un aeroporto senza piste importate non e' un errore della pagina: l'elenco resta piu' corto.
            }
        }
        _condRunways = list;
    }

    // ---- Stato in URL e preferenze ------------------------------------------------------------------

    // In URL sta cio' che identifica COSA STO GUARDANDO — ACC, vista, accordo, verso, filtri — cioe' quello
    // che ha senso mandare a un collega e ritrovare dopo un F5. In localStorage sta cio' che e' COME MI PIACE
    // GUARDARE — anteprime, ordinamento — che e' preferenza della persona, non del contenuto.
    private string UrlSignature() => $"{_accCode}|{_selectedId}|{_view}|{_direction}|{_filter}|{_kindFilter}|{_toReviewOnly}|{_noReceiverOnly}";
    private string PrefSignature() => $"{_showPreviews}|{_sort}|{_sortDesc}";
    private string _lastUrl = "", _lastPref = "";

    private void SyncUrl()
    {
        if (_acc is null || UrlSignature() == _lastUrl) return;
        _lastUrl = UrlSignature();

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["acc"] = _acc.Code,
            ["vista"] = _view == XferView.Tree ? null : _view.ToString(),
            ["accordo"] = _selectedId,
            ["verso"] = _direction == AgreementDirection.AtoB ? null : _direction.ToString(),
            ["q"] = string.IsNullOrWhiteSpace(_filter) ? null : _filter,
            ["tipo"] = _kindFilter?.ToString(),
            ["rev"] = _toReviewOnly ? "1" : null,
            ["norx"] = _noReceiverOnly ? "1" : null,
        }), forceLoad: false, replace: true);
    }

    /// <summary>Ricostruisce lo stato dall'URL. Se il link porta un ACC, la pagina si apre gia' li'.</summary>
    private async Task RestoreFromUrl()
    {
        var q = QueryStringUtil.Parse(new Uri(Nav.Uri).Query);

        _filter = q.Value("q") ?? "";
        _kindFilter = q.Enum<TransferFlowKind>("tipo");
        _toReviewOnly = q.Flag("rev");
        _noReceiverOnly = q.Flag("norx");
        if (q.Enum<XferView>("vista") is { } v) _view = v;
        if (q.Enum<AgreementDirection>("verso") is { } d) _direction = d;

        var acc = q.Value("acc");
        if (string.IsNullOrWhiteSpace(acc)) return;

        _accCode = acc!;
        await OnAccChanged();   // azzera la scelta: quella dal link va rimessa DOPO

        // L'accordo si sceglie solo se esiste ancora: un link vecchio a uno eliminato deve aprire la pagina,
        // non lasciarla su un riquadro che parla di qualcosa che non c'e'.
        if (int.TryParse(q.Value("accordo"), out var id) && _agreements.Any(a => a.Id == id))
            SelectAgreement(id);
    }

    /// <summary>⚠️ <c>localStorage</c> si legge al PRIMO RENDER, mai in <c>OnInitializedAsync</c>: durante il
    /// prerender non c'è JS, e la lettura fallirebbe in silenzio lasciando le preferenze ai valori di
    /// riposo.</summary>
    private async Task RestorePreferences()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", "vipi.xfer.prefs");
            if (string.IsNullOrWhiteSpace(raw)) return;
            var parts = raw!.Split('|');
            if (parts.Length > 0 && bool.TryParse(parts[0], out var prev)) _showPreviews = prev;
            if (parts.Length > 1 && Enum.TryParse<RowSort>(parts[1], out var sort)) _sort = sort;
            if (parts.Length > 2 && bool.TryParse(parts[2], out var desc)) _sortDesc = desc;
            NormalizeSortForView();
            _lastPref = PrefSignature();
        }
        catch (Exception)
        {
            // Nessun localStorage (prerender, o browser che lo nega): le preferenze restano ai valori di riposo.
        }
    }

    private async Task SavePreferences()
    {
        if (PrefSignature() == _lastPref) return;
        _lastPref = PrefSignature();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "vipi.xfer.prefs", PrefSignature()); }
        catch (Exception) { }
    }

    /// <summary>⚠️ Una preferenza salvata può non valere nel contesto in cui si riapre: una chiave di
    /// ordinamento che esiste solo in elenco, su una pagina che apre in albero, lascerebbe la tendina VUOTA.</summary>
    private void NormalizeSortForView()
    {
        if (_view == XferView.Tree && _sort is not (RowSort.Manual or RowSort.Points or RowSort.Level))
            _sort = RowSort.Manual;
    }

    // ---- Ciclo di vita ------------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        // ⚠️ Prewarm nel ciclo di vita e non dal markup: il lazy-load durante il render girava sul DbContext del
        // circuito e produceva «A second operation was started», cioè un circuito morto che a occhio sembra vivo.
        if (!Authz.IsAdmin) return;
        // Prewarm nel ciclo di vita e non dal markup: il lazy-load durante il render girava sul DbContext del
        // circuito e produceva «A second operation was started», cioe' un circuito morto che a occhio sembra vivo.
        Stations.Prewarm();
        _all = await Struct.ListSectorNodesAsync();
        _airports = await Struct.ListAllAirportsAsync();
        // Coppie confinanti: dicono quali ACC esteri sono confermati, e servono agli avvisi.
        _candidates = await Neighbours.ListAsync();
        await RestoreFromUrl();
    }

    private bool _prefsRestored;
    private bool _revealPanel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_prefsRestored)
        {
            _prefsRestored = true;
            await RestorePreferences();
            StateHasChanged();
        }

        if (_focusCell)
        {
            _focusCell = false;
            try { await _cellInput.FocusAsync(); } catch (Exception) { }
        }

        // ⚠️ Chiamare il JS dal gestore del clic è troppo presto: il DOM è ancora quello di prima (pannello
        // vuoto, senza piede) e la misura cadrebbe sul contenuto sbagliato. Si alza un flag e si chiama qui.
        if (_revealPanel)
        {
            _revealPanel = false;
            try { await JS.InvokeVoidAsync("vipiRevealPanel", "xt-panel"); } catch (Exception) { }
        }

        // ⚠️ L'altezza «schermo meno chrome» non è esprimibile in CSS: N è proprio ciò che non si sa. Si misura,
        // e si rimisura a OGNI render perché l'avviso del lock compare e sparisce da solo, spostando tutto.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".xfe-layout3"); } catch (Exception) { }

        await SavePreferences();
        SyncUrl();
    }

    private Task SelectAcc(string code)
    {
        if (string.Equals(_accCode, code, StringComparison.OrdinalIgnoreCase)) return Task.CompletedTask;
        _accCode = code;
        return OnAccChanged();
    }

    private async Task OnAccChanged()
    {
        _acc = string.IsNullOrWhiteSpace(_accCode) ? null : Stations.Resolve(_accCode);
        if (_acc is null)
        {
            _agreements = Array.Empty<AgreementRow>();
            _areas = Array.Empty<SpecialAreaPick>();
            _preview = null;
            return;
        }

        _selectedId = null; _newOpen = false; _selected.Clear(); ClosePanel();
        await Guarded(async () =>
        {
            _areas = await AccDeriv.ListSpecialAreasByAccAsync(_acc.Code);
            await LoadAsync();
        }, null);
    }

    private async Task LoadAsync(bool withPreview = true)
    {
        _agreements = await Agreements.ListByAccAsync(_acc!.Code);
        if (withPreview) _preview = await AccDeriv.GetPreviewContextAsync(_acc.Code);
        CollapseAllButSelected();
    }

    /// <summary>Alla prima apertura l'albero è chiuso tranne il ramo scelto: aperto tutto, un ACC con decine di
    /// controparti seppellisce il resto.</summary>
    private void CollapseAllButSelected()
    {
        if (_collapsed.Count > 0) return;
        var open = SelectedAgreement() is { } a ? CounterpartLabel(a) : null;
        foreach (var cp in BuildNav(_agreements))
            if (!string.Equals(cp.Key, open, StringComparison.OrdinalIgnoreCase)) _collapsed.Add(cp.Key);
    }

    private void CollapseAll()
    {
        foreach (var cp in BuildNav(_agreements)) _collapsed.Add(cp.Key);
    }

    private void ExpandAll() => _collapsed.Clear();

    private void ToggleNode(string key)
    {
        if (!_collapsed.Remove(key)) _collapsed.Add(key);
    }

    private void SelectAgreement(int id)
    {
        _selectedId = id;
        _newOpen = false;
        ClosePanel();
        // Il verso mostrato riparte da quello che l'accordo ha davvero: aprire un accordo a un verso solo sul
        // verso vuoto farebbe sembrare che non abbia clausole.
        var a = SelectedAgreement();
        if (a is not null && !a.Clauses.Any(c => c.Direction == _direction))
            _direction = a.Clauses.Any(c => c.Direction == AgreementDirection.BtoA)
                ? AgreementDirection.BtoA : AgreementDirection.AtoB;
        if (a is not null) _collapsed.Remove(CounterpartLabel(a));
    }

    private void OpenNewAgreement()
    {
        ClosePanel();
        _editHeaderId = null;
        _newForm.Reset();
        _newOpen = true;
    }

    private void CloseNew() => _newOpen = false;

    private void SetView(XferView view)
    {
        _view = view;
        NormalizeSortForView();
    }

    private void TogglePreviews() => _showPreviews = !_showPreviews;

    /// <summary>Dall'elenco all'albero, sull'accordo della riga: è il ponte fra le due viste, e serve perché per
    /// sapere se una clausola è giusta bisogna vedere le sorelle — che l'elenco non mostra come blocco.</summary>
    private async Task GoToAgreement(XferTableRow r)
    {
        SetView(XferView.Tree);
        _direction = r.Clause.Direction;
        SelectAgreement(r.Agreement.Id);
        await OnEditRow(r);
    }

    private Task OnEditRow(XferTableRow r) => EditClause(r.Agreement, r.Clause);

    // ---- Scritture ----------------------------------------------------------------------------------

    private async Task AddAgreement()
    {
        var newId = 0;
        await Guarded(async () =>
        {
            newId = await Agreements.AddAgreementAsync(_acc!.Code, ToInput(_newForm));
            _newForm.Reset();
            _newOpen = false;
        }, L["Xfer_AgreementAdded"]);
        if (newId > 0) SelectAgreement(newId);
    }

    private void OpenEditHeader(AgreementRow a)
    {
        ClosePanel();
        _editForm.LoadFrom(a);
        _editHeaderId = a.Id;
    }

    private async Task SaveHeader(AgreementRow a)
    {
        await Guarded(async () =>
        {
            await Agreements.UpdateAgreementAsync(_acc!.Code, a.Id, ToInput(_editForm));
            _editHeaderId = null;
        }, L["Xfer_AgreementUpdated"]);
        await LoadRunwaysAsync(SelectedAgreement());
    }

    private async Task DeleteAgreement(AgreementRow a)
    {
        // La fotografia si scatta PRIMA (dopo, l'accordo non c'è più) ma l'annulla si arma DOPO, e solo se
        // l'eliminazione è andata: offrire di annullare qualcosa che non è successo è peggio che non offrirlo.
        var snap = SnapshotOf(a);
        await Guarded(() => Agreements.DeleteAgreementAsync(_acc!.Code, a.Id), L["Xfer_AgreementDeleted"].Value);
        if (_error is null)
        {
            _selectedId = null;
            _undo = (() => Agreements.RestoreAgreementAsync(_acc!.Code, snap), L["Xfer_AgreementRestored"].Value);
        }
    }

    private Task CopyDirection(AgreementRow a) =>
        Guarded(async () =>
        {
            var from = _direction == AgreementDirection.AtoB ? AgreementDirection.BtoA : AgreementDirection.AtoB;
            var n = await Agreements.CopyDirectionAsync(_acc!.Code, a.Id, from);
            _status = string.Format(L["Xfer_DirectionCopied"].Value, n);
        }, null);

    private async Task OpenAddClause(AgreementRow a)
    {
        _editClauseId = null; _editHeaderId = null;
        _addClauseAgreementId = a.Id;
        _selectedId = a.Id;
        _addClause.Reset();
        // La faccetta parte già aperta sul caso più comune quando si consegna a un APP: «al confine dell'AoR».
        _addClause.Facet.Reset(preset: ReceivesApp(a));
        ResetPanelSections(_addClause);
        _formOpenedAs = _addClause.Signature();
        await LoadRunwaysAsync(a);
        _revealPanel = true;
    }

    private async Task EditClause(AgreementRow a, AgreementClauseRow c)
    {
        _addClauseAgreementId = null; _editHeaderId = null;
        _selectedId = a.Id;
        _direction = c.Direction;
        _editClauseId = c.Id;
        _editClause.LoadFrom(c, ParseRwys);
        ResetPanelSections(_editClause);
        _formOpenedAs = _editClause.Signature();
        await LoadRunwaysAsync(a);
        _revealPanel = true;
    }

    private void ClosePanel() { _editClauseId = null; _addClauseAgreementId = null; }

    private AgreementRow? CurrentAgreement() =>
        _editClauseId is int id ? AgreementOf(id)
        : _addClauseAgreementId is int add ? _agreements.FirstOrDefault(a => a.Id == add)
        : null;

    private AgreementClauseRow? CurrentClause() => _editClauseId is int id ? FindClause(id) : null;

    private bool InGroup() => CurrentClause()?.VariantGroup is not null;

    private bool ReceivesApp(AgreementRow a) =>
        a.Parties.Where(p => p.Side == AgreementSide.B)
            .Any(p => _all.FirstOrDefault(s => s.Id == p.SectorId)?.Type == SectorType.App);

    private Task SavePanel() =>
        _editClauseId is int id
            ? SaveClauseAsync(id)
            : _addClauseAgreementId is int agreementId ? AddClause(agreementId) : Task.CompletedTask;

    private Task SaveClauseAsync(int clauseId) =>
        Guarded(() => Agreements.UpdateClauseAsync(_acc!.Code, clauseId, ToClauseInput(_editClause)),
                L["Xfer_RowSaved"].Value);

    private async Task AddClause(int agreementId)
    {
        await Guarded(async () =>
        {
            await Agreements.AddClauseAsync(_acc!.Code, agreementId, _direction, ToClauseInput(_addClause));
            _addClause.Reset();
            _formOpenedAs = _addClause.Signature();
        }, L["Xfer_RowAdded"]);
    }

    private async Task DeleteClause()
    {
        if (_editClauseId is not int id) return;
        var c = FindClause(id);
        var a = AgreementOf(id);
        if (c is null || a is null) return;

        var snap = new AgreementClauseRestore(a.Id, SnapshotOf(c));
        await Guarded(() => Agreements.DeleteClauseAsync(_acc!.Code, id), L["Xfer_RowDeleted"].Value);
        if (_error is null)
        {
            ClosePanel();
            _undo = (() => Agreements.RestoreClausesAsync(_acc!.Code, new[] { snap }), L["Xfer_RowsRestored"].Value);
        }
    }

    private Task MoveClause(bool up) =>
        _editClauseId is int id ? RowAction(() => Agreements.MoveClauseAsync(_acc!.Code, id, up)) : Task.CompletedTask;

    private Task DuplicateGroup() =>
        _editClauseId is int id
            ? Guarded(async () =>
            {
                var n = await Agreements.DuplicateVariantGroupAsync(_acc!.Code, id);
                _status = string.Format(L["Xfer_GroupDuplicated"].Value, n);
            }, null)
            : Task.CompletedTask;

    private Task DetachVariant() =>
        _editClauseId is int id ? RowAction(() => Agreements.DetachVariantAsync(_acc!.Code, id)) : Task.CompletedTask;

    private Task AddAlternative(int clauseId) =>
        AddVariant(() => Agreements.AddAlternativeAsync(_acc!.Code, clauseId), L["Xfer_AlternativeAdded"].Value);

    private Task AddException(int clauseId) =>
        AddVariant(() => Agreements.AddExceptionAsync(_acc!.Code, clauseId), L["Xfer_ExceptionAdded"].Value);

    /// <summary>Una variante nasce e si apre subito nel pannello: è nata senza condizione, e la condizione è
    /// esattamente ciò che va scritto adesso.</summary>
    private async Task AddVariant(Func<Task<int>> add, string message)
    {
        var newId = 0;
        await Guarded(async () => { newId = await add(); }, null);
        if (_error is not null) return;
        _status = message;

        var c = FindClause(newId);
        var a = AgreementOf(newId);
        if (c is not null && a is not null) await EditClause(a, c);
    }

    private Task RowAction(Func<Task> action) => Guarded(action, null);

    /// <summary>Invio nel form dell'accordo nuovo: lo crea, se ha almeno un mittente.</summary>
    private async Task TrySubmitNew(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy || !_canEdit || _newForm.SideA.Count == 0) return;
        await AddAgreement();
    }

    /// <summary>Invio nel pannello: salva. Il gesto più frequente della pagina non deve richiedere il mouse.</summary>
    private async Task PanelKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy || !_canEdit) return;
        await SavePanel();
    }

    // ---- Input ---------------------------------------------------------------------------------------

    private AgreementInput ToInput(HeaderForm f) => new()
    {
        TrafficKind = f.Kind,
        Description = NullIfBlank(f.Description),
        SideA = f.SideA.Select(SectorIdOf).Where(id => id > 0).ToList(),
        SideB = f.SideB.Select(SectorIdOf).Where(id => id > 0).ToList(),
        Airports = f.Airports.ToList(),
    };

    private int SectorIdOf(string callsign) =>
        _all.FirstOrDefault(s => string.Equals(s.Callsign, callsign.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private AgreementClauseInput ToClauseInput(ClauseForm form) => form.Facet.Apply(new AgreementClauseInput
    {
        Cops = form.Points,
        LevelValue = form.Constraint == LevelConstraint.Special ? null : form.Value,
        LevelUnit = form.Unit,
        LevelConstraint = form.Constraint,
        LevelSpecial = form.Constraint == LevelConstraint.Special ? NullIfBlank(form.Special) : null,
        Parity = form.Parity,
        VerticalState = form.VState,
        ConditionLabel = form.Rwys.Length == 0 ? null : string.Join(" / ", form.Rwys),
        ConditionAreaLabel = NullIfBlank(form.AreaLabel),
        ConditionCustomLabel = NullIfBlank(form.CustomLabel),
    });

    // ---- Fotografie e annulla ------------------------------------------------------------------------

    private static AgreementClauseSnapshot SnapshotOf(AgreementClauseRow c) =>
        new(EditableCopy(c), c.Direction, c.Order, c.VariantGroup, c.VariantDepth);

    private static AgreementSnapshot SnapshotOf(AgreementRow a) => new(
        new AgreementInput
        {
            TrafficKind = a.TrafficKind,
            Description = a.Description,
            SideA = a.Parties.Where(p => p.Side == AgreementSide.A).OrderBy(p => p.Order).Select(p => p.SectorId).ToList(),
            SideB = a.Parties.Where(p => p.Side == AgreementSide.B).OrderBy(p => p.Order).Select(p => p.SectorId).ToList(),
            Airports = a.Airports.OrderBy(x => x.Order).Select(x => new AgreementAirportInput(x.Icao, x.Name)).ToList(),
        },
        a.Clauses.OrderBy(c => c.Direction).ThenBy(c => c.Order).Select(SnapshotOf).ToList());

    private (Func<Task> Restore, string Message)? _undo;

    private void ClearToast() { _status = null; _undo = null; }

    private async Task Undo()
    {
        if (_undo is not { } undo) return;
        _undo = null;
        await Guarded(undo.Restore, undo.Message);
    }

    /// <summary>Un gruppo di alternative senza «negli altri casi»: i casi che nessuna condizione copre restano
    /// scoperti, e chi legge non sa che fare. Può essere legittimo, quindi si segnala e non si impedisce.</summary>
    private IReadOnlyList<string> AlternativesWithoutNormalCase(AgreementRow a)
    {
        var avvisi = new List<string>();
        foreach (var g in a.Clauses.Where(c => c.Direction == _direction && c.VariantGroup is not null)
                     .GroupBy(c => c.VariantGroup!.Value))
        {
            var alternative = g.Where(c => c.VariantDepth == 0 && !c.IsGroupWide).ToList();
            if (alternative.Count > 1 && alternative.All(c => !string.IsNullOrWhiteSpace(c.ConditionDisplay)))
                avvisi.Add(alternative[0].Cops);
        }
        return avvisi;
    }

    /// <summary>
    /// Ogni scrittura passa di qui: azzera l'annulla precedente, mette la pagina in «occupato», ricarica e
    /// riporta l'errore in un posto solo.
    /// <para>⚠️ Il costo per gesto conta: ricaricare il contesto anteprima costa sei mappe, irrilevante dal
    /// pannello e caro a ogni Invio in cella. Si rifà solo quando cambia ciò che l'anteprima legge davvero.</para>
    /// </summary>
    private async Task Guarded(Func<Task> action, string? ok, bool withPreview = false)
    {
        if (_busy) return;
        _busy = true;
        _error = null; _status = null; _undo = null;
        try
        {
            await action();
            if (_acc is not null) await LoadAsync(withPreview);
            if (ok is not null) _status = ok;
        }
        catch (Vipi.Application.Aor.ValidationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
