        <TypeaheadPicker Label="@L["Xfer_CondArea"]" Placeholder="@L["Xfer_SearchArea"]"
                         Items="AreaItems(form.AreaText)" EmptyOption="@L["Xfer_AreaNone"]" NoMatch="@L["Xfer_NoArea"]"
                         Text="@form.AreaText" TextChanged="t => { form.AreaText = t; ResolveArea(form); }"
                         OnPick="i => PickArea(form, i?.Value)" OnUnhandledKey="PanelKey" />
