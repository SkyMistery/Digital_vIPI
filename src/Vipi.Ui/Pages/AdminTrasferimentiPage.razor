    {
        AgreementGapKind.ToReview => XferLabels.Clauses(L, g.Count),
        AgreementGapKind.AsymmetricDirections => L["Xfer_GapOnlyOneWay", string.Join(", ", g.Items)],
        AgreementGapKind.MissingReverse => L["Xfer_GapMissingReverseDetail", g.Count],
        AgreementGapKind.TwinSections => L["Xfer_GapTwinSectionsDetail", g.Count],
        AgreementGapKind.EmptySection => L["Xfer_GapEmptySectionDetail"],
        AgreementGapKind.NeighbourWithoutAgreement => L["Xfer_GapNeighbourDetail"],
        AgreementGapKind.AirportWithoutArrivals => L["Xfer_GapAirportDetail"],
        _ => L["Xfer_GapSectorDetail"],
