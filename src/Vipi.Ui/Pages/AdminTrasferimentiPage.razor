    /// <summary>
    /// Tasti del pannello: Invio salva, Ctrl+Invio salva e riapre per la riga successiva, Esc chiude.
    /// Invio non salva mentre il picker del ricevente è aperto — lì serve a scegliere.
    /// </summary>
    private async Task PanelKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { ClosePanel(); return; }
        if (e.Key != "Enter" || _busy || !_canEdit) return;
        var form = ActiveForm;
        if (form is null) return;
        if (form.NextOpen && !e.CtrlKey) return;
        if (_editPointId is null && e.CtrlKey) { await AddPoint(_addPointFlowId!.Value, keepOpen: true); return; }
        await SavePanel();
    }

