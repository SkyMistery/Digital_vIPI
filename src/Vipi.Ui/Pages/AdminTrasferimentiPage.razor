@page "/vsop/admin/trasferimenti"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject ITransferService Transfers
@inject IStructureEditingService Struct
@inject IEditAuthorizationService Authz
@inject INeighbourReader Neighbours

<PageTitle>Trasferimenti · vIPI IVAO Italia</PageTitle>

<style>
    .sector-pick-wrap { position: relative; }
    .sector-pick { position: absolute; left: 0; right: 0; top: 100%; z-index: 30; margin-top: 2px; max-height: 200px; overflow-y: auto; border: 1px solid #c4cadb; border-radius: 6px; background: #fff; box-shadow: 0 6px 18px rgba(13,44,153,.14); }
    .sector-pick .sp-item { display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid #eef1f7; background: transparent; padding: 5px 9px; font-size: 13px; cursor: pointer; }
    .sector-pick .sp-item:last-child { border-bottom: 0; }
    .sector-pick .sp-item:hover { background: #f2f5ff; }
    .sector-pick .sp-item.on { background: #0D2C99; color: #fff; font-weight: 600; }
    .sector-pick .sp-empty { display: block; padding: 6px 9px; color: #8a90a2; font-size: 12px; }
</style>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">Home</a> › <a href="/vsop/admin/permessi">Area Staff</a> › <a href="/vsop/admin/sectorstructure">Struttura</a> › <b>Trasferimenti</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">Trasferimenti tra settori</h2><span class="muted">Per ogni <b>settore</b> i trasferimenti sono raggruppati per <b>aeroporto</b> e per <b>tipo</b> (arrivi/partenze); ogni riga indica il <b>punto</b>, la <b>quota</b> e il <b>settore ricevente</b>. Nella vista operativa, se un settore è chiuso si risale la gerarchia fino al primo online (altrimenti UNICOM).</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic">⛔</span><div>Pagina riservata agli amministratori.</div></div>
    }
    else
    {
        @if (_error is not null) { <div class="callout danger"><span class="cic">⛔</span><div>@_error</div></div> }
        @if (_status is not null) { <div class="callout success"><span class="cic">✓</span><div>@_status</div></div> }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" />

        @* ---- Scelta ACC ---- *@
        <div class="section-title"><h3>ACC</h3><span class="ln"></span></div>
        <div class="block">
            @if (Stations.Accs.Count == 0)
            {
                <p class="help">Nessun ACC. Importa dalla <a href="/vsop/admin/acc">pagina ACC</a>.</p>
            }
            else
            {
                <div style="display:flex;flex-wrap:wrap;gap:8px">
                    @foreach (var a in Stations.Accs)
                    {
                        var active = string.Equals(_accCode, a.Code, StringComparison.OrdinalIgnoreCase);
                        <button class="btn @(active ? "primary" : "ghost")" disabled="@(_busy)" title="@a.Name" @onclick="() => SelectAcc(a.Code)">@a.Code</button>
                    }
                </div>
            }
        </div>

        @if (_acc is null)
        {
            <p class="help">Scegli un ACC per gestirne i trasferimenti.</p>
        }
        else
        {
            @* ---- Nuovo gruppo (settore · aeroporto · tipo) ---- *@
            <div class="block">
                <h5 style="margin-top:0">Nuovo gruppo di trasferimenti</h5>
                <div class="inline-form" style="border-top:0;padding-top:0;margin-top:0">
                    <div class="field sector-pick-wrap"><label>Settore mittente</label>
                        <input placeholder="cerca callsign…" @bind="_fSectorText" @bind:event="oninput" @bind:after="ResolveFSector"
                               @onfocus="() => _fOpen = true" @onblur="() => _fOpen = false" />
                        @if (_fOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var s in OwnSectors().Where(s => Match(s, _fSectorText)).Take(50))
                                {
                                    <button type="button" class="sp-item @(s.Id == _fSector ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickFSector(s)">@s.Callsign@(IsForeignSender(s) ? $" · {s.AccCode} (estero)" : "")</button>
                                }
                                @if (!OwnSectors().Any(s => Match(s, _fSectorText))) { <span class="sp-empty">nessun settore</span> }
                            </div>
                        }
                    </div>
                    <div class="field sector-pick-wrap"><label>Aeroporto <span class="muted" style="font-weight:400">(anche nuovo/estero)</span></label>
                        <input placeholder="LIRF / LFPG" @bind="_fApt" @bind:event="oninput" title="ICAO, anche estero" autocomplete="off"
                               @onfocus="() => _aOpen = true" @onblur="() => _aOpen = false" />
                        @if (_aOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var ap in _airports.Where(a => MatchApt(a, _fApt)).Take(50))
                                {
                                    <button type="button" class="sp-item @(string.Equals(ap.Icao, _fApt, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickApt(ap)"><b>@ap.Icao</b> <span class="muted" style="font-size:11px">@ap.Name · @ap.AccCode</span></button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_fApt) && !_airports.Any(a => string.Equals(a.Icao, _fApt.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <span class="sp-empty">↵ usa «@_fApt.Trim().ToUpperInvariant()» (nuovo aeroporto)</span>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_fApt) && !IsKnownApt(_fApt))
                    {
                        <div class="field"><label>Nome aeroporto <span class="muted" style="font-weight:400">(fuori DB)</span></label>
                            <div style="display:flex;gap:6px">
                                <input placeholder="es. Parigi Charles de Gaulle" @bind="_fAptName" title="Mostrato accanto all'ICAO nelle sezioni trasferimenti" />
                                <button type="button" class="btn ghost" style="white-space:nowrap" disabled="@_busy" @onclick="() => LookupApt(false)" title="Cerca il nome su IVAO (non aggiunge l'aeroporto al catalogo)">🔍 IVAO</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_fAptMsg)) { <span class="muted" style="font-size:11.5px">@_fAptMsg</span> }
                        </div>
                    }
                    <div class="field narrow"><label>Tipo</label>
                        <select @bind="_fKind">
                            <option value="@TransferFlowKind.Arrival">Arrivi</option>
                            <option value="@TransferFlowKind.Departure">Partenze</option>
                            <option value="@TransferFlowKind.Overflight">Sorvoli</option>
                            <option value="@TransferFlowKind.Vfr">VFR</option>
                            <option value="@TransferFlowKind.Other">Altro</option>
                        </select>
                    </div>
                    <div class="field"><label>Descrizione (opz.)</label><input placeholder="Roma NE trasferisce…" @bind="_fDesc" /></div>
                    <button class="btn primary" disabled="@(_busy || !_canEdit || _fSector == 0 || NewAptMissingName(_fApt, _fAptName))" @onclick="AddFlow">+ Gruppo</button>
                    @if (_canEdit && _fSector == 0) { <span class="muted" style="font-size:12px;align-self:center">Seleziona il settore mittente per abilitare</span> }
                    else if (_canEdit && AirportRequiredMissing(_fKind, _fApt)) { <span class="muted" style="font-size:12px;align-self:center">Arrivi/Partenze richiedono un aeroporto</span> }
                    else if (_canEdit && NewAptMissingName(_fApt, _fAptName)) { <span class="muted" style="font-size:12px;align-self:center">Aeroporto fuori DB: indica il nome</span> }
                </div>
                <p class="help" style="margin:6px 0 0">L'aeroporto può essere di uno stato estero (ICAO libero). Sorvoli/VFR possono restare senza aeroporto: in quel caso è il <b>settore ricevente</b> di ogni riga (interno o estero confinante) a farli comparire nei coordinamenti — senza ricevente la riga resta UNICOM e non viene derivata.</p>
            </div>

            @if (_flows.Count == 0)
            {
                <p class="help">Nessun trasferimento per questo ACC. Aggiungi un gruppo qui sopra.</p>
            }
            else
            {
                var shown = FilteredFlows();
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:6px 0 12px">
                    <input class="htree-search" style="flex:1;min-width:180px" placeholder="filtra: settore / aeroporto / CoP / ricevente…"
                           @bind="_flowFilter" @bind:event="oninput" />
                    <select @bind="_kindFilter" style="width:130px">
                        <option value="">Tutti i tipi</option>
                        <option value="@TransferFlowKind.Arrival">Arrivi</option>
                        <option value="@TransferFlowKind.Departure">Partenze</option>
                        <option value="@TransferFlowKind.Overflight">Sorvoli</option>
                        <option value="@TransferFlowKind.Vfr">VFR</option>
                        <option value="@TransferFlowKind.Other">Altro</option>
                    </select>
                    <span class="muted" style="font-size:12px;white-space:nowrap">@shown.Count grupp@(shown.Count == 1 ? "o" : "i") · @shown.Sum(f => f.Points.Count) righe</span>
                    @if (_filtering) { <button class="btn ghost" @onclick="() => { _flowFilter = string.Empty; _kindFilter = null; }">↺ azzera</button> }
                </div>
                @if (shown.Count == 0)
                {
                    <p class="help">Nessun trasferimento corrisponde al filtro.</p>
                }

            @* ---- Settore ▸ Aeroporto ▸ Tipo ▸ righe ---- *@
            @foreach (var secGroup in shown.GroupBy(f => f.OwningSectorCallsign).OrderBy(g => g.Key))
            {
                var secKey = secGroup.Key;
                var secOpen = _filtering || !_collapsedSec.Contains(secKey);
                <div class="section-title" style="margin-bottom:4px;cursor:pointer" @onclick="() => ToggleSec(secKey)">
                    <h3 style="margin:0"><span style="display:inline-block;width:1em">@(secOpen ? "▾" : "▸")</span> @secKey</h3>
                    <span class="ln"></span>
                    <span class="muted" style="font-size:12px">@secGroup.Count() gruppi</span>
                </div>
                @if (!secOpen) { continue; }
                @foreach (var aptGroup in secGroup.GroupBy(f => f.AirportIcao).OrderBy(g => g.Key ?? "~"))
                {
                    var aptKey = $"{secKey}|{aptGroup.Key}";
                    var aptOpen = _filtering || !_collapsedApt.Contains(aptKey);
                    <div class="block">
                        <h5 style="margin:0;cursor:pointer" @onclick="() => ToggleApt(aptKey)">
                            <span style="display:inline-block;width:1em">@(aptOpen ? "▾" : "▸")</span>
                            @AptHeader(aptGroup.Key)
                        </h5>
                        @if (aptOpen)
                        {
                        @foreach (var f in aptGroup.OrderBy(x => x.Kind))
                        {
                            var flowOpen = _filtering || !_collapsedFlow.Contains(f.Id);
                            <div class="section-title" style="margin:6px 0">
                                <h4 style="margin:0;cursor:pointer" @onclick="() => ToggleFlow(f.Id)">
                                    <span style="display:inline-block;width:1em">@(flowOpen ? "▾" : "▸")</span>
                                    <span class="pill blue">@KindLabel(f.Kind)</span>
                                    <span class="muted" style="font-size:12px;font-weight:400">@f.Points.Count righe</span>
                                    @if (f.Points.Count > 0 && f.Points.All(p => string.IsNullOrWhiteSpace(p.NextSectorCallsign)))
                                    {
                                        <span class="pill" style="background:#f4c542;color:#3a2f00" title="Ogni riga è UNICOM: senza settore ricevente il flusso non compare nei coordinamenti derivati">⚠ nessun ricevente</span>
                                    }
                                </h4>
                                <span class="ln"></span>
                                @if (_confirmDeleteFlowId == f.Id)
                                {
                                    <span class="muted" style="font-size:12.5px">Eliminare? <b>@f.Points.Count righe</b></span>
                                    <button class="btn danger" disabled="@(_busy || !_canEdit)" @onclick="() => DeleteFlow(f.Id)">Sì, elimina</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _confirmDeleteFlowId = null">Annulla</button>
                                }
                                else
                                {
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => EditFlow(f)">✎ Gruppo</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _confirmDeleteFlowId = f.Id">✕ Gruppo</button>
                                }
                            </div>
                            @if (!flowOpen) { continue; }
                            @if (_editFlowId == f.Id)
                            {
                                <div class="inline-form" style="margin:0 0 8px">
                                    <div class="field sector-pick-wrap"><label>Settore mittente</label>
                                        <input placeholder="cerca callsign…" @bind="_efSectorText" @bind:event="oninput" @bind:after="ResolveEfSector"
                                               @onfocus="() => _efOpen = true" @onblur="() => _efOpen = false" />
                                        @if (_efOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in OwnSectors().Where(s => Match(s, _efSectorText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _efSector ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEfSector(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode@(IsForeignSender(s) ? " (estero)" : "")</span></button>
                                                }
                                                @if (!OwnSectors().Any(s => Match(s, _efSectorText))) { <span class="sp-empty">nessun settore</span> }
                                            </div>
                                        }
                                    </div>
                                    <div class="field narrow"><label>Tipo</label>
                                        <select @bind="_efKind">
                                            <option value="@TransferFlowKind.Arrival">Arrivi</option>
                                            <option value="@TransferFlowKind.Departure">Partenze</option>
                                            <option value="@TransferFlowKind.Overflight">Sorvoli</option>
                                            <option value="@TransferFlowKind.Vfr">VFR</option>
                                            <option value="@TransferFlowKind.Other">Altro</option>
                                        </select>
                                    </div>
                                    <div class="field narrow"><label>Aeroporto</label><input placeholder="LIRF / —" @bind="_efApt" /></div>
                                    @if (!string.IsNullOrWhiteSpace(_efApt) && !IsKnownApt(_efApt))
                                    {
                                        <div class="field"><label>Nome aeroporto <span class="muted" style="font-weight:400">(fuori DB)</span></label>
                                            <div style="display:flex;gap:6px">
                                                <input placeholder="es. Parigi Charles de Gaulle" @bind="_efAptName" />
                                                <button type="button" class="btn ghost" style="white-space:nowrap" disabled="@_busy" @onclick="() => LookupApt(true)" title="Cerca il nome su IVAO (non aggiunge l'aeroporto al catalogo)">🔍 IVAO</button>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_efAptMsg)) { <span class="muted" style="font-size:11.5px">@_efAptMsg</span> }
                                        </div>
                                    }
                                    <div class="field"><label>Descrizione (opz.)</label><input placeholder="Roma NE trasferisce…" @bind="_efDesc" /></div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || NewAptMissingName(_efApt, _efAptName))" @onclick="() => SaveFlow(f.Id)">💾 Salva</button>
                                    @if (_canEdit && AirportRequiredMissing(_efKind, _efApt)) { <span class="muted" style="font-size:12px;align-self:center">Arrivi/Partenze richiedono un aeroporto</span> }
                                    else if (_canEdit && NewAptMissingName(_efApt, _efAptName)) { <span class="muted" style="font-size:12px;align-self:center">Aeroporto fuori DB: indica il nome</span> }
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editFlowId = null">Annulla</button>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(f.Description)) { <p class="muted" style="margin:0 0 8px;font-size:13.5px">@f.Description</p> }

                            <table class="res-table">
                                <thead><tr><th>CoP (punto)</th><th>Quota</th><th>Settore ricevente</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var p in f.Points)
                                    {
                                        @if (_editPointId == p.Id)
                                        {
                                            <tr>
                                                <td><input style="width:90px" placeholder="VALMA / —" @bind="_epCop" /></td>
                                                <td>
                                                    <select @bind="_epConstraint" style="width:78px">
                                                        <option value="@LevelConstraint.AtOrBelow">≤ (↓)</option>
                                                        <option value="@LevelConstraint.AtOrAbove">≥ (↑)</option>
                                                        <option value="@LevelConstraint.Exact">esatto</option>
                                                        <option value="@LevelConstraint.Special">speciale</option>
                                                    </select>
                                                    @if (_epConstraint == LevelConstraint.Special)
                                                    {
                                                        <input style="width:120px" placeholder="per aerovia" @bind="_epSpecial" />
                                                    }
                                                    else
                                                    {
                                                        <input type="number" style="width:70px" @bind="_epValue" />
                                                        <select @bind="_epUnit" style="width:56px"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                                                    }
                                                    <select @bind="_epParity" style="width:78px" title="Livelli semicircolari">
                                                        <option value="@LevelParity.Any">Tutti</option>
                                                        <option value="@LevelParity.Even">Pari</option>
                                                        <option value="@LevelParity.Odd">Dispari</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <div class="sector-pick-wrap">
                                                        <input style="width:150px" placeholder="UNICOM" @bind="_epNextText" @bind:event="oninput" @bind:after="ResolveEpNext"
                                                               @onfocus="() => _epOpen = true" @onblur="() => _epOpen = false" />
                                                        @if (_epOpen)
                                                        {
                                                            <div class="sector-pick">
                                                                @foreach (var s in _all.Where(s => Match(s, _epNextText)).Take(50))
                                                                {
                                                                    <button type="button" class="sp-item @(s.Id == _epNext ? "on" : "")"
                                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEpNext(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode</span></button>
                                                                }
                                                                @if (!_all.Any(s => Match(s, _epNextText))) { <span class="sp-empty">nessun settore</span> }
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                                <td style="white-space:nowrap">
                                                    <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="() => SavePoint(p.Id)">💾</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editPointId = null">✕</button>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td><b>@(string.IsNullOrWhiteSpace(p.Cop) ? "—" : p.Cop)</b></td>
                                                <td>@p.LevelText</td>
                                                <td>@(p.NextSectorCallsign ?? "—")</td>
                                                <td style="white-space:nowrap">
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[0].Id)" title="Sposta su" @onclick="() => Move(p.Id, true)">▲</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit || p.Id == f.Points[^1].Id)" title="Sposta giù" @onclick="() => Move(p.Id, false)">▼</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => EditPoint(p)">✎</button>
                                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => DeletePoint(p.Id)">✕</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                            @if (_addPointFlowId == f.Id)
                            {
                                <div class="inline-form" style="margin-top:8px">
                                    <div class="field narrow"><label>CoP</label><input placeholder="VALMA / —" @bind="_pCop" /></div>
                                    <div class="field narrow"><label>Vincolo</label>
                                        <select @bind="_pConstraint">
                                            <option value="@LevelConstraint.AtOrBelow">≤ (↓)</option>
                                            <option value="@LevelConstraint.AtOrAbove">≥ (↑)</option>
                                            <option value="@LevelConstraint.Exact">esatto</option>
                                            <option value="@LevelConstraint.Special">speciale</option>
                                        </select>
                                    </div>
                                    @if (_pConstraint == LevelConstraint.Special)
                                    {
                                        <div class="field"><label>Testo quota</label><input placeholder="per aerovia" @bind="_pSpecial" /></div>
                                    }
                                    else
                                    {
                                        <div class="field narrow"><label>Valore</label><input type="number" @bind="_pValue" /></div>
                                        <div class="field narrow"><label>Unità</label>
                                            <select @bind="_pUnit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                                        </div>
                                    }
                                    <div class="field narrow"><label>Livelli <span class="muted" style="font-weight:400">(semicircolare)</span></label>
                                        <select @bind="_pParity">
                                            <option value="@LevelParity.Any">Tutti</option>
                                            <option value="@LevelParity.Even">Pari</option>
                                            <option value="@LevelParity.Odd">Dispari</option>
                                        </select>
                                    </div>
                                    <div class="field sector-pick-wrap"><label>Settore ricevente <span class="muted" style="font-weight:400">(vuoto = UNICOM)</span></label>
                                        <input placeholder="cerca callsign…" @bind="_pNextText" @bind:event="oninput" @bind:after="ResolvePNext"
                                               @onfocus="() => _pOpen = true" @onblur="() => _pOpen = false" />
                                        @if (_pOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in _all.Where(s => Match(s, _pNextText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _pNext ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickPNext(s)">@s.Callsign <span class="muted" style="font-size:11px">@s.AccCode</span></button>
                                                }
                                                @if (!_all.Any(s => Match(s, _pNextText))) { <span class="sp-empty">nessun settore</span> }
                                            </div>
                                        }
                                    </div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="() => AddPoint(f.Id)">Aggiungi riga</button>
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _addPointFlowId = null">Annulla</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn ghost" style="margin-top:8px" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddPoint(f.Id)">+ Riga (CoP/quota/ricevente)</button>
                            }
                        }
                        }
                    </div>
                }
            }
            }
        }
    }
</div>

@code {
    private string _accCode = "";
    private AccInfo? _acc;
    private IReadOnlyList<TransferFlowRow> _flows = Array.Empty<TransferFlowRow>();
    private IReadOnlyList<GlobalSectorRow> _all = Array.Empty<GlobalSectorRow>();
    private IReadOnlyList<AirportAdminRow> _airports = Array.Empty<AirportAdminRow>();
    private IReadOnlyList<NeighbourCandidateRow> _candidates = Array.Empty<NeighbourCandidateRow>();
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _status, _error;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // Stato collasso (chiavi presenti = collassate): settore, aeroporto (settore|icao), gruppo arrivi/partenze (flowId).
