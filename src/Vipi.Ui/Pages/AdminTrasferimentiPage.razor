            <div class="xt-row2">
                <div class="field"><label>@L["Xfer_CommsWhere"]</label>
                    <select @bind="form.Facet.CommsKind">
                        <option value="@TransferHandoffKind.Unspecified">@L["Xfer_CommsSameAsControl"]</option>
                        <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                        <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                        <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                    </select>
                </div>
                @if (form.Facet.CommsKind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
                {
                    <div class="field"><label>@L["Xfer_HandoffLabel"]</label>
                        <input @bind="form.Facet.CommsLabel" @bind:event="oninput" @onkeydown="PanelKey" />
                    </div>
