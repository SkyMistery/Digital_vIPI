    // ---- Costruzione di ciò che si vede -------------------------------------------------------------

    /// <summary>La sezione a fuoco, col suo accordo: è dove finisce una clausola nuova.</summary>
    private (AgreementRow Agreement, AgreementSectionRow Section)? FocusSection()
    {
        if (_focusSectionId is not int id) return null;
        foreach (var a in _agreements)
            foreach (var sec in a.Sections)
                if (sec.Id == id) return (a, sec);
        return null;
    }

    private AgreementRow? SelectedAgreement() =>
        _selectedId is int id ? _agreements.FirstOrDefault(a => a.Id == id) : null;

    /// <summary>Le clausole di <b>una sezione</b>, nell'ordine della vista.</summary>
    private IReadOnlyList<XferTableRow> RowsFor(AgreementRow a, AgreementSectionRow s)
    {
        var clauses = SortedClauses(s.Clauses);
        return BuildRows(clauses.Select(c => (Agreement: a, Section: s, Clause: c)).ToList());
    }

    private IReadOnlyList<AgreementClauseRow> SortedClauses(IReadOnlyList<AgreementClauseRow> clauses) => _sort switch
    {
        RowSort.Points => clauses.OrderBy(c => string.IsNullOrWhiteSpace(c.Cops) ? "~" : c.Cops, StringComparer.OrdinalIgnoreCase).ToList(),
        RowSort.Level => clauses.OrderBy(c => c.LevelValue ?? int.MaxValue).ThenBy(c => c.Cops, StringComparer.OrdinalIgnoreCase).ToList(),
        _ => clauses.OrderBy(c => c.Order).ToList(),
    };

    /// <summary>
    /// Tutte le clausole degli accordi mostrati, per la vista a elenco.
    /// <para>Qui il filtro «da rivedere» vale davvero <b>sulle clausole</b>: in albero può solo restringere gli
    /// accordi, e un accordo con una clausola da rivedere su otto continuava a mostrarne otto.</para>
    /// </summary>
    private IReadOnlyList<XferTableRow> FlatRows(IReadOnlyList<AgreementRow> agreements)
    {
        var triples = agreements
            .SelectMany(a => a.Sections.SelectMany(s => s.Clauses.Select(c => (Agreement: a, Section: s, Clause: c))))
            .Where(x => !_toReviewOnly || NeedsReview(x.Agreement, x.Section, x.Clause));

        // «Manuale» in elenco non può essere l'ordine dell'outline (è per sezione): è l'ordine dell'albero
        // appiattito — controparte, sezione — e dentro la sezione l'outline vero.
        var ordered = triples
            .OrderBy(x => CounterpartLabel(x.Agreement), StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Section.Order)
            .ThenBy(x => x.Clause.Order);

        ordered = _sort switch
        {
            RowSort.Points => Direct(ordered, x => string.IsNullOrWhiteSpace(x.Clause.Cops) ? "~" : x.Clause.Cops),
            RowSort.Level => Direct(ordered, x => (x.Clause.LevelValue ?? int.MaxValue).ToString("D6")),
            RowSort.Sender => Direct(ordered, x => XferLabels.Sender(x.Agreement, x.Section)),
            RowSort.Receiver => Direct(ordered, x => XferLabels.Receiver(x.Agreement, x.Section)),
            RowSort.Airport => Direct(ordered, x => x.Section.AirportsLabel),
            RowSort.Kind => Direct(ordered, x => XferLabels.Kind(L, x.Section.Kind)),
            _ => ordered,
        };

        return BuildRows(ordered.ToList());
    }

    /// <summary>Applica la chiave scelta <b>sopra</b> l'ordine di base, nel verso corrente. Il confronto è per
    /// stringa anche sul livello (imbottito a sei cifre): una chiave sola tiene insieme i casi, e un numero
    /// ordinato come testo con la stessa larghezza si ordina come numero.</summary>
    private IOrderedEnumerable<(AgreementRow Agreement, AgreementSectionRow Section, AgreementClauseRow Clause)> Direct(
        IOrderedEnumerable<(AgreementRow Agreement, AgreementSectionRow Section, AgreementClauseRow Clause)> rows,
        Func<(AgreementRow Agreement, AgreementSectionRow Section, AgreementClauseRow Clause), string> key) =>
        _sortDesc
            ? rows.OrderByDescending(key, StringComparer.OrdinalIgnoreCase)
            : rows.OrderBy(key, StringComparer.OrdinalIgnoreCase);

    /// <summary>Le righe pronte da rendere: blocco di varianti, anteprima e riassunto della faccetta composti.</summary>
    private List<XferTableRow> BuildRows(IReadOnlyList<(AgreementRow Agreement, AgreementSectionRow Section, AgreementClauseRow Clause)> src)
    {
        var rows = new List<XferTableRow>(src.Count);
        for (var i = 0; i < src.Count; i++)
        {
            var (a, s, c) = (src[i].Agreement, src[i].Section, src[i].Clause);
            rows.Add(new XferTableRow(a, s, c, GroupViewOf(src, i),
                                      _showPreviews ? PreviewOf(a, s, c) : null, FacetSummary(c)));
        }
        return rows;
    }

    /// <summary>
    /// Il blocco di varianti della clausola in posizione <paramref name="ix"/> della vista.
    /// <para>Apertura e chiusura si calcolano sull'ordine <b>mostrato</b> — la guida deve chiudersi dove il
    /// blocco finisce a schermo — mentre il padre si legge sull'ordine <b>salvato</b>: quello è la struttura, e
    /// ordinare la vista non la cambia.</para>
    /// <para>⚠️ Due righe adiacenti stanno nello stesso blocco solo se vengono dalla stessa <b>sezione</b>: il
    /// numero di gruppo è progressivo per accordo, e in elenco due gruppi di sezioni diverse si toccano davvero
    /// — senza questo controllo si fonderebbero in un blocco che non esiste.</para>
    /// </summary>
    private static XferGroupView GroupViewOf(IReadOnlyList<(AgreementRow Agreement, AgreementSectionRow Section, AgreementClauseRow Clause)> shown, int ix)
    {
        var (s, c) = (shown[ix].Section, shown[ix].Clause);
        if (c.VariantGroup is not int g) return XferGroupView.None;

        bool SameBlock(int j) =>
            j >= 0 && j < shown.Count && shown[j].Section.Id == s.Id && shown[j].Clause.VariantGroup == g;

        var siblings = s.Clauses.OrderBy(x => x.Order).ToList();
        var count = siblings.Count(x => x.VariantGroup == g);
        return new XferGroupView(true, !SameBlock(ix - 1), !SameBlock(ix + 1), g % 2 == 1, count, c.VariantDepth,
                                 Outline.ParentOf(siblings, c));
    }

    /// <summary>
    /// L'albero del navigatore: <b>ACC della controparte ▸ accordo</b>, con gli avvisi già contati.
    /// <para>Due livelli e non tre: la relazione <i>è</i> l'accordo — ce n'è uno solo per coppia — e il livello
    /// che stava in mezzo è sparito con la ragione che lo teneva in piedi.</para>
    /// <para>La chiave del ramo è l'ACC dell'<b>altro capo letto dalla lente</b>, non il lato B: per i 13 accordi
    /// di LIBB (10 su 11 di LIRR) in cui la ACC aperta <i>è</i> il lato B, il ramo prendeva il nome dei nostri
    /// stessi settori.</para>
    /// </summary>
    private IReadOnlyList<XferNavCounterpart> BuildNav(IReadOnlyList<AgreementRow> agreements) =>
        agreements.GroupBy(NavKey, StringComparer.OrdinalIgnoreCase)
            .Select(g => new XferNavCounterpart(
                g.Key,
                NavGroupLabel(g.First()),
                NavGroupNote(g.First()),
                NavGroupOrder(g.First()),
                // L'ordine è per CONTROPARTE e poi per il nostro capo: è il nome che si sta cercando, e il
                // nostro lato è quasi sempre lo stesso su tutte le relazioni di una ACC.
                g.Select(NavAgreement)
                 .OrderBy(a => a.Far, StringComparer.OrdinalIgnoreCase)
                 .ThenBy(a => a.Near, StringComparer.OrdinalIgnoreCase)
                 .ToList()))
            // I due casi particolari — accordi interni e controparti fuori catalogo — stanno in fondo: sono
            // elenchi brevi, e non sono un confine con cui si lavora.
            .OrderBy(c => c.SortOrder).ThenBy(c => c.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private XferNavAgreement NavAgreement(AgreementRow a) =>
        new(a.Id, _lens.Near(a), _lens.Far(a), a.Note,
            a.Sections.Count,
            a.Sections.Sum(s => s.Clauses.Count),
            MissingReverseCount(a),
            a.Sections.Sum(s => s.Clauses.Count(c => NeedsReview(a, s, c))));

    /// <summary>Quante sezioni hanno un reciproco che avrebbe senso e non è scritto. Solo dove il reciproco
    /// esiste davvero: un arrivo non ne ha uno — il traffico scende verso lo scalo e basta.</summary>
    private static int MissingReverseCount(AgreementRow a) =>
        a.Sections.Count(s => Mirrorable(s.Kind) && s.Clauses.Count > 0 && ReverseOf(a, s) is null);

    /// <summary>La sezione speculare: stesso traffico, stessi scali, verso opposto.</summary>
    private static AgreementSectionRow? ReverseOf(AgreementRow a, AgreementSectionRow s) =>
        a.Sections.FirstOrDefault(x => x.Id != s.Id && x.Kind == s.Kind && x.Direction != s.Direction
                                       && string.Equals(x.AirportsLabel, s.AirportsLabel, StringComparison.OrdinalIgnoreCase));

    /// <summary>Il traffico ha un reciproco: sorvoli, VFR, altro. Arrivi e partenze no — il loro «contrario» è
    /// una sezione di tipo diverso, e per quella l'accostamento per aeroporto basta a farla vedere.</summary>
    private static bool Mirrorable(TransferFlowKind k) =>
        k is not (TransferFlowKind.Arrival or TransferFlowKind.Departure);

    /// <summary>La chiave di collasso: l'ACC della controparte. Deve essere <b>stabile</b>, perché i nodi chiusi
    /// vivono in un insieme di chiavi e un'etichetta localizzata cambierebbe albero cambiando lingua.</summary>
    private string NavKey(AgreementRow a)
    {
        var o = _lens.Orient(a);
        if (o.IsInternal) return $"acc:{_accCode}:interni";
        return _lens.FarAccCode(a) is { Length: > 0 } acc ? $"acc:{acc}" : "acc:";
    }

    private string NavGroupLabel(AgreementRow a) =>
        _lens.FarAccCode(a) is { Length: > 0 } acc ? acc : L["Xfer_NoCounterpart"];

    private string? NavGroupNote(AgreementRow a) =>
        _lens.Orient(a).IsInternal ? L["Xfer_NavInternal"].Value : null;

    private int NavGroupOrder(AgreementRow a) =>
        _lens.Orient(a).IsInternal ? 1 : _lens.FarAccCode(a) is { Length: > 0 } ? 0 : 2;

    /// <summary>Come si legge la controparte di un accordo: l'<b>altro capo rispetto a noi</b>.</summary>
    private string CounterpartLabel(AgreementRow a) => _lens.Far(a);

    /// <summary>Il nostro capo dell'accordo, come si legge.</summary>
    private string NearLabel(AgreementRow a) => _lens.Near(a);

    /// <summary>
    /// Una clausola «da rivedere» consegna a un APP e non dice ancora dove avviene il trasferimento. Prima
    /// della faccetta quel dato non esisteva, quindi il suo livello poteva voler dire due cose diverse
    /// (autorizzato o al trasferimento) e solo chi l'ha scritta lo sa: vanno riaperte a mano.
    /// </summary>
    private bool NeedsReview(AgreementRow a, AgreementSectionRow s, AgreementClauseRow c)
    {
        if (c.HandoffKind != TransferHandoffKind.Unspecified) return false;
        var receiver = a.Receiver(s.Direction);
        return _all.FirstOrDefault(x => x.Id == receiver.SectorId)?.Type == SectorType.App;
    }

    private int ToReviewCount() =>
        _agreements.Sum(a => a.Sections.Sum(s => s.Clauses.Count(c => NeedsReview(a, s, c))));

    /// <summary>Accordi filtrati per testo (capi/aeroporti/nota/punti), tipo di traffico e «da rivedere».</summary>
    private IReadOnlyList<AgreementRow> FilteredAgreements()
    {
        var q = _filter.Trim();
        return _agreements.Where(a =>
            (_kindFilter is null || a.Sections.Any(s => s.Kind == _kindFilter))
            && (!_toReviewOnly || a.Sections.Any(s => s.Clauses.Any(c => NeedsReview(a, s, c))))
            && (q.Length == 0
                || a.SideA.Callsign.Contains(q, StringComparison.OrdinalIgnoreCase)
                || a.SideB.Callsign.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (a.Note?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || a.Sections.Any(s => s.Airports.Any(x => x.Icao.Contains(q, StringComparison.OrdinalIgnoreCase))
                                       || (s.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                                       || s.Clauses.Any(c => c.Cops.Contains(q, StringComparison.OrdinalIgnoreCase)))))
            .ToList();
    }

    /// <summary>Le sezioni dell'accordo che passano il filtro per tipo: in albero il filtro restringe ciò che si
    /// vede dentro l'accordo, non solo quali accordi compaiono.</summary>
    private IReadOnlyList<AgreementSectionRow> VisibleSections(AgreementRow a) =>
        _kindFilter is null ? a.Sections : a.Sections.Where(s => s.Kind == _kindFilter).ToList();

    // ---- Colonna 2: il riquadro di lavoro -----------------------------------------------------------

    /// <summary>Testata del riquadro: dice cosa si sta guardando e — a destra — come uscirne.</summary>
    private RenderFragment PaneHead(string title, string? subtitle, EventCallback? onClose) => __builder =>
    {
        <div class="xt-pane-h">
            <b>@title</b>
            @if (!string.IsNullOrWhiteSpace(subtitle)) { <span class="muted xt-hint">@subtitle</span> }
            @if (onClose is { } close)
            {
                <button class="btn ghost xt-panel-x" title="@L["Common_Close"]" @onclick="close">✕</button>
            }
        </div>
    };

    private RenderFragment WorkPane(IReadOnlyList<AgreementRow> shown, IReadOnlyList<XferTableRow> rows) => __builder =>
    {
        if (_view == XferView.Flat)
        {
            <div class="xt-pane-h">
                <b>@L["Xfer_ViewFlat"]</b>
                <span class="muted xt-hint">@XferLabels.Clauses(L, rows.Count)</span>
                @* «+ Clausola» compare quando una SEZIONE è a fuoco — la si porta dietro passando da albero a
                   elenco. Senza, non comparirebbe: una clausola appartiene a una tabella, e chiedere quale con
                   un secondo selettore sarebbe un giro più lungo del tornare all'albero (che è il tasto ↗). *@
                @if (FocusSection() is { } target)
                {
                    <span class="ln xt-grow"></span>
                    <span class="muted xt-hint">@CounterpartLabel(target.Agreement) · @XferLabels.Section(L, target.Section)</span>
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddClause(target.Agreement, target.Section)">+ @L["Xfer_AddClause"]</button>
                }
            </div>
            <div class="xt-pane-body">
                @if (rows.Count == 0)
                {
                    <p class="help">@(_filtering ? L["Xfer_NoFilterMatch"] : L["Xfer_NoFlows"])</p>
                }
                else
                {
                    @RowsTable(rows, showContext: true, canDrag: false)
                }
            </div>
            return;
        }

        if (_newOpen)
        {
            @PaneHead(L["Xfer_NewAgreement"].Value, null, EventCallback.Factory.Create(this, CloseNew))
            <div class="xt-pane-body">
                @PairFields(_newPair)
                <div class="xt-foot">
                    @* Servono i DUE capi: un accordo è una relazione, e con un capo solo non lo è. Il
                       suggerimento dice quale manca invece di un «compila i campi» generico. *@
                    <button class="btn primary" disabled="@(_busy || !_canEdit || !_newPair.HasBothSides)" @onclick="AddAgreement">+ @L["Xfer_Agreement"]</button>
                    @if (_canEdit && _newPair.SideA.Length == 0) { <span class="muted xt-hint xt-selfc">@L["Xfer_SelectSenderHint"]</span> }
                    else if (_canEdit && _newPair.SideB.Length == 0) { <span class="muted xt-hint xt-selfc">@L["Xfer_SelectReceiverHint"]</span> }
                </div>
                <p class="help xt-mt0">@((MarkupString)L["Xfer_NewAgreementHelp"].Value)</p>
            </div>
            return;
        }

        var ag = SelectedAgreement();
        if (ag is null)
        {
            @* Riquadro vuoto: dice cosa fare. Una colonna che non dice niente sembra rotta — vale qui come vale
               per il pannello, ed è la stessa lezione. *@
            <div class="xt-pane-empty">
                <p class="ct">@L["Xfer_PaneEmptyTitle"]</p>
                <p class="muted">@(shown.Count == 0 && !_filtering ? L["Xfer_PaneEmptyFirst"] : L["Xfer_PaneEmptyBody"])</p>
            </div>
            return;
        }

        var orient = _lens.Orient(ag);
        var sezioni = VisibleSections(ag);

        @* Testata dell'accordo: i DUE CAPI, e basta. Il traffico non è più qui — sta nelle sezioni, una per
           tabella — perché un accordo con arrivi, partenze e due versi di sorvoli non ha «un» tipo.
           ⚠️ L'ordine è «noi · loro», che NON è l'ordine di archivio: i lati stanno in forma canonica (id minore
           = A), che non significa niente per chi legge. *@
        <div class="xt-pane-h">
            <b>@ag.Side(orient.NearSide).Callsign</b>
            <span class="xt-dir">⇄</span>
            <b>@ag.Side(orient.FarSide).Callsign</b>
            @if (orient.IsInternal)
            {
                <span class="pill neutral" title="@L["Xfer_InternalTitle"]">@L["Xfer_NavInternal"]</span>
            }
            <span class="muted xt-hint">@XferLabels.Sections(L, ag.Sections.Count)</span>
            @if (!string.IsNullOrWhiteSpace(ag.Note))
            {
                <span class="muted xt-desc" title="@ag.Note">— @ag.Note</span>
            }
            <span class="ln xt-grow"></span>
            @* Gli stessi due tasti dell'albero, e nello stesso ordine: aprire tutto e chiudere tutto è un gesto
               che il resto dell'app ha già insegnato, e cambiarne la forma qui costerebbe di impararlo due volte.
               ⚠️ Non sono sotto il lock: guardare non è scrivere. *@
            <button class="btn ghost" title="@L["Xfer_ExpandSections"]" @onclick="() => ExpandAllSections(ag)">⊞</button>
            <button class="btn ghost" title="@L["Xfer_CollapseSections"]" @onclick="() => CollapseAllSections(ag)">⊟</button>
            <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenNewSection(ag)">+ @L["Xfer_Section"]</button>
            <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenEditHeader(ag)">✎ @L["Xfer_AgreementEdit"]</button>
            <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteGroupAria"]" Disabled="@(_busy || !_canEdit)"
                           Prompt="@(string.Format(L["Xfer_DeleteAgreementPrompt"].Value, ag.Sections.Sum(x => x.Clauses.Count)))" OnConfirm="() => DeleteAgreement(ag)"><Trigger><Icon Name="x" /> @L["Xfer_AgreementDelete"]</Trigger></InlineConfirm>
        </div>

        <div class="xt-pane-body">
            @if (_editHeaderId == ag.Id)
            {
                <div class="xt-subform">
                    @PairFields(_editPair)
                    <div class="xt-foot">
                        <button class="btn primary" disabled="@(_busy || !_canEdit || !_editPair.HasBothSides)" @onclick="() => SaveHeader(ag)">💾 @L["Common_Save"]</button>
                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editHeaderId = null">@L["Common_Cancel"]</button>
                        @* ⚠️ Cambiare un capo può ribaltare i versi di tutte le sezioni: i lati si tengono in
                           forma canonica, e il verso li segue. È detto qui perché non sia una sorpresa. *@
                        <span class="muted xt-hint xt-selfc">@L["Xfer_PairEditHint"]</span>
                    </div>
                </div>
            }

            @if (_newSectionFor == ag.Id)
            {
                <div class="xt-subform">
                    <b>@L["Xfer_NewSection"]</b>
                    @SectionFields(ag)
                    <div class="xt-foot">
                        <button class="btn primary" disabled="@(_busy || !_canEdit || !_sectionForm.Ready)" @onclick="() => AddSection(ag)">+ @L["Xfer_Section"]</button>
                        <button class="btn ghost" disabled="@_busy" @onclick="() => _newSectionFor = null">@L["Common_Cancel"]</button>
                        @if (_canEdit && !_sectionForm.Ready) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                    </div>
                </div>
            }

            @if (sezioni.Count == 0)
            {
                <p class="help">@(_kindFilter is not null ? L["Xfer_NoFilterMatch"] : L["Xfer_NoSectionsYet"])</p>
            }

            @* Le sezioni nell'ordine in cui si leggono — aeroporto per aeroporto (arrivi poi partenze), poi i
               sorvoli nei due versi, poi il resto. L'ordine è IMPOSTO (AgreementSectionOrder): non è struttura
               come l'ordine delle clausole, e lasciarlo a mano vorrebbe dire poter nascondere una partenza in
               fondo, lontano dai suoi arrivi. *@
            @foreach (var sec in sezioni)
            {
                @SectionBlock(ag, sec)

                @* Il reciproco che manca si vede come un blocco VUOTO, subito sotto. È la stessa regola dei due
                   versi sempre a vista di ferragosto: l'interruttore nascondeva ciò che mancava, e per questo il
                   reciproco non si scriveva mai. Vale solo dove un reciproco esiste davvero — un arrivo non ne
                   ha uno. *@
                @if (Mirrorable(sec.Kind) && sec.Clauses.Count > 0 && ReverseOf(ag, sec) is null)
                {
                    @MissingReverseBlock(ag, sec)
                }
            }
        </div>
    };

    /// <summary>
    /// Una sezione dell'accordo: intestazione, avvisi, tabella, e i suoi tasti.
    ///
    /// <para>⚠️ I tasti stanno <b>in testa</b> al blocco e non a piede. Il piede-che-tiene-i-tasti è la misura
    /// che è costata sei giri, e vale per <b>un</b> corpo che scorre: con più blocchi il piede del primo
    /// finirebbe a metà pagina, che è peggio del problema che risolveva.</para>
    /// </summary>
    private RenderFragment SectionBlock(AgreementRow ag, AgreementSectionRow sec) => __builder =>
    {
        var rows = RowsFor(ag, sec);
        var open = !_collapsedSections.Contains(sec.Id);
        var gemella = TwinOf(ag, sec);

        <section class="xt-dirblock @(_lens.IsOutbound(ag, sec) ? "xt-out" : "xt-in")">
            <div class="xt-dirhead">
                @* ⚠️ `aria-expanded="@bool"` NON funziona: Blazor lo tratta come attributo BOOLEANO HTML — con
                   `true` rende `aria-expanded=""`, che per ARIA non è un valore valido, e con `false` OMETTE
                   l'attributo, che per uno screen reader vuol dire «non espandibile» invece che «chiuso». Serve la
                   stringa. Visto ispezionando il DOM, non dai test; `StrutturaPage` lo faceva già giusto. *@
                <button type="button" class="xt-dirtoggle" aria-expanded="@open.ToString().ToLowerInvariant()"
                        @onclick="() => ToggleSection(sec.Id)">
                    <span class="xt-chev">@(open ? "▾" : "▸")</span>
                    <span class="xt-dirway">@XferLabels.Kind(L, sec.Kind)</span>
                    <span class="xt-dirpair">@DirectionPair(ag, sec)</span>
                </button>

                @* Il verso si CORREGGE da qui: alla creazione è una proposta (lo dice l'aeroporto), e una
                   proposta deve poter essere smentita in un gesto. *@
                @if (_canEdit)
                {
                    <button class="btn ghost xt-flip" disabled="@_busy" title="@L["Xfer_FlipDirectionTitle"]"
                            @onclick="() => FlipDirection(sec)">⇄</button>
                }

                @AirportChips(ag, sec)

                <span class="muted xt-hint">@XferLabels.Clauses(L, rows.Count)</span>
                <span class="ln xt-grow"></span>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)"
                        @onclick="() => OpenAddClause(ag, sec)">+ @L["Xfer_AddClause"]</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_PasteTitle"]"
                        @onclick="() => TogglePaste(sec)">⎘ @L["Xfer_Paste"]</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_SectionEditTitle"]"
                        @onclick="() => OpenEditSection(sec)">✎</button>
                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_SectionDeleteAria"]" Disabled="@(_busy || !_canEdit)"
                               Prompt="@(string.Format(L["Xfer_SectionDeletePrompt"].Value, sec.Clauses.Count))"
                               OnConfirm="() => DeleteSection(ag, sec)"><Trigger><Icon Name="x" /></Trigger></InlineConfirm>
            </div>

            @if (_editSectionId == sec.Id)
            {
                <div class="xt-subform">
                    @SectionFields(ag)
                    <div class="xt-foot">
                        <button class="btn primary" disabled="@(_busy || !_canEdit || !_sectionForm.Ready)" @onclick="() => SaveSection(sec)">💾 @L["Common_Save"]</button>
                        <button class="btn ghost" disabled="@_busy" @onclick="() => _editSectionId = null">@L["Common_Cancel"]</button>
                        @if (_canEdit && !_sectionForm.Ready) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                    </div>
                </div>
            }

            @if (open)
            {
                @* Gemelle: due sezioni che dicono la stessa cosa. È un AVVISO e non un errore (decisione del
                   18 agosto 2026): due arrivi a LIRF che valgono a condizioni diverse si scrivono con le
                   VARIANTI dentro una sezione sola, ma vietare la seconda non lo insegnerebbe a nessuno. *@
                @if (gemella is not null && sec.Order < gemella.Order)
                {
                    <div class="callout info xt-warn">
                        <span class="cic">⧉</span>
                        <div>@(string.Format(L["Xfer_TwinSections"].Value, gemella.Clauses.Count))</div>
                        @* ⚠️ L'etichetta di conferma va passata: il default di InlineConfirm è «Sì, elimina», e
                           qui non si elimina niente — si unisce. *@
                        <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_MergeAria"]" Disabled="@(_busy || !_canEdit)"
                                       Prompt="@(string.Format(L["Xfer_MergePrompt"].Value, gemella.Clauses.Count))"
                                       ConfirmLabel="@L["Xfer_MergeConfirm"]" CancelLabel="@L["Common_Cancel"]"
                                       OnConfirm="() => MergeSections(sec.Id, gemella.Id)"><Trigger>⧉ @L["Xfer_Merge"]</Trigger></InlineConfirm>
                    </div>
                }

                @* La proposta «l'avvicinamento dell'aeroporto» nasce dall'ICAO; qui la stessa conoscenza torna
                   come VERIFICA. ⚠️ Sta nel CORPO e non nella testata: là la riga porta già traffico, coppia,
                   freccia, scali, conteggio e quattro tasti, e una pill lunga mandava «Paste table ✎ ✕» a capo
                   sotto «+ Clause». Visto a schermo, su tre sezioni su otto. *@
                @foreach (var (icao, parent) in UncoveredAirports(ag, sec))
                {
                    <div class="callout xt-warn">
                        <span class="cic">⚠</span>
                        <div title="@L["Xfer_AptNotCoveredTitle"]">
                            @(string.Format(L["Xfer_AptNotCovered"].Value, icao, parent))
                        </div>
                    </div>
                }

                @* I punti che stanno da UN LATO SOLO fra due sezioni speculari. È la domanda che ha prodotto le
                   asimmetrie vere dell'archivio (BELIX di qua, OLGAT di là), e ora che le due sezioni stanno
                   nello stesso accordo si può porre qui invece che nel cruscotto — che è il posto dove si
                   cerca, non dove si scrive. *@
                @if (ReverseOf(ag, sec) is { } opposto && sec.Direction == AgreementDirection.AtoB)
                {
                    var spaiati = AgreementPoints.UnpairedBetween(sec, opposto);
                    @if (spaiati.Count > 0)
                    {
                        <div class="callout xt-warn">
                            <span class="cic">⚠</span>
                            <div>@(string.Format(L["Xfer_UnpairedPoints"].Value, string.Join(", ", spaiati)))</div>
                        </div>
                    }
                }

                @* Avviso NON bloccante: un gruppo di varianti senza «negli altri casi» lascia scoperti i casi che
                   nessuna condizione copre, e chi legge non sa che fare. Può essere legittimo (le condizioni
                   possono essere esaustive), quindi si segnala, non si impedisce. *@
                @foreach (var w in AlternativesWithoutNormalCase(sec))
                {
                    <div class="callout xt-warn">
                        <span class="cic">⚠</span>
                        <div>@(string.Format(L["Xfer_AltNoNormalCase"].Value, w))</div>
                    </div>
                }

                @if (rows.Count == 0)
                {
                    <p class="help xt-dirempty">@L["Xfer_NoClausesHere"]</p>
                }
                else
                {
                    @* Il trascinamento vale solo con l'ordinamento manuale: riordinare una vista ordinata per
                       punto scriverebbe un ordine che non è quello che si vede. Fra sezioni diverse il
                       repository lo rifiuta già, e i blocchi sono tabelle separate: il gesto non li attraversa. *@
                    @RowsTable(rows, showContext: false, canDrag: _sort == RowSort.Manual)
                }

                @if (_pasteSectionId == sec.Id) { @PasteForm(ag, sec) }
            }
        </section>
    };

    /// <summary>
    /// Il posto del reciproco che non c'è: un blocco vuoto col tasto per scriverlo.
    /// <para>Il vuoto <b>è</b> l'informazione. Nasconderlo rifarebbe il difetto dell'interruttore di ferragosto:
    /// in archivio i reciproci scritti erano zero, e nessuno se n'era accorto perché non si vedeva che
    /// mancavano.</para>
    /// </summary>
    private RenderFragment MissingReverseBlock(AgreementRow ag, AgreementSectionRow sec) => __builder =>
    {
        <section class="xt-dirblock xt-ghost">
            <div class="xt-dirhead">
                <span class="xt-dirway">@XferLabels.Kind(L, sec.Kind)</span>
                <span class="xt-dirpair">@ReversePair(ag, sec)</span>
                <span class="muted xt-hint">@L["Xfer_NoReciprocalYet"]</span>
                <span class="ln xt-grow"></span>
                @* Copiare è un PUNTO DI PARTENZA, non un «rendi bilaterale»: i livelli dei due versi sono quasi
                   sempre diversi, e indovinarli sarebbe scrivere un accordo che nessuno ha concordato. *@
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_CopyDirectionTitle"]"
                        @onclick="() => CopyToReverse(sec)">⇄ @L["Xfer_CopyDirection"]</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)"
                        @onclick="() => OpenNewReverseSection(ag, sec)">+ @L["Xfer_Section"]</button>
            </div>
        </section>
    };

    // ---- Gli aeroporti della sezione ----------------------------------------------------------------
    // Il gruppo di aeroporti è ciò che si mette a punto più spesso: «vale anche per Brindisi». Sta nella testata
    // della sezione perché è lì che si legge, e perché aprire un form di quattro campi per toccarne uno è il
    // costo che il giro di ferragosto aveva già tolto.

    private int? _aptOpenId;
    private string _aptText = "", _aptName = "";

    private void ToggleAptPicker(AgreementSectionRow s)
    {
        _aptOpenId = _aptOpenId == s.Id ? null : s.Id;
        _aptText = ""; _aptName = "";
    }

    /// <summary>Le chip degli aeroporti nella testata della sezione, col picker in linea.</summary>
    private RenderFragment AirportChips(AgreementRow ag, AgreementSectionRow sec) => __builder =>
    {
        var aperto = _aptOpenId == sec.Id;

        <span class="xt-hdr-apts">
            @foreach (var apt in sec.Airports.OrderBy(x => x.Order))
            {
                var icao = apt.Icao;
                <span class="pill neutral xt-apt" title="@apt.Name">@icao
                    @if (_canEdit)
                    {
                        <button type="button" class="xt-chipx" title="@L["Xfer_RemoveAirport"]" disabled="@_busy"
                                @onclick="() => RemoveAirportFrom(sec, icao)">✕</button>
                    }
                </span>
            }
            @* Per arrivi e partenze l'aeroporto è obbligatorio: se non c'è, la testata lo dice invece di
               lasciare un vuoto che sembra una scelta. *@
            @if (sec.Airports.Count == 0 && AirportRequiredKind(sec.Kind))
            {
                <span class="pill xt-warnpill" title="@L["Xfer_AirportRequired"]">⚠ @L["Xfer_NoAirport"]</span>
            }
            @* Il tasto compare dove gli aeroporti NON sono esclusi: tutto tranne i sorvoli, che attraversano e
               non atterrano. Offrirlo su un sorvolo sarebbe invitare a scrivere un dato che il modello rifiuta. *@
            @if (_canEdit && AirportsRelevant(sec.Kind, sec.Airports.Count))
            {
                <button class="btn ghost xt-aptadd" disabled="@_busy" title="@L["Xfer_AddAirportTitle"]"
                        @onclick="() => ToggleAptPicker(sec)">@(aperto ? "✕" : "+ " + L["Xfer_Airport"])</button>
            }
        </span>

        @if (aperto)
        {
            <span class="xt-aptpick">
                <TypeaheadPicker Placeholder="LIRF / LFPG" Items="AirportItems(_aptText)"
                                 @bind-Text="_aptText" NoMatch="@NewAptFooter(_aptText)" Footer="@NewAptFooter(_aptText)" />
                @if (!string.IsNullOrWhiteSpace(_aptText) && !IsKnownApt(_aptText))
                {
                    <input placeholder="@L["Xfer_AptNamePh"]" @bind="_aptName" title="@L["Xfer_AptNameTitle"]" />
                }
                <button class="btn primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_aptText))"
                        @onclick="() => AddAirportTo(sec)">+ @L["Xfer_AddAirport"]</button>
            </span>
        }

    };

    /// <summary>
    /// Gli aeroporti della sezione il cui <b>ente di copertura</b> non è chi riceve — quando la cosa è davvero
    /// sospetta.
    ///
    /// <para>Solo per gli <b>arrivi</b>: è il traffico che allo scalo ci arriva davvero. Per le partenze l'ente
    /// di copertura è chi CEDE, e la verifica direbbe il contrario di ciò che serve.</para>
    ///
    /// <para>⚠️ <b>E solo quando a ricevere è un ente di AEROPORTO</b> (APP o torre). Un'<b>area</b> che riceve
    /// arrivi e poi li gira all'avvicinamento è il caso <b>normale</b>, non un difetto: visto a schermo
    /// sull'accordo `LIBB ⇄ LGGG`, l'avviso scattava su <b>tre sezioni su otto</b> — LIBD, LIBG e LIBR verso
    /// `LIBB_ES_CTR</b> — e tutte e tre erano scritte bene. Una categoria che urla sempre non si guarda più:
    /// è già successo col cruscotto delle lacune, ed è la seconda volta che questa pagina lo impara.</para>
    ///
    /// <para>Il legame ICAO → ente sta sul nodo Aeroporto della struttura (<c>_airportParents</c>), non dedotto
    /// dal callsign — uno scalo può essere coperto da un ente con un altro prefisso.</para>
    /// </summary>
    private IEnumerable<(string Icao, string Parent)> UncoveredAirports(AgreementRow ag, AgreementSectionRow sec)
    {
        if (sec.Kind != TransferFlowKind.Arrival) yield break;

        var ricevente = ag.Receiver(sec.Direction);
        var tipo = _all.FirstOrDefault(x => x.Id == ricevente.SectorId)?.Type;
        if (tipo is not (SectorType.App or SectorType.Twr)) yield break;

        foreach (var apt in sec.Airports.OrderBy(x => x.Order))
            if (_airportParents.TryGetValue(apt.Icao, out var parent)
                && !string.Equals(parent, ricevente.Callsign, StringComparison.OrdinalIgnoreCase))
                yield return (apt.Icao, parent);
    }

    private Task AddAirportTo(AgreementSectionRow sec)
    {
        var icao = _aptText.Trim().ToUpperInvariant();
        if (icao.Length == 0) return Task.CompletedTask;
        if (sec.Airports.Any(x => string.Equals(x.Icao, icao, StringComparison.OrdinalIgnoreCase)))
        {
            _error = string.Format(L["Xfer_AptAlreadyThere"].Value, icao);
            return Task.CompletedTask;
        }

        var lista = sec.Airports.OrderBy(x => x.Order)
            .Select(x => new AgreementAirportInput(x.Icao, x.Name))
            .Append(new AgreementAirportInput(icao, NullIfBlank(_aptName)))
            .ToList();
        // Il picker si CHIUDE: a campo vuoto la tendina propone l'intero catalogo — cinquanta scali che
        // coprono la testata — e aggiungerne due di fila è raro quanto riaprirlo è economico.
        _aptOpenId = null; _aptText = ""; _aptName = "";
        return SaveAirports(sec, lista);
    }

    private Task RemoveAirportFrom(AgreementSectionRow sec, string icao)
    {
        var lista = sec.Airports.OrderBy(x => x.Order)
            .Where(x => !string.Equals(x.Icao, icao, StringComparison.OrdinalIgnoreCase))
            .Select(x => new AgreementAirportInput(x.Icao, x.Name))
            .ToList();
        return SaveAirports(sec, lista);
    }

    /// <summary>Riscrive il solo elenco aeroporti, lasciando il resto della sezione com'è. Passa dalla stessa
    /// porta di scrittura del form, quindi le regole valgono anche qui: togliere l'ultimo aeroporto a una
    /// sezione di arrivi <b>non passa</b>, e lo dice.</summary>
    private async Task SaveAirports(AgreementSectionRow sec, IReadOnlyList<AgreementAirportInput> airports)
    {
        await Guarded(() => Agreements.UpdateSectionAsync(_acc!.Code, sec.Id, new AgreementSectionInput
        {
            Kind = sec.Kind,
            Direction = sec.Direction,
            Description = sec.Description,
            Airports = airports,
        }), null);
        await LoadRunwaysAsync(FocusSection()?.Section);
    }

    /// <summary>
    /// Cambia il tipo di traffico della sezione.
    /// <para>⚠️ Passa dalla porta di scrittura come tutto il resto, quindi le regole valgono: passare ad
    /// <b>arrivi</b> o <b>partenze</b> una sezione senza aeroporti <b>non va a buon fine</b>, e lo dice.</para>
    /// </summary>
    private int _kindEpoch;

    private Task ChangeKind(AgreementSectionRow sec, ChangeEventArgs e)
    {
        if (!Enum.TryParse<TransferFlowKind>(e.Value?.ToString(), out var kind) || kind == sec.Kind)
            return Task.CompletedTask;

        // L'epoca avanza a ogni tentativo, riuscito o no: è ciò che fa ricreare la tendina e riallinearla al
        // tipo davvero salvato. Un <select> il cui valore memorizzato non cambia dopo un rifiuto non viene
        // riscritto da Blazor, e resta sulla scelta rifiutata — mentendo.
        _kindEpoch++;
        return Guarded(() => Agreements.UpdateSectionAsync(_acc!.Code, sec.Id, new AgreementSectionInput
        {
            Kind = kind,
            Direction = sec.Direction,
            Description = sec.Description,
            Airports = sec.Airports.OrderBy(x => x.Order)
                .Select(x => new AgreementAirportInput(x.Icao, x.Name)).ToList(),
        }), null);
    }

    /// <summary>Ribalta il verso della sezione: la proposta dell'aeroporto è una proposta, e va potuta
    /// smentire in un gesto.</summary>
    private Task FlipDirection(AgreementSectionRow sec) =>
        Guarded(() => Agreements.UpdateSectionAsync(_acc!.Code, sec.Id, new AgreementSectionInput
        {
            Kind = sec.Kind,
            Direction = SectionDirection.Flip(sec.Direction),
            Description = sec.Description,
            Airports = sec.Airports.OrderBy(x => x.Order)
                .Select(x => new AgreementAirportInput(x.Icao, x.Name)).ToList(),
        }), null);

    /// <summary>La sezione gemella: stesso traffico, stesso verso, stessi scali. Null se non ce n'è.</summary>
    private static AgreementSectionRow? TwinOf(AgreementRow a, AgreementSectionRow s) =>
        a.Sections.FirstOrDefault(x => x.Id != s.Id && x.Kind == s.Kind && x.Direction == s.Direction
                                       && string.Equals(x.AirportsLabel, s.AirportsLabel, StringComparison.OrdinalIgnoreCase));

    private void ToggleSection(int sectionId)
    {
        if (!_collapsedSections.Remove(sectionId)) _collapsedSections.Add(sectionId);
    }

    /// <summary>«da → a» coi callsign veri del verso della sezione. «A→B» non direbbe niente a nessuno.</summary>
    private static string DirectionPair(AgreementRow a, AgreementSectionRow s) =>
        $"{a.Sender(s.Direction).Callsign} → {a.Receiver(s.Direction).Callsign}";

    /// <summary>La coppia del verso OPPOSTO: è quella del reciproco che manca.</summary>
    private static string ReversePair(AgreementRow a, AgreementSectionRow s) =>
        $"{a.Receiver(s.Direction).Callsign} → {a.Sender(s.Direction).Callsign}";

    // ---- Incolla-tabella ----------------------------------------------------------------------------
    // Riempire l'Italia a mano significa ridigitare tabelle che esistono gia', scritte da qualcun altro, in un
    // PDF. Qui si incollano e si guardano PRIMA di salvare: un incolla che salvasse direttamente metterebbe in
    // archivio la propria interpretazione di un testo che nessuno ha riletto.

    /// <summary>La sezione in cui si sta incollando; null = nessun incolla aperto. È la SEZIONE e non
    /// l'accordo: si incolla in una tabella, e quale sia lo dice il blocco in cui si è premuto — non uno stato
    /// di pagina, che si ricorderebbe l'ultima invece della presente.</summary>
    private int? _pasteSectionId;
    private string _pasteText = "";

    private void TogglePaste(AgreementSectionRow sec)
    {
        ClosePanel();
        _pasteSectionId = _pasteSectionId == sec.Id ? null : sec.Id;
        _pasteText = "";
    }

    private RenderFragment PasteForm(AgreementRow a, AgreementSectionRow sec) => __builder =>
    {
        var parsed = ClausePaste.Parse(_pasteText);
        var buone = parsed.Count(p => p.Ok);
        var riceventi = ClausePaste.DistinctReceivers(parsed);

        <div class="xt-subform">
            <div class="field">
                <label>@L["Xfer_PasteLabel"] <span class="muted xt-lbl-soft">@L["Xfer_PasteHint"]</span></label>
                <textarea rows="6" placeholder="@L["Xfer_PastePh"]" @bind="_pasteText" @bind:event="oninput"></textarea>
            </div>

            @if (parsed.Count > 0)
            {
                @* L'anteprima mostra il livello RESO, non quello scritto: LevelFormatting.Parse non fallisce
                   mai — cio' che non e' un livello diventa il livello «speciale» — quindi l'unico modo di
                   accorgersi che una colonna e' finita nel posto sbagliato e' vedere come e' stata capita. *@
                <table class="res-table">
                    <thead><tr><th>#</th><th>@L["Xfer_ColPoints"]</th><th>@L["Xfer_ColLevel"]</th><th>@L["Xfer_ColReceiver"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in parsed)
                        {
                            <tr class="@(p.Ok ? null : "xt-sel")">
                                <td class="muted">@p.Line</td>
                                @if (p.Ok)
                                {
                                    <td><b>@p.Clause!.Cops</b></td>
                                    <td>@LevelFormatting.Format(p.Clause!.LevelValue, p.Clause!.LevelUnit,
                                            p.Clause!.LevelConstraint, p.Clause!.LevelSpecial, p.Clause!.Parity,
                                            p.Clause!.VerticalState)</td>
                                    <td class="muted">@(p.Receiver ?? "—")</td>
                                    <td class="muted">@p.Clause!.ConditionCustomLabel</td>
                                }
                                else
                                {
                                    <td colspan="4" class="muted">@p.Raw — <b>@p.Error</b></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                @* Righe con riceventi diversi sono ACCORDI diversi: dirlo prima di scrivere e' l'unico modo di
                   non ricreare il difetto che il modello nuovo ha appena chiuso. *@
                @if (riceventi.Count > 1)
                {
                    <div class="callout warning">
                        <span class="cic">⚠</span>
                        <div>@(string.Format(L["Xfer_PasteManyReceivers"].Value, string.Join(", ", riceventi)))</div>
                    </div>
                }
                else if (riceventi.Count == 1 && !string.Equals(riceventi[0], a.Receiver(sec.Direction).Callsign,
                             StringComparison.OrdinalIgnoreCase))
                {
                    <div class="callout info">
                        <span class="cic">ℹ</span>
                        <div>@(string.Format(L["Xfer_PasteOtherReceiver"].Value, riceventi[0]))</div>
                    </div>
                }
            }

            <div class="xt-foot">
                <button class="btn primary" disabled="@(_busy || !_canEdit || buone == 0)"
                        @onclick="() => ConfirmPaste(sec)">@(string.Format(L["Xfer_PasteImport"].Value, buone))</button>
                <button class="btn ghost" disabled="@_busy" @onclick="() => _pasteSectionId = null">@L["Common_Cancel"]</button>
            </div>
        </div>
    };

    /// <summary>Scrive le clausole lette, in coda alla SEZIONE in cui si è incollato. Il ricevente scritto sulle
    /// righe NON si applica: è il capo opposto dell'accordo, e cambiarlo da qui cambierebbe l'accordo intero
    /// senza dirlo.</summary>
    private async Task ConfirmPaste(AgreementSectionRow sec)
    {
        var parsed = ClausePaste.Parse(_pasteText).Where(p => p.Ok).ToList();
        if (parsed.Count == 0) return;

        await Guarded(async () =>
        {
            foreach (var p in parsed)
                await Agreements.AddClauseAsync(_acc!.Code, sec.Id, p.Clause!);
            _pasteSectionId = null;
            _pasteText = "";
        }, string.Format(L["Xfer_PasteDone"].Value, parsed.Count));
    }

    /// <summary>I campi dell'accordo: i due capi e una nota. Nient'altro — il traffico sta nelle sezioni.</summary>
    private RenderFragment PairFields(PairForm form) => __builder =>
    {
        <div class="inline-form xt-flat">
            @SidePicker(form, near: true)
            @SidePicker(form, near: false)
            <div class="field"><label>@L["Xfer_NoteOpt"]</label>
                <input placeholder="@L["Xfer_NotePh"]" @bind="form.Note" @bind:event="oninput" />
            </div>
        </div>
    };

    /// <summary>Un capo dell'accordo: la chip dell'ente scelto più il picker per cambiarlo.</summary>
    private RenderFragment SidePicker(PairForm form, bool near) => __builder =>
    {
        var current = near ? form.SideA : form.SideB;
        var text = near ? form.SideAText : form.SideBText;

        <div class="field">
            @* ⚠️ Nessuno dei due capi è opzionale, e l'etichetta «(vuoto = UNICOM)» che stava qui insegnava il
               contrario: UNICOM lo calcola la vista operativa quando il ricevente è offline, non si scrive.
               Adesso è anche di schema — due colonne NOT NULL. *@
            <label>
                @(near ? L["Xfer_SideNear"] : L["Xfer_SideFar"])
                <span class="xt-req" title="@L["Xfer_SideRequiredTitle"]">*</span>
            </label>
            <div class="xt-chips">
                @if (current.Length > 0)
                {
                    <span class="pill neutral">@current
                        <button type="button" class="xt-chipx" title="@L["Xfer_RemoveParty"]"
                                @onclick="() => SetSide(form, near, string.Empty)">✕</button>
                    </span>
                }
                else { <span class="muted">—</span> }
            </div>
            <TypeaheadPicker Placeholder="@L["Xfer_SearchCallsign"]"
                             Items="@(near ? SectorItems(text) : CounterpartItems(form, text))"
                             Text="@text"
                             TextChanged="t => { if (near) form.SideAText = t; else form.SideBText = t; }"
                             OnPick="i => SetSide(form, near, i?.Value)" />
        </div>
    };

    private void SetSide(PairForm form, bool near, string? callsign)
    {
        var cs = (callsign ?? "").Trim();
        // Un solo ente per capo: sceglierne un altro SOSTITUISCE, non aggiunge. È la decisione del 18 agosto
        // 2026 — la forma «TS EXE cede a PS EXE / PN EXE» si scrive come due accordi.
        if (near) { form.SideA = cs; form.SideAText = ""; }
        else { form.SideB = cs; form.SideBText = ""; }
    }

    /// <summary>I campi di una sezione: il traffico, il verso, gli aeroporti, la prosa. Uno solo per creazione e
    /// modifica — due markup paralleli sono due occasioni di aggiornarne uno solo.</summary>
    private RenderFragment SectionFields(AgreementRow ag) => __builder =>
    {
        var form = _sectionForm;

        @* ⚠️ Griglia, non flex. In flex con `align-items:flex-end` il campo degli aeroporti — alto tre righe:
           etichetta, chip, comandi — teneva in riga la descrizione, che è un input solo: sopra la descrizione
           restava un buco alto quanto due righe, e il form sembrava rotto. Qui le righe sono dichiarate:
           traffico e verso a misura, descrizione per il resto, aeroporti sotto per tutta la larghezza. *@
        <div class="inline-form xt-flat xt-secform">
            <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                <select value="@form.Kind" @onchange="e => PickSectionKind(ag, e)">
                    <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                    <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                    <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                    <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                    <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                </select>
            </div>

            @* Il verso: PROPOSTO dall'aeroporto (chi non ha lo scalo cede a chi ce l'ha) e correggibile con un
               clic. Non si ricalcola a ogni lettura — l'AoR cambia, l'accordo scritto no — si salva.
               ⚠️ Il CHIP È IL COMANDO: ci si clicca sopra e si inverte. Prima il verso era un'etichetta con un
               tasto ⇄ accanto — due elementi per una cosa sola, e il bersaglio del gesto era il più piccolo dei
               due. Qui si preme ciò che si sta leggendo. *@
            <div class="field xt-dirfield"><label>@L["Xfer_Direction"]</label>
                <button type="button" class="pill blue xt-dirchip" title="@L["Xfer_FlipDirectionTitle"]"
                        @onclick="() => form.Direction = SectionDirection.Flip(form.Direction)">
                    @DirectionPairOf(ag, form.Direction)<span class="xt-dirchip-x">⇄</span>
                </button>
            </div>

            @* Aeroporti: un elenco, non un campo. È l'asse che il modello di luglio costringeva a moltiplicare —
               quattro flussi identici per quattro scali di Roma — e i documenti veri lo scrivono già così.
               ⚠️ Compare dove NON è escluso: tutto tranne i sorvoli. E se degli aeroporti ci sono già resta a
               vista anche col tipo cambiato — un campo nascosto che tiene dati è il modo più rapido di perderli. *@
            @if (AirportsRelevant(form.Kind, form.Airports.Count))
            {
            <div class="field xt-f-apts">
                <label>@L["Xfer_AirportsLabel"] <span class="muted xt-lbl-soft">@L["Xfer_AirportsHint"]</span></label>
                @* Chip e comandi d'aggiunta sulla STESSA riga: erano due blocchi impilati, e la seconda riga
                   esisteva solo perché erano due elementi diversi — non perché lo spazio mancasse. *@
                <div class="xt-aptline">
                    @foreach (var apt in form.Airports.ToList())
                    {
                        <span class="pill neutral">@apt.Icao@(string.IsNullOrWhiteSpace(apt.Name) ? "" : $" · {apt.Name}")
                            <button type="button" class="xt-chipx" title="@L["Xfer_RemoveAirport"]"
                                    @onclick="() => form.Airports.Remove(apt)">✕</button>
                        </span>
                    }
                    @if (form.Airports.Count == 0) { <span class="muted">—</span> }
                    <span class="xt-barsep"></span>
                    @* ⚠️ Largo quanto un ICAO e non di più: il picker eredita `min-width:150px; flex:1` dal
                       campo dell'inline-form, e con quello Direction non stava più in riga. Il segnaposto
                       scende a un ICAO solo per la stessa ragione — «LIRF / LFPG» non ci entrerebbe. *@
                    <TypeaheadPicker Class="xt-aptpick-narrow" Placeholder="LIRF"
                                     Items="AirportItems(form.AirportText)"
                                     @bind-Text="form.AirportText" NoMatch="@NewAptFooter(form.AirportText)"
                                     Footer="@NewAptFooter(form.AirportText)" />
                    @if (!string.IsNullOrWhiteSpace(form.AirportText) && !IsKnownApt(form.AirportText))
                    {
                        <input placeholder="@L["Xfer_AptNamePh"]" @bind="form.AirportName" title="@L["Xfer_AptNameTitle"]" />
                        <button type="button" class="btn ghost xt-nowrap" disabled="@_busy"
                                @onclick="LookupApt" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                    }
                    <button type="button" class="btn ghost" disabled="@(string.IsNullOrWhiteSpace(form.AirportText))"
                            @onclick="() => AddAirportToForm(ag)">+ @L["Xfer_AddAirport"]</button>
                </div>
                @* Gli aeroporti restati addosso a un tipo che non li vuole: si dicono, non si cancellano da soli. *@
                @if (form.Airports.Count > 0 && form.Kind == TransferFlowKind.Overflight)
                {
                    <span class="muted xt-hint">@L["Xfer_AirportsNotForKind"]</span>
                }
            </div>
            }

            <div class="field"><label>@L["Xfer_DescOpt"]</label>
                <input placeholder="@L["Xfer_DescPh"]" @bind="form.Description" @bind:event="oninput" />
            </div>
        </div>
    };

    /// <summary>La tabella delle clausole. Un solo punto di chiamata per vista, e gli stessi agganci: se un
    /// giorno una delle due smette di reagire a un gesto, si vede qui e non in due markup paralleli.</summary>
    private RenderFragment RowsTable(IReadOnlyList<XferTableRow> rows, bool showContext, bool canDrag) => __builder =>
    {
        <XferRowsTable Rows="rows" ShowContext="showContext" CanDrag="canDrag"
                       SortColumn="@_sort.ToString()" SortDescending="_sortDesc"
                       OnSort="c => SortBy(Enum.Parse<RowSort>(c))"
                       Selected="_selected" EditClauseId="_editClauseId"
                       Disabled="@(_busy || !_canEdit)" DragId="_dragId" DragOverId="_dragOver"
                       EditingCell="_cellEdit" CellEditor="@(_canEdit ? CellEditor : null)" OnCellClick="OpenCell"
                       OnEdit="OnEditRow" OnGoToAgreement="GoToAgreement"
                       OnAddAlternative="AddAlternative" OnAddException="AddException"
                       OnToggleSelect="ToggleSelect"
                       OnDragStart="id => _dragId = id" OnDragOver="id => _dragOver = id" OnDrop="DropOn" />
    };

    /// <summary>Il campo dentro la cella. Entrambe le celle sono testo libero — il livello lo è per davvero,
    /// «per aerovia» compreso, e i punti sono un elenco separato da virgole.</summary>
    private RenderFragment<XferCellRef> CellEditor => cell => __builder =>
    {
        // L'epoca si cattura QUI, al render: il gestore di sfocamento che ne nasce vale per QUESTA apertura di
        // cella e per nessun'altra. Senza, il salvataggio da Invio (che apre subito la cella dopo) veniva
        // seguito dallo sfocamento della cella vecchia, che scriveva il testo vecchio nella cella nuova.
        var epoch = _cellEpoch;
        @* size, e non solo la larghezza in CSS: in una tabella a colonne automatiche un <input> porta la propria
           larghezza INTRINSECA (venti caratteri), e width:100% non la riduce — la colonna si allargava di un
           centinaio di pixel all'apertura e le altre scivolavano di lato. *@
        <input class="xt-celledit" @ref="_cellInput" @bind="_cellText" @bind:event="oninput"
               size="@(cell.Cell == XferCell.Points ? 16 : 8)"
               placeholder="@CellPlaceholder(cell.Cell)" disabled="@_busy"
               @onkeydown="e => CellKey(e, epoch)" @onblur="() => CommitCell(epoch)" />
    };

    // ---- Colonna 3: il pannello della clausola ------------------------------------------------------

    /// <summary>
    /// Il pannello di destra: è l'unico posto dove si scrive una clausola <b>per intero</b>. Vuoto mostra cosa
    /// fare, come il pannello dettaglio di Struttura — una colonna che non dice niente sembra rotta.
    /// </summary>
    private RenderFragment ClausePanel() => __builder =>
    {
        var form = _clauseForm;
        var ag = CurrentAgreement();
        var sec = CurrentSection();

        if (form is null || ag is null || sec is null)
        {
            <div class="xt-panel-empty">
                <p class="ct">@L["Xfer_PanelEmptyTitle"]</p>
                <p class="muted">@L["Xfer_PanelEmptyBody"]</p>
            </div>
            return;
        }

        var editing = _editClauseId is not null;

        @* Testata · corpo · piede. Il corpo è l'unica parte che scorre: le azioni stavano in fondo a 1426 px di
           contenuto in 904 disponibili, e il Salva non compariva in NESSUNA posizione di scorrimento della
           pagina. Misurato a schermo, non stimato. *@
        <div class="xt-panel-h">
            <b>@(editing ? L["Xfer_PanelEdit"] : L["Xfer_PanelNew"])</b>
            <span class="muted">@SenderOf(ag, sec) → @ReceiverOf(ag, sec) · @XferLabels.Section(L, sec)</span>
            @* L'avviso vive dove vivono le modifiche: in cima alla pagina stava a migliaia di pixel da qui. *@
            @if (HasOpenEdit) { <span class="pill xt-elsepill" title="@L["Xfer_UnsavedBody"]">✎ @L["Xfer_UnsavedTitle"]</span> }
            <button class="btn ghost xt-panel-x" title="@L["Common_Cancel"]" @onclick="ClosePanel">✕</button>
        </div>

        <div class="xt-panel-body">

        @* --- Identità: dove entra il traffico ---
           Il RICEVENTE non è più qui. Era il campo che ogni riga ripeteva e che il salvataggio doveva propagare
           alle sorelle per non lasciarle contraddirsi: adesso è il lato B dell'accordo, e l'invariante non può
           più rompersi perché non c'è più niente da tenere d'accordo. *@
        <div class="xt-grp"><span>@L["Xfer_GrpIdentity"]</span></div>
        <div class="field">
            <label>@L["Xfer_ColPoints"] <span class="muted xt-hint">@L["Xfer_CopListHint"]</span></label>
            <input placeholder="VALMA / VALMA, ELB, TOP" @bind="form.Points" @bind:event="oninput"
                   @onkeydown="PanelKey" />
        </div>

        @* --- Livello autorizzato --- *@
        @PanelSection("level", L["Xfer_GrpCleared"], LevelSummary(form))
        @if (SectionOpen("level"))
        {
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Constraint"]</label>
                <select @bind="form.Constraint">
                    <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                    <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                    <option value="@LevelConstraint.Exact">@L["Xfer_Exact"]</option>
                    <option value="@LevelConstraint.Special">@L["Xfer_Special"]</option>
                </select>
            </div>
            @if (form.Constraint == LevelConstraint.Special)
            {
                <div class="field"><label>@L["Xfer_LevelText"]</label>
                    <input placeholder="@L["Xfer_PerAirway"]" @bind="form.Special" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
            }
            else
            {
                <div class="field"><label>@L["Xfer_Value"]</label>
                    <input type="number" @bind="form.Value" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
                <div class="field"><label>@L["Xfer_Unit"]</label>
                    <select @bind="form.Unit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                </div>
            }
        </div>
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Levels"] <span class="muted xt-hint">@L["Xfer_SemicircHint"]</span></label>
                <select @bind="form.Parity">
                    <option value="@LevelParity.Any">@L["Xfer_ParityAny"]</option>
                    <option value="@LevelParity.Even">@L["Xfer_ParityEven"]</option>
                    <option value="@LevelParity.Odd">@L["Xfer_ParityOdd"]</option>
                </select>
            </div>
            <div class="field"><label>@L["Xfer_VState"]</label>
                <select @bind="form.VState">
                    <option value="@TransferVerticalState.Unspecified">@L["Xfer_VStateNone"]</option>
                    <option value="@TransferVerticalState.Level">@L["Xfer_VStateLevel"]</option>
                    <option value="@TransferVerticalState.Descending">↓ @L["Xfer_VStateDescending"]</option>
                    <option value="@TransferVerticalState.Climbing">↑ @L["Xfer_VStateClimbing"]</option>
                </select>
            </div>
        </div>
        }

        @* --- Faccetta trasferimento --- *@
        @PanelSection("handoff", L["Xfer_GrpHandoff"], FacetSummaryOf(form))
        @if (SectionOpen("handoff"))
        {
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_HandoffWhere"]</label>
                <select @bind="form.Facet.Kind">
                    <option value="@TransferHandoffKind.Unspecified">@L["Xfer_HandoffSameAsEntry"]</option>
                    <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                    <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                    <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                </select>
            </div>
            @if (form.Facet.Kind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
            {
                <div class="field"><label>@L["Xfer_HandoffLabel"]</label>
                    <input placeholder="CHI / 20 NM da AVN" @bind="form.Facet.Label" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
            }
        </div>
        @if (form.Facet.Kind != TransferHandoffKind.Unspecified)
        {
            <div class="xt-row2">
                <div class="field"><label>@L["Xfer_HandoffLevel"]</label>
                    <input type="number" @bind="form.Facet.LevelValue" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
                <div class="field"><label>@L["Xfer_Unit"]</label>
                    <select @bind="form.Facet.LevelUnit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                </div>
                <div class="field"><label>@L["Xfer_Constraint"]</label>
                    <select @bind="form.Facet.LevelConstraint">
                        <option value="@LevelConstraint.Exact">@L["Xfer_HandoffPassing"]</option>
                        <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                        <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                    </select>
                </div>
            </div>
            <div class="xt-row2">
                <div class="field"><label>@L["Xfer_CommsWhere"]</label>
                    <select @bind="form.Facet.CommsKind">
                        <option value="@TransferHandoffKind.Unspecified">@L["Xfer_CommsSameAsControl"]</option>
                        <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                        <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                        <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                    </select>
                </div>
                @if (form.Facet.CommsKind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
                {
                    <div class="field"><label>@L["Xfer_HandoffLabel"]</label>
                        <input @bind="form.Facet.CommsLabel" @bind:event="oninput" @onkeydown="PanelKey" />
                    </div>
                }
            </div>
        }
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Speed"]</label>
                <select @bind="form.Facet.SpeedConstraint">
                    <option value="@SpeedConstraint.Unspecified">@L["Xfer_SpeedNone"]</option>
                    <option value="@SpeedConstraint.AtOrBelow">≤</option>
                    <option value="@SpeedConstraint.AtOrAbove">≥</option>
                    <option value="@SpeedConstraint.Exact">=</option>
                </select>
            </div>
            @if (form.Facet.SpeedConstraint != SpeedConstraint.Unspecified)
            {
                <div class="field"><label>@L["Xfer_SpeedKt"]</label>
                    <input type="number" @bind="form.Facet.SpeedValue" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
            }
        </div>
        }

        @* --- Condizione operativa --- *@
        @PanelSection("condition", L["Xfer_GrpCondition"], ConditionSummary(form))
        @if (SectionOpen("condition"))
        {
        <div class="field">
            <label>@L["Xfer_CondRunway"] @if (_condRunways.Count == 0) { <span class="muted xt-hint">@L["Xfer_NoRunways"]</span> }</label>
            <select multiple size="4" @onchange="e => PickRunways(form, e)">
                @foreach (var r in _condRunways)
                {
                    <option value="@r.Label" selected="@form.Rwys.Contains(r.Label)">@r.Label</option>
                }
            </select>
        </div>
        <TypeaheadPicker Label="@L["Xfer_CondArea"]" Placeholder="@L["Xfer_SearchArea"]"
                         Items="AreaItems(form.AreaText)" EmptyOption="@L["Xfer_AreaNone"]" NoMatch="@L["Xfer_NoArea"]"
                         Text="@form.AreaText" TextChanged="t => { form.AreaText = t; ResolveArea(form); }"
                         OnPick="i => PickArea(form, i?.Value)" OnUnhandledKey="PanelKey" />
        <div class="field"><label>@L["Xfer_CondCustom"]</label>
            <input placeholder="@L["Xfer_CondCustomPh"]" @bind="form.CustomLabel" @bind:event="oninput" @onkeydown="PanelKey" />
        </div>
        @if (InGroup())
        {
            <label class="muted xt-check" title="@L["Xfer_GroupWideTitle"]">
                <input type="checkbox" checked="@form.Facet.IsGroupWide"
                       @onchange="e => form.Facet.IsGroupWide = (bool)(e.Value ?? false)" /> @L["Xfer_GroupWide"]
            </label>
        }
        }

        @* --- Anteprima --- *@
        @if (_preview is not null)
        {
            <div class="xt-grp"><span>@L["Xfer_Preview"]</span></div>
            <p class="xt-prev">“@(PreviewForm(ag, sec, form) ?? L["Xfer_PreviewIncomplete"].Value)”</p>
        }

        </div>

        @* Il PIEDE: tutto ciò che si deve raggiungere sta fuori dal corpo che scorre. Nel corpo restano i dati,
           che si leggono; chi non lo sa scorre la pagina all'infinito e i tasti non compaiono mai — è stato
           segnalato due volte, con misure diverse. *@
        <div class="xt-panel-f">
            <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SavePanel">💾 @L["Common_Save"]</button>
            @if (editing)
            {
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_MoveUp"]" @onclick="() => MoveClause(true)">↑</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_MoveDown"]" @onclick="() => MoveClause(false)">↓</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DuplicateGroupTitle"]" @onclick="DuplicateGroup">⧉</button>
                @if (InGroup())
                {
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DetachTitle"]" @onclick="DetachVariant">⇤</button>
                }
                <span class="ln xt-grow"></span>
                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteRowAria"]" Disabled="@(_busy || !_canEdit)"
                               Prompt="@L["Xfer_DeleteRowPrompt"]" OnConfirm="DeleteClause"><Trigger><Icon Name="x" /></Trigger></InlineConfirm>
            }
        </div>
    };

    // ---- Sezioni collassabili del pannello ----------------------------------------------------------
    // Richiuse solo se VUOTE, e col riassunto accanto al titolo: nascondere un dato senza dirlo è peggio di una
    // scheda lunga.
    private readonly HashSet<string> _closedSections = new(StringComparer.Ordinal);

    private bool SectionOpen(string key) => !_closedSections.Contains(key);

    private RenderFragment PanelSection(string key, string title, string summary) => __builder =>
    {
        var open = SectionOpen(key);
        <div class="xt-grp xt-clickable" role="button" tabindex="0" aria-expanded="@open.ToString().ToLowerInvariant()"
             @onclick="() => ToggleSection(key)"
             @onkeydown="e => SectionKey(e, key)">
            <span>@title</span>
            @if (!open && summary.Length > 0) { <span class="muted xt-hint">@summary</span> }
            <span class="xt-chev">@(open ? "▾" : "▸")</span>
        </div>
    };

    /// <summary>Invio/Spazio sull'intestazione di sezione: senza, si apre solo col mouse.</summary>
    private void SectionKey(KeyboardEventArgs e, string key)
    {
        if (e.Key is "Enter" or " " or "Spacebar") ToggleSection(key);
    }

    private void ToggleSection(string key)
    {
        if (!_closedSections.Remove(key)) _closedSections.Add(key);
    }

    private void ResetPanelSections(ClauseForm form)
    {
        _closedSections.Clear();
        if (FacetSummaryOf(form).Length == 0) _closedSections.Add("handoff");
        if (ConditionSummary(form).Length == 0) _closedSections.Add("condition");
    }

    private string LevelSummary(ClauseForm f) =>
        LevelFormatting.Format(f.Constraint == LevelConstraint.Special ? null : f.Value, f.Unit, f.Constraint,
                               f.Special, f.Parity, f.VState);

    private string FacetSummaryOf(ClauseForm f)
    {
        var parts = new List<string>(3);
        if (f.Facet.Kind != TransferHandoffKind.Unspecified)
            parts.Add(LevelFormatting.FormatHandoffLevel(f.Facet.LevelValue, f.Facet.LevelUnit, f.Facet.LevelConstraint) is { Length: > 0 } lv
                ? lv : L["Xfer_HandoffSet"].Value);
        var speed = LevelFormatting.FormatSpeed(f.Facet.SpeedValue, f.Facet.SpeedConstraint);
        if (speed.Length > 0) parts.Add(speed);
        return string.Join(" · ", parts);
    }

    private static string ConditionSummary(ClauseForm f) =>
        TransferConditionText.Display(
            f.Rwys.Length == 0 ? null : string.Join(" / ", f.Rwys),
            string.IsNullOrWhiteSpace(f.AreaLabel) ? null : f.AreaLabel,
            string.IsNullOrWhiteSpace(f.CustomLabel) ? null : f.CustomLabel) ?? "";

    private string FacetSummary(AgreementClauseRow c)
    {
        var parts = new List<string>(3);
        var place = TransferHandoffText.Place(_preview?.Template ?? CoordinationSentenceTemplate.Default,
                                              c.HandoffKind, c.HandoffLabel);
        if (place.Length > 0) parts.Add(place);
        if (c.HandoffLevelText.Length > 0) parts.Add(c.HandoffLevelText);
        if (c.SpeedText.Length > 0) parts.Add(c.SpeedText);
        return string.Join(" · ", parts);
    }

    // ---- Anteprima ----------------------------------------------------------------------------------

    private string? PreviewOf(AgreementRow a, AgreementSectionRow s, AgreementClauseRow c) =>
        _preview is null ? null : AgreementPreview.Compose(_preview, a, s, c);

    /// <summary>L'anteprima di ciò che si sta scrivendo <b>adesso</b>: la clausola del form, non quella salvata.
    /// Si costruisce una clausola finta e la si passa allo stesso composer del documento — un'anteprima che si
    /// compone da sé è l'anteprima che prima o poi mente.</summary>
    private string? PreviewForm(AgreementRow a, AgreementSectionRow sec, ClauseForm form)
    {
        if (_preview is null) return null;
        var draft = ToClauseInput(form);
        var fake = new AgreementClauseRow
        {
            Id = _editClauseId ?? 0,
            SectionId = sec.Id,
            Cops = draft.Cops,
            LevelValue = draft.LevelValue, LevelUnit = draft.LevelUnit, LevelConstraint = draft.LevelConstraint,
            LevelSpecial = draft.LevelSpecial, Parity = draft.Parity, VerticalState = draft.VerticalState,
            ConditionLabel = draft.ConditionLabel, ConditionAreaLabel = draft.ConditionAreaLabel,
            ConditionCustomLabel = draft.ConditionCustomLabel,
            HandoffKind = draft.HandoffKind, HandoffLabel = draft.HandoffLabel,
            HandoffLevelValue = draft.HandoffLevelValue, HandoffLevelUnit = draft.HandoffLevelUnit,
            HandoffLevelConstraint = draft.HandoffLevelConstraint,
            CommsHandoffKind = draft.CommsHandoffKind, CommsHandoffLabel = draft.CommsHandoffLabel,
            SpeedValue = draft.SpeedValue, SpeedConstraint = draft.SpeedConstraint,
            IsGroupWide = draft.IsGroupWide,
            // La catena delle condizioni si legge sull'outline SALVATO: la clausola in scrittura sta dove sta,
            // e la sua profondità non cambia mentre si digita.
            VariantGroup = CurrentClause()?.VariantGroup,
            VariantDepth = CurrentClause()?.VariantDepth ?? 0,
            Order = CurrentClause()?.Order ?? int.MaxValue,
        };

        // La clausola finta prende il posto di quella salvata dentro la SEZIONE, così la risalita dell'outline
        // trova gli stessi antenati che troverà il documento.
        var clauses = sec.Clauses.Where(x => x.Id != fake.Id).Append(fake).OrderBy(x => x.Order).ToList();
        return AgreementPreview.Compose(_preview, a, sec with { Clauses = clauses }, fake);
    }

    // ---- Scrittura in cella -------------------------------------------------------------------------

    private XferCellRef? _cellEdit;
    private string _cellText = "";
    private int _cellEpoch;
    private ElementReference _cellInput;
    private bool _focusCell;

    private string CellPlaceholder(XferCell cell) => cell switch
    {
        XferCell.Points => "VALMA, ELB",
        _ => "FL130-",
    };

    private void OpenCell(XferCellRef cell)
    {
        var c = FindClause(cell.ClauseId);
        if (c is null) return;
        _cellEdit = cell;
        _cellText = XferRowsTable.Display(c, cell.Cell);
        _cellEpoch++;
        _focusCell = true;
    }

    private void CancelCell(int epoch)
    {
        if (epoch != _cellEpoch) return;
        _cellEdit = null;
        _cellEpoch++;
    }

    private async Task CellKey(KeyboardEventArgs e, int epoch)
    {
        if (e.Key == "Escape") { CancelCell(epoch); return; }
        if (e.Key is not ("Enter" or "Tab")) return;
        await CommitCell(epoch);
    }

    private async Task CommitCell(int epoch)
    {
        if (epoch != _cellEpoch || _cellEdit is not { } cell) return;
        _cellEpoch++;
        var c = FindClause(cell.ClauseId);
        _cellEdit = null;
        if (c is null) return;

        var input = CellInput(c, cell.Cell, _cellText);
        if (input is null) return;
        await Guarded(() => Agreements.UpdateClauseAsync(_acc!.Code, c.Id, input), null);
    }

    /// <summary>
    /// L'input di salvataggio di una cella. <b>Una casella scrive solo ciò che mostra</b>: tutto il resto della
    /// clausola si porta avanti tale e quale, o scrivere il livello cancellerebbe in silenzio lo stato verticale
    /// — che nel testo del livello non lascia segno.
    /// </summary>
    private AgreementClauseInput? CellInput(AgreementClauseRow c, XferCell cell, string text)
    {
        var input = EditableCopy(c);
        switch (cell)
        {
            case XferCell.Points:
                return input with { Cops = text.Trim() };
            case XferCell.Level:
                var level = LevelFormatting.Parse(text);
                return input with
                {
                    LevelConstraint = level.Constraint,
                    LevelValue = level.Constraint == LevelConstraint.Special ? null : level.Value,
                    LevelSpecial = level.Constraint == LevelConstraint.Special ? level.Special : null,
                    LevelUnit = level.Unit,
                    Parity = level.Parity,
                    // Lo stato verticale NON si tocca: LevelFormatting.Parse lo restituisce, ma la cella non lo
                    // mostra e quindi non lo può scrivere.
                    VerticalState = c.VerticalState,
                };
            default:
                return null;
        }
    }

    private AgreementClauseRow? FindClause(int clauseId) =>
        _agreements.SelectMany(a => a.AllClauses).FirstOrDefault(c => c.Id == clauseId);

    private AgreementRow? AgreementOf(int clauseId) =>
        _agreements.FirstOrDefault(a => a.AllClauses.Any(c => c.Id == clauseId));

    private AgreementSectionRow? SectionOf(int clauseId) =>
        _agreements.SelectMany(a => a.Sections).FirstOrDefault(s => s.Clauses.Any(c => c.Id == clauseId));

    private AgreementSectionRow? SectionById(int sectionId) =>
        _agreements.SelectMany(a => a.Sections).FirstOrDefault(s => s.Id == sectionId);

    /// <summary>Una clausola esistente → input di modifica. Copia tutto: chi ne cambia un campo usa <c>with</c>.</summary>
    private static AgreementClauseInput EditableCopy(AgreementClauseRow c) => new()
    {
        Cops = c.Cops, LevelValue = c.LevelValue, LevelUnit = c.LevelUnit, LevelConstraint = c.LevelConstraint,
        LevelSpecial = c.LevelSpecial, Parity = c.Parity, VerticalState = c.VerticalState,
        ConditionLabel = c.ConditionLabel, ConditionRefId = c.ConditionRefId,
        ConditionAreaLabel = c.ConditionAreaLabel, ConditionCustomLabel = c.ConditionCustomLabel,
        HandoffKind = c.HandoffKind, HandoffLabel = c.HandoffLabel,
        HandoffLevelValue = c.HandoffLevelValue, HandoffLevelUnit = c.HandoffLevelUnit,
        HandoffLevelConstraint = c.HandoffLevelConstraint,
        CommsHandoffKind = c.CommsHandoffKind, CommsHandoffLabel = c.CommsHandoffLabel,
        SpeedValue = c.SpeedValue, SpeedConstraint = c.SpeedConstraint, IsGroupWide = c.IsGroupWide,
    };

    // ---- Picker e ausili ----------------------------------------------------------------------------

    /// <summary>Gli enti candidati a una PARTE. Un accordo esce dalla ACC per definizione — verso un altro ACC
    /// italiano o verso un confinante estero — quindi l'elenco non puo' fermarsi ai settori di casa; quelli di
    /// casa vengono comunque per primi.</summary>
    private IEnumerable<GlobalSectorRow> PartyCandidates()
    {
        var home = _acc?.Code ?? "";
        return _all
            .OrderByDescending(s => string.Equals(s.AccCode, home, StringComparison.OrdinalIgnoreCase))
            .ThenBy(s => s.AccCode).ThenBy(s => s.Callsign);
    }

    private IReadOnlyList<TypeaheadPicker.Item> SectorItems(string text) =>
        PartyCandidates().Where(s => Match(s, text)).Take(50)
            .Select(s => new TypeaheadPicker.Item(s.Callsign, s.AccCode))
            .ToList();

    /// <summary>
    /// Le voci del picker della CONTROPARTE: le proposte in cima, col loro perche', poi tutti gli altri.
    /// <para>⚠️ Le proposte non FILTRANO l'elenco, lo precedono. Un accordo puo' legare due enti che nessuna
    /// regola prevede — e' successo con LGKR_APP, aggiunto a mano — e un elenco che li nascondesse renderebbe
    /// impossibile scrivere proprio i casi che valeva la pena scrivere.</para>
    /// <para>La RAGIONE viaggia accanto alla voce: una proposta senza il suo perche' e' indistinguibile da un
    /// dato, e verrebbe accettata anche quando e' sbagliata.</para>
    /// <para>⚠️ Le proposte «per aeroporto» qui non arrivano più, ed è una conseguenza voluta del modello: alla
    /// creazione l'accordo non ha un traffico né uno scalo — li portano le sezioni — quindi restano il confine
    /// confermato e la controparte già usata. Chi cerca l'avvicinamento di uno scalo lo trova dalla sezione,
    /// dove l'ICAO c'è: la stessa conoscenza torna là come <b>verifica</b>.</para>
    /// </summary>
    private IReadOnlyList<TypeaheadPicker.Item> CounterpartItems(PairForm form, string text)
    {
        var proposte = AgreementSuggestions.ForReceivingSide(
            TransferFlowKind.Other,
            Array.Empty<string>(),
            SuggestionSectors(),
            AirportParents(),
            ConfirmedNeighbourAccs(),
            new HashSet<string>(new[] { form.SideA, form.SideB }.Where(x => x.Length > 0),
                                StringComparer.OrdinalIgnoreCase));

        var inCima = proposte
            .Where(x => string.IsNullOrWhiteSpace(text)
                        || x.Callsign.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .Select(x => new TypeaheadPicker.Item(x.Callsign, SuggestionReason(x.Reason), Strong: true))
            .ToList();

        var visti = inCima.Select(x => x.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return inCima.Concat(SectorItems(text).Where(x => !visti.Contains(x.Value))).ToList();
    }

    /// <summary>I settori nella forma minima che serve a proporre.</summary>
    private IReadOnlyList<SuggestionSector> SuggestionSectors() =>
        _all.Select(s => new SuggestionSector(s.Callsign, s.AccCode, s.Type)).ToList();

    /// <summary>ICAO → ente che copre l'aeroporto, dichiarato nella gerarchia. E' il ricevente piu' probabile
    /// di un arrivo, e viene prima di qualunque deduzione dal callsign.</summary>
    private IReadOnlyDictionary<string, string> AirportParents() => _airportParents;

    /// <summary>Gli ACC esteri confinanti CONFERMATI: le coppie in attesa o rifiutate non sono un confine.</summary>
    private IReadOnlySet<string> ConfirmedNeighbourAccs() =>
        _candidates
            .Where(c => c.Status == NeighbourCandidateStatus.Confirmed
                        && string.Equals(c.HomeAccCode, _acc?.Code, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.ForeignAccCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    /// <summary>Il perche' di una proposta, a parole. Sta qui e non nell'enum perche' e' LINGUA, e questa
    /// interfaccia esiste anche in inglese.</summary>
    private string SuggestionReason(AgreementSuggestionReason r) => r switch
    {
        AgreementSuggestionReason.AirportApproach => L["Xfer_WhyApproach"],
        AgreementSuggestionReason.AirportUnit => L["Xfer_WhyAirportUnit"],
        AgreementSuggestionReason.ConfirmedNeighbour => L["Xfer_WhyNeighbour"],
        _ => L["Xfer_WhyCounterpart"],
    };

    /// <summary>ICAO → ente che lo copre. Caricata alla scelta dell'ACC: e' una mappa piccola e non cambia
    /// mentre si scrive.</summary>
    private IReadOnlyDictionary<string, string> _airportParents =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<TypeaheadPicker.Item> AirportItems(string text) =>
        _airports.Where(a => MatchApt(a, text)).Take(50)
            .Select(a => new TypeaheadPicker.Item(a.Icao, a.Name + " - " + a.AccCode, Strong: true))
            .ToList();

    private IReadOnlyList<TypeaheadPicker.Item> AreaItems(string text) =>
        (string.IsNullOrWhiteSpace(text) ? _areas : _areas.Where(a => a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)))
            .Take(50).Select(a => new TypeaheadPicker.Item(a.Name, a.Type)).ToList();

    private static bool Match(GlobalSectorRow s, string text) =>
        string.IsNullOrWhiteSpace(text) || s.Callsign.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool MatchApt(AirportAdminRow a, string text) =>
        string.IsNullOrWhiteSpace(text)
        || a.Icao.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)
        || a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool IsKnownApt(string icao) =>
        !string.IsNullOrWhiteSpace(icao)
        && _airports.Any(a => string.Equals(a.Icao, icao.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? NewAptFooter(string icao) =>
        !string.IsNullOrWhiteSpace(icao) && !IsKnownApt(icao)
            ? "\u21b5 " + string.Format(L["Xfer_UseNewApt"].Value, icao.Trim().ToUpperInvariant())
            : null;

    /// <summary>Il nome dell'aeroporto fuori catalogo, chiesto a IVAO. Riempie solo il campo libero: lo scalo
    /// NON entra nel catalogo, che è il vincolo — niente documenti su scali non italiani nei picker.</summary>
    private async Task LookupApt()
    {
        var icao = _sectionForm.AirportText.Trim().ToUpperInvariant();
        if (icao.Length < 4) return;
        await Guarded(async () =>
        {
            var info = await Struct.LookupExternalAirportAsync(icao);
            _sectionForm.AirportName = info?.Name ?? "";
            if (info is null) _error = string.Format(L["Xfer_NotFoundIvao"].Value, icao);
        }, null);
    }

    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static string Dash(string s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    private string KindLabel(TransferFlowKind k) => XferLabels.Kind(L, k);

    private static string SenderOf(AgreementRow a, AgreementSectionRow s) => a.Sender(s.Direction).Callsign;
    private static string ReceiverOf(AgreementRow a, AgreementSectionRow s) => a.Receiver(s.Direction).Callsign;


    /// <summary>Il tipo di traffico pretende almeno un aeroporto: arrivi e partenze sono definiti rispetto a uno
    /// scalo, e senza la frase resterebbe orfana.</summary>
    private static bool AirportRequiredKind(TransferFlowKind k) =>
        k is TransferFlowKind.Arrival or TransferFlowKind.Departure;

    /// <summary>Il tipo di traffico non vuole aeroporti: un sorvolo attraversa, non consegna. VFR e Altro
    /// invece possono averne — decisione del 18 agosto 2026, ed è la regola «dove non sono esclusi».</summary>
    private static bool AirportlessKind(TransferFlowKind k) => k is TransferFlowKind.Overflight;


    /// <summary>
    /// Il campo aeroporti ha senso: il tipo non li esclude, <b>oppure</b> ce ne sono già — e quelli non si
    /// nascondono mai, o si perdono senza che nessuno lo veda.
    /// <para>⚠️ Include «altro», ed è il punto: è il tipo con cui un accordo <b>nasce</b>. Restringere il campo
    /// ai soli arrivi e partenze creava un <b>catch-22</b> — per dire «arrivi» serve un aeroporto, e per
    /// aggiungerlo serviva aver già detto «arrivi». Trovato guidando la creazione, non dai test.</para>
    /// </summary>
    private static bool AirportsRelevant(TransferFlowKind kind, int airports) =>
        !AirportlessKind(kind) || airports > 0;

    private void PickRunways(ClauseForm form, ChangeEventArgs e) =>
        form.Rwys = e.Value is string[] v ? v : Array.Empty<string>();

    private void ResolveArea(ClauseForm form) =>
        form.AreaLabel = _areas.FirstOrDefault(a => string.Equals(a.Name, form.AreaText.Trim(), StringComparison.OrdinalIgnoreCase))?.Name ?? form.AreaText.Trim();

    private void PickArea(ClauseForm form, string? name) { form.AreaLabel = name ?? ""; form.AreaText = name ?? ""; }

    private static string[] ParseRwys(string? label) =>
        string.IsNullOrWhiteSpace(label)
            ? Array.Empty<string>()
            : label.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>
    /// Le piste selezionabili per la condizione: l'unione di quelle degli aeroporti della sezione.
    /// <para>⚠️ Con più di uno scalo la sigla porta il proprio ICAO: «16R» su Fiumicino e su Malpensa sono due
    /// piste diverse, e un elenco che le confondesse produrrebbe condizioni che valgono per l'aeroporto
    /// sbagliato.</para>
    /// </summary>
    private async Task LoadRunwaysAsync(AgreementSectionRow? sec)
    {
        if (sec is null || sec.Airports.Count == 0) { _condRunways = Array.Empty<RunwayOption>(); return; }

        var many = sec.Airports.Count > 1;
        var list = new List<RunwayOption>();
        foreach (var apt in sec.Airports.OrderBy(x => x.Order))
        {
            if (!IsKnownApt(apt.Icao)) continue;
            try
            {
                var d = await Airports.LoadForViewAsync(apt.Icao);
                if (d is null) continue;
                foreach (var r in d.Runways)
                    list.Add(new RunwayOption(many ? apt.Icao + " " + r.Ident : r.Ident, r.Ident, r.Id));
            }
            catch (Exception)
            {
                // Un aeroporto senza piste importate non e' un errore della pagina: l'elenco resta piu' corto.
            }
        }
        _condRunways = list;
    }

    // ---- Stato in URL e preferenze ------------------------------------------------------------------

    // In URL sta cio' che identifica COSA STO GUARDANDO — ACC, vista, accordo, verso, filtri — cioe' quello
    // che ha senso mandare a un collega e ritrovare dopo un F5. In localStorage sta cio' che e' COME MI PIACE
    // GUARDARE — anteprime, ordinamento — che e' preferenza della persona, non del contenuto.
    private string UrlSignature() => $"{_accCode}|{_selectedId}|{_focusSectionId}|{_view}|{_filter}|{_kindFilter}|{_toReviewOnly}";
    private string PrefSignature() => $"{_showPreviews}|{_sort}|{_sortDesc}";
    private string _lastUrl = "", _lastPref = "";

    private void SyncUrl()
    {
        if (_acc is null || UrlSignature() == _lastUrl) return;
        _lastUrl = UrlSignature();

        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["acc"] = _acc.Code,
            ["vista"] = _view == XferView.Tree ? null : _view.ToString(),
            ["accordo"] = _selectedId,
            // La SEZIONE: è ciò che si sta guardando dentro l'accordo, e serve alla verifica a schermo e
            // all'aiuto in-app per portare qualcuno esattamente sulla tabella di cui si parla.
            ["sezione"] = _focusSectionId,
            // «verso» non si scrive più: il verso è della sezione, e la sezione ha un id.
            ["verso"] = null,
            ["q"] = string.IsNullOrWhiteSpace(_filter) ? null : _filter,
            ["tipo"] = _kindFilter?.ToString(),
            ["rev"] = _toReviewOnly ? "1" : null,
            ["norx"] = null,
        }), forceLoad: false, replace: true);
    }

    /// <summary>Ricostruisce lo stato dall'URL. Se il link porta un ACC, la pagina si apre gia' li'.</summary>
    private async Task RestoreFromUrl()
    {
        var q = QueryStringUtil.Parse(new Uri(Nav.Uri).Query);

        _filter = q.Value("q") ?? "";
        _kindFilter = q.Enum<TransferFlowKind>("tipo");
        _toReviewOnly = q.Flag("rev");
        if (q.Enum<XferView>("vista") is { } v) _view = v;

        var acc = q.Value("acc");
        if (string.IsNullOrWhiteSpace(acc)) return;

        _accCode = acc!;
        await OnAccChanged();   // azzera la scelta: quella dal link va rimessa DOPO

        // L'accordo si sceglie solo se esiste ancora: un link vecchio a uno eliminato deve aprire la pagina,
        // non lasciarla su un riquadro che parla di qualcosa che non c'e'.
        if (int.TryParse(q.Value("accordo"), out var id) && _agreements.Any(a => a.Id == id))
            SelectAgreement(id);

        // La sezione si mette a fuoco solo se esiste ancora, come l'accordo: un link vecchio deve aprire la
        // pagina, non lasciarla su un riquadro che parla di una tabella cancellata.
        if (int.TryParse(q.Value("sezione"), out var sec) && SectionById(sec) is not null)
            _focusSectionId = sec;
    }

    /// <summary>⚠️ <c>localStorage</c> si legge al PRIMO RENDER, mai in <c>OnInitializedAsync</c>: durante il
    /// prerender non c'è JS, e la lettura fallirebbe in silenzio lasciando le preferenze ai valori di
    /// riposo.</summary>
    private async Task RestorePreferences()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", "vipi.xfer.prefs");
            if (string.IsNullOrWhiteSpace(raw)) return;
            var parts = raw!.Split('|');
            if (parts.Length > 0 && bool.TryParse(parts[0], out var prev)) _showPreviews = prev;
            if (parts.Length > 1 && Enum.TryParse<RowSort>(parts[1], out var sort)) _sort = sort;
            if (parts.Length > 2 && bool.TryParse(parts[2], out var desc)) _sortDesc = desc;
            NormalizeSortForView();
            _lastPref = PrefSignature();
        }
        catch (Exception)
        {
            // Nessun localStorage (prerender, o browser che lo nega): le preferenze restano ai valori di riposo.
        }
    }

    private async Task SavePreferences()
    {
        if (PrefSignature() == _lastPref) return;
        _lastPref = PrefSignature();
        try { await JS.InvokeVoidAsync("localStorage.setItem", "vipi.xfer.prefs", PrefSignature()); }
        catch (Exception) { }
    }

    /// <summary>⚠️ Una preferenza salvata può non valere nel contesto in cui si riapre: una chiave di
    /// ordinamento che esiste solo in elenco, su una pagina che apre in albero, lascerebbe la tendina VUOTA.</summary>
    private void NormalizeSortForView()
    {
        if (_view == XferView.Tree && _sort is not (RowSort.Manual or RowSort.Points or RowSort.Level))
            _sort = RowSort.Manual;
    }

    // ---- Ciclo di vita ------------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        // ⚠️ Prewarm nel ciclo di vita e non dal markup: il lazy-load durante il render girava sul DbContext del
        // circuito e produceva «A second operation was started», cioè un circuito morto che a occhio sembra vivo.
        if (!Authz.IsAdmin) return;
        // Prewarm nel ciclo di vita e non dal markup: il lazy-load durante il render girava sul DbContext del
        // circuito e produceva «A second operation was started», cioe' un circuito morto che a occhio sembra vivo.
        Stations.Prewarm();
        _all = await Struct.ListSectorNodesAsync();
        _airports = await Struct.ListAllAirportsAsync();
        // Coppie confinanti: dicono quali ACC esteri sono confermati, e servono agli avvisi.
        _candidates = await Neighbours.ListAsync();
        await RestoreFromUrl();
    }

    private bool _prefsRestored;
    private bool _revealPanel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_prefsRestored)
        {
            _prefsRestored = true;
            await RestorePreferences();
            StateHasChanged();
        }

        if (_focusCell)
        {
            _focusCell = false;
            try { await _cellInput.FocusAsync(); } catch (Exception) { }
        }

        // ⚠️ Chiamare il JS dal gestore del clic è troppo presto: il DOM è ancora quello di prima (pannello
        // vuoto, senza piede) e la misura cadrebbe sul contenuto sbagliato. Si alza un flag e si chiama qui.
        if (_revealPanel)
        {
            _revealPanel = false;
            try { await JS.InvokeVoidAsync("vipiRevealPanel", "xt-panel"); } catch (Exception) { }
        }

        // ⚠️ L'altezza «schermo meno chrome» non è esprimibile in CSS: N è proprio ciò che non si sa. Si misura,
        // e si rimisura a OGNI render perché l'avviso del lock compare e sparisce da solo, spostando tutto.
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".xfe-layout3"); } catch (Exception) { }

        await SavePreferences();
        SyncUrl();
    }

    /// <summary>
    /// ⚠️ Il «è già quello» si misura su <c>_acc</c>, non su <c>_accCode</c>. Il codice può esserci senza che
    /// si sia RISOLTO — un ACC nascosto, rinominato o sparito fra due aperture della pagina, o un link vecchio
    /// con <c>?acc=</c> — e in quel caso la pagina resta ferma su titolo e riga ACC. Con il confronto sul solo
    /// codice il chip di QUEL codice era morto: l'unico che chi guarda prova a premere, perché è quello che sta
    /// cercando di aprire. Succedeva anche cambiando quali ACC sono visibili in Struttura.
    /// </summary>
    private Task SelectAcc(string code)
    {
        if (_acc is not null && string.Equals(_accCode, code, StringComparison.OrdinalIgnoreCase))
            return Task.CompletedTask;
        _accCode = code;
        return OnAccChanged();
    }

    private async Task OnAccChanged()
    {
        _acc = string.IsNullOrWhiteSpace(_accCode) ? null : Stations.Resolve(_accCode);
        if (_acc is null)
        {
            _agreements = Array.Empty<AgreementRow>();
            _areas = Array.Empty<SpecialAreaPick>();
            _preview = null;
            return;
        }

        _selectedId = null; _newOpen = false; _selected.Clear(); ClosePanel();
        _lens = new AgreementViewpoint(_acc.Code, SuggestionSectors());
        await Guarded(async () =>
        {
            _areas = await AccDeriv.ListSpecialAreasByAccAsync(_acc.Code);
            // ICAO -> ente che copre lo scalo: sta sul nodo Aeroporto della struttura, non sulle sue posizioni
            // (scaletta DEL->GND->TWR->APP). Si legge da li' invece di dedurlo dal callsign, perche' uno scalo
            // puo' essere coperto da un ente con un altro prefisso — ed e' proprio il caso in cui la deduzione
            // dal callsign non basterebbe.
            var struttura = await Struct.LoadAsync(_acc.Code);
            _airportParents = struttura?.Airports
                .Where(a => !string.IsNullOrWhiteSpace(a.ParentCallsign))
                .ToDictionary(a => a.Icao, a => a.ParentCallsign!, StringComparer.OrdinalIgnoreCase)
                ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            await LoadAsync();
        }, null);
    }

    private async Task LoadAsync(bool withPreview = true)
    {
        _agreements = await Agreements.ListByAccAsync(_acc!.Code);
        if (withPreview) _preview = await AccDeriv.GetPreviewContextAsync(_acc.Code);
        CollapseAllButSelected();
    }

    /// <summary>Alla prima apertura l'albero è chiuso tranne il ramo scelto: aperto tutto, un ACC con decine di
    /// controparti seppellisce il resto.</summary>
    private void CollapseAllButSelected()
    {
        if (_collapsed.Count > 0) return;
        var open = SelectedAgreement() is { } a ? NavKey(a) : null;
        foreach (var cp in BuildNav(_agreements))
            if (!string.Equals(cp.Key, open, StringComparison.OrdinalIgnoreCase)) _collapsed.Add(cp.Key);
    }

    private void CollapseAll()
    {
        foreach (var cp in BuildNav(_agreements)) _collapsed.Add(cp.Key);
    }

    private void ExpandAll() => _collapsed.Clear();

    private void ToggleNode(string key)
    {
        if (!_collapsed.Remove(key)) _collapsed.Add(key);
    }

    private void SelectAgreement(int id)
    {
        _selectedId = id;
        _newOpen = false;
        ClosePanel();
        _newSectionFor = null; _editSectionId = null; _editHeaderId = null; _pasteSectionId = null;
        var a = SelectedAgreement();
        if (a is null) return;
        // Il fuoco riparte dalla prima sezione: è quella in cima, e con essa «+ clausola» in elenco sa dove
        // scrivere anche appena arrivati.
        _focusSectionId = a.Sections.FirstOrDefault()?.Id;
        _collapsed.Remove(NavKey(a));

        // ⚠️ L'accordo si apre con le sezioni CHIUSE (scelta del committente, 18 agosto 2026). Otto tabelle
        // aperte sono qualche migliaio di pixel: chi apre un accordo sta cercando UNA sezione, e gliela fa
        // trovare l'elenco dei titoli — non lo scorrimento.
        // Il vuoto non si perde per questo: il blocco del **reciproco mancante** non è collassabile, quindi
        // resta a vista anche con tutto chiuso, e i conteggi sono nelle intestazioni.
        CollapseAllSections(a);
    }

    /// <summary>Chiude tutte le sezioni di un accordo.</summary>
    private void CollapseAllSections(AgreementRow a)
    {
        foreach (var sec in a.Sections) _collapsedSections.Add(sec.Id);
    }

    private void ExpandAllSections(AgreementRow a)
    {
        foreach (var sec in a.Sections) _collapsedSections.Remove(sec.Id);
    }

    private void OpenNewAgreement()
    {
        ClosePanel();
        _editHeaderId = null; _newSectionFor = null; _editSectionId = null;
        _newPair.Reset();
        // Creare è dire CHI: un accordo nasce senza nemmeno una sezione, e non può nascere invalido perché non
        // c'è niente da validare oltre ai due capi.
        _newOpen = true;
    }

    private void CloseNew() => _newOpen = false;

    private void SetView(XferView view)
    {
        _view = view;
        NormalizeSortForView();
    }

    private void TogglePreviews() => _showPreviews = !_showPreviews;

    /// <summary>Dall'elenco all'albero, sull'accordo della riga: è il ponte fra le due viste, e serve perché per
    /// sapere se una clausola è giusta bisogna vedere le sorelle — che l'elenco non mostra come blocco.</summary>
    private async Task GoToAgreement(XferTableRow r)
    {
        SetView(XferView.Tree);
        SelectAgreement(r.Agreement.Id);
        // Dopo SelectAgreement, che riporta il fuoco sulla prima sezione: qui la sezione che conta è quella
        // della riga da cui si è partiti, e la clausola che si apre subito dopo è la sua.
        _focusSectionId = r.Section.Id;
        _collapsedSections.Remove(r.Section.Id);
        await OnEditRow(r);
    }

    private Task OnEditRow(XferTableRow r) => EditClause(r.Agreement, r.Section, r.Clause);

    // ---- Scritture ----------------------------------------------------------------------------------

    private async Task AddAgreement()
    {
        var a = SectorIdOf(_newPair.SideA);
        var b = SectorIdOf(_newPair.SideB);

        // ⚠️ Una coppia già scritta non è un errore dell'utente: è una domanda a cui esiste una risposta
        // migliore di «no». Si apre l'accordo che c'è — e le sezioni si aggiungono lì.
        var esistente = a > 0 && b > 0 ? await Agreements.FindByPairAsync(_acc!.Code, a, b) : null;
        if (esistente is int already)
        {
            _newOpen = false;
            _newPair.Reset();
            SelectAgreement(already);
            _status = L["Xfer_PairAlreadyThere"];
            return;
        }

        var newId = 0;
        await Guarded(async () =>
        {
            newId = await Agreements.AddAgreementAsync(_acc!.Code, ToPairInput(_newPair));
            _newPair.Reset();
            _newOpen = false;
        }, L["Xfer_AgreementAdded"]);
        if (newId > 0) SelectAgreement(newId);
    }

    private void OpenEditHeader(AgreementRow a)
    {
        ClosePanel();
        _newSectionFor = null; _editSectionId = null;
        _editPair.LoadFrom(a, _lens);
        _editHeaderId = a.Id;
    }

    private async Task SaveHeader(AgreementRow a)
    {
        await Guarded(async () =>
        {
            await Agreements.UpdateAgreementAsync(_acc!.Code, a.Id, ToPairInput(_editPair));
            _editHeaderId = null;
        }, L["Xfer_AgreementUpdated"]);
    }

    private async Task DeleteAgreement(AgreementRow a)
    {
        // La fotografia si scatta PRIMA (dopo, l'accordo non c'è più) ma l'annulla si arma DOPO, e solo se
        // l'eliminazione è andata: offrire di annullare qualcosa che non è successo è peggio che non offrirlo.
        var snap = SnapshotOf(a);
        await Guarded(() => Agreements.DeleteAgreementAsync(_acc!.Code, a.Id), L["Xfer_AgreementDeleted"].Value);
        if (_error is null)
        {
            _selectedId = null;
            _undo = (() => Agreements.RestoreAgreementAsync(_acc!.Code, snap), L["Xfer_AgreementRestored"].Value);
        }
    }

    // ---- sezioni ------------------------------------------------------------------------------------

    private void OpenNewSection(AgreementRow a)
    {
        ClosePanel();
        _editHeaderId = null; _editSectionId = null;
        _sectionForm.Reset();
        _newSectionFor = a.Id;
    }

    /// <summary>Apre il form già impostato sul <b>reciproco</b> che manca: stesso traffico, stessi scali, verso
    /// opposto. È il gesto «scrivilo da zero» accanto a «copia l'altro verso».</summary>
    private void OpenNewReverseSection(AgreementRow a, AgreementSectionRow sec)
    {
        OpenNewSection(a);
        _sectionForm.LoadFrom(sec);
        _sectionForm.Description = "";
        _sectionForm.Direction = SectionDirection.Flip(sec.Direction);
    }

    private async Task AddSection(AgreementRow a)
    {
        var newId = 0;
        await Guarded(async () =>
        {
            newId = await Agreements.AddSectionAsync(_acc!.Code, a.Id, ToSectionInput(_sectionForm));
            _newSectionFor = null;
        }, L["Xfer_SectionAdded"]);
        // Una sezione appena creata nasce APERTA, anche se tutte le altre sono chiuse: è quella su cui si sta
        // lavorando, ed è dove va scritta la prima clausola.
        if (newId > 0) { _focusSectionId = newId; _collapsedSections.Remove(newId); }
    }

    private void OpenEditSection(AgreementSectionRow sec)
    {
        ClosePanel();
        _editHeaderId = null; _newSectionFor = null;
        _sectionForm.LoadFrom(sec);
        _editSectionId = sec.Id;
        _collapsedSections.Remove(sec.Id);
    }

    private async Task SaveSection(AgreementSectionRow sec)
    {
        await Guarded(async () =>
        {
            await Agreements.UpdateSectionAsync(_acc!.Code, sec.Id, ToSectionInput(_sectionForm));
            _editSectionId = null;
        }, L["Xfer_SectionUpdated"]);
        await LoadRunwaysAsync(FocusSection()?.Section);
    }

    private async Task DeleteSection(AgreementRow a, AgreementSectionRow sec)
    {
        var snap = new AgreementSectionRestore(a.Id, SnapshotOf(sec));
        await Guarded(() => Agreements.DeleteSectionAsync(_acc!.Code, sec.Id), L["Xfer_SectionDeleted"].Value);
        if (_error is null)
        {
            if (_focusSectionId == sec.Id) _focusSectionId = null;
            _undo = (() => Agreements.RestoreSectionAsync(_acc!.Code, snap), L["Xfer_SectionRestored"].Value);
        }
    }

    /// <summary>Copia la sezione nel verso opposto, come punto di partenza per il reciproco.</summary>
    private Task CopyToReverse(AgreementSectionRow sec) =>
        Guarded(async () =>
        {
            var newId = await Agreements.CopySectionToReverseAsync(_acc!.Code, sec.Id);
            if (newId is int id) { _focusSectionId = id; _status = string.Format(L["Xfer_DirectionCopied"].Value, sec.Clauses.Count); }
        }, null);

    /// <summary>Il tipo scelto nel form propone anche il VERSO: cambiare da arrivi a partenze sullo stesso
    /// scalo ribalta chi cede e chi riceve, ed è la parte che nessuno ricorda di girare a mano.</summary>
    private void PickSectionKind(AgreementRow ag, ChangeEventArgs e)
    {
        if (!Enum.TryParse<TransferFlowKind>(e.Value?.ToString(), out var kind)) return;
        _sectionForm.Kind = kind;
        _sectionForm.Direction = ProposeDirection(ag, kind, _sectionForm.Airports.FirstOrDefault()?.Icao);
    }

    private void AddAirportToForm(AgreementRow ag)
    {
        var icao = _sectionForm.AirportText.Trim().ToUpperInvariant();
        if (icao.Length == 0) return;
        if (!_sectionForm.Airports.Any(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase)))
            _sectionForm.Airports.Add(new AgreementAirportInput(icao,
                IsKnownApt(icao) ? null : NullIfBlank(_sectionForm.AirportName)));

        // Il primo scalo PROPONE il verso: «arrivi verso LIRF» va verso chi ha LIRF, e chi scrive non deve
        // ricordarsi di girare la freccia. Resta una proposta — la freccia è lì accanto, e si clicca.
        if (_sectionForm.Airports.Count == 1)
            _sectionForm.Direction = ProposeDirection(ag, _sectionForm.Kind, icao);

        _sectionForm.AirportText = ""; _sectionForm.AirportName = "";
    }

    /// <summary>
    /// Il verso proposto per una sezione, dall'aeroporto: la funzione pura di <c>SectionDirection</c>, con i
    /// dati che questa pagina ha già in mano (la catena di copertura dello scalo e la sua ACC).
    /// </summary>
    private AgreementDirection ProposeDirection(AgreementRow ag, TransferFlowKind kind, string? icao)
    {
        if (string.IsNullOrWhiteSpace(icao)) return SectionDirection.Propose(kind, (AgreementSide?)null);

        var chain = new List<string>();
        var cursor = _airportParents.TryGetValue(icao!, out var parent)
            ? _all.FirstOrDefault(x => string.Equals(x.Callsign, parent, StringComparison.OrdinalIgnoreCase))
            : null;
        // La catena si risale finché c'è un padre; il tetto a otto è una guardia contro un anello nei dati,
        // non un limite di disegno.
        for (var i = 0; cursor is not null && i < 8; i++)
        {
            chain.Add(cursor.Callsign);
            cursor = cursor.ParentSectorId is int pid ? _all.FirstOrDefault(x => x.Id == pid) : null;
        }

        var accOfAirport = _airports.FirstOrDefault(x => string.Equals(x.Icao, icao, StringComparison.OrdinalIgnoreCase))?.AccCode;
        var owner = SectionDirection.OwningSide(
            new AgreementSideHint(ag.SideA.Callsign, _lens.AccOf(ag.SideA.Callsign)),
            new AgreementSideHint(ag.SideB.Callsign, _lens.AccOf(ag.SideB.Callsign)),
            new AirportCoverageHint(chain, accOfAirport));

        return SectionDirection.Propose(kind, owner);
    }

    /// <summary>«da → a» per un verso che non è ancora salvato: serve al form della sezione.</summary>
    private static string DirectionPairOf(AgreementRow a, AgreementDirection d) =>
        $"{a.Sender(d).Callsign} → {a.Receiver(d).Callsign}";

    // ---- clausole -----------------------------------------------------------------------------------

    private async Task OpenAddClause(AgreementRow a, AgreementSectionRow sec)
    {
        _editClauseId = null; _editHeaderId = null; _newSectionFor = null; _editSectionId = null;
        _addClauseSectionId = sec.Id;
        _selectedId = a.Id;
        _focusSectionId = sec.Id;
        // La tabella in cui la clausola sta per nascere dev'essere a vista: il pannello scrive lì.
        _collapsedSections.Remove(sec.Id);
        _addClause.Reset();
        // La faccetta parte già aperta sul caso più comune quando si consegna a un APP: «al confine dell'AoR».
        _addClause.Facet.Reset(preset: ReceivesApp(a, sec));
        ResetPanelSections(_addClause);
        _formOpenedAs = _addClause.Signature();
        await LoadRunwaysAsync(sec);
        _revealPanel = true;
    }

    private async Task EditClause(AgreementRow a, AgreementSectionRow sec, AgreementClauseRow c)
    {
        _addClauseSectionId = null; _editHeaderId = null; _newSectionFor = null; _editSectionId = null;
        _selectedId = a.Id;
        _focusSectionId = sec.Id;
        _collapsedSections.Remove(sec.Id);
        _editClauseId = c.Id;
        _editClause.LoadFrom(c, ParseRwys);
        ResetPanelSections(_editClause);
        _formOpenedAs = _editClause.Signature();
        await LoadRunwaysAsync(sec);
        _revealPanel = true;
    }

    private void ClosePanel() { _editClauseId = null; _addClauseSectionId = null; }

    private AgreementRow? CurrentAgreement() =>
        _editClauseId is int id ? AgreementOf(id)
        : _addClauseSectionId is int add ? _agreements.FirstOrDefault(a => a.Sections.Any(s => s.Id == add))
        : null;

    private AgreementSectionRow? CurrentSection() =>
        _editClauseId is int id ? SectionOf(id)
        : _addClauseSectionId is int add ? SectionById(add)
        : null;

    private AgreementClauseRow? CurrentClause() => _editClauseId is int id ? FindClause(id) : null;

    private bool InGroup() => CurrentClause()?.VariantGroup is not null;

    private bool ReceivesApp(AgreementRow a, AgreementSectionRow sec) =>
        _all.FirstOrDefault(x => x.Id == a.Receiver(sec.Direction).SectorId)?.Type == SectorType.App;

    private Task SavePanel() =>
        _editClauseId is int id
            ? SaveClauseAsync(id)
            : _addClauseSectionId is int sectionId ? AddClause(sectionId) : Task.CompletedTask;

    private Task SaveClauseAsync(int clauseId) =>
        Guarded(() => Agreements.UpdateClauseAsync(_acc!.Code, clauseId, ToClauseInput(_editClause)),
                L["Xfer_RowSaved"].Value);

    private async Task AddClause(int sectionId)
    {
        await Guarded(async () =>
        {
            await Agreements.AddClauseAsync(_acc!.Code, sectionId, ToClauseInput(_addClause));
            _addClause.Reset();
            _formOpenedAs = _addClause.Signature();
        }, L["Xfer_RowAdded"]);
    }

    private async Task DeleteClause()
    {
        if (_editClauseId is not int id) return;
        var c = FindClause(id);
        var sec = SectionOf(id);
        if (c is null || sec is null) return;

        var snap = new AgreementClauseRestore(sec.Id, SnapshotOf(c));
        await Guarded(() => Agreements.DeleteClauseAsync(_acc!.Code, id), L["Xfer_RowDeleted"].Value);
        if (_error is null)
        {
            ClosePanel();
            _undo = (() => Agreements.RestoreClausesAsync(_acc!.Code, new[] { snap }), L["Xfer_RowsRestored"].Value);
        }
    }

    private Task MoveClause(bool up) =>
        _editClauseId is int id ? RowAction(() => Agreements.MoveClauseAsync(_acc!.Code, id, up)) : Task.CompletedTask;

    private Task DuplicateGroup() =>
        _editClauseId is int id
            ? Guarded(async () =>
            {
                var n = await Agreements.DuplicateVariantGroupAsync(_acc!.Code, id);
                _status = string.Format(L["Xfer_GroupDuplicated"].Value, n);
            }, null)
            : Task.CompletedTask;

    private Task DetachVariant() =>
        _editClauseId is int id ? RowAction(() => Agreements.DetachVariantAsync(_acc!.Code, id)) : Task.CompletedTask;

    private Task AddAlternative(int clauseId) =>
        AddVariant(() => Agreements.AddAlternativeAsync(_acc!.Code, clauseId), L["Xfer_AlternativeAdded"].Value);

    private Task AddException(int clauseId) =>
        AddVariant(() => Agreements.AddExceptionAsync(_acc!.Code, clauseId), L["Xfer_ExceptionAdded"].Value);

    /// <summary>Una variante nasce e si apre subito nel pannello: è nata senza condizione, e la condizione è
    /// esattamente ciò che va scritto adesso.</summary>
    private async Task AddVariant(Func<Task<int>> add, string message)
    {
        var newId = 0;
        await Guarded(async () => { newId = await add(); }, null);
        if (_error is not null) return;
        _status = message;

        var c = FindClause(newId);
        var a = AgreementOf(newId);
        var sec = SectionOf(newId);
        if (c is not null && a is not null && sec is not null) await EditClause(a, sec, c);
    }

    private Task RowAction(Func<Task> action) => Guarded(action, null);

    /// <summary>Invio nel pannello: salva. Il gesto più frequente della pagina non deve richiedere il mouse.</summary>
    private async Task PanelKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy || !_canEdit) return;
        await SavePanel();
    }

    // ---- Input ---------------------------------------------------------------------------------------

    private AgreementInput ToPairInput(PairForm f) => new()
    {
        SideASectorId = SectorIdOf(f.SideA),
        SideBSectorId = SectorIdOf(f.SideB),
        Note = NullIfBlank(f.Note),
    };

    private static AgreementSectionInput ToSectionInput(SectionForm f) => new()
    {
        Kind = f.Kind,
        Direction = f.Direction,
        Description = NullIfBlank(f.Description),
        // I sorvoli non hanno scali: se ne erano rimasti addosso cambiando tipo, la sezione non si salverebbe.
        // Si tolgono qui e non a ogni digitazione, perché un campo che si svuota da solo mentre lo si guarda è
        // il modo più rapido di perdere un dato senza accorgersene.
        Airports = f.Kind == TransferFlowKind.Overflight
            ? Array.Empty<AgreementAirportInput>()
            : f.Airports.ToList(),
    };

    private int SectorIdOf(string callsign) =>
        _all.FirstOrDefault(s => string.Equals(s.Callsign, callsign.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private AgreementClauseInput ToClauseInput(ClauseForm form) => form.Facet.Apply(new AgreementClauseInput
    {
        Cops = form.Points,
        LevelValue = form.Constraint == LevelConstraint.Special ? null : form.Value,
        LevelUnit = form.Unit,
        LevelConstraint = form.Constraint,
        LevelSpecial = form.Constraint == LevelConstraint.Special ? NullIfBlank(form.Special) : null,
        Parity = form.Parity,
        VerticalState = form.VState,
        ConditionLabel = form.Rwys.Length == 0 ? null : string.Join(" / ", form.Rwys),
        ConditionAreaLabel = NullIfBlank(form.AreaLabel),
        ConditionCustomLabel = NullIfBlank(form.CustomLabel),
    });

    // ---- Fotografie e annulla ------------------------------------------------------------------------

    private static AgreementClauseSnapshot SnapshotOf(AgreementClauseRow c) =>
        new(EditableCopy(c), c.Order, c.VariantGroup, c.VariantDepth);

    private static AgreementSectionSnapshot SnapshotOf(AgreementSectionRow s) => new(
        new AgreementSectionInput
        {
            Kind = s.Kind,
            Direction = s.Direction,
            Description = s.Description,
            Airports = s.Airports.OrderBy(x => x.Order).Select(x => new AgreementAirportInput(x.Icao, x.Name)).ToList(),
        },
        s.Order,
        s.Clauses.OrderBy(c => c.Order).Select(SnapshotOf).ToList());

    private static AgreementSnapshot SnapshotOf(AgreementRow a) => new(
        new AgreementInput
        {
            SideASectorId = a.SideA.SectorId,
            SideBSectorId = a.SideB.SectorId,
            Note = a.Note,
        },
        a.Sections.OrderBy(s => s.Order).Select(SnapshotOf).ToList());

    private (Func<Task> Restore, string Message)? _undo;

    private void ClearToast() { _status = null; _undo = null; }

    private async Task Undo()
    {
        if (_undo is not { } undo) return;
        _undo = null;
        await Guarded(undo.Restore, undo.Message);
    }

    /// <summary>Un gruppo di alternative senza «negli altri casi»: i casi che nessuna condizione copre restano
    /// scoperti, e chi legge non sa che fare. Può essere legittimo, quindi si segnala e non si impedisce.
    /// <para>Per SEZIONE, e non per accordo: l'outline vive dentro una sezione, e un avviso che uscisse dalla
    /// tabella sbagliata manderebbe a cercare un gruppo dove non c'è.</para></summary>
    private static IReadOnlyList<string> AlternativesWithoutNormalCase(AgreementSectionRow sec)
    {
        var avvisi = new List<string>();
        foreach (var g in sec.Clauses.Where(c => c.VariantGroup is not null)
                     .GroupBy(c => c.VariantGroup!.Value))
        {
            var alternative = g.Where(c => c.VariantDepth == 0 && !c.IsGroupWide).ToList();
            if (alternative.Count > 1 && alternative.All(c => !string.IsNullOrWhiteSpace(c.ConditionDisplay)))
                avvisi.Add(alternative[0].Cops);
        }
        return avvisi;
    }

    /// <summary>
    /// Ogni scrittura passa di qui: azzera l'annulla precedente, mette la pagina in «occupato», ricarica e
    /// riporta l'errore in un posto solo.
    /// <para>⚠️ Il costo per gesto conta: ricaricare il contesto anteprima costa sei mappe, irrilevante dal
    /// pannello e caro a ogni Invio in cella. Si rifà solo quando cambia ciò che l'anteprima legge davvero.</para>
    /// </summary>
    private async Task Guarded(Func<Task> action, string? ok, bool withPreview = false)
    {
        if (_busy) return;
        _busy = true;
        _error = null; _status = null; _undo = null;
        try
        {
            await action();
            if (_acc is not null) await LoadAsync(withPreview);
            if (ok is not null) _status = ok;
        }
        catch (Vipi.Application.Aor.ValidationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
