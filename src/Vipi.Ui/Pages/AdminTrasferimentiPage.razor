@page "/vsop/admin/trasferimenti"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject ITransferService Transfers
@inject IStructureEditingService Struct
@inject IEditAuthorizationService Authz
@inject INeighbourReader Neighbours
@inject IAirportEditingService Airports
@inject IAccDerivationService AccDeriv
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Xfer_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <a href="/vsop/admin/sectorstructure">@L["Struct_Title"]</a> › <b>@L["Xfer_Title"]</b></div>
    <div class="doc-head">
        <div><h2 class="xt-h2">@L["Xfer_Heading"]</h2><span class="muted">@((MarkupString)L["Xfer_Subtitle"].Value)</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else
    {
        @if (_error is not null || _status is not null)
        {
            <div class="toast-fixed">
                @if (_error is not null)
                {
                    <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div><button class="tclose" title="@L["Common_Close"]" @onclick="() => _error = null">✕</button></div>
                }
                else
                {
                    <div class="callout success"><span class="cic">✓</span><div>@_status</div><button class="tclose" title="@L["Common_Close"]" @onclick="() => _status = null">✕</button></div>
                }
            </div>
        }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" ExpiresChanged="OnLockExpiry" />

        @* Il lock scadeva senza preavviso: si stava scrivendo e la pagina tornava in sola lettura. *@
        @if (LockEndingSoon)
        {
            <div class="callout warning">
                <span class="cic">⏳</span>
                <div>
                    <p class="ct">@L["Xfer_LockEndingTitle"]</p>
                    @(string.Format(L["Xfer_LockEndingBody"].Value, _lockExpiresUtc!.Value.ToLocalTime().ToString("HH:mm")))
                </div>
            </div>
        }

        @* Chiudere il pannello scarta: meglio dirlo mentre la riga è ancora aperta. *@
        @if (HasOpenEdit)
        {
            <div class="callout info xt-unsaved">
                <span class="cic">✎</span>
                <div><p class="ct">@L["Xfer_UnsavedTitle"]</p>@L["Xfer_UnsavedBody"]</div>
            </div>
        }

        @* ---- Scelta ACC ---- *@
        <div class="section-title"><h3>ACC</h3><span class="ln"></span></div>
        <div class="block">
            @if (Stations.Accs.Count == 0)
            {
                <p class="help">@((MarkupString)L["Xfer_NoAccImport"].Value)</p>
            }
            else
            {
                <div class="xt-chips">
                    @foreach (var a in Stations.Accs)
                    {
                        var active = string.Equals(_accCode, a.Code, StringComparison.OrdinalIgnoreCase);
                        <button class="btn @(active ? "primary" : "ghost")" disabled="@(_busy)" title="@a.Name" @onclick="() => SelectAcc(a.Code)">@a.Code</button>
                    }
                </div>
            }
        </div>

        @if (_acc is null)
        {
            <p class="help">@L["Xfer_ChooseAcc"]</p>
        }
        else
        {
            @* ---- Nuovo gruppo (settore · aeroporto · tipo) ---- *@
            <div class="block">
                <h5 class="xt-mt0">@L["Xfer_NewGroup"]</h5>
                <div class="inline-form xt-flat">
                    <div class="field sector-pick-wrap"><label>@L["Xfer_SenderSector"]</label>
                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_fSectorText" @bind:event="oninput" @bind:after="ResolveFSector"
                               @onfocus="() => _fOpen = true" @onblur="() => _fOpen = false" />
                        @if (_fOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var s in OwnSectors().Where(s => Match(s, _fSectorText)).Take(50))
                                {
                                    <button type="button" class="sp-item @(s.Id == _fSector ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickFSector(s)">@s.Callsign@(IsForeignSender(s) ? $" · {s.AccCode} ({L["Xfer_Foreign"]})" : "")</button>
                                }
                                @if (!OwnSectors().Any(s => Match(s, _fSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                            </div>
                        }
                    </div>
                    <div class="field sector-pick-wrap"><label>@L["Xfer_Airport"] <span class="muted xt-lbl-soft">@L["Xfer_AirportNewForeign"]</span></label>
                        <input placeholder="LIRF / LFPG" @bind="_fApt" @bind:event="oninput" title="@L["Xfer_IcaoForeignTitle"]" autocomplete="off"
                               @onfocus="() => _aOpen = true" @onblur="OnAptBlur" />
                        @if (_aOpen)
                        {
                            <div class="sector-pick">
                                @foreach (var ap in _airports.Where(a => MatchApt(a, _fApt)).Take(50))
                                {
                                    <button type="button" class="sp-item @(string.Equals(ap.Icao, _fApt, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                            @onmousedown:preventDefault="true" @onmousedown="() => PickApt(ap)"><b>@ap.Icao</b> <span class="muted xt-hint">@ap.Name · @ap.AccCode</span></button>
                                }
                                @if (!string.IsNullOrWhiteSpace(_fApt) && !_airports.Any(a => string.Equals(a.Icao, _fApt.Trim(), StringComparison.OrdinalIgnoreCase)))
                                {
                                    <span class="sp-empty">↵ @(string.Format(L["Xfer_UseNewApt"].Value, _fApt.Trim().ToUpperInvariant()))</span>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_fApt) && !IsKnownApt(_fApt))
                    {
                        <div class="field"><label>@L["Xfer_AptName"] <span class="muted xt-lbl-soft">@L["Xfer_OutOfDb"]</span></label>
                            <div class="xt-btnrow">
                                <input placeholder="@L["Xfer_AptNamePh"]" @bind="_fAptName" title="@L["Xfer_AptNameTitle"]" />
                                <button type="button" class="btn ghost xt-nowrap" disabled="@_busy" @onclick="() => LookupApt(false)" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_fAptMsg)) { <span class="muted xt-hint">@_fAptMsg</span> }
                        </div>
                    }
                    <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                        <select @bind="_fKind">
                            <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                            <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                            <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                            <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                            <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                        </select>
                    </div>
                    <div class="field"><label>@L["Xfer_DescOpt"]</label><input placeholder="@L["Xfer_DescPh"]" @bind="_fDesc" @bind:event="oninput" @onkeydown="TrySubmitGroup" /></div>
                    <button class="btn primary" disabled="@(_busy || !_canEdit || _fSector == 0 || NewAptMissingName(_fApt, _fAptName))" @onclick="AddFlow">+ @L["Xfer_Group"]</button>
                    @if (_canEdit && _fSector == 0) { <span class="muted xt-hint xt-selfc">@L["Xfer_SelectSenderHint"]</span> }
                    else if (_canEdit && AirportRequiredMissing(_fKind, _fApt)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                    else if (_canEdit && NewAptMissingName(_fApt, _fAptName)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AptNeedsName"]</span> }
                </div>
                <p class="help xt-mt0">@((MarkupString)L["Xfer_NewGroupHelp"].Value)</p>
            </div>

            @if (_flows.Count == 0)
            {
                <p class="help">@L["Xfer_NoFlows"]</p>
            }
            else
            {
                var shown = FilteredFlows();
                <div class="xfe-filters xt-bar">
                    <input class="htree-search xt-search" placeholder="@L["Xfer_FilterPh"]"
                           @bind="_flowFilter" @bind:event="oninput" />
                    <select @bind="_kindFilter">
                        <option value="">@L["Xfer_AllKinds"]</option>
                        <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                        <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                        <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                        <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                        <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                    </select>
                    <span class="muted xt-count">@GroupsCountLabel(shown.Count) · @(string.Format(L["Xfer_RowsCount"].Value, shown.Sum(f => f.Points.Count)))</span>
                    @* Un ricevente mancante è una riga che in frequenza finisce a UNICOM: va trovata, non cercata. *@
                    @{ var noRecv = _flows.Sum(f => f.Points.Count(x => x.NextSectorId is null)); }
                    @if (noRecv > 0 || _noReceiverOnly)
                    {
                        <button class="btn @(_noReceiverOnly ? "primary" : "ghost")" title="@L["Xfer_NoReceiverTitle"]"
                                @onclick="() => _noReceiverOnly = !_noReceiverOnly">⚠ @L["Xfer_NoReceiverFilter"] (@noRecv)</button>
                    }
                    @* Le righe ACC→APP scritte prima della faccetta non dicono dove avviene il trasferimento e
                       vanno riviste a mano: senza un modo di elencarle, la revisione si perde per strada. *@
                    @{ var toReview = ToReviewCount(); }
                    @if (toReview > 0 || _toReviewOnly)
                    {
                        <button class="btn @(_toReviewOnly ? "primary" : "ghost")"
                                title="@L["Xfer_ToReviewTitle"]" @onclick="() => _toReviewOnly = !_toReviewOnly">
                            ⚠ @L["Xfer_ToReview"] (@toReview)
                        </button>
                    }
                    @if (_filtering) { <button class="btn ghost" @onclick="ResetFilters">↺ @L["Xfer_Reset"]</button> }
                    <span class="ln xt-grow"></span>
                    <button class="btn ghost" title="@L["Xfer_ExpandAll"]" @onclick="ExpandAll">⊞ @L["Xfer_ExpandAll"]</button>
                    <button class="btn ghost" title="@L["Xfer_CollapseAll"]" @onclick="CollapseAll">⊟ @L["Xfer_CollapseAll"]</button>
                    <label class="muted xt-check" title="@L["Xfer_SortNote"]">
                        @L["Xfer_SortBy"]
                        <select @bind="_sort">
                            <option value="@RowSort.Manual">@L["Xfer_SortManual"]</option>
                            <option value="@RowSort.Cop">@L["Xfer_SortCop"]</option>
                            <option value="@RowSort.Level">@L["Xfer_SortLevel"]</option>
                        </select>
                    </label>
                    <label class="muted xt-check" title="@L["Xfer_ShowPreviewsTitle"]">
                        <input type="checkbox" @bind="_showPreviews" /> @L["Xfer_ShowPreviews"]
                    </label>
                </div>
                @if (shown.Count == 0)
                {
                    <p class="help">@L["Xfer_NoFilterMatch"]</p>
                }

            @* Lista a sinistra, editing a destra: è il pattern che il progetto usa già in Struttura, Permessi e
               Incarichi. Qui mancava, ed era l'unica pagina di editing che trasformava la riga in un form. *@
            @if (_selected.Count > 0)
            {
                <div class="callout info xt-bulk">
                    <span class="cic">☑</span>
                    <div class="xt-bulkbody">
                        <b>@(string.Format(L["Xfer_BulkSelected"].Value, _selected.Count))</b>
                        <div class="field sector-pick-wrap xt-bulkpick">
                            <input placeholder="@L["Xfer_BulkReceiver"]" @bind="_bulkNextText" @bind:event="oninput"
                                   @bind:after="() => _bulkNext = _all.FirstOrDefault(x => string.Equals(x.Callsign, _bulkNextText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0"
                                   @onfocus="() => _bulkOpen = true" @onblur="() => _bulkOpen = false" />
                            @if (_bulkOpen)
                            {
                                <div class="sector-pick">
                                    @foreach (var sx in _all.Where(x => Match(x, _bulkNextText)).Take(50))
                                    {
                                        <button type="button" class="sp-item" @onmousedown:preventDefault="true"
                                                @onmousedown="() => { _bulkNext = sx.Id; _bulkNextText = sx.Callsign; _bulkOpen = false; }">@sx.Callsign</button>
                                    }
                                </div>
                            }
                        </div>
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="ApplyBulkReceiver">@L["Xfer_BulkApply"]</button>
                        <button class="btn ghost" @onclick="() => _selected.Clear()">@L["Xfer_BulkClear"]</button>
                    </div>
                </div>
            }

            <div class="xfe-layout">
            <div class="xt-list">

            @* ---- Settore ▸ Aeroporto ▸ Tipo ▸ righe ---- *@
            @foreach (var secGroup in shown.GroupBy(f => f.OwningSectorCallsign).OrderBy(g => g.Key))
            {
                var secKey = secGroup.Key;
                var secOpen = _filtering || !_collapsedSec.Contains(secKey);
                <div class="section-title xt-clickable" role="button" tabindex="0"
                     aria-expanded="@secOpen" @onclick="() => ToggleSec(secKey)"
                     @onkeydown="e => { if (IsActivationKey(e)) ToggleSec(secKey); }">
                    <h3 class="xt-m0"><span class="xt-chev">@(secOpen ? "▾" : "▸")</span> @secKey</h3>
                    <span class="ln"></span>
                    <span class="muted xt-hint">@(string.Format(L["Xfer_GroupsN"].Value, secGroup.Count()))</span>
                </div>
                @if (!secOpen) { continue; }
                @foreach (var aptGroup in secGroup.GroupBy(f => f.AirportIcao).OrderBy(g => g.Key ?? "~"))
                {
                    var aptKey = $"{secKey}|{aptGroup.Key}";
                    var aptOpen = _filtering || !_collapsedApt.Contains(aptKey);
                    <div class="block">
                        <h5 class="xt-m0 xt-clickable" role="button" tabindex="0" aria-expanded="@aptOpen"
                            @onclick="() => ToggleApt(aptKey)" @onkeydown="e => { if (IsActivationKey(e)) ToggleApt(aptKey); }">
                            <span class="xt-chev">@(aptOpen ? "▾" : "▸")</span>
                            @AptHeader(aptGroup.Key)
                        </h5>
                        @if (aptOpen)
                        {
                        @foreach (var f in aptGroup.OrderBy(x => x.Kind))
                        {
                            var flowOpen = _filtering || !_collapsedFlow.Contains(f.Id);
                            <div class="section-title xt-my">
                                <h4 class="xt-m0 xt-clickable" role="button" tabindex="0" aria-expanded="@flowOpen"
                                    @onclick="() => ToggleFlow(f.Id)" @onkeydown="e => { if (IsActivationKey(e)) ToggleFlow(f.Id); }">
                                    <span class="xt-chev">@(flowOpen ? "▾" : "▸")</span>
                                    <span class="pill blue">@KindLabel(f.Kind)</span>
                                    <span class="muted xt-hint xt-lbl-soft">@(string.Format(L["Xfer_RowsCount"].Value, f.Points.Count))</span>
                                    @if (!string.IsNullOrWhiteSpace(f.Description))
                                    {
                                        <span class="muted xt-desc" title="@f.Description">— @f.Description</span>
                                    }
                                    @if (f.Points.Count > 0 && f.Points.All(p => string.IsNullOrWhiteSpace(p.NextSectorCallsign)))
                                    {
                                        <button type="button" class="pill xt-warnpill"
                                                title="@L["Xfer_UnicomTitle"]"
                                                @onclick:stopPropagation="true" disabled="@(_busy || !_canEdit)" @onclick="() => FixUnicom(f)">⚠ @L["Xfer_NoReceiver"]</button>
                                    }
                                </h4>
                                <span class="ln"></span>
                                @* Tre azioni sullo stesso oggetto dicevano tutte e tre «Gruppo»: il verbo mancava proprio dove serviva. *@
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_CloneGroupTitle"]" @onclick="() => OpenCloneFlow(f)">⧉ @L["Xfer_GroupClone"]</button>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => EditFlow(f)">✎ @L["Xfer_GroupEdit"]</button>
                                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteGroupAria"]" Disabled="@(_busy || !_canEdit)"
                                               Prompt="@(string.Format(L["Xfer_DeleteGroupPrompt"].Value, f.Points.Count))" OnConfirm="() => DeleteFlow(f.Id)"><Trigger><Icon Name="x" /> @L["Xfer_GroupDelete"]</Trigger></InlineConfirm>
                            </div>
                            @if (!flowOpen) { continue; }
                            @if (_editFlowId == f.Id)
                            {
                                <div class="inline-form xt-mb">
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_SenderSector"]</label>
                                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_efSectorText" @bind:event="oninput" @bind:after="ResolveEfSector"
                                               @onfocus="() => _efOpen = true" @onblur="() => _efOpen = false" />
                                        @if (_efOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in OwnSectors().Where(s => Match(s, _efSectorText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _efSector ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickEfSector(s)">@s.Callsign <span class="muted xt-hint">@s.AccCode@(IsForeignSender(s) ? " (" + L["Xfer_Foreign"] + ")" : "")</span></button>
                                                }
                                                @if (!OwnSectors().Any(s => Match(s, _efSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                            </div>
                                        }
                                    </div>
                                    <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                                        <select @bind="_efKind">
                                            <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                                            <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                                            <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                                            <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                                            <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                                        </select>
                                    </div>
                                    <div class="field narrow"><label>@L["Xfer_Airport"]</label><input placeholder="LIRF / —" @bind="_efApt" @onblur="() => MaybeAutoLookup(true)" /></div>
                                    @if (!string.IsNullOrWhiteSpace(_efApt) && !IsKnownApt(_efApt))
                                    {
                                        <div class="field"><label>@L["Xfer_AptName"] <span class="muted xt-lbl-soft">@L["Xfer_OutOfDb"]</span></label>
                                            <div class="xt-btnrow">
                                                <input placeholder="@L["Xfer_AptNamePh"]" @bind="_efAptName" />
                                                <button type="button" class="btn ghost xt-nowrap" disabled="@_busy" @onclick="() => LookupApt(true)" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(_efAptMsg)) { <span class="muted xt-hint">@_efAptMsg</span> }
                                        </div>
                                    }
                                    <div class="field"><label>@L["Xfer_DescOpt"]</label><input placeholder="@L["Xfer_DescPh"]" @bind="_efDesc" /></div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || NewAptMissingName(_efApt, _efAptName))" @onclick="() => SaveFlow(f.Id)">💾 @L["Common_Save"]</button>
                                    @if (_canEdit && AirportRequiredMissing(_efKind, _efApt)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                                    else if (_canEdit && NewAptMissingName(_efApt, _efAptName)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AptNeedsName"]</span> }
                                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editFlowId = null">@L["Common_Cancel"]</button>
                                </div>
                            }
                            @if (_cloneFlowId == f.Id)
                            {
                                <div class="inline-form xt-subform">
                                    <div class="field sector-pick-wrap"><label>@L["Xfer_CloneToSender"]</label>
                                        <input placeholder="@L["Xfer_SearchCallsign"]" @bind="_cloneSectorText" @bind:event="oninput" @bind:after="ResolveCloneSector"
                                               @onfocus="() => _cloneOpen = true" @onblur="() => _cloneOpen = false" />
                                        @if (_cloneOpen)
                                        {
                                            <div class="sector-pick">
                                                @foreach (var s in OwnSectors().Where(s => Match(s, _cloneSectorText)).Take(50))
                                                {
                                                    <button type="button" class="sp-item @(s.Id == _cloneSector ? "on" : "")"
                                                            @onmousedown:preventDefault="true" @onmousedown="() => PickCloneSector(s)">@s.Callsign <span class="muted xt-hint">@s.AccCode@(IsForeignSender(s) ? " (" + L["Xfer_Foreign"] + ")" : "")</span></button>
                                                }
                                                @if (!OwnSectors().Any(s => Match(s, _cloneSectorText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                                            </div>
                                        }
                                    </div>
                                    <span class="muted xt-hint xt-selfc">@L["Xfer_Copy"] <b>@KindLabel(f.Kind)</b>@(string.IsNullOrWhiteSpace(f.AirportIcao) ? "" : $" · {f.AirportIcao}") @(string.Format(L["Xfer_WithRows"].Value, f.Points.Count))</span>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || _cloneSector == 0)" @onclick="() => ConfirmCloneFlow(f)">⧉ @L["Xfer_CloneHere"]</button>
                                    <button class="btn ghost" disabled="@_busy" @onclick="() => _cloneFlowId = null">@L["Common_Cancel"]</button>
                                </div>
                            }

                            @* Avviso NON bloccante: un gruppo di varianti senza «negli altri casi» lascia scoperti i
                               casi che nessuna condizione copre, e chi legge non sa che fare. Può essere legittimo
                               (le condizioni possono essere esaustive), quindi si segnala, non si impedisce. *@
                            @foreach (var a in AlternativesWithoutNormalCase(f))
                            {
                                <div class="callout xt-warn">
                                    <span class="cic">⚠</span>
                                    <div>@(string.Format(L["Xfer_AltNoNormalCase"].Value, a))</div>
                                </div>
                            }

                            @* Tabella di SOLA LETTURA: l'editing sta nel pannello a destra, dove i campi hanno
                               un'etichetta e lo spazio per starci. Prima la riga si trasformava in una fila di sei
                               controlli senza nomi, e il multi-select delle piste copriva la riga sotto. *@
                            <table class="res-table xfe-table">
                                <thead>
                                    <tr>
                                        <th class="xt-drag"></th>
                                        <th class="xt-pick"></th>
                                        <th>@L["Xfer_ColCop"]</th>
                                        <th>@L["Xfer_ColLevel"]</th>
                                        <th>@L["Xfer_ColReceiver"]</th>
                                        <th>@L["Xfer_ColCondition"]</th>
                                        <th class="xt-acts"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in SortedPoints(f))
                                    {
                                        var sel = _editPointId == p.Id;
                                        <tr class="@RowClass(p, sel)" @key="p.Id"
                                            @ondragover:preventDefault="true"
                                            @ondragenter="() => _dragOver = p.Id" @ondrop="() => DropOn(p)">
                                            @* Riordino per trascinamento: con l'outline l'ordine è la struttura, e
                                               quattro frecce per riga su otto righe erano trentadue bersagli. *@
                                            @* Il trascinamento vale solo con l'ordinamento manuale: riordinare una
                                               vista ordinata per CoP scriverebbe un ordine che non è quello che si vede. *@
                                            <td class="xt-drag">
                                                @if (_sort == RowSort.Manual)
                                                {
                                                    <span class="app-drag" draggable="@(_canEdit ? "true" : "false")"
                                                          title="@L["Common_DragReorder"]" @ondragstart="() => _dragId = p.Id">⠿</span>
                                                }
                                            </td>
                                            <td class="xt-pick">
                                                <input type="checkbox" checked="@_selected.Contains(p.Id)"
                                                       @onchange="() => ToggleSelect(p.Id)" />
                                            </td>
                                            <td class="@DepthClass(p)">
                                                @if (p.VariantDepth > 0) { <span class="xt-nest">↳</span> }
                                                <b>@(string.IsNullOrWhiteSpace(p.Cop) ? "—" : p.Cop)</b>
                                                @if (p.IsGroupWide)
                                                {
                                                    <span class="pill neutral" title="@L["Xfer_GroupWideTitle"]">@L["Xfer_GroupWide"]</span>
                                                }
                                            </td>
                                            <td>
                                                @p.LevelText
                                                @* La faccetta si legge sotto il livello autorizzato: sono due livelli,
                                                   e metterli sulla stessa riga confonde proprio ciò che distingue. *@
                                                @{ var facetSummary = FacetSummary(p); }
                                                @if (facetSummary.Length > 0) { <div class="xt-facet">→ @facetSummary</div> }
                                            </td>
                                            <td>@(p.NextSectorCallsign ?? "—")</td>
                                            @* Una colonna sola, come nella vista pubblica: le tre separate erano vuote
                                               su 70 righe di 76, e la stessa condizione si leggeva in tre posti. *@
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(p.ConditionDisplay)) { <span class="muted">—</span> }
                                                else { <span class="pill neutral" title="@L["Xfer_ColCondition"]">@p.ConditionDisplay</span> }
                                            </td>
                                            <td class="xt-acts">
                                                @* Tre azioni, non nove: aggiungere, modificare, eliminare. Spostare,
                                                   duplicare e sfilare stanno nel pannello, dove c'è posto per le parole. *@
                                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_AddAlternativeTitle"]" @onclick="() => AddAlternative(p.Id)">⑂</button>
                                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_AddExceptionTitle"]" @onclick="() => AddException(p.Id)">↳</button>
                                                <button class="btn @(sel ? "primary" : "ghost")" disabled="@(_busy || !_canEdit)" title="@L["Xfer_EditRowTitle"]" @onclick="() => EditPoint(f, p)">✎</button>
                                            </td>
                                        </tr>
                                        @if (_showPreviews)
                                        {
                                            var prev = PreviewRow(f, p);
                                            @if (!string.IsNullOrWhiteSpace(prev))
                                            {
                                                <tr class="xfer-prev"><td colspan="7"><span class="xt-prev">“@prev”</span></td></tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>

                            @* Il form della riga nuova sta nel pannello a destra, come quello di modifica: è la
                               stessa forma, e averla in due posti significava scriverla due volte. *@
                            <div class="xt-foot">
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddPoint(f)">+ @L["Xfer_AddRowFull"]</button>
                                <button class="btn ghost" disabled="@(_busy || !_canEdit)"
                                        title="@L["Xfer_CopyFromTitle"]" @onclick="() => OpenCopyFrom(f)">@L["Xfer_CopyFrom"]</button>
                            </div>

                            @if (_copyFromFlowId == f.Id)
                            {
                                @* Gli accordi di aeroporti vicini si somigliano: si sceglie il gruppo da cui
                                   prendere le righe invece di ridigitarle una per una. *@
                                <div class="inline-form xt-subform">
                                    <div class="field"><label>@L["Xfer_CopyFromLabel"]</label>
                                        <select @bind="_copySourceFlowId">
                                            <option value="0">—</option>
                                            @foreach (var src in _flows.Where(x => x.Id != f.Id && x.Points.Count > 0)
                                                                       .OrderBy(x => x.OwningSectorCallsign).ThenBy(x => x.AirportIcao))
                                            {
                                                <option value="@src.Id">@src.OwningSectorCallsign · @(src.AirportIcao ?? "—") · @KindLabel(src.Kind) (@src.Points.Count)</option>
                                            }
                                        </select>
                                    </div>
                                    <button class="btn primary" disabled="@(_busy || !_canEdit || _copySourceFlowId == 0)"
                                            @onclick="() => ConfirmCopyFrom(f)">@L["Xfer_CopyFromDo"]</button>
                                    <button class="btn ghost" disabled="@_busy" @onclick="() => _copyFromFlowId = null">@L["Common_Cancel"]</button>
                                </div>
                            }
                        }
                        }
                    </div>
                }
            }
            </div>@* /xt-list *@
            @* ---- Pannello: qui si scrive ---- *@
            <aside class="detail-sticky xt-panel">
                @PointPanel()
            </aside>
            </div>@* /xfe-layout *@
            }

        }
    }
</div>

@code {
    private string _accCode = "";
    private AccInfo? _acc;
    private IReadOnlyList<TransferFlowRow> _flows = Array.Empty<TransferFlowRow>();
    private IReadOnlyList<GlobalSectorRow> _all = Array.Empty<GlobalSectorRow>();
    private IReadOnlyList<AirportAdminRow> _airports = Array.Empty<AirportAdminRow>();
    private IReadOnlyList<NeighbourCandidateRow> _candidates = Array.Empty<NeighbourCandidateRow>();
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _status, _error;

    // Anteprima frasi: contesto (mappe + template) caricato alla scelta dell'ACC; compone in locale (nessun round-trip
    // per tasto). _showPreviews = mostra la frase risultante sotto ogni riga in lettura (default on).
    private CoordinationPreviewContext? _preview;
    private bool _showPreviews = true;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // Scadenza del lock: arriva a ogni battito (60s), che è anche la frequenza con cui l'avviso si aggiorna.
    private DateTime? _lockExpiresUtc;
    private void OnLockExpiry(DateTime? utc) { _lockExpiresUtc = utc; StateHasChanged(); }

    /// <summary>
    /// Il lock sta per scadere DAVVERO. La soglia è 60 secondi e non cinque minuti perché il TTL del lock è di
    /// tre (<c>ResourceLockService.LockTtlMinutes</c>): a cinque minuti la condizione sarebbe sempre vera e
    /// l'avviso sempre acceso — provato a schermo, compariva su ogni caricamento.
    /// <para>Con l'heartbeat vivo (60s) il lock si rinnova e questo non scatta mai: scatta quando l'heartbeat
    /// si è fermato, che è l'unico momento in cui l'avviso serve davvero.</para>
    /// </summary>
    private bool LockEndingSoon =>
        _canEdit && _lockExpiresUtc is { } e && e - DateTime.UtcNow <= TimeSpan.FromSeconds(60) && e > DateTime.UtcNow;

    // Stato collasso (chiavi presenti = collassate): settore, aeroporto (settore|icao), gruppo arrivi/partenze (flowId).
    private readonly HashSet<string> _collapsedSec = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _collapsedApt = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<int> _collapsedFlow = new();

    // form nuovo gruppo (flusso). _fSectorText = ricerca callsign; _fSector = id risolto.
    private int _fSector;
    private string _fSectorText = "";
    private TransferFlowKind _fKind = TransferFlowKind.Arrival;
    private string _fApt = "", _fAptName = "", _fDesc = "";
    private string? _fAptMsg, _efAptMsg;   // esito lookup IVAO del nome aeroporto fuori DB (add / edit)

    // ---- Form della RIGA (punto), uno solo, in due istanze ----
    // Prima erano due blocchi di campi paralleli con prefisso diverso (_p* per la riga nuova, _ep* per la
    // modifica): dodici coppie da tenere allineate a mano, e dodici occasioni di aggiornarne una sola. Ora la
    // forma è un tipo, e le due modalità sono due istanze — il markup del pannello è scritto una volta.
    private sealed class PointForm
    {
        public string Cop { get; set; } = "";
        public LevelConstraint Constraint { get; set; } = LevelConstraint.AtOrBelow;
        public int? Value { get; set; }
        public LevelUnit Unit { get; set; } = LevelUnit.Fl;
        public string Special { get; set; } = "";
        public LevelParity Parity { get; set; } = LevelParity.Any;
        public TransferVerticalState VState { get; set; } = TransferVerticalState.Unspecified;
        public int Next { get; set; }                    // 0 = UNICOM
        public string NextText { get; set; } = "";
        public bool NextOpen { get; set; }

        // Condizione: tre dimensioni indipendenti (tutte opzionali).
        public string[] Rwys { get; set; } = Array.Empty<string>();
        public string AreaLabel { get; set; } = "";
        public string AreaText { get; set; } = "";
        public bool AreaOpen { get; set; }
        public string CustomLabel { get; set; } = "";

        public FacetForm Facet { get; } = new();

        /// <summary>Firma dei valori: serve a dire se il form è stato TOCCATO. «Modifiche non salvate» deve
        /// dire modifiche — legarlo al solo pannello aperto lo accendeva appena si apriva una riga.</summary>
        public string Signature() => string.Join('', new[]
        {
            Cop, Constraint.ToString(), Value?.ToString() ?? "", Unit.ToString(), Special,
            Parity.ToString(), VState.ToString(), Next.ToString(),
            string.Join(',', Rwys), AreaLabel, CustomLabel,
            Facet.Kind.ToString(), Facet.Label, Facet.LevelValue?.ToString() ?? "",
            Facet.LevelUnit.ToString(), Facet.LevelConstraint.ToString(),
            Facet.CommsKind.ToString(), Facet.CommsLabel,
            Facet.SpeedValue?.ToString() ?? "", Facet.SpeedConstraint.ToString(), Facet.IsGroupWide.ToString(),
        });

        public void Reset()
        {
            Cop = ""; Constraint = LevelConstraint.AtOrBelow; Value = null; Unit = LevelUnit.Fl; Special = "";
            Parity = LevelParity.Any; VState = TransferVerticalState.Unspecified;
            Next = 0; NextText = ""; NextOpen = false;
            Rwys = Array.Empty<string>(); AreaLabel = ""; AreaText = ""; AreaOpen = false; CustomLabel = "";
            Facet.Reset();
        }

        public void LoadFrom(TransferPointRow p, Func<string?, string[]> parseRwys)
        {
            Cop = p.Cop; Constraint = p.LevelConstraint; Value = p.LevelValue; Unit = p.LevelUnit;
            Special = p.LevelSpecial ?? ""; Parity = p.Parity; VState = p.VerticalState;
            Next = p.NextSectorId ?? 0; NextText = p.NextSectorCallsign ?? ""; NextOpen = false;
            Rwys = parseRwys(p.ConditionLabel);
            AreaLabel = p.ConditionAreaLabel ?? ""; AreaText = p.ConditionAreaLabel ?? ""; AreaOpen = false;
            CustomLabel = p.ConditionCustomLabel ?? "";
            Facet.LoadFrom(p);
        }
    }

    private readonly PointForm _addForm = new();    // riga nuova nel gruppo _addPointFlowId
    private readonly PointForm _editForm = new();   // riga esistente _editPointId
    private int? _addPointFlowId;

    /// <summary>Il form aperto adesso: la modifica vince sull'aggiunta, come nell'ordine in cui li si apre.</summary>
    private PointForm? ActiveForm => _editPointId is not null ? _editForm : _addPointFlowId is not null ? _addForm : null;

    // Piste reali dell'aeroporto del flusso in editing (opzioni condizione «Pista»); vuoto se fuori DB / non importate.
    private IReadOnlyList<RunwayRow> _condRunways = Array.Empty<RunwayRow>();

    // Aree speciali dell'ACC corrente (opzioni condizione «Area»); caricate alla scelta dell'ACC.
    private IReadOnlyList<SpecialAreaPick> _areas = Array.Empty<SpecialAreaPick>();

    // form edit gruppo (flusso) in-place. _efSector = id mittente risolto (editabile).
    private int? _editFlowId;
    private TransferFlowKind _efKind = TransferFlowKind.Arrival;
    private string _efApt = "", _efAptName = "", _efDesc = "";
    private int _efSector;
    private string _efSectorText = "";
    private bool _efOpen;

    // form clona gruppo (righe incluse) verso un altro settore mittente. _cloneSector = id destinazione risolto.
    private int? _cloneFlowId;
    private int _cloneSector;
    private string _cloneSectorText = "";
    private bool _cloneOpen;

    // Filtro elenco esistente.
    private string _flowFilter = "";
    private TransferFlowKind? _kindFilter;

    // Un filtro attivo espande l'albero: quello che resta va visto, non ricercato a mano cliccando.
    private bool _filtering => !string.IsNullOrWhiteSpace(_flowFilter) || _kindFilter is not null || _toReviewOnly;

    /// <summary>Filtro «da rivedere»: mostra solo i flussi con almeno una riga da rivedere.</summary>
    private bool _toReviewOnly;

    /// <summary>Filtro «senza ricevente»: una riga senza <c>Next</c> in frequenza finisce a UNICOM, e finché
    /// non la si trova non la si corregge. Il badge sul gruppo c'era, il modo di elencarle no.</summary>
    private bool _noReceiverOnly;

    private void ResetFilters()
    {
        _flowFilter = string.Empty; _kindFilter = null; _toReviewOnly = false; _noReceiverOnly = false;
    }

    // ---- Selezione multipla e modifica in blocco ----
    // Quando un settore cambia nome o ne assorbe un altro, il ricevente va cambiato su decine di righe: riga
    // per riga sono decine di aperture del pannello, e basta saltarne una perché il documento dica due cose.
    private readonly HashSet<int> _selected = new();
    private int _bulkNext;
    private string _bulkNextText = "";
    private bool _bulkOpen;

    private void ToggleSelect(int pointId)
    {
        if (!_selected.Remove(pointId)) _selected.Add(pointId);
    }

    private async Task ApplyBulkReceiver()
    {
        if (_selected.Count == 0) return;
        var ids = _selected.ToList();
        var n = 0;
        await Guarded(async () =>
        {
            n = await Transfers.SetReceiverAsync(_acc!.Code, ids, _bulkNext == 0 ? null : _bulkNext);
            _selected.Clear(); _bulkNext = 0; _bulkNextText = "";
        }, null);
        if (n > 0) _status = string.Format(L["Xfer_BulkDone"].Value, n);
    }

    private Task DuplicateGroup(int pointId) =>
        Guarded(async () =>
        {
            var n = await Transfers.DuplicateVariantGroupAsync(_acc!.Code, pointId);
            _status = string.Format(L["Xfer_GroupDuplicated"].Value, n);
        }, null);

    // ---- Ordinamento della VISTA ----
    // Cambia solo come si guarda l'elenco: l'ordine salvato è la struttura dell'outline e non si tocca mai
    // da qui. Per questo l'ordinamento non-manuale disabilita il trascinamento: sarebbero due verità.
    private enum RowSort { Manual, Cop, Level }
    private RowSort _sort = RowSort.Manual;

    private IReadOnlyList<TransferPointRow> SortedPoints(TransferFlowRow f) => _sort switch
    {
        RowSort.Cop => f.Points.OrderBy(p => string.IsNullOrWhiteSpace(p.Cop) ? "~" : p.Cop, StringComparer.OrdinalIgnoreCase).ToList(),
        RowSort.Level => f.Points.OrderBy(p => p.LevelValue ?? int.MaxValue).ThenBy(p => p.Cop, StringComparer.OrdinalIgnoreCase).ToList(),
        _ => f.Points,
    };

    /// <summary>Firma del form al momento in cui si è aperto: il confronto dice se è stato toccato.</summary>
    private string _formOpenedAs = "";

    /// <summary>Il pannello ha modifiche NON SALVATE: aperto non basta, deve essere cambiato qualcosa.</summary>
    private bool HasOpenEdit => ActiveForm is { } f && f.Signature() != _formOpenedAs;

    // ---- Riordino per trascinamento ----
    // Con l'outline l'ordine è la struttura, e le quattro frecce per riga erano trentadue bersagli da 28px su un
    // flusso di otto righe. Il gesto è quello che il progetto usa già in Frequenze, Regole pista e Struttura.
    private int? _dragId, _dragOver;

    private async Task DropOn(TransferPointRow target)
    {
        var src = _dragId; _dragId = null; _dragOver = null;
        if (src is not int id || id == target.Id || !_canEdit || _busy) return;
        await Guarded(() => Transfers.MovePointToAsync(_acc!.Code, id, target.Id), null);
    }

    /// <summary>Classe della riga: selezione, appartenenza a un gruppo, bersaglio del trascinamento.</summary>
    private string RowClass(TransferPointRow p, bool selected)
    {
        var c = new List<string>(3);
        if (p.VariantGroup is not null) c.Add("xfer-variant");
        if (selected) c.Add("xt-sel");
        if (_dragOver == p.Id && _dragId is not null && _dragId != p.Id) c.Add("xt-dragover");
        return string.Join(' ', c);
    }

    /// <summary>Rientro della riga per profondità: una classe per livello, così non serve uno stile inline.</summary>
    private static string DepthClass(TransferPointRow p) =>
        p.VariantDepth <= 0 ? "" : $"xt-d{Math.Min(p.VariantDepth, 4)}";

    /// <summary>
    /// Una riga «da rivedere» è una riga che consegna a un APP e non dice ancora dove avviene il trasferimento.
    /// Prima della faccetta quel dato non esisteva, quindi il suo livello poteva voler dire due cose diverse
    /// (autorizzato o al trasferimento) e solo chi ha scritto la riga lo sa: vanno riaperte a mano.
    /// </summary>
    private bool NeedsReview(TransferPointRow p) =>
        p.HandoffKind == TransferHandoffKind.Unspecified
        && p.NextSectorId is int id
        && _all.FirstOrDefault(s => s.Id == id)?.Type == SectorType.App;

    private int ToReviewCount() => _flows.Sum(f => f.Points.Count(NeedsReview));

    /// <summary>Flussi filtrati per testo (settore/aeroporto/descrizione/CoP/ricevente), per tipo e «da rivedere».</summary>
    private IReadOnlyList<TransferFlowRow> FilteredFlows()
    {
        var q = _flowFilter.Trim();
        return _flows.Where(f =>
            (_kindFilter is null || f.Kind == _kindFilter)
            && (!_toReviewOnly || f.Points.Any(NeedsReview))
            && (q.Length == 0
                || (f.OwningSectorCallsign?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.AirportIcao?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (f.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || f.Points.Any(p =>
                    (p.Cop?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (p.NextSectorCallsign?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))))
            .ToList();
    }

    private void ResolveEfSector() =>
        _efSector = OwnSectors().FirstOrDefault(s => string.Equals(s.Callsign, _efSectorText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;
    private void PickEfSector(GlobalSectorRow s) { _efSector = s.Id; _efSectorText = s.Callsign; _efOpen = false; }

    /// <summary>Riga aperta in modifica nel pannello; null = nessuna (o si sta aggiungendo).</summary>
    private int? _editPointId;

    /// <summary>
    /// Stato del form per la faccetta TRASFERIMENTO di una riga (dove passa il controllo, a che livello, dove
    /// passano le comunicazioni, velocità, «negli altri casi»).
    /// <para>Un oggetto e non dieci campi sciolti per form: i form sono due (modifica in-place e nuova riga) e
    /// la faccetta ha dieci pezzi — venti campi paralleli con prefisso diverso sono venti occasioni di
    /// aggiornarne uno solo dei due.</para>
    /// </summary>
    private sealed class FacetForm
    {
        public TransferHandoffKind Kind { get; set; } = TransferHandoffKind.Unspecified;
        public string Label { get; set; } = "";
        public int? LevelValue { get; set; }
        public LevelUnit LevelUnit { get; set; } = LevelUnit.Fl;
        public LevelConstraint LevelConstraint { get; set; } = LevelConstraint.Exact;
        public TransferHandoffKind CommsKind { get; set; } = TransferHandoffKind.Unspecified;
        public string CommsLabel { get; set; } = "";
        public int? SpeedValue { get; set; }
        public SpeedConstraint SpeedConstraint { get; set; } = SpeedConstraint.Unspecified;
        public bool IsGroupWide { get; set; }

        public void LoadFrom(TransferPointRow p)
        {
            Kind = p.HandoffKind; Label = p.HandoffLabel ?? "";
            LevelValue = p.HandoffLevelValue; LevelUnit = p.HandoffLevelUnit;
            // Su una riga che la faccetta non l'ha mai usata, il vincolo salvato è il valore di riposo della
            // colonna (AtOrAbove, lo zero dell'enum) e non una scelta di nessuno: caricarlo farebbe partire il
            // form da «o superiore» e la prima faccetta scritta direbbe la forma sbagliata. Trovato guidando
            // l'editor: la frase usciva «al confine dell'AoR a FL110 o superiore» invece di «passando FL110».
            LevelConstraint = p.HandoffKind == TransferHandoffKind.Unspecified
                ? LevelConstraint.Exact
                : p.HandoffLevelConstraint;
            CommsKind = p.CommsHandoffKind; CommsLabel = p.CommsHandoffLabel ?? "";
            SpeedValue = p.SpeedValue; SpeedConstraint = p.SpeedConstraint;
            IsGroupWide = p.IsGroupWide;
        }

        /// <summary>Svuota il form. Con <paramref name="preset"/> apre già la faccetta sul caso più comune —
        /// «al confine dell'AoR, passando un livello» — che è la forma di un accordo ACC→APP.</summary>
        public void Reset(bool preset = false)
        {
            Kind = preset ? TransferHandoffKind.AorBoundary : TransferHandoffKind.Unspecified;
            Label = ""; LevelValue = null; LevelUnit = LevelUnit.Fl; LevelConstraint = LevelConstraint.Exact;
            CommsKind = TransferHandoffKind.Unspecified; CommsLabel = "";
            SpeedValue = null; SpeedConstraint = SpeedConstraint.Unspecified;
            IsGroupWide = false;
        }

        public TransferHandoffFacet ToFacet() => new(
            Kind, Label, LevelValue, LevelUnit, LevelConstraint,
            CommsKind, CommsLabel, SpeedValue, SpeedConstraint, IsGroupWide);

        /// <summary>Riversa la faccetta nell'input di salvataggio (l'input è un record: <c>with</c> tiene
        /// insieme i campi senza ricopiare gli altri quindici).</summary>
        public TransferPointInput Apply(TransferPointInput input) => input with
        {
            HandoffKind = Kind,
            HandoffLabel = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim(),
            HandoffLevelValue = LevelValue,
            HandoffLevelUnit = LevelUnit,
            HandoffLevelConstraint = LevelConstraint,
            CommsHandoffKind = CommsKind,
            CommsHandoffLabel = string.IsNullOrWhiteSpace(CommsLabel) ? null : CommsLabel.Trim(),
            SpeedValue = SpeedValue,
            SpeedConstraint = SpeedConstraint,
            IsGroupWide = IsGroupWide,
        };
    }


    /// <summary>
    /// Campi della faccetta trasferimento, identici nei due form (modifica in-place e nuova riga). I campi
    /// dipendenti compaiono solo quando servono: l'etichetta non si chiede per il confine dell'AoR, che si
    /// descrive da sé, e il valore di velocità non si chiede senza vincolo.
    /// <para><paramref name="inGroup"/> = la riga sta in un gruppo di varianti: solo lì «negli altri casi»
    /// significa qualcosa, perché solo lì esistono «gli altri casi».</para>
    /// </summary>
    /// <summary>
    /// Il pannello di destra: è l'unico posto dove si scrive una riga. Vuoto mostra cosa fare, come il
    /// pannello dettaglio di Struttura — una colonna che non dice niente sembra rotta.
    /// </summary>
    private RenderFragment PointPanel() => __builder =>
    {
        var form = ActiveForm;
        var flow = CurrentFlow();

        if (form is null || flow is null)
        {
            <div class="xt-panel-empty">
                <p class="ct">@L["Xfer_PanelEmptyTitle"]</p>
                <p class="muted">@L["Xfer_PanelEmptyBody"]</p>
            </div>
            return;
        }

        var editing = _editPointId is not null;
        var point = editing ? flow.Points.FirstOrDefault(x => x.Id == _editPointId) : null;

        <div class="xt-panel-h">
            <b>@(editing ? L["Xfer_PanelEdit"] : L["Xfer_PanelNew"])</b>
            <span class="muted">@flow.OwningSectorCallsign@(string.IsNullOrWhiteSpace(flow.AirportIcao) ? "" : $" · {flow.AirportIcao}") · @KindLabel(flow.Kind)</span>
            <button class="btn ghost xt-panel-x" title="@L["Common_Cancel"]" @onclick="ClosePanel">✕</button>
        </div>

        @* --- Identità: dove entra il traffico e a chi va --- *@
        <div class="xt-grp"><span>@L["Xfer_GrpIdentity"]</span></div>
        <div class="field">
            <label>@(editing ? "CoP" : L["Xfer_ColCop"].Value)
                @if (!editing) { <span class="muted xt-hint">@L["Xfer_CopListHint"]</span> }
            </label>
            <input placeholder="@(editing ? "VALMA / —" : "VALMA / VALMA, ELB, TOP")" @bind="form.Cop" @bind:event="oninput"
                   @onkeydown="PanelKey" />
        </div>
        <div class="field sector-pick-wrap">
            <label>@L["Xfer_ColReceiver"] <span class="muted xt-hint">@L["Xfer_EmptyUnicom"]</span></label>
            <input placeholder="@L["Xfer_SearchCallsign"]" @bind="form.NextText" @bind:event="oninput" @bind:after="() => ResolveNext(form)"
                   @onfocus="() => form.NextOpen = true" @onblur="() => form.NextOpen = false" @onkeydown="PanelKey" />
            @if (form.NextOpen)
            {
                <div class="sector-pick">
                    @foreach (var s in _all.Where(s => Match(s, form.NextText)).Take(50))
                    {
                        <button type="button" class="sp-item @(s.Id == form.Next ? "on" : "")"
                                @onmousedown:preventDefault="true" @onmousedown="() => PickNext(form, s)">@s.Callsign <span class="muted xt-hint">@s.AccCode</span></button>
                    }
                    @if (!_all.Any(s => Match(s, form.NextText))) { <span class="sp-empty">@L["Xfer_NoSector"]</span> }
                </div>
            }
        </div>

        @* --- Livello autorizzato --- *@
        <div class="xt-grp"><span>@L["Xfer_GrpCleared"]</span></div>
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Constraint"]</label>
                <select @bind="form.Constraint">
                    <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                    <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                    <option value="@LevelConstraint.Exact">@L["Xfer_Exact"]</option>
                    <option value="@LevelConstraint.Special">@L["Xfer_Special"]</option>
                </select>
            </div>
            @if (form.Constraint == LevelConstraint.Special)
            {
                <div class="field"><label>@L["Xfer_LevelText"]</label>
                    <input placeholder="@L["Xfer_PerAirway"]" @bind="form.Special" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
            }
            else
            {
                <div class="field"><label>@L["Xfer_Value"]</label>
                    <input type="number" @bind="form.Value" @bind:event="oninput" @onkeydown="PanelKey" />
                </div>
                <div class="field"><label>@L["Xfer_Unit"]</label>
                    <select @bind="form.Unit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                </div>
            }
        </div>
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Levels"] <span class="muted xt-hint">@L["Xfer_SemicircHint"]</span></label>
                <select @bind="form.Parity">
                    <option value="@LevelParity.Any">@L["Xfer_ParityAny"]</option>
                    <option value="@LevelParity.Even">@L["Xfer_ParityEven"]</option>
                    <option value="@LevelParity.Odd">@L["Xfer_ParityOdd"]</option>
                </select>
            </div>
            <div class="field"><label>@L["Xfer_VState"]</label>
                <select @bind="form.VState">
                    <option value="@TransferVerticalState.Unspecified">@L["Xfer_VStateNone"]</option>
                    <option value="@TransferVerticalState.Level">@L["Xfer_VStateLevel"]</option>
                    <option value="@TransferVerticalState.Descending">@L["Xfer_VStateDescending"]</option>
                    <option value="@TransferVerticalState.Climbing">@L["Xfer_VStateClimbing"]</option>
                </select>
            </div>
        </div>

        @* --- Trasferimento (faccetta ACC→APP) --- *@
        <div class="xt-grp"><span>@L["Xfer_GrpHandoff"]</span></div>
        @FacetFields(form.Facet, point?.VariantGroup is not null && point.VariantDepth == 0)

        @* --- Condizione --- *@
        <div class="xt-grp"><span>@L["Xfer_GrpCondition"]</span></div>
        <div class="field"><label>@L["Xfer_RunwaysInUse"] <span class="muted xt-hint">@L["Xfer_MultiSelectHint"]</span></label>
            @if (_condRunways.Count > 0)
            {
                <select multiple size="@Math.Min(4, _condRunways.Count)" @bind="form.Rwys">
                    @foreach (var r in _condRunways) { <option value="@r.Ident">@RwyLabel(r)</option> }
                </select>
            }
            else { <span class="muted xt-hint">@L["Xfer_NoRunwaysForApt"]</span> }
        </div>
        <div class="field sector-pick-wrap"><label>@L["Xfer_ActiveArea"] <span class="muted xt-hint">@L["Xfer_SearchHint"]</span></label>
            <input placeholder="@L["Xfer_SearchArea"]" @bind="form.AreaText" @bind:event="oninput" @bind:after="() => ResolveArea(form)"
                   @onfocus="() => form.AreaOpen = true" @onblur="() => form.AreaOpen = false" />
            @if (form.AreaOpen)
            {
                <div class="sector-pick">
                    <button type="button" class="sp-item" @onmousedown:preventDefault="true" @onmousedown="() => PickArea(form, null)"><span class="muted">@L["Xfer_AreaNone"]</span></button>
                    @foreach (var a in MatchAreas(form.AreaText).Take(50))
                    {
                        <button type="button" class="sp-item @(string.Equals(a.Name, form.AreaLabel, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                @onmousedown:preventDefault="true" @onmousedown="() => PickArea(form, a)">@a.Name @if (!string.IsNullOrWhiteSpace(a.Type)) { <span class="muted xt-hint">@a.Type</span> }</button>
                    }
                    @if (!MatchAreas(form.AreaText).Any()) { <span class="sp-empty">@L["Xfer_NoArea"]</span> }
                </div>
            }
        </div>
        <div class="field"><label>@L["Xfer_ColCustom"] <span class="muted xt-hint">@L["Xfer_FreeTextHint"]</span></label>
            <input placeholder="@L["Xfer_CustomPh"]" @bind="form.CustomLabel" @bind:event="oninput" @onkeydown="PanelKey" />
        </div>

        @* --- Anteprima: è il modo più diretto di accorgersi di una riga sbagliata --- *@
        <div class="xt-preview">
            <b>@L["Xfer_PreviewLabel"]:</b>
            @{ var prev = PreviewForm(flow, form); }
            <span class="xt-prev">@(string.IsNullOrWhiteSpace(prev) ? L["Xfer_PreviewIncomplete"].Value : $"“{prev}”")</span>
        </div>

        <div class="xt-panel-actions">
            <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="SavePanel">💾 @L["Common_Save"]</button>
            @if (!editing)
            {
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_AddRowContinueTitle"]" @onclick="() => AddPoint(_addPointFlowId!.Value, true)">＋ @L["Xfer_AddRowContinue"]</button>
            }
            <button class="btn ghost" disabled="@_busy" @onclick="ClosePanel">@L["Common_Cancel"]</button>
        </div>

        @* Spostare, duplicare e sfilare vivono qui: nella riga erano sei icone da 28px senza nome. *@
        @if (editing && point is not null)
        {
            <div class="xt-grp"><span>@L["Xfer_GrpRowActions"]</span></div>
            <div class="xt-panel-actions">
                <button class="btn ghost" disabled="@(_busy || !_canEdit || point.Id == flow.Points[0].Id)" @onclick="() => Move(point.Id, true)">▲ @L["Xfer_MoveUp"]</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit || point.Id == flow.Points[^1].Id)" @onclick="() => Move(point.Id, false)">▼ @L["Xfer_MoveDown"]</button>
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => CloneRow(flow, point)">⧉ @L["Xfer_DuplicateRow"]</button>
                @if (point.VariantGroup is not null)
                {
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DetachVariantTitle"]" @onclick="() => DetachVariant(point.Id)">⇤ @L["Xfer_DetachVariant"]</button>
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_DuplicateGroupTitle"]" @onclick="() => DuplicateGroup(point.Id)">@L["Xfer_DuplicateGroup"]</button>
                }
                <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteRowAria"]" Disabled="@(_busy || !_canEdit)"
                               Prompt="@L["Xfer_DeleteRowPrompt"]" OnConfirm="() => DeletePoint(point.Id)"><Trigger>✕ @L["Common_Delete"]</Trigger></InlineConfirm>
            </div>
        }
    };

    /// <summary>
    /// Campi della faccetta trasferimento. Stessa forma degli altri blocchi del pannello — etichetta sopra,
    /// campo sotto — perché prima erano etichette inline e la sezione sembrava appartenere a un'altra pagina.
    /// I campi dipendenti compaiono solo quando servono: l'etichetta non si chiede per il confine dell'AoR, che
    /// si descrive da sé, e il valore di velocità non si chiede senza vincolo.
    /// <para><paramref name="inGroup"/> = la riga può scavalcare le alternative: solo dentro un gruppo, e solo
    /// al primo livello, «vale per tutte» significa qualcosa.</para>
    /// </summary>
    private RenderFragment FacetFields(FacetForm ff, bool inGroup) => __builder =>
    {
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Handoff"]</label>
                <select @bind="ff.Kind" title="@L["Xfer_HandoffTitle"]">
                    <option value="@TransferHandoffKind.Unspecified">@L["Xfer_HandoffNone"]</option>
                    <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                    <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                    <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                </select>
            </div>
            @if (ff.Kind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
            {
                <div class="field"><label>@L["Xfer_HandoffWhere"]</label>
                    <input placeholder="@L["Xfer_HandoffLabelPh"]" @bind="ff.Label" @bind:event="oninput" />
                </div>
            }
        </div>

        @if (ff.Kind != TransferHandoffKind.Unspecified)
        {
            <div class="xt-row2">
                <div class="field"><label>@L["Xfer_HandoffLevel"]</label>
                    <select @bind="ff.LevelConstraint" title="@L["Xfer_HandoffLevelTitle"]">
                        <option value="@LevelConstraint.Exact">@L["Xfer_HandoffPassing"]</option>
                        <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                        <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                    </select>
                </div>
                <div class="field"><label>@L["Xfer_Value"]</label>
                    <input type="number" @bind="ff.LevelValue" @bind:event="oninput" />
                </div>
                <div class="field"><label>@L["Xfer_Unit"]</label>
                    <select @bind="ff.LevelUnit"><option value="@LevelUnit.Fl">FL</option><option value="@LevelUnit.Feet">ft</option></select>
                </div>
            </div>
            <div class="xt-row2">
                <div class="field"><label>@L["Xfer_Comms"]</label>
                    <select @bind="ff.CommsKind" title="@L["Xfer_CommsTitle"]">
                        <option value="@TransferHandoffKind.Unspecified">@L["Xfer_CommsSame"]</option>
                        <option value="@TransferHandoffKind.AorBoundary">@L["Xfer_HandoffAor"]</option>
                        <option value="@TransferHandoffKind.Point">@L["Xfer_HandoffPoint"]</option>
                        <option value="@TransferHandoffKind.Custom">@L["Xfer_HandoffCustom"]</option>
                    </select>
                </div>
                @if (ff.CommsKind is TransferHandoffKind.Point or TransferHandoffKind.Custom)
                {
                    <div class="field"><label>@L["Xfer_HandoffWhere"]</label>
                        <input placeholder="@L["Xfer_HandoffLabelPh"]" @bind="ff.CommsLabel" @bind:event="oninput" />
                    </div>
                }
            </div>
        }

        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Speed"]</label>
                <select @bind="ff.SpeedConstraint">
                    <option value="@SpeedConstraint.Unspecified">@L["Xfer_SpeedNone"]</option>
                    <option value="@SpeedConstraint.AtOrBelow">≤</option>
                    <option value="@SpeedConstraint.AtOrAbove">≥</option>
                    <option value="@SpeedConstraint.Exact">=</option>
                </select>
            </div>
            @if (ff.SpeedConstraint != SpeedConstraint.Unspecified)
            {
                <div class="field"><label>kt</label>
                    <input type="number" placeholder="250" @bind="ff.SpeedValue" @bind:event="oninput" />
                </div>
            }
        </div>

        @if (inGroup)
        {
            <label class="xt-check xt-groupwide" title="@L["Xfer_GroupWideTitle"]">
                <input type="checkbox" @bind="ff.IsGroupWide" /> @L["Xfer_GroupWide"]
            </label>
        }
    };

    // Aree filtrate per testo (typeahead): match sul nome (case-insensitive); vuoto = tutte.
    private IEnumerable<SpecialAreaPick> MatchAreas(string text) =>
        string.IsNullOrWhiteSpace(text) ? _areas : _areas.Where(a => a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));

    // Risoluzione/scelta di area e ricevente: una coppia sola, perché il form è uno solo (in due istanze).
    // Prima erano quattro metodi con prefisso diverso che facevano la stessa cosa.
    private void ResolveArea(PointForm form) =>
        form.AreaLabel = _areas.FirstOrDefault(a => string.Equals(a.Name, form.AreaText.Trim(), StringComparison.OrdinalIgnoreCase))?.Name ?? "";
    private void PickArea(PointForm form, SpecialAreaPick? a) { form.AreaLabel = a?.Name ?? ""; form.AreaText = a?.Name ?? ""; form.AreaOpen = false; }

    private void ResolveNext(PointForm form) =>
        form.Next = _all.FirstOrDefault(s => string.Equals(s.Callsign, form.NextText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private void PickNext(PointForm form, GlobalSectorRow s)
    {
        form.Next = s.Id; form.NextText = s.Callsign; form.NextOpen = false;
        // Preset: scegliendo un APP come ricevente, la riga è quasi sempre un accordo a due eventi. La faccetta
        // si apre già sulla forma tipica invece di restare chiusa e obbligare a un giro in più. Solo se l'utente
        // non l'ha già toccata — un preset che sovrascrive una scelta fatta è un bug, non una comodità.
        if (s.Type == SectorType.App && form.Facet.Kind == TransferHandoffKind.Unspecified) form.Facet.Reset(preset: true);
    }

    // Etichetta piste combinata ("16R / 16L"), in ordine di pista dell'aeroporto; soft-ref pista solo se singola.
    private string RunwaysLabel(string[] idents)
    {
        var ordered = _condRunways.Count > 0
            ? _condRunways.Where(r => idents.Contains(r.Ident, StringComparer.OrdinalIgnoreCase)).Select(r => r.Ident)
            : idents;
        return string.Join(" / ", ordered);
    }

    private int? ResolveRwyRef(string[] idents) =>
        idents.Length == 1
            ? _condRunways.FirstOrDefault(r => string.Equals(r.Ident, idents[0], StringComparison.OrdinalIgnoreCase))?.Id
            : null;

    // Riporta un'etichetta piste ("16R / 16L", tollera il vecchio prefisso "RWY ") all'insieme di ident selezionati.
    private static string[] ParseRwys(string? label) =>
        (label ?? "").Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => s.StartsWith("RWY ", StringComparison.OrdinalIgnoreCase) ? s[4..].Trim() : s)
            .ToArray();

    // Dropdown ricerca aperto?
    // Dropdown aperti dei picker che NON stanno nel form riga (nuovo gruppo, aeroporto): quelli del form
    // vivono dentro PointForm, accanto ai valori che filtrano.
    private bool _fOpen, _aOpen;

    private void ResolveFSector() =>
        _fSector = OwnSectors().FirstOrDefault(s => string.Equals(s.Callsign, _fSectorText.Trim(), StringComparison.OrdinalIgnoreCase))?.Id ?? 0;

    private static bool Match(GlobalSectorRow s, string text) =>
        string.IsNullOrWhiteSpace(text) || s.Callsign.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private void PickFSector(GlobalSectorRow s) { _fSector = s.Id; _fSectorText = s.Callsign; _fOpen = false; }

    private static bool MatchApt(AirportAdminRow a, string text) =>
        string.IsNullOrWhiteSpace(text)
        || a.Icao.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)
        || a.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase);

    private void PickApt(AirportAdminRow a) { _fApt = a.Icao; _fAptName = ""; _aOpen = false; }

    // Aeroporto fuori DB (nuovo/estero) senza nome: va bloccato, il nome è obbligatorio per gli aeroporti a mano.
    private bool NewAptMissingName(string icao, string name) =>
        !string.IsNullOrWhiteSpace(icao) && !IsKnownApt(icao) && string.IsNullOrWhiteSpace(name);

    // Aeroporto già nel catalogo DB? Se sì il nome viene da lì e non serve chiederlo.
    private bool IsKnownApt(string icao) =>
        _airports.Any(a => string.Equals(a.Icao, icao.Trim(), StringComparison.OrdinalIgnoreCase));

    // Cerca il nome dell'aeroporto fuori DB su IVAO (per-ICAO, anche estero) e riempie il campo nome.
    // NON lo aggiunge al catalogo: resta un nome libero sul flusso (così non compare nei picker «Nuovo documento»).
    private async Task LookupApt(bool edit)
    {
        var icao = ((edit ? _efApt : _fApt) ?? "").Trim().ToUpperInvariant();
        if (icao.Length < 3) { SetAptMsg(edit, L["Xfer_TypeIcaoFirst"]); return; }
        _busy = true;
        SetAptMsg(edit, L["Xfer_SearchingIvao"]);
        await InvokeAsync(StateHasChanged);
        try
        {
            var info = await Struct.LookupExternalAirportAsync(icao);
            if (info is null) { SetAptMsg(edit, string.Format(L["Xfer_NotFoundIvao"].Value, icao)); }
            else
            {
                if (edit) _efAptName = info.Name; else _fAptName = info.Name;
                var extra = string.Join(" · ", new[] { info.City, info.AccCode }.Where(s => !string.IsNullOrWhiteSpace(s)));
                SetAptMsg(edit, $"✓ {info.Icao} — {info.Name}{(extra.Length > 0 ? $" ({extra})" : "")}");
            }
        }
        catch (Exception ex) { SetAptMsg(edit, L["Common_Error"] + ex.Message); }
        finally { _busy = false; }
    }

    private void SetAptMsg(bool edit, string msg) { if (edit) _efAptMsg = msg; else _fAptMsg = msg; }

    // ICAO già cercati in auto (per non ripetere la chiamata IVAO a ogni blur dello stesso codice).
    private readonly HashSet<string> _autoLookedUp = new(StringComparer.OrdinalIgnoreCase);

    private async Task OnAptBlur()
    {
        _aOpen = false;
        await MaybeAutoLookup(false);
    }

    // Aeroporto fuori DB e senza nome ancora: cerca il nome su IVAO senza attendere il click sul bottone 🔍.
    // Una sola volta per ICAO; il bottone manuale resta come re-trigger (bypassa il guard).
    private async Task MaybeAutoLookup(bool edit)
    {
        var icao = ((edit ? _efApt : _fApt) ?? string.Empty).Trim().ToUpperInvariant();
        if (icao.Length < 4 || IsKnownApt(icao)) return;
        if (!string.IsNullOrWhiteSpace(edit ? _efAptName : _fAptName)) return;
        if (!_autoLookedUp.Add(icao)) return;
        await LookupApt(edit);
    }

    // Etichetta header aeroporto: «✈ ICAO — Nome» (catalogo DB o nome salvato sul flusso); «Senza aeroporto» se null.
    private string AptHeader(string? icao)
    {
        if (string.IsNullOrWhiteSpace(icao)) return L["Xfer_NoAirportHdr"];
        var name = _airports.FirstOrDefault(a => string.Equals(a.Icao, icao, StringComparison.OrdinalIgnoreCase))?.Name
            ?? _flows.FirstOrDefault(f => string.Equals(f.AirportIcao, icao, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(f.AirportName))?.AirportName;
        return string.IsNullOrWhiteSpace(name) ? $"✈ {icao}" : $"✈ {icao} — {name}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Authz.IsAdmin) return;
        // Il selettore ACC legge Stations.Accs nel RENDER: va scaldato ORA, con il context libero e
        // sequenziale. Senza, il lazy-load parte durante il render e il circuito muore con «A second
        // operation was started» (verifica live A6 su MariaDB: la pagina non si apriva affatto).
        Stations.Prewarm();
        _all = await Struct.ListSectorNodesAsync();
        _airports = await Struct.ListAllAirportsAsync();
        // Coppie confinanti: abilitano i settori esteri come MITTENTI (direzione estero→home nelle vLOA).
        _candidates = await Neighbours.ListAsync();
    }

    private Task SelectAcc(string code)
    {
        _accCode = code;
        return OnAccChanged();
    }

    private async Task OnAccChanged()
    {
        _status = _error = null;
        _addPointFlowId = null; _cloneFlowId = null; _editFlowId = null; _editPointId = null;
        _fSector = 0; _fSectorText = ""; _fApt = ""; _fAptName = ""; _fDesc = "";
        _acc = string.IsNullOrWhiteSpace(_accCode) ? null : Stations.Resolve(_accCode);
        if (_acc is null) { _flows = Array.Empty<TransferFlowRow>(); _areas = Array.Empty<SpecialAreaPick>(); _preview = null; return; }
        _areas = await AccDeriv.ListSpecialAreasByAccAsync(_acc.Code);
        await LoadAsync();   // popola anche _preview
        CollapseAll();
    }

    private async Task LoadAsync()
    {
        _flows = await Transfers.ListFlowsByAccAsync(_acc!.Code);
        // Rinfresca il contesto anteprima (mappe aeroporti/nomi) così le frasi riflettono l'ultima modifica.
        _preview = await AccDeriv.GetPreviewContextAsync(_acc.Code);
    }

    // Su scelta ACC parti con tutto collassato: riempi i set di collasso con tutte le chiavi correnti.
    private void CollapseAll()
    {
        _collapsedSec.Clear(); _collapsedApt.Clear(); _collapsedFlow.Clear();
        foreach (var f in _flows)
        {
            _collapsedSec.Add(f.OwningSectorCallsign);
            _collapsedApt.Add($"{f.OwningSectorCallsign}|{f.AirportIcao}");
            _collapsedFlow.Add(f.Id);
        }
    }

    // Espandi tutto: svuota i set di collasso (tutti i livelli aperti).
    private void ExpandAll() { _collapsedSec.Clear(); _collapsedApt.Clear(); _collapsedFlow.Clear(); }

    // Apre il percorso (settore ▸ aeroporto ▸ flusso) fino a un flusso specifico: usato dopo add/clona/edit così il
    // gruppo toccato è subito visibile anche se il ramo era collassato.
    private void ExpandTo(int flowId)
    {
        var f = _flows.FirstOrDefault(x => x.Id == flowId);
        if (f is null) return;
        _collapsedSec.Remove(f.OwningSectorCallsign);
        _collapsedApt.Remove($"{f.OwningSectorCallsign}|{f.AirportIcao}");
        _collapsedFlow.Remove(f.Id);
    }

    // Anteprima frase di una riga esistente (lettura). Null = dati incompleti / UNICOM (nessuna frase, come la derivazione).
    /// <summary>
    /// Anteprima della riga che il pannello sta scrivendo. La catena delle condizioni parte dagli ANTENATI
    /// SALVATI e finisce su quella in scrittura: l'anteprima deve mostrare la frase che il documento renderà,
    /// e quella cumula. Coi soli campi del form direbbe «R403B attiva» dove il documento dirà «con pista 07 in
    /// uso e R403B attiva».
    /// </summary>
    private string? PreviewForm(TransferFlowRow f, PointForm form)
    {
        var editing = f.Points.FirstOrDefault(x => x.Id == _editPointId);
        var chain = editing is null
            ? new List<ConditionClause>()
            : CoordinationDerivation.ConditionChain(f.Points, editing).SkipLast(1).ToList();
        chain.Add(new ConditionClause(
            form.Rwys.Length == 0 ? null : RunwaysLabel(form.Rwys), form.AreaLabel, form.CustomLabel));

        // In aggiunta il CoP può essere una lista: si mostra il primo come esempio.
        var cop = _editPointId is null ? (SplitCops(form.Cop).FirstOrDefault() ?? "") : form.Cop;

        return _preview?.Compose(f.OwningSectorCallsign, form.Next == 0 ? null : form.NextText, f.AirportIcao, f.Kind,
            form.Constraint, form.Value, form.Unit, form.Special, form.Parity, form.VState, cop,
            chain, form.Facet.ToFacet());
    }

