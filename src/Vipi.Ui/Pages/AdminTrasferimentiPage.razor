    private async Task ConfirmCopyFrom(TransferFlowRow dest)
    {
        var src = _flows.FirstOrDefault(x => x.Id == _copySourceFlowId);
        if (src is null) return;
        await Guarded(async () =>
        {
            // Le righe arrivano piatte: il GRUPPO di varianti appartiene al flusso d'origine, e ricrearlo qui
            // vorrebbe dire inventare legami che nessuno ha chiesto — come già per la clonazione di un gruppo.
            foreach (var p in src.Points) await Transfers.AddPointAsync(_acc!.Code, dest.Id, FromRow(p));
            _copyFromFlowId = null;
        }, string.Format(L["Xfer_CopiedRows"].Value, src.Points.Count));
    }

