@page "/vsop/admin/trasferimenti"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject IAgreementService Agreements
@inject IStructureEditingService Struct
@inject IEditAuthorizationService Authz
@inject INeighbourReader Neighbours
@inject IAirportEditingService Airports
@inject IAccDerivationService AccDeriv
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
    Editor degli ACCORDI di coordinamento.

    L'asse è cambiato con il modello (carta: docs/feature/2026-08-16-accordi-di-coordinamento.md): non più
    «flussi di un settore verso un aeroporto» ma accordi fra due parti, con più mittenti, più aeroporti, più
    punti per clausola e fino a due versi. Il guscio a tre colonne resta quello di agosto, e con lui tutte le
    misure che sono costate: il corpo che scorre, il piede che tiene i tasti, il trascinamento del sottoalbero,
    l'annulla che rimette l'outline, la scrittura in cella.
*@

<PageTitle>@L["Xfer_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap struct">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/admin/permessi">@L["Common_StaffArea"]</a> › <a href="/vsop/admin/sectorstructure">@L["Struct_Title"]</a> › <b>@L["Xfer_Title"]</b></div>
    <div class="doc-head">
        <div><h2 class="xt-h2">@L["Xfer_Heading"]</h2><span class="muted">@((MarkupString)L["Xfer_Subtitle"].Value)</span></div>
    </div>

    @if (!Authz.IsAdmin)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@L["Common_AdminOnly"]</div></div>
    }
    else
    {
        @if (_error is not null || _status is not null)
        {
            <div class="toast-fixed">
                @if (_error is not null)
                {
                    <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div><button class="tclose" title="@L["Common_Close"]" @onclick="() => _error = null">✕</button></div>
                }
                else
                {
                    <div class="callout success">
                        <span class="cic">✓</span>
                        <div>@_status</div>
                        @* L'annulla vive quanto il messaggio che lo propone: finché è a schermo funziona, la
                           prima operazione successiva o la sua chiusura se lo portano via. Non un timer di
                           dieci secondi — un timer va comunicato con un conto alla rovescia, altrimenti il
                           tasto sparisce mentre lo si sta guardando; qui la regola è una sola, e si vede. *@
                        @if (_undo is not null)
                        {
                            <button class="btn ghost xt-undo" disabled="@(_busy || !_canEdit)" @onclick="Undo">↺ @L["Xfer_Undo"]</button>
                        }
                        <button class="tclose" title="@L["Common_Close"]" @onclick="ClearToast">✕</button>
                    </div>
                }
            </div>
        }

        <EditLockBar ResourceKey="@ResourceLockKeys.Structure" LockChanged="OnLockChanged" ExpiresChanged="OnLockExpiry" />

        @* Il lock scadeva senza preavviso: si stava scrivendo e la pagina tornava in sola lettura. *@
        @if (LockEndingSoon)
        {
            <div class="callout warning">
                <span class="cic">⏳</span>
                <div>
                    <p class="ct">@L["Xfer_LockEndingTitle"]</p>
                    @(string.Format(L["Xfer_LockEndingBody"].Value, _lockExpiresUtc!.Value.ToLocalTime().ToString("HH:mm")))
                </div>
            </div>
        }

        @* ---- Scelta ACC ----
           Una barra e non un blocco titolato: la scelta dell'ACC è un interruttore, e prendeva l'altezza di una
           sezione sopra il lavoro vero. *@
        <div class="xt-accbar">
            <span class="xt-acclbl">ACC</span>
            @if (Stations.Accs.Count == 0)
            {
                <span class="help">@((MarkupString)L["Xfer_NoAccImport"].Value)</span>
            }
            else
            {
                @foreach (var a in Stations.Accs)
                {
                    var active = string.Equals(_accCode, a.Code, StringComparison.OrdinalIgnoreCase);
                    <button class="btn @(active ? "primary" : "ghost")" disabled="@(_busy)" title="@a.Name" @onclick="() => SelectAcc(a.Code)">@a.Code</button>
                }
            }
        </div>

        @if (_acc is null)
        {
            <p class="help">@L["Xfer_ChooseAcc"]</p>
        }
        else
        {
            var shown = FilteredAgreements();
            var tableRows = _view == XferView.Flat ? FlatRows(shown) : SelectedAgreementRows();
            var shownClauses = _view == XferView.Flat ? tableRows.Count : shown.Sum(a => a.Clauses.Count);

            @* ---- Barra: filtri, vista, ordinamento ---- *@
            <div class="xfe-filters xt-bar">
                <input class="htree-search xt-search" placeholder="@L["Xfer_FilterPh"]"
                       @bind="_filter" @bind:event="oninput" />
                <select @bind="_kindFilter">
                    <option value="">@L["Xfer_AllKinds"]</option>
                    <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                    <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                    <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                    <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                    <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                </select>
                <span class="muted xt-count">@AgreementsCountLabel(shown.Count) · @(string.Format(L["Xfer_ClausesCount"].Value, shownClauses))</span>
                @* Un accordo senza ricevente manda il traffico a UNICOM: va trovato, non cercato. *@
                @{ var noRecv = _agreements.Count(NoReceiver); }
                @if (noRecv > 0 || _noReceiverOnly)
                {
                    <button class="btn @(_noReceiverOnly ? "primary" : "ghost")" title="@L["Xfer_NoReceiverTitle"]"
                            @onclick="ToggleNoReceiverFilter">⚠ @L["Xfer_NoReceiverFilter"] (@noRecv)</button>
                }
                @* Le clausole ACC→APP scritte prima della faccetta non dicono dove avviene il trasferimento e
                   vanno riviste a mano: senza un modo di elencarle, la revisione si perde per strada. *@
                @{ var toReview = ToReviewCount(); }
                @if (toReview > 0 || _toReviewOnly)
                {
                    <button class="btn @(_toReviewOnly ? "primary" : "ghost")"
                            title="@L["Xfer_ToReviewTitle"]" @onclick="ToggleToReviewFilter">
                        ⚠ @L["Xfer_ToReview"] (@toReview)
                    </button>
                }
                @if (_filtering) { <button class="btn ghost" @onclick="ResetFilters">↺ @L["Xfer_Reset"]</button> }
                <span class="ln xt-grow"></span>
                @* I due filtri diagnostici attraversano gli accordi: in ALBERO si trova l'accordo e si apre, in
                   ELENCO si vedono tutte le clausole che li fanno scattare, una sotto l'altra. È la ragione per
                   cui la vista si commuta qui, accanto ai filtri, e non altrove. *@
                <div class="xt-viewsw" role="group" aria-label="@L["Xfer_ViewLabel"]">
                    <button class="btn @(_view == XferView.Tree ? "primary" : "ghost")"
                            title="@L["Xfer_ViewTreeTitle"]" @onclick="() => SetView(XferView.Tree)">▤ @L["Xfer_ViewTree"]</button>
                    <button class="btn @(_view == XferView.Flat ? "primary" : "ghost")"
                            title="@L["Xfer_ViewFlatTitle"]" @onclick="() => SetView(XferView.Flat)">☰ @L["Xfer_ViewFlat"]</button>
                </div>
                @if (_view == XferView.Tree)
                {
                    <button class="btn ghost" title="@L["Xfer_ExpandAll"]" @onclick="ExpandAll">⊞</button>
                    <button class="btn ghost" title="@L["Xfer_CollapseAll"]" @onclick="CollapseAll">⊟</button>
                }
                @* La tendina resta all'ALBERO. In elenco ordinano le intestazioni, e due comandi per la stessa
                   cosa nello stesso posto sarebbero due verità; per giunta quattro delle sei chiavi (mittente,
                   ricevente, aeroporto, tipo) qui non avrebbero senso — dentro un accordo sono costanti. *@
                @if (_view == XferView.Tree)
                {
                    <label class="muted xt-check" title="@L["Xfer_SortNote"]">
                        @L["Xfer_SortBy"]
                        <select @bind="_sort">
                            <option value="@RowSort.Manual">@L["Xfer_SortManual"]</option>
                            <option value="@RowSort.Points">@L["Xfer_SortCop"]</option>
                            <option value="@RowSort.Level">@L["Xfer_SortLevel"]</option>
                        </select>
                    </label>
                }
                <label class="muted xt-check" title="@L["Xfer_ShowPreviewsTitle"]">
                    <input type="checkbox" checked="@_showPreviews" @onchange="TogglePreviews" /> @L["Xfer_ShowPreviews"]
                </label>
            </div>

            @* ---- Modifica in blocco ----
               ⚠️ Il RICEVENTE non è più qui, e non è una dimenticanza: era un campo di riga, adesso è il lato B
               dell'accordo e si cambia nella sua testata — una volta per accordo invece che su ogni clausola.
               Livello e condizione restano, perché sono proprio ciò che due varianti dicono diverso. *@
            @if (_selected.Count > 0)
            {
                <div class="callout info xt-bulk">
                    <span class="cic">☑</span>
                    <div class="xt-bulkbody">
                        <b>@(string.Format(L["Xfer_BulkSelected"].Value, _selected.Count))</b>

                        <div class="field xt-bulkfield">
                            <input placeholder="@L["Xfer_BulkLevel"]" title="@L["Xfer_BulkLevelTitle"]"
                                   @bind="_bulkLevelText" @bind:event="oninput" />
                        </div>
                        <button class="btn ghost" disabled="@(_busy || !_canEdit || string.IsNullOrWhiteSpace(_bulkLevelText))"
                                @onclick="ApplyBulkLevel">@L["Xfer_BulkApplyLevel"]</button>

                        @* Condizione: area + testo libero. Niente piste — dipendono dall'aeroporto, e con un
                           accordo che può averne quattro la stessa sigla è ancora più ambigua di prima. *@
                        <TypeaheadPicker Class="xt-bulkpick" Placeholder="@L["Xfer_BulkArea"]"
                                         Items="AreaItems(_bulkAreaText)" EmptyOption="@L["Xfer_AreaNone"]"
                                         NoMatch="@L["Xfer_NoArea"]" @bind-Text="_bulkAreaText" />
                        <div class="field xt-bulkfield">
                            <input placeholder="@L["Xfer_BulkCustom"]" @bind="_bulkCustomText" @bind:event="oninput" />
                        </div>
                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_BulkConditionTitle"]"
                                @onclick="ApplyBulkCondition">@L["Xfer_BulkApplyCondition"]</button>

                        <span class="ln xt-grow"></span>
                        <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_BulkDeleteAria"]" Disabled="@(_busy || !_canEdit)"
                                       Prompt="@(string.Format(L["Xfer_BulkDeletePrompt"].Value, _selected.Count))"
                                       OnConfirm="DeleteBulk"><Trigger><Icon Name="x" /> @L["Common_Delete"]</Trigger></InlineConfirm>
                        <button class="btn ghost" @onclick="() => _selected.Clear()">@L["Xfer_BulkClear"]</button>
                    </div>
                </div>
            }

            @* ---- Tre colonne: si sceglie · si lavora · si scrive ----
               Ognuna scorre per conto proprio dentro l'altezza dello schermo. È la differenza che toglie
               l'attrito più caro della pagina vecchia: il pannello non finisce mai «dopo la lista», perché
               sopra di lui non c'è più una lista. *@
            @* Il pannello vuoto si ritira SOLO in elenco, dove la tabella ha dieci colonne e ha bisogno della
               larghezza. In albero resta: lì lo spazio c'è, e una colonna che dice cosa fare vale più di 380 px. *@
            <div class="xfe-layout3 @(_view == XferView.Flat ? "xt-noNav" : "") @(_view == XferView.Flat && _clauseForm is null ? "xt-noPanel" : "")">
                @if (_view == XferView.Tree)
                {
                    <XferNavigator Counterparts="BuildNav(shown)" SelectedId="_selectedId"
                                   Collapsed="_collapsed" ForceOpen="_filtering" Filtered="_filtering"
                                   Disabled="@(_busy || !_canEdit)"
                                   OnToggle="ToggleNode" OnSelect="SelectAgreement" OnNew="OpenNewAgreement" />
                }

                <section class="xt-pane">
                    @WorkPane(shown, tableRows)
                </section>

                @if (_view == XferView.Tree || _clauseForm is not null)
                {
                    <aside id="xt-panel" class="xt-panel">
                        @ClausePanel()
                    </aside>
                }
            </div>
        }
    }
</div>

@code {
    private string _accCode = "";
    private AccInfo? _acc;
    private IReadOnlyList<AgreementRow> _agreements = Array.Empty<AgreementRow>();
    private IReadOnlyList<GlobalSectorRow> _all = Array.Empty<GlobalSectorRow>();
    private IReadOnlyList<AirportAdminRow> _airports = Array.Empty<AirportAdminRow>();
    private IReadOnlyList<NeighbourCandidateRow> _candidates = Array.Empty<NeighbourCandidateRow>();
    private bool _busy;
    private bool _canEdit;   // true = questa sessione tiene il lock di struttura (EditLockBar)
    private string? _status, _error;

    // Anteprima frasi: contesto (mappe + template) caricato alla scelta dell'ACC; compone in locale (nessun
    // round-trip per tasto). _showPreviews = mostra la frase risultante sotto ogni clausola (default on).
    private CoordinationPreviewContext? _preview;
    private bool _showPreviews = true;

    private void OnLockChanged(bool mine) { _canEdit = mine; StateHasChanged(); }

    // Scadenza del lock: arriva a ogni battito (60s), che è anche la frequenza con cui l'avviso si aggiorna.
    private DateTime? _lockExpiresUtc;
    private void OnLockExpiry(DateTime? utc) { _lockExpiresUtc = utc; StateHasChanged(); }

    /// <summary>
    /// Il lock sta per scadere DAVVERO. La soglia è 60 secondi e non cinque minuti perché il TTL del lock è di
    /// tre (<c>ResourceLockService.LockTtlMinutes</c>): a cinque minuti la condizione sarebbe sempre vera e
    /// l'avviso sempre acceso — provato a schermo, compariva su ogni caricamento.
    /// </summary>
    private bool LockEndingSoon =>
        _canEdit && _lockExpiresUtc is { } e && e - DateTime.UtcNow <= TimeSpan.FromSeconds(60) && e > DateTime.UtcNow;

    /// <summary>Nodi del navigatore chiusi (chiavi presenti = collassate). L'accordo è una foglia: si sceglie.</summary>
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>Come si guarda l'elenco. Non è una preferenza estetica: sono due modi di lavorare diversi.</summary>
    private enum XferView
    {
        /// <summary>Albero: si sceglie un accordo e si lavora su quello. È il modo di <b>scrivere</b>.</summary>
        Tree,

        /// <summary>Elenco: tutte le clausole dell'ACC in una tabella sola. È il modo di <b>rivedere</b> — per
        /// trovare le righe senza ricevente o da rivedere, l'albero è il nemico.</summary>
        Flat,
    }

    private XferView _view = XferView.Tree;

    /// <summary>L'accordo aperto nel riquadro di lavoro. Null = nessuno scelto (o se ne sta creando uno).</summary>
    private int? _selectedId;

    /// <summary>Il riquadro di lavoro sta mostrando il form dell'accordo nuovo.</summary>
    private bool _newOpen;

    /// <summary>Il verso che si sta guardando. Un accordo a un verso solo non mostra il selettore.</summary>
    private AgreementDirection _direction = AgreementDirection.AtoB;

    // ---- Form dell'INTESTAZIONE dell'accordo ---------------------------------------------------------
    // Un tipo e non venti campi sciolti: le istanze sono due (nuovo e modifica) e i campi sono elenchi, che
    // duplicati a mano sono due occasioni di aggiornarne uno solo.

    private sealed class HeaderForm
    {
        public TransferFlowKind Kind { get; set; } = TransferFlowKind.Arrival;
        public string Description { get; set; } = "";

        /// <summary>Gli enti dei due lati, per callsign: l'id lo risolve la pagina al salvataggio, così un
        /// callsign scritto a mano e poi corretto non lascia in giro un id vecchio.</summary>
        public List<string> SideA { get; } = new();
        public List<string> SideB { get; } = new();
        public string SideAText { get; set; } = "";
        public string SideBText { get; set; } = "";

        /// <summary>Gli aeroporti (ICAO → nome libero per quelli fuori catalogo).</summary>
        public List<AgreementAirportInput> Airports { get; } = new();
        public string AirportText { get; set; } = "";
        public string AirportName { get; set; } = "";

        public void Reset()
        {
            Kind = TransferFlowKind.Arrival; Description = "";
            SideA.Clear(); SideB.Clear(); SideAText = ""; SideBText = "";
            Airports.Clear(); AirportText = ""; AirportName = "";
        }

        public void LoadFrom(AgreementRow a)
        {
            Reset();
            Kind = a.TrafficKind;
            Description = a.Description ?? "";
            SideA.AddRange(a.Parties.Where(p => p.Side == AgreementSide.A).OrderBy(p => p.Order).Select(p => p.Callsign));
            SideB.AddRange(a.Parties.Where(p => p.Side == AgreementSide.B).OrderBy(p => p.Order).Select(p => p.Callsign));
            Airports.AddRange(a.Airports.OrderBy(x => x.Order).Select(x => new AgreementAirportInput(x.Icao, x.Name)));
        }
    }

    private readonly HeaderForm _newForm = new();
    private readonly HeaderForm _editForm = new();

    /// <summary>L'accordo di cui si sta modificando l'intestazione in-place; null = nessuno.</summary>
    private int? _editHeaderId;

    // ---- Form della CLAUSOLA ------------------------------------------------------------------------
    // Come prima, un tipo solo in due istanze. Rispetto alla riga di ieri manca il RICEVENTE: è dell'accordo.

    private sealed class ClauseForm
    {
        public string Points { get; set; } = "";
        public LevelConstraint Constraint { get; set; } = LevelConstraint.AtOrBelow;
        public int? Value { get; set; }
        public LevelUnit Unit { get; set; } = LevelUnit.Fl;
        public string Special { get; set; } = "";
        public LevelParity Parity { get; set; } = LevelParity.Any;
        public TransferVerticalState VState { get; set; } = TransferVerticalState.Unspecified;

        // Condizione: tre dimensioni indipendenti (tutte opzionali).
        public string[] Rwys { get; set; } = Array.Empty<string>();
        public string AreaLabel { get; set; } = "";
        public string AreaText { get; set; } = "";
        public string CustomLabel { get; set; } = "";

        public FacetForm Facet { get; } = new();

        /// <summary>Firma dei valori: serve a dire se il form è stato TOCCATO. «Modifiche non salvate» deve
        /// dire modifiche — legarlo al solo pannello aperto lo accendeva appena si apriva una clausola.</summary>
        /// <summary>Separatore che non puo' comparire in nessun campo: la firma serve a confrontare, non a
        /// leggere, e un separatore stampabile renderebbe due form diversi indistinguibili appena qualcuno
        /// digita quel carattere.</summary>
        private const char Sep = '\u001f';

        public string Signature() => string.Join(Sep, new[]
        {
            Points, Constraint.ToString(), Value?.ToString() ?? "", Unit.ToString(), Special,
            Parity.ToString(), VState.ToString(),
            string.Join(',', Rwys), AreaLabel, CustomLabel,
            Facet.Kind.ToString(), Facet.Label, Facet.LevelValue?.ToString() ?? "",
            Facet.LevelUnit.ToString(), Facet.LevelConstraint.ToString(),
            Facet.CommsKind.ToString(), Facet.CommsLabel,
            Facet.SpeedValue?.ToString() ?? "", Facet.SpeedConstraint.ToString(), Facet.IsGroupWide.ToString(),
        });

        public void Reset()
        {
            Points = ""; Constraint = LevelConstraint.AtOrBelow; Value = null; Unit = LevelUnit.Fl; Special = "";
            Parity = LevelParity.Any; VState = TransferVerticalState.Unspecified;
            Rwys = Array.Empty<string>(); AreaLabel = ""; AreaText = ""; CustomLabel = "";
            Facet.Reset();
        }

        public void LoadFrom(AgreementClauseRow c, Func<string?, string[]> parseRwys)
        {
            Points = c.Cops; Constraint = c.LevelConstraint; Value = c.LevelValue; Unit = c.LevelUnit;
            Special = c.LevelSpecial ?? ""; Parity = c.Parity; VState = c.VerticalState;
            Rwys = parseRwys(c.ConditionLabel);
            AreaLabel = c.ConditionAreaLabel ?? ""; AreaText = c.ConditionAreaLabel ?? "";
            CustomLabel = c.ConditionCustomLabel ?? "";
            Facet.LoadFrom(c);
        }
    }

    /// <summary>
    /// Stato del form per la faccetta TRASFERIMENTO (dove passa il controllo, a che livello, dove passano le
    /// comunicazioni, velocità, «scavalca le alternative»).
    /// </summary>
    private sealed class FacetForm
    {
        public TransferHandoffKind Kind { get; set; } = TransferHandoffKind.Unspecified;
        public string Label { get; set; } = "";
        public int? LevelValue { get; set; }
        public LevelUnit LevelUnit { get; set; } = LevelUnit.Fl;
        public LevelConstraint LevelConstraint { get; set; } = LevelConstraint.Exact;
        public TransferHandoffKind CommsKind { get; set; } = TransferHandoffKind.Unspecified;
        public string CommsLabel { get; set; } = "";
        public int? SpeedValue { get; set; }
        public SpeedConstraint SpeedConstraint { get; set; } = SpeedConstraint.Unspecified;
        public bool IsGroupWide { get; set; }

        public void LoadFrom(AgreementClauseRow c)
        {
            Kind = c.HandoffKind; Label = c.HandoffLabel ?? "";
            LevelValue = c.HandoffLevelValue; LevelUnit = c.HandoffLevelUnit;
            // Su una clausola che la faccetta non l'ha mai usata, il vincolo salvato è il valore di riposo della
            // colonna (AtOrAbove, lo zero dell'enum) e non una scelta di nessuno: caricarlo farebbe partire il
            // form da «o superiore» e la prima faccetta scritta direbbe la forma sbagliata. Trovato guidando
            // l'editor: la frase usciva «al confine dell'AoR a FL110 o superiore» invece di «passando FL110».
            LevelConstraint = c.HandoffKind == TransferHandoffKind.Unspecified
                ? LevelConstraint.Exact
                : c.HandoffLevelConstraint;
            CommsKind = c.CommsHandoffKind; CommsLabel = c.CommsHandoffLabel ?? "";
            SpeedValue = c.SpeedValue; SpeedConstraint = c.SpeedConstraint;
            IsGroupWide = c.IsGroupWide;
        }

        /// <summary>Svuota il form. Con <paramref name="preset"/> apre già la faccetta sul caso più comune —
        /// «al confine dell'AoR, passando un livello» — che è la forma di un accordo ACC→APP.</summary>
        public void Reset(bool preset = false)
        {
            Kind = preset ? TransferHandoffKind.AorBoundary : TransferHandoffKind.Unspecified;
            Label = ""; LevelValue = null; LevelUnit = LevelUnit.Fl; LevelConstraint = LevelConstraint.Exact;
            CommsKind = TransferHandoffKind.Unspecified; CommsLabel = "";
            SpeedValue = null; SpeedConstraint = SpeedConstraint.Unspecified;
            IsGroupWide = false;
        }

        public TransferHandoffFacet ToFacet() => new(
            Kind, Label, LevelValue, LevelUnit, LevelConstraint,
            CommsKind, CommsLabel, SpeedValue, SpeedConstraint, IsGroupWide);

        /// <summary>Riversa la faccetta nell'input di salvataggio (l'input è un record: <c>with</c> tiene
        /// insieme i campi senza ricopiare gli altri quindici).</summary>
        public AgreementClauseInput Apply(AgreementClauseInput input) => input with
        {
            HandoffKind = Kind,
            HandoffLabel = string.IsNullOrWhiteSpace(Label) ? null : Label.Trim(),
            HandoffLevelValue = LevelValue,
            HandoffLevelUnit = LevelUnit,
            HandoffLevelConstraint = LevelConstraint,
            CommsHandoffKind = CommsKind,
            CommsHandoffLabel = string.IsNullOrWhiteSpace(CommsLabel) ? null : CommsLabel.Trim(),
            SpeedValue = SpeedValue,
            SpeedConstraint = SpeedConstraint,
            IsGroupWide = IsGroupWide,
        };
    }

    private readonly ClauseForm _addClause = new();
    private readonly ClauseForm _editClause = new();
    private int? _addClauseAgreementId;
    private int? _editClauseId;

    /// <summary>Il form aperto adesso: la modifica vince sull'aggiunta, come nell'ordine in cui li si apre.</summary>
    private ClauseForm? _clauseForm => _editClauseId is not null ? _editClause : _addClauseAgreementId is not null ? _addClause : null;

    /// <summary>Piste reali degli aeroporti dell'accordo in editing (opzioni condizione «Pista»). Un accordo può
    /// avere più scali: le piste si uniscono, e quando gli scali sono più d'uno la sigla porta il suo ICAO —
    /// «16R» su due aeroporti diversi sono due piste diverse.</summary>
    private IReadOnlyList<RunwayOption> _condRunways = Array.Empty<RunwayOption>();

    /// <summary>Una pista selezionabile: come si legge, e l'id per il soft-ref. L'etichetta porta l'ICAO quando
    /// l'accordo ha piu' di un aeroporto — «16R» su Fiumicino e su Malpensa sono due piste diverse.</summary>
    private sealed record RunwayOption(string Label, string Ident, int Id);

    /// <summary>Aree speciali dell'ACC corrente (opzioni condizione «Area»); caricate alla scelta dell'ACC.</summary>
    private IReadOnlyList<SpecialAreaPick> _areas = Array.Empty<SpecialAreaPick>();

    // Filtri.
    private string _filter = "";
    private TransferFlowKind? _kindFilter;

    /// <summary>Un filtro attivo espande l'albero: quello che resta va visto, non ricercato a mano cliccando.</summary>
    private bool _filtering =>
        !string.IsNullOrWhiteSpace(_filter) || _kindFilter is not null || _toReviewOnly || _noReceiverOnly;

    private bool _toReviewOnly;
    private bool _noReceiverOnly;

    /// <summary>
    /// I due filtri diagnostici parlano di CLAUSOLE (o di accordi interi, per il ricevente): accendendoli si
    /// vuole vedere quelle righe, non l'accordo che le contiene insieme a tutte le altre. Per questo
    /// l'accensione porta direttamente in elenco.
    /// </summary>
    private void ToggleNoReceiverFilter()
    {
        _noReceiverOnly = !_noReceiverOnly;
        if (_noReceiverOnly) SetView(XferView.Flat);
    }

    private void ToggleToReviewFilter()
    {
        _toReviewOnly = !_toReviewOnly;
        if (_toReviewOnly) SetView(XferView.Flat);
    }

    private void ResetFilters()
    {
        _filter = string.Empty; _kindFilter = null; _toReviewOnly = false; _noReceiverOnly = false;
    }

    // ---- Selezione multipla e modifica in blocco ----
    private readonly HashSet<int> _selected = new();
    private string _bulkLevelText = "", _bulkAreaText = "", _bulkCustomText = "";

    private void ToggleSelect(int clauseId)
    {
        if (!_selected.Remove(clauseId)) _selected.Add(clauseId);
    }

    private async Task ApplyBulkLevel()
    {
        if (_selected.Count == 0 || string.IsNullOrWhiteSpace(_bulkLevelText)) return;
        var ids = _selected.ToList();
        var level = LevelFormatting.Parse(_bulkLevelText);
        var n = 0;
        await Guarded(async () =>
        {
            n = await Agreements.SetLevelAsync(_acc!.Code, ids, level);
            _selected.Clear(); _bulkLevelText = "";
        }, null);
        if (n > 0) _status = string.Format(L["Xfer_BulkDone"].Value, n);
    }

    private async Task ApplyBulkCondition()
    {
        if (_selected.Count == 0) return;
        var ids = _selected.ToList();
        var area = _bulkAreaText.Trim();
        var custom = _bulkCustomText.Trim();
        var n = 0;
        await Guarded(async () =>
        {
            n = await Agreements.SetConditionAsync(_acc!.Code, ids,
                area.Length == 0 ? null : area, custom.Length == 0 ? null : custom);
            _selected.Clear(); _bulkAreaText = ""; _bulkCustomText = "";
        }, null);
        if (n > 0) _status = string.Format(L["Xfer_BulkDone"].Value, n);
    }

    private async Task DeleteBulk()
    {
        if (_selected.Count == 0) return;
        var ids = _selected.ToList();

        // Fotografia prima, annulla armato dopo, e solo se è andata.
        var snaps = _agreements
            .SelectMany(a => a.Clauses.Where(c => _selected.Contains(c.Id))
                              .Select(c => new AgreementClauseRestore(a.Id, SnapshotOf(c))))
            .ToList();

        var n = 0;
        await Guarded(async () =>
        {
            n = await Agreements.DeleteClausesAsync(_acc!.Code, ids);
            _selected.Clear();
        }, null);

        if (_error is not null) return;
        _status = string.Format(L["Xfer_BulkDeleted"].Value, n);
        if (snaps.Count > 0)
            _undo = (() => Agreements.RestoreClausesAsync(_acc!.Code, snaps), L["Xfer_RowsRestored"].Value);
    }

    // ---- Ordinamento della VISTA ----
    // Cambia solo come si guarda l'elenco: l'ordine salvato è la struttura dell'outline e non si tocca mai da
    // qui. Per questo l'ordinamento non-manuale disabilita il trascinamento: sarebbero due verità.
    private enum RowSort { Manual, Points, Level, Sender, Receiver, Airport, Kind }

    private RowSort _sort = RowSort.Manual;
    private bool _sortDesc;

    private void SortBy(RowSort column)
    {
        if (_sort == column) { _sortDesc = !_sortDesc; return; }
        _sort = column;
        _sortDesc = false;
    }

    /// <summary>Firma del form al momento in cui si è aperto: il confronto dice se è stato toccato.</summary>
    private string _formOpenedAs = "";

    /// <summary>Il pannello ha modifiche NON SALVATE: aperto non basta, deve essere cambiato qualcosa.</summary>
    private bool HasOpenEdit => _clauseForm is { } f && f.Signature() != _formOpenedAs;

    // ---- Riordino per trascinamento ----
    private int? _dragId, _dragOver;

    private async Task DropOn(AgreementClauseRow target)
    {
        var src = _dragId; _dragId = null; _dragOver = null;
        if (src is not int id || id == target.Id || !_canEdit || _busy) return;
        await Guarded(() => Agreements.MoveClauseToAsync(_acc!.Code, id, target.Id), null);
    }

    // ---- Costruzione di ciò che si vede -------------------------------------------------------------

    private AgreementRow? SelectedAgreement() =>
        _selectedId is int id ? _agreements.FirstOrDefault(a => a.Id == id) : null;

    /// <summary>Le clausole del verso mostrato, nell'ordine della vista.</summary>
    private IReadOnlyList<XferTableRow> SelectedAgreementRows()
    {
        var a = SelectedAgreement();
        if (a is null) return Array.Empty<XferTableRow>();
        var clauses = SortedClauses(a.Clauses.Where(c => c.Direction == _direction).ToList());
        return BuildRows(clauses.Select(c => (a, c)).ToList());
    }

    private IReadOnlyList<AgreementClauseRow> SortedClauses(IReadOnlyList<AgreementClauseRow> clauses) => _sort switch
    {
        RowSort.Points => clauses.OrderBy(c => string.IsNullOrWhiteSpace(c.Cops) ? "~" : c.Cops, StringComparer.OrdinalIgnoreCase).ToList(),
        RowSort.Level => clauses.OrderBy(c => c.LevelValue ?? int.MaxValue).ThenBy(c => c.Cops, StringComparer.OrdinalIgnoreCase).ToList(),
        _ => clauses.OrderBy(c => c.Order).ToList(),
    };

    /// <summary>
    /// Tutte le clausole degli accordi mostrati, per la vista a elenco.
    /// <para>Qui i due filtri diagnostici valgono davvero <b>sulle clausole</b>: in albero possono solo
    /// restringere gli accordi, e un accordo con una clausola da rivedere su otto continuava a mostrarne otto.</para>
    /// </summary>
    private IReadOnlyList<XferTableRow> FlatRows(IReadOnlyList<AgreementRow> agreements)
    {
        var pairs = agreements
            .SelectMany(a => a.Clauses.Select(c => (Agreement: a, Clause: c)))
            .Where(x => !_noReceiverOnly || NoReceiver(x.Agreement))
            .Where(x => !_toReviewOnly || NeedsReview(x.Agreement, x.Clause));

        // «Manuale» in elenco non può essere l'ordine dell'outline (è per accordo e per verso): è l'ordine
        // dell'albero appiattito — controparte, tipo, aeroporti — e dentro l'accordo l'outline vero.
        var ordered = pairs
            .OrderBy(x => CounterpartLabel(x.Agreement), StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Agreement.TrafficKind)
            .ThenBy(x => XferLabels.Airports(x.Agreement), StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => x.Clause.Direction)
            .ThenBy(x => x.Clause.Order);

        ordered = _sort switch
        {
            RowSort.Points => Direct(ordered, x => string.IsNullOrWhiteSpace(x.Clause.Cops) ? "~" : x.Clause.Cops),
            RowSort.Level => Direct(ordered, x => (x.Clause.LevelValue ?? int.MaxValue).ToString("D6")),
            RowSort.Sender => Direct(ordered, x => SenderLabel(x.Agreement, x.Clause)),
            RowSort.Receiver => Direct(ordered, x => ReceiverLabel(x.Agreement, x.Clause)),
            RowSort.Airport => Direct(ordered, x => XferLabels.Airports(x.Agreement)),
            RowSort.Kind => Direct(ordered, x => XferLabels.Kind(L, x.Agreement.TrafficKind)),
            _ => ordered,
        };

        return BuildRows(ordered.ToList());
    }

    /// <summary>Applica la chiave scelta <b>sopra</b> l'ordine di base, nel verso corrente. Il confronto è per
    /// stringa anche sul livello (imbottito a sei cifre): una chiave sola tiene insieme i casi, e un numero
    /// ordinato come testo con la stessa larghezza si ordina come numero.</summary>
    private IOrderedEnumerable<(AgreementRow Agreement, AgreementClauseRow Clause)> Direct(
        IOrderedEnumerable<(AgreementRow Agreement, AgreementClauseRow Clause)> rows,
        Func<(AgreementRow Agreement, AgreementClauseRow Clause), string> key) =>
        _sortDesc
            ? rows.OrderByDescending(key, StringComparer.OrdinalIgnoreCase)
            : rows.OrderBy(key, StringComparer.OrdinalIgnoreCase);

    /// <summary>Le righe pronte da rendere: blocco di varianti, anteprima e riassunto della faccetta composti.</summary>
    private List<XferTableRow> BuildRows(IReadOnlyList<(AgreementRow Agreement, AgreementClauseRow Clause)> src)
    {
        var rows = new List<XferTableRow>(src.Count);
        for (var i = 0; i < src.Count; i++)
        {
            var (a, c) = src[i];
            rows.Add(new XferTableRow(a, c, GroupViewOf(src, i),
                                      _showPreviews ? PreviewOf(a, c) : null, FacetSummary(c)));
        }
        return rows;
    }

    /// <summary>
    /// Il blocco di varianti della clausola in posizione <paramref name="ix"/> della vista.
    /// <para>Apertura e chiusura si calcolano sull'ordine <b>mostrato</b> — la guida deve chiudersi dove il
    /// blocco finisce a schermo — mentre il padre si legge sull'ordine <b>salvato</b>: quello è la struttura, e
    /// ordinare la vista non la cambia.</para>
    /// <para>⚠️ Due righe adiacenti stanno nello stesso blocco solo se vengono dallo stesso accordo <b>e dallo
    /// stesso verso</b>: il numero di gruppo è progressivo per accordo, e in elenco due gruppi diversi si
    /// toccano davvero — senza questo controllo si fonderebbero in un blocco che non esiste.</para>
    /// </summary>
    private static XferGroupView GroupViewOf(IReadOnlyList<(AgreementRow Agreement, AgreementClauseRow Clause)> shown, int ix)
    {
        var (a, c) = shown[ix];
        if (c.VariantGroup is not int g) return XferGroupView.None;

        bool SameBlock(int j) =>
            j >= 0 && j < shown.Count && shown[j].Agreement.Id == a.Id
            && shown[j].Clause.Direction == c.Direction && shown[j].Clause.VariantGroup == g;

        var siblings = a.Clauses.Where(x => x.Direction == c.Direction).OrderBy(x => x.Order).ToList();
        var count = siblings.Count(x => x.VariantGroup == g);
        return new XferGroupView(true, !SameBlock(ix - 1), !SameBlock(ix + 1), g % 2 == 1, count, c.VariantDepth,
                                 Outline.ParentOf(siblings, c));
    }

    /// <summary>L'albero del navigatore: controparte ▸ accordo, con gli avvisi già contati.</summary>
    private IReadOnlyList<XferNavCounterpart> BuildNav(IReadOnlyList<AgreementRow> agreements) =>
        agreements.GroupBy(CounterpartLabel, StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => new XferNavCounterpart(
                g.Key,
                g.Key,
                g.OrderBy(a => a.TrafficKind).ThenBy(a => XferLabels.Airports(a), StringComparer.OrdinalIgnoreCase)
                 .Select(a => new XferNavAgreement(
                     a.Id, a.TrafficKind, XferLabels.Airports(a), a.Description,
                     a.Clauses.Count,
                     a.Clauses.Select(c => c.Direction).Distinct().Count(),
                     NoReceiver(a),
                     a.Clauses.Count(c => NeedsReview(a, c))))
                 .ToList()))
            .ToList();

    /// <summary>Come si legge la controparte di un accordo: il lato B, o l'avviso che non c'è nessuno.</summary>
    private string CounterpartLabel(AgreementRow a)
    {
        var b = XferLabels.Side(a, AgreementSide.B);
        return b.Length > 0 ? b : L["Xfer_NoCounterpart"];
    }

    private static string SenderLabel(AgreementRow a, AgreementClauseRow c) =>
        XferLabels.Side(a, c.Direction == AgreementDirection.AtoB ? AgreementSide.A : AgreementSide.B);

    private static string ReceiverLabel(AgreementRow a, AgreementClauseRow c) =>
        XferLabels.Side(a, c.Direction == AgreementDirection.AtoB ? AgreementSide.B : AgreementSide.A);

    /// <summary>L'accordo non ha nessuno che riceva: il traffico finisce a UNICOM e la derivazione lo scarta.</summary>
    private static bool NoReceiver(AgreementRow a) => a.Parties.All(p => p.Side != AgreementSide.B);

    /// <summary>
    /// Una clausola «da rivedere» consegna a un APP e non dice ancora dove avviene il trasferimento. Prima
    /// della faccetta quel dato non esisteva, quindi il suo livello poteva voler dire due cose diverse
    /// (autorizzato o al trasferimento) e solo chi l'ha scritta lo sa: vanno riaperte a mano.
    /// </summary>
    private bool NeedsReview(AgreementRow a, AgreementClauseRow c)
    {
        if (c.HandoffKind != TransferHandoffKind.Unspecified) return false;
        var side = c.Direction == AgreementDirection.AtoB ? AgreementSide.B : AgreementSide.A;
        return a.Parties.Where(p => p.Side == side)
            .Any(p => _all.FirstOrDefault(s => s.Id == p.SectorId)?.Type == SectorType.App);
    }

    private int ToReviewCount() => _agreements.Sum(a => a.Clauses.Count(c => NeedsReview(a, c)));

    /// <summary>Accordi filtrati per testo (parti/aeroporti/descrizione/punti), tipo e filtri diagnostici.</summary>
    private IReadOnlyList<AgreementRow> FilteredAgreements()
    {
        var q = _filter.Trim();
        return _agreements.Where(a =>
            (_kindFilter is null || a.TrafficKind == _kindFilter)
            && (!_toReviewOnly || a.Clauses.Any(c => NeedsReview(a, c)))
            && (!_noReceiverOnly || NoReceiver(a))
            && (q.Length == 0
                || a.Parties.Any(p => p.Callsign.Contains(q, StringComparison.OrdinalIgnoreCase))
                || a.Airports.Any(x => x.Icao.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (a.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || a.Clauses.Any(c => c.Cops.Contains(q, StringComparison.OrdinalIgnoreCase))))
            .ToList();
    }

    // ---- Colonna 2: il riquadro di lavoro -----------------------------------------------------------

    /// <summary>Testata del riquadro: dice cosa si sta guardando e — a destra — come uscirne.</summary>
    private RenderFragment PaneHead(string title, string? subtitle, EventCallback? onClose) => __builder =>
    {
        <div class="xt-pane-h">
            <b>@title</b>
            @if (!string.IsNullOrWhiteSpace(subtitle)) { <span class="muted xt-hint">@subtitle</span> }
            @if (onClose is { } close)
            {
                <button class="btn ghost xt-panel-x" title="@L["Common_Close"]" @onclick="close">✕</button>
            }
        </div>
    };

    private RenderFragment WorkPane(IReadOnlyList<AgreementRow> shown, IReadOnlyList<XferTableRow> rows) => __builder =>
    {
        if (_view == XferView.Flat)
        {
            <div class="xt-pane-h">
                <b>@L["Xfer_ViewFlat"]</b>
                <span class="muted xt-hint">@(string.Format(L["Xfer_ClausesCount"].Value, rows.Count))</span>
                @* «+ Clausola» compare quando un accordo È scelto — la scelta si conserva passando da albero a
                   elenco. Senza un accordo non compare: una clausola deve appartenere a uno, e chiederlo con un
                   secondo selettore sarebbe un giro più lungo del tornare all'albero (che è il tasto ↗). *@
                @if (SelectedAgreement() is { } target)
                {
                    <span class="ln xt-grow"></span>
                    <span class="muted xt-hint">@CounterpartLabel(target) · @KindLabel(target.TrafficKind)</span>
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddClause(target)">+ @L["Xfer_AddClause"]</button>
                }
            </div>
            <div class="xt-pane-body">
                @if (rows.Count == 0)
                {
                    <p class="help">@(_filtering ? L["Xfer_NoFilterMatch"] : L["Xfer_NoFlows"])</p>
                }
                else
                {
                    @RowsTable(rows, showContext: true, canDrag: false)
                }
            </div>
            return;
        }

        if (_newOpen)
        {
            @PaneHead(L["Xfer_NewAgreement"].Value, null, EventCallback.Factory.Create(this, CloseNew))
            <div class="xt-pane-body">
                @HeaderFields(_newForm, isNew: true)
                <div class="xt-foot">
                    <button class="btn primary" disabled="@(_busy || !_canEdit || _newForm.SideA.Count == 0)" @onclick="AddAgreement">+ @L["Xfer_Agreement"]</button>
                    @if (_canEdit && _newForm.SideA.Count == 0) { <span class="muted xt-hint xt-selfc">@L["Xfer_SelectSenderHint"]</span> }
                    else if (_canEdit && AirportRequiredMissing(_newForm)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                </div>
                <p class="help xt-mt0">@((MarkupString)L["Xfer_NewAgreementHelp"].Value)</p>
            </div>
            return;
        }

        var ag = SelectedAgreement();
        if (ag is null)
        {
            @* Riquadro vuoto: dice cosa fare. Una colonna che non dice niente sembra rotta — vale qui come vale
               per il pannello, ed è la stessa lezione. *@
            <div class="xt-pane-empty">
                <p class="ct">@L["Xfer_PaneEmptyTitle"]</p>
                <p class="muted">@(shown.Count == 0 && !_filtering ? L["Xfer_PaneEmptyFirst"] : L["Xfer_PaneEmptyBody"])</p>
            </div>
            return;
        }

        var versi = ag.Clauses.Select(c => c.Direction).Distinct().ToList();

        @* Testata dell'accordo: i DUE CAPI uno accanto all'altro, il traffico, gli aeroporti. È la differenza
           che si vede appena si apre: prima il mittente era nell'intestazione e il ricevente in ogni riga, e
           per sapere con chi fosse l'accordo bisognava guardare la tabella. *@
        <div class="xt-pane-h">
            <b>@Dash(XferLabels.Side(ag, AgreementSide.A))</b>
            <span class="xt-dir">@(versi.Count > 1 ? "⇄" : "→")</span>
            <b>@Dash(XferLabels.Side(ag, AgreementSide.B))</b>
            <span class="pill blue">@KindLabel(ag.TrafficKind)</span>
            @if (XferLabels.Airports(ag).Length > 0)
            {
                <span class="muted xt-hint">@XferLabels.Airports(ag)</span>
            }
            @if (!string.IsNullOrWhiteSpace(ag.Description))
            {
                <span class="muted xt-desc" title="@ag.Description">— @ag.Description</span>
            }
            @if (NoReceiver(ag))
            {
                <span class="pill xt-warnpill" title="@L["Xfer_UnicomTitle"]">⚠ @L["Xfer_NoReceiver"]</span>
            }
            <span class="ln xt-grow"></span>
            <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenEditHeader(ag)">✎ @L["Xfer_AgreementEdit"]</button>
            <InlineConfirm TriggerClass="btn ghost" AriaLabel="@L["Xfer_DeleteGroupAria"]" Disabled="@(_busy || !_canEdit)"
                           Prompt="@(string.Format(L["Xfer_DeleteAgreementPrompt"].Value, ag.Clauses.Count))" OnConfirm="() => DeleteAgreement(ag)"><Trigger><Icon Name="x" /> @L["Xfer_AgreementDelete"]</Trigger></InlineConfirm>
        </div>

        <div class="xt-pane-body">
            @if (_editHeaderId == ag.Id)
            {
                <div class="xt-subform">
                    @HeaderFields(_editForm, isNew: false)
                    <div class="xt-foot">
                        <button class="btn primary" disabled="@(_busy || !_canEdit)" @onclick="() => SaveHeader(ag)">💾 @L["Common_Save"]</button>
                        <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => _editHeaderId = null">@L["Common_Cancel"]</button>
                        @if (_canEdit && AirportRequiredMissing(_editForm)) { <span class="muted xt-hint xt-selfc">@L["Xfer_AirportRequired"]</span> }
                    </div>
                </div>
            }

            @* Selettore del verso: compare quando l'accordo è bilaterale, o quando lo si può rendere tale.
               Due tabelle e non una sola con due metà, come Annex D.2 — le clausole del verso opposto non sono
               alternative delle prime. *@
            <div class="xt-dirbar">
                <div class="xt-viewsw" role="group" aria-label="@L["Xfer_DirectionLabel"]">
                    <button class="btn @(_direction == AgreementDirection.AtoB ? "primary" : "ghost")"
                            @onclick="() => _direction = AgreementDirection.AtoB">
                        @DirectionLabel(ag, AgreementDirection.AtoB)
                    </button>
                    <button class="btn @(_direction == AgreementDirection.BtoA ? "primary" : "ghost")"
                            @onclick="() => _direction = AgreementDirection.BtoA">
                        @DirectionLabel(ag, AgreementDirection.BtoA)
                    </button>
                </div>
                @* Copiare il verso è un PUNTO DI PARTENZA, non un «rendi bilaterale»: i livelli dei due versi
                   sono diversi quasi sempre, e indovinarli sarebbe scrivere un accordo che nessuno ha
                   concordato. Compare solo quando il verso mostrato è vuoto e l'altro no. *@
                @if (ag.Clauses.Any(c => c.Direction != _direction) && !ag.Clauses.Any(c => c.Direction == _direction))
                {
                    <button class="btn ghost" disabled="@(_busy || !_canEdit)" title="@L["Xfer_CopyDirectionTitle"]"
                            @onclick="() => CopyDirection(ag)">⇄ @L["Xfer_CopyDirection"]</button>
                }
            </div>

            @* Avviso NON bloccante: un gruppo di varianti senza «negli altri casi» lascia scoperti i casi che
               nessuna condizione copre, e chi legge non sa che fare. Può essere legittimo (le condizioni possono
               essere esaustive), quindi si segnala, non si impedisce. *@
            @foreach (var w in AlternativesWithoutNormalCase(ag))
            {
                <div class="callout xt-warn">
                    <span class="cic">⚠</span>
                    <div>@(string.Format(L["Xfer_AltNoNormalCase"].Value, w))</div>
                </div>
            }

            @if (rows.Count == 0)
            {
                <p class="help">@L["Xfer_NoClausesHere"]</p>
            }
            else
            {
                @* Il trascinamento vale solo con l'ordinamento manuale: riordinare una vista ordinata per punto
                   scriverebbe un ordine che non è quello che si vede. *@
                @RowsTable(rows, showContext: false, canDrag: _sort == RowSort.Manual)
            }

            <div class="xt-foot">
                <button class="btn ghost" disabled="@(_busy || !_canEdit)" @onclick="() => OpenAddClause(ag)">+ @L["Xfer_AddClause"]</button>
            </div>
        </div>
    };

    /// <summary>I campi dell'intestazione: i due lati, il tipo, gli aeroporti, la descrizione. Uno solo per
    /// entrambe le istanze del form — due markup paralleli sono due occasioni di aggiornarne uno solo.</summary>
    private RenderFragment HeaderFields(HeaderForm form, bool isNew) => __builder =>
    {
        <div class="inline-form xt-flat">
            @PartyPicker(form, AgreementSide.A)
            @PartyPicker(form, AgreementSide.B)

            <div class="field narrow"><label>@L["Xfer_Kind"]</label>
                <select @bind="form.Kind">
                    <option value="@TransferFlowKind.Arrival">@L["Xfer_KindArrival"]</option>
                    <option value="@TransferFlowKind.Departure">@L["Xfer_KindDeparture"]</option>
                    <option value="@TransferFlowKind.Overflight">@L["Xfer_KindOverflight"]</option>
                    <option value="@TransferFlowKind.Vfr">@L["Xfer_KindVfr"]</option>
                    <option value="@TransferFlowKind.Other">@L["Xfer_KindOther"]</option>
                </select>
            </div>

            @* Aeroporti: un elenco, non un campo. È l'asse che il modello vecchio costringeva a moltiplicare —
               quattro flussi identici per quattro scali di Roma — e i documenti veri lo scrivono già così. *@
            <div class="field">
                <label>@L["Xfer_AirportsLabel"] <span class="muted xt-lbl-soft">@L["Xfer_AirportsHint"]</span></label>
                <div class="xt-chips">
                    @foreach (var apt in form.Airports.ToList())
                    {
                        <span class="pill neutral">@apt.Icao@(string.IsNullOrWhiteSpace(apt.Name) ? "" : $" · {apt.Name}")
                            <button type="button" class="xt-chipx" title="@L["Xfer_RemoveAirport"]"
                                    @onclick="() => form.Airports.Remove(apt)">✕</button>
                        </span>
                    }
                    @if (form.Airports.Count == 0) { <span class="muted">—</span> }
                </div>
                <div class="xt-btnrow">
                    <TypeaheadPicker Placeholder="LIRF / LFPG" Items="AirportItems(form.AirportText)"
                                     @bind-Text="form.AirportText" NoMatch="@NewAptFooter(form.AirportText)"
                                     Footer="@NewAptFooter(form.AirportText)" />
                    @if (!string.IsNullOrWhiteSpace(form.AirportText) && !IsKnownApt(form.AirportText))
                    {
                        <input placeholder="@L["Xfer_AptNamePh"]" @bind="form.AirportName" title="@L["Xfer_AptNameTitle"]" />
                        <button type="button" class="btn ghost xt-nowrap" disabled="@_busy"
                                @onclick="() => LookupApt(form)" title="@L["Xfer_LookupTitle"]"><Icon Name="search" /> IVAO</button>
                    }
                    <button type="button" class="btn ghost" disabled="@(string.IsNullOrWhiteSpace(form.AirportText))"
                            @onclick="() => AddAirport(form)">+ @L["Xfer_AddAirport"]</button>
                </div>
            </div>

            <div class="field"><label>@L["Xfer_DescOpt"]</label>
                <input placeholder="@L["Xfer_DescPh"]" @bind="form.Description" @bind:event="oninput"
                       @onkeydown="@(isNew ? TrySubmitNew : (Func<KeyboardEventArgs, Task>)(_ => Task.CompletedTask))" />
            </div>
        </div>
    };

    /// <summary>Un lato dell'accordo: le chip degli enti scelti più il picker per aggiungerne.</summary>
    private RenderFragment PartyPicker(HeaderForm form, AgreementSide side) => __builder =>
    {
        var list = side == AgreementSide.A ? form.SideA : form.SideB;
        var text = side == AgreementSide.A ? form.SideAText : form.SideBText;

        <div class="field">
            <label>
                @(side == AgreementSide.A ? L["Xfer_SideA"] : L["Xfer_SideB"])
                @if (side == AgreementSide.B) { <span class="muted xt-lbl-soft">@L["Xfer_EmptyUnicom"]</span> }
            </label>
            <div class="xt-chips">
                @foreach (var cs in list.ToList())
                {
                    <span class="pill neutral">@cs
                        <button type="button" class="xt-chipx" title="@L["Xfer_RemoveParty"]"
                                @onclick="() => list.Remove(cs)">✕</button>
                    </span>
                }
                @if (list.Count == 0) { <span class="muted">—</span> }
            </div>
            <TypeaheadPicker Placeholder="@L["Xfer_SearchCallsign"]" Items="SectorItems(text)"
                             Text="@text"
                             TextChanged="t => { if (side == AgreementSide.A) form.SideAText = t; else form.SideBText = t; }"
                             OnPick="i => AddParty(form, side, i?.Value)" />
        </div>
    };

    /// <summary>La tabella delle clausole. Un solo punto di chiamata per vista, e gli stessi agganci: se un
    /// giorno una delle due smette di reagire a un gesto, si vede qui e non in due markup paralleli.</summary>
    private RenderFragment RowsTable(IReadOnlyList<XferTableRow> rows, bool showContext, bool canDrag) => __builder =>
    {
        <XferRowsTable Rows="rows" ShowContext="showContext" CanDrag="canDrag"
                       SortColumn="@_sort.ToString()" SortDescending="_sortDesc"
                       OnSort="c => SortBy(Enum.Parse<RowSort>(c))"
                       Selected="_selected" EditClauseId="_editClauseId"
                       Disabled="@(_busy || !_canEdit)" DragId="_dragId" DragOverId="_dragOver"
                       EditingCell="_cellEdit" CellEditor="@(_canEdit ? CellEditor : null)" OnCellClick="OpenCell"
                       OnEdit="OnEditRow" OnGoToAgreement="GoToAgreement"
                       OnAddAlternative="AddAlternative" OnAddException="AddException"
                       OnToggleSelect="ToggleSelect"
                       OnDragStart="id => _dragId = id" OnDragOver="id => _dragOver = id" OnDrop="DropOn" />
    };

    /// <summary>Il campo dentro la cella. Entrambe le celle sono testo libero — il livello lo è per davvero,
    /// «per aerovia» compreso, e i punti sono un elenco separato da virgole.</summary>
    private RenderFragment<XferCellRef> CellEditor => cell => __builder =>
    {
        // L'epoca si cattura QUI, al render: il gestore di sfocamento che ne nasce vale per QUESTA apertura di
        // cella e per nessun'altra. Senza, il salvataggio da Invio (che apre subito la cella dopo) veniva
        // seguito dallo sfocamento della cella vecchia, che scriveva il testo vecchio nella cella nuova.
        var epoch = _cellEpoch;
        @* size, e non solo la larghezza in CSS: in una tabella a colonne automatiche un <input> porta la propria
           larghezza INTRINSECA (venti caratteri), e width:100% non la riduce — la colonna si allargava di un
           centinaio di pixel all'apertura e le altre scivolavano di lato. *@
        <input class="xt-celledit" @ref="_cellInput" @bind="_cellText" @bind:event="oninput"
               size="@(cell.Cell == XferCell.Points ? 16 : 8)"
               placeholder="@CellPlaceholder(cell.Cell)" disabled="@_busy"
               @onkeydown="e => CellKey(e, epoch)" @onblur="() => CommitCell(epoch)" />
    };

    // ---- Colonna 3: il pannello della clausola ------------------------------------------------------

    /// <summary>
    /// Il pannello di destra: è l'unico posto dove si scrive una clausola <b>per intero</b>. Vuoto mostra cosa
    /// fare, come il pannello dettaglio di Struttura — una colonna che non dice niente sembra rotta.
    /// </summary>
    private RenderFragment ClausePanel() => __builder =>
    {
        var form = _clauseForm;
        var ag = CurrentAgreement();

        if (form is null || ag is null)
        {
            <div class="xt-panel-empty">
                <p class="ct">@L["Xfer_PanelEmptyTitle"]</p>
                <p class="muted">@L["Xfer_PanelEmptyBody"]</p>
            </div>
            return;
        }

        var editing = _editClauseId is not null;

        @* Testata · corpo · piede. Il corpo è l'unica parte che scorre: le azioni stavano in fondo a 1426 px di
           contenuto in 904 disponibili, e il Salva non compariva in NESSUNA posizione di scorrimento della
           pagina. Misurato a schermo, non stimato. *@
        <div class="xt-panel-h">
            <b>@(editing ? L["Xfer_PanelEdit"] : L["Xfer_PanelNew"])</b>
            <span class="muted">@SenderOf(ag) → @ReceiverOf(ag) · @KindLabel(ag.TrafficKind)</span>
            @* L'avviso vive dove vivono le modifiche: in cima alla pagina stava a migliaia di pixel da qui. *@
            @if (HasOpenEdit) { <span class="pill xt-elsepill" title="@L["Xfer_UnsavedBody"]">✎ @L["Xfer_UnsavedTitle"]</span> }
            <button class="btn ghost xt-panel-x" title="@L["Common_Cancel"]" @onclick="ClosePanel">✕</button>
        </div>

        <div class="xt-panel-body">

        @* --- Identità: dove entra il traffico ---
           Il RICEVENTE non è più qui. Era il campo che ogni riga ripeteva e che il salvataggio doveva propagare
           alle sorelle per non lasciarle contraddirsi: adesso è il lato B dell'accordo, e l'invariante non può
           più rompersi perché non c'è più niente da tenere d'accordo. *@
        <div class="xt-grp"><span>@L["Xfer_GrpIdentity"]</span></div>
        <div class="field">
            <label>@L["Xfer_ColPoints"] <span class="muted xt-hint">@L["Xfer_CopListHint"]</span></label>
            <input placeholder="VALMA / VALMA, ELB, TOP" @bind="form.Points" @bind:event="oninput"
                   @onkeydown="PanelKey" />
        </div>

        @* --- Livello autorizzato --- *@
        @PanelSection("level", L["Xfer_GrpCleared"], LevelSummary(form))
        @if (SectionOpen("level"))
        {
        <div class="xt-row2">
            <div class="field"><label>@L["Xfer_Constraint"]</label>
                <select @bind="form.Constraint">
                    <option value="@LevelConstraint.AtOrBelow">≤ (-)</option>
                    <option value="@LevelConstraint.AtOrAbove">≥ (+)</option>
                    <option value="@LevelConstraint.Exact">@L["Xfer_Exact"]</option>
                    <option value="@LevelConstraint.Special">@L["Xfer_Special"]</option>
