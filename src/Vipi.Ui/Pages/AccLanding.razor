@page "/vsop/{Acc}"
@layout SopLayout
@inject IStationResolver Stations
@inject IAiracService Airac
@inject IEditAuthorizationService Authz
@inject IStructureEditingService Structure

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@_acc.Name · vIPI IVAO Italia</PageTitle>

    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/vsop">Home</a> › <b>@_acc.Name (@_acc.Code)</b></div>
        <div class="doc-head">
            <div>
                <h2 style="margin-bottom:2px">@_acc.Name <span class="muted" style="font-weight:400;font-size:20px">— @_acc.Code</span></h2>
                <p class="muted" style="margin:0">Scegli cosa consultare sotto la FIR di @_acc.Code.</p>
            </div>
            <span class="airac">📅 AIRAC @Airac.GetCycle(DateTime.UtcNow)</span>
        </div>

        @{ var a = Acc.ToLowerInvariant(); }
        <div class="section-title" style="margin-top:18px"><h3>Documenti</h3><span class="ln"></span></div>
        <div class="choice-grid">
            <a class="big-choice" href="/vsop/@a/vipi" style="text-decoration:none;color:inherit">
                <span class="ic">📘</span>
                <div>
                    <h4 style="margin:0">vIPI di @_acc.Name</h4>
                    <span class="muted" style="font-size:13.5px">Documento di ACC: separazioni, AoR, configurazioni, frequenze, minime e coordinamenti. Include gli APP remotizzati.</span>
                </div>
                <span class="arr" style="margin-left:auto;font-size:22px;color:var(--ivao-lightblue)">→</span>
            </a>

            <div class="choice">
                <h4><a href="/vsop/@a/airports" style="text-decoration:none;color:inherit"><span class="ic">🛫</span> Aeroporti →</a></h4>
                <p class="muted">vIPI dei singoli aeroporti sotto la FIR.</p>
                <ul class="linklist">
                    @if (_airports.Count == 0)
                    {
                        <li><span class="muted">Nessun aeroporto</span></li>
                    }
                    else
                    {
                        @foreach (var ap in _airports)
                        {
                            <li onclick="location.href='/vsop/@a/airports?icao=@ap.Icao'"><span>@ap.Icao · @ap.Name</span><span class="arr">→</span></li>
                        }
                    }
                </ul>
            </div>

            <div class="choice">
                <h4><a href="/vsop/@a/apps" style="text-decoration:none;color:inherit"><span class="ic">📡</span> Avvicinamenti non remotizzati →</a></h4>
                <p class="muted">APP con documentazione propria.</p>
                <ul class="linklist">
                    @if (_apps.Count == 0)
                    {
                        <li><span class="muted">Nessun APP non remotizzato</span></li>
                    }
                    else
                    {
                        @foreach (var ap in _apps)
                        {
                            <li onclick="location.href='/vsop/@a/apps/vipi?icao=@(ap.AirportIcao ?? ap.Callsign)'"><span>@ap.Callsign · @ap.Name</span><span class="arr">→</span></li>
                        }
                    }
                </ul>
            </div>

            <div class="choice">
                <h4><a href="/vsop/@a/vloa" style="text-decoration:none;color:inherit"><span class="ic">🤝</span> vLOA →</a></h4>
                <p class="muted">Lettere di accordo con i centri confinanti.</p>
                <ul class="linklist">
                    @if (_vloas.Count == 0)
                    {
                        <li><span class="muted">Nessuna vLOA</span></li>
                    }
                    else
                    {
                        @foreach (var v in _vloas)
                        {
                            <li onclick="location.href='/vsop/@a/vloa/@v.DocId'"><span>@v.Title@(v.Neighbour is null ? "" : $" · {v.Neighbour}")</span><span class="arr">→</span></li>
                        }
                    }
                </ul>
            </div>
        </div>

        @if (_canEdit)
        {
            <div class="section-title"><h3>Admin <span class="pill blue" style="font-size:11px">CH/AOD</span></h3><span class="ln"></span></div>
            <div class="choice-grid">
                <a class="choice" href="/vsop/@a/editor" style="text-decoration:none;color:inherit"><h4><span class="ic">✏️</span> Editor vIPI</h4><p class="muted">Struttura, blocchi, pubblicazione.</p></a>
                <a class="choice" href="/vsop/@a/topologia" style="text-decoration:none;color:inherit"><h4><span class="ic">🧭</span> Topologia settori</h4><p class="muted">Gerarchia, unificazioni, simulatore.</p></a>
                <a class="choice" href="/vsop/@a/editor-trasferimenti" style="text-decoration:none;color:inherit"><h4><span class="ic">🔄</span> Editor trasferimenti</h4><p class="muted">Righe strutturate CoP/FL/catena.</p></a>
                <a class="choice" href="/vsop/@a/editor-vloa" style="text-decoration:none;color:inherit"><h4><span class="ic">🤝</span> Editor vLOA</h4><p class="muted">Lettera di accordo bilaterale.</p></a>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    private AccInfo? _acc;
    private bool _canEdit;
    private IReadOnlyList<AirportRow> _airports = Array.Empty<AirportRow>();
    private IReadOnlyList<SectorRow> _apps = Array.Empty<SectorRow>();
    private IReadOnlyList<VloaRow> _vloas = Array.Empty<VloaRow>();

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _canEdit = await Authz.CanEditFirAsync(_acc.Code);

        var data = await Structure.LoadAsync(_acc.Code);
        if (data is not null)
        {
            // "In evidenza" = FeaturedRank 1..3; fallback ai primi 3 per ICAO/callsign quando nessuno è marcato.
            _airports = data.Airports
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Icao)
                .Take(3).ToList();
            _apps = data.Sectors
                .Where(s => s.Type == SectorType.App)
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Callsign)
                .Take(3).ToList();
            _vloas = data.Vloas
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Title)
                .Take(3).ToList();
        }
    }
}
