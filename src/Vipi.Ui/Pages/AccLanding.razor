@page "/services/vsop/{Acc}"
@layout SopLayout
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection

@* ⚠️ SCOPE PROPRIO (OwningComponentBase), come già sei componenti di questo repository dopo l'audit del
   30 luglio 2026. Il motivo è misurato, non teorico: alle 17:44 del 24 agosto questa pagina è morta sette
   volte con «A second operation was started on this context instance» — la sua query trovava il DbContext
   della richiesta già occupato da qualcun altro.

   Con uno scope proprio la pagina lavora su un DbContext SUO: nessuno può passarle davanti, e non serve
   sapere chi fosse l'altro — che è il punto, perché quello non si è ancora capito (voce E9).

   ⚠️ NON tutto si sposta nello scope proprio. `IStationResolver` resta quello della richiesta perché il
   layout l'ha già scaldato (`Prewarm`): riprendendolo dallo scope nuovo si ripagherebbe la stessa query,
   a freddo. Restano fuori anche le cose che il database non lo toccano: localizzazione, AIRAC, meteo,
   cache degli ATC online. *@
@inject IStationResolver Stations
@inject IAiracService Airac
@inject IStringLocalizer<SharedResource> L

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@_acc.Name · vIPI IVAO Italia</PageTitle>

    <div class="wrap reading-cap">
        <div class="breadcrumb"><a href="/services/vsop">@L["Common_Home"]</a> › <b>@_acc.Code</b></div>
        <div class="doc-head">
            <div>
                <h1 class="page-h1" style="margin:0">@_acc.Code — @_acc.Name</h1>
            </div>
            <span class="airac"><Icon Name="calendar" /> AIRAC @Airac.GetCycle(DateTime.UtcNow)</span>
        </div>

        @{ var a = Acc.ToLowerInvariant(); }
        <div class="section-title" style="margin-top:18px"><h2 class="h-sect">@L["AccLanding_Documents"]</h2><span class="ln"></span></div>
        <div class="choice-grid">
            @* Stesso gate di aeroporti/APP/vLOA (doc 13 §3j): senza release AIRAC effettiva la vIPI non è
               pubblica, e la card portava a «vIPI non disponibile». Allo staff resta, con la sua etichetta e la
               rotta dell'editor, come nell'elenco degli APP. *@
            @if (_vipiPublished)
            {
                <a class="big-choice nav-card c-vipi" href="/services/vsop/@a/vipi">
                    <div class="bc-body">
                        <span class="eyebrow">@L["AccLanding_MainDoc"]</span>
                        <h3 class="h-card">@L["AccLanding_VipiOf", _acc.Name]</h3>
                        <span class="muted">@L["AccLanding_VipiDesc"]</span>
                    </div>
                    <span class="bc-open">@L["Common_Open"]</span>
                </a>
            }
            else if (_canEdit)
            {
                <a class="big-choice nav-card c-vipi" href="/services/vsop/@a/editor">
                    <div class="bc-body">
                        <span class="eyebrow">@L["AccLanding_MainDoc"]</span>
                        <h3 class="h-card">@L["AccLanding_VipiOf", _acc.Name]</h3>
                        <span class="muted">@L["AccLanding_VipiUnpublished"]</span>
                    </div>
                    <span class="bc-open">@L["Common_Editor"]</span>
                </a>
            }

            <div class="choice nav-card c-air">
                <a class="nav-head" href="/services/vsop/@a/airports"><h3 class="h-card">@L["AccLanding_Airports"]</h3><span class="count">@_airportsTotal</span></a>
                <p class="muted">@L["AccLanding_AirportsDesc"]</p>
                <ul class="linklist">
                    @if (_airports.Count == 0)
                    {
                        <li class="empty"><span class="muted">@L["Common_NoAirport"]</span></li>
                    }
                    else
                    {
                        @foreach (var ap in _airports)
                        {
                            <li onclick="location.href='/services/vsop/@a/airports?icao=@ap.Icao'"><span class="tag">@ap.Icao</span><span>@ap.Name</span></li>
                        }
                    }
                </ul>
                <a class="see-all" href="/services/vsop/@a/airports">@L["Common_SeeAll"]</a>
            </div>

            <div class="choice nav-card c-app">
                <a class="nav-head" href="/services/vsop/@a/apps"><h3 class="h-card">@L["AccLanding_Apps"]</h3><span class="count">@_appsTotal</span></a>
                <p class="muted">@L["AccLanding_AppsDesc"]</p>
                <ul class="linklist">
                    @if (_apps.Count == 0)
                    {
                        <li class="empty"><span class="muted">@L["Common_NoApp"]</span></li>
                    }
                    else
                    {
                        @foreach (var ap in _apps)
                        {
                            <li onclick="location.href='/services/vsop/@a/apps/vipi?app=@ap.Callsign'"><span class="tag">@ap.Callsign</span><span>@ap.Name</span></li>
                        }
                    }
                </ul>
                <a class="see-all" href="/services/vsop/@a/apps">@L["Common_SeeAll"]</a>
            </div>

            <div class="choice nav-card c-vloa">
                <a class="nav-head" href="/services/vsop/@a/vloa"><h3 class="h-card">vLoA</h3><span class="count">@_vloasTotal</span></a>
                <p class="muted">@L["AccLanding_VloaDesc"]</p>
                <ul class="linklist">
                    @if (_vloas.Count == 0)
                    {
                        <li class="empty"><span class="muted">@L["Common_NoVloa"]</span></li>
                    }
                    else
                    {
                        @foreach (var v in _vloas)
                        {
                            <li onclick="location.href='/services/vsop/@a/vloa?acc=@v.NeighbourCode'">@if (v.Neighbour is not null){<span class="tag">@v.Neighbour</span>}<span>@v.Title</span></li>
                        }
                    }
                </ul>
                <a class="see-all" href="/services/vsop/@a/vloa">@L["Common_SeeAllF"]</a>
            </div>
        </div>

        <div class="section-title"><h2 class="h-sect">@L["AccLanding_OpsView"]</h2><span class="ln"></span></div>
        <div class="choice-grid">
            <a class="big-choice nav-card c-vipi" href="/services/vsop/live">
                <div class="bc-body">
                    <span class="eyebrow">⚡ Live</span>
                    <h3 class="h-card">@L["AccLanding_OpsViewOf", _acc.Name]</h3>
                    <span class="muted">@L["AccLanding_OpsViewDesc"]</span>
                </div>
                <span class="bc-open">@L["Common_Open"]</span>
            </a>
        </div>

        @if (_canEdit)
        {
            <div class="section-title"><h2 class="h-sect">Admin</h2><span class="ln"></span></div>
            <div class="choice-grid">
                <a class="choice nav-card c-admin" href="/services/vsop/admin/transfers"><div class="nav-head"><h3 class="h-card">@L["Home_TransfersTitle"]</h3></div><p class="muted">@L["AccLanding_TransfersAdminDesc"]</p></a>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    private AccInfo? _acc;
    private bool _canEdit;
    private IReadOnlyList<AirportRow> _airports = Array.Empty<AirportRow>();
    private IReadOnlyList<SectorRow> _apps = Array.Empty<SectorRow>();
    private IReadOnlyList<VloaRow> _vloas = Array.Empty<VloaRow>();
    private int _airportsTotal, _appsTotal, _vloasTotal;
    private bool _vipiPublished;

    // I servizi che interrogano il database: presi dallo SCOPE DI QUESTA PAGINA, non da quello
    // della richiesta. Vedi il commento in testa al file.
    private IEditAuthorizationService Authz = default!;
    private IStructureEditingService Structure = default!;
    private IDocumentAdminService Docs = default!;

    protected override void OnInitialized()
    {
        Authz = ScopedServices.GetRequiredService<IEditAuthorizationService>();
        Structure = ScopedServices.GetRequiredService<IStructureEditingService>();
        Docs = ScopedServices.GetRequiredService<IDocumentAdminService>();
    }

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;
        _canEdit = await Authz.CanEditAccAsync(_acc.Code);

        var data = await Structure.LoadAsync(_acc.Code);
        if (data is not null)
        {
            // "In evidenza" = FeaturedRank 1..3; fallback ai primi 3 per ICAO/callsign quando nessuno è marcato.
            var managed = await Docs.ListAsync();
            _vipiPublished = managed.Any(m => m.Kind == ManagedDocKind.AccVipi && m.HasEffectiveRelease && !m.IsHidden
                                              && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase));
            // Aeroporti: solo quelli con una release AIRAC effettiva e non nascosti (doc 10 §3f: visibilità = release effettiva).
            var publishedApts = managed
                .Where(m => m.Kind == ManagedDocKind.AirportVipi && m.HasEffectiveRelease && !m.IsHidden
                            && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase))
                .Select(m => m.Scope)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var airports = data.Airports.Where(x => x.IsPublic && publishedApts.Contains(x.Icao)).ToList();
            // APP: solo non remotizzati (Standalone) e pubblicati (non nascosti), con collasso d'albero (solo l'antenato).
            var apps = StandaloneApps(data.Sectors, managed, _acc.Code);
            // vLOA: solo quelle con release AIRAC effettiva e non nascoste (stessa regola di aeroporti/APP, doc 10 §3f).
            var publishedVloas = managed
                .Where(m => m.Kind == ManagedDocKind.Vloa && m.HasEffectiveRelease && !m.IsHidden && m.DocumentId is not null)
                .Select(m => m.DocumentId!.Value)
                .ToHashSet();
            var vloas = data.Vloas.Where(v => publishedVloas.Contains(v.DocId)).ToList();
            _airportsTotal = airports.Count;
            _appsTotal = apps.Count;
            _vloasTotal = vloas.Count;
            _airports = airports
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Icao)
                .Take(3).ToList();
            _apps = apps
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Callsign)
                .Take(3).ToList();
            _vloas = vloas
                .OrderBy(x => x.FeaturedRank ?? int.MaxValue).ThenBy(x => x.Title)
                .Take(3).ToList();
        }
    }

    // APP non remotizzati (Standalone) e pubblicati (non nascosti), col collasso d'albero: se un APP standalone ha
    // un antenato che è a sua volta un APP standalone mostrato, si tiene solo l'antenato. Stessa regola di /apps.
    private static List<SectorRow> StandaloneApps(IReadOnlyList<SectorRow> all, IReadOnlyList<ManagedDoc> managed, string accCode)
    {
        var published = managed
            .Where(m => m.Kind == ManagedDocKind.AppVipi && m.HasEffectiveRelease && !m.IsHidden
                        && string.Equals(m.AccCode, accCode, StringComparison.OrdinalIgnoreCase))
            .Select(m => m.Scope)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var standalone = all
            .Where(s => s.Type == SectorType.App && s.ApproachKind == ApproachKind.Standalone && published.Contains(s.Callsign))
            .ToList();
        var standaloneIds = standalone.Select(s => s.Id).ToHashSet();
        var byId = all.ToDictionary(s => s.Id);
        bool HasStandaloneAncestor(SectorRow s)
        {
            var pid = s.ParentSectorId;
            while (pid is int id && byId.TryGetValue(id, out var p))
            {
                if (standaloneIds.Contains(p.Id)) return true;
                pid = p.ParentSectorId;
            }
            return false;
        }
        return standalone.Where(s => !HasStandaloneAncestor(s)).ToList();
    }
}
