@page "/services/vsop/admin/required-sections"
@layout SopLayout
@rendermode InteractiveServer
@inherits Vipi.Ui.ScopeProprioCheAspetta
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<SharedResource> L
@inject Vipi.Application.Routing.IDocRoutesRegistry Rotte

<PageTitle>@L["Opt_Title"] · IVAO Italy</PageTitle>

@* ---- Le sezioni da scrivere, e quali sono facoltative (S133, carta 2026-10-28-stato-dei-documenti §1 D4) ------
   Il committente: le sezioni da scrivere le decide il catalogo. La regola di partenza resta nel codice (editoriale, non
   un contenitore, non una sezione che la pagina disegna da sé); qui un admin ne spegne una per un tipo di documento, e da
   quel momento vuota non conta più — nella scheda del documento e nella colonna «Da completare» di Documenti.
   ⚠️ Vale per TUTTI i documenti di quel tipo: lo dice l'aiuto, e lo dice la riga.
   ⚠️ SCOPE PROPRIO, come le altre pagine admin che leggono: il circuito ha già il suo DbContext. *@
<div class="wrap struct">
    <AdminNav />

    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">@L["Opt_Title"]</h1>
        <HelpHint AriaLabel="@L["Opt_Title"]" ExtraClass="wide">@L["Opt_Intro"]</HelpHint>
        <LiveRegion>
            @if (_stato is { Length: > 0 })
            {
                <span class="st-msg ok"><Icon Name="check-circle" Size="14" /> <span class="st-msg-t">@_stato</span></span>
            }
        </LiveRegion>
    </div>

    @if (_errore is { Length: > 0 })
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_errore</div></div>
    }
    else if (_righe is null)
    {
        <LoadingState />
    }
    else
    {
        @* ---- I documenti con sezioni vuote (S134). Il committente, 4 novembre 2026: «un elenco di tutti i documenti che
           hanno sezioni vuote … se clicco sul nome mi apre l'editor». Sopra le tabelle, perché si guarda prima che cosa
           manca e poi si decide se una sezione è davvero da scrivere; spenta una sezione, l'elenco si rifà. Il conto è
           quello della scheda del documento e della colonna «Da completare» di Documenti: un servizio solo. *@
        <section class="opt-docs" data-docs-vuote>
            <h2 class="h-card" style="margin:12px 0 8px">
                @L["Opt_DocsTitle"] <span class="muted">· @_documenti.Count</span>
            </h2>
            <p class="help">@L["Opt_DocsHelp"]</p>
            @if (_documenti.Count == 0)
            {
                <p class="muted">@L["Opt_DocsNone"]</p>
            }
            else
            {
                <div class="panel sd">
                    @foreach (var (d, s) in _documenti)
                    {
                        var editor = Editor(d);
                        <details @key="d.DocumentId" class="opt-doc" data-doc="@d.DocumentId">
                            <summary>
                                @if (editor is not null)
                                {
                                    <a href="@editor" title="@L["Opt_DocsOpen"]"><b>@d.Title</b></a>
                                }
                                else
                                {
                                    <b>@d.Title</b>
                                }
                                @if (!string.IsNullOrWhiteSpace(d.Scope))
                                {
                                    <span class="muted">· @d.Scope</span>
                                }
                                @if (d.IsHidden)
                                {
                                    <span class="pill grey">@L["Ver_Hidden"]</span>
                                }
                                <span class="pill amber">@(s.Vuote == 1 ? L["SdS_PillOne"].Value : string.Format(L["SdS_Pill"].Value, s.Vuote))</span>
                            </summary>
                            @foreach (var parte in s.Parti.Where(p => p.Vuote.Count > 0))
                            {
                                @if (parte.Titolo is { } titolo)
                                {
                                    <p class="sd-part"><b>@titolo</b></p>
                                }
                                <ul class="sd-list">
                                    @foreach (var v in parte.Vuote)
                                    {
                                        <li>
                                            <span data-percorso>@v.Percorso</span>
                                            @if (editor is not null)
                                            {
                                                <a class="sd-go" href="@($"{editor}#s-{v.SectionId}")">@L["Sd_Write"] →</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </details>
                    }
                </div>
            }
        </section>

        <p class="help">@L["Opt_Help"]</p>
        @foreach (var profilo in _righe.GroupBy(r => r.Profilo))
        {
            var spente = profilo.Count(r => r.Facoltativa);
            <h2 class="h-card" style="margin:18px 0 8px">
                @Profilo(profilo.Key)
                <span class="muted">· @string.Format(L["Opt_Counted"].Value, profilo.Count() - spente, profilo.Count())</span>
            </h2>
            <div class="panel">
                <table class="res-table" data-profilo="@profilo.Key">
                    <thead>
                        <tr>
                            <th>@L["Opt_ColSection"]</th>
                            <th style="width:1%;white-space:nowrap">@L["Opt_ColOptional"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in profilo)
                        {
                            <tr class="@(r.Facoltativa ? "row-off" : "")">
                                <td>@r.Percorso <code class="muted" style="font-size:11px">@r.Chiave</code></td>
                                <td style="text-align:center">
                                    <input type="checkbox" checked="@r.Facoltativa" disabled="@_busy"
                                           aria-label="@string.Format(L["Opt_ToggleAria"].Value, r.Percorso)"
                                           title="@L["Opt_ToggleTitle"]"
                                           @onchange="e => ImpostaAsync(r, e.Value is true)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<SezioneDelCatalogo>? _righe;
    private IReadOnlyList<(ManagedDoc Doc, StatoSezioni Stato)> _documenti = Array.Empty<(ManagedDoc, StatoSezioni)>();
    private string? _errore;
    private string? _stato;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await InFilaAsync(async () =>
            {
                _righe = await Servizio.ElencoAsync();
                await DocumentiAsync();
            });
        }
        catch (EditNotAllowedException) { _errore = L["Opt_AdminOnly"]; }
    }

    private ISezioniFacoltativeService Servizio => ScopedServices.GetRequiredService<ISezioniFacoltativeService>();

    /// <summary>
    /// I documenti con almeno una sezione da scrivere vuota, nell'ordine dell'elenco di Documenti. Due letture in fila
    /// sullo stesso scope (l'elenco e il conto in una passata), mai una per documento.
    /// </summary>
    private async Task DocumentiAsync()
    {
        var elenco = await ScopedServices.GetRequiredService<IDocumentAdminService>().ListAsync();
        var conto = await ScopedServices.GetRequiredService<ISezioniDaScrivereService>().QuadroAsync();
        _documenti = elenco
            .Where(d => d.DocumentId is int id && conto.TryGetValue(id, out var s) && s.Vuote > 0)
            .DistinctBy(d => d.DocumentId)
            .Select(d => (d, conto[d.DocumentId!.Value]))
            .ToList();
    }

    /// <summary>L'editor del documento, come lo compongono Documenti e il Glossario.</summary>
    private string? Editor(ManagedDoc d) =>
        Rotte.For(d.Kind).EditorUrl((d.AccCode ?? "lirr").ToLowerInvariant(), d.ReleaseKey, d.NeighbourCode, d.DocumentId);

    private async Task ImpostaAsync(SezioneDelCatalogo r, bool facoltativa)
    {
        if (_busy) return;
        _busy = true; _stato = null;
        try
        {
            await InFilaAsync(async () =>
            {
                await Servizio.ImpostaAsync(r.Profilo, r.Chiave, facoltativa);
                _righe = await Servizio.ElencoAsync();
                await DocumentiAsync();
            });
            _stato = string.Format(L[facoltativa ? "Opt_NowOptional" : "Opt_NowRequired"].Value, r.Percorso, Profilo(r.Profilo));
        }
        catch (EditNotAllowedException) { _errore = L["Opt_AdminOnly"]; }
        catch (Vipi.Application.Aor.ValidationException ex) { _errore = ex.Message; }
        finally { _busy = false; }
    }

    private string Profilo(SectionProfile p) => L[$"Opt_Profile_{p}"];
}
