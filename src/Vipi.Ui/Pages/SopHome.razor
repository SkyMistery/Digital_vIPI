@page "/services/vsop"
@layout SopLayout
@*  ⚠️ NIENTE @@rendermode, ed è una scelta: questa pagina non ha un solo comando.

    Fino al 27 agosto 2026 era «InteractiveServer», e ogni visitatore dell'INGRESSO del sito apriva un
    WebSocket e uno stato lato server — per una pagina che conta gli ATC una volta sola al render (lo dice
    OnlineCount qui sotto) e non ha né un pulsante né un campo. Con una sola istanza, nessun backplane e
    venticinque circuiti trattenuti, sono i circuiti che servono all'editor.

    ⚠️ I numeri degli ATC non erano comunque «vivi» nemmeno prima: chi si iscrive allo stream è il badge in
    barra (LiveBadge), che è un'isola sua. Qui erano e restano una fotografia al momento del render.

    ⚠️ Se un domani qui dentro entra un comando — un filtro, una chip cliccabile — la cosa da fare NON è
    rimettere @@rendermode su tutta la pagina, ma rendere interattivo QUEL pezzo. Vedi ChangedPage, che il
    circuito ce l'ha per due chip e basta.
*@
@inject IAiracService Airac
@inject IStationResolver Stations
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject IStringLocalizer<SharedResource> L
@inject EnglishStrings En

<PageTitle>vIPI · IVAO Italy</PageTitle>

<div class="wrap">
    <div class="breadcrumb"><a href="/services">‹ @En["Services_Title"]</a></div>
    <div class="hero">
        <span class="airac"><Icon Name="calendar" /> AIRAC @Airac.GetCycle(DateTime.UtcNow)</span>
        <h1>@L["Home_Heading"]</h1>
        <p>@L["Home_Intro"]</p>
    </div>

    <div class="section-title"><h2 class="h-sect">Virtual Area Control Center</h2><span class="ln"></span></div>
    @if (Stations.Accs.Count == 0)
    {
        <div class="callout info"><span class="cic"><Icon Name="inbox" Size="18" /></span><div>
            <p class="ct">@L["Home_NoAccTitle"]</p>
            @L["Home_DbEmpty"] @(Authz.IsEditor ? L["Home_CreateFirstAdmin"] : L["Home_CreateFirstUser"])
            @if (Authz.IsEditor)
            {
                <div style="margin-top:10px"><a class="btn primary" href="/services/vsop/admin/sector-structure">@L["Home_CreateAccBtn"]</a></div>
            }
        </div></div>
    }
    else
    {
        <div class="acc-grid">
            @foreach (var acc in Stations.Accs)
            {
                var n = OnlineCount(acc.Code);
                <a class="acc-card @(n > 0 ? "on" : "off")" href="/services/vsop/@acc.Code.ToLowerInvariant()" style="text-decoration:none">
                    <div class="onl"><span class="dot"></span> @(n > 0 ? L["Common_OnlineN", n] : L["Common_Offline"])</div>
                    <div class="code">@acc.Code</div>
                    <div class="name">@acc.Name</div>
                </a>
            }
        </div>
    }

    <div class="choice-grid" style="margin-top:22px">
        @* I vSOP militari: elenco NAZIONALE, non sotto una ACC — un pilota cerca «Ghedi», non «LIMM». *@
        <a class="choice" href="/services/vsop/mil"><h3 class="h-card"><span class="ic"><Icon Name="shield" Size="18" /></span> @L["Mil_Title"]</h3><p class="muted">@L["Mil_Desc"]</p></a>
        <a class="choice" href="/services/vsop/changed"><h3 class="h-card"><span class="ic"><Icon Name="sparkles" Size="18" /></span> @L["Home_ChangedTitle"]</h3><p class="muted">@L["Home_ChangedDesc"]</p></a>
        <a class="choice" href="/services/profile-swapper"><h3 class="h-card"><span class="ic"><Icon Name="copy" Size="18" /></span> @L["Swap_Heading"]</h3><p class="muted">@L["Services_SwapperDesc"]</p></a>
        <a class="choice" href="/services/stats"><h3 class="h-card"><span class="ic"><Icon Name="clipboard" Size="18" /></span> @L["Stats_Title"]</h3><p class="muted">@L["Services_StatsDesc"]</p></a>
    </div>

    @* La sezione staff si apre a chi ha qualcosa da farci: l'Editor. La sola voce «Permessi» resta agli
       admin, ed è l'unica riga con un `@if` proprio qui dentro. *@
    @if (Authz.IsEditor)
    {
        <details class="staff-sec" data-persist="vsop-staff" open>
        <summary class="section-title"><h2 class="h-sect">@L["Home_StaffSection"] <span class="chev">▸</span></h2><span class="ln"></span></summary>
        <div class="choice-grid">
            <a class="choice" href="/services/vsop/versions"><h3 class="h-card"><span class="ic"><Icon Name="file" Size="18" /></span> @L["Home_DocsTitle"]</h3><p class="muted">@L["Home_DocsDesc"]</p></a>
            <a class="choice" href="/services/vsop/screens"><h3 class="h-card"><span class="ic"><Icon Name="grid" Size="18" /></span> @L["Home_ScreensTitle"]</h3><p class="muted">@L["Home_ScreensDesc"]</p></a>
            <a class="choice" href="/services/vsop/admin/acc"><h3 class="h-card"><span class="ic"><Icon Name="radio" Size="18" /></span> @L["Home_AccTitle"]</h3><p class="muted">@L["Home_AccDesc"]</p></a>
            <a class="choice" href="/services/vsop/admin/sector-structure"><h3 class="h-card"><span class="ic"><Icon Name="building" Size="18" /></span> @L["Home_StructTitle"]</h3><p class="muted">@L["Home_StructDesc"]</p></a>
            <a class="choice" href="/services/vsop/admin/transfers"><h3 class="h-card"><span class="ic"><Icon Name="refresh" Size="18" /></span> @L["Home_TransfersTitle"]</h3><p class="muted">@L["Home_TransfersDesc"]</p></a>
            @if (Authz.IsAdmin)
            {
                <a class="choice" href="/services/vsop/admin/permissions"><h3 class="h-card"><span class="ic"><Icon Name="key" Size="18" /></span> @L["Home_PermsTitle"]</h3><p class="muted">@L["Home_PermsDesc"]</p></a>
            }
        </div>
        </details>
    }
</div>

@code {
    // Scalda le cache del resolver (ACC + mappa aeroporti) prima del render: la home itera tutte le ACC e per
    // ognuna chiama OnlineCount()→ResolveByCallsign. Senza prewarm il lazy-load colpirebbe il DbContext condiviso
    // durante il render → crash "second operation" su Postgres.
    protected override void OnInitialized() => Stations.Prewarm();

    // Conteggio one-shot al render: ATC online del dato ACC. Include sia i settori d'area (es. LIRR_NE_CTR)
    // sia le postazioni d'aeroporto sotto quell'ACC (es. LIRP_TWR / LIEO_EW0_APP → l'ACC dell'aeroporto).
    private int OnlineCount(string accCode)
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
            Stations.ResolveByCallsign(cs)?.Code.Equals(accCode, StringComparison.OrdinalIgnoreCase) == true);
    }
}
