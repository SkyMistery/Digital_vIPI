@page "/sop"
@inject IAiracService Airac
@inject ICurrentUserProvider Users

<PageTitle>vIPI · IVAO Italia</PageTitle>

<link rel="stylesheet" href="_content/Vipi.Ui/vipi-theme.css" />

<header class="vipi-header">
    <h1>vIPI / vLOA Interactive</h1>
    <p>Documentazione operativa ATC — IVAO Italia · Aggiornato AIRAC @Airac.GetCycle(DateTime.UtcNow)</p>
</header>

@if (_user is { } u)
{
    <div class="vipi-callout vipi-callout--info">
        Loggato come <strong>@u.Name</strong> (VID @u.Vid) · FIR @u.Fir
        @if (u.CanEdit)
        {
            <span class="vipi-badge vipi-badge--online" style="margin-left:.5rem">Editor (CH/AOD)</span>
        }
    </div>
}
else
{
    <div class="vipi-callout vipi-callout--warning">Consultazione anonima (sola lettura).</div>
}

<h2>Centri di controllo</h2>
<nav class="vipi-acc-grid">
    @foreach (var acc in Accs)
    {
        <a class="vipi-acc-card" href="/sop/@acc.Code.ToLowerInvariant()">
            <strong>@acc.Code</strong>
            <span>@acc.Name</span>
        </a>
    }
</nav>

<style>
    .vipi-acc-grid { display: flex; gap: 1rem; flex-wrap: wrap; }
    .vipi-acc-card {
        display: flex; flex-direction: column; min-width: 9rem; padding: 1rem;
        border: 1px solid var(--ivao-grey); border-radius: 8px; text-decoration: none;
        color: var(--ivao-blue); background: #fff;
    }
    .vipi-acc-card strong { font-family: var(--ivao-font-heading); font-size: 1.5rem; }
    .vipi-acc-card:hover { border-color: var(--ivao-light-blue); }
    .vipi-header { border-bottom: 3px solid var(--ivao-blue); margin-bottom: 1.5rem; }
</style>

@code {
    // Home a 4 ACC (PIANO §22.1 / ADR-0001 D8). FIR pilota: Roma.
    private static readonly (string Code, string Name)[] Accs =
    {
        ("LIRR", "Roma ACC"),
        ("LIMM", "Milano ACC"),
        ("LIPP", "Padova ACC"),
        ("LIBB", "Brindisi ACC"),
    };

    private CurrentUser? _user;

    protected override void OnInitialized() => _user = Users.Get();
}
