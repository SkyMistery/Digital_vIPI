@page "/vsop"
@layout SopLayout
@rendermode InteractiveServer
@inject IAiracService Airac
@inject IStationResolver Stations
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online

<PageTitle>vIPI · IVAO Italia</PageTitle>

<div class="wrap">
    <div class="hero">
        <span class="airac">📅 AIRAC @Airac.GetCycle(DateTime.UtcNow)</span>
        <h1>Documentazione operativa</h1>
        <p>Seleziona un ACC per consultare le vIPI, gli aeroporti e gli avvicinamenti. Oppure cerca direttamente una postazione.</p>
        <form class="searchbar" action="/vsop/search" method="get"><span class="ico">🔍</span><input name="q" placeholder="Cerca CoP, FIX, callsign, frequenze… es. VALMA, LIRR_NE_CTR" /></form>
    </div>

    <div class="section-title"><h3>Area Control Centre</h3><span class="ln"></span></div>
    @if (Stations.Accs.Count == 0)
    {
        <div class="callout info"><span class="cic">📭</span><div>
            <p class="ct">Nessuna ACC ancora</p>
            Il database è vuoto. @(Authz.IsAdmin
                ? "Crea la prima ACC per iniziare a inserire posizioni, topologia e documenti."
                : "Lo staff non ha ancora creato ACC: torna più tardi.")
            @if (Authz.IsAdmin)
            {
                <div style="margin-top:10px"><a class="btn primary" href="/vsop/admin/sectorstructure">+ Crea ACC / struttura</a></div>
            }
        </div></div>
    }
    else
    {
        <div class="acc-grid">
            @foreach (var acc in Stations.Accs)
            {
                var n = OnlineCount(acc.Code);
                <a class="acc-card @(n > 0 ? "on" : "off")" href="/vsop/@acc.Code.ToLowerInvariant()" style="text-decoration:none">
                    <div class="onl"><span class="dot"></span> @(n > 0 ? $"{n} online" : "offline")</div>
                    <div class="code">@acc.Code</div>
                    <div class="name">@acc.Name</div>
                </a>
            }
        </div>
    }

    <div class="section-title"><h3>Navigazione rapida</h3><span class="ln"></span></div>
    <div class="choice-grid">
        <a class="choice" href="/vsop/changed" style="text-decoration:none;color:inherit"><h4><span class="ic">🆕</span> Cosa è cambiato dall'ultimo AIRAC</h4><p class="muted">Documenti modificati nel ciclo corrente.</p></a>
    </div>

    @if (Authz.IsAdmin)
    {
        <div class="section-title"><h3>Staff <span class="pill blue" style="font-size:11px">CH/AOD/DIR</span></h3><span class="ln"></span></div>
        <div class="choice-grid">
            <a class="choice" href="/vsop/versioni" style="text-decoration:none;color:inherit"><h4><span class="ic">🗂️</span> Bozze &amp; versioni</h4><p class="muted">Stato documenti, storico e pubblicazioni programmate.</p></a>
            <a class="choice" href="/vsop/screens" style="text-decoration:none;color:inherit"><h4><span class="ic">🧩</span> Tutte le schermate</h4><p class="muted">Indice di navigazione di tutte le pagine accessibili.</p></a>
            <a class="choice" href="/vsop/admin/acc" style="text-decoration:none;color:inherit"><h4><span class="ic">🛰️</span> ACC</h4><p class="muted">Importa gli ACC dalla sorgente e nascondi quelli non operativi.</p></a>
            <a class="choice" href="/vsop/admin/sectorstructure" style="text-decoration:none;color:inherit"><h4><span class="ic">🏗️</span> Struttura settori</h4><p class="muted">Gestisci settori, contenimento, frequenze e documenti.</p></a>
            <a class="choice" href="/vsop/admin/permessi" style="text-decoration:none;color:inherit"><h4><span class="ic">🔑</span> Permessi editing</h4><p class="muted">Concedi a VID (CH o non) il diritto di editare i documenti per ACC.</p></a>
        </div>
    }
</div>

@code {
    // Conteggio one-shot al render: ATC online la cui prima parte del callsign coincide col codice ACC
    // (es. LIRR_NE_CTR → "LIRR"). Le posizioni torre/avvicinamento degli aeroporti non sono incluse: follow-up.
    private int OnlineCount(string accCode)
    {
        var snap = Online.GetCurrent();
        return snap.Callsigns.Count(cs =>
        {
            var i = cs.IndexOf('_');
            var head = i > 0 ? cs[..i] : cs;
            return head.Equals(accCode, StringComparison.OrdinalIgnoreCase);
        });
    }
}
