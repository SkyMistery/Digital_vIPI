@page "/vsop/{Acc}/live"
@layout SopLayout
@rendermode InteractiveServer
@inject IStationResolver Stations
@inject IStructureEditingService Structure
@inject IDocumentAdminService Docs
@inject IAccDerivationService Profile
@inject IAccDocumentService AccDoc
@inject ITopologyProvider Topology
@inject IAorService Aor
@inject IOnlineAtcProvider Online
@inject ITransferService Transfers
@inject ICurrentUserProvider Users
@inject IAiracService Airac
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_UnknownAcc"]</p>@Acc</div></div></div>
}
else
{
    <PageTitle>@_data.AccName — @L["Live_Tab"] · vIPI IVAO Italia</PageTitle>
    <div class="wrap">
        <div class="breadcrumb">
            <a href="/vsop">@L["Common_Home"]</a> › <a href="/vsop/@Acc.ToLowerInvariant()">@_data.AccCode</a> › <b>@L["Live_Tab"]</b>
        </div>

        <div class="reduced-top">
            <h2 style="margin:0">@_data.AccName — @L["Live_Tab"]</h2>
            <span class="live-badge" style="background:#dafbe7;color:#0f7a37;border-color:#a7e9c1"><span class="dot"></span> Live · @_p</span>
            <label class="muted" style="font-size:13px;margin-left:auto">@L["Live_Position"]
                <select value="@_p" @onchange="OnPositionPicked" style="margin-left:6px;padding:4px 8px">
                    @foreach (var pos in _positions) { <option value="@pos">@pos</option> }
                </select>
            </label>
            @if (_myCallsign is not null)
            {
                <span class="xo-chip on" title="@(_followMe ? L["Live_DetectedFromIvao"] : L["Live_FollowOffTip"])">@_myCallsign</span>
                @if (!_followMe && _positions.Contains(_myCallsign) && _myCallsign != _p)
                {
                    <button type="button" class="btn ghost" style="padding:3px 10px;font-size:12.5px" @onclick="FollowMeAgain">↺ @L["Live_FollowMe", _myCallsign]</button>
                }
            }
            <span class="muted" style="font-size:13px">@L["Live_AtcOnlineN", _snapshot.Callsigns.Count] · @(_snapshot.AsOf == DateTimeOffset.MinValue ? "—" : _snapshot.AsOf.ToLocalTime().ToString("HH:mm:ss"))</span>
            <a class="btn ghost" href="/vsop/@Acc.ToLowerInvariant()/vipi">@L["Live_ExtendedDoc"]</a>
        </div>

        @if (_noDoc)
        {
            @* Il documento porta il raggruppamento, non il dato: senza vIPI pubblicata la pagina resta
               utilizzabile (trasferimenti, AoR, frequenze dai cataloghi) e lo dice, invece di sparire. *@
            <div class="callout warning"><span class="cic"><Icon Name="warning" Size="18" /></span><div><p class="ct">@L["Live_NoDocTitle", _acc.Code]</p>@((MarkupString)string.Format(L["Live_NoDocBody"], $"/vsop/{Acc.ToLowerInvariant()}/vipi"))</div></div>
        }
        else
        {
            <div class="callout info"><span class="cic">⚡</span><div><p class="ct">@L["Live_ReducedLiveTitle"]</p>@((MarkupString)string.Format(L["Live_ReducedLiveBody"], _p))</div></div>
        }

        @if (_changes.Count > 0)
        {
            @* La pagina si riscriveva in silenzio a ogni tick: qui i cambi restano scritti finché non li scarti. *@
            <div class="live-changes" role="status" aria-live="polite">
                <span class="lc-lab">@L["Live_ChangesLabel"]</span>
                @foreach (var ch in Enumerable.Reverse(_changes))
                {
                    <span class="lc-chip @(ch.Online ? "on" : "off")">@(ch.Online ? "▲" : "▼") @ch.Callsign <span class="lc-t">@Z(ch.At)</span></span>
                }
                <button type="button" class="lc-clear" @onclick="() => _changes.Clear()">@L["Live_ChangesClear"]</button>
            </div>
        }

        <p class="muted" style="font-size:13.5px;margin-bottom:7px">@L["Live_QuickView"]</p>
        <div class="apt-quick" style="margin-bottom:22px">
            <span class="ch sw @(_selectedApt is null ? "on" : "")" @onclick="() => _selectedApt = null">📡 @L["Live_MySector"]</span>
            @foreach (var (ap, direct, deleg) in OrderedApts())
            {
                var icao = ap.Icao;
                <span class="ch sw @(direct && !deleg ? "" : "ch-deleg") @(_selectedApt == icao ? "on" : "")"
                      title="@(deleg ? L["Live_AptDelegatedTip"] : direct ? L["Live_AptQuickTip"] : L["Live_AptOtherTip"])"
                      @onclick="() => _selectedApt = icao">@icao@(deleg ? L["Live_DelegSuffix"] : "")</span>
            }
        </div>

        @if (_selectedApt is not null)
        {
            <AirportQuickPanel Icao="@_selectedApt" Acc="@Acc" />
        }
        else
        {
            var freqRows = _freqs.Values.SelectMany(x => x)
                .GroupBy(r => r.Callsign, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First()).ToList();
            var appGroups = _data.Blocks.Where(b => b.Kind == AccBlockKind.AppGroup).ToList();
            var onlineAround = _resolved
                .SelectMany(r => r.Points.Where(p => p.IsOnline).Select(p => p.ResolvedHandler)
                    .Append(r.OwnerOnline ? r.ResolvedOwnerCallsign : null))
                .Where(cs => !string.IsNullOrWhiteSpace(cs)).Select(cs => cs!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(c => c, StringComparer.OrdinalIgnoreCase).ToList();

        <div class="red-top-grid">
            @* Chiuse alla prima apertura (data-persist ricorda poi la scelta): la vista si apre su una
               mappa leggibile della postazione, non su due muri di tabelle da scorrere. *@
            <details class="acc-item" data-persist="live-freq">
                <summary><span>📻 @L["Common_Frequencies"]</span><span class="tag-state tag-covered">@freqRows.Count</span></summary>
                <div class="body">
                    @if (freqRows.Count > 0) { <AppFrequencies Rows="freqRows" /> }
                    else { <p class="muted" style="font-size:13px;margin:0">@L["Live_NoFreqDerived"]</p> }
                </div>
            </details>

            @foreach (var block in appGroups.Where(b => IsDelegated(b)))
            {
                <details class="acc-item collapsed-strip" data-persist="@($"live-blk-{block.Key}")">
                    <summary><span>🔇 @block.Title — @L["Live_Delegated"]</span><span class="tag-state tag-online">@L["Common_TagOnline"]</span></summary>
                    <div class="body">
                        <p class="muted" style="font-size:13px;margin-top:0">@((MarkupString)string.Format(L["Live_CollapsedBody"], block.Title))</p>
                        <AccSectionBody Block="block" Key="frequencies" Root="@_root" Freqs="_freqs.GetValueOrDefault(block.Key)" />
                    </div>
                </details>
            }

            @foreach (var block in appGroups.Where(b => !IsDelegated(b)))
            {
                <details class="acc-item" open data-persist="@($"live-blk-{block.Key}")">
                    <summary><span>📡 @block.Title</span><span class="tag-state tag-covered">@L["Common_TagCovered"]</span></summary>
                    <div class="body">
                        <AccSectionBody Block="block" Key="frequencies" Root="@_root" Freqs="_freqs.GetValueOrDefault(block.Key)" />
                    </div>
                </details>
            }
        </div>

        <details class="acc-item" data-persist="live-xfer">
            <summary><span><Icon Name="refresh" /> @L["Live_TransfersTitle"]</span><span class="tag-state tag-covered">@_resolved.Count</span></summary>
            <div class="body">
                <div class="xfer-online">
                    <span class="xo-label">@L["Live_OnlineAround"]</span>
                    @if (onlineAround.Count > 0)
                    {
                        @foreach (var cs in onlineAround) { <span class="xo-chip on">@cs</span> }
                    }
                    else { <span class="muted xo-hint">@L["Live_NoNeighbourOnline"]</span> }
                    <span class="muted xo-hint">@L["Live_TransfersHint"]</span>
                </div>
                <TransfersLive Flows="_resolved" EmptyText="@L["Live_NoCoord"]" Changed="ChangedCallsigns()" />
            </div>
        </details>
        }
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;

    /// <summary>Postazione scelta a mano (?p=CALLSIGN). Assente = la vista segue la tua connessione IVAO.</summary>
    [SupplyParameterFromQuery(Name = "p")] public string? PositionParam { get; set; }

    private AccInfo? _acc;
    private AccVipiData _data = new() { AccCode = "", AccName = "", Blocks = new() };
    private Topology? _topo;
    private string? _root;
    private IReadOnlyList<string> _positions = Array.Empty<string>();
    private string _p = "";
    private OnlineAtcSnapshot _snapshot = OnlineAtcSnapshot.Empty;
    private AorResult? _aor;
    private IReadOnlyList<ResolvedTransferFlow> _resolved = Array.Empty<ResolvedTransferFlow>();
    private string? _myCallsign;
    private IReadOnlyList<AirportRow> _apts = Array.Empty<AirportRow>();
    private string? _selectedApt;
    private bool _noDoc;          // ACC senza vIPI pubblicata: la pagina resta viva, con banner + frequenze di ripiego
    private bool _followMe = true; // la postazione segue la connessione IVAO finché non la scegli a mano

    private readonly Dictionary<string, List<AppFreqRow>> _freqs = new();

    /// <summary>Un ente rilevante è passato online/offline mentre la pagina era aperta.</summary>
    private sealed record LiveChange(string Callsign, bool Online, DateTimeOffset At);

    private const int MaxChanges = 6;
    private readonly List<LiveChange> _changes = new();
    private HashSet<string>? _prevOnline;   // null = primo caricamento: lo stato iniziale non è un cambio

    private DotNetObjectReference<AccLivePage>? _ref;

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) return;

        var roots = await Profile.ListTreeRootsAsync(Acc);
        _root = roots.Count > 0 ? roots[0].Callsign : null;

        _topo = await Topology.BuildByAccCodeAsync(_acc.Code);

        // Struttura ACC: posizioni operative = solo i settori CTR; aeroporti pubblicati per i chip vista rapida.
        var structure = await Structure.LoadAsync(_acc.Code);
        var ctr = (structure?.Sectors ?? Array.Empty<SectorRow>())
            .Where(s => s.Type == SectorType.Ctr)
            .OrderBy(s => s.Callsign, StringComparer.OrdinalIgnoreCase).ToList();
        _positions = ctr.Select(s => s.Callsign).ToList();
        var primary = ctr.FirstOrDefault(s => s.IsPrimary)?.Callsign;

        // Visibilità pubblica = release effettiva (doc 10 §3f), non nascosti.
        var published = (await Docs.ListAsync())
            .Where(m => m.Kind == ManagedDocKind.AirportVipi && m.HasEffectiveRelease && !m.IsHidden
                        && string.Equals(m.AccCode, _acc.Code, StringComparison.OrdinalIgnoreCase))
            .Select(m => m.Scope).ToHashSet(StringComparer.OrdinalIgnoreCase);
        _apts = structure?.Airports
            .Where(x => x.IsPublic && published.Contains(x.Icao))
            .OrderBy(x => x.Icao).ToList()
            ?? (IReadOnlyList<AirportRow>)Array.Empty<AirportRow>();

        _snapshot = Online.GetCurrent();
        _myCallsign = MyCallsign();

        // ?p= è una scelta esplicita (link salvato tra i preferiti, o il selettore): vince e sgancia
        // l'aggancio alla connessione, altrimenti la pagina te la riporterebbe via al primo tick.
        var wanted = (PositionParam ?? "").Trim().ToUpperInvariant();
        if (wanted.Length > 0 && _positions.Contains(wanted))
        {
            _p = wanted;
            _followMe = false;
        }
        else if (string.IsNullOrEmpty(_p) || !_positions.Contains(_p))
        {
            // Default P = posizione connessa (se CTR di questa ACC), altrimenti il CTR primario, altrimenti un CTR radice.
            _followMe = true;
            _p = (_myCallsign is not null && _positions.Contains(_myCallsign))
                ? _myCallsign
                : primary
                  ?? _positions.FirstOrDefault(c => _topo is not null && !_topo.Parent.ContainsKey(c))
                  ?? _positions.FirstOrDefault() ?? "";
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_acc is null) return;

        // La vista live è legata all'ENTE che apri, non al documento: trasferimenti e AoR non toccano il
        // documento, e le frequenze escono dai cataloghi (il blocco porta solo raggruppamento e ordine).
        // Senza vIPI pubblicata (LoadForViewAsync null, doc 10 §3f) la pagina resta quindi utilizzabile.
        var model = await AccDoc.LoadForViewAsync(_acc.Code);
        _noDoc = model is null;
        _data = model?.Data ?? new AccVipiData { AccCode = _acc.Code, AccName = _acc.Name, Blocks = new() };
        _snapshot = Online.GetCurrent();
        SyncPosition();
        var online = new HashSet<string>(_snapshot.Callsigns, StringComparer.OrdinalIgnoreCase);
        _aor = _topo is not null && !string.IsNullOrEmpty(_p) ? Aor.Resolve(_topo, _p, online) : null;
        _resolved = await Transfers.ResolveForAccAsync(_acc.Code, online);
        TrackChanges(online);

        _freqs.Clear();
        foreach (var b in _noDoc ? await FallbackBlocksAsync() : _data.Blocks)
            _freqs[b.Key] = (await Profile.DeriveFrequenciesAsync(_acc.Code, b, _root)).ToList();
    }

    /// <summary>
    /// Enti che contano per questa postazione: il dominio topologico di P (chi copro / chi mi copre) e chiunque
    /// compaia nei miei trasferimenti. Ancorata al callsign CONFIGURATO (<c>NextSectorCallsign</c>) e non solo a
    /// quello risolto: altrimenti chi va offline uscirebbe dall'insieme e il suo cambio non verrebbe mai visto.
    /// </summary>
    private HashSet<string> RelevantCallsigns()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (_topo is not null && !string.IsNullOrEmpty(_p))
            foreach (var cs in _topo.DomainOf(_p)) set.Add(cs);

        foreach (var r in _resolved)
        {
            set.Add(r.Flow.OwningSectorCallsign);
            set.Add(r.ResolvedOwnerCallsign);
            foreach (var pt in r.Points)
            {
                if (!string.IsNullOrWhiteSpace(pt.Point.NextSectorCallsign)) set.Add(pt.Point.NextSectorCallsign!);
                set.Add(pt.ResolvedHandler);
            }
        }

        set.Remove("UNICOM");   // non è un ente che va online o offline
        return set;
    }

    /// <summary>
    /// Diff dell'insieme online fra due tick. Senza questo la pagina si riscriveva in silenzio: un punto di
    /// trasferimento poteva cambiare destinatario sotto gli occhi di chi stava guardando altrove.
    /// </summary>
    private void TrackChanges(HashSet<string> online)
    {
        var relevant = RelevantCallsigns();
        var now = new HashSet<string>(online.Where(relevant.Contains), StringComparer.OrdinalIgnoreCase);
        if (_prevOnline is null) { _prevOnline = now; return; }

        var at = _snapshot.AsOf == DateTimeOffset.MinValue ? DateTimeOffset.UtcNow : _snapshot.AsOf;
        foreach (var cs in now.Except(_prevOnline, StringComparer.OrdinalIgnoreCase)) _changes.Add(new(cs, true, at));
        foreach (var cs in _prevOnline.Except(now, StringComparer.OrdinalIgnoreCase)) _changes.Add(new(cs, false, at));

        _prevOnline = now;
        if (_changes.Count > MaxChanges) _changes.RemoveRange(0, _changes.Count - MaxChanges);
    }

    /// <summary>Orario in UTC: un controllore ragiona in Z, non nel fuso del suo PC.</summary>
    private static string Z(DateTimeOffset at) => at.UtcDateTime.ToString("HH:mm") + "Z";

    private IReadOnlySet<string> ChangedCallsigns() =>
        _changes.Select(c => c.Callsign).ToHashSet(StringComparer.OrdinalIgnoreCase);

    private string? MyCallsign() => Users.Get() is { } u
        ? _snapshot.Details.FirstOrDefault(d => d.UserId == u.UserId)?.Callsign
        : null;

    /// <summary>
    /// Riaggancia la postazione alla tua connessione IVAO a ogni tick live. Prima <c>_myCallsign</c> si
    /// calcolava una volta sola all'apertura: chi apriva la pagina e si connetteva dopo non veniva mai
    /// agganciato, e restava a guardare il settore sbagliato. Il selettore manuale sgancia (<c>_followMe</c>).
    /// </summary>
    private void SyncPosition()
    {
        _myCallsign = MyCallsign();
        if (!_followMe || _myCallsign is null || !_positions.Contains(_myCallsign)) return;
        _p = _myCallsign;
    }

    /// <summary>Scelta manuale: sgancia il follow e finisce in ?p=, così il tab è ricaricabile e salvabile.</summary>
    private void OnPositionPicked(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(picked)) return;
        _followMe = false;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("p", picked), replace: true);
    }

    /// <summary>Torna a seguire la connessione (toglie ?p=).</summary>
    private void FollowMeAgain()
    {
        _followMe = true;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("p", (string?)null), replace: true);
    }

    /// <summary>
    /// Blocchi sintetici usati quando l'ACC non ha vIPI pubblicata: stessa derivazione dei blocchi veri, ma il
    /// raggruppamento lo fa il catalogo invece dell'editore — tutti i CTR dell'ACC (Aerovia a membri vuoti) e
    /// tutti i suoi APP. Non finiscono in <c>_data.Blocks</c>: servono solo a riempire l'elenco frequenze.
    /// </summary>
    private async Task<IReadOnlyList<AccBlock>> FallbackBlocksAsync()
    {
        var apps = await Profile.ListAppSectorsAsync(_acc!.Code);
        return new[]
        {
            new AccBlock { Key = "fallback:ctr", Kind = AccBlockKind.Aerovia },
            new AccBlock { Key = "fallback:app", Kind = AccBlockKind.AppGroup, MemberCallsigns = apps.Select(a => a.Callsign).ToList() },
        };
    }

    // Un gruppo-APP è "delegato" (collassato) quando un suo settore membro è gestito da un subordinato online (≠ P).
    private bool IsDelegated(AccBlock block) =>
        _aor is not null && block.MemberCallsigns.Any(cs =>
            _aor.State.TryGetValue(cs, out var st) && st == SectorState.Online);

    // Aeroporto "delegato" (controllato online): un callsign col primo token = ICAO (es. LIRF_TWR, LIRF_S_APP).
    private bool IsAptDelegated(string icao) =>
        _snapshot.Callsigns.Any(cs => cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase));

    // Chip aeroporto: SOLO i discendenti del settore aperto P nell'albero (figli o figli-dei-figli = ParentCallsign
    // nel dominio di P). Dentro: prima quelli sotto controllo diretto, in fondo i delegati (APP/TWR online). Alfabetico.
    private IEnumerable<(AirportRow Ap, bool Direct, bool Deleg)> OrderedApts()
    {
        var domain = _topo is not null && !string.IsNullOrEmpty(_p)
            ? _topo.DomainOf(_p)
            : (IReadOnlySet<string>)new HashSet<string>();
        return _apts
            .Where(ap => ap.ParentCallsign is { } pc && domain.Contains(pc))
            .Select(ap =>
            {
                var deleg = IsAptDelegated(ap.Icao);
                return (Ap: ap, Direct: !deleg, Deleg: deleg);
            })
            .OrderByDescending(x => x.Direct)
            .ThenBy(x => x.Ap.Icao, StringComparer.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("vipiLive.subscribe", _ref);
        }

        // A ogni render, non solo il primo: cambiando chip aeroporto o a un tick live i <details> vengono
        // ricreati e perderebbero la persistenza del collasso (wireCollapse gira solo a load/enhancedload).
        try { await JS.InvokeVoidAsync("vipiWireCollapse"); } catch (JSDisconnectedException) { /* circuito chiuso */ }
    }

    /// <summary>Chiamato dal browser (SSE) a ogni cambio della cache ATC.</summary>
    [JSInvokable]
    public async Task OnLiveUpdate()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("vipiLive.unsubscribe"); } catch { /* circuito chiuso */ }
        _ref?.Dispose();
    }
}
