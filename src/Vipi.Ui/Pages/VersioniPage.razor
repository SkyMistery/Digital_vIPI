@page "/vsop/versioni"
@page "/vsop/{Acc}/versioni"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditingService Editing
@inject IReleaseService Releases
@inject IDocumentAdminService DocAdmin
@inject IEditAuthorizationService Authz
@inject Vipi.Application.Abstractions.IStaffRosterRepository StaffRoster
@inject Vipi.Application.Abstractions.IAuditLogReader Audit
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Vipi.Ui.Shared.Routing.IDocRoutesRegistry DocRoutes
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nd_Drafts"] · IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/vsop">Admin</a> › <b>@L["Nd_Drafts"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Nd_Drafts"]</h2><span class="muted">@(string.Format(L["Ver_Subtitle"].Value, _currentCycle))</span></div>
        <div style="display:flex;gap:8px;align-items:center">
            @if (_docs is not null && Filtered().Any())
            {
                <button type="button" class="btn ghost" @onclick="ToggleExpandAll">@(AllExpanded ? "▴ " + L["Ver_CollapseAll"] : "▾ " + L["Ver_ExpandAll"])</button>
            }
            <a class="btn primary" href="/vsop/editor/newdoc"><Icon Name="plus" /> @L["Nd_Title"]</a>
        </div>
    </div>

    @if (_error is not null) { <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Ver_NotAllowed"]</p>@_error</div></div> }
    @if (_status is not null) { <div class="callout success"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div>@_status</div></div> }

    @if (_docs is null)
    {
        <LoadingState />
    }
    else
    {
        @* ---- riepilogo campagna release ---- *@
        <div class="block" style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;margin:10px 0;font-size:13px">
            <b><Icon Name="calendar" /> @(string.Format(L["Ver_CurrentCycle"].Value, _currentCycle))</b>
            <span class="muted">@(string.Format(L["Ver_NDocs"].Value, _docs.Count))</span>
            <span class="pill green" title="@L["Ver_EffectiveTitle"]">🟢 @(string.Format(L["Ver_NEffective"].Value, CampaignCount("effective")))</span>
            <span class="pill blue" title="@L["Ver_ScheduledTitle"]">🕒 @(string.Format(L["Ver_NScheduled"].Value, CampaignCount("scheduled")))</span>
            <span class="pill grey" title="@L["Ver_NoReleaseTitle"]">⚠️ @(string.Format(L["Ver_NNoRelease"].Value, CampaignCount("none")))</span>
        </div>

        @* ---- barra ricerca + filtri ---- *@
        <div class="htree-search" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0">
            <input class="app-in" style="flex:1;min-width:220px" placeholder="@L["Ver_SearchPh"]"
                   value="@_q" @oninput="e => SetQuery(e.Value?.ToString())" />
            <span>@L["Ver_KindLabel"]</span>
            @foreach (var (k, lab) in KindFilters)
            {
                <span class="pill @(_kindFilter == k ? "blue" : "grey")" style="cursor:pointer" @onclick="() => SetKind(k)">@lab</span>
            }
            <span style="margin-left:6px">@L["Ver_StatusLabel"]</span>
            @foreach (var (s, lab) in StatusFilters)
            {
                <span class="pill @(_statusFilter == s ? "blue" : "grey")" style="cursor:pointer" @onclick="() => SetStatus(s)">@lab</span>
            }
            <span style="margin-left:6px">@L["Ver_ReleaseLabel"]</span>
            @foreach (var (s, lab) in ReleaseFilters)
            {
                <span class="pill @(_releaseFilter == s ? "blue" : "grey")" style="cursor:pointer" @onclick="() => SetRelease(s)">@lab</span>
            }
        </div>

        <p class="muted" style="font-size:12px">@Filtered().Count() @(IsFiltering ? string.Format(L["Ver_OfTotal"].Value, _docs.Count) : "") @L["Ver_DocsWord"]@(IsFiltering ? L["Ver_FilteredSuffix"].Value : "")</p>

        @if (!Filtered().Any())
        {
            <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">@L["Ver_NoDoc"]</p>@L["Ver_NoDocMatch"]</div></div>
        }

        @foreach (var d in Filtered())
        {
            var key = RowKey(d);
            var open = _expanded.Contains(key);
            <div class="doc-rowi" style="@(d.IsHidden ? "opacity:.6" : "")">
                <button type="button" class="btn ghost" style="min-width:30px" @onclick="() => Toggle(key)">@(open ? "▾" : "▸")</button>
                <span class="di"><Icon Name="@KindIcon(d.Kind)" Size="18" /></span>
                <div style="flex:1">
                    <b>@d.Title</b>
                    <div class="muted" style="font-size:12px">@KindLabel(d.Kind) · @d.Scope</div>
                </div>
                @if (d.IsHidden) { <span class="pill grey">@L["Ver_Hidden"]</span> }
                else if (d.HasDraft) { <span class="pill grey">@L["Ver_DraftOpen"]</span> }
                else { <span class="pill green">@L["Ver_Public"]</span> }
                @{ var sum = SummaryOf(d); }
                @if (sum is not null && sum.EffectiveCycle is not null)
                {
                    <span class="pill green" title="@L["Ver_EffectiveNowTitle"]">🟢 AIRAC @sum.EffectiveCycle</span>
                }
                @if (sum is not null && sum.NextScheduledCycle is not null)
                {
                    <span class="pill blue" title="@L["Ver_ScheduledFutureTitle"]">🕒 @sum.NextScheduledCycle</span>
                }
                @if (_summariesLoaded && sum is null)
                {
                    <span class="pill grey" title="@L["Ver_NoReleaseTitle"]">⚠️ @L["Ver_NoReleaseBadge"]</span>
                }
                <a class="btn ghost" href="@EditorLink(d)">@L["Nd_OpenEditor"]</a>
                @if (Authz.IsAdmin)
                {
                    <button class="btn ghost" disabled="@_busy" title="@(d.IsHidden ? L["Ver_ShowPublicTitle"] : L["Ver_HidePublicTitle"])"
                            @onclick="() => ToggleHidden(d)"><Icon Name="@(d.IsHidden ? "eye" : "eye-off")" /> @(d.IsHidden ? L["AccAdmin_Show"] : L["AccAdmin_Hide"])</button>
                    <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Ver_DeletePermTitle"]" AriaLabel="@L["Ver_DeleteDocAria"]"
                                   Prompt="@L["Ver_DeletePrompt"]" Disabled="@_busy" OnConfirm="() => Delete(d)">
                        <Trigger><Icon Name="trash" /></Trigger>
                    </InlineConfirm>
                }
            </div>

            @if (open)
            {
                <div style="margin:6px 0 20px 40px">
                    @DetailBlock(d)
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public string? Acc { get; set; }

    private IReadOnlyList<ManagedDoc>? _docs;
    private readonly HashSet<string> _expanded = new();
    private readonly HashSet<string> _loadingKeys = new();
    private readonly Dictionary<string, IReadOnlyList<VersionInfo>> _versions = new();
    private readonly Dictionary<string, IReadOnlyList<ReleaseInfo>> _releases = new();
    private Dictionary<string, ReleaseSummary> _summaries = new();
    private bool _summariesLoaded;
    private readonly Dictionary<int, string> _authorNames = new();
    private readonly Dictionary<string, IReadOnlyList<Vipi.Application.Abstractions.AuditEntry>> _history = new();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private bool _busy;
    private string? _status, _error;

    // filtri
    private string _q = "";
    private ManagedDocKind? _kindFilter;      // null = tutti
    private string _statusFilter = "all";     // all|public|draft|hidden
    private string _releaseFilter = "all";    // all|effective|scheduled|none

    private (ManagedDocKind?, string)[] KindFilters =>
    new (ManagedDocKind?, string)[]
    {
        (null, L["Ver_FilterAll_M"]), (ManagedDocKind.Vloa, "vLOA"), (ManagedDocKind.AccVipi, "ACC"),
        (ManagedDocKind.AirportVipi, L["Nd_Airport"]), (ManagedDocKind.AppVipi, "APP"),
    };
    private (string, string)[] StatusFilters =>
    new (string, string)[]
    {
        ("all", L["Ver_FilterAll_M"]), ("public", L["Ver_FilterPublic"]), ("draft", L["Ver_FilterDraft"]), ("hidden", L["Ver_FilterHidden"]),
    };
    private (string, string)[] ReleaseFilters =>
    new (string, string)[]
    {
        ("all", L["Ver_FilterAll_F"]), ("effective", L["Rel_Effective"]), ("scheduled", L["Ver_FilterScheduled"]), ("none", L["Ver_FilterNoRelease"]),
    };

    protected override async Task OnInitializedAsync()
    {
        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        ReadFiltersFromUrl();
        await LoadAsync();
        await LoadSummariesAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _docs = await DocAdmin.ListAsync();
            // Pre-filtro per ACC dal route /vsop/{acc}/versioni.
            if (!string.IsNullOrWhiteSpace(Acc))
            {
                var acc = Acc.Trim().ToUpperInvariant();
                _docs = _docs.Where(d => string.Equals(d.AccCode, acc, StringComparison.OrdinalIgnoreCase)).ToList();
            }
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    // Stato release di TUTTE le righe in un colpo, per badge/filtri/riepilogo senza espandere.
    private async Task LoadSummariesAsync()
    {
        if (_docs is null) return;
        var targets = _docs.Select(d => (d.ReleaseTarget, d.ReleaseKey)).Distinct().ToList();
        var map = await Releases.SummariesAsync(targets);
        _summaries = _docs
            .GroupBy(RowKey)
            .ToDictionary(g => g.Key, g =>
            {
                var d = g.First();
                return map.TryGetValue((d.ReleaseTarget, d.ReleaseKey), out var s) ? s : null;
            })
            .Where(kv => kv.Value is not null)
            .ToDictionary(kv => kv.Key, kv => kv.Value!);
        _summariesLoaded = true;
    }

    private ReleaseSummary? SummaryOf(ManagedDoc d) => _summaries.TryGetValue(RowKey(d), out var s) ? s : null;

    private int CampaignCount(string kind)
    {
        if (_docs is null) return 0;
        return _docs.Count(d =>
        {
            var s = SummaryOf(d);
            return kind switch
            {
                "effective" => s?.EffectiveCycle is not null,
                "scheduled" => s?.NextScheduledCycle is not null,
                "none" => s is null,
                _ => false,
            };
        });
    }

    private bool IsFiltering => !string.IsNullOrWhiteSpace(_q) || _kindFilter is not null || _statusFilter != "all" || _releaseFilter != "all";

    private IEnumerable<ManagedDoc> Filtered()
    {
        if (_docs is null) return Array.Empty<ManagedDoc>();
        var q = _q.Trim();
        return _docs.Where(d =>
            (_kindFilter is null || d.Kind == _kindFilter)
            && (_statusFilter switch
            {
                "public" => !d.IsHidden && !d.HasDraft,
                "draft" => d.HasDraft,
                "hidden" => d.IsHidden,
                _ => true,
            })
            && (_releaseFilter switch
            {
                "effective" => SummaryOf(d)?.EffectiveCycle is not null,
                "scheduled" => SummaryOf(d)?.NextScheduledCycle is not null,
                "none" => SummaryOf(d) is null,
                _ => true,
            })
            && (q.Length == 0
                || d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                || d.Scope.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (d.AccCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)));
    }

    private static string RowKey(ManagedDoc d) => $"{d.Kind}:{d.ReleaseKey}:{d.DocumentId}";

    private async Task Toggle(string key)
    {
        if (!_expanded.Remove(key))
        {
            _expanded.Add(key);
            _loadingKeys.Add(key);
            StateHasChanged();
            await LoadDetailAsync(key);
            _loadingKeys.Remove(key);
        }
    }

    private bool AllExpanded => _docs is not null && Filtered().All(d => _expanded.Contains(RowKey(d)));

    private async Task ToggleExpandAll()
    {
        if (_docs is null) return;
        var rows = Filtered().ToList();
        if (AllExpanded)
        {
            foreach (var d in rows) _expanded.Remove(RowKey(d));
            return;
        }
        foreach (var d in rows)
        {
            var key = RowKey(d);
            if (_expanded.Add(key)) { _loadingKeys.Add(key); }
        }
        StateHasChanged();
        foreach (var d in rows)
        {
            var key = RowKey(d);
            if (_loadingKeys.Contains(key)) { await LoadDetailAsync(key); _loadingKeys.Remove(key); }
        }
    }

    // ---- filtri: setter + sync URL (?q=&kind=&stato=&rel=) ----
    private void SetQuery(string? q) { _q = q ?? ""; SyncUrl(); }
    private void SetKind(ManagedDocKind? k) { _kindFilter = k; SyncUrl(); }
    private void SetStatus(string s) { _statusFilter = s; SyncUrl(); }
    private void SetRelease(string s) { _releaseFilter = s; SyncUrl(); }

    private void SyncUrl()
    {
        var qp = new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(_q) ? null : _q,
            ["kind"] = _kindFilter?.ToString(),
            ["stato"] = _statusFilter == "all" ? null : _statusFilter,
            ["rel"] = _releaseFilter == "all" ? null : _releaseFilter,
        };
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(qp), forceLoad: false, replace: true);
    }

    private void ReadFiltersFromUrl()
    {
        var q = ParseQuery(new Uri(Nav.Uri).Query);
        if (q.TryGetValue("q", out var qv)) _q = qv;
        if (q.TryGetValue("kind", out var kv) && Enum.TryParse<ManagedDocKind>(kv, out var k)) _kindFilter = k;
        if (q.TryGetValue("stato", out var sv) && StatusFilters.Any(f => f.Item1 == sv)) _statusFilter = sv;
        if (q.TryGetValue("rel", out var rv) && ReleaseFilters.Any(f => f.Item1 == rv)) _releaseFilter = rv;
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var i = part.IndexOf('=');
            if (i <= 0) continue;
            var name = Uri.UnescapeDataString(part[..i]);
            var val = Uri.UnescapeDataString(part[(i + 1)..]);
            d[name] = val;
        }
        return d;
    }

    // Lazy: versioni (solo Document) + release, caricate quando la riga è espansa.
    private async Task LoadDetailAsync(string key)
    {
        var d = _docs?.FirstOrDefault(x => RowKey(x) == key);
        if (d is null) return;
        try
        {
            if (d.DocumentId is int docId && !_versions.ContainsKey(key))
                _versions[key] = await Editing.ListVersionsAsync(docId);
            if (!_releases.ContainsKey(key))
                _releases[key] = await Releases.ListAsync(d.ReleaseTarget, d.ReleaseKey);
            // Storia modifiche (audit) solo per i profili ACC/APP: non hanno version-list.
            if ((d.Kind is ManagedDocKind.AccVipi or ManagedDocKind.AppVipi) && !_history.ContainsKey(key))
            {
                var (etype, eid) = AuditRefOf(d);
                _history[key] = await Audit.ListForEntityAsync(etype, eid);
            }
            await ResolveAuthorsAsync(key);
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    // Risolve i VID mostrati (versioni + release) in nomi, una volta per riga.
    private async Task ResolveAuthorsAsync(string key)
    {
        var vids = new HashSet<int>();
        if (_versions.TryGetValue(key, out var vs)) foreach (var v in vs) vids.Add(v.CreatedByUserId);
        if (_releases.TryGetValue(key, out var rs)) foreach (var r in rs) vids.Add(r.CreatedByUserId);
        if (_history.TryGetValue(key, out var hs)) foreach (var h in hs) vids.Add(h.UserId);
        var missing = vids.Where(id => id != 0 && !_authorNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) return;
        var names = await StaffRoster.GetDisplayNamesAsync(missing);
        foreach (var kv in names) _authorNames[kv.Key] = kv.Value;
    }

    private string Author(int vid) =>
        _authorNames.TryGetValue(vid, out var n) ? $"{n} (VID {vid})" : $"VID {vid}";

    // Chiave audit del profilo: ACC = codice ACC; APP = callsign (= ReleaseKey). Normalizzati upper.
    private static (string EntityType, string EntityId) AuditRefOf(ManagedDoc d) => d.Kind switch
    {
        ManagedDocKind.AccVipi => ("AccProfile", (d.AccCode ?? "").ToUpperInvariant()),
        ManagedDocKind.AppVipi => ("AppProfile", d.ReleaseKey.ToUpperInvariant()),
        _ => ("", ""),
    };

    // Riepilogo leggero delle aree toccate dal DetailsJson {"Areas":[...],"Saves":N}.
    private string HistoryDetail(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            var areas = root.TryGetProperty("Areas", out var a) && a.ValueKind == System.Text.Json.JsonValueKind.Array
                ? string.Join(", ", a.EnumerateArray().Select(x => x.GetString()).Where(x => !string.IsNullOrEmpty(x)))
                : "";
            var saves = root.TryGetProperty("Saves", out var s) && s.TryGetInt32(out var n) ? n : 0;
            var sfx = saves > 1 ? string.Format(L["Ver_SavesSuffix"].Value, saves) : "";
            return areas.Length > 0 ? $"{areas}{sfx}" : sfx.TrimStart(' ', '·', ' ');
        }
        catch (System.Text.Json.JsonException) { return ""; }
    }

    private RenderFragment DetailBlock(ManagedDoc d) => __builder =>
    {
        var key = RowKey(d);
        @if (_loadingKeys.Contains(key))
        {
            <p class="help" style="margin:0 0 6px">@L["Common_Loading"]</p>
        }
        @if (_versions.TryGetValue(key, out var vers) && vers.Count > 0)
        {
            foreach (var v in vers)
            {
                <div class="ver-row @(v.IsCurrent ? "current" : "")">
                    @* v@(...) con parentesi: «v@v.…» sarebbe letto da Razor come email ed emesso letterale. *@
                    <span class="vb">v@(v.VersionNumber)</span>
                    <div>
                        <b>@StatusLabel(v.Status)</b>
                        @if (v.IsCurrent) { <span class="pill green">@L["Ver_Current"]</span> }
                        <div class="vmeta" title="@L["Ver_AuthorDraftTitle"]">@Author(v.CreatedByUserId) · @v.CreatedUtc.ToString("dd MMM yyyy HH:mm") · AIRAC @v.AiracCycle@(string.IsNullOrWhiteSpace(v.Note) ? "" : $" — \"{v.Note}\"")</div>
                    </div>
                    <span class="vact">
                        @if (v.Status == DocumentStatus.Draft)
                        {
                            <button class="btn primary" disabled="@_busy" @onclick="() => Publish(d, v.Id)">@L["Ver_PublishVersion"]</button>
                            @* Scartare distrugge lavoro: stessa conferma in linea dell'eliminazione documento. *@
                            @* Etichette passate esplicitamente: i default del componente sono in italiano fisso
                               e direbbero «elimina», mentre qui l'azione è «scarta» — e la pagina può essere in inglese. *@
                            <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Ver_DiscardTitle"]" AriaLabel="@L["Ver_DiscardAria"]"
                                           Prompt="@L["Ver_DiscardPrompt"]" Disabled="@_busy"
                                           ConfirmLabel="@L["Ver_DiscardConfirm"]" CancelLabel="@L["Common_Cancel"]"
                                           OnConfirm="() => DiscardDraft(d, v.Id)">
                                <Trigger><Icon Name="trash" /> @L["Ver_Discard"]</Trigger>
                            </InlineConfirm>
                        }
                    </span>
                </div>
            }
        }

        @if (d.Kind is ManagedDocKind.AccVipi or ManagedDocKind.AppVipi)
        {
            <div class="block" style="margin-top:8px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <b>🕓 @L["Ver_HistoryTitle"]</b>
                    <span class="muted" style="font-size:12px">@L["Ver_HistorySubtitle"]</span>
                </div>
                @if (_history.TryGetValue(key, out var hist) && hist.Count > 0)
                {
                    foreach (var e in hist)
                    {
                        var detail = HistoryDetail(e.DetailsJson);
                        <div class="ver-row">
                            <span class="vb">✎</span>
                            <div>
                                <b>@Author(e.UserId)</b>
                                <div class="vmeta">@e.TimestampUtc.ToString("dd MMM yyyy HH:mm")@(string.IsNullOrEmpty(detail) ? "" : $" · {detail}")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="help" style="margin:0">@L["Ver_NoHistory"]</p>
                }
            </div>
        }

        <div class="block" style="margin-top:8px">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                <b><Icon Name="calendar" /> @L["Rel_AiracRelease"]</b>
                <span class="muted" style="font-size:12px">@(string.Format(L["Ver_ReleaseSubtitle"].Value, _currentCycle))</span>
            </div>
            @if (_releases.TryGetValue(key, out var rels) && rels.Count > 0)
            {
                foreach (var r in rels)
                {
                    <div class="ver-row @(r.IsEffectiveNow ? "current" : "")">
                        <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
                        <div>
                            <b>@ReleaseLabel(r)</b>
                            @* «rilascio #N» = progressivo della release, non la versione del documento (vedi ReleasePanel). *@
                            <div class="vmeta" title="@L["Ver_AuthorReleaseTitle"]">@L["Rel_VersionLabel", r.VersionNumber] · @Author(r.CreatedByUserId) · @r.CreatedUtc.ToString("dd MMM yyyy HH:mm") · @L["Rel_EffectiveFrom"] @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.Note) ? "" : $" — \"{r.Note}\"")</div>
                        </div>
                        <span class="vact">
                            <a class="btn ghost" href="@PreviewLink(d, r.Id)" target="_blank" rel="noopener" title="@L["Rel_PreviewTitle"]"><Icon Name="eye" /> @L["Rel_Preview"]</a>
                            <button class="btn ghost" disabled="@_busy" @onclick="() => ToggleDiff(key, r.Id)" title="@L["Rel_DiffTitle"]"><Icon Name="search" /> @L["Rel_Diff"]</button>
                            @if (Authz.IsAdmin)
                            {
                                <button class="btn ghost" disabled="@_busy" @onclick="() => CancelRelease(key, r.Id)" title="@L["Rel_CancelTitle"]">✕ @L["Common_Cancel"]</button>
                            }
                        </span>
                    </div>
                    @if (_diffOpen.Contains(r.Id))
                    {
                        <div class="block" style="margin:2px 0 8px 24px">
                            <ReleaseDiffTable Diff="@(_diffs.TryGetValue(r.Id, out var d) ? d : null)" />
                        </div>
                    }
                }
            }
            else
            {
                <p class="help" style="margin:0 0 6px">@L["Rel_NoRelease"]</p>
            }

            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:8px">
                <select class="app-in" style="min-width:270px;max-width:340px" @onchange="e => SetCycle(key, e.Value?.ToString())">
                    @foreach (var c in _upcoming)
                    {
                        <option value="@c.Cycle" selected="@(SelectedCycle(key) == c.Cycle)">AIRAC @c.Cycle — @L["Rel_From"] @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
                    }
                </select>
                <input class="app-in" style="max-width:240px" placeholder="@L["Rel_NotePh"]" value="@NoteOf(key)" @onchange="e => SetNote(key, e.Value?.ToString())" />
                <button class="btn primary" disabled="@_busy" @onclick="() => PublishRelease(d)">@L["Ver_PublishAtCycle"]</button>
                <button class="btn ghost" disabled="@_busy" @onclick="() => PublishNow(d)" title="@L["Ver_PublishNowTitle"]">@L["Ver_PublishNowReview"]</button>
            </div>
        </div>
    };

    private async Task Publish(ManagedDoc d, int versionId)
    {
        // Pubblicazione dalla lista (senza aprire l'editor): acquisisci prima il lock — es. un documento generato
        // in automatico e mai aperto non ne ha uno. PublishAsync lo rilascia dopo. Se un altro editor lo detiene,
        // AcquireLock non lo assegna e PublishAsync solleva il conflitto (messaggio già gestito da Run).
        await Run(async () =>
        {
            if (d.DocumentId is int docId) await Editing.AcquireLockAsync(docId);
            await Editing.PublishAsync(versionId, note: null);
        }, L["Ver_VersionPublished"]);
    }

    /// <summary>
    /// Scarta la bozza: come la pubblicazione dalla lista, prende prima il lock (un documento mai aperto non
    /// ne ha uno) e il servizio lo rilascia dopo. Se lo detiene un altro editor, il conflitto arriva da lì col
    /// suo messaggio. Le condizioni — è davvero una bozza, e c'è una versione a cui tornare — le impone il
    /// servizio: qui non si duplicano, o divergerebbero al primo cambio.
    /// </summary>
    private async Task DiscardDraft(ManagedDoc d, int versionId)
    {
        await Run(async () =>
        {
            if (d.DocumentId is int docId) await Editing.AcquireLockAsync(docId);
            await Editing.DiscardDraftAsync(versionId);
        }, L["Ver_DraftDiscarded"]);
    }

    private async Task PublishRelease(ManagedDoc d)
    {
        var key = RowKey(d);
        var cycle = SelectedCycle(key) ?? _upcoming.FirstOrDefault()?.Cycle;
        if (cycle is null) return;
        _releases.Remove(key);
        await Run(() => Releases.PublishAsync(d.ReleaseTarget, d.ReleaseKey, cycle, NoteOf(key)), string.Format(L["Ver_ReleasePublishedCycle"].Value, cycle));
        await LoadDetailAsync(key);
        await LoadSummariesAsync();
    }

    private async Task PublishNow(ManagedDoc d)
    {
        var key = RowKey(d);
        _releases.Remove(key);
        await Run(() => Releases.PublishNowAsync(d.ReleaseTarget, d.ReleaseKey, NoteOf(key)), L["Rel_PublishedNow"]);
        await LoadDetailAsync(key);
        await LoadSummariesAsync();
    }

    // ---- annulla / differenze / anteprima release ----
    private readonly HashSet<int> _diffOpen = new();
    private readonly Dictionary<int, ReleaseDiff> _diffs = new();

    private async Task CancelRelease(string key, int releaseId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L["Rel_CancelConfirm"].Value))
            return;
        _releases.Remove(key);
        await Run(() => Releases.CancelReleaseAsync(releaseId), L["Rel_Canceled"]);
        await LoadDetailAsync(key);
        await LoadSummariesAsync();
    }

    private async Task ToggleDiff(string key, int releaseId)
    {
        if (!_diffOpen.Remove(releaseId))
        {
            _diffOpen.Add(releaseId);
            if (!_diffs.ContainsKey(releaseId))
            {
                try { _diffs[releaseId] = await Releases.DiffAsync(releaseId); }
                catch (EditNotAllowedException ex) { _error = ex.Message; }
            }
        }
    }

    // Anteprima release nel viewer tipizzato (?as=rel:{id}). No hop via /vsop/release: costruiamo l'URL diretto.
    private string PreviewLink(ManagedDoc d, int releaseId)
    {
        var acc = (d.AccCode ?? Acc ?? "lirr").ToLowerInvariant();
        return DocRoutes.For(d.Kind).ViewerUrl(acc, d.ReleaseKey, d.NeighbourCode, releaseId)
            ?? $"/vsop/release/{releaseId}";
    }

    private async Task ToggleHidden(ManagedDoc d)
    {
        await Run(() => DocAdmin.SetHiddenAsync(new ManagedDocRef(d.Kind, d.ReleaseKey, d.DocumentId), !d.IsHidden),
            d.IsHidden ? L["Ver_DocShown"] : L["Ver_DocHidden"]);
        await LoadAsync();
    }

    private async Task Delete(ManagedDoc d)
    {
        if (!await JS.InvokeAsync<bool>("confirm", string.Format(L["Ver_DeleteConfirm"].Value, d.Title)))
            return;
        await Run(() => DocAdmin.DeleteAsync(new ManagedDocRef(d.Kind, d.ReleaseKey, d.DocumentId)), L["Ver_DocDeleted"]);
        _expanded.Remove(RowKey(d));
        await LoadAsync();
    }

    private async Task Run(Func<Task> action, string ok)
    {
        _busy = true; _status = _error = null;
        try { await action(); _status = ok; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (EditConflictException ex) { _error = ex.Message; }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // stato per-riga (ciclo/nota release)
    private readonly Dictionary<string, string?> _selCycle = new();
    private readonly Dictionary<string, string?> _note = new();
    private string? SelectedCycle(string key) => _selCycle.TryGetValue(key, out var c) ? c : null;
    private void SetCycle(string key, string? c) => _selCycle[key] = c;
    private string? NoteOf(string key) => _note.TryGetValue(key, out var n) ? n : null;
    private void SetNote(string key, string? n) => _note[key] = n;

    // Icona per tipo documento, coerente coi bottoni di NewDocumentPage (globe/map/plane/file).
    private static string KindIcon(ManagedDocKind k) => k switch
    {
        ManagedDocKind.Vloa => "globe", ManagedDocKind.AccVipi => "map",
        ManagedDocKind.AirportVipi => "plane-takeoff", ManagedDocKind.AppVipi => "plane-landing", _ => "file",
    };
    private string KindLabel(ManagedDocKind k) => k switch
    {
        ManagedDocKind.Vloa => "vLOA", ManagedDocKind.AccVipi => L["Nd_KindAcc"],
        ManagedDocKind.AirportVipi => L["Nd_KindAirport"], ManagedDocKind.AppVipi => "vIPI APP", _ => k.ToString(),
    };
    private string StatusLabel(DocumentStatus s) => s switch
    {
        DocumentStatus.Draft => L["Ver_StBozza"], DocumentStatus.Published => L["Ver_StPubblicata"], DocumentStatus.Archived => L["Ver_StArchiviata"], _ => s.ToString(),
    };
    private string ReleaseLabel(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 " + L["Rel_Effective"] : r.Status == ReleaseStatus.Scheduled ? "🕒 " + L["Rel_Scheduled"] : L["Rel_Superseded"];

    private string EditorLink(ManagedDoc d)
    {
        var acc = (d.AccCode ?? Acc ?? "lirr").ToLowerInvariant();
        return DocRoutes.For(d.Kind).EditorUrl(acc, d.ReleaseKey, d.NeighbourCode, d.DocumentId)
            ?? "/vsop/versioni";
    }
}
