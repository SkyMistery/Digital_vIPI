@page "/services/vsop/versions"
@page "/services/vsop/{Acc}/versions"
@layout SopLayout
@rendermode InteractiveServer
@* ⚠️ OwningComponentBase per lo SCOPE: il servizio di editing (e il suo DbContext) non viene dal circuito. *@
@inherits OwningComponentBase
@using Microsoft.Extensions.DependencyInjection
@inject IReleaseService Releases
@inject IProssimoAiracService ProssimoAirac
@inject IDocumentAdminService DocAdmin
@inject IDocumentImpactService Impacts
@inject IEditAuthorizationService Authz
@inject Vipi.Application.Abstractions.IStaffRosterRepository StaffRoster
@inject Vipi.Application.Abstractions.IAuditLogReader Audit
@inject NavigationManager Nav
@inject Vipi.Application.Routing.IDocRoutesRegistry DocRoutes
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<PageTitle>@L["Nd_Drafts"] · IVAO Italy</PageTitle>

<div class="wrap struct">
    @* ---- Le pagine admin, dove stava la briciola di pane ----
       La barra è al posto della briciola perché ne faceva già il lavoro e meglio: «Home › Staff Area ›
       Structure › Airports» portava a tre posti che sono tutti qui dentro (o nel logo in topbar), diceva
       «sei in Airports» come lo dice la voce accesa, e inventava una gerarchia — Aeroporti NON sta sotto
       Struttura, sono pagine sorelle, e la barra le mostra per quello che sono. Le briciole erano anche già
       divergenti fra loro: «Admin» portava a due indirizzi diversi a seconda della pagina.
       Sopra il titolo e non sotto: il titolo deve toccare il contenuto che intitola. Da sotto, la barra si
       infilava fra l'H2 e la sua prima sezione e li staccava.
       ⚠️ Resta nuda, senza `@if` intorno: il filtro per autorizzazione lo fa il componente.
       ⚠️ Questa pagina è l'unica delle undici senza cancello: chi ha un grant su una ACC ci lavora senza
       essere admin. Per questo la barra non va chiusa in un `@if (IsAdmin)` — lo nasconderebbe a chi la
       pagina la usa — e per questo il filtro sta nel componente: là dentro Versioni è l'unica voce marcata
       `Chi.Chiunque`, e a chi vede solo quella la barra non compare. *@
    <AdminNav />

    @* ---- Testata in UNA riga: titolo (+conteggio) · ciclo · «?» · comandi di PAGINA · esito ----
       Come Struttura, ACC, Accordi, Aeroporti e Confinanti (.st-head). Il sottotitolo diceva SEMPRE a schermo
       ciò che il «?» dice al clic: stesso testo, stessa chiave (Ver_Subtitle), cambia solo dove si legge. *@
    @if (!Authz.IsEditor)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Common_AccessReserved"]</p>@L["Pend_AdminOnly"]</div></div>
    }

    <div class="doc-head st-head">
        @* ⚠️ Lo spazio fra un'espressione e un `@if` Razor lo mangia il compilatore: serve un carattere vero. *@
        <h1 class="st-h2 page-h1">@L["Nd_Drafts"]&nbsp;<span class="pill blue" title="@L["Ver_CountTitle"]">@CountLabel()</span></h1>
        @* Il ciclo corrente stava dentro la fascia di riepilogo, ed è l'unica cosa di quella fascia che non
           fosse un doppione dei chip dei filtri: sale qui, dove costa una pill. *@
        <span class="pill grey" title="@L["Ver_CycleTitle"]">AIRAC @_currentCycle</span>
        <HelpHint Href="/services/vsop/guide#versioni" AriaLabel="@L["Ver_HelpAria"]" ExtraClass="wide">
            <p style="margin:0 0 6px">@(string.Format(L["Ver_Subtitle"].Value, _currentCycle))</p>
            @((MarkupString)L["Ver_Intro"].Value)
        </HelpHint>
        <nav class="struct-nav">
            @* «Espandi tutti» è sparito col dettaglio dentro l'elenco: apriva N righe, cioè N×3 chiamate
               (versioni, release e storia per ognuna), per una pagina che poi non finiva più. Col pannello a
               fianco si guarda un documento alla volta, che è come si lavora. *@
            @* L'elenco è una fotografia: i lock si prendono e si lasciano mentre la pagina sta aperta. Un tasto,
               non un poll: il dato cambia poche volte al giorno e il giro costa una query su tutti i documenti. *@
            <button type="button" class="btn ghost" disabled="@_busy" title="@L["Ver_RefreshTitle"]" @onclick="ReloadAsync">↻ @L["Ver_Refresh"]</button>
            <a class="btn primary" href="/services/vsop/editor/new-document"><Icon Name="plus" /> @L["Nd_Title"]</a>
        </nav>
        @* L'esito è un chip in testata, fra i comandi che l'hanno provocato e il contenuto: da fascia sopra
           l'elenco spingeva in giù proprio le righe su cui si stava lavorando (regola 5).
           ⚠️ Il titolo non e' sempre «Operazione non consentita»: un documento occupato non e' un permesso
           negato, ed e' un'altra reazione (aspetto un minuto, non chiedo un grant). *@
        <LiveRegion>
            @if (_error is not null || _status is not null)
            {
                <span class="st-msg @(_error is not null ? "warn" : "ok")">
                    <Icon Name="@(_error is not null ? "warning" : "check-circle")" Size="14" />
                    <span class="st-msg-t">
                        @if (_error is not null)
                        {
                            <b>@(_errorTitle ?? L["Ver_NotAllowed"].Value)</b>
                            <text> </text>@_error
                        }
                        else
                        {
                            @_status
                        }
                    </span>
                    <button class="tclose" title="@L["Common_Close"]" @onclick="ClearStatus">✕</button>
                </span>
            }
        </LiveRegion>
    </div>

    @* ---- «Prossimo AIRAC»: che cosa manca al ciclo entrante, e il gesto per metterlo a posto in blocco ----
       Carta docs/feature/2026-09-02-il-ciclo-entrante.md §AW3.
       ⚠️ NON e' una lista nuova: le righe di lavoro le porta gia' «Da fare» (ImpactKind.ReleaseDriftNextCycle),
       e la §1 del FEATURE-PROCESS dice di estendere e mai affiancare. Qui c'e' il quadro d'insieme.
       ⚠️ Chiuso di suo: e' una cosa che si guarda una volta a ciclo, e aperto spingerebbe l'elenco -- che e'
       il motivo per cui si apre questa pagina -- sotto la piega ogni giorno dell'anno (regola 5). *@
    @if (Authz.IsEditor && _airac is { } q)
    {
        @* ⚠️ Stile in riga e nessuna classe nuova: un foglio toccato vuol dire impronta nuova e quindi un
           pacchetto che porta il CSS. Qui bastano quattro proprieta' di disposizione. *@
        <details class="block">
            <summary style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;cursor:pointer">
                <b><Icon Name="calendar" /> @L["Airac_NextTitle"]</b>
                <span class="pill grey">AIRAC @q.CicloEntrante</span>
                <span class="muted">@(string.Format(L["Airac_NextFrom"].Value, q.EfficaceUtc.ToString("dd MMM yyyy")))</span>
                <span class="pill @(q.GiorniAllEntrata <= 3 ? "amber" : "")">
                    @(q.GiorniAllEntrata == 0 ? L["Airac_NextToday"].Value : string.Format(L["Airac_NextInDays"].Value, q.GiorniAllEntrata))
                </span>
                @if (q.DaProgrammare > 0)
                {
                    <span class="pill blue">@(string.Format(L["Airac_NextMissing"].Value, q.DaProgrammare))</span>
                }
            </summary>

            <p class="help" style="margin:6px 0">@((MarkupString)L["Airac_NextHelp"].Value)</p>

            @if (q.DaProgrammare == 0)
            {
                <p class="help" style="margin:0"><Icon Name="check-circle" Size="14" /> @L["Airac_NextAllDone"]</p>
            }
            else
            {
                <p style="margin:0 0 6px">
                    @(string.Format(L["Airac_NextCounts"].Value, q.Programmati, q.DaProgrammare))
                </p>
                <ul style="margin:0 0 6px 18px;padding:0">
                    @foreach (var d in q.Documenti.Where(x => !x.GiaProgrammato).Take(MaxDaMostrare))
                    {
                        <li>@d.Titolo @if (d.AccCode is { Length: > 0 } a) { <span class="muted">— @a</span> }</li>
                    }
                </ul>
                @if (q.DaProgrammare > MaxDaMostrare)
                {
                    <p class="muted" style="margin:0 0 6px">@(string.Format(L["Airac_NextAndMore"].Value, q.DaProgrammare - MaxDaMostrare))</p>
                }
                <button class="btn primary" disabled="@_busy" @onclick="ProgrammaMancantiAsync"
                        title="@L["Airac_NextScheduleAllTitle"]">
                    <Icon Name="calendar" /> @(string.Format(L["Airac_NextScheduleAll"].Value, q.CicloEntrante))
                </button>
            }

            @if (_airacSaltati.Count > 0)
            {
                <div class="callout warning" style="margin:8px 0 0">
                    <span class="cic"><Icon Name="warning" Size="18" /></span>
                    <div>
                        <p class="ct">@(string.Format(L["Airac_NextSkipped"].Value, _airacSaltati.Count))</p>
                        <ul style="margin:4px 0 0 18px;padding:0">
                            @foreach (var (titolo, motivo) in _airacSaltati)
                            {
                                <li><b>@titolo</b> — @motivo</li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </details>
    }

    @if (_docs is null)
    {
        <LoadingState />
    }
    else
    {
        @* ---- barra: ricerca · chip che CONTANO · tipo e ACC nei menu · ✕ ----
           Il riepilogo di campagna («3 in vigore · 2 programmate · 1 senza release») era una fascia sopra
           l'elenco che diceva gli stessi numeri che i chip dei filtri avrebbero dovuto portare: un fatto in
           due posti (regola 103). Restano i chip, coi numeri dentro. Il ciclo corrente — l'unica cosa della
           fascia che non fosse un doppione — è salito accanto al titolo.
           I chip stanno in GRUPPO, così la barra va a capo in un punto solo, e ci sono sempre — spenti a
           zero, perché un chip che compare col contatore accorcia la riga sotto il puntatore (regole 31-32).
           Tipo e ACC sono menu e non chip: sono quattro tipi più una ACC per divisione, e come chip da soli
           chiedevano più larghezza di tutto il resto della barra. *@
        var n = Counts();
        @* ---- Due pannelli alti quanto lo schermo meno ciò che sta sopra (vipiFitViewport a ogni render) ----
           A sinistra l'elenco, a destra il documento scelto. Il dettaglio era una fascia DENTRO l'elenco:
           aprendolo, la riga sotto — quella che si stava per guardare — saltava in giù di tutto il blocco
           (versioni + storia + release + barra di pubblicazione). Qui l'elenco non si muove. *@
        <div class="ver-layout">
            @* --- SINISTRA: l'elenco dei documenti --- *@
            <div class="panel st-pane">
                <div class="struct-bar">
                    <input class="htree-search" value="@_q" @oninput="e => SetQuery(e.Value?.ToString())" placeholder="@L["Ver_SearchPh"]" />
                    <select class="htree-select" aria-label="@L["Ver_KindLabel"]" title="@L["Ver_KindLabel"]"
                            @onchange="e => SetKind(ParseKind(e.Value?.ToString()))">
                        @foreach (var (k, lab) in KindFilters)
                        {
                            <option value="@(k?.ToString() ?? "")" selected="@(_kindFilter == k)">@lab</option>
                        }
                    </select>
                    @* Il menu ACC compare solo se c'è più di una ACC da distinguere: con la rotta /services/vsop/{acc}/versions
                       l'elenco è già ristretto, e un filtro con una scelta sola è arredamento. *@
                    @if (AccFilters.Count > 1)
                    {
                        <select class="htree-select" aria-label="@L["Ver_AccLabel"]" title="@L["Ver_AccLabel"]"
                                @onchange="e => SetAcc(Blank(e.Value?.ToString()))">
                            <option value="" selected="@(_accFilter is null)">@L["Ver_FilterAll_F"]</option>
                            @foreach (var acc in AccFilters)
                            {
                                <option value="@acc" selected="@(_accFilter == acc)">@acc</option>
                            }
                        </select>
                    }
                    <span class="sb-chips">
                        <button class="sh-chip @(_statusFilter == "public" ? "on" : "")" disabled="@(n.Public == 0)"
                                title="@L["Ver_PublicChipTitle"]" @onclick='() => ToggleStatus("public")'>@L["Ver_FilterPublic"] <span class="chip-n">@n.Public</span></button>
                        <button class="sh-chip @(_statusFilter == "draft" ? "on" : "")" disabled="@(n.Draft == 0)"
                                title="@L["Ver_DraftChipTitle"]" @onclick='() => ToggleStatus("draft")'>@L["Ver_FilterDraft"] <span class="chip-n">@n.Draft</span></button>
                        <button class="sh-chip @(_statusFilter == "hidden" ? "on" : "")" disabled="@(n.Hidden == 0)"
                                title="@L["Ver_HiddenChipTitle"]" @onclick='() => ToggleStatus("hidden")'>@L["Ver_FilterHidden"] <span class="chip-n">@n.Hidden</span></button>
                        <button class="sh-chip @(_statusFilter == "editing" ? "on" : "")" disabled="@(n.Editing == 0)"
                                title="@L["Ver_EditingTitle"]" @onclick='() => ToggleStatus("editing")'>@L["Ver_FilterEditing"] <span class="chip-n">@n.Editing</span></button>
                        <span class="sb-sep"></span>
                        <button class="sh-chip @(_releaseFilter == "effective" ? "on" : "")" disabled="@(n.Effective == 0)"
                                title="@L["Ver_EffectiveTitle"]" @onclick='() => ToggleRelease("effective")'>@L["Rel_Effective"] <span class="chip-n">@n.Effective</span></button>
                        <button class="sh-chip @(_releaseFilter == "scheduled" ? "on" : "")" disabled="@(n.Scheduled == 0)"
                                title="@L["Ver_ScheduledTitle"]" @onclick='() => ToggleRelease("scheduled")'>@L["Ver_FilterScheduled"] <span class="chip-n">@n.Scheduled</span></button>
                        @* Il chip di LAVORO: i documenti senza release sono la coda da smaltire — in giallo quando
                           ce n'è, spento a zero. *@
                        <button class="sh-chip @(n.NoRelease > 0 ? "warn" : "") @(_releaseFilter == "none" ? "on" : "")" disabled="@(n.NoRelease == 0)"
                                title="@L["Ver_NoReleaseTitle"]" @onclick='() => ToggleRelease("none")'>@L["Ver_FilterNoRelease"] <span class="chip-n">@n.NoRelease</span></button>
                        @* Il ✕ sta DENTRO il gruppo, non dopo: da solo in fondo è lui ad andare a capo per primo e la
                           barra diventa di tre righe invece di due. C'è sempre, spento quando non c'è niente da
                           azzerare; solo il glifo, il nome nel title e in aria-label. *@
                        <button class="lnk-mini" disabled="@(!IsFiltering)" @onclick="ClearFilters"
                                title="@L["Ver_ClearTitle"]" aria-label="@L["Ver_Clear"]">✕</button>
                    </span>
                </div>

                @if (Filtered().Any())
                {
                    <div class="st-scroll">
                        @foreach (var d in Filtered())
                        {
                            var key = RowKey(d);
                            @* La riga INTERA è il comando di selezione: cliccata sceglie, ricliccata lascia,
                               un'altra sposta la scelta; Invio e Spazio fanno quello che fa il clic. Non porta
                               più tasti: le azioni stanno nel pannello, dove la conferma in linea ha posto e
                               non fa andare a capo il titolo (era la riga alta 118px). *@
                            <div class="doc-rowi acc-pick @(_selKey == key ? "picked" : "") @(d.IsHidden ? "row-off" : "")"
                                 role="button" tabindex="0" aria-pressed="@(_selKey == key ? "true" : "false")"
                                 title="@L["Ver_RowPickTitle"]" @onclick="() => Pick(key)" @onkeydown="e => OnRowKey(e, key)">
                                <span class="di"><Icon Name="@KindIcon(d.Kind)" Size="18" /></span>
                                <div class="dr-main">
                                    <b>@d.Title</b>
                                    <div class="dr-sub">@KindLabel(d.Kind)@(string.IsNullOrWhiteSpace(d.Scope) ? "" : $" · {d.Scope}")</div>
                                </div>
                                @if (d.IsHidden) { <span class="pill grey">@L["Ver_Hidden"]</span> }
                                else if (d.HasDraft) { <span class="pill grey">@L["Ver_DraftOpen"]</span> }
                                else { <span class="pill green">@L["Ver_Public"]</span> }
                                @if (d.EffectiveCycle is { } eff)
                                {
                                    <span class="pill green" title="@L["Ver_EffectiveNowTitle"]">🟢 AIRAC @eff</span>
                                }
                                @if (d.NextScheduledCycle is { } next)
                                {
                                    <span class="pill blue" title="@L["Ver_ScheduledFutureTitle"]">🕒 @next</span>
                                }
                                @if (!d.HasAnyRelease)
                                {
                                    <span class="pill grey" title="@L["Ver_NoReleaseTitle"]">⚠️ @L["Ver_NoReleaseBadge"]</span>
                                }
                                @* La casella degli impatti, riassunta in una pill. L'ordine delle tre non è
                                   alfabetico: dice quel che è più urgente. «Già in pubblico» batte tutto — il
                                   cambio è sotto gli occhi dei lettori senza che nessuno l'abbia approvato. *@
                                @if (Badge(d) is { } b)
                                {
                                    @if (b.GiaInPubblico > 0)
                                    {
                                        <span class="pill red" title="@L["Impact_PublicNowTitle"]">@L["Impact_PublicNow"] (@b.GiaInPubblico)</span>
                                    }
                                    else if (b.Rotti > 0)
                                    {
                                        <span class="pill amber">@L["Impact_Broken"] (@b.Rotti)</span>
                                    }
                                    else if (b.DaRipubblicare > 0)
                                    {
                                        <span class="pill blue" title="@L["Impact_RepublishTitle"]">@L["Impact_Republish"] (@b.DaRipubblicare)</span>
                                    }
                                    else
                                    {
                                        <span class="pill amber">@L["Impact_ToReview"] (@b.Total)</span>
                                    }
                                }
                                @* Chi sta lavorando a cosa. Il nome e l'ORA sono entrambi necessari: il lock del
                                   documento dura 30 minuti e non ha battito, quindi «bloccato» senza scadenza non
                                   direbbe se aspettare o no. *@
                                @if (d.IsLocked)
                                {
                                    <span class="pill @(IsMyLock(d) ? "green" : "amber")" data-utc-title="@VipiTime.Iso(d.LockExpiresUtc)" title="@LockTitle(d)">🔒 @LockBadge(d)</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="help">@L["Ver_NoDocMatch"] <a role="button" class="lnk-inline" @onclick="ClearFilters">@L["Ver_Clear"]</a>.</p>
                }
            </div>

            @* --- DESTRA: il documento scelto --- *@
            <div class="panel st-pane">
                @if (Selected is { } sel)
                {
                    <div class="ver-detail-head">
                        <div class="dr-main">
                            <b>@sel.Title</b>
                            <div class="dr-sub">@KindLabel(sel.Kind)@(string.IsNullOrWhiteSpace(sel.Scope) ? "" : $" · {sel.Scope}")</div>
                        </div>
                        @if (sel.IsLocked)
                        {
                            <span class="pill @(IsMyLock(sel) ? "green" : "amber")" data-utc-title="@VipiTime.Iso(sel.LockExpiresUtc)" title="@LockTitle(sel)">🔒 @LockBadge(sel)</span>
                        }
                    </div>
                    @* Le azioni del documento: erano dentro la riga d'elenco, e con loro la conferma in linea
                       da ~500px che comprimeva il titolo fino a mandarlo a capo una parola per riga. Qui hanno
                       una riga propria e vanno a capo insieme. *@
                    <div class="ver-acts">
                        <a class="btn ghost" href="@EditorLink(sel)">@L["Nd_OpenEditor"]</a>
                        @if (CanManage(sel))
                        {
                            @if (sel.IsHidden)
                            {
                                @* Rimettere a vista non distrugge niente: resta immediato. *@
                                <button class="btn ghost" disabled="@ActionsBlocked(sel)" title="@BlockedTitle(sel, L["Ver_ShowPublicTitle"].Value)"
                                        @onclick="() => ToggleHidden(sel)"><Icon Name="eye" /> @L["AccAdmin_Show"]</button>
                            }
                            else
                            {
                                <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@BlockedTitle(sel, L["Ver_HidePublicTitle"].Value)" AriaLabel="@L["Ver_HideDocAria"]"
                                               Prompt="@L["Ver_HidePrompt", sel.Title]" ConfirmLabel="@L["Ver_HideConfirmYes"]" CancelLabel="@L["Common_Cancel"]"
                                               Danger="false" Disabled="@ActionsBlocked(sel)" CanOpenAsync="() => RefreshLockAsync(sel)" OnConfirm="() => ToggleHidden(sel)">
                                    <Trigger><Icon Name="eye-off" /> @L["AccAdmin_Hide"]</Trigger>
                                </InlineConfirm>
                            }
                            @* Il testo che spiega la conseguenza sta QUI, non in un confirm del browser: il nativo bloccava
                               il circuito (e la verifica live) e faceva la seconda domanda dopo questa. *@
                            @* La finestra dice cosa si perde — le pubblicazioni, e chi resta senza pagina —
                               prima di chiedere. Il documento non ha protezioni che lo blocchino: è nostro,
                               nessuna sorgente lo rivendica. Il lock di editing resta il solo ostacolo, e lo
                               si rilegge al clic invece di scoprirlo dopo la conferma. *@
                            @if (sel.DocumentId is int docId)
                            {
                                <DeleteDialog Target="DeletionTarget.Document(docId)" Nome="@sel.Title"
                                              TriggerClass="btn ghost" TriggerTitle="@BlockedTitle(sel, L["Ver_DeletePermTitle"].Value)"
                                              AriaLabel="@L["Ver_DeleteDocAria"]" Disabled="@ActionsBlocked(sel)"
                                              CanOpenAsync="() => RefreshLockAsync(sel)" OnDeleted="DopoEliminazione">
                                    <Trigger><Icon Name="trash" /> @L["Common_Delete"]</Trigger>
                                </DeleteDialog>
                            }
                            else
                            {
                                <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@BlockedTitle(sel, L["Ver_DeletePermTitle"].Value)" AriaLabel="@L["Ver_DeleteDocAria"]"
                                               Prompt="@L["Ver_DeleteConfirm", sel.Title]" Disabled="@ActionsBlocked(sel)"
                                               CanOpenAsync="() => RefreshLockAsync(sel)" OnConfirm="() => Delete(sel)">
                                    <Trigger><Icon Name="trash" /> @L["Common_Delete"]</Trigger>
                                </InlineConfirm>
                            }
                        }
                        @if (sel.IsLocked && !IsMyLock(sel) && Authz.IsEditor)
                        {
                            <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Lock_ForceTitle"]" AriaLabel="@L["Lock_ForceUnlock"]"
                                           Prompt="@L["Ver_ForceUnlockPrompt", sel.LockedByName ?? L["Lock_AnotherEditor"].Value]"
                                           ConfirmLabel="@L["Lock_ForceUnlock"]" CancelLabel="@L["Common_Cancel"]" Disabled="@_busy"
                                           OnConfirm="() => ForceUnlock(sel)">
                                <Trigger>🔓 @L["Lock_ForceUnlock"]</Trigger>
                            </InlineConfirm>
                        }
                    </div>
                    @* Dentro il pannello scorre SOLO il corpo: testata e azioni restano ferme. *@
                    <div class="st-scroll">
                        @DetailBlock(sel)
                    </div>
                }
                else
                {
                    <p class="help">@L["Ver_PickHint"]</p>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Acc { get; set; }

    private IReadOnlyList<ManagedDoc>? _docs;
    private IReadOnlyDictionary<int, ImpactBadge> _impatti = new Dictionary<int, ImpactBadge>();
    // La riga scelta (chiave RowKey), e le chiavi il cui dettaglio si sta caricando.
    private string? _selKey;
    private readonly HashSet<string> _loadingKeys = new();
    private readonly Dictionary<string, IReadOnlyList<VersionInfo>> _versions = new();
    private readonly Dictionary<string, IReadOnlyList<ReleaseInfo>> _releases = new();
    private readonly Dictionary<int, string> _authorNames = new();
    private readonly Dictionary<string, IReadOnlyList<Vipi.Application.Abstractions.AuditEntry>> _history = new();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";

    /// <summary>Il quadro del ciclo entrante (§AW3). null = non ancora letto, o lettura fallita: la sezione
    /// semplicemente non compare — è un di più, e non deve poter rompere la pagina che la ospita.</summary>
    private QuadroCicloEntrante? _airac;

    /// <summary>Chi il giro in blocco non è riuscito a programmare, e perché. ⚠️ Sta a schermo finché non si
    /// ricarica: un giro riuscito a metà in silenzio è peggio di uno fallito, perché chi l'ha premuto crede
    /// di aver finito.</summary>
    private List<(string Titolo, string Motivo)> _airacSaltati = new();

    /// <summary>Quanti documenti mancanti si elencano prima di dire «e altri N». Dieci: è un promemoria di
    /// che cosa manca, non l'elenco — quello è il pannello sotto, con i suoi filtri.</summary>
    private const int MaxDaMostrare = 10;

    private bool _busy;
    private string? _status, _error, _errorTitle;

    // filtri
    private string _q = "";
    private ReleaseTargetType? _kindFilter;      // null = tutti
    private string _statusFilter = "all";     // all|public|draft|hidden|editing
    private string _releaseFilter = "all";    // all|effective|scheduled|none
    private string? _accFilter;               // null = tutte

    /// <summary>
    /// Le voci del menu «Tipo». ⚠️ L'etichetta di ogni tipo è quella di <see cref="KindLabel"/>: due elenchi
    /// che nominano le stesse cose in due modi diversi si scostano al primo che si tocca, e il filtro
    /// direbbe una parola mentre la riga ne mostra un'altra.
    ///
    /// <para>⚠️ <b>`AirportMil` mancava</b> (trovato a schermo il 29 agosto 2026): l'icona e l'etichetta
    /// della riga erano già state sistemate, il filtro no — quindi i vSOP militari si vedevano nell'elenco
    /// ma non si potevano isolare, ed erano l'unica famiglia con documenti veri a non avere la sua voce.</para>
    ///
    /// <para>⚠️ <b>`AppMil` NON c'è, ed è la cosa giusta</b>: quel documento non esiste — nessuna porta lo
    /// crea e le sue rotte tornano `null` (carta vSOP militari §1c). Una voce di filtro che non può che dare
    /// zero righe è una promessa falsa, la stessa che quelle rotte hanno già pagato una volta. Va aggiunta
    /// <b>insieme</b> alle sue pagine.</para>
    /// </summary>
    private (ReleaseTargetType?, string)[] KindFilters =>
    new (ReleaseTargetType?, string)[]
    {
        (null, L["Ver_FilterAll_M"]), (ReleaseTargetType.Vloa, "vLOA"), (ReleaseTargetType.AccVipi, "ACC"),
        (ReleaseTargetType.Airport, L["Nd_Airport"]), (ReleaseTargetType.App, "APP"),
        (ReleaseTargetType.AirportMil, KindLabel(ReleaseTargetType.AirportMil)),
    };
    // I valori ammessi nell'URL. Le ETICHETTE non stanno più qui: i chip le portano una per una, coi loro
    // titoli, e un elenco di coppie serviva solo a generare i chip «tutti» che il ✕ ha sostituito.
    private static readonly string[] StatusValues = { "public", "draft", "hidden", "editing" };
    private static readonly string[] ReleaseValues = { "effective", "scheduled", "none" };

    /// <summary>
    /// L'altezza dei due pannelli e' «schermo meno cio' che sta sopra»: non e' esprimibile in CSS e si
    /// MISURA, a ogni render — sopra ci sono cose che compaiono e spariscono da sole (il chip d'esito, il
    /// «?» aperto, la barra che va a capo a schermo stretto). Sotto i 900 il JS toglie l'altezza da se'.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("vipiFitViewport", ".ver-layout", 900); } catch (Exception) { }
    }

    /// <summary>
    /// Risolto dallo scope PROPRIO della pagina (<c>OwningComponentBase</c>): contesto isolato da quello del
    /// circuito, che la sessione condivide con barra, isole e pannelli. Due operazioni sovrapposte sullo
    /// stesso contesto danno «<c>A second operation was started on this context</c>» e uccidono il circuito.
    /// </summary>
    private IEditingService Editing = default!;

    protected override async Task OnInitializedAsync()
    {
        Editing = ScopedServices.GetRequiredService<IEditingService>();

        // ⚠️ Fino al 29 agosto 2026 questa pagina non aveva un cancello, ed era una scelta: l'elenco si
        // leggeva e i tasti li abilitava la concessione. Con le concessioni morte quella scelta non ha più
        // un meccanismo dietro — e l'elenco porta bozze e documenti nascosti, che non sono roba pubblica.
        if (!Authz.IsEditor) return;

        _currentCycle = Releases.CurrentCycle();
        _upcoming = Releases.UpcomingCycles(14);
        ReadFiltersFromUrl();
        await LoadAsync();
        await LeggiCicloEntranteAsync();
    }

    /// <summary>Ricarica l'elenco: i lock nascono e muoiono mentre la pagina sta aperta, e con essi i cicli release.</summary>
    private async Task ReloadAsync()
    {
        _busy = true; _status = _error = _errorTitle = null;
        try { await LoadAsync(); await LeggiCicloEntranteAsync(); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Il quadro del ciclo entrante. ⚠️ Un guasto qui <b>non</b> deve portarsi via la pagina: la sezione è un
    /// di più sopra l'elenco, e l'elenco è il motivo per cui questa pagina si apre.
    /// </summary>
    private async Task LeggiCicloEntranteAsync()
    {
        try { _airac = await ProssimoAirac.LeggiAsync(); }
        catch { _airac = null; }
    }

    /// <summary>
    /// Programma in blocco le release mancanti al ciclo entrante. ⚠️ Dopo, si <b>rilegge</b>: la sezione dice
    /// quanti mancano, e lasciarla ferma sui numeri di prima le farebbe dire il falso proprio nell'istante in
    /// cui si è appena agito.
    /// </summary>
    private async Task ProgrammaMancantiAsync()
    {
        _busy = true; _status = _error = _errorTitle = null; _airacSaltati = new();
        try
        {
            // ⚠️ Nota NULL, e non una frase nostra: la nota di una release è testo che finisce in archivio e
            // si rilegge in timeline. Scritta qui, sarebbe nella lingua di chi ha premuto il tasto e ci
            // resterebbe per sempre — è la regola già pagata dagli impatti (le frasi restano chiave+argomenti).
            var esito = await ProssimoAirac.ProgrammaMancantiAsync();
            _airacSaltati = esito.Saltati.ToList();
            _status = string.Format(L["Airac_NextDone"].Value, esito.Programmati, _airac?.CicloEntrante ?? "");
            await LoadAsync();
            await LeggiCicloEntranteAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        try
        {
            _docs = await DocAdmin.ListAsync();
            // Pre-filtro per ACC dal route /services/vsop/{acc}/versioni.
            if (!string.IsNullOrWhiteSpace(Acc))
            {
                var acc = Acc.Trim().ToUpperInvariant();
                _docs = _docs.Where(d => string.Equals(d.AccCode, acc, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            // Le segnalazioni aperte, in UNA query per tutto l'elenco: una per riga sarebbe una query per
            // documento a ogni caricamento della pagina.
            _impatti = await Impacts.CountOpenAsync(_docs.Where(x => x.DocumentId is not null)
                .Select(x => x.DocumentId!.Value).ToList());
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    /// <summary>Il riassunto delle segnalazioni aperte del documento, se ne ha.</summary>
    private ImpactBadge? Badge(ManagedDoc d) =>
        d.DocumentId is int id && _impatti.TryGetValue(id, out var b) ? b : null;

    // Lo stato release arriva già con l'elenco (ManagedDoc.EffectiveCycle/NextScheduledCycle): fino al 21 agosto
    // 2026 questa pagina rifaceva la stessa SummariesAsync che il repository aveva appena eseguito.

    /// <summary>
    /// Può nascondere/eliminare questa riga.
    ///
    /// <para>⚠️ Qui c'era una domanda per ACC, risolta a ogni caricamento: quali ACC può gestire questa
    /// persona. Dal 28 agosto 2026 non è più una domanda — l'Editor edita tutto — e il documento non entra
    /// più nella risposta.</para>
    /// </summary>
    private bool CanManage(ManagedDoc d) => Authz.IsEditor;

    // ---- lock: chi ci sta lavorando ----
    private bool IsMyLock(ManagedDoc d) => d.LockedByUserId is { } uid && uid == Authz.CurrentUserId;

    /// <summary>
    /// Etichetta corta del badge: «chi · ora». La forma distesa («In modifica da X fino alle …») sta nel
    /// tooltip, non nella pill: guidando la pagina, «🔒 Stai modificando · lock fino alle 00:48» era largo
    /// abbastanza da mandare a capo la colonna dei tasti, e una riga documento alta il doppio si vede.
    /// </summary>
    private string LockBadge(ManagedDoc d)
    {
        var chi = IsMyLock(d) ? L["Ver_LockMineShort"].Value : d.LockedByName ?? L["Lock_AnotherEditor"].Value;
        return d.LockExpiresUtc is { } e ? $"{chi} · {VipiTime.Z(e)}" : chi;
    }

    private string LockTitle(ManagedDoc d) => IsMyLock(d)
        ? L["Lock_Editing"].Value
        : $"{L["Lock_LockedByPrefix"].Value} {d.LockedByName ?? L["Lock_AnotherEditor"].Value}"
          + (d.LockExpiresUtc is { } e ? L["Lock_LockedUntilSuffix", VipiTime.Z(e)].Value : "");

    /// <summary>Azione di scrittura sconsigliata: lock di un ALTRO. Il divieto vero sta nel servizio (il tasto
    /// spento è cortesia, non guardia: l'elenco è una fotografia e una scheda vecchia lo aggirerebbe).</summary>
    private bool ActionsBlocked(ManagedDoc d) => _busy || (d.IsLocked && !IsMyLock(d));

    private string BlockedTitle(ManagedDoc d, string titoloNormale) =>
        d.IsLocked && !IsMyLock(d) ? L["Ver_LockedActionsTitle", LockTitle(d)].Value : titoloNormale;

    /// <summary>
    /// Rilegge il lock di <b>un solo</b> documento subito prima di un'azione delicata, e aggiorna la sua riga.
    /// Ritorna false se risulta occupato da un altro (l'azione non si avvia).
    ///
    /// <para><b>Perché una query per id e non un ricarico.</b> L'elenco è una fotografia: un lock preso dopo
    /// il caricamento non si vede, e il tasto resta acceso finché il servizio non rifiuta. Rileggere tutta la
    /// lista a ogni clic — o a intervalli — costa una query su tutti i documenti per un dato che cambia poche
    /// volte al giorno; rileggere <i>quello che si sta per toccare</i>, nel momento in cui lo si tocca, costa
    /// una riga.</para>
    ///
    /// <para>Questo <b>non</b> sostituisce la guardia: quella vive in <c>DocumentAdminService</c>, perché fra
    /// questa lettura e la scrittura passa comunque un istante, e perché una scheda vecchia non passa di qui.
    /// Serve a non fare una domanda («eliminare definitivamente?») la cui risposta verrà comunque rifiutata.</para>
    /// </summary>
    private async Task<bool> RefreshLockAsync(ManagedDoc d)
    {
        if (d.DocumentId is not int id) return true;

        LockInfo lk;
        // Se non posso nemmeno ispezionare, non decido qui: lascio parlare il servizio, che dà il messaggio giusto.
        try { lk = await Editing.InspectLockAsync(id); }
        catch (EditNotAllowedException) { return true; }

        var fresco = lk.Locked
            ? d with { LockedByUserId = lk.ByUserId, LockedByName = lk.ByName, LockExpiresUtc = lk.ExpiresUtc }
            : d with { LockedByUserId = null, LockedByName = null, LockExpiresUtc = null };
        if (_docs is not null)
            _docs = _docs.Select(x => ReferenceEquals(x, d) ? fresco : x).ToList();

        if (lk.Locked && !lk.IsMine)
        {
            _status = null;
            _errorTitle = L["Ver_LockedTitle"];
            _error = L["Ver_LockedNowMsg", d.Title, lk.ByName ?? L["Lock_AnotherEditor"].Value].Value;
            StateHasChanged();
            return false;
        }
        StateHasChanged();
        return true;
    }

    private async Task ForceUnlock(ManagedDoc d)
    {
        if (d.DocumentId is not int id) return;
        await Run(() => Editing.ForceUnlockAsync(id), L["Ver_Unlocked"]);
        await LoadAsync();
    }

    /// <summary>
    /// I sette numeri dei chip, contati in un giro solo sull'elenco che la pagina ha già in mano: nessuna
    /// query nuova, e i conteggi che la fascia di riepilogo mostrava sono gli stessi che i chip portano
    /// adesso — un fatto, un posto.
    /// </summary>
    private (int Public, int Draft, int Hidden, int Editing, int Effective, int Scheduled, int NoRelease) Counts()
    {
        var (pub, dr, hid, ed, eff, sch, nor) = (0, 0, 0, 0, 0, 0, 0);
        foreach (var d in _docs ?? Array.Empty<ManagedDoc>())
        {
            // ⚠️ Ogni numero conta ESATTAMENTE ciò che il suo chip mostra una volta cliccato (stessa
            // condizione di Filtered): un documento nascosto con una bozza aperta sta in due chip, e va
            // bene — un chip che dice 3 e ne mostra 2 è un numero che mente.
            if (!d.IsHidden && !d.HasDraft) pub++;
            if (d.HasDraft) dr++;
            if (d.IsHidden) hid++;
            if (d.IsLocked) ed++;
            if (d.EffectiveCycle is not null) eff++;
            if (d.NextScheduledCycle is not null) sch++;
            if (!d.HasAnyRelease) nor++;
        }
        return (pub, dr, hid, ed, eff, sch, nor);
    }

    /// <summary>Le ACC presenti nell'elenco, per i chip del filtro. Ordinate: sono etichette, non dati.</summary>
    private IReadOnlyList<string> AccFilters => _docs is null
        ? Array.Empty<string>()
        : _docs.Select(d => d.AccCode).Where(a => !string.IsNullOrWhiteSpace(a)).Select(a => a!)
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(a => a, StringComparer.OrdinalIgnoreCase).ToList();

    private bool IsFiltering => !string.IsNullOrWhiteSpace(_q) || _kindFilter is not null
        || _statusFilter != "all" || _releaseFilter != "all" || _accFilter is not null;

    // Contatore onesto accanto al titolo: «N/TOT» solo quando un filtro è attivo, il totale secco quando non
    // lo è (regola 30). Era una riga di prosa sotto la barra dei filtri.
    private string CountLabel() => _docs is null ? "" : IsFiltering ? $"{Filtered().Count()}/{_docs.Count}" : _docs.Count.ToString();

    private void ClearStatus() { _status = _error = _errorTitle = null; }

    private IEnumerable<ManagedDoc> Filtered()
    {
        if (_docs is null) return Array.Empty<ManagedDoc>();
        var q = _q.Trim();
        return _docs.Where(d =>
            (_kindFilter is null || d.Kind == _kindFilter)
            && (_accFilter is null || string.Equals(d.AccCode, _accFilter, StringComparison.OrdinalIgnoreCase))
            && (_statusFilter switch
            {
                "public" => !d.IsHidden && !d.HasDraft,
                "draft" => d.HasDraft,
                "hidden" => d.IsHidden,
                "editing" => d.IsLocked,
                _ => true,
            })
            && (_releaseFilter switch
            {
                "effective" => d.EffectiveCycle is not null,
                "scheduled" => d.NextScheduledCycle is not null,
                "none" => !d.HasAnyRelease,
                _ => true,
            })
            && (q.Length == 0
                || d.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                || d.Scope.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (d.AccCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)));
    }

    private static string RowKey(ManagedDoc d) => $"{d.Kind}:{d.ReleaseKey}:{d.DocumentId}";

    /// <summary>
    /// Il documento scelto — stato di PAGINA, non un filtro: non si scrive nella casella di ricerca e non si
    /// perde scrivendoci sopra. Se un filtro lo porta fuori dall'elenco, il pannello si svuota da sé invece di
    /// mostrare un documento che a schermo non c'è più.
    /// </summary>
    private ManagedDoc? Selected => _selKey is null ? null : Filtered().FirstOrDefault(d => RowKey(d) == _selKey);

    /// <summary>Scegliere una riga: cliccata sceglie, ricliccata lascia, un'altra sposta la scelta.</summary>
    private async Task Pick(string key)
    {
        if (_selKey == key) { _selKey = null; return; }
        _selKey = key;
        if (_versions.ContainsKey(key) && _releases.ContainsKey(key) && _history.ContainsKey(key)) return;
        _loadingKeys.Add(key);
        StateHasChanged();
        await LoadDetailAsync(key);
        _loadingKeys.Remove(key);
    }

    private async Task OnRowKey(KeyboardEventArgs e, string key)
    {
        if (e.Key is "Enter" or " " or "Spacebar") await Pick(key);
    }

    // ---- filtri: setter + sync URL (?q=&kind=&stato=&rel=) ----
    private void SetQuery(string? q) { _q = q ?? ""; SyncUrl(); }
    private void SetKind(ReleaseTargetType? k) { _kindFilter = k; SyncUrl(); }
    private void SetAcc(string? a) { _accFilter = a; SyncUrl(); }

    // I chip sono interruttori: ricliccato, il chip acceso torna a «tutti». Il chip «tutti» non c'è — il
    // totale sta accanto al titolo e il ✕ azzera in un gesto solo.
    private void ToggleStatus(string s) { _statusFilter = _statusFilter == s ? "all" : s; SyncUrl(); }
    private void ToggleRelease(string s) { _releaseFilter = _releaseFilter == s ? "all" : s; SyncUrl(); }

    private void ClearFilters()
    {
        _q = ""; _kindFilter = null; _statusFilter = "all"; _releaseFilter = "all"; _accFilter = null;
        SyncUrl();
    }

    // I menu parlano in stringhe: "" è «tutti», e un valore che non esiste più non deve far esplodere la pagina.
    private static ReleaseTargetType? ParseKind(string? v) =>
        Enum.TryParse<ReleaseTargetType>(v, out var k) ? k : null;
    private static string? Blank(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;

    private void SyncUrl()
    {
        var qp = new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(_q) ? null : _q,
            ["kind"] = _kindFilter?.ToString(),
            ["stato"] = _statusFilter == "all" ? null : _statusFilter,
            ["rel"] = _releaseFilter == "all" ? null : _releaseFilter,
            ["acc"] = _accFilter,
        };
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(qp), forceLoad: false, replace: true);
    }

    private void ReadFiltersFromUrl()
    {
        var q = QueryStringUtil.Parse(new Uri(Nav.Uri).Query);
        if (q.TryGetValue("q", out var qv)) _q = qv;
        if (q.Enum<ReleaseTargetType>("kind") is { } k) _kindFilter = k;
        if (q.Value("stato") is { } sv && StatusValues.Contains(sv)) _statusFilter = sv;
        if (q.Value("rel") is { } rv && ReleaseValues.Contains(rv)) _releaseFilter = rv;
        // L'ACC non si valida contro un elenco chiuso: l'elenco dei documenti non è ancora caricato, e una ACC
        // che non c'è filtra a zero — che è esattamente ciò che dice l'URL.
        if (q.Value("acc") is { } av && !string.IsNullOrWhiteSpace(av)) _accFilter = av.ToUpperInvariant();
    }

    // Lazy: versioni (solo Document) + release, caricate quando la riga è espansa.
    private async Task LoadDetailAsync(string key)
    {
        var d = _docs?.FirstOrDefault(x => RowKey(x) == key);
        if (d is null) return;
        try
        {
            if (d.DocumentId is int docId && !_versions.ContainsKey(key))
                _versions[key] = await Editing.ListVersionsAsync(docId);
            if (!_releases.ContainsKey(key))
                _releases[key] = await Releases.ListAsync(d.ReleaseTarget, d.ReleaseKey);
            // Storia modifiche: vale per TUTTE le famiglie (doc 13 §3i). L'audit lo si scrive per DocumentVersion,
            // quindi la storia di un documento è l'unione di quella delle sue versioni. Prima si interrogavano i
            // bersagli «AccProfile»/«AppProfile» — lo storage per-tipo droppato dal doc 08i: quelle righe non le
            // scrive più nessuno, e il riquadro diceva sempre «nessuna storia» per ACC e APP e non c'era altrove.
            if (d.DocumentId is int historyDocId && !_history.ContainsKey(key))
            {
                var versionIds = (_versions.TryGetValue(key, out var vs) ? vs : await Editing.ListVersionsAsync(historyDocId))
                    .Select(v => v.Id.ToString()).ToList();
                _history[key] = await Audit.ListForEntitiesAsync("DocumentVersion", versionIds);
            }
            await ResolveAuthorsAsync(key);
        }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
    }

    // Risolve i VID mostrati (versioni + release) in nomi, una volta per riga.
    private async Task ResolveAuthorsAsync(string key)
    {
        var vids = new HashSet<int>();
        if (_versions.TryGetValue(key, out var vs)) foreach (var v in vs) vids.Add(v.CreatedByUserId);
        if (_releases.TryGetValue(key, out var rs)) foreach (var r in rs) vids.Add(r.CreatedByUserId);
        if (_history.TryGetValue(key, out var hs)) foreach (var h in hs) vids.Add(h.UserId);
        var missing = vids.Where(id => id != 0 && !_authorNames.ContainsKey(id)).ToList();
        if (missing.Count == 0) return;
        var names = await StaffRoster.GetDisplayNamesAsync(missing);
        foreach (var kv in names) _authorNames[kv.Key] = kv.Value;
    }

    /// <summary>Il nome che il roster conosce, o <c>null</c>. Prima questo metodo componeva da sé la stringa
    /// «Nome (VID 123456)»; la compone <c>VidLink</c>, che di quel VID fa anche un link al profilo.</summary>
    private string? NomeAutore(int vid) => _authorNames.TryGetValue(vid, out var n) ? n : null;

    /// <summary>Chi ha fatto l'atto, come si scrive in riga. ⚠️ Due rami erano arrivati qui per strade
    /// diverse e la fusione le teneva entrambe a metà: uno aveva reso il VID una porta sul profilo, l'altro
    /// aveva stabilito che «VID 0» è una riga che mente — zero non è nessuno, è il backfill di boot. Valgono
    /// tutte e due: sopra lo zero il VID è un link, sullo zero si scrive «sistema» e non si linka niente.
    /// Non è una regola di <c>VidLink</c>: là «VID 0» è voluto e c'è un test che lo pretende (una colonna
    /// intestata «VID» vuole un numero, non una parola).</summary>
    private RenderFragment Autore(int vid) => __builder =>
    {
        @if (vid <= 0)
        {
            @L["Common_SystemAuthor"]
        }
        else
        {
            <VidLink Vid="vid" Nome="@NomeAutore(vid)" />
        }
    };

    // ⚠️ Qui c'era un parser che leggeva {"Areas":[...],"Saves":N} dal DetailsJson: chiavi che NESSUNO
    // scrive, quindi ritornava sempre stringa vuota — un riepilogo che non ha mai riepilogato niente.
    // Non si cancella e basta: si sostituisce con lo stesso formattatore della pagina Audit, cosi' due
    // pagine che mostrano lo stesso evento non possono piu' divergere.
    private string HistoryDetail(AuditEntry e) => AuditNarrator.Frase(e, L);

    private RenderFragment DetailBlock(ManagedDoc d) => __builder =>
    {
        var key = RowKey(d);
        @if (_loadingKeys.Contains(key))
        {
            <p class="help">@L["Common_Loading"]</p>
        }
        @if (_versions.TryGetValue(key, out var vers) && vers.Count > 0)
        {
            foreach (var v in vers)
            {
                <div class="ver-row @(v.IsCurrent ? "current" : "")">
                    @* v@(...) con parentesi: «v@v.…» sarebbe letto da Razor come email ed emesso letterale. *@
                    <span class="vb">v@(v.VersionNumber)</span>
                    <div>
                        <b>@StatusLabel(v.Status)</b>
                        @if (v.IsCurrent) { <span class="pill green">@L["Ver_Current"]</span> }
                        <div class="vmeta" title="@L["Ver_AuthorDraftTitle"]">@Autore(v.CreatedByUserId) · @v.CreatedUtc.ToString("dd MMM yyyy HH:mm") · AIRAC @v.AiracCycle@(string.IsNullOrWhiteSpace(v.Note) ? "" : $" — \"{v.Note}\"")</div>
                    </div>
                    <span class="vact">
                        @if (v.Status == DocumentStatus.Draft)
                        {
                            <button class="btn primary" disabled="@_busy" @onclick="() => Publish(d, v.Id)">@L["Ver_PublishVersion"]</button>
                            @* Scartare distrugge lavoro: stessa conferma in linea dell'eliminazione documento. *@
                            @* Etichette passate esplicitamente: i default del componente sono in italiano fisso
                               e direbbero «elimina», mentre qui l'azione è «scarta» — e la pagina può essere in inglese. *@
                            <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Ver_DiscardTitle"]" AriaLabel="@L["Ver_DiscardAria"]"
                                           Prompt="@L["Ver_DiscardPrompt"]" Disabled="@_busy"
                                           ConfirmLabel="@L["Ver_DiscardConfirm"]" CancelLabel="@L["Common_Cancel"]"
                                           OnConfirm="() => DiscardDraft(d, v.Id)">
                                <Trigger><Icon Name="trash" /> @L["Ver_Discard"]</Trigger>
                            </InlineConfirm>
                        }
                    </span>
                </div>
            }
        }

        @if (d.DocumentId is not null)
        {
            <div class="block ver-sec">
                <div class="ver-sec-h">
                    <b>🕓 @L["Ver_HistoryTitle"]</b>
                    @* La riga di prosa che spiegava la storia stava SEMPRE a schermo, dentro il pannello dove
                       lo spazio e' quello che e': stesso testo, stessa chiave, si legge al clic (regola 7). *@
                    <HelpHint Href="/services/vsop/guide#versioni" AriaLabel="@L["Ver_HistoryTitle"]">@L["Ver_HistorySubtitle"]</HelpHint>
                </div>
                @if (_history.TryGetValue(key, out var hist) && hist.Count > 0)
                {
                    foreach (var e in hist)
                    {
                        var detail = HistoryDetail(e);
                        <div class="ver-row">
                            <span class="vb">✎</span>
                            <div>
                                <b>@Autore(e.UserId)</b>
                                <div class="vmeta">@e.TimestampUtc.ToString("dd MMM yyyy HH:mm")@(string.IsNullOrEmpty(detail) ? "" : " · ")<VidText Testo="@detail" /></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="help">@L["Ver_NoHistory"]</p>
                }
            </div>
        }

        <div class="block ver-sec">
            <div class="ver-sec-h">
                <b><Icon Name="calendar" /> @L["Rel_AiracRelease"]</b>
                <HelpHint Href="/services/vsop/guide#versioni" AriaLabel="@L["Rel_AiracRelease"]">@(string.Format(L["Ver_ReleaseSubtitle"].Value, _currentCycle))</HelpHint>
            </div>
            @if (_releases.TryGetValue(key, out var rels) && rels.Count > 0)
            {
                foreach (var r in rels)
                {
                    <div class="ver-row @(r.IsEffectiveNow ? "current" : "")">
                        <span class="vb">AIRAC @r.ReleaseAiracCycle</span>
                        <div>
                            <b>@ReleaseLabel(r)</b>
                            @* «rilascio #N» = progressivo della release, non la versione del documento (vedi ReleasePanel). *@
                            <div class="vmeta" title="@L["Ver_AuthorReleaseTitle"]">@L["Rel_VersionLabel", r.VersionNumber] · @Autore(r.CreatedByUserId) · @r.CreatedUtc.ToString("dd MMM yyyy HH:mm") · @L["Rel_EffectiveFrom"] @r.ReleaseEffectiveUtc.ToString("dd MMM yyyy")@(string.IsNullOrWhiteSpace(r.Note) ? "" : $" — \"{r.Note}\"")</div>
                        </div>
                        <span class="vact">
                            <a class="btn ghost" href="@PreviewLink(d, r.Id)" target="_blank" rel="noopener" title="@L["Rel_PreviewTitle"]"><Icon Name="eye" /> @L["Rel_Preview"]</a>
                            <button class="btn ghost" disabled="@_busy" @onclick="() => ToggleDiff(key, r.Id)" title="@L["Rel_DiffTitle"]"><Icon Name="search" /> @L["Rel_Diff"]</button>
                            @if (Authz.IsEditor)
                            {
                                @* Annullare una release in vigore/programmata riporta il PUBBLICO alla precedente:
                                   più delicato di «nascondi». Una SUPERATA invece è storia: la domanda lo dice
                                   (stessa coppia di frasi di ReleasePanel). *@
                                <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@CancelTitle(r)" AriaLabel="@CancelTitle(r)"
                                               Prompt="@CancelPrompt(r)" ConfirmLabel="@L["Ver_CancelReleaseYes"]" CancelLabel="@L["Ver_CancelReleaseNo"]"
                                               Disabled="@_busy" OnConfirm="() => CancelRelease(key, r.Id)">
                                    <Trigger>✕ @L["Common_Cancel"]</Trigger>
                                </InlineConfirm>
                            }
                        </span>
                    </div>
                    @if (_diffOpen.Contains(r.Id))
                    {
                        <div class="block ver-diff">
                            <ReleaseDiffTable Diff="@(_diffs.TryGetValue(r.Id, out var d) ? d : null)" />
                        </div>
                    }
                }
            }
            else
            {
                <p class="help">@L["Rel_NoRelease"]</p>
            }

            <div class="ver-pub">
                <select class="app-in ver-cycle" @onchange="e => SetCycle(key, e.Value?.ToString())">
                    @foreach (var c in _upcoming)
                    {
                        <option value="@c.Cycle" selected="@(SelectedCycle(key) == c.Cycle)">AIRAC @c.Cycle — @L["Rel_From"] @c.EffectiveUtc.ToString("dd MMM yyyy")</option>
                    }
                </select>
                <input class="app-in ver-note" placeholder="@L["Rel_NotePh"]" value="@NoteOf(key)" @onchange="e => SetNote(key, e.Value?.ToString())" />
                <button class="btn primary" disabled="@_busy" @onclick="() => PublishRelease(d)">@L["Ver_PublishAtCycle"]</button>
                @* «Pubblica ora» scavalca il ciclo AIRAC e va al pubblico subito: un clic solo era troppo poco. *@
                <InlineConfirm TriggerClass="btn ghost" TriggerTitle="@L["Ver_PublishNowTitle"]" AriaLabel="@L["Ver_PublishNowReview"]"
                               Prompt="@L["Ver_PublishNowPrompt"]" ConfirmLabel="@L["Ver_PublishNowYes"]" CancelLabel="@L["Common_Cancel"]"
                               Danger="false" Disabled="@_busy" OnConfirm="() => PublishNow(d)">
                    <Trigger>@L["Ver_PublishNowReview"]</Trigger>
                </InlineConfirm>
            </div>
        </div>
    };

    private async Task Publish(ManagedDoc d, int versionId)
    {
        // Pubblicazione dalla lista (senza aprire l'editor): acquisisci prima il lock — es. un documento generato
        // in automatico e mai aperto non ne ha uno. PublishAsync lo rilascia dopo. Se un altro editor lo detiene,
        // AcquireLock non lo assegna e PublishAsync solleva il conflitto (messaggio già gestito da Run).
        await Run(async () =>
        {
            if (d.DocumentId is int docId) await Editing.AcquireLockAsync(docId);
            await Editing.PublishAsync(versionId, note: null);
        }, L["Ver_VersionPublished"]);
    }

    /// <summary>
    /// Scarta la bozza: come la pubblicazione dalla lista, prende prima il lock (un documento mai aperto non
    /// ne ha uno) e il servizio lo rilascia dopo. Se lo detiene un altro editor, il conflitto arriva da lì col
    /// suo messaggio. Le condizioni — è davvero una bozza, e c'è una versione a cui tornare — le impone il
    /// servizio: qui non si duplicano, o divergerebbero al primo cambio.
    /// </summary>
    private async Task DiscardDraft(ManagedDoc d, int versionId)
    {
        await Run(async () =>
        {
            if (d.DocumentId is int docId) await Editing.AcquireLockAsync(docId);
            await Editing.DiscardDraftAsync(versionId);
        }, L["Ver_DraftDiscarded"]);
    }

    private async Task PublishRelease(ManagedDoc d)
    {
        var key = RowKey(d);
        var cycle = SelectedCycle(key) ?? _upcoming.FirstOrDefault()?.Cycle;
        if (cycle is null) return;
        _releases.Remove(key);
        await Run(() => Releases.PublishAsync(d.ReleaseTarget, d.ReleaseKey, cycle, NoteOf(key)), string.Format(L["Ver_ReleasePublishedCycle"].Value, cycle));
        await LoadDetailAsync(key);
        await LoadAsync();   // i cicli release stanno nell'elenco: si rilegge quello, non un secondo riepilogo
    }

    private async Task PublishNow(ManagedDoc d)
    {
        var key = RowKey(d);
        _releases.Remove(key);
        await Run(() => Releases.PublishNowAsync(d.ReleaseTarget, d.ReleaseKey, NoteOf(key)), L["Rel_PublishedNow"]);
        await LoadDetailAsync(key);
        await LoadAsync();   // i cicli release stanno nell'elenco: si rilegge quello, non un secondo riepilogo
    }

    // ---- annulla / differenze / anteprima release ----
    private readonly HashSet<int> _diffOpen = new();
    private readonly Dictionary<int, ReleaseDiff> _diffs = new();

    private async Task CancelRelease(string key, int releaseId)
    {
        _releases.Remove(key);
        await Run(() => Releases.CancelReleaseAsync(releaseId), L["Rel_Canceled"]);
        await LoadDetailAsync(key);
        await LoadAsync();   // i cicli release stanno nell'elenco: si rilegge quello, non un secondo riepilogo
    }

    private async Task ToggleDiff(string key, int releaseId)
    {
        if (!_diffOpen.Remove(releaseId))
        {
            _diffOpen.Add(releaseId);
            if (!_diffs.ContainsKey(releaseId))
            {
                try { _diffs[releaseId] = await Releases.DiffAsync(releaseId); }
                catch (EditNotAllowedException ex) { _error = ex.Message; }
            }
        }
    }

    // Anteprima release nel viewer tipizzato (?as=rel:{id}). No hop via /services/vsop/release: costruiamo l'URL diretto.
    private string PreviewLink(ManagedDoc d, int releaseId)
    {
        var acc = (d.AccCode ?? Acc ?? "lirr").ToLowerInvariant();
        return DocRoutes.For(d.Kind).ViewerUrl(acc, d.ReleaseKey, d.NeighbourCode, releaseId)
            ?? $"/services/vsop/release/{releaseId}";
    }

    private async Task ToggleHidden(ManagedDoc d)
    {
        // «Nascondi» passa dalla conferma, che ha gia' riletto il lock; «Mostra» e' immediato e lo rilegge qui.
        if (!await RefreshLockAsync(d)) return;
        await Run(() => DocAdmin.SetHiddenAsync(new ManagedDocRef(d.Kind, d.ReleaseKey, d.DocumentId), !d.IsHidden),
            d.IsHidden ? L["Ver_DocShown"] : L["Ver_DocHidden"]);
        await LoadAsync();
    }

    // La conferma è l'InlineConfirm della riga, e porta il titolo del documento e le conseguenze: prima ce n'erano
    // DUE in fila (quella in linea più un window.confirm), e il testo utile stava nella seconda — che per giunta
    // blocca il circuito Blazor e manda in stallo la verifica live.
    /// <summary>Dopo l'eliminazione dalla finestra: il documento scelto non esiste più e il pannello si
    /// svuota. L'eliminazione l'ha già fatta il servizio — qui resta solo da rimettere a posto la pagina.</summary>
    private async Task DopoEliminazione()
    {
        _status = L["Ver_DocDeleted"];
        _error = _errorTitle = null;
        _selKey = null;
        await LoadAsync();
    }

    private async Task Delete(ManagedDoc d)
    {
        await Run(() => DocAdmin.DeleteAsync(new ManagedDocRef(d.Kind, d.ReleaseKey, d.DocumentId)), L["Ver_DocDeleted"]);
        if (_selKey == RowKey(d)) _selKey = null;   // il documento scelto non esiste più: il pannello si svuota
        await LoadAsync();
    }

    private async Task Run(Func<Task> action, string ok)
    {
        _busy = true; _status = _error = _errorTitle = null;
        try { await action(); _status = ok; }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        catch (EditConflictException ex) { _error = ex.Message; _errorTitle = L["Ver_LockedTitle"]; }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ex.Message; }
        catch (InvalidOperationException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // stato per-riga (ciclo/nota release)
    private readonly Dictionary<string, string?> _selCycle = new();
    private readonly Dictionary<string, string?> _note = new();
    private string? SelectedCycle(string key) => _selCycle.TryGetValue(key, out var c) ? c : null;
    private void SetCycle(string key, string? c) => _selCycle[key] = c;
    private string? NoteOf(string key) => _note.TryGetValue(key, out var n) ? n : null;
    private void SetNote(string key, string? n) => _note[key] = n;

    // Icona per tipo documento, coerente coi bottoni di NewDocumentPage (globe/map/plane/file).
    // ⚠️ Lo «scudo» dei militari è lo stesso della card su /services/vsop: un documento si riconosce
    // dall'icona prima che dall'etichetta, e due icone diverse per la stessa cosa sono due cose diverse.
    private static string KindIcon(ReleaseTargetType k) => k switch
    {
        ReleaseTargetType.Vloa => "globe", ReleaseTargetType.AccVipi => "map",
        ReleaseTargetType.Airport => "plane-takeoff", ReleaseTargetType.App => "plane-landing",
        ReleaseTargetType.AirportMil or ReleaseTargetType.AppMil => "shield", _ => "file",
    };
    // ⚠️ Il ramo finale stampa il NOME DELL'ENUM: fino al 29 agosto 2026 una release militare compariva
    // qui come «AirportMil», non tradotta e non riconoscibile. Il ramo resta — è la rete per un tipo nuovo —
    // ma i tipi che esistono devono avere tutti un nome scritto per un lettore.
    private string KindLabel(ReleaseTargetType k) => k switch
    {
        ReleaseTargetType.Vloa => "vLOA", ReleaseTargetType.AccVipi => L["Nd_KindAcc"],
        ReleaseTargetType.Airport => L["Nd_KindAirport"], ReleaseTargetType.App => "vIPI APP",
        ReleaseTargetType.AirportMil => L["Mil_LinkFromCivil"],
        ReleaseTargetType.AppMil => $"{L["Mil_LinkFromCivil"]} APP",
        _ => k.ToString(),
    };
    private string StatusLabel(DocumentStatus s) => s switch
    {
        DocumentStatus.Draft => L["Ver_StBozza"], DocumentStatus.Published => L["Ver_StPubblicata"], DocumentStatus.Archived => L["Ver_StArchiviata"], _ => s.ToString(),
    };
    private string ReleaseLabel(ReleaseInfo r) => r.IsEffectiveNow
        ? "🟢 " + L["Rel_Effective"] : r.Status == ReleaseStatus.Scheduled ? "🕒 " + L["Rel_Scheduled"] : L["Rel_Superseded"];

    /// <summary>Superata = né in vigore né programmata: annullarla cancella storia, non cambia il pubblico.</summary>
    private static bool Superata(ReleaseInfo r) => !r.IsEffectiveNow && r.Status != ReleaseStatus.Scheduled;
    private string CancelPrompt(ReleaseInfo r) =>
        Superata(r) ? L["Rel_CancelPromptOld", r.ReleaseAiracCycle] : L["Rel_CancelPrompt", r.ReleaseAiracCycle];
    private string CancelTitle(ReleaseInfo r) =>
        Superata(r) ? L["Rel_CancelTitleOld"] : L["Rel_CancelTitle"];

    private string EditorLink(ManagedDoc d)
    {
        var acc = (d.AccCode ?? Acc ?? "lirr").ToLowerInvariant();
        return DocRoutes.For(d.Kind).EditorUrl(acc, d.ReleaseKey, d.NeighbourCode, d.DocumentId)
            ?? "/services/vsop/versions";
    }
}
