@page "/services/vsop/admin/pending"
@layout SopLayout
@rendermode InteractiveServer
@inject IPendingOverviewService Pending
@inject IWorkListService Lavoro
@inject IDocumentImpactService Impatti
@inject IEditAuthorizationService Authz
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Pend_Title"] · IVAO Italy</PageTitle>

@* ---- «Cosa devo sistemare» ------------------------------------------------------------------------
   I pezzi c'erano già tutti, e si leggevano uno per volta: gli orfani in fondo alla Struttura di UNA ACC,
   gli impatti nel banner di UN documento aperto in modifica, e gli aeroporti spariti da nessuna parte —
   perché fino al 26 agosto 2026 `Airport` non aveva nessun timbro d'import.
   Questa pagina è anche ciò che DÀ IL PERMESSO di eliminare: la regola è che si toglie solo quel che la
   sorgente non manda da due giri, e qui si vede chi ha già maturato quel diritto e chi no, col motivo
   scritto accanto invece che scoperto premendo un tasto. *@
<div class="wrap struct">
    <AdminNav />

    <div class="doc-head st-head">
        <h1 class="st-h2 page-h1">
            @L["Pend_Title"]
            @if (_dati is not null)
            {
                <span>&nbsp;</span>
                <span class="pill @(Totale > 0 ? "amber" : "blue")">@Totale</span>
            }
        </h1>
        <HelpHint Href="/services/vsop/guide#admin-pending" AriaLabel="@L["Pend_HelpAria"]" ExtraClass="wide">
            @((MarkupString)L["Pend_Intro"].Value)
        </HelpHint>
        <nav class="struct-nav">
            <button class="btn ghost" disabled="@_busy" @onclick="CaricaAsync" title="@L["Audit_Refresh"]">
                <Icon Name="refresh" Size="14" /> @L["Audit_Refresh"]
            </button>
        </nav>
        <LiveRegion>
            @if (_msg is { } m)
            {
                <span class="st-msg warn"><Icon Name="warning" Size="14" /><span class="st-msg-t">@m</span></span>
            }
        </LiveRegion>
    </div>

    @if (!Authz.IsAdmin)
    {
        <p class="help">@L["Pend_AdminOnly"]</p>
    }
    else if (_dati is null)
    {
        <LoadingState />
    }
    else
    {
        @* Il metro, in cima: senza sapere QUANDO la sorgente ha parlato l'ultima volta, «non lo manda più»
           è un'affermazione che chi legge non può verificare. *@
        <p class="muted" style="margin:0 0 14px;font-size:12.5px">
            @L["Pend_LastRuns",
                _dati.UltimoGiroAcc is { } a ? $"{a:yyyy-MM-dd HH:mm}Z" : "—",
                _dati.UltimoGiroAeroporti is { } b ? $"{b:yyyy-MM-dd HH:mm}Z" : "—",
                _dati.PenultimoGiroAeroporti is { } c ? $"{c:yyyy-MM-dd HH:mm}Z" : "—"]
        </p>

        @if (Totale == 0)
        {
            <EmptyState Icon="check-circle" Title="@L["Pend_AllClear"].Value">
                <p style="margin:0">@L["Pend_AllClearHint"]</p>
            </EmptyState>
        }

        @* ---- Aeroporti che la sorgente non conferma più ---- *@
        @if (_dati.Aeroporti.Count > 0)
        {
            <div class="section-title">
                <h2 class="h-sect">@L["Pend_AirportsTitle"] <span class="pill amber">@_dati.Aeroporti.Count</span></h2>
                <span class="ln"></span>
            </div>
            <div class="panel">
                <table class="res-table">
                    <thead>
                        <tr>
                            <th>@L["Pend_ColWhat"]</th>
                            <th>@L["Pend_ColLastSeen"]</th>
                            <th>@L["Pend_ColPrice"]</th>
                            <th>@L["Orph_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _dati.Aeroporti)
                        {
                            <tr>
                                <td><b>@r.Riga.Icao</b> <span class="muted">@r.Riga.Name · @r.Riga.AccCode</span></td>
                                <td>
                                    @(r.Riga.LastSeenUtc is { } t ? $"{t:yyyy-MM-dd}" : "—")
                                    @if (r.Riga.DaGiorni is { } g)
                                    {
                                        <span class="muted"> · @L["Pend_DaysAgo", g]</span>
                                    }
                                </td>
                                <td>
                                    @if (r.Riga.Settori > 0)
                                    {
                                        <span>@L["Pend_Sectors", r.Riga.Settori]</span>
                                    }
                                    @if (r.Riga.HaDocumento)
                                    {
                                        <span class="pill blue">@L["Pend_HasDoc"]</span>
                                    }
                                </td>
                                <td>
                                    @if (r.Eliminabile)
                                    {
                                        <DeleteDialog Target="DeletionTarget.Airport(r.Riga.AirportId)" Nome="@r.Riga.Icao"
                                                      TriggerClass="btn ghost danger" AriaLabel="@L["Del_Airport"]"
                                                      Disabled="@_busy" OnDeleted="CaricaAsync">
                                            <Trigger><Icon Name="trash" Size="14" /> @L["Del_Airport"]</Trigger>
                                        </DeleteDialog>
                                    }
                                    else
                                    {
                                        <span class="muted">@r.MotivoDelNo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ---- Documenti senza una chiave ----------------------------------------------------------
           ⚠️ Non sono invisibili: sono etichettati male. Un vIPI che nessun descrittore riconosce come ACC o
           APP finisce nel catch-all dell'aeroporto, e senza un aeroporto la chiave di release nasce VUOTA:
           compare in elenco senza nome di scalo, non si pubblica, la tendina degli incarichi lo nasconde di
           proposito. Ci si finisce quando il terreno cambia sotto — un CTR radice che un import infila sotto
           un padre. Questo è il solo posto che li nomina per quello che sono. *@
        @if (_dati.DocumentiFuoriElenco.Count > 0)
        {
            <div class="section-title">
                <h2 class="h-sect">@L["Pend_LostDocsTitle"] <span class="pill amber">@_dati.DocumentiFuoriElenco.Count</span></h2>
                <span class="ln"></span>
            </div>
            <div class="panel">
                <p class="muted" style="margin:0 0 10px">@L["Pend_LostDocsHint"]</p>
                <table class="res-table">
                    <thead>
                        <tr>
                            <th>@L["Pend_ColDoc"]</th>
                            <th>@L["Orph_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _dati.DocumentiFuoriElenco)
                        {
                            <tr>
                                <td><b>@d.Title</b> <span class="muted">@L["Pend_DocNumber", d.Id]</span></td>
                                <td>
                                    <DeleteDialog Target="DeletionTarget.Document(d.Id)" Nome="@d.Title"
                                                  TriggerClass="btn ghost danger" AriaLabel="@L["Del_Doc"]"
                                                  Disabled="@_busy" OnDeleted="CaricaAsync">
                                        <Trigger><Icon Name="trash" Size="14" /> @L["Del_Doc"]</Trigger>
                                    </DeleteDialog>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ---- Settori orfani, di tutte le ACC ---- *@
        @if (_dati.Orfani.Count > 0)
        {
            <div class="section-title">
                <h2 class="h-sect">@L["Orph_Title"] <span class="pill amber">@_dati.Orfani.Count</span></h2>
                <span class="ln"></span>
            </div>
            <div class="panel">
                <p class="muted" style="margin:0 0 10px">@L["Pend_OrphansHint"]</p>
                <table class="res-table">
                    <thead>
                        <tr>
                            <th>@L["Orph_Callsign"]</th>
                            <th>@L["Orph_Why"]</th>
                            <th>@L["Orph_Documents"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _dati.Orfani)
                        {
                            <tr>
                                <td><b>@o.Callsign</b><br /><span class="muted">@o.AccCode</span></td>
                                <td>@Motivo(o)</td>
                                <td>
                                    @if (o.DocumentTitle is { } t)
                                    {
                                        <span class="pill blue">@L["Orph_CarriesDoc"]</span> <span>@t</span>
                                    }
                                    else if (o.Documents.Count > 0)
                                    {
                                        <span class="muted">@string.Join(", ", o.Documents.Select(d => d.Title))</span>
                                    }
                                    else
                                    {
                                        <span class="muted">@L["Orph_NoDocs"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @* Il riaggancio e l'eliminazione vivono nella Struttura, dove c'è l'albero che serve a
                   decidere: qui si vede che ESISTONO, e da lì si va a farlo. *@
                <p style="margin:10px 0 0">
                    <a class="btn ghost" href="/services/vsop/admin/sector-structure">@L["Pend_GoStructure"]</a>
                </p>
            </div>
        }

        @* ---- Documenti che non dicono più quel che direbbero oggi ------------------------------------
           Dal 26 agosto 2026 questa sezione non è più una tabella di sola lettura: sono le STESSE righe che
           l'interessato trova in «Da fare» e in cima al suo editor, rese dallo stesso componente e lette
           dallo stesso read-model. Tre resi diversi della stessa riga erano tre racconti che iniziavano a
           divergere. Qui la lista è quella dell'admin, quindi copre TUTTI i documenti.
           Carta: docs/feature/2026-08-26-da-fare-una-lista-sola.md §2/D1. *@
        @if (_daFare.Count > 0)
        {
            <div class="section-title">
                <h2 class="h-sect">@L["Pend_DocsTitle"] <span class="pill amber">@_daFare.Count</span></h2>
                <span class="ln"></span>
            </div>
            <div class="panel">
                <ul class="wi-list">
                    @foreach (var r in _daFare)
                    {
                        <WorkItemRow @key="r.Chiave" Item="r" Busy="_busy" ShowAssign="false"
                                     OnDone="ChiudiRiga" />
                    }
                </ul>
            </div>
        }
    }
</div>

@code {
    private PendingOverview? _dati;

    /// <summary>Le righe che il sistema ha aperto sui documenti, lette dal read-model unico. Solo quelle di
    /// SISTEMA: gli incarichi delle persone stanno in «Da fare», che è la pagina di chi lavora — questa è la
    /// pagina di chi tiene in ordine l'archivio.</summary>
    private IReadOnlyList<WorkItem> _daFare = Array.Empty<WorkItem>();

    /// <summary>
    /// Quante cose chiedono attenzione, contate su ciò che la pagina MOSTRA DAVVERO.
    ///
    /// <para>⚠️ Non è <c>PendingOverview.Totale</c>, e la differenza si vede: quello conta tutte le
    /// segnalazioni aperte, mentre la sezione qui sotto salta quelle che qualcuno ha già <b>preso in
    /// carico</b> — sono diventate un incarico, e stanno in «Da fare». Con il totale di prima la pastiglia
    /// direbbe nove e le righe sarebbero otto, che è il modo più rapido di far dubitare di una pagina.</para>
    /// </summary>
    private int Totale => _dati is null ? 0
        : _dati.Orfani.Count + _dati.Aeroporti.Count + _dati.DocumentiFuoriElenco.Count + _daFare.Count;
    private bool _busy;
    private string? _msg;

    // ⚠️ In OnParametersSetAsync e non in OnInitializedAsync: su una pagina interattiva il primo gira una
    // volta sola per tutta la vita del circuito.
    protected override Task OnParametersSetAsync() => CaricaAsync();

    private async Task CaricaAsync()
    {
        if (!Authz.IsAdmin) return;
        _busy = true;
        _msg = null;
        try
        {
            _dati = await Pending.LoadAsync();
            // Solo le righe di SISTEMA: gli incarichi delle persone stanno in «Da fare». ⚠️ Da admin
            // `MieAsync` copre tutti i documenti, quindi l'elenco qui resta quello di prima — meno quelle
            // che qualcuno ha già preso in carico, che è esattamente ciò che si vuole vedere sparire.
            _daFare = (await Lavoro.MieAsync())
                .Where(r => r.Origine == WorkOrigin.Sistema)
                .ToList();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    /// <summary>Il perché di un orfano, con le stesse parole della Struttura: tre fatti diversi, tre rimedi
    /// diversi, e le stesse chiavi — due frasi per lo stesso fatto sono due racconti che divergono.</summary>
    private string Motivo(OrphanSectorRow o) => o.Reason switch
    {
        OrphanReason.Hidden => L["Orph_Hidden"].Value,
        OrphanReason.Gone => L["Orph_Gone"].Value,
        _ => L["Orph_NotListed"].Value,
    };

    /// <summary>Spuntare una riga: qui capitano solo segnalazioni di sistema, e solo quelle NON calcolate
    /// mostrano il ✓ — il componente lo sa già dal piano che la riga porta con sé.</summary>
    private async Task ChiudiRiga(WorkItem r)
    {
        if (r.ImpactId is not int impactId) return;
        _busy = true;
        _msg = null;
        try
        {
            await Impatti.ClearAsync(impactId);
            await CaricaAsync();
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }
}
