@page "/sop/{Acc}/vipi"
@layout SopLayout
@inject IVipiViewService ViewService
@inject IStationResolver Stations

@if (_acc is null)
{
    <div class="wrap"><div class="callout danger"><span class="cic">⛔</span><div><p class="ct">ACC sconosciuto</p>@Acc</div></div></div>
}
else if (_view is null)
{
    <div class="wrap">
        <div class="breadcrumb"><a href="/sop">Home</a> › <a href="/sop/@Acc.ToLowerInvariant()">@_acc.Name</a> › <b>vIPI</b></div>
        <div class="callout warning"><span class="cic">⚠️</span><div><p class="ct">Documento non disponibile</p>Nessuna vIPI pubblicata per @_acc.Name.</div></div>
    </div>
}
else
{
    <PageTitle>@_view.Title · vIPI IVAO Italia</PageTitle>

    <div class="wrap">
        <div class="breadcrumb"><a href="/sop">Home</a> › <a href="/sop/@Acc.ToLowerInvariant()">@_acc.Name</a> › <b>@_view.Title</b></div>

        <div class="doc-layout">
            <aside class="toc">
                <p class="toc-h">Sommario</p>
                <ul>
                    @foreach (var s in _view.Sections)
                    {
                        <li>
                            <a href="#@s.Id">@s.Title</a>
                            @if (s.Children.Any())
                            {
                                <ul>
                                    @foreach (var c in s.Children)
                                    {
                                        <li><a class="lvl2" href="#@c.Id">@c.Title</a></li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </aside>

            <div>
                <div class="doc-head">
                    <div>
                        <h2 style="margin-bottom:2px">@_view.Title</h2>
                        <span class="muted">@_acc.Name · @(IsReduced ? "vista ridotta" : "vista estesa")</span>
                    </div>
                    <span class="airac">📅 Aggiornato AIRAC @_view.AiracCycle</span>
                </div>

                @foreach (var s in _view.Sections)
                {
                    <SectionNode Section="s" />
                }
            </div>

            <aside class="doc-rail">
                <div class="rail-card">
                    <h5><span class="dot" style="width:8px;height:8px;border-radius:50%;background:var(--ivao-green);display:inline-block"></span> Online nel tuo dominio</h5>
                    <ul class="online-list">
                        <li><span class="dot"></span><span class="cs">—</span><span class="fq">nessuno (no live)</span></li>
                    </ul>
                    <p class="muted" style="font-size:11.5px;margin:8px 0 0">Lista reale con il polling IVAO (fase F3).</p>
                </div>

                <div class="rail-card rail-mini">
                    <h5>🗺️ Mini-mappa AoR</h5>
                    <svg viewBox="0 0 280 180" aria-label="mini mappa settori">
                        <polygon points="24,40 130,28 150,98 56,128 18,96" fill="#0D2C99" fill-opacity="0.22" stroke="#0D2C99" stroke-width="2" />
                        <polygon points="130,28 256,46 262,116 168,134 150,98" fill="#3C55AC" fill-opacity="0.18" stroke="#3C55AC" stroke-width="1.5" />
                        <polygon points="56,128 168,134 162,172 70,170" fill="#7EA2D6" fill-opacity="0.28" stroke="#3C55AC" stroke-width="1.5" />
                        <text x="64" y="82" font-family="Nunito Sans" font-size="12" fill="#0D2C99" font-weight="700">NE</text>
                        <text x="206" y="92" font-family="Nunito Sans" font-size="12" fill="#3C55AC" font-weight="700">EW</text>
                        <text x="108" y="158" font-family="Nunito Sans" font-size="12" fill="#2c5d99" font-weight="700">SU</text>
                    </svg>
                </div>

                <div class="rail-card">
                    <h5>↪ Salta a</h5>
                    <ul class="rail-jump">
                        @foreach (var s in _view.Sections)
                        {
                            <li><a href="#@s.Id" style="color:inherit">@s.Title</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public string Acc { get; set; } = default!;
    [SupplyParameterFromQuery] public string? Tier { get; set; }

    private AccInfo? _acc;
    private DocumentView? _view;

    private bool IsReduced => string.Equals(Tier, "reduced", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        _acc = Stations.Resolve(Acc);
        if (_acc is null) { _view = null; return; }

        var tier = IsReduced ? BlockTier.Reduced : BlockTier.Extended;
        _view = await ViewService.BuildAccVipiAsync(_acc.Code, tier, live: false);
    }
}
