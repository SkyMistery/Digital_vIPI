@page "/services/vsop/{Acc}/mil"
@layout SopLayout
@inject IVipiViewService ViewService
@inject IAirportViewDerivationService AirportView
@inject IWeatherProvider Weather
@inject IMilitaryDocumentService Militari
@inject IStationResolver Stations
@inject Vipi.Application.Translation.DocumentTranslator Translator
@inject IReleaseService Releases
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@inject IStringLocalizer<SharedResource> L
@inject EnglishStrings En
@using System.Globalization
@using Vipi.Application.Content
@using Vipi.Ui.Shared
@using Vipi.Ui.Components.App
@using Vipi.Application.Abstractions
@using Vipi.Application.Weather
@using Vipi.Domain

<PageTitle>@(_view?.Title ?? L["Mil_Title"].Value) · IVAO Italy</PageTitle>

@* ---- Il vSOP militare di un campo (carta vSOP militari §5) -------------------------------------------

   ⚠️ NESSUN @rendermode: e' un documento, quindi SSR statico come il resto del chrome. La chip
   pilota/ATC sono tre COLLEGAMENTI apposta -- un bottone qui non partirebbe.

   ⚠️ Non e' la pagina dell'aeroporto con un parametro: le due edizioni hanno release, cicli AIRAC e
   contenuti indipendenti, e un collegamento salvato deve portare sempre allo stesso documento. *@

<div class="wrap">
    <div class="breadcrumb">
        <a href="/services/vsop">@En["Common_Home"]</a> ›
        <a href="/services/vsop/mil">@En["Mil_Title"]</a> ›
        <b>@(_icao.Length > 0 ? _icao : "—")</b>
    </div>

    @if (_view is null)
    {
        <div class="callout warning">
            <span class="cic"><Icon Name="warning" Size="18" /></span>
            <div><p class="ct">@L["Mil_Empty"]</p>@L["Mil_EmptyHint"]</div>
        </div>
    }
    else
    {
        @* ---- Le TRE colonne del documento, come le altre quattro famiglie -------------------------------

           ⚠️ Fino al 29 agosto 2026 questa pagina era l'UNICA delle cinque senza `doc-layout`: solo
           `.wrap.reading-cap` e il corpo. Niente indice a sinistra, niente riquadro dei collegamenti a
           destra. Su un vSOP militare — che ha nove sezioni, alcune lunghe — voleva dire scorrere per
           trovare le frequenze, e non avere il ponte verso l'altra edizione se non nella testata.

           ⚠️ `reading-cap` è caduto insieme: `.wrap:has(.doc-layout){max-width:none}` toglie il tetto al
           contenitore, ma la classe restava a dichiarare un limite che non vale più. Due regole che dicono
           cose diverse sullo stesso elemento sono un difetto che aspetta. *@
        <div class="doc-layout">
            <aside class="toc" aria-label="@L["Doc_TocAria"]">
                <p class="toc-h">@L["Common_Contents"]</p>
                <ul>
                    @foreach (var s in VisibleSections())
                    {
                        <li><a href="#@AnchorOf(s)">@s.Title</a></li>
                    }
                </ul>
            </aside>

            <div>
                <PrintMeta Title="@_view.Title" Subtitle="@L["Mil_PrintSubtitle"]" AiracCycle="@Cycle()" />
                <div class="doc-head">
                    <div>
                        <h1 class="page-h1">@_view.Title</h1>
                        @* Il ponte verso l'altra edizione dello stesso scalo: chi apre il militare deve poter
                           arrivare al civile senza tornare indietro di due pagine.

                           ⚠️ SOLO SE la vIPI civile esiste davvero, come fa la pagina civile verso di qui. Fino al
                           29 agosto 2026 il collegamento c'era sempre, e sui campi SOLO militari — Aviano, Ghedi,
                           Decimomannu, Rivolto, cioè proprio quelli che un vSOP ce l'hanno — portava al callout
                           «documento non disponibile». Un ponte che a volte non porta da nessuna parte è peggio di
                           un ponte che non c'è: la seconda volta non ci si clicca più nemmeno quando funziona. *@
                        @if (_haCivile)
                        {
                            <p class="muted">
                                <a href="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}")">
                                    <Icon Name="book-open" Size="14" /> @L["Mil_LinkToCivil"]
                                </a>
                            </p>
                        }
                    </div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@L["Common_Print"]</button>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil/editor?icao={_icao}")">@L["Common_Editor"]</a>
                        }
                    </div>
                </div>

                @if (_mode.IsPreview)
                {
                    <PreviewBanner Kind="_mode.Kind" Cycle="@_relCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}&as=draft")" />
                }

                <AudienceChip Visibile="_haMarcate" Vista="_vista"
                              BaseHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}")" />
                <TranslationNotice Coverage="_copertura" />

                <DocumentSectionsView Sections="_view.Sections" Profile="SectionProfile.AirportMil"
                                      IsDraft="@(_mode.Kind == PreviewKind.Draft)"
                                      AnchorOf="AnchorOf"
                                      DerivedContent="CorpoDerivato" />
            </div>

            @* Colonna destra sticky (desktop ≥1500px): riepilogo + collegamenti. Le voci sono quelle
               dell'aeroporto civile con la meta cambiata — elenco militare invece di elenco aeroporti — e il
               ponte verso l'altra edizione, che qui è il civile. *@
            <aside class="doc-rail" aria-label="@L["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @L["Common_Summary"]</h5>
                    @* Il ciclo del DOCUMENTO mostrato, non quello di oggi (doc 13 §3h): in anteprima di
                       release è quello della release, e lo snapshot se lo porta dietro. *@
                    <div class="rail-line"><span class="muted">@L["Common_AiracCycle"]</span><b>@Cycle()</b></div>
                    <div class="rail-line"><span class="muted">@L["Common_AtcOnline"]</span>
                        @{ var n = OnlineAt(_icao); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @L["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@L["Common_Home"]</a></li>
                        <li><a href="/services/vsop/mil">@L["Mil_Title"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @Acc.ToUpperInvariant()</a></li>
                        @* Stesso ponte della testata, e stesso gate: se la vIPI civile non c'è, la voce non
                           c'è. Un elenco di collegamenti utili con dentro un vicolo cieco è peggio di uno
                           più corto. *@
                        @if (_haCivile)
                        {
                            <li><a href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@_icao">@L["Mil_LinkToCivil"]</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public string Acc { get; set; } = "";

    [SupplyParameterFromQuery(Name = "icao")] public string? Icao { get; set; }

    /// <summary>Anteprima: assente = pubblica, <c>draft</c> = bozza, <c>rel:{id}</c> = una release. Stessa
    /// grammatica degli altri quattro viewer.</summary>
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero.</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    /// <summary>Le sezioni che l'indice a sinistra elenca: le nascoste solo in anteprima bozza, dove si
    /// vedono marcate. Stessa regola (e stessa riga) delle altre famiglie.</summary>
    private IEnumerable<SectionView> VisibleSections() =>
        _view!.Sections.Where(s => _mode.Kind == PreviewKind.Draft || !s.IsHidden);

    /// <summary>L'ancora di una sezione: <c>s-{Id}</c> come in tutte le famiglie (doc 13 §3e). ⚠️ Deve
    /// restare uguale al default di <c>DocumentSectionsView</c>, o l'indice punterebbe a un id che non
    /// esiste e i suoi link non farebbero niente — senza errori.</summary>
    private static string AnchorOf(SectionView s) => s.Id;

    /// <summary>Il ciclo AIRAC MOSTRATO: quello dell'anteprima release se è una, altrimenti quello che si
    /// porta dietro lo snapshot del documento.</summary>
    private string Cycle() => _relCycle ?? _view?.AiracCycle ?? "";

    /// <summary>Quanti ATC su questo campo adesso. ⚠️ L'ATIS è escluso, come sull'aeroporto civile: è una
    /// frequenza registrata, non qualcuno che controlla.</summary>
    private int OnlineAt(string icao) => Online.GetCurrent().Callsigns.Count(cs =>
        cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase)
        && !cs.EndsWith("_ATIS", StringComparison.OrdinalIgnoreCase));

    private DocumentView? _view;
    private string _icao = "";
    private Vipi.Domain.SectionAudience? _vista;
    private bool _haMarcate;
    private Vipi.Application.Translation.TranslationCoverage _copertura =
        Vipi.Application.Translation.TranslationCoverage.Nessuna;

    private PreviewMode _mode;      // pubblica | bozza | release
    private string? _relCycle;      // il ciclo dell'anteprima release, per il banner
    private bool _canEdit;
    private bool _useFrozen;        // vista pubblica: derivate congelate dalla release effettiva (doc 10 §3d)
    private bool _haCivile;         // esiste una vIPI civile pubblicata per questo scalo? (il ponte inverso)

    private AirportDerived _derivate = AirportDerived.Empty;
    private WeatherReport? _wx;
    private ParsedMetar? _metar;
    private ParsedTaf? _taf;
    private IReadOnlyList<AccSpecialAreaView> _aree = Array.Empty<AccSpecialAreaView>();

    /// <summary>
    /// Il corpo delle sezioni rese dalla pagina. ⚠️ Sono le STESSE dell'aeroporto civile perché parlano
    /// dello stesso scalo: meteo, piste, quote di transizione e frequenze di LIPI sono quelle, qualunque
    /// documento le mostri. Riusare la derivazione invece di rifarla è ciò che rende «sei chiavi riusate»
    /// un fatto e non una dichiarazione.
    ///
    /// <para>⚠️ Quel che il PDF ha in più — le coordinate delle soglie, i CRC/AEW — non si deriva: sta nei
    /// blocchi editoriali sotto la scheda, ed è per questo che quelle due sezioni sono <c>HostAndBlocks</c>.</para>
    /// </summary>
    private RenderFragment<SectionView> CorpoDerivato => sec => __builder =>
    {
        @switch (sec.SectionKey)
        {
            case "weather": <AirportWeather Icao="@_icao" Report="_wx" Metar="_metar" Taf="_taf" />; break;
            case "transition": <AirportTransition View="_derivate.Transition" CurrentQnh="_metar?.QnhHpa" />; break;
            case "frequencies": <AirportFrequencies View="_derivate.Frequencies" />; break;
            case "runways": <AirportRunways View="_derivate.Runways" />; break;
            @* Le aree di lavoro: E' la mappa dell'AoR con le chip, cioe' esattamente cio' che il PDF disegna
               a mano una figura per volta. Stesso motore della vIPI ACC e dell'APP. *@
            case "regulated": <RegulatedAreas Areas="_aree" />; break;
            case "validity": <ValidityStamp Target="ReleaseTargetType.AirportMil" Key="@_icao" ReleaseId="@ReleaseMostrata()" />; break;
        }
    };

    /// <summary>Vista PUBBLICA: documento e derivate congelate si impostano INSIEME (doc 11 §3d).</summary>
    private async Task CaricaPubblicoAsync()
    {
        _view = await ViewService.BuildAirportMilVipiAsync(_icao, BlockTier.Extended, live: false);
        _useFrozen = true;
    }

    /// <summary>La release che questa vista mostra: quella dell'anteprima, o null = la effettiva adesso.</summary>
    private int? ReleaseMostrata() => _mode.Kind == PreviewKind.Release ? _mode.ReleaseId : null;

    /// <summary>
    /// La selezione vive nel BodyJson del primo blocco della sezione, come per l'APP.
    /// ⚠️ <c>OwnAuto</c> forzato a falso: senza JSON <c>Parse</c> risponde «automatico», che qui non esiste —
    /// il modo automatico è del solo blocco Aerovia della vIPI ACC.
    /// </summary>
    private static RegulatedSelection LeggiAree(SectionView s)
    {
        var sel = RegulatedSelectionJson.Parse(s.Blocks.FirstOrDefault()?.BodyJson);
        return new RegulatedSelection { OwnAuto = false, OwnIds = sel.OwnIds, ExtraIds = sel.ExtraIds };
    }

    protected override async Task OnParametersSetAsync()
    {
        _icao = (Icao ?? "").Trim().ToUpperInvariant();
        _view = null;
        _copertura = Vipi.Application.Translation.TranslationCoverage.Nessuna;
        _haMarcate = false;
        _mode = PreviewMode.Parse(As, null);
        _relCycle = null;
        _useFrozen = false;
        _haCivile = false;
        if (_icao.Length == 0) return;

        Stations.Prewarm();
        _canEdit = Authz.IsEditor;

        // ⚠️ Il degrado di un'anteprima non autorizzata torna alla PUBBLICA, derivate congelate comprese:
        // lasciarlo a metà servirebbe al pubblico le derivate live, e il congelamento AIRAC diventerebbe
        // aggirabile scrivendo un `?as=rel:` qualsiasi nell'indirizzo.
        switch (_mode.Kind)
        {
            case PreviewKind.Draft:
                if (_canEdit)
                    _view = await ViewService.BuildAirportMilVipiAsync(_icao, BlockTier.Extended, live: false,
                        ignoreRelease: true, preferWorking: true);
                else { _mode = default; await CaricaPubblicoAsync(); }
                break;
            case PreviewKind.Release:
                var pv = await Releases.GetPreviewAsync(_mode.ReleaseId, ReleaseTargetType.AirportMil, _icao);
                if (pv?.Doc is not null) { _relCycle = pv.AiracCycle; _view = await ViewService.BuildFromRawAsync(pv.Doc, BlockTier.Extended); }
                else { _mode = default; await CaricaPubblicoAsync(); }
                break;
            default:
                await CaricaPubblicoAsync();
                break;
        }
        if (_view is null) return;

        _haCivile = await Militari.HasPublishedCivilAsync(_icao);

        // Le derivate dello STESSO scalo: meteo live piu' le sezioni congelate della release militare.
        _wx = await Weather.GetAsync(_icao);
        _metar = string.IsNullOrWhiteSpace(_wx?.Metar) ? null : MetarParser.ParseMetar(_wx!.Metar!);
        _taf = string.IsNullOrWhiteSpace(_wx?.Taf) ? null : MetarParser.ParseTaf(_wx!.Taf!);
        // ⚠️ `AirportMil`, NON `Airport`: le tabelle si derivano dallo stesso scalo, ma il congelato si
        // legge dalla release di QUESTO documento. Con `Airport` un campo misto (Pisa) mostrerebbe qui la
        // fotografia della vIPI civile — al ciclo AIRAC civile — e un campo solo militare (Rivolto) non
        // troverebbe niente e resterebbe per sempre live, senza che nulla protesti.
        _derivate = await AirportView.ResolveForViewAsync(_icao, _useFrozen, ReleaseTargetType.AirportMil);

        // ⚠️ Gli id delle aree li porta il DOCUMENTO mostrato; shape e descrizioni vengono dai cataloghi
        // correnti — come nella vIPI ACC e nell'APP. Si legge PRIMA della traduzione: la sezione tradotta
        // porta la prosa, non il JSON del blocco.
        var aree = _view.Sections.FirstOrDefault(
            s => string.Equals(s.SectionKey, "regulated", StringComparison.OrdinalIgnoreCase));
        _aree = aree is null
            ? Array.Empty<AccSpecialAreaView>()
            : await Militari.ResolveRegulatedAreasAsync(LeggiAree(aree));

        // ⚠️ Il vSOP militare nasce in ITALIANO (carta §1d): la lingua sorgente e' quella in cui si
        // REDIGE, non quella dei quindici PDF di partenza. Un lettore inglese lo ottiene tradotto.
        // ⚠️ «It» qui e' solo la lingua di NASCITA della famiglia: la sorgente vera la porta il documento
        // (DocumentView.Language), e questo parametro serve agli snapshot salvati prima che il campo
        // esistesse. Due posti che dichiarano la lingua sono due posti che possono contraddirsi.
        var lettore = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
        var tradotto = await Translator.TranslateAsync(_view, Vipi.Domain.Language.It, lettore);
        _view = tradotto.View;
        _copertura = tradotto.Coverage;

        // Il filtro DOPO la traduzione: si filtra la vista che il lettore vedra' davvero.
        _vista = AudienceFilter.Leggi(Vista);
        _haMarcate = AudienceFilter.HaSezioniMarcate(_view.Sections);
        var filtrate = AudienceFilter.Filtra(_view.Sections, _vista);
        if (!ReferenceEquals(filtrate, _view.Sections))
            _view = new DocumentView
            {
                Title = _view.Title, AiracCycle = _view.AiracCycle, Sections = filtrate,
                Language = _view.Language, Translations = _view.Translations,
            };
    }
}
