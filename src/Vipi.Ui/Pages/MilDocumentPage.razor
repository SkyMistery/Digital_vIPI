@page "/services/vsop/{Acc}/mil"
@layout SopLayout
@inject MilMemberLoader Loader
@inject IDocumentUnionService Unioni
@inject UnionLoader Membri
@inject NavigationManager Nav
@inject IEditAuthorizationService Authz
@inject IOnlineAtcProvider Online
@* Il nome dell'ACC per il sottotitolo: la pagina aveva solo il CODICE della rotta, e «Aeroporto
   militare · LIMM» non e' quel che dicono le altre quattro testate. *@
@inject IStationResolver Stations
@* ⚠️ Qui resta il solo `Sito`, cioè la lingua di chi GUARDA il sito: è l'arredamento della pagina.
   L'altro localizzatore — quello della lingua del DOCUMENTO, da cui passano le intestazioni delle tabelle
   del vSOP (ColonneNominativi, ColonneParcheggi) — sta in <MilDocumentBody>, insieme alle tabelle che
   intesta. La differenza fra i due è il confine della lingua bloccata (carta §4). *@
@inject StringheDelSito Sito
@inject EnglishStrings En
@using System.Globalization
@using Vipi.Application.Content
@using Vipi.Ui.Shared
@using Vipi.Ui.Components.App
@using Vipi.Application.Abstractions
@using Vipi.Application.Weather
@using Vipi.Domain

<PageTitle>@(_doc?.View.Title ?? Sito["Mil_Title"]) · IVAO Italy</PageTitle>

@* ---- Il vSOP militare di un campo (carta vSOP militari §5) -------------------------------------------

   ⚠️ NESSUN @rendermode: e' un documento, quindi SSR statico come il resto del chrome. La chip
   pilota/ATC sono tre COLLEGAMENTI apposta -- un bottone qui non partirebbe.

   ⚠️ Non e' la pagina dell'aeroporto con un parametro: le due edizioni hanno release, cicli AIRAC e
   contenuti indipendenti, e un collegamento salvato deve portare sempre allo stesso documento. *@

<div class="wrap">
    <div class="breadcrumb">
        <a href="/services/vsop">@En["Common_Home"]</a> ›
        <a href="/services/vsop/mil">@En["Mil_Title"]</a> ›
        <b>@(_icao.Length > 0 ? _icao : "—")</b>
    </div>

    @if (_doc is null)
    {
        <div class="callout warning">
            <span class="cic"><Icon Name="warning" Size="18" /></span>
            <div><p class="ct">@Sito["Mil_Empty"]</p>@Sito["Mil_EmptyHint"]</div>
        </div>
    }
    else
    {
        @* ---- Le TRE colonne del documento, come le altre quattro famiglie -------------------------------

           ⚠️ Fino al 29 agosto 2026 questa pagina era l'UNICA delle cinque senza `doc-layout`: solo
           `.wrap.reading-cap` e il corpo. Niente indice a sinistra, niente riquadro dei collegamenti a
           destra. Su un vSOP militare — che ha nove sezioni, alcune lunghe — voleva dire scorrere per
           trovare le frequenze, e non avere il ponte verso l'altra edizione se non nella testata.

           ⚠️ `reading-cap` è caduto insieme: `.wrap:has(.doc-layout){max-width:none}` toglie il tetto al
           contenitore, ma la classe restava a dichiarare un limite che non vale più. Due regole che dicono
           cose diverse sullo stesso elemento sono un difetto che aspetta. *@
        <div class="doc-layout">
            @* L'indice porta anche le SOTTO-sezioni: su questo documento sono venti su ventisei, e senza di
               loro l'indice ne elencava sei. *@
            <div>
                <DocumentToc Sections="_doc.View.Sections" IsDraft="@(_doc.Mode.Kind == PreviewKind.Draft)"
                             HeaderLabel="@(_altri.Count > 0 ? _doc.View.Title : null)"
                             AnchorOf="MilDocumentBody.AnchorOf" />
                <UnionToc Membri="_altri" IsDraft="@(_doc.Mode.Kind == PreviewKind.Draft)" />
            </div>

            <div>
                <PrintMeta Title="@_doc.View.Title" Subtitle="@Sottotitolo()" AiracCycle="@Cycle()"
                           Coverage="_doc.Copertura" Bloccata="@_doc.Bloccata" />
                <div class="doc-head">
                    <div>
                        <h1 class="page-h1" style="margin-bottom:2px">@_doc.View.Title</h1>
                        @* ⚠️ Il sottotitolo e' arrivato il 3 settembre 2026: fino a quel giorno questa era
                           l'UNICA delle cinque testate senza, e sopra il documento restavano una riga di
                           titolo nuda, un blocco di tre bottoni e un riquadro pieno per dire in che lingua
                           e' scritto. La chip di lettura sta ora in coda al sottotitolo e il riquadro e'
                           diventato un gettone: tre righe sopra il documento sono tornate due. *@
                        <div class="sub-line">
                            <span class="muted">@Sottotitolo()</span>
                            <AudienceChip Compatto="true" Visibile="_doc.HaMarcate" Vista="_doc.Vista"
                                          BaseHref="@AudienceHref()" />
                        </div>
                        @* ⚠️ Dal 2 settembre 2026 la riga propria dell'avviso ce l'hanno TUTTE E CINQUE:
                           appesa al sottotitolo, la riga andava a capo in mezzo alla frase dove il
                           sottotitolo era lungo. *@
                        <div class="sim-line"><SimDisclaimer /> <TranslationNotice Coverage="_doc.Copertura" Compatto="true" /> <LinguaBloccataNotice Lingua="@_doc.Bloccata" Compatto="true" /></div>
                        @* Il ponte verso l'altra edizione dello stesso scalo: chi apre il militare deve poter
                           arrivare al civile senza tornare indietro di due pagine.

                           ⚠️ SOLO SE la vIPI civile esiste davvero, come fa la pagina civile verso di qui. Fino al
                           29 agosto 2026 il collegamento c'era sempre, e sui campi SOLO militari — Aviano, Ghedi,
                           Decimomannu, Rivolto, cioè proprio quelli che un vSOP ce l'hanno — portava al callout
                           «documento non disponibile». Un ponte che a volte non porta da nessuna parte è peggio di
                           un ponte che non c'è: la seconda volta non ci si clicca più nemmeno quando funziona. *@
                        @if (MostraPonteCivile)
                        {
                            <p class="muted">
                                <a href="@($"/services/vsop/{Acc.ToLowerInvariant()}/airports?icao={_icao}")">
                                    <Icon Name="book-open" Size="14" /> @Sito["Mil_LinkToCivil"]
                                </a>
                            </p>
                        }
                    </div>
                    <div style="display:flex;align-items:center;gap:10px">
                        <button type="button" class="btn ghost" onclick="window.print()">@Sito["Common_Print"]</button>
                        @if (_canEdit)
                        {
                            <a class="btn primary" href="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil/editor?icao={_icao}")">@Sito["Common_Editor"]</a>
                        }
                    </div>
                </div>

                @if (_doc.Mode.IsPreview)
                {
                    <PreviewBanner Kind="_doc.Mode.Kind" Cycle="@_doc.RelCycle"
                                   PublicHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}")"
                                   DraftHref="@($"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}&as=draft")" />
                }

                @* ⚠️ Un vSOP militare su un campo MISTO senza la sua vIPI civile: la guardia impedisce di
                   crearne di nuovi, ma non ripara quelli nati prima del 29 agosto 2026. Lo si dice a chi
                   può rimediare, con il tasto che rimedia — non a chi legge, che non ci può fare niente. *@
                @if (MancaCivile)
                {
                    <div class="callout warning">
                        <span class="cic"><Icon Name="warning" Size="18" /></span>
                        <div>
                            <p class="ct">@Sito["Mil_MissingCivilTitle"]</p>
                            @Sito["Mil_MissingCivilBody"]
                            <p style="margin:8px 0 0">
                                <a class="btn ghost" href="/services/vsop/@Acc.ToLowerInvariant()/airports/editor?icao=@_icao">
                                    <Icon Name="plus" Size="14" /> @Sito["Mil_MissingCivilAction"]
                                </a>
                            </p>
                        </div>
                    </div>
                }

                @* ⚠️ Chip di lettura e gettone della lingua stanno nella TESTATA, non qui: vedi la
                   `.sub-line` e la `.sim-line` piu' sopra. *@
                @* Il corpo — sezioni e derivate — sta in un componente, perché lo stesso documento va reso
                   anche nella pagina UNITA (carta 2026-09-03-documenti-uniti.md). Qui resta il chrome. *@
                <MilDocumentBody Doc="_doc" />

                @* Gli altri documenti dell'unione, nell'ordine scelto dal redattore. *@
                <UnionBodies Membri="_altri" />
            </div>

            @* Colonna destra sticky (desktop ≥1500px): riepilogo + collegamenti. Le voci sono quelle
               dell'aeroporto civile con la meta cambiata — elenco militare invece di elenco aeroporti — e il
               ponte verso l'altra edizione, che qui è il civile. *@
            <aside class="doc-rail" aria-label="@Sito["Doc_RailAria"]">
                <div class="rail-card">
                    <h5><Icon Name="clipboard" /> @Sito["Common_Summary"]</h5>
                    @* Il ciclo del DOCUMENTO mostrato, non quello di oggi (doc 13 §3h): in anteprima di
                       release è quello della release, e lo snapshot se lo porta dietro. *@
                    <div class="rail-line"><span class="muted">@Sito["Common_AiracCycle"]</span><b>@Cycle()</b></div>
                    <div class="rail-line"><span class="muted">@Sito["Common_AtcOnline"]</span>
                        @{ var n = OnlineAt(_icao); }
                        <span class="onl-badge @(n > 0 ? "on" : "off")"><span class="dot"></span> @(n > 0 ? $"{n}" : "off")</span>
                    </div>
                </div>
                <div class="rail-card">
                    <h5><Icon Name="link" /> @Sito["Common_Links"]</h5>
                    <ul class="rail-links">
                        <li><a href="/services/vsop">@Sito["Common_Home"]</a></li>
                        <li><a href="/services/vsop/mil">@Sito["Mil_Title"]</a></li>
                        <li><a href="/services/vsop/@Acc.ToLowerInvariant()">ACC @Acc.ToUpperInvariant()</a></li>
                        @* Stesso ponte della testata, e stesso gate: se la vIPI civile non c'è, la voce non
                           c'è. Un elenco di collegamenti utili con dentro un vicolo cieco è peggio di uno
                           più corto. *@
                        @if (MostraPonteCivile)
                        {
                            <li><a href="/services/vsop/@Acc.ToLowerInvariant()/airports?icao=@_icao">@Sito["Mil_LinkToCivil"]</a></li>
                        }
                    </ul>
                </div>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter] public string Acc { get; set; } = "";

    [SupplyParameterFromQuery(Name = "icao")] public string? Icao { get; set; }

    /// <summary>Anteprima: assente = pubblica, <c>draft</c> = bozza, <c>rel:{id}</c> = una release. Stessa
    /// grammatica degli altri quattro viewer.</summary>
    [SupplyParameterFromQuery(Name = "as")] public string? As { get; set; }

    /// <summary>La vista di lettura: «pilota», «atc», o assente per il documento intero.</summary>
    [SupplyParameterFromQuery(Name = "vista")] public string? Vista { get; set; }

    private string _icao = "";
    private bool _canEdit;

    /// <summary>L'ACC della rotta, risolto per il NOME: la briciola e il rail si accontentano del codice,
    /// il sottotitolo no. null = codice sconosciuto, e allora si scrive il codice.</summary>
    private AccInfo? _acc;

    /// <summary>Il documento caricato — vista, modalità OTTENUTA, derivate, tabelle, stato della civile.
    /// null = questo campo non ha un vSOP militare da mostrare.</summary>
    private MilMemberDocument? _doc;

    /// <summary>Gli ALTRI documenti dell'unione, se questo è l'ospite. Vuoto = documento solo.</summary>
    private IReadOnlyList<MembroUnito> _altri = Array.Empty<MembroUnito>();

    /// <summary>La riga sotto il titolo, la stessa a schermo e sul foglio: «Aeroporto militare · Milano»,
    /// come «Aeroporto · Milano» sulla vIPI civile dello stesso scalo. ⚠️ Scritta una volta sola perche' le
    /// due sedi non divergano al primo ritocco — sul foglio la testata a schermo non c'e'.</summary>
    private string Sottotitolo() => $"{Sito["Mil_SubtitlePrefix"]} · {_acc?.Name ?? Acc.ToUpperInvariant()}";

    /// <summary>L'indirizzo di questa pagina SENZA `vista`, per la chip di lettura. ⚠️ `as=draft` va
    /// conservato: filtrare dentro un'anteprima non deve buttare fuori dall'anteprima.</summary>
    private string AudienceHref() =>
        $"/services/vsop/{Acc.ToLowerInvariant()}/mil?icao={_icao}"
        + (_doc?.Mode.Kind == PreviewKind.Draft ? "&as=draft" : "");

    /// <summary>Il ciclo AIRAC MOSTRATO: quello dell'anteprima release se è una, altrimenti quello che si
    /// porta dietro lo snapshot del documento.</summary>
    private string Cycle() => _doc?.RelCycle ?? _doc?.View.AiracCycle ?? "";

    /// <summary>Quanti ATC su questo campo adesso. ⚠️ L'ATIS è escluso, come sull'aeroporto civile: è una
    /// frequenza registrata, non qualcuno che controlla.</summary>
    private int OnlineAt(string icao) => Online.GetCurrent().Callsigns.Count(cs =>
        cs.Split('_', 2)[0].Equals(icao, StringComparison.OrdinalIgnoreCase)
        && !cs.EndsWith("_ATIS", StringComparison.OrdinalIgnoreCase));

    /// <summary>Il ponte verso la vIPI civile: al pubblico solo se PUBBLICATA, allo staff anche se è solo
    /// una bozza — il civile può essere appena nato, e un collegamento che compare solo dopo la
    /// pubblicazione compare quando non serve più.</summary>
    private bool MostraPonteCivile =>
        _doc is { } d && (d.Civile.Pubblicata || (_canEdit && d.Civile.Esiste));

    /// <summary>
    /// Vero quando questo vSOP militare <b>non dovrebbe esistere da solo</b>: campo misto, e la vIPI civile
    /// non c'è. Si dice solo allo staff, perché è un lavoro da fare, non un'informazione per chi legge.
    /// <para>⚠️ Dal 29 agosto 2026 questo caso non si può più CREARE (la guardia sta in
    /// <c>EfMilitaryDocumentService.CreaAsync</c>), ma i documenti nati prima possono benissimo essere lì:
    /// una guardia nuova non ripara il passato, e tacere lascerebbe il difetto dov'è.</para>
    /// </summary>
    private bool MancaCivile =>
        _canEdit && _doc is { } d && !d.Civile.SoloMilitare && !d.Civile.Esiste;

    protected override async Task OnParametersSetAsync()
    {
        _icao = (Icao ?? "").Trim().ToUpperInvariant();
        _acc = Stations.Resolve(Acc);
        _doc = null;
        if (_icao.Length == 0) return;

        _canEdit = Authz.IsEditor;

        // Tutto il carico — anteprima, lingua, meteo, derivate, le sei tabelle, traduzione, titoli di
        // catalogo, filtro di lettura — sta nel caricatore: l'ordine di quei passi è la correttezza, e non
        // appartiene a QUESTA pagina.
        _doc = await Loader.LoadAsync(_icao, PreviewMode.Parse(As, null), Vista);
        if (_doc is null) return;

        // ---- L'unione (carta 2026-09-03) ------------------------------------------------------------
        // ⚠️ `AirportMil` e non `Airport`: le due edizioni dello stesso scalo hanno la STESSA chiave di
        // release (l'ICAO) e si distinguono per il tipo. Chiedere con l'altro tipo darebbe l'unione del
        // documento civile — che è un altro documento, e magari un'altra unione.
        var unione = await Unioni.ForTargetAsync(ReleaseTargetType.AirportMil, _icao);
        if (unione is not null && !unione.IsHostTarget(ReleaseTargetType.AirportMil, _icao))
        {
            // ⚠️ SOLO la vista pubblica reindirizza. Le anteprime e l'editor restano dove sono: chi guarda
            // la release di QUESTO documento la sta guardando apposta, e mandarlo altrove renderebbe la sua
            // anteprima irraggiungibile.
            // ⚠️ `replace: true` e nessun `@rendermode` su questa pagina: così il rimando diventa una vera
            // 302 che il browser segue prima di disegnare qualunque cosa — è il modo di ReleasePreviewPage.
            if (_doc.Mode.Kind == PreviewKind.Public
                && await Membri.IndirizzoDellOspiteAsync(unione, ReleaseTargetType.AirportMil, _icao) is { } indirizzo)
                Nav.NavigateTo(indirizzo, replace: true);
            return;
        }
        _altri = unione is null
            ? Array.Empty<MembroUnito>()
            : await Membri.AltriMembriAsync(unione, unione.Host.DocumentId, _doc.Mode, Vista, Cycle());
    }
}
