@page "/vsop/tasks"
@layout SopLayout
@rendermode InteractiveServer
@inject IEditorTaskService Tasks
@inject ICurrentUserProvider User
@inject IEditorTaskLinksService TaskLinks
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Tasks_MyTasks"] · IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1200px">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <b>@L["Tasks_MyTasks"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px"><Icon Name="clipboard" Size="22" /> @L["Tasks_MyTasks"]</h2><span class="muted">@string.Format(L["Tasks_Subtitle"], _currentCycle)</span></div>
    </div>

    @if (User.Get() is null)
    {
        <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div><p class="ct">@L["Tasks_NotAuth"]</p>@L["Tasks_NotAuthBody"]</div></div>
    }
    else
    {
        @if (_error is not null) { <div class="callout danger"><span class="cic"><Icon Name="octagon" Size="18" /></span><div>@_error</div></div> }
        @if (_status is not null) { <div class="callout success"><span class="cic">✓</span><div>@_status</div></div> }

        <div class="section-title"><h3>@L["Tasks_NewPersonal"]</h3><span class="ln"></span></div>
        <div class="block">
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                <input class="app-in" style="flex:1;min-width:220px" placeholder="@L["Tasks_TitlePlaceholder"]" @bind="_newTitle" />
                <select class="app-in" style="max-width:130px" @bind="_newPriority">
                    @foreach (var p in Enum.GetValues<EditorTaskPriority>()) { <option value="@p">@PrioLabel(p)</option> }
                </select>
                <select class="app-in" style="max-width:170px" @bind="_newDue">
                    <option value="">@L["Tasks_NoDue"]</option>
                    @foreach (var c in _upcoming) { <option value="@c.Cycle">@string.Format(L["Tasks_ByAirac"], c.Cycle)</option> }
                </select>
                <button class="btn primary" disabled="@_busy" @onclick="CreateMine">@L["Tasks_AddToMe"]</button>
            </div>
            <p class="help" style="margin:6px 0 0">@L["Tasks_FreeHint"]</p>
        </div>

        @if (_tasks is null) { <LoadingState /> }
        else if (_tasks.Count == 0) { <p class="help">@L["Tasks_NoneAssigned"]</p> }
        else
        {
            <div class="apt-2col" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px;margin-top:14px">
                @foreach (var col in Columns)
                {
                    <div>
                        <div class="section-title"><h3 style="font-size:14px">@ColLabel(col) <span class="muted">(@Count(col))</span></h3><span class="ln"></span></div>
                        @foreach (var t in _tasks.Where(t => t.Status == col))
                        {
                            @TaskCard(t)
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<EditorTask>? _tasks;
    private IReadOnlyDictionary<(ReleaseTargetType Type, string Key), EditorTaskLink> _links =
        new Dictionary<(ReleaseTargetType, string), EditorTaskLink>();
    private IReadOnlyList<AiracCycleInfo> _upcoming = Array.Empty<AiracCycleInfo>();
    private string _currentCycle = "";
    private bool _busy;
    private string? _status, _error;

    private string _newTitle = "";
    private EditorTaskPriority _newPriority = EditorTaskPriority.Normal;
    private string _newDue = "";

    private static readonly EditorTaskStatus[] Columns =
        { EditorTaskStatus.Todo, EditorTaskStatus.InProgress, EditorTaskStatus.InReview, EditorTaskStatus.Done, EditorTaskStatus.Blocked };

    protected override async Task OnInitializedAsync()
    {
        _currentCycle = Tasks.CurrentCycle();
        _upcoming = Tasks.UpcomingCycles(14);
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _tasks = await Tasks.ListMineAsync();
            // Una risoluzione per CARICAMENTO, non una per card: il read-model interroga una volta sola, e
            // se nessun incarico e' legato a un documento non interroga affatto.
            _links = await TaskLinks.ForAsync(_tasks);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    /// <summary>Dove porta il tasto del documento collegato. null = non c'e' un posto dove andare, e allora
    /// il tasto non si mostra: un'etichetta che mente costa piu' di un'etichetta assente (regola 168).</summary>
    private EditorTaskLink? Link(EditorTask t) =>
        t.TargetType is { } tipo && !string.IsNullOrWhiteSpace(t.TargetKey)
            && _links.TryGetValue((tipo, t.TargetKey!), out var l) ? l : null;

    private async Task CreateMine()
    {
        _busy = true; _status = _error = null;
        try
        {
            var me = User.Get()!;
            var input = new EditorTaskInput(_newTitle, null, me.UserId, me.Name,
                _newPriority, string.IsNullOrWhiteSpace(_newDue) ? null : _newDue, null, null, null);
            await Tasks.CreateAsync(input);
            _newTitle = ""; _newDue = "";
            await Load();
            _status = L["Tasks_AddedMsg"];
        }
        catch (Vipi.Application.Aor.ValidationException ex) { _error = ServiceErrorNarrator.Testo(ex, L); }
        catch (EditNotAllowedException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetStatus(int id, EditorTaskStatus status)
    {
        _busy = true; _status = _error = null;
        try { await Tasks.UpdateStatusAsync(id, status); await Load(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Delete(int id)
    {
        _busy = true; _status = _error = null;
        try { await Tasks.DeleteAsync(id); await Load(); _status = L["AdminTasks_DeletedMsg"]; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private int Count(EditorTaskStatus s) => _tasks?.Count(t => t.Status == s) ?? 0;

    private RenderFragment TaskCard(EditorTask t) => __builder =>
    {
        var overdue = Tasks.IsOverdue(t);
        <div class="block" style="margin-bottom:8px;@(overdue ? "border-color:var(--ivao-red)" : "")">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
                <span class="pill @PrioPill(t.Priority)">@PrioLabel(t.Priority)</span>
                @if (t.DueAiracCycle is not null) { <span class="pill @(overdue ? "future" : "grey")" title="@L["Tasks_DueAiracTitle"]">@(overdue ? L["Tasks_Late"].Value + " " : "")AIRAC @t.DueAiracCycle</span> }
            </div>
            <b>@t.Title</b>
            @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="muted" style="font-size:12px;margin-top:2px">@t.Description</div> }
            @if (t.TargetKey is not null)
            {
                var link = Link(t);
                @if (link?.Url is { } url)
                {
                    <div style="margin-top:4px"><a class="btn ghost" href="@url" title="@link.TitoloCorrente">@L["Tasks_OpenDoc"]</a></div>
                }
                @if (!string.IsNullOrWhiteSpace(t.TargetLabel)) { <div class="muted" style="font-size:11px;margin-top:2px">@t.TargetLabel</div> }
                @* Il documento non c'e' piu' (o non e' raggiungibile): si dice, invece di offrire un tasto
                   che porta altrove. L'etichetta resta quella scritta nell'incarico. *@
                @if (link?.Url is null) { <div class="muted" style="font-size:11px">@L["Tasks_DocGone"]</div> }
            }
            <div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px">
                @foreach (var s in Columns.Where(s => s != t.Status))
                {
                    <button class="btn ghost" style="font-size:11px;padding:2px 8px" disabled="@_busy" @onclick="() => SetStatus(t.Id, s)">→ @ColLabel(s)</button>
                }
                @if (t.CreatedByUserId == (User.Get()?.UserId ?? -1))
                {
                    <button class="btn ghost" style="font-size:11px;padding:2px 8px" disabled="@_busy" @onclick="() => Delete(t.Id)" title="@L["Common_Remove"]" aria-label="@L["AdminTasks_DeleteTask"]"><Icon Name="trash" /></button>
                }
            </div>
        </div>
    };

    private string ColLabel(EditorTaskStatus s) => s switch
    {
        EditorTaskStatus.Todo => L["TaskStatus_Todo"],
        EditorTaskStatus.InProgress => L["TaskStatus_InProgress"],
        EditorTaskStatus.InReview => L["TaskStatus_InReview"],
        EditorTaskStatus.Done => L["TaskStatus_Done"],
        EditorTaskStatus.Blocked => L["TaskStatus_Blocked"],
        _ => s.ToString(),
    };

    private string PrioLabel(EditorTaskPriority p) => p switch
    {
        EditorTaskPriority.Low => L["TaskPrio_Low"], EditorTaskPriority.Normal => L["TaskPrio_Normal"], EditorTaskPriority.High => L["TaskPrio_High"], _ => p.ToString(),
    };

    private static string PrioPill(EditorTaskPriority p) => p switch
    {
        EditorTaskPriority.High => "future", EditorTaskPriority.Normal => "blue", _ => "grey",
    };
}
