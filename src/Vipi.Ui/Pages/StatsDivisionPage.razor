@page "/services/stats/division"
@layout SopLayout
@rendermode InteractiveServer
@* Pagina pubblica: un circuito caduto non si annuncia, se si rimette da solo (vipi-riconnessione.js). *@
@attribute [RiconnessioneDiscreta]
@inherits ScopeProprioCheAspetta
@using Microsoft.Extensions.DependencyInjection
@using Vipi.Application.Abstractions
@using Vipi.Application.Auth
@using Vipi.Application.Stats

@* ⚠️ SCOPE PROPRIO (OwningComponentBase) e sentinella di rientro, per la stessa ragione delle altre
   pagine che ce l'hanno: questa è interattiva, quindi il suo `DbContext` è quello del CIRCUITO e vive per
   ore. Un gesto che parte mentre il precedente è ancora in volo trova il contesto occupato e la pagina muore
   con «A second operation was started on this context instance» — è la sequenza che il 24 agosto 2026 ha
   ucciso sette volte una pagina di questo sito.

   Le porte servono a tre cose diverse: lo scope proprio protegge dagli ALTRI, la sentinella da SÉ STESSI.
   Qui servono tutte e due, perché la casella della classifica scrive e poi rilegge tutto mentre una chip di
   periodo può già aver fatto ripartire lo stesso caricamento (revisione del 6 settembre 2026, R-016).

   🔴 E non bastavano: nessuna delle due protegge dal TEMPO. Con tutt'e due in linea, questa pagina è caduta
   in produzione l'8 settembre 2026 alle 20:26:02 — `ObjectDisposedException` in
   `EfAtcStatsQueries.ByPositionAsync` — perché lo scope si chiude con la query ancora aperta quando l'utente
   se ne va. La terza porta è `ScopeProprioCheAspetta`: chiude e ASPETTA chi era dentro. Vedi §CF.

   Restano fuori dallo scope proprio le cose che il database non lo toccano: localizzazione e identità. *@
@inject ICurrentUserProvider Utenti
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

@* La divisione: copertura e classifica. Interattiva perché lo staff accende e spegne la classifica pubblica
   da qui — il resto sarebbe stato SSR statico. *@

<PageTitle>@L["Stats_DivisionTitle"] · vIPI IVAO Italy</PageTitle>

@* ---- La veste del 30 settembre 2026 ------------------------------------------------------------------------
   Tavola approvata dal committente (carta docs/feature/2026-09-30-statistiche-nuova-grafica.md), stesso stile
   della pagina personale: cinque numeri col loro contesto, gli aeroporti subito sotto per lo staff, due grafici
   affiancati, la copertura, la classifica coi nomi di chi è entrato nel sito, le postazioni, gli strumenti. *@

<div class="wrap stats">
    <div class="sx-top">
        <div class="doc-head">
            @* Il tasto gemello di quello sulla pagina personale: si va e si torna dalla riga del titolo. *@
            <div class="sh-title">
                <h1 class="page-h1">@L["Stats_DivisionTitle"]</h1>
                <a class="btn ghost sh-go" href="/services/stats">
                    <Icon Name="activity" Size="15" /> @L["Stats_BackToMine"]
                </a>
            </div>
            <p class="muted">@L["Stats_DivisionSubtitle"]</p>
        </div>
        @if (_puoVedere)
        {
            <StatsChipBar Voci="_periodi" Titolo="@L["Stats_Period"].Value" />
        }
    </div>

    @if (!_puoVedere)
    {
        @* Default spento: finché lo staff non decide, le ore degli altri non si mostrano a nessuno. *@
        <p class="muted">@L["Stats_LeaderboardOff"]</p>
    }
    else
    {
        <div class="kpi-grid">
            <StatsKpi Valore="@StatsView.Ore(_totali?.Seconds ?? 0)" Unita="h" Etichetta="@L["Stats_Hours"].Value"
                      Nota="@L["Stats_PerController", _mediaOre].Value" />
            <StatsKpi Valore="@((_totali?.Shifts ?? 0).ToString())" Etichetta="@L["Stats_Shifts"].Value"
                      Nota="@L["Stats_PerController", _mediaTurni].Value" />
            <StatsKpi Valore="@((_totali?.Movements ?? 0).ToString())" Etichetta="@L["Stats_Movements"].Value"
                      Nota="@L["Stats_PerController", _mediaMovimenti].Value" />
            <StatsKpi Valore="@_controllori.ToString()" Etichetta="@L["Stats_Controllers"].Value"
                      Nota="@L["Stats_ControllersHint"].Value" />
            <StatsKpi Valore="@_durataMedia" Etichetta="@L["Stats_AvgShift"].Value"
                      Nota="@L["Stats_AllPositionsHint"].Value" />
        </div>

        @* ⚠️ Guardia PROPRIA, e non basta essere dentro il ramo «_puoVedere»: questa pagina la aprono anche i
           soci quando la classifica è pubblica, e il traffico coperto/scoperto di ogni scalo è uno strumento
           di pianificazione dello staff — deciso dal committente il 25 agosto 2026.

           ⚠️ Sta QUI, subito sotto i numeri, e non in fondo: è la domanda per cui uno staffista apre questa
           pagina, e in coda alla classifica da cinquanta righe non la trovava nessuno (chiesto dal committente,
           confermato nella veste del 30 settembre 2026). *@
        @if (Authz.IsDivisionStaff)
        {
            <section class="sx-card sx-block">
                <div class="sx-head">
                    <h2 class="sx-h">@L["Stats_Airports"]</h2>
                    @if (_aeroporti is not null && _aeroporti.DaysCovered > 0 && _aeroporti.DaysCovered < _aeroporti.DaysAsked)
                    {
                        @* ⚠️ Un periodo non ancora recuperato NON è «zero traffico»: senza questo avviso i numeri
                           bassi dei primi giorni sembrerebbero un dato, e sono un lavoro a metà. *@
                        <span class="sx-tag gold">@L["Stats_AirportsPartial", _aeroporti.DaysCovered, _aeroporti.DaysAsked]</span>
                    }
                </div>
                <p class="muted">@L["Stats_AirportsHint"]</p>

                <StatsChipBar Voci="_gruppi" Titolo="@L["Stats_AirportsGroup"].Value" />

                @if (_aeroporti is null || _aeroporti.DaysCovered == 0)
                {
                    @* Vuoto per un motivo, non per un buco: il consolidamento non ha ancora girato. *@
                    <p class="muted">@L["Stats_AirportsEmpty"]</p>
                }
                else
                {
                    <table class="res-table tbl-cards sx-air">
                        <thead>
                            <tr>
                                <th>@L["Stats_Airport"]</th>
                                <th>@L["Stats_AirportMovements"]</th>
                                <th>@L["Stats_AirportCovered"]</th>
                                <th class="num">@L["Stats_AirportOpenHours"]</th>
                                <th class="num">@L["Stats_AirportOpenShare"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _tuttiAeroporti ? _aeroporti.Rows : _aeroporti.Rows.Take(10))
                            {
                                <tr title="@L["Stats_AirportRowTitle", r.Icao, r.Movements, r.Covered, StatsView.Ore(r.AtcMinutes * 60L)]">
                                    <td data-l="@L["Stats_Airport"]"><b class="icao">@r.Icao</b> <span class="muted">@r.Name</span></td>
                                    <td data-l="@L["Stats_AirportMovements"]">
                                        <span class="sx-cell">
                                            <span class="sx-bar"><i style="width:@StatsView.Quota(r.Movements, _maxMovimentiAeroporto)"></i></span>
                                            @r.Movements
                                        </span>
                                    </td>
                                    @* La barra dice la QUOTA coperta, non il numero: fra due campi da mille e da
                                       dieci movimenti la domanda è quale dei due è più scoperto. *@
                                    <td data-l="@L["Stats_AirportCovered"]">
                                        <span class="sx-cell">
                                            <span class="sx-bar"><i class="p-app" style="width:@(r.CoveredPercent is { } q ? q + "%" : "0%")"></i></span>
                                            @if (r.CoveredPercent is { } p2) { <text>@r.Covered · @p2%</text> }
                                            else { <text>—</text> }
                                        </span>
                                    </td>
                                    <td class="num" data-l="@L["Stats_AirportOpenHours"]">@StatsView.Ore(r.AtcMinutes * 60L)</td>
                                    <td class="num muted" data-l="@L["Stats_AirportOpenShare"]">
                                        @(r.OpenPercent is { } o ? o + "%" : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            @* ⚠️ Celle `td` con `data-l` anche qui: sul piccolo la tabella diventa una pila di
                               schede, e una riga di totali fatta di `th` nudi resterebbe senza etichette. *@
                            <tr class="tot">
                                <td data-l="">@L["Stats_AirportsTotal"]</td>
                                <td data-l="@L["Stats_AirportMovements"]">@_aeroporti.Movements</td>
                                <td data-l="@L["Stats_AirportCovered"]">@_aeroporti.Covered@(_quotaTotale is { } t ? $" · {t}%" : "")</td>
                                <td class="num" data-l="@L["Stats_AirportOpenHours"]">@StatsView.Ore(_aeroporti.AtcMinutes * 60L)</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="sx-foot">
                        @if (_aeroporti.Rows.Count > 10)
                        {
                            <button type="button" class="btn ghost" @onclick="() => _tuttiAeroporti = !_tuttiAeroporti">
                                @(_tuttiAeroporti ? L["Stats_ShowFirst", 10] : L["Stats_ShowAllAirports", _aeroporti.Rows.Count])
                            </button>
                        }
                        @* ⚠️ La misura si dichiara, non si lascia intuire: «con ATC» è un'approssimazione
                           dichiarata, e senza questa riga un numero preciso sembrerebbe un registro. *@
                        <p class="muted">@L["Stats_AirportsMeasure"]</p>
                    </div>
                }
            </section>
        }

        <div class="sx-row">
            <section class="sx-card">
                <div class="sx-head">
                    <h2 class="sx-h">@L["Stats_MonthChart"]</h2>
                    <span class="muted">@L["Stats_MonthHover"]</span>
                </div>
                <StatsBars Barre="_barreMesi" Titolo="@L["Stats_MonthChart"].Value" />
            </section>
            <section class="sx-card">
                <h2 class="sx-h">@L["Stats_PositionShareDivision"]</h2>
                @* Una barra sola al posto della ciambella, sul tempo di TUTTE le postazioni. *@
                <div class="sx-split" role="img" aria-label="@L["Stats_PositionShareDivision"]">
                    @foreach (var f in _fette)
                    {
                        <i class="@f.CssClass" style="width:@StatsView.Quota(f.Value, _totaleFette)" title="@f.Title"></i>
                    }
                </div>
                <ul class="sx-list">
                    @foreach (var t in _tipi)
                    {
                        <li class="sx-type">
                            <i class="@t.Classe"></i>
                            <b>@t.Tipo</b>
                            <span class="muted">@L["Stats_SessionsN", t.Sessioni]</span>
                            <span class="v">@StatsView.Ore(t.Secondi) h</span>
                            <span class="muted">@Percento(t.Secondi, _totaleFette)</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <section class="sx-card sx-block">
            <h2 class="sx-h">@L["Stats_Coverage"]</h2>
            <p class="muted">@L["Stats_CoverageHint"]</p>
            <CoverageHeatmap Celle="_griglia" Copertura="true" Titolo="@L["Stats_Coverage"].Value" />
            <div class="cov-legend">
                <span>@L["Stats_CovLegend"]</span>
                <span>@L["Stats_CovNone"]</span>
                <i class="cov-q0"></i><i class="cov-q1"></i><i class="cov-q2"></i><i class="cov-q3"></i><i class="cov-q4"></i>
                <span>@L["Stats_CovFull"]</span>
            </div>
        </section>

        <section class="sx-card sx-block">
            <div class="sx-head">
                <h2 class="sx-h">@L["Stats_TopControllers"]</h2>
                @* ⚠️ Solo allo staff, perché solo lo staff può APRIRE quel che questo campo trova: mostrarlo a
                   tutti vorrebbe dire offrire una porta che si chiude in faccia. Non è comunque una guardia — la
                   guardia sta nella pagina di destinazione, insieme alla riga di audit — è il modo di arrivarci
                   senza scorrere una classifica di cinquanta righe cercando un numero. *@
                @if (Authz.IsDivisionStaff)
                {
                    <div class="vid-find">
                        <CampoTesto type="search" inputmode="numeric" list="vid-noti"
                               placeholder="@L["Stats_FindVidPlaceholder"]" aria-label="@L["Stats_FindVid"]"
                               Valore="@_cercato" OnInput="ScriveIlVid" OnKeyDown="TastoNelCampo" />
                        @* I nomi li sa il roster, che raccoglie chi ha fatto login da NOI: è un aiuto per gli
                           staffisti, non un elenco di controllori — degli altri abbiamo il solo VID. *@
                        <datalist id="vid-noti">
                            @foreach (var v in _noti)
                            {
                                <option value="@v.Key">@v.Value</option>
                            }
                        </datalist>
                        <button class="btn primary" disabled="@(_vidValido is null)" @onclick="ApriIlProfilo">
                            <Icon Name="search" Size="15" /> @L["Stats_FindVidGo"]
                        </button>
                    </div>
                }
            </div>
            @if (Authz.IsDivisionStaff)
            {
                <p class="muted">
                    @(_cercato.Length > 0 && _vidValido is null ? L["Stats_FindVidBad"] : L["Stats_FindVidHint"])
                </p>
            }

            @if (_classifica.Count > 0)
            {
                <div class="podium">
                    @for (var i = 0; i < Math.Min(3, _classifica.Count); i++)
                    {
                        var c = _classifica[i];
                        <div class="pod p@(i + 1)">
                            <span class="pos">@(i + 1)</span>
                            <div>
                                <div class="who">@Controllore(c.UserId)</div>
                                <div class="what">@StatsView.Ore(c.Seconds) h · @c.Shifts @L["Stats_Shifts"]</div>
                            </div>
                        </div>
                    }
                </div>

                <table class="res-table tbl-cards">
                    <thead>
                        <tr>
                            <th>#</th><th>@L["Stats_Controller"]</th><th>@L["Stats_Hours"]</th>
                            <th>@L["Stats_Shifts"]</th><th>@L["Stats_Movements"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _classifica.Count; i++)
                        {
                            var c = _classifica[i];
                            var mia = c.UserId == _io;
                            var staccata = !_tuttaClassifica && i >= 10;
                            @* I primi dieci; la propria riga si trova senza cercarla anche quando è la
                               ventiseiesima: in coda, dopo i puntini. *@
                            if (staccata && !mia) continue;
                            <tr class="@(mia ? "rank-me" : "")">
                                <td data-l="#">@(staccata ? "…" : "")@(i + 1)</td>
                                <td data-l="@L["Stats_Controller"]">@Controllore(c.UserId)</td>
                                <td class="cb" data-l="@L["Stats_Hours"]"
                                    style="--cb:@StatsView.Quota(c.Seconds, _maxOre)">@StatsView.Ore(c.Seconds)</td>
                                <td data-l="@L["Stats_Shifts"]">@c.Shifts</td>
                                <td data-l="@L["Stats_Movements"]">@c.Movements</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="sx-foot">
                @if (_classifica.Count > 10)
                {
                    <button type="button" class="btn ghost" @onclick="() => _tuttaClassifica = !_tuttaClassifica">
                        @L["Stats_ShowFirst", _tuttaClassifica ? 10 : _classifica.Count]
                    </button>
                }
                <p class="muted">
                    @if (_rango.Position > 0)
                    {
                        <text>@L["Stats_YouAre", _rango.Position, _rango.Total]@(" ")</text>
                    }
                    @L["Stats_NamesHint"]
                </p>
            </div>
        </section>

        <section class="sx-card sx-block">
            <h2 class="sx-h">@L["Stats_ByPosition"]</h2>
            <ul class="sx-list sx-cols">
                @foreach (var r in _tuttePostazioniVisibili ? _perPostazione : _perPostazione.Take(10))
                {
                    <li class="sx-hr">
                        <span class="k">@r.Key</span>
                        <span class="sx-bar"><i class="@StatsView.PosClass(r.Key)" style="width:@StatsView.Quota(r.Seconds, _maxOrePostazione)"></i></span>
                        <span class="v">@StatsView.Ore(r.Seconds) h</span>
                        <span class="d">@L["Stats_PositionDetail", r.Sessions, r.Movements]</span>
                    </li>
                }
            </ul>
            @if (_perPostazione.Count > 10)
            {
                <div>
                    <button type="button" class="btn ghost" @onclick="() => _tuttePostazioniVisibili = !_tuttePostazioniVisibili">
                        @(_tuttePostazioniVisibili ? L["Stats_ShowFirst", 10] : L["Stats_AllPositions", _perPostazione.Count])
                    </button>
                </div>
            }
        </section>
    }

    @if (Authz.IsDivisionStaff)
    {
        <h2 class="sx-sub sx-tools-h">@L["Stats_StaffTools"]</h2>
        <div class="sx-tools">
            @* L'ingresso all'archivio grezzo: senza un link da qualche parte, la pagina esisterebbe solo per
               chi ne conosce l'indirizzo. Sta accanto agli altri strumenti di staff, non nel menu pubblico. *@
            <a class="sx-card sx-tool" href="/services/stats/world">
                <b><Icon Name="search" Size="15" /> @L["World_Title"]</b>
                <span class="muted">@L["World_Subtitle"]</span>
            </a>

            @* Chi è entrato nel sito: solo agli amministratori (30 settembre 2026), sono dati personali. *@
            @if (Authz.IsAdmin)
            {
                <a class="sx-card sx-tool" href="/services/stats/logins">
                    <b><Icon Name="log-in" Size="15" /> @L["Logins_Title"]</b>
                    <span class="muted">@L["Logins_Subtitle"]</span>
                </a>
            }

            <div class="sx-card sx-tool" role="group" aria-label="@L["Stats_Visibility"]">
                <label class="inline-form">
                    <input type="checkbox" checked="@_pubblica" @onchange="CambiaVisibilita" />
                    <b>@L["Stats_PublicLeaderboard"]</b>
                </label>
                <span class="muted">
                    @L["Stats_PublicLeaderboardHint"]
                    @if (_deciso is { } quando)
                    {
                        <text> · @L["Stats_DecidedBy", _decisoDa, quando.ToString("yyyy-MM-dd HH:mm")]Z</text>
                    }
                </span>
            </div>
        </div>
    }

    <p class="muted" style="margin-top:22px">@L["Stats_Disclaimer"]</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "p")] public string? P { get; set; }

    /// <summary>Gruppo di aeroporti scelto dall'indirizzo (<c>?g=LIRR</c>). Vuoto = tutti.</summary>
    [SupplyParameterFromQuery(Name = "g")] public string? G { get; set; }

    private StatsTotals? _totali;
    private IReadOnlyList<ControllerRanking> _classifica = Array.Empty<ControllerRanking>();
    private IReadOnlyList<StatsByKey> _perPostazione = Array.Empty<StatsByKey>();
    private IReadOnlyList<StatsByKey> _tuttePostazioni = Array.Empty<StatsByKey>();
    private IReadOnlyList<CoverageCell> _griglia = Array.Empty<CoverageCell>();
    private IReadOnlyList<StatsChipBar.Voce> _periodi = Array.Empty<StatsChipBar.Voce>();
    private IReadOnlyList<StatsChipBar.Voce> _gruppi = Array.Empty<StatsChipBar.Voce>();
    private AirportCoverageSummary? _aeroporti;
    private int? _quotaTotale;
    private IReadOnlyList<StatsSlice> _fette = Array.Empty<StatsSlice>();
    private IReadOnlyList<StatsBar> _barreMesi = Array.Empty<StatsBar>();
    private bool _pubblica;
    private bool _puoVedere;
    private DateTime? _deciso;
    private int _decisoDa;
    private int? _io;
    private double _maxOre, _maxOrePostazione, _maxMovimentiAeroporto, _totaleFette;
    private int _controllori;

    /// <summary>La propria posizione: la riga evidenziata e la frase sotto la classifica.</summary>
    private StatsRank _rango = new(0, 0);

    /// <summary>Il contesto dei numeri: quanto fa, in media, ogni controllore con almeno un turno.</summary>
    private string _mediaOre = "", _mediaTurni = "", _mediaMovimenti = "", _durataMedia = "—";

    /// <summary>Tipo di postazione, sessioni e ore: la lista sotto la barra divisa.</summary>
    private sealed record TipoPostazione(string Tipo, string Classe, int Sessioni, long Secondi);
    private IReadOnlyList<TipoPostazione> _tipi = Array.Empty<TipoPostazione>();

    /// <summary>
    /// «Mario R.» per chi è entrato nel sito almeno una volta (registro degli accessi), per il VID della
    /// classifica. Decisione del committente del 30 settembre 2026: nome e iniziale del cognome, accanto al VID,
    /// a chiunque veda la classifica — IVAO lo consente, l'informativa lo dice. Chi non è mai entrato resta un VID.
    /// </summary>
    private IReadOnlyDictionary<int, string> _nomi = new Dictionary<int, string>();

    // Quanto si vede: i primi dieci, il resto a richiesta. Interattiva, quindi basta un campo.
    private bool _tuttaClassifica, _tuttiAeroporti, _tuttePostazioniVisibili;

    /// <summary>Periodo e gruppo dell'ultimo caricamento: senza, ogni render rifarebbe tutte le query.</summary>
    private string? _caricato;

    /// <summary>È già in corso un giro di letture? ⚠️ Si alza <b>prima</b> del primo <c>await</c>: alzarla
    /// dopo vorrebbe dire non alzarla affatto, perché è lì che il gesto successivo entra.</summary>
    private bool _inCorso;

    // I servizi che interrogano il database: presi dallo SCOPE DI QUESTA PAGINA, non da quello del circuito.
    // Vedi il commento in testa al file.
    private IAtcStatsQueries Stats = default!;
    private IStatsSettingsStore Impostazioni = default!;
    private IEditAuthorizationService Authz = default!;
    private IStaffRosterRepository Roster = default!;
    private IAirportCoverageQueries Aeroporti = default!;
    private IRegistroAccessi Accessi = default!;

    protected override void OnInitialized()
    {
        Stats = ScopedServices.GetRequiredService<IAtcStatsQueries>();
        Impostazioni = ScopedServices.GetRequiredService<IStatsSettingsStore>();
        Authz = ScopedServices.GetRequiredService<IEditAuthorizationService>();
        Roster = ScopedServices.GetRequiredService<IStaffRosterRepository>();
        Aeroporti = ScopedServices.GetRequiredService<IAirportCoverageQueries>();
        Accessi = ScopedServices.GetRequiredService<IRegistroAccessi>();
    }

    /// <summary>
    /// ⚠️ <c>OnParametersSetAsync</c> e <b>non</b> <c>OnInitializedAsync</c>, ed è la differenza fra chip che
    /// funzionano e chip che non fanno niente.
    ///
    /// <para>Questa pagina è l'unica delle tre <b>interattiva</b> (l'interruttore della classifica sta qui),
    /// e su un componente interattivo l'inizializzazione gira <b>una volta sola</b>. Le chip sono link che
    /// cambiano la sola stringa di query: l'indirizzo cambiava, la chip si accendeva nell'HTML nuovo… e i
    /// numeri restavano quelli di prima, perché nessuno li andava a rileggere. Sulle altre due pagine non
    /// succede — sono SSR statiche e ogni navigazione le ricostruisce da capo.</para>
    ///
    /// <para>⚠️ La chiave si segna <b>prima</b> di leggere, non dopo: durante l'<c>await</c> possono arrivare
    /// altri render, e segnarla dopo vorrebbe dire fare le stesse query due volte.</para>
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var chiave = $"{P}|{G}";
        if (_caricato == chiave) return;

        _caricato = chiave;
        await CaricaAsync();
    }

    /// <summary>
    /// La porta del caricamento, con la <b>sentinella di rientro</b>.
    ///
    /// <para>⚠️ Sta qui e non nei chiamanti perché i chiamanti sono due — i parametri della pagina e la
    /// casella della classifica — e la porta è una sola. E si alza <b>prima</b> di chiamare: alzarla dopo il
    /// primo <c>await</c> vorrebbe dire non alzarla, perché è esattamente lì che entra il gesto successivo.</para>
    /// </summary>
    private async Task CaricaAsync()
    {
        if (_inCorso) return;
        _inCorso = true;
        // ⚠️ `InFilaAsync` non è la sentinella qui sopra e non la sostituisce: quella decide CHI entra,
        // questa fa sapere alla chiusura che c'è qualcuno dentro da aspettare. Vedi ScopeProprioCheAspetta.
        try { await InFilaAsync(LeggiAsync); }
        finally { _inCorso = false; }
    }

    private async Task LeggiAsync()
    {
        var impostazioni = await Impostazioni.GetAsync();
        _pubblica = impostazioni.PublicLeaderboard;
        _deciso = impostazioni.UpdatedUtc;
        _decisoDa = impostazioni.UpdatedByUserId;
        _io = Utenti.Get()?.UserId;

        // Lo staff vede sempre; gli altri solo se la classifica è stata resa pubblica.
        _puoVedere = Authz.IsDivisionStaff || (_pubblica && Utenti.Get() is not null);
        if (!_puoVedere) return;

        var periodo = StatsView.Period(P);
        // Le due file di chip si tengono a vicenda: cambiare il periodo non deve far perdere il gruppo
        // scelto, e viceversa. Sono link, e la pagina resta leggibile dall'indirizzo.
        var gruppo = string.IsNullOrWhiteSpace(G) ? null : G.Trim().ToUpperInvariant();
        _periodi = StatsView.Periods
            .Select(p => new StatsChipBar.Voce(
                L[p.LabelKey], Indirizzo(p.Key, gruppo), p.Key == periodo.Key))
            .ToList();

        var a = DateTimeOffset.UtcNow;
        var da = a.AddDays(-periodo.Days);

        _totali = await Stats.TotalsAsync(null, da, a);
        _classifica = await Stats.TopControllersAsync(da, a, limit: 50);
        // Venti righe in tabella, ma la ciambella sul totale vero (vedi la stessa nota in StatsHome).
        _tuttePostazioni = await Stats.ByPositionAsync(null, da, a, limit: 500);
        _perPostazione = _tuttePostazioni.Take(20).ToList();

        // Quanti controllori hanno almeno un turno: la classifica è tagliata ai primi cinquanta e non lo sa.
        _rango = await Stats.RankAsync(_io ?? 0, da, a);
        _controllori = _rango.Total;
        var perTesta = Math.Max(1, _controllori);
        _mediaOre = StatsView.Ore(_totali!.Seconds / perTesta);
        _mediaTurni = Math.Round(_totali!.Shifts / (double)perTesta).ToString("0");
        _mediaMovimenti = (_totali!.Movements / (double)perTesta).ToString("0.#");
        _durataMedia = _totali!.Shifts > 0 ? StatsView.Durata((int)(_totali.Seconds / _totali.Shifts)) : "—";
        _griglia = await Stats.CoverageAsync(null, da, a);

        var perMese = await Stats.ByMonthAsync(null, da, a);
        _barreMesi = perMese
            .Select(m => new StatsBar(
                StatsView.Mese(m.Key), m.Seconds / 3600.0,
                L["Stats_MonthTitle", m.Key, StatsView.Ore(m.Seconds), m.Sessions, m.Movements]))
            .ToList();

        _fette = _tuttePostazioni
            .GroupBy(p => StatsView.Tipo(p.Key))
            .Select(g => new StatsSlice(
                g.Key, g.Sum(x => x.Seconds), StatsView.PosClass(g.Key),
                L["Stats_SliceTitle", g.Key, StatsView.Ore(g.Sum(x => x.Seconds)), g.Sum(x => x.Sessions)]))
            .OrderByDescending(f => f.Value)
            .ToList();
        _totaleFette = _fette.Sum(f => f.Value);
        _tipi = _tuttePostazioni
            .GroupBy(p => StatsView.Tipo(p.Key))
            .Select(g => new TipoPostazione(g.Key, StatsView.PosClass(g.Key), g.Sum(x => x.Sessions), g.Sum(x => x.Seconds)))
            .OrderByDescending(x => x.Secondi)
            .ToList();

        // I nomi per i suggerimenti: solo di chi è in classifica, e solo di chi il roster conosce.
        _noti = await Roster.GetDisplayNamesAsync(_classifica.Select(c => c.UserId).ToList());
        _nomi = await Accessi.NomiBreviAsync(_classifica.Select(c => c.UserId).ToList());

        _maxOre = _classifica.Count == 0 ? 0 : _classifica.Max(c => c.Seconds);
        _maxOrePostazione = _perPostazione.Count == 0 ? 0 : _perPostazione.Max(r => r.Seconds);

        // ⚠️ Il traffico dei campi si legge SOLO per lo staff, e la guardia sta qui — prima della query —
        // non davanti al markup: una guardia messa dopo nasconde i numeri a schermo e li ha comunque già
        // tirati fuori dal database. È la stessa regola della pagina personale di un altro.
        if (!Authz.IsDivisionStaff) return;

        var elenco = await Aeroporti.GroupsAsync();
        _gruppi = new[] { new StatsChipBar.Voce(L["Stats_AirportsAll"], Indirizzo(periodo.Key, null), gruppo is null) }
            .Concat(elenco.Select(x => new StatsChipBar.Voce(
                $"{x.Code} ({x.Airports})", Indirizzo(periodo.Key, x.Code), x.Code == gruppo)))
            .ToList();

        _aeroporti = await Aeroporti.ByAirportAsync(da, a, gruppo);
        _maxMovimentiAeroporto = _aeroporti.Rows.Count == 0 ? 0 : _aeroporti.Rows.Max(r => r.Movements);
        _quotaTotale = _aeroporti.Movements <= 0
            ? null
            : (int)Math.Round(_aeroporti.Covered * 100.0 / _aeroporti.Movements);
    }

    private static string Percento(double v, double tot) =>
        tot <= 0 ? "0%" : Math.Round(v / tot * 100).ToString("0") + "%";

    /// <summary>
    /// Chi è, in classifica e sul podio: il nome breve sopra e il VID sotto, o il solo VID. Allo staff il VID porta
    /// in DUE posti: il numero al profilo IVAO (come ovunque nell'app), la lente alle statistiche personali qui dentro.
    /// </summary>
    private RenderFragment Controllore(int vid) => @<span class="sx-who-c">
        @if (_nomi.TryGetValue(vid, out var nome))
        {
            <b>@nome</b>
        }
        <span class="sx-vid">
            <VidLink Vid="vid" SoloNumero="true" />
            @if (Authz.IsDivisionStaff) { <StatsPeekLink Vid="vid" /> }
        </span>
    </span>;

    /// <summary>L'indirizzo della pagina con periodo e gruppo insieme: le chip non si cancellano a vicenda.</summary>
    private static string Indirizzo(string periodo, string? gruppo) =>
        gruppo is null
            ? $"/services/stats/division?p={periodo}"
            : $"/services/stats/division?p={periodo}&g={gruppo}";

    /// <summary>Quel che è stato scritto nel campo, com'è stato scritto.</summary>
    private string _cercato = "";

    /// <summary>Il VID che si ricava da quel che è stato scritto; <c>null</c> = niente di riconoscibile.</summary>
    private int? _vidValido;

    /// <summary>I VID di cui sappiamo anche il nome (roster degli staffisti), per i suggerimenti.</summary>
    private IReadOnlyDictionary<int, string> _noti = new Dictionary<int, string>();

    private void ScriveIlVid(ChangeEventArgs e)
    {
        _cercato = e.Value?.ToString() ?? "";
        _vidValido = VidInput.Parse(_cercato);
    }

    // Cercare un numero e dover poi prendere il mouse è il modo di far scrivere il VID due volte.
    private void TastoNelCampo(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApriIlProfilo();
    }

    private void ApriIlProfilo()
    {
        if (_vidValido is not { } vid) return;
        Nav.NavigateTo($"/services/stats/user/{vid}");
    }

    private async Task CambiaVisibilita(ChangeEventArgs e)
    {
        if (!Authz.IsDivisionStaff) return;                       // la guardia sta anche qui, non solo nel markup

        var acceso = e.Value is true;
        await Impostazioni.SaveAsync(acceso, Utenti.Get()?.UserId ?? 0);
        await CaricaAsync();
    }
}
