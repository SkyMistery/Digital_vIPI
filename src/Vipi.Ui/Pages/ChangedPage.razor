@page "/vsop/changed"
@layout SopLayout
@rendermode InteractiveServer
@inject IChangesService Changes
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Changed_Title"] · vIPI IVAO Italia</PageTitle>

<div class="wrap" style="max-width:1100px">
    <div class="breadcrumb"><a href="/vsop">@L["Common_Home"]</a> › <b>@L["Changed_Title"]</b></div>
    <div class="doc-head">
        <div><h2 style="margin-bottom:2px">@L["Changed_Title"]</h2><span class="muted">@L["Changed_Subtitle"]</span></div>
        <span class="airac"><Icon Name="calendar" /> AIRAC @Changes.CurrentCycle</span>
    </div>

    <div class="apt-quick" style="margin:6px 0 20px">
        <span class="ch @(_acc is null ? "on" : "")" style="cursor:pointer" @onclick="() => SetAcc(null)">@L["Common_All"]</span>
        @foreach (var f in _accs)
        {
            <span class="ch @(_acc == f ? "on" : "")" style="cursor:pointer" @onclick="() => SetAcc(f)">@f</span>
        }
    </div>

    @if (_rows is null)
    {
        <LoadingState />
    }
    else if (Filtered.Count == 0)
    {
        <div class="callout info"><span class="cic"><Icon Name="check-circle" Size="18" /></span><div><p class="ct">@L["Changed_NoChanges"]</p>@L["Changed_NoChangesBody", Changes.CurrentCycle]@AccSuffix()</div></div>
    }
    else
    {
        <div class="chg">
            @foreach (var r in Filtered)
            {
                <div class="chg-row">
                    <span class="chg-tag @(r.IsNew ? "add" : "mod")">@(r.IsNew ? L["Changed_New"] : L["Changed_Updated"])</span>
                    <div style="flex:1">
                        @* v@(...) con parentesi: «v@r.…» sarebbe letto da Razor come email ed emesso letterale. *@
                        <b>@r.DocTitle</b> <span class="muted">· @r.AccCode · v@(r.VersionNumber)</span>
                        @if (!string.IsNullOrWhiteSpace(r.Note)) { <div class="muted">@r.Note</div> }
                        <div class="diff">
                            <span>@L["Changed_Sections"] @r.PrevSections → <b>@r.CurrSections</b></span> ·
                            <span>@L["Changed_Blocks"] @r.PrevBlocks → <b>@r.CurrBlocks</b></span> ·
                            <span class="muted">VID @r.PublishedByUserId · @r.PublishedUtc.ToString("dd MMM HH:mm")</span>
                        </div>
                    </div>
                    <a class="chg-link" href="@r.Url">@L["Common_OpenArrow"]</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<ChangeRow>? _rows;
    private string? _acc;

    private IReadOnlyList<string> _accs = System.Array.Empty<string>();
    private IReadOnlyList<ChangeRow> Filtered =>
        _rows is null ? System.Array.Empty<ChangeRow>()
        : (_acc is null ? _rows : _rows.Where(r => r.AccCode == _acc).ToList());

    protected override async Task OnInitializedAsync()
    {
        _rows = await Changes.ListChangedAsync();
        _accs = _rows.Select(r => r.AccCode).Distinct().OrderBy(x => x).ToList();
    }

    private void SetAcc(string? f) => _acc = f;

    // Suffisso "per {ACC}" localizzato (evita localizer annidato nell'interpolazione).
    private string AccSuffix() => _acc is null ? "" : $" {L["Changed_ForAcc", _acc]}";
}
