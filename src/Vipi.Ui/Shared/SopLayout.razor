@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IStationResolver Stations
@inject ICurrentUserProvider Users
@inject IEditAuthorizationService Authz
@inject IOptions<VipiChromeOptions> Chrome
@inject IOptions<DivisionOptions> Divisione
@inject IStringLocalizer<SharedResource> L
@inject ILogger<SopLayout> Log

<div class="vipi-root">
<a class="skip-link" href="#vipi-main">@L["Chrome_SkipToContent"]</a>
@if (Chrome.Value.RenderTopbar)
{
    <header class="topbar">
        @* ---- Telefono: il menu a scomparsa ----
           Sotto i 700px la barra non si comprime piu' in riga (misurato: pavimento a 959px, e i soli
           codici ACC sono 263 su 375 di schermo): cambia FORMA. In riga restano marchio, ricerca e
           questo tasto; dentro, gli ACC e tutti i comandi.
           ⚠️ `<details>` nativo e non un menu Blazor: il layout e' SSR statico, e un menu che
           dipendesse dal circuito non funzionerebbe proprio sulle pagine pubbliche — che sono quelle
           che si guardano dal telefono. Sopra i 700px il tasto non si rende affatto (CSS). *@
        <details class="tb-menu" id="tb-menu">
            <summary aria-label="@L["Chrome_Menu"]" title="@L["Chrome_Menu"]"><span aria-hidden="true">☰</span></summary>
            <div class="tb-menu-pan">
                <nav class="tb-menu-acc" aria-label="@L["Chrome_AccNav"]">
                    @foreach (var acc in _accs)
                    {
                        <a class="@(IsActiveAcc(acc.Code) ? "active" : null)" href="/services/vsop/@acc.Code.ToLowerInvariant()" aria-current="@(IsActiveAcc(acc.Code) ? "page" : null)">@acc.Code</a>
                    }
                </nav>
                @* Sotto lo scaglione tb-4 la barra nasconde zoom e tasti: «quello che esce dalla riga vive
                   nel menù». Qui le tre scelte sono esplicite, che è più chiaro di un giro a tre stati. Lo stato
                   attivo lo segna vipiApplyTema() su `data-theme-set`. *@
                <div class="tb-menu-tema" role="group" aria-label="@L["Chrome_Theme"]">
                    <button type="button" data-theme-set="auto" onclick="vipiSetTema('auto')"><Icon Name="monitor" /> @L["Chrome_ThemeAutoShort"]</button>
                    <button type="button" data-theme-set="light" onclick="vipiSetTema('light')"><Icon Name="sun" /> @L["Chrome_ThemeLightShort"]</button>
                    <button type="button" data-theme-set="dark" onclick="vipiSetTema('dark')"><Icon Name="moon" /> @L["Chrome_ThemeDarkShort"]</button>
                </div>
                @* La lingua: dallo scaglione tb-4 il gruppo esce dalla riga, e qui è l'unica strada che
                   resta — la stessa regola del tema e dello zoom. Nomi per esteso, che qui lo spazio c'è. *@
                <div class="tb-menu-lingua" role="group" aria-label="@L["Chrome_Language"]" data-enhance-nav="false">
                    @foreach (var lingua in LinguaDiLettura.Supportate)
                    {
                        var attiva = string.Equals(lingua, _lingua, StringComparison.OrdinalIgnoreCase);
                        <a href="@UrlConLingua(lingua)" hreflang="@lingua" class="@(attiva ? "on" : null)"
                           aria-current="@(attiva ? "true" : null)">@L[NomeLingua(lingua)]</a>
                    }
                </div>
                <a href="/services"><Icon Name="grid" /> @L["Chrome_Services"]</a>
                <a href="/services/vsop/guide"><Icon Name="help-circle" /> @L["Chrome_Guide"]</a>
                <a href="/services/vsop/live"><Icon Name="radio" /> @L["Chrome_OpenLive"]</a>
                <a href="/services/stats"><Icon Name="clipboard" /> @L["Stats_Title"]</a>
                @if (_canEdit)
                {
                    <a href="/services/vsop/versions"><Icon Name="pencil" /> @L["Chrome_Editor"]</a>
                    <a href="/services/vsop/tasks"><Icon Name="clipboard" /> @L["Nav_Tasks"]</a>
                }
                @if (_isAdmin)
                {
                    <a href="/services/vsop/admin/permissions"><Icon Name="key" /> @L["Chrome_Permissions"]</a>
                }
                @if (_user is null)
                {
                    <a href="/services/vsop/auth/login?returnUrl=/services/vsop"><Icon Name="log-in" /> @L["Chrome_Login"]</a>
                }
                else
                {
                    <a href="/services/vsop/auth/logout"><Icon Name="log-out" /> @L["Chrome_Logout"]</a>
                }
            </div>
        </details>
        @* Il marchio porta all'HUB, non alla documentazione: fino al 22 agosto 2026 puntava a
           /services/vsop, cioe' a UNO SOLO degli strumenti, mentre stava in cima a tutti.

           ⚠️ IL MARCHIO NON SI TRADUCE, ed e' una regola del committente (docs/design/regole-lingua.md
           R1-R2). Fino al 28 agosto 2026 diceva `Services_Title` — «Servizi ATC» in italiano, «ATC
           Services» in inglese — cioe' cambiava nome col cambiare della lingua. Un marchio e' un nome
           proprio: chi lo cerca, lo cerca cosi'. `Services_Title` resta dov'e' un TITOLO (l'hub), che e'
           un'altra cosa e segue la lingua.

           ⚠️ Il sottotitolo viene dalla CONFIGURAZIONE e non dalle risorse: e' il nome della divisione, e
           una divisione diversa che monta questo modulo deve vedere il proprio. *@
        <a class="brand" href="/services" aria-label="@L["Chrome_BrandHome"]">
            <span class="logo">ATC</span>
            <div>ATC Services <small>IVAO @Divisione.Value.Name</small></div>
        </a>
        <nav class="acc-nav" aria-label="@L["Chrome_AccNav"]">
            @foreach (var acc in _accs)
            {
                <a class="@(IsActiveAcc(acc.Code) ? "active" : null)" href="/services/vsop/@acc.Code.ToLowerInvariant()" aria-current="@(IsActiveAcc(acc.Code) ? "page" : null)">@acc.Code</a>
            }
        </nav>
        <form class="top-search" action="/services/vsop/search" method="get" role="search">
            <span class="ico"><Icon Name="search" /></span>
            <input name="q" placeholder="@L["Chrome_SearchPh"]" aria-label="@L["Chrome_Search"]" />
        </form>
        <div class="right">
            @* ⚠️ Qui stava il tasto «Servizi», tolto insieme al cambio del marchio: adesso e' il marchio a
               portare all'hub, e due link identici a 100px di distanza sono ingombro, non ridondanza. Nel
               «☰» la voce resta, perche' li' il marchio e' ridotto al solo logo. *@
            <a class="editor-btn icon-only" href="/services/vsop/guide" title="@L["Chrome_Guide"]" aria-label="@L["Chrome_Guide"]"><Icon Name="help-circle" /></a>
            <div class="zoom-ctrl" role="group" aria-label="@L["Chrome_ZoomPage"]">
                <button type="button" onclick="vipiZoom(-0.1)" title="@L["Chrome_ZoomOut"]" aria-label="@L["Chrome_ZoomOut"]">−</button>
                <span id="vipiZoomPct" role="status" aria-live="polite" aria-label="@L["Chrome_ZoomPage"]" onclick="vipiZoomReset()" title="@L["Chrome_ZoomReset"]">100%</span>
                <button type="button" onclick="vipiZoom(0.1)" title="@L["Chrome_ZoomIn"]" aria-label="@L["Chrome_ZoomIn"]">+</button>
            </div>
            @* La LINGUA. ⚠️ Un controllo solo per l'interfaccia E per il documento (carta bilingue §7): un
               documento inglese dentro una pagina italiana è una schermata mezza tradotta. Fino al 28 agosto
               2026 il meccanismo c'era tutto — `?culture=`, il cookie, il badge «non revisionata» — e
               mancava questo: la lingua si poteva chiedere solo scrivendola nell'indirizzo.
               ⚠️ DUE CHIP e non un tasto che gira come il tema: su un tasto solo non si sa se «EN» è la
               lingua in cui sei o quella in cui andresti, e a differenza del tema qui l'errore non si vede
               finché la pagina non si è già ricaricata. Costa una trentina di px in più, e la barra li
               trova: dallo scaglione tb-4 in giù il gruppo esce di riga e la scelta resta nel «☰».
               ⚠️ SONO LINK, non tasti: il chrome è SSR statico e non c'è nessun circuito da chiamare —
               cambiare lingua è ricaricare questa stessa pagina chiedendola in un'altra lingua, e infatti
               funziona anche a JavaScript spento. *@
            @* ⚠️ `data-enhance-nav="false"`: CAMBIARE LINGUA DEVE RICARICARE DAVVERO.
               Misurato a schermo il 28 agosto 2026 su LIBC: cliccando «EN» la pagina diventava inglese ma il
               riquadro METAR restava «VENTO / VISIBILITÀ / NUBI» e il badge diceva «Live · non connesso».
               La navigazione «enhanced» di `blazor.web.js` non ricarica il documento: sostituisce il DOM e
               RIUSA IL CIRCUITO già aperto — e la cultura di un circuito è quella di quando è nato. Il
               chrome, che è SSR, arrivava tradotto; le isole interattive no.
               Senza questo attributo il cookie non basta: il cookie lo legge la richiesta successiva, e con
               l'enhanced navigation una richiesta successiva del circuito non c'è. *@
            <div class="lang-ctrl" role="group" aria-label="@L["Chrome_Language"]" data-enhance-nav="false">
                @foreach (var lingua in LinguaDiLettura.Supportate)
                {
                    var attiva = string.Equals(lingua, _lingua, StringComparison.OrdinalIgnoreCase);
                    <a href="@UrlConLingua(lingua)" hreflang="@lingua" class="@(attiva ? "on" : null)"
                       aria-current="@(attiva ? "true" : null)"
                       title="@L[NomeLingua(lingua)]" aria-label="@L[NomeLingua(lingua)]">@lingua.ToUpperInvariant()</a>
                }
            </div>
            @* Tema: un solo tasto che gira automatico → chiaro → scuro. È un tasto e non tre perché tre
               costerebbero una novantina di px in barra; le tre scelte esplicite stanno nel menù, dove lo
               spazio c'è. ⚠️ Il conto non è piu' contro un minimo incomprimibile noto (quello era il mondo
               delle media query): da 2026-08-22-topbar-misurata.md la barra si misura, e questo tasto è
               semplicemente uno dei pezzi che la misura deve far stare.
               ⚠️ L'ICONA la sceglie il CSS sullo stato di :root, non il JS: il chrome è SSR statico e non si
               ridisegna da sé, quindi le tre icone si rendono tutte e se ne mostra una. Al JS resta la sola
               etichetta, che in CSS non è esprimibile — e le stringhe gli arrivano dai `data-lbl-*`, perché
               stanno nel resx e non dentro un file .js. *@
            <button type="button" class="editor-btn icon-only theme-ctrl" data-theme-ctrl
                    onclick="vipiCicloTema()"
                    title="@L["Chrome_ThemeAuto"]" aria-label="@L["Chrome_ThemeAuto"]"
                    data-lbl-auto="@L["Chrome_ThemeAuto"]"
                    data-lbl-light="@L["Chrome_ThemeLight"]"
                    data-lbl-dark="@L["Chrome_ThemeDark"]">
                <Icon Name="monitor" Class="ti ti-auto" />
                <Icon Name="sun" Class="ti ti-light" />
                <Icon Name="moon" Class="ti ti-dark" />
            </button>
            @* Toggle Estesa/Ridotta rimosso: la vista Ridotta è disabilitata (rebuild /services/vsop, Round 12). *@
            @* La versione, ai SOLI admin. Risponde a una domanda che si è posta di continuo — «che versione
               è online?» — e che finora si rispondeva scaricando un file via FTP.
               ⚠️ Non è per tutti: a un socio non dice niente, e a chi passa di qui direbbe con quale build
               precisa sta parlando, che è informazione da regalare solo se serve a qualcuno.
               ⚠️ È la PRIMA cosa che esce dalla barra quando lo spazio manca (CSS, scaglione tb-2): è una
               spia, non un comando, e la stessa riga sta in diagnostica/avvio-diagnostica.txt. *@
            @if (_isAdmin && Chrome.Value.Versione is { Length: > 0 } ver)
            {
                <span class="ver-chip" title="@Chrome.Value.VersioneDettaglio" aria-label="@(L["Chrome_Version"].Value + ": " + ver)">@ver</span>
            }
            @* Isola interattiva: il layout è SSR statico e il badge dev'essere l'unica cosa che si aggiorna
               da sola quando ti colleghi in frequenza. Il VID glielo passa il layout, che l'HttpContext ce l'ha. *@
            <LiveBadge UserId="_user?.UserId" />
            @if (_canEdit)
            {
                <a class="editor-btn" href="/services/vsop/versions" title="@L["Chrome_OpenEditor"]" aria-label="@L["Chrome_OpenEditor"]"><Icon Name="pencil" /> <span class="eb-t">@L["Chrome_Editor"]</span></a>
            }
            @if (_isAdmin)
            {
                <a class="editor-btn icon-only" href="/services/vsop/admin/permissions" title="@L["Chrome_Permissions"]" aria-label="@L["Chrome_Permissions"]"><Icon Name="key" /></a>
            }
            @if (_user is { } u)
            {
                @* L'AVATAR è la porta agli incarichi: il tasto dedicato è stato tolto perché la barra è a
                   corto di spazio e la pagina ha già un posto naturale dove stare, cioè sotto la propria
                   identità. ⚠️ Serve `aria-label`: il nome accessibile sarebbero altrimenti le sole
                   INIZIALI, che non dicono niente a chi non vede il cerchio. Il nome per esteso resta nel
                   `title`, dove stava.
                   ⚠️ La voce nel menù «☰» NON si tocca: allo scaglione tb-4 la barra nasconde
                   `.user-chip`, quindi lì il menù è l'unica strada rimasta per gli incarichi. *@
                <div class="user-chip">
                    <a class="avatar" href="/services/vsop/tasks"
                       title="@u.Name · @L["Chrome_MyTasks"]" aria-label="@L["Chrome_MyTasks"]">@Initials(u.Name)</a>
                    @* Logout standalone: no-op se l'endpoint non è montato (embedded). *@
                    <a class="editor-btn icon-only" href="/services/vsop/auth/logout" title="@L["Chrome_Logout"]" aria-label="@L["Chrome_Logout"]"><Icon Name="log-out" /></a>
                </div>
            }
            else
            {
                <a class="editor-btn" href="/services/vsop/auth/login?returnUrl=/services/vsop" title="@L["Chrome_LoginTitle"]"><Icon Name="log-in" /> <span class="eb-t">@L["Chrome_Login"]</span></a>
            }
        </div>
    </header>
}

<main id="vipi-main">@Body</main>
@* IL PIE' DI OGNI FOGLIO STAMPATO. A schermo non esiste (`.print-only`).

   ⚠️ Sta nel LAYOUT e non nei documenti perche' vale per OGNI pagina del sito, non solo per i cinque
   documenti: chiunque stampi qualunque cosa da qui si porta a casa un foglio che dice che cos'e'.

   ⚠️ `position:fixed` e' l'unico modo che il CSS ha di RIPETERE una riga su ogni foglio: le margin box
   di `@@page` (`@@bottom-center`) non le implementa nessun browser, e l'alternativa — riavvolgere tutto
   il contenuto dentro un `<table><tfoot>` — vorrebbe dire cambiare il markup di tutto il sito per una
   riga sola. Si ripete su ogni pagina in Chrome, Edge e Firefox; ⚠️ Safari la stampa solo sulla PRIMA
   pagina, ed e' il motivo per cui l'avviso sta ANCHE nell'intestazione (`PrintMeta`) e sotto il titolo.

   Lo spazio in cui atterra lo apre `@@page{margin-bottom}` in vipi-print.css: senza, il testo del
   documento gli scorrerebbe sotto. *@
<footer class="print-only sim-foot"><SimDisclaimer /></footer>

@* ⚠️ Senza questa barra un circuito morto e' MUTO: la pagina resta a schermo e i tasti smettono di
   funzionare, senza un messaggio. Le pagine dei documenti sono proprio quelle dove e' successo. *@
<BarraErroreCircuito />
</div>

@code {
    private string? _acc;
    private IReadOnlyList<AccInfo> _accs = Array.Empty<AccInfo>();
    private CurrentUser? _user;
    private bool _isAdmin;
    private bool _canEdit;

    /// <summary>
    /// ⚠️ IL LAVORO ASINCRONO DEL LAYOUT SI COMPIE PRIMA CHE L'ALBERO VENGA DISEGNATO, e non è una
    /// raffinatezza: è la seconda metà del difetto del 24 agosto 2026, che la prima correzione non aveva
    /// visto.
    ///
    /// <para><b>Il meccanismo.</b> `ComponentBase` disegna <b>subito</b> dopo `OnParametersSetAsync`, e
    /// aspetta il task solo se non è già completato. Un layout che lascia una query in volo la lascia in
    /// volo mentre viene disegnato il suo <c>@Body</c> — cioè mentre la PAGINA esegue il proprio
    /// `OnParametersSetAsync`. Le due query cadono sullo stesso `DbContext` dello scope, e la seconda muore
    /// con «A second operation was started on this context instance».</para>
    ///
    /// <para><b>Misurato, non temuto:</b> alle 17:44 del 24 agosto, con la prima correzione già in
    /// produzione, sette richieste sono morte così — <c>AccLanding</c> su <c>CanEditAccAsync</c>,
    /// <c>AeroportoPage</c> su <c>AirportPresidencyService</c>. Il layout aveva smesso di litigare con sé
    /// stesso e aveva cominciato a litigare con le pagine.</para>
    ///
    /// <para>Sovrascrivendo <c>SetParametersAsync</c> il lavoro si conclude <b>prima</b> di
    /// <c>base.SetParametersAsync</c>, che è ciò che innesca il disegno: quando la pagina parte, il layout
    /// non ha più niente in volo. ⚠️ Chi rimettesse un `await` dentro `OnParametersSetAsync` riaprirebbe la
    /// finestra per OGNI pagina del sito — c'è un test che lo impedisce.</para>
    /// </summary>
    public override async Task SetParametersAsync(ParameterView parameters)
    {
        parameters.SetParameterProperties(this);
        await CaricaAsync();
        // ParameterView.Empty: i parametri sono già stati applicati sopra. È il modo documentato.
        await base.SetParametersAsync(ParameterView.Empty);
    }

    private async Task CaricaAsync()
    {
        _user = Users.Get();

        // ⚠️ IL CATALOGO SI LEGGE QUI, E PRIMA DI QUALUNQUE `await`. Non è pignoleria: è il difetto del
        // 24 agosto 2026, letto nello stack trace di 78 richieste fallite.
        //
        // `Stations.Accs` è a caricamento pigro, e il markup lo leggeva DENTRO `BuildRenderTree`. Ma Blazor
        // disegna l'albero mentre `OnParametersSetAsync` è ancora in volo — se il metodo restituisce un task
        // non completato, il primo render parte subito — e in quel momento la query del catalogo partiva
        // sullo STESSO `DbContext` dello scope su cui era già in corso quella di `_canEdit`. Due operazioni
        // insieme sullo stesso context: «A second operation was started on this context instance».
        //
        // Perché si vedeva solo da collegati: l'anonimo esce da `_canEdit` prima del database, quindi non
        // c'è nessun await in volo e le due query non si incontrano mai. Ed è la stessa asimmetria che aveva
        // fatto sospettare `_canEdit`: la corsa la innesca lui, ma a morire è il catalogo.
        //
        // ⚠️ E NON era «a volte»: era SISTEMATICA per una classe di utenti, e i numeri lo dicono. Delle 92
        // righe, le 78 della corsa vengono TUTTE dallo stesso VID non-admin; l'admin che navigava nella
        // stessa finestra non ne ha prodotta nessuna. Il motivo sta in `ComponentBase`: dopo
        // `OnParametersSetAsync` il render parte SEMPRE, ma se il task è già completato non c'è niente in
        // volo. Per un admin `CanEditAnythingAsync` risponde dai claim senza toccare il database — task
        // completato, nessuna corsa. Per un socio qualunque è una query vera — task in volo, corsa certa.
        //   anonimo    → niente domanda      → niente corsa
        //   admin      → risposta immediata  → niente corsa
        //   socio      → query vera in volo  → CORSA, ogni volta
        // Ecco perché lo vedeva solo chi non ha incarichi, e perché a noi non capitava mai.
        //
        // `Prewarm()` era già scritto apposta («chiamata dal ciclo di vita async, context libero e
        // sequenziale») e non lo chiamava nessuno.
        _accs = LeggiCatalogo();

        // /services/vsop/{acc}/{vipi?}. ⚠️ Il conto dei segmenti NON si rifà qui: era scritto a mano e
        // contava dal primo, che dal 22 agosto 2026 è «services» e non più «vsop» — da allora nessun ACC
        // è più stato evidenziato. Ora il prefisso sta in un posto solo (VsopRoutes).
        _acc = VsopRoutes.AccFrom(Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath);

        // Tasto Editor: visibile a chi può editare, cioè dall'Editor in su.
        _isAdmin = Authz.IsAdmin;
        _canEdit = Authz.IsEditor;
    }

    /// <summary>
    /// Il catalogo delle ACC, scaldato FUORI dal render. Degrada come il tasto «Modifica» e per la stessa
    /// ragione: senza elenco la barra perde i collegamenti alle ACC, ma la pagina — la guida, l'hub, un
    /// documento già in cache — si apre lo stesso. Prima, un catalogo illeggibile era una pagina morta.
    /// </summary>
    private IReadOnlyList<AccInfo> LeggiCatalogo()
    {
        try
        {
            Stations.Prewarm();
            return Stations.Accs;
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Barra: il catalogo delle ACC non si è potuto leggere. "
                             + "La barra esce senza i collegamenti alle ACC e la pagina si serve lo stesso.");
            return Array.Empty<AccInfo>();
        }
    }

    /// <summary>
    /// La sola domanda che la barra fa al database, e l'<b>unica cosa</b> che un utente loggato fa in più
    /// di un anonimo su qualunque pagina. Per questo qui si degrada invece di lanciare.
    ///
    /// <para><b>Perché.</b> Il 24 agosto 2026 un socio senza incarichi ha visto la pagina «Error.» su
    /// <c>/services</c> — una pagina che non legge niente dal database — mentre per chi non era entrato lo
    /// stesso indirizzo rispondeva 200. L'asimmetria è tutta qui: l'anonimo esce dalla condizione prima di
    /// arrivare al database, l'admin esce sul controllo dei codici staff, e resta a pagare il giro proprio
    /// il socio qualunque. Qualunque intoppo — connessione caduta, pool esaurito, comando scaduto — non
    /// spegneva un tasto: buttava giù <b>tutta</b> la pagina, per i soli utenti loggati.</para>
    ///
    /// <para>⚠️ <b>Il difetto è stato chiuso alla radice il 28 agosto 2026, e questo metodo è sparito con
    /// lui.</b> La domanda non si fa più: il livello sta nei claim e in un fotogramma in memoria, quindi
    /// «può modificare?» è un confronto, non una query. Il <c>try/catch</c> che ingoiava l'errore serviva
    /// solo perché quella domanda poteva fallire; una domanda che non tocca il database non fallisce.</para>
    /// </summary>

    private bool IsActiveAcc(string code) =>
        _acc is not null && code.Equals(_acc, StringComparison.OrdinalIgnoreCase);

    /// <summary>La lingua in cui si sta leggendo: quella dell'interfaccia, che è anche quella del documento.</summary>
    private static string _lingua =>
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

    /// <summary>Il nome della lingua nella lingua corrente («Italiano»/«Inglese»), dalle risorse.</summary>
    private static string NomeLingua(string lingua) => "Chrome_Lang_" + lingua.ToLowerInvariant();

    /// <summary>
    /// Questa stessa pagina, chiesta in un'altra lingua.
    ///
    /// <para>⚠️ Il corpo sta in <see cref="LinkLingua"/> e non qui: lo stesso indirizzo serve ai
    /// collegamenti <c>rel="alternate"</c> nel <c>&lt;head&gt;</c>, che vivono nell'host. Due copie
    /// avrebbero potuto divergere in un modo che nessuno vede — un motore di ricerca non protesta se
    /// l'alternativa punta altrove rispetto al tasto.</para>
    /// </summary>
    private string UrlConLingua(string lingua) => LinkLingua.Url(Nav, lingua);

    /// ⚠️ Si tengono solo le parole che COMINCIANO PER LETTERA. Il nome che arriva non è sempre
    /// «nome cognome»: l'identità di sviluppo è «Carmine (704798)», e prendendo alla lettera «la prima
    /// lettera della seconda parola» l'avatar scriveva «C(». Vale anche in produzione, dove un secondo
    /// nome puntato o un titolo fra parentesi non sono ipotesi peregrine.
    /// Il ripiego a una parola sola parte dalla PAROLA, non dal nome intero, o si tornerebbe a pescare
    /// la parentesi per un altro giro.
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Where(p => char.IsLetter(p[0]))
                        .ToArray();
        if (parts.Length >= 2) return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        var sola = parts.Length == 1 ? parts[0] : name.Trim();
        return sola.Length >= 2 ? sola[..2].ToUpper() : sola.ToUpper();
    }
}
