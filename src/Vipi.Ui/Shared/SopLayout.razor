@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IStationResolver Stations
@inject ICurrentUserProvider Users
@inject IEditAuthorizationService Authz
@inject IEditingService Editing
@inject IOptions<VipiChromeOptions> Chrome
@inject IStringLocalizer<SharedResource> L

<div class="vipi-root">
<a class="skip-link" href="#vipi-main">@L["Chrome_SkipToContent"]</a>
@if (Chrome.Value.RenderTopbar)
{
    <header class="topbar">
        @* ---- Telefono: il menu a scomparsa ----
           Sotto i 700px la barra non si comprime piu' in riga (misurato: pavimento a 959px, e i soli
           codici ACC sono 263 su 375 di schermo): cambia FORMA. In riga restano marchio, ricerca e
           questo tasto; dentro, gli ACC e tutti i comandi.
           ⚠️ `<details>` nativo e non un menu Blazor: il layout e' SSR statico, e un menu che
           dipendesse dal circuito non funzionerebbe proprio sulle pagine pubbliche — che sono quelle
           che si guardano dal telefono. Sopra i 700px il tasto non si rende affatto (CSS). *@
        <details class="tb-menu" id="tb-menu">
            <summary aria-label="@L["Chrome_Menu"]" title="@L["Chrome_Menu"]"><span aria-hidden="true">☰</span></summary>
            <div class="tb-menu-pan">
                <nav class="tb-menu-acc" aria-label="@L["Chrome_AccNav"]">
                    @foreach (var acc in Stations.Accs)
                    {
                        <a class="@(IsActiveAcc(acc.Code) ? "active" : null)" href="/services/vsop/@acc.Code.ToLowerInvariant()">@acc.Code</a>
                    }
                </nav>
                <a href="/services"><Icon Name="grid" /> @L["Chrome_Services"]</a>
                <a href="/services/vsop/guide"><Icon Name="help-circle" /> @L["Chrome_Guide"]</a>
                <a href="/services/vsop/live"><Icon Name="radio" /> @L["Chrome_OpenLive"]</a>
                @if (_canEdit)
                {
                    <a href="/services/vsop/versions"><Icon Name="pencil" /> @L["Chrome_Editor"]</a>
                    <a href="/services/vsop/tasks"><Icon Name="clipboard" /> @L["Nav_Tasks"]</a>
                }
                @if (_isAdmin)
                {
                    <a href="/services/vsop/admin/permissions"><Icon Name="key" /> @L["Chrome_Permissions"]</a>
                }
                @if (_user is null)
                {
                    <a href="/services/vsop/auth/login?returnUrl=/services/vsop"><Icon Name="log-in" /> @L["Chrome_Login"]</a>
                }
                else
                {
                    <a href="/services/vsop/auth/logout"><Icon Name="log-out" /> @L["Chrome_Logout"]</a>
                }
            </div>
        </details>
        <a class="brand" href="/services/vsop" aria-label="@L["Chrome_BrandHome"]">
            <span class="logo">vIPI</span>
            <div>vIPI <small>@L["Chrome_BrandSubtitle"]</small></div>
        </a>
        <nav class="acc-nav" aria-label="@L["Chrome_AccNav"]">
            @foreach (var acc in Stations.Accs)
            {
                <a class="@(IsActiveAcc(acc.Code) ? "active" : null)" href="/services/vsop/@acc.Code.ToLowerInvariant()" aria-current="@(IsActiveAcc(acc.Code) ? "page" : null)">@acc.Code</a>
            }
        </nav>
        <form class="top-search" action="/services/vsop/search" method="get" role="search">
            <span class="ico"><Icon Name="search" /></span>
            <input name="q" placeholder="@L["Chrome_SearchPh"]" aria-label="@L["Chrome_Search"]" />
        </form>
        <div class="right">
            <a class="editor-btn icon-only" href="/services" title="@L["Chrome_Services"]" aria-label="@L["Chrome_Services"]"><Icon Name="grid" /></a>
            <a class="editor-btn icon-only" href="/services/vsop/guide" title="@L["Chrome_Guide"]" aria-label="@L["Chrome_Guide"]"><Icon Name="help-circle" /></a>
            @if (_staff is { Length: > 0 })
            {
                <div class="staff-badge" title="@L["Chrome_StaffPosition"]"><Icon Name="award" /> <span class="sb-t">@_staff</span></div>
            }
            <div class="zoom-ctrl" role="group" aria-label="@L["Chrome_ZoomPage"]">
                <button type="button" onclick="vipiZoom(-0.1)" title="@L["Chrome_ZoomOut"]" aria-label="@L["Chrome_ZoomOut"]">−</button>
                <span id="vipiZoomPct" role="status" aria-live="polite" aria-label="@L["Chrome_ZoomPage"]" onclick="vipiZoomReset()" title="@L["Chrome_ZoomReset"]">100%</span>
                <button type="button" onclick="vipiZoom(0.1)" title="@L["Chrome_ZoomIn"]" aria-label="@L["Chrome_ZoomIn"]">+</button>
            </div>
            @* Toggle Estesa/Ridotta rimosso: la vista Ridotta è disabilitata (rebuild /services/vsop, Round 12). *@
            @* Isola interattiva: il layout è SSR statico e il badge dev'essere l'unica cosa che si aggiorna
               da sola quando ti colleghi in frequenza. Il VID glielo passa il layout, che l'HttpContext ce l'ha. *@
            <LiveBadge UserId="_user?.UserId" />
            @if (_canEdit)
            {
                <a class="editor-btn" href="/services/vsop/versions" title="@L["Chrome_OpenEditor"]" aria-label="@L["Chrome_OpenEditor"]"><Icon Name="pencil" /> <span class="eb-t">@L["Chrome_Editor"]</span></a>
                @* ⚠️ Era l'unica voce della topbar scritta a mano in italiano, accanto a una tradotta:
                   in pagina inglese diceva «Incarichi». L'etichetta e' la stessa della barra admin. *@
                <a class="editor-btn" href="/services/vsop/tasks" title="@L["Chrome_MyTasks"]" aria-label="@L["Chrome_MyTasks"]"><Icon Name="clipboard" /> <span class="eb-t">@L["Nav_Tasks"]</span></a>
            }
            @if (_isAdmin)
            {
                <a class="editor-btn icon-only" href="/services/vsop/admin/permissions" title="@L["Chrome_Permissions"]" aria-label="@L["Chrome_Permissions"]"><Icon Name="key" /></a>
            }
            @if (_user is { } u)
            {
                <div class="user-chip">
                    <span class="avatar" title="@u.Name">@Initials(u.Name)</span>
                    @* Logout standalone: no-op se l'endpoint non è montato (embedded). *@
                    <a class="editor-btn icon-only" href="/services/vsop/auth/logout" title="@L["Chrome_Logout"]" aria-label="@L["Chrome_Logout"]"><Icon Name="log-out" /></a>
                </div>
            }
            else
            {
                <a class="editor-btn" href="/services/vsop/auth/login?returnUrl=/services/vsop" title="@L["Chrome_LoginTitle"]"><Icon Name="log-in" /> <span class="eb-t">@L["Chrome_Login"]</span></a>
            }
        </div>
    </header>
}

<main id="vipi-main">@Body</main>
</div>

@code {
    private string? _acc;
    private CurrentUser? _user;
    private bool _isAdmin;
    private bool _canEdit;
    private string? _staff;

    protected override async Task OnParametersSetAsync()
    {
        _user = Users.Get();
        _staff = _user is { StaffPositions.Count: > 0 } su ? string.Join(" · ", su.StaffPositions) : null;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var segments = uri.AbsolutePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        // /services/vsop/{acc}/{vipi?}
        _acc = segments.Length >= 2 && segments[0].Equals("vsop", StringComparison.OrdinalIgnoreCase)
            ? segments[1] : null;

        // Tasto Editor: visibile solo a chi può editare almeno un documento (admin o grant).
        _isAdmin = Authz.IsAdmin;
        _canEdit = _user is not null && (_isAdmin || (await Editing.ListEditableDocumentsAsync()).Count > 0);
    }

    private bool IsActiveAcc(string code) =>
        _acc is not null && code.Equals(_acc, StringComparison.OrdinalIgnoreCase);

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}"
            : (name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper());
    }
}
