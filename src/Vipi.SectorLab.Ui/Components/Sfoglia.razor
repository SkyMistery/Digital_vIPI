@implements IDisposable
@inject SessioneDelLab Lab

@*
    Sfoglia (carta F3 §2.2 passo 2, slice 5): la ricerca per nome, l'albero delle cartelle, e i record del file
    aperto. Si iscrive da sé a Cambiata — vedi Mappa.razor: un componente senza parametri non lo ridisegna nessuno.
*@
<div class="lab-sfoglia">
    <input type="search" class="lab-cerca" placeholder="Cerca un nome (fix, VOR, settore, area…) o un file"
           value="@_cercato" @oninput="Cerca" data-campo="cerca" />

    @if (_cercato.Trim().Length >= 2)
    {
        <div class="lab-risultati" data-risultati="@_trovati.Count">
            @* I file per nome (28 settembre): prima dei record, un clic apre il file nell'albero. *@
            @foreach (string file in _file)
            {
                <button class="lab-trovato lab-trovato-file" @onclick="() => ApriIlFile(file)" data-trovato-file="@file"
                        title="@file">
                    <span class="lab-etichetta">📄 @Nome(file)</span>
                    <span class="lab-nota">@Cartella(file)</span>
                </button>
            }
            @if (_trovati.Count == 0 && _file.Count == 0)
            {
                <p class="lab-nota">Nessun nome così. @* I record senza geometria non sono ancora nell'indice (slice 5). *@</p>
            }
            @foreach (var trovato in _trovati)
            {
                <button class="lab-trovato @(Scelto(trovato.File, trovato.Record) ? "lab-scelto" : null)"
                        @onclick="() => VaiA(trovato)" data-trovato="@trovato.Etichetta">
                    <span class="lab-etichetta">@trovato.Etichetta</span>
                    <span class="lab-nota">@Nome(trovato.File)</span>
                </button>
            }
        </div>
    }
    else if (Lab.Albero is { } radice)
    {
        <div class="lab-albero">
            @foreach (var cartella in radice.Cartelle)
            {
                <Cartella Nodo="cartella" />
            }
            @foreach (var nellaRadice in radice.File)
            {
                <VoceDiFile File="nellaRadice" />
            }
        </div>
    }

    @* Nell'albero i record del file aperto stanno sotto di lui (RecordDelFile, da VoceDiFile); durante una ricerca
       l'albero non c'è, e stanno qui sotto i risultati. *@
    @if (_cercato.Trim().Length >= 2 && Lab.FileScelto is { } aperto)
    {
        <RecordDelFile Relativo="@aperto" />
    }
</div>

@code {
    private string _cercato = string.Empty;
    private IReadOnlyList<Trovato> _trovati = [];
    private IReadOnlyList<string> _file = [];

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Cerca(ChangeEventArgs e)
    {
        _cercato = e.Value?.ToString() ?? string.Empty;
        _trovati = Lab.Cerca(_cercato);
        _file = Lab.CercaFile(_cercato);
    }

    /// <summary>Un file trovato: si apre nell'albero, e la ricerca si chiude per mostrarlo coi suoi record.</summary>
    private void ApriIlFile(string relativo)
    {
        _cercato = string.Empty;
        _trovati = [];
        _file = [];
        Lab.ApriFile(relativo);
    }

    /// <summary>La cartella del file sotto Include/IT (o sotto la radice, per gli .isc).</summary>
    private static string Cartella(string relativo)
    {
        string senza = relativo.StartsWith("SectorFiles/Include/IT/", StringComparison.OrdinalIgnoreCase)
            ? relativo["SectorFiles/Include/IT/".Length..]
            : relativo;
        int barra = senza.LastIndexOf('/');
        return barra < 0 ? "IT" : senza[..barra];
    }

    private void VaiA(Trovato trovato)
    {
        // Andare su una forma accende il suo strato: sennò si sceglie qualcosa che sulla mappa non si vede.
        Lab.Accendi(trovato.Strato, acceso: true);
        Lab.Scegli(trovato.File, trovato.Record);
    }

    private bool Scelto(string file, int record) => Lab.Scelta == (file, record);

    private static string Nome(string relativo) => relativo[(relativo.LastIndexOf('/') + 1)..];

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
