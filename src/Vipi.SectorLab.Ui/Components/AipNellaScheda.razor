@inject SessioneDelLab Lab

@*
    La scheda di una voce dell'AIP espanso scelta sulla mappa (F6): com'è scritta nel modello — un'area, una rotta coi suoi
    tratti, un'attesa, un punto, una radioassistenza… Non è un record del sector. Ogni voce si corregge o si toglie da qui
    (carta «Le correzioni dell'AIP espanso», slice 2 le aree, slice 3 il resto): la correzione va nell'AIP espanso, non nel
    sector.
*@
@if (Voce is { } voce)
{
    var correggibile = Area is not null || Modello is not null;
    <div class="lab-ispettore" data-scheda-aip="@voce.Genere">
        <header>
            <p class="lab-etichetta">@voce.Titolo</p>
            <p class="lab-nota">AIP espanso @Ciclo · @voce.Genere@(correggibile ? "" : " · sola lettura")</p>
        </header>
        @if (Correzione is { } c)
        {
            <p class="lab-nota" data-correzione-aip="@c.Id">✎ @(c.Op == Aip.CorrectionOp.Add ? "Aggiunta" : "Corretta") (@c.Id, dal ciclo @c.Since): @c.Reason — fonte: @c.Source</p>
        }
        <dl class="lab-campi-aip">
            @foreach (var (nome, valore) in voce.Campi)
            {
                <dt>@nome</dt>
                <dd>@valore
                    @* Da dove viene la voce (22 ottobre): «AD 2 LIRN 5-11 (09/07/2026)» → il PDF a quella pagina, dall'indice delle pagine. *@
                    @if (nome == "Pagina" && valore != "—" && Ciclo is { } ciclo)
                    {
                        <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="apri-pagina-aip" title="Apre il PDF a questa pagina"
                                @onclick="() => ApriLaPagina(ciclo, valore)">Apri il PDF</button>
                    }
                </dd>
            }
        </dl>
        @if (voce.Righe.Count > 0)
        {
            <pre class="lab-righe-aip" data-righe-aip>@string.Join("\n", voce.Righe)</pre>
        }
        @if (correggibile)
        {
            @if (_cosa is null)
            {
                <p class="lab-gesti-record">
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="correggi-area" @onclick="() => Apri(Gesto.Correggi)"
                            title="Corregge la voce nell'AIP espanso: un errore dell'AIP, o un dato da un'altra fonte">Correggi</button>
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="togli-area" @onclick="() => Apri(Gesto.Togli)"
                            title="Toglie la voce dall'AIP espanso, con una correzione">Togli dall'AIP espanso…</button>
                    @if (Correzione is { } attiva)
                    {
                        <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="ritira-correzione" disabled="@Lab.StaCorreggendoLAip"
                                title="La voce torna com'è nel PDF" @onclick="() => Ritira(attiva.Id)">Ritira la correzione</button>
                    }
                </p>
            }
            else if (_cosa == Gesto.Correggi)
            {
                @if (Area is { } area)
                {
                    <ModuloDellArea Prima="area" Chiuso="Chiudi" />
                }
                else if (Modello is var (tipo, oggetto))
                {
                    <ModuloDiUnaVoce Tipo="tipo" Prima="oggetto" Chiuso="Chiudi" />
                }
            }
            else
            {
                <div class="lab-modulo-aip" data-togli-area>
                    @if (Correzione is { Op: Aip.CorrectionOp.Add })
                    {
                        <p class="lab-nota">La voce c'è solo per un'aggiunta: si ritira l'aggiunta.</p>
                    }
                    else
                    {
                        <label class="lab-nota">Perché
                            <input class="lab-campo" value="@_perche" data-campo="togli-perche" @onchange="e => _perche = e.Value?.ToString()" />
                        </label>
                        <label class="lab-nota">Fonte
                            <input class="lab-campo" value="@_fonte" data-campo="togli-fonte" placeholder="AIP SUP 123/26 · errore AIP, segnalato a ENAV il …" @onchange="e => _fonte = e.Value?.ToString()" />
                        </label>
                    }
                    <p>
                        <button type="button" class="lab-tasto" data-tasto="conferma-togli" disabled="@Lab.StaCorreggendoLAip" @onclick="Togli">Togli dall'AIP espanso</button>
                        <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="lascia-togli" @onclick="Chiudi">Lascia stare</button>
                    </p>
                </div>
            }
            @if (_rifiuto is { } rifiuto)
            {
                <p class="lab-errore" data-rifiuto-correzione>@rifiuto</p>
            }
        }
        else if (_rifiuto is { } rifiuto)
        {
            <p class="lab-errore" data-rifiuto-correzione>@rifiuto</p>
        }
    </div>
}

@code {
    private enum Gesto { Correggi, Togli }

    [Parameter] public Vipi.SectorLab.Core.PdfAip.VoceDellAip? Voce { get; set; }

    [Parameter] public string? Ciclo { get; set; }

    /// <summary>L'area della voce, se la voce è un'area: allora si corregge col suo modulo.</summary>
    [Parameter] public Aip.Airspace? Area { get; set; }

    /// <summary>La voce del modello, se non è un'area (slice 3): si corregge col modulo generale.</summary>
    [Parameter] public (Aip.CorrectionKind Tipo, object Voce)? Modello { get; set; }

    /// <summary>La correzione in piedi che ha fatto la voce, o null.</summary>
    [Parameter] public Aip.AipCorrection? Correzione { get; set; }

    private Gesto? _cosa;
    private object? _di;
    private string? _perche;
    private string? _fonte;
    private string? _rifiuto;

    protected override void OnParametersSet()
    {
        // Un'altra voce scelta: i moduli aperti per quella di prima si chiudono.
        object? ora = (object?)Area ?? Modello?.Voce;
        if (ReferenceEquals(_di, ora)) return;
        _di = ora;
        _cosa = null;
        _rifiuto = null;
    }

    private void Apri(Gesto cosa)
    {
        _cosa = cosa;
        _rifiuto = null;
    }

    private void Chiudi()
    {
        _cosa = null;
        _rifiuto = null;
    }

    private async Task Togli()
    {
        var fatto = Area is { } area
            ? await Lab.TogliLAreaAsync(area.Key, _perche, _fonte)
            : Modello is var (tipo, voce) && await Lab.TogliLaVoceAsync(tipo, Aip.AipCorrections.KeyOf(voce), _perche, _fonte);
        if (fatto)
            Chiudi();
        else
            _rifiuto = Lab.Rifiuto;
    }

    private async Task Ritira(string id) => _rifiuto = await Lab.RitiraLaCorrezioneAsync(id) ? null : Lab.Rifiuto;

    /// <summary>Il campo dice «riferimento (data)»: la pagina si cerca col riferimento.</summary>
    private void ApriLaPagina(string ciclo, string campo)
    {
        var parentesi = campo.IndexOf(" (", StringComparison.Ordinal);
        _rifiuto = Lab.ApriLaPaginaDellAip(ciclo, parentesi < 0 ? campo : campo[..parentesi]) ? null : Lab.Rifiuto;
    }
}
