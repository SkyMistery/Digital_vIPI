@inject SessioneDelLab Lab

@*
    Un problema, in una riga: gravità, file e riga, regola, dettaglio, e il testo della riga. Il clic porta lì (slice 10).
    Sotto, il gesto che lo risolve, se c'è: i commenti in coda del file spostati sopra (lotto «Subito» slice 2a).
*@
<button class="lab-problema @(Problema.Gravita == Gravita.Errore ? "lab-problema-errore" : "lab-problema-avviso")"
        @onclick="() => Lab.VaiAlProblema(Problema)"
        title="@(Problema.Record is null ? "Apre il file" : "Apre il record, sulla mappa e nell'ispettore")"
        data-problema="@Problema.Problema.Regola" data-file="@Problema.File" data-riga="@Problema.Problema.Riga">
    <span class="lab-problema-dove">@Problema.Nome@(Problema.Problema.Riga > 0 ? $":{Problema.Problema.Riga}" : "")</span>
    <span class="lab-problema-regola">@Problema.Problema.Regola</span>
    <span class="lab-nota">@Problema.Problema.Dettaglio</span>
    @if (Problema.Problema.Testo.Length > 0)
    {
        <code>@Problema.Problema.Testo</code>
    }
</button>
@if (Problema.Problema.Regola == Regola.CommentoInCoda)
{
    <button class="lab-tasto lab-tasto-tenue lab-gesto-del-problema" @onclick="SpostaSopra" data-tasto="sposta-commenti"
            title="Ogni commento in coda del file va sulla riga sopra la sua: una voce nelle modifiche, si annulla">
        Sposta sopra i commenti di @Problema.Nome
    </button>
}
else if (Problema.Problema.Proposta is { } proposta)
{
    <div class="lab-gesto-del-problema" data-proposta="@Problema.Problema.Riga">
        <code class="lab-riga-aggiunta">@proposta</code>
        <button class="lab-tasto lab-tasto-tenue" @onclick="Correggi" data-tasto="correggi"
                title="La riga diventa questa: una voce nelle modifiche, si annulla">
            Correggi la riga
        </button>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProblemaNelLab Problema { get; set; } = null!;

    private void SpostaSopra() => Lab.SpostaICommentiSopra(Problema.File);

    private void Correggi() => Lab.Correggi(Problema);
}
