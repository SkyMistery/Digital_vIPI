@implements IDisposable
@inject SessioneDelLab Lab
@using Vipi.SectorLab.Core.PdfAip

@*
    L'indice dell'AIP espanso (riordino delle pagine, D9): le voci come nell'AIP — ENR 2, ENR 3, ENR 4, ENR 5, AD 2 —,
    sezione per sezione, AD 2 scalo per scalo. Un clic sceglie la voce: la scheda accanto, la forma inquadrata sulla
    mappa. Entrando nella pagina lo strato dell'AIP si carica da sé (è lo stesso di «Mostra l'AIP espanso sulla mappa»).
*@
<div class="lab-indice-aip" data-indice-aip>
    <h2 class="lab-riquadro-titolo">AIP espanso @(Lab.StratoDellAip is { } s ? $"· ciclo {s.Ciclo}" : "")</h2>
    @* I cicli (26 ottobre, committente: il ciclo di lavoro lo sceglie lui): che cos'è quello mostrato, e gli altri su cui passare. *@
    @if (Lab.StratoDellAip is { } mostrato)
    {
        <p class="lab-nota" data-ciclo-indice>@Lab.StatoDeiCicliDellAip.Dice(mostrato.Ciclo)
            @foreach (var altro in Lab.CicliConIlModello.Where(c => c != mostrato.Ciclo))
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="lavora-sul-ciclo" data-lavora="@altro"
                        title="Indice, mappa, correzioni e confronti col sector useranno il @altro" @onclick="() => Lab.LavoraSulCicloAsync(altro)">Lavora sul @altro</button>
            }
        </p>
    }
    else if (Lab.CartellaDellAipEspanso is not null && Lab.CicloDiLavoro is null && Lab.CicliConIlModello.Count > 1)
    {
        <p class="lab-nota" data-scegli-ciclo>Su quale ciclo lavori?
            @foreach (var c in Lab.CicliConIlModello)
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="lavora-sul-ciclo" data-lavora="@c"
                        @onclick="() => Lab.LavoraSulCicloAsync(c)">@c · @Lab.StatoDeiCicliDellAip.Dice(c)</button>
            }
        </p>
    }
    @* Dal 22 ottobre qui, non più in «Lettura e consegna» (che non ha la mappa): la casella dello strato e «Aggiungi». *@
    @if (Lab.CartellaDellAipEspanso is not null)
    {
        <div data-aip-sulla-mappa>
            <label class="lab-nota">
                <input type="checkbox" data-casella="aip-sulla-mappa" checked="@Lab.Accesi.Contains(AipSullaMappa.Tipo.Id)"
                       disabled="@(Lab.Sessione is null)" @onchange="e => Mostra(e.Value is true)" />
                Mostra l'AIP espanso sulla mappa
            </label>
            @if (Lab.StratoDellAip is { } stratoMostrato)
            {
                <span class="lab-nota" data-aip-strato> · ciclo @stratoMostrato.Ciclo, @stratoMostrato.Strato.Forme.Count forme@(Attese(stratoMostrato) is var (nonDisegnate, tutte) && nonDisegnate > 0 ? $" ({nonDisegnate} attese su {tutte} senza il punto nel sector)" : ""): i tipi si accendono negli Strati</span>
                @* Le correzioni (slice 2 e 3): una voce si corregge dalla sua scheda; una che il PDF non ha si aggiunge da qui. *@
                @if (_aggiungi is Aip.CorrectionKind.Airspace)
                {
                    <ModuloDellArea Chiuso="() => _aggiungi = null" />
                }
                else if (_aggiungi is { } tipo)
                {
                    <ModuloDiUnaVoce Tipo="tipo" Iniziali="_iniziali" PercheIniziale="@_percheIniziale" Chiuso="ChiudiLAggiunta" />
                }
                else
                {
                    <span class="lab-nota" data-aggiungi>
                        <select class="lab-campo" data-campo="aggiungi-tipo" value="@_tipoDaAggiungere"
                                @onchange="e => _tipoDaAggiungere = Enum.TryParse<Aip.CorrectionKind>(e.Value?.ToString(), out var t) ? t : _tipoDaAggiungere">
                            @foreach (var t in Enum.GetValues<Aip.CorrectionKind>())
                            {
                                <option value="@t">@CorrezioniDellAip.Nome(t)</option>
                            }
                        </select>
                        <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="aggiungi-area"
                                title="Una voce che il PDF non ha (AIP SUP, AIC…): va nell'AIP espanso del ciclo @stratoMostrato.Ciclo, con la sua fonte" @onclick="() => _aggiungi = _tipoDaAggiungere">Aggiungi</button>
                    </span>
                }
            }
            @if (_rifiutoDellaMappa is not null)
            {
                <p class="lab-avviso-breve" data-rifiuto-aip>@_rifiutoDellaMappa</p>
            }
        </div>
    }
    @if (Lab.StratoDellAip is not { } strato)
    {
        @if (_caricando)
        {
            <p class="lab-nota">Leggo l'AIP espanso…</p>
        }
        else if (Lab.CartellaDellAipEspanso is null)
        {
            <p class="lab-nota" data-indice-senza-aip>Manca la cartella dell'AIP espanso: sceglila nelle
                <button class="lab-voce" @onclick="() => Lab.ScegliLaPagina(PaginaDelLab.Impostazioni)">Impostazioni</button>, o prendila in
                <button class="lab-voce" @onclick="() => Lab.ScegliLaPagina(PaginaDelLab.Aip)">Lettura e consegna</button>.</p>
        }
        else
        {
            <p class="lab-nota" data-indice-senza-aip>@(Lab.Rifiuto ?? "L'AIP espanso non è ancora sulla mappa.")</p>
            <button class="lab-tasto lab-tasto-tenue" @onclick="CaricaAsync" data-tasto="carica-aip">Riprova</button>
        }
    }
    else
    {
        <input class="lab-cerca" type="search" placeholder="Cerca una voce (LI R12, M726, LIRF, ELKAP…)"
               @bind="_filtro" @bind:event="oninput" data-campo="cerca-aip" />
        @foreach (var parte in Indice(strato))
        {
            <details class="lab-indice-parte" open data-parte="@parte.Codice">
                <summary><strong>@parte.Codice</strong> @parte.Nome <span class="lab-nota">@parte.Quante.ToString("N0")</span></summary>
                @foreach (var gruppo in parte.Gruppi)
                {
                    @Gruppo(gruppo)
                }
            </details>
        }
        @if (_indice is { Count: 0 })
        {
            <p class="lab-nota">Nessuna voce con «@_filtro».</p>
        }
    }
</div>

@code {
    private string? _filtro;
    private bool _caricando;

    private StratoDellAip? _di;
    private string? _filtroDi;
    private IReadOnlyList<GruppoDellIndice>? _indice;

    /// <summary>L'indice si rifà solo se cambia lo strato (un ciclo nuovo, una correzione) o il filtro.</summary>
    private IReadOnlyList<GruppoDellIndice> Indice(StratoDellAip strato)
    {
        if (_indice is null || !ReferenceEquals(_di, strato) || _filtroDi != _filtro)
        {
            _indice = IndiceDellAip.Di(strato.Voci, _filtro);
            _di = strato;
            _filtroDi = _filtro;
            _indiciDeiGruppi.Clear();
        }
        return _indice;
    }

    private readonly Dictionary<GruppoDellIndice, IReadOnlyList<int>> _indiciDeiGruppi = new(ReferenceEqualityComparer.Instance);

    /// <summary>Le voci di un gruppo, a ogni livello: si contano a ogni disegno, si cercano una volta per indice.</summary>
    private IReadOnlyList<int> Indici(GruppoDellIndice gruppo)
    {
        if (!_indiciDeiGruppi.TryGetValue(gruppo, out var indici))
            _indiciDeiGruppi[gruppo] = indici = [.. gruppo.Indici];
        return indici;
    }

    private RenderFragment Gruppo(GruppoDellIndice gruppo) => __builder =>
    {
        var indici = Indici(gruppo);
        var accese = Lab.QuanteVociDellAipAccese(indici);
        <details class="lab-indice-gruppo" open="@Aperto(gruppo)" data-gruppo="@gruppo.Codice">
            <summary>
                @* 26 ottobre (committente: «accendere la singola procedura o la singola area»): un gruppo — uno scalo, le sue SID,
                   una sezione — si accende e si spegne sulla mappa tutto insieme, qualunque sia il genere negli Strati. *@
                <input type="checkbox" class="lab-indice-accesa" data-accendi-gruppo="@gruppo.Codice" checked="@(accese == indici.Count)"
                       title="@(accese == indici.Count ? "Tutte accese sulla mappa: spegnile" : accese == 0 ? "Spente sulla mappa: accendile" : $"{accese} su {indici.Count} accese sulla mappa: accendile tutte")"
                       @onchange="e => Lab.AccendiLeVociDellAip(indici, e.Value is true)" />
                <span class="lab-indice-codice">@gruppo.Codice.Split('/')[^1]</span>
                @if (gruppo.Nome.Length > 0 && !gruppo.Codice.EndsWith(gruppo.Nome, StringComparison.Ordinal))
                {
                    <span>@gruppo.Nome</span>
                }
                <span class="lab-nota">@gruppo.Quante.ToString("N0")</span>
            </summary>
            @foreach (var voce in gruppo.Voci)
            {
                <button class="lab-voce lab-indice-voce @(Lab.SceltaDellAip == voce.Indice ? "lab-scelto" : null)"
                        @onclick="() => Scegli(voce)" title="@voce.Genere" data-voce-aip="@voce.Indice">@voce.Titolo</button>
            }
            @foreach (var sotto in gruppo.Gruppi)
            {
                @Gruppo(sotto)
            }
        </details>
    };

    /// <summary>Aperto se si sta cercando, o se dentro c'è la voce scelta (anche quando la si è scelta dalla mappa).</summary>
    private bool Aperto(GruppoDellIndice gruppo) =>
        !string.IsNullOrWhiteSpace(_filtro) || (Lab.SceltaDellAip is { } i && Contiene(gruppo, i));

    private static bool Contiene(GruppoDellIndice gruppo, int indice) =>
        gruppo.Voci.Any(v => v.Indice == indice) || gruppo.Gruppi.Any(g => Contiene(g, indice));

    private void Scegli(VoceDellIndice voce)
    {
        if (Lab.StratoDellAip is { } strato)
            Lab.Scegli(strato.File, voce.Indice);
    }

    protected override async Task OnInitializedAsync()
    {
        Lab.Cambiata += Aggiorna;
        if (Lab.StratoDellAip is null && Lab.CartellaDellAipEspanso is not null)
            await CaricaAsync();
        PrendiLAggiunta();
    }

    private IReadOnlyDictionary<string, string>? _iniziali;
    private string? _percheIniziale;

    /// <summary>«Aggiungi AJO» da una segnalazione (26 ottobre): il modulo si apre col tipo, la sigla e il perché già scritti.</summary>
    private void PrendiLAggiunta()
    {
        if (Lab.AggiuntaRichiesta is not var (tipo, nome, perche) || Lab.StratoDellAip is null)
            return;
        Lab.AggiuntaPresa();
        _aggiungi = tipo;
        _iniziali = new Dictionary<string, string>(StringComparer.Ordinal) { ["designator"] = nome };
        _percheIniziale = perche;
    }

    private void ChiudiLAggiunta()
    {
        _aggiungi = null;
        _iniziali = null;
        _percheIniziale = null;
    }

    private async Task CaricaAsync()
    {
        _caricando = true;
        await Lab.MostraLAipAsync(true);
        _caricando = false;
    }

    private void Aggiorna() => InvokeAsync(() =>
    {
        PrendiLAggiunta();
        StateHasChanged();
    });

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private Aip.CorrectionKind? _aggiungi;
    private Aip.CorrectionKind _tipoDaAggiungere = Aip.CorrectionKind.Airspace;
    private string? _rifiutoDellaMappa;

    private async Task Mostra(bool mostra) => _rifiutoDellaMappa = await Lab.MostraLAipAsync(mostra) ? null : Lab.Rifiuto;

    private static (int NonDisegnate, int Tutte) Attese(StratoDellAip strato)
    {
        var attese = strato.Strato.Forme.Where(f => f.Genere == AipSullaMappa.Attese).ToList();
        return (attese.Count(f => f.Tratti.Count == 0), attese.Count);
    }
}
