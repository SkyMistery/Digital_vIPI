@page "/pannelli"
@implements IDisposable
@inject SessioneDelLab Lab

@*
    La finestra dei pannelli, per lavorare con due schermi (chiesto dal committente il 23 settembre): i pannelli della
    pagina scelta (riordino delle pagine, D3) — per Sector, Sfoglia e Problemi, la scheda del record scelto, le
    modifiche col diff. La mappa e gli strati restano nella finestra principale; la barra è la stessa. Lo stato è uno
    solo, SessioneDelLab: una forma scelta sulla mappa si apre qui, un record scelto qui si evidenzia là. La apre e la chiude il guscio (Finestra.cs), che dice al Lab quando c'è.
*@
<PageTitle>Aurora Sector Lab — pannelli</PageTitle>

@if (Lab.Stato is StatoDelLab.Aperta)
{
    <div class="lab-schermo">
        <BarraDelLab />
        <div class="lab-corpo lab-pannelli" data-pannelli="si" data-pagina-corpo="@Lab.Pagina.ToString().ToLowerInvariant()">
            <PannelliDellaPagina NellaFinestraDeiPannelli="true" />
        </div>
    </div>
}
else
{
    <main class="lab-vuoto">
        <h1>Aurora Sector Lab</h1>
        <p class="lab-nota" data-stato="senza-cartella">Apri la cartella del sector dalla finestra principale: i pannelli la seguono.</p>
    </main>
}

@code {
    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
