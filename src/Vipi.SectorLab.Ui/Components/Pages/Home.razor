@page "/"
@implements IDisposable
@inject IJSRuntime Js
@inject SessioneDelLab Lab

<PageTitle>Aurora Sector Lab</PageTitle>

@if (Lab.Stato is StatoDelLab.Aperta)
{
    <div class="lab-schermo">
        <header class="lab-barra">
            <strong>Aurora Sector Lab</strong>
            <span class="lab-nota" data-barra="numeri">
                @Lab.Sessione!.File.Count file · @Lab.Sessione.RecordTotali.ToString("N0") record ·
                @Forme.ToString("N0") forme · @Punti.ToString("N0") punti · @Lab.Durata.TotalSeconds.ToString("0.0") s
            </span>
            <span class="lab-nota" data-barra="problemi">
                @(Lab.StaValidando ? "validazione…" : $"{Errori} errori · {Avvisi} avvisi")
            </span>
            @if (Lab.Cataloghi.Count > 1)
            {
                <label class="lab-isc">
                    Nomi risolti con
                    <select value="@Lab.IscScelto" @onchange="CambiaIsc" data-campo="isc">
                        @foreach (var isc in Lab.Cataloghi.OrderBy(c => c.Key, StringComparer.Ordinal))
                        {
                            <option value="@isc.Key" selected="@(isc.Key == Lab.IscScelto)">@isc.Key (@isc.Value.Punti.ToString("N0") punti)</option>
                        }
                    </select>
                </label>
            }
            <Storia />
            @if (Lab.PannelliInUnAltraFinestra)
            {
                <button class="lab-tasto lab-tasto-tenue" @onclick="RiportaIPannelli" data-tasto="riporta"
                        title="Chiude la finestra dei pannelli e li rimette qui, accanto alla mappa">Pannelli qui</button>
            }
            else
            {
                <button class="lab-tasto lab-tasto-tenue" @onclick="StaccaIPannelli" data-tasto="stacca"
                        title="Sfoglia, Problemi, la scheda e le modifiche in un'altra finestra (per esempio sull'altro schermo); qui resta la mappa">Pannelli in un'altra finestra</button>
            }
            <button class="lab-tasto lab-tasto-tenue" @onclick="Lab.ApriIlRegistro" data-tasto="registro"
                    title="Apre la cartella del registro: @Lab.Registro.Cartella — il file di oggi racconta ogni gesto e ogni errore">Registro</button>
            <TastoDelTema />
            <button class="lab-tasto" @onclick="Chiudi" data-tasto="cambia-cartella">Cambia cartella…</button>
        </header>

        <div class="lab-corpo">
            @* Coi due schermi i pannelli stanno nell'altra finestra (/pannelli): qui restano mappa e strati. *@
            @if (!Lab.PannelliInUnAltraFinestra)
            {
                <ColonnaDiSinistra />
                @* Ogni divisore allarga o stringe la colonna alla sua SINISTRA (sectorlab.js): il nome è la chiave della larghezza. *@
                <div class="lab-divisore" data-divide="sfoglia" title="Trascina per allargare; doppio clic per la larghezza di base"></div>

                <aside class="lab-colonna lab-colonna-ispettore">
                    <Scheda />
                    <Modifiche />
                </aside>
                <div class="lab-divisore" data-divide="ispettore" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
            }

            <aside class="lab-strati">
                <h2>Strati</h2>
                @foreach (var strato in Lab.Strati)
                {
                    <label class="lab-strato @(strato.Forme.Count == 0 ? "lab-strato-vuoto" : null)">
                        <input type="checkbox"
                               checked="@Lab.Accesi.Contains(strato.Id)"
                               disabled="@(strato.Tipo.Sfondo || strato.Forme.Count == 0)"
                               @onchange="e => Accendi(strato.Id, e)"
                               data-strato="@strato.Id" />
                        <span class="lab-pallino" data-strato-colore="@strato.Id"></span>
                        <span>@strato.Tipo.Nome</span>
                        <span class="lab-nota">@strato.Forme.Count.ToString("N0")</span>
                    </label>
                }

                @if (Lab.InVista.Count > 0)
                {
                    @* La vista: la mappa mostra solo questi (e le coste). Un clic sulla × toglie; «Tutto» torna agli strati. *@
                    <div class="lab-vista" data-vista="@Lab.InVista.Count">
                        <h2>In vista <span class="lab-nota">@Lab.InVista.Count</span>
                            <button class="lab-annulla" @onclick="Lab.SvuotaLaVista" data-tasto="vista-tutto"
                                    title="La mappa torna a mostrare tutti gli strati accesi">mostra tutto</button></h2>
                        @foreach (string chiave in Lab.InVista)
                        {
                            int cancelletto = chiave.LastIndexOf('#');
                            string file = chiave[..cancelletto];
                            int? record = chiave[(cancelletto + 1)..] is "*" ? null : int.Parse(chiave[(cancelletto + 1)..], System.Globalization.CultureInfo.InvariantCulture);
                            <p class="lab-voce-in-vista" data-in-vista="@chiave">
                                @if (record is { } r)
                                {
                                    <button class="lab-voce" @onclick="() => Lab.Scegli(file, r)">@Lab.NomeInVista(chiave)</button>
                                }
                                else
                                {
                                    <span>@Lab.NomeInVista(chiave)</span>
                                }
                                <button class="lab-annulla" @onclick="() => Lab.CambiaLaVista(file, record)" title="Toglilo dalla vista">×</button>
                            </p>
                        }
                    </div>
                }

                @if (Scelta is { } scelta)
                {
                    @* Solo i numeri della forma: chi l'ha scelta la legge per intero nell'ispettore, a sinistra. *@
                    <p class="lab-nota lab-scelta" data-scelta="@($"{scelta.File}#{scelta.Record}")">
                        Scelto: <span class="lab-etichetta">@scelta.Etichetta</span> · @scelta.Punti.ToString("N0") punti
                    </p>
                }
            </aside>
            <div class="lab-divisore" data-divide="strati" title="Trascina per allargare; doppio clic per la larghezza di base"></div>

            <Mappa />
        </div>
    </div>
}
else
{
    <main class="lab-vuoto">
        <h1>Aurora Sector Lab</h1>
        <p>Apri la cartella del clone del sector: quella che contiene <code>SectorFiles/</code>.</p>
        <div class="lab-apri">
            <input type="text" @bind="_percorso" @bind:event="oninput" placeholder="D:\…\it-aurora-sector"
                   disabled="@(Lab.Stato is StatoDelLab.InApertura)" data-campo="cartella" />
            <button class="lab-tasto" @onclick="Apri"
                    disabled="@(Lab.Stato is StatoDelLab.InApertura || string.IsNullOrWhiteSpace(_percorso))"
                    data-tasto="apri">Apri</button>
        </div>

        @if (Lab.Stato is StatoDelLab.InApertura)
        {
            <p class="lab-nota" data-stato="apertura">Lettura dell'albero…</p>
        }
        else if (Lab.Errore is { } errore)
        {
            <p class="lab-errore" data-stato="errore">@errore</p>
        }
        else
        {
            <p class="lab-nota">
                @if (_interattivo)
                {
                    <span data-stato="interattivo">Pronto.</span>
                }
                else
                {
                    <span data-stato="caricamento">Avvio…</span>
                }
            </p>
        }
    </main>
}

@code {
    private bool _interattivo;
    private string? _percorso;

    private int Errori => Lab.ProblemiDellAlbero.Count(p => p.Gravita == Gravita.Errore);

    private int Avvisi => Lab.ProblemiDellAlbero.Count - Errori;

    private int Forme => Lab.Strati.Sum(s => s.Forme.Count);

    private int Punti => Lab.Strati.Sum(s => s.Punti);

    private FormaDellaMappa? Scelta => Lab.FormaScelta();

    protected override void OnInitialized()
    {
        Lab.Cambiata += Aggiorna;
        _percorso = Lab.UltimaCartella();
    }

    protected override async Task OnAfterRenderAsync(bool primo)
    {
        if (!primo) return;
        _interattivo = true;
        StateHasChanged();
        // Dice alla finestra che il circuito è vivo: è il momento che il guscio misura (e la prova d'avvio aspetta).
        await Js.InvokeVoidAsync("sectorlab.pronto");
    }

    private Task Apri() => Lab.ApriAsync(_percorso);

    private void Chiudi() => Lab.Chiudi();

    /// <summary>
    /// La finestra dei pannelli la apre il guscio (una window.open che la WebView2 gli passa); in un browser qualunque
    /// si apre come scheda nuova, e funziona lo stesso: lo stato è del server.
    /// </summary>
    private async Task StaccaIPannelli() => await Js.InvokeVoidAsync("sectorlab.staccaIPannelli");

    /// <summary>Chiede al guscio di chiudere la finestra dei pannelli: sarà lui, chiudendola, a dire «di nuovo qui».</summary>
    private async Task RiportaIPannelli() => await Js.InvokeVoidAsync("sectorlab.riportaIPannelli");

    private void Accendi(string strato, ChangeEventArgs e) => Lab.Accendi(strato, e.Value is true);

    private Task CambiaIsc(ChangeEventArgs e) => Lab.ScegliIscAsync(e.Value?.ToString() ?? "");

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
