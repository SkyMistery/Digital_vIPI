@page "/"
@implements IDisposable
@inject IJSRuntime Js
@inject SessioneDelLab Lab

<PageTitle>Aurora Sector Lab</PageTitle>

@if (Lab.Stato is StatoDelLab.Aperta)
{
    <div class="lab-schermo">
        <BarraDelLab Principale="true" />

        <div class="lab-corpo" data-pagina-corpo="@Lab.Pagina.ToString().ToLowerInvariant()">
            @* Coi due schermi i pannelli della pagina stanno nell'altra finestra (/pannelli): qui restano mappa e strati. *@
            @if (!Lab.PannelliInUnAltraFinestra)
            {
                <PannelliDellaPagina />
            }

            @* La mappa non si smonta mai (D2): Consegna e Impostazioni la nascondono soltanto, e tornando a Sector o AIP
               strati, vista e scelta sono quelli di prima. Con display:contents i figli restano colonne di .lab-corpo. *@
            <div class="lab-con-la-mappa @(MappaNascosta ? "lab-nascosto" : null)" data-mappa-nascosta="@(MappaNascosta ? "si" : "no")">
            <aside class="lab-strati">
                <Sezione Chiave="strati">
                <Titolo>Strati</Titolo>
                <ChildContent>
                @foreach (var strato in Lab.StratiDaMostrare)
                {
                    <label class="lab-strato @(strato.Forme.Count == 0 ? "lab-strato-vuoto" : null)">
                        <input type="checkbox"
                               checked="@Lab.Accesi.Contains(strato.Id)"
                               disabled="@(strato.Tipo.Sfondo || strato.Forme.Count == 0)"
                               @onchange="e => Accendi(strato.Id, e)"
                               data-strato="@strato.Id" />
                        <span class="lab-pallino" data-strato-colore="@strato.Id"></span>
                        <span>@strato.Tipo.Nome</span>
                        <span class="lab-nota">@strato.Forme.Count.ToString("N0")</span>
                    </label>
                    @* Slice 12c (H1): i generi dello strato acceso — assi, bordi, edifici, marcature… — uno per casella. *@
                    @if (Lab.Accesi.Contains(strato.Id) && Lab.GeneriDi(strato.Id) is { Count: > 0 } generi)
                    {
                        <div class="lab-generi" data-generi="@strato.Id">
                            @foreach (var genere in generi)
                            {
                                string stratoId = strato.Id, genereId = genere.Id;
                                <label class="lab-strato lab-genere">
                                    <input type="checkbox" checked="@Lab.GenereAcceso(stratoId, genereId)"
                                           @onchange="e => Lab.AccendiIlGenere(stratoId, genereId, e.Value is true)"
                                           data-genere="@($"{stratoId}:{genereId}")" />
                                    <span>@genere.Nome</span>
                                    <span class="lab-nota">@genere.Forme.ToString("N0")</span>
                                </label>
                            }
                        </div>
                    }
                }
                </ChildContent>
                </Sezione>

                @* I colori della mappa (lotto «Subito» slice 4, D3): quelli di Aurora dallo schema scelto, o quelli del Lab. *@
                <Sezione Chiave="colori">
                <Titolo>Colori</Titolo>
                <ChildContent>
                <div class="lab-colori" data-colori="@(Lab.ColoriDiAurora ? "aurora" : "lab")">
                    <label class="lab-strato">
                        <input type="radio" name="lab-colori" checked="@Lab.ColoriDiAurora" disabled="@(Lab.Colori is null)"
                               @onchange="() => Lab.UsaIColoriDiAurora(true)" data-tasto="colori-aurora" />
                        <span>di Aurora</span>
                    </label>
                    <label class="lab-strato">
                        <input type="radio" name="lab-colori" checked="@(!Lab.ColoriDiAurora)"
                               @onchange="() => Lab.UsaIColoriDiAurora(false)" data-tasto="colori-lab" />
                        <span>del Lab</span>
                    </label>
                    @if (Lab.SchemiDisponibili.Count > 0)
                    {
                        <select class="lab-schema" data-schema="@Lab.SchemaScelto" @onchange="ScegliSchema"
                                title="Lo schema di Aurora (ColourSchemes della cartella di Aurora, nelle Impostazioni): lo stesso che si usa in Aurora">
                            @foreach (string schema in Lab.SchemiDisponibili)
                            {
                                <option value="@schema" selected="@(schema == Lab.SchemaScelto)">@schema</option>
                            }
                        </select>
                    }
                    @if (Lab.ColoriMancanti is { } mancanti)
                    {
                        <p class="lab-nota">@mancanti</p>
                    }
                </div>
                </ChildContent>
                </Sezione>

                @if (Lab.InVista.Count > 0)
                {
                    @* La vista: la mappa mostra solo questi (e le coste). Un clic sulla × toglie; «Tutto» torna agli strati. *@
                    <div class="lab-vista" data-vista="@Lab.InVista.Count">
                        <Sezione Chiave="vista">
                        <Titolo>In vista <span class="lab-nota">@Lab.InVista.Count</span></Titolo>
                        <Accanto>
                            <button class="lab-annulla" @onclick="Lab.SvuotaLaVista" data-tasto="vista-tutto"
                                    title="La mappa torna a mostrare tutti gli strati accesi">mostra tutto</button>
                        </Accanto>
                        <ChildContent>
                        @foreach (string chiave in Lab.InVista)
                        {
                            int cancelletto = chiave.LastIndexOf('#');
                            string file = chiave[..cancelletto];
                            int? record = chiave[(cancelletto + 1)..] is "*" ? null : int.Parse(chiave[(cancelletto + 1)..], System.Globalization.CultureInfo.InvariantCulture);
                            <p class="lab-voce-in-vista" data-in-vista="@chiave">
                                @if (record is { } r)
                                {
                                    <button class="lab-voce" @onclick="() => Lab.Scegli(file, r)">@Lab.NomeInVista(chiave)</button>
                                }
                                else
                                {
                                    <span>@Lab.NomeInVista(chiave)</span>
                                }
                                <button class="lab-annulla" @onclick="() => Lab.CambiaLaVista(file, record)" title="Toglilo dalla vista">×</button>
                            </p>
                        }
                        </ChildContent>
                        </Sezione>
                    </div>
                }

                @if (Scelta is { } scelta)
                {
                    @* Solo i numeri della forma: chi l'ha scelta la legge per intero nell'ispettore, a sinistra. *@
                    <p class="lab-nota lab-scelta" data-scelta="@($"{scelta.File}#{scelta.Record}")">
                        Scelto: <span class="lab-etichetta">@scelta.Etichetta</span> · @scelta.Punti.ToString("N0") punti
                    </p>
                }
            </aside>
            <div class="lab-divisore" data-divide="strati" title="Trascina per allargare; doppio clic per la larghezza di base"></div>

            @* R4 (D15): una mappa per spazio di lavoro, sullo stesso motore. Una nasce la prima volta che si entra nel suo
               spazio e poi resta, nascosta quando lo spazio è un altro: strati, vista, zoom e scelta sono quelli di prima. *@
            @foreach (var spazio in SpaziConLaMappa())
            {
                <div class="lab-mappa-dello-spazio @(spazio == Lab.SpazioAttivo ? null : "lab-nascosto")" data-mappa-dello-spazio="@spazio.ToString().ToLowerInvariant()">
                    <Mappa @key="spazio" Spazio="spazio" />
                </div>
            }
            </div>
        </div>
    </div>
}
else
{
    bool primoAvvio = Lab.CartellaDiLavoro is null;
    <main class="lab-vuoto">
        <h1>Aurora Sector Lab</h1>
        @* Il primo avvio (20 ottobre): tutto in un posto solo — i due link, una cartella di lavoro, un tasto. *@
        @if (primoAvvio)
        {
            <section class="lab-primo-avvio" data-primo-avvio>
                <h2>Primo avvio</h2>
                <p class="lab-nota">Incolla i link dei due repo (anche copiati dal browser) e scegli una cartella di lavoro: il Lab
                    ci prende il sector e l'AIP espanso e crea la cartella dove mettere i PDF dell'AIP Italia.</p>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Repo del sector</span>
                    <input type="text" class="lab-campo-largo" value="@Lab.IndirizzoDelSector" @onchange="e => Lab.CambiaLIndirizzoDelSector(e.Value?.ToString())"
                           disabled="@Lab.StaPrendendo" data-campo="primo-indirizzo-del-sector" />
                </label>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Repo dell'AIP espanso</span>
                    <input type="text" class="lab-campo-largo" value="@Lab.IndirizzoDellAipEspanso" @onchange="e => Lab.CambiaLIndirizzoDellAipEspanso(e.Value?.ToString())"
                           disabled="@Lab.StaPrendendo" data-campo="primo-indirizzo-aip" />
                </label>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Cartella di Aurora (profili e colori)</span>
                    <span class="lab-apri lab-apri-stretta">
                        <input type="text" value="@Lab.CartellaDiAurora" placeholder="@Vipi.SectorLab.Core.Mappa.SchemiDiAurora.CartellaDiAuroraDiBase"
                               @onchange="e => _rifiutoAurora = Lab.CambiaLaCartellaDiAurora(e.Value?.ToString()) ? null : Lab.Rifiuto"
                               disabled="@Lab.StaPrendendo" data-campo="primo-cartella-di-aurora" />
                        @if (Lab.ScegliCartella is not null)
                        {
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-primo-aurora" disabled="@Lab.StaPrendendo"
                                    title="Sceglie la cartella di Aurora in Esplora risorse" @onclick="SfogliaAurora">Sfoglia…</button>
                        }
                    </span>
                    <span class="lab-nota" data-cosa-ce-in-aurora>@CosaCeInAurora()</span>
                    @if (_rifiutoAurora is not null)
                    {
                        <span class="lab-avviso-breve">@_rifiutoAurora</span>
                    }
                </label>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Cartella di lavoro</span>
                    <span class="lab-apri lab-apri-stretta">
                        <input type="text" @bind="_lavoro" @bind:event="oninput" placeholder="D:\IVAO"
                               disabled="@Lab.StaPrendendo" data-campo="cartella-di-lavoro" />
                        @if (Lab.ScegliCartella is not null)
                        {
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-lavoro" disabled="@Lab.StaPrendendo"
                                    title="Sceglie (o crea) la cartella di lavoro in Esplora risorse" @onclick="SfogliaLavoro">Sfoglia…</button>
                        }
                        <button type="button" class="lab-tasto" @onclick="Prepara" data-tasto="prepara-tutto"
                                disabled="@(Lab.StaPrendendo || Lab.Stato is StatoDelLab.InApertura || string.IsNullOrWhiteSpace(_lavoro))">Prepara tutto</button>
                    </span>
                </label>
                @if (!string.IsNullOrWhiteSpace(_lavoro) && Path.IsPathFullyQualified(_lavoro.Trim()))
                {
                    var cartelle = Vipi.SectorLab.Core.Git.PrimoAvvio.CartelleDi(_lavoro);
                    <ul class="lab-nota" data-cartelle-del-primo-avvio>
                        <li><code>@cartelle.Sector</code> — il sector</li>
                        <li><code>@cartelle.AipEspanso</code> — l'AIP espanso</li>
                        <li><code>@cartelle.Pdf</code> — i PDF dell'AIP Italia (li scarichi tu da ENAV)</li>
                    </ul>
                }
                <p class="lab-nota">Le credenziali di GitHub non servono per un repo pubblico; per uno privato, e per mandare, le
                    chiederà git, nella sua finestra.</p>
            </section>
        }
        else
        {
            @* Il Lab lavora nel suo ambiente (committente, 20 ottobre: «più è isolato l'ambiente di lavoro meno casino
               facciamo»): niente «Apri» su una cartella qualsiasi né recenti; i sector sono quelli dell'ambiente. *@
            <section class="lab-recenti" data-ambiente>
                <h2>Ambiente di lavoro</h2>
                <p class="lab-nota"><code>@Lab.CartellaDiLavoro</code></p>
                @if (Lab.SectorDellAmbiente() is { Count: > 0 } sector)
                {
                    @foreach (string uno in sector)
                    {
                        string questo = uno;
                        <button type="button" class="lab-recente" data-apri-sector="@Path.GetFileName(questo)" disabled="@(Lab.Stato is StatoDelLab.InApertura || Lab.StaPrendendo)"
                                title="Apre questo sector" @onclick="() => Lab.ApriAsync(questo)">
                            <strong>@Path.GetFileName(questo)</strong>
                            <span class="lab-nota">@questo</span>
                        </button>
                    }
                }
                else
                {
                    <p class="lab-nota" data-ambiente-vuoto>Nell'ambiente non c'è nessun sector: prendilo qui sotto.</p>
                }
            </section>

            @* Un altro sector (il ciclo dopo, una prova) si prende solo dentro l'ambiente: basta il nome. *@
            <details class="lab-prendi" data-prendi open="@(Lab.SectorDellAmbiente().Count == 0)">
                <summary>Prendi un altro sector</summary>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Dal repo (il link di GitHub, anche copiato dal browser)</span>
                    <input type="text" class="lab-campo-largo" value="@Lab.IndirizzoDelSector" @onchange="e => Lab.CambiaLIndirizzoDelSector(e.Value?.ToString())"
                           disabled="@Lab.StaPrendendo" data-campo="indirizzo-del-sector" />
                </label>
                <label class="lab-campo-in-colonna">
                    <span class="lab-nota">Nome (diventa la sua cartella nell'ambiente: per esempio «ciclo-2611» o «prova»)</span>
                    <span class="lab-apri lab-apri-stretta">
                        <input type="text" @bind="_nomeDelSector" @bind:event="oninput" placeholder="ciclo-2611"
                               disabled="@Lab.StaPrendendo" data-campo="nome-del-sector" />
                        <button type="button" class="lab-tasto" @onclick="PrendiUnAltro" data-tasto="prendi"
                                disabled="@(Lab.StaPrendendo || Lab.Stato is StatoDelLab.InApertura || string.IsNullOrWhiteSpace(_nomeDelSector))">Prendi</button>
                    </span>
                </label>
                <p class="lab-nota">Scarica solo <code>SectorFiles</code> (con <code>ColorSchemes</code>, se c'è) e i file di oggi:
                    qualche secondo. Le credenziali di GitHub le chiede git, nella sua finestra, se servono.</p>
            </details>
        }

        @if (Lab.StaPrendendo)
        {
            <p class="lab-nota" data-stato="prendo">@(Lab.PassoDelPrimoAvvio ?? "Prendo il sector dal repo…")</p>
        }
        else if (Lab.Stato is StatoDelLab.InApertura)
        {
            <p class="lab-nota" data-stato="apertura">Lettura dell'albero…</p>
        }
        else if (Lab.Errore is { } errore)
        {
            <p class="lab-errore" data-stato="errore">@errore</p>
        }
        else
        {
            <p class="lab-nota">
                @if (_interattivo)
                {
                    <span data-stato="interattivo">Pronto.</span>
                }
                else
                {
                    <span data-stato="caricamento">Avvio…</span>
                }
            </p>
        }
    </main>
}

@code {
    private bool _interattivo;
    private string? _nomeDelSector;

    /// <summary>Gli spazi in cui si è già entrati: la loro mappa c'è (nascosta se non è quello attivo).</summary>
    private readonly HashSet<SpazioDiLavoro> _spaziVisti = [];

    private IEnumerable<SpazioDiLavoro> SpaziConLaMappa()
    {
        _spaziVisti.Add(Lab.SpazioAttivo);
        return Enum.GetValues<SpazioDiLavoro>().Where(_spaziVisti.Contains);
    }
    private string? _lavoro;

    private Task PrendiUnAltro() => Lab.PrendiUnAltroSectorAsync(_nomeDelSector);

    private Task Prepara() => Lab.PreparaIlPrimoAvvioAsync(_lavoro);

    private string? _rifiutoAurora;

    private async Task SfogliaAurora()
    {
        if (await Lab.ScegliCartella!("La cartella di Aurora (quella con ColourSchemes e Profiles)", Lab.CartellaDiAurora) is { } scelta)
            _rifiutoAurora = Lab.CambiaLaCartellaDiAurora(scelta) ? null : Lab.Rifiuto;
    }

    private string CosaCeInAurora() => Vipi.SectorLab.Core.Mappa.SchemiDiAurora.NellaCartellaDiAurora(Lab.CartellaDiAurora) switch
    {
        null => "Questa cartella non c'è: Aurora è installata? Di solito è " + Vipi.SectorLab.Core.Mappa.SchemiDiAurora.CartellaDiAuroraDiBase + ".",
        (0, 0) => "Qui non ci sono né schemi di colore né profili di Aurora.",
        var (schemi, profili) => $"Qui ci sono {schemi} schemi di colore e {profili} profili di Aurora.",
    };

    private async Task SfogliaLavoro()
    {
        if (await Lab.ScegliCartella!("La cartella di lavoro del Lab: dentro il sector, l'AIP espanso e i PDF", _lavoro) is { } scelta)
            _lavoro = scelta;
    }

    private void ScegliSchema(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } nome)
            Lab.ScegliSchema(nome);
    }

    private FormaDellaMappa? Scelta => Lab.FormaScelta();

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    protected override async Task OnAfterRenderAsync(bool primo)
    {
        if (!primo) return;
        _interattivo = true;
        StateHasChanged();
        // Dice alla finestra che il circuito è vivo: è il momento che il guscio misura (e la prova d'avvio aspetta).
        await Js.InvokeVoidAsync("sectorlab.pronto");
    }

    /// <summary>
    /// Consegna, Testo, Impostazioni e «Lettura e consegna» dell'AIP (22 ottobre) non hanno mappa: la nascondono, se non è
    /// in una finestra tutta sua.
    /// </summary>
    private bool MappaNascosta => !Lab.PannelliInUnAltraFinestra && Lab.Pagina is PaginaDelLab.Consegna or PaginaDelLab.Testo or PaginaDelLab.Impostazioni or PaginaDelLab.Aip;


    private void Accendi(string strato, ChangeEventArgs e) => Lab.Accendi(strato, e.Value is true);

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
