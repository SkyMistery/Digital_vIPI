@inject SessioneDelLab Lab

@*
    Un record nuovo (slice 8, rivisto dopo la prova 6 del committente, 23 settembre). Dalla scheda copia il record
    scelto; dal file (senza sceglierne uno) copia il vicino per nome, o l'ultimo. Nei file di punti col nome (fix, VOR,
    NDB, punti VFR) chiede il NOME, e il nuovo nasce già al suo posto in ordine alfabetico nella sua sezione — non
    sotto quello da cui è partito. Negli altri file va sotto il modello, come prima: l'ordine di ogni tipo di file
    si decide col committente, file per file.
    Lotto «Subito», slice 3e (A1): prima di tutto chiede il TIPO FISSO del nuovo, col suo significato — negli .artcc
    etichetta (L) o traccia (T), da scegliere per forza; negli altri file (tipo del fix, della voce .str, del segmento
    .geo…) parte dal tipo del record che si copia.
    Slice 16c (F3): un punto VFR chiede anche il CODICE, già scritto col primo numero libero dopo quello del punto da
    cui si parte; il punto nasce al suo posto in ordine di codice.
*@
@if (_chiede)
{
    <span class="lab-nuovo-record" data-nuovo-record="@(Modello is null ? "file" : "record")">
        @if (Scelta is { } scelta)
        {
            <select class="lab-campo" value="@(_tipo ?? "")" @ref="_campoDelTipo" title="@scelta.Domanda"
                    @onchange="SceltoIlTipo" data-campo="tipo-nuovo">
                <option value="">— @(scelta.Facoltativo ? "tipo non scritto" : scelta.Domanda)</option>
                @foreach (var voce in scelta.Valori)
                {
                    <option value="@voce.Valore">@voce.Voce</option>
                }
            </select>
        }
        @if (Campo is not null)
        {
            <input class="lab-campo" placeholder="@($"{Campo} del nuovo")" value="@_nome" @ref="_campo"
                   @oninput="e => _nome = e.Value?.ToString()" @onkeydown="Tasto" data-campo="nome-nuovo" />
        }
        @if (ChiedeIlCodice)
        {
            <input class="lab-campo lab-campo-corto" placeholder="Codice" value="@(_codice ?? Proposto)"
                   title="Il codice del punto (2° campo): è il nome del suo fix nascosto, e mette il punto in ordine nel file. Proposto: le lettere del punto da cui parti e il primo numero libero."
                   @oninput="e => _codice = e.Value?.ToString()" @onkeydown="Tasto" data-campo="codice-nuovo" />
        }
        <button class="lab-tasto" @onclick="Aggiungi" disabled="@(PercheNo is not null)"
                title="@(PercheNo ?? DoveVa)"
                data-tasto="aggiungi-con-nome">Aggiungi</button>
        <button class="lab-annulla" @onclick="() => _chiede = false" data-tasto="non-aggiungere">annulla</button>
        @if (Lab.Rifiuto is { } rifiuto)
        {
            <span class="lab-errore" data-rifiuto-nuovo="1">@rifiuto</span>
        }
    </span>
}
else
{
    <button class="lab-tasto lab-tasto-tenue" @onclick="Comincia"
            title="@(Modello is null ? "Un record nuovo in questo file, nella forma dei suoi vicini" : "Un record nuovo nella forma di questo")"
            data-tasto="@(Modello is null ? "aggiungi-al-file" : "aggiungi-record")">@(Modello is null ? "+ Nuovo record" : "+ Record come questo")</button>
}

@code {
    [Parameter, EditorRequired] public string File { get; set; } = null!;

    /// <summary>Il record da copiare; null = dal file.</summary>
    [Parameter] public int? Modello { get; set; }

    private bool _chiede;
    private string? _nome;
    private string? _tipo;

    /// <summary>Il codice scritto dall'AOD; null = quello proposto.</summary>
    private string? _codice;
    private ElementReference _campo;
    private ElementReference _campoDelTipo;
    private bool _mettiIlFuoco;

    private string? Campo => Lab.NomeDelRecordNuovo(File);

    private SceltaDelTipo? Scelta => Lab.TipoDelNuovoDi(File);

    private bool ChiedeIlCodice => Campo is not null && Lab.ChiedeIlCodice(File);

    private string? Proposto => Lab.CodiceProposto(File, Modello);

    private string DoveVa
        => Campo is null ? "Lo aggiunge sotto quello da cui parte"
            : ChiedeIlCodice ? "Lo mette al suo posto in ordine di codice"
            : "Lo mette al suo posto in ordine alfabetico";

    /// <summary>Perché «Aggiungi» non si può ancora premere, o null.</summary>
    private string? PercheNo
        => Scelta is { Facoltativo: false } scelta && _tipo is null ? $"Scegli prima: {scelta.Domanda.ToLowerInvariant()}"
            : Campo is not null && string.IsNullOrWhiteSpace(_nome) ? "Scrivi prima il nome"
            : null;

    private void Comincia()
    {
        if (Campo is null && Scelta is null)
        {
            if (Modello is { } modello)
                Lab.AggiungiRecord(File, modello);
            else
                Lab.AggiungiAlFile(File);
            return;
        }

        _chiede = true;
        _nome = null;
        _codice = null;
        // Il tipo del record da copiare, dove il tipo è un campo; negli .artcc la forma si sceglie sempre.
        _tipo = Scelta is { Proprieta: not null }
            ? Lab.TipoDelRecord(File, Modello ?? Lab.EtichetteDi(File).Count - 1)
            : null;
        _mettiIlFuoco = true;
    }

    private void SceltoIlTipo(ChangeEventArgs e) => _tipo = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();

    private void Aggiungi()
    {
        if (PercheNo is not null)
            return;
        string? nome = Campo is null ? null : (_nome ?? "").Trim();
        string? codice = ChiedeIlCodice ? _codice : null;
        bool fatto = Modello is { } modello ? Lab.AggiungiRecord(File, modello, nome, _tipo, codice) : Lab.AggiungiAlFile(File, nome, _tipo, codice);
        if (fatto)
            _chiede = false;
    }

    private void Tasto(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && PercheNo is null)
            Aggiungi();
        else if (e.Key == "Escape")
            _chiede = false;
    }

    protected override async Task OnAfterRenderAsync(bool primo)
    {
        if (!_mettiIlFuoco)
            return;
        _mettiIlFuoco = false;
        try
        {
            // Prima la domanda che manca: il tipo se non c'è, se no il nome.
            await (Scelta is { Facoltativo: false } && (_tipo is null || Campo is null) ? _campoDelTipo : _campo).FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Nei test (bUnit) non c'è un elemento vero da mettere a fuoco.
        }
    }
}
