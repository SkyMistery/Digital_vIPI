@inject SessioneDelLab Lab

@*
    La voce del record nella scheda (lotto «Subito» slice 6b, «file per file» H3, §M «nome di un pezzo»): come si chiama
    nella finestra di selezione di Aurora, e le sue parti di questo record col nome dal commento sopra — che qui si
    cambia. Il nome della voce dei confini, delle MVA, delle aerovie e delle aree è nelle righe di dati (il 2° campo, il
    6° delle aree): dalla slice 7f si rinomina anche quello, in tutte le righe della voce del file.
*@
@if (Lab.VoceDi(File, Record) is { } voce)
{
    var parti = voce.Parti.Where(p => p.Record == Record).ToList();
    <Sezione Chiave="scheda-voce" data-voce-scheda="@voce.Nome">
    <Titolo>Voce <span class="lab-nota">@voce.Nome@(voce.NomeMancante ? " · nome mancante" : "")</span></Titolo>
    <ChildContent>
    <table class="lab-campi">
        <tbody>
            @if (voce.NomeDalCommento)
            {
                <tr data-nome-voce="@voce.Nome">
                    <th title="Il commento sopra il gruppo: è il nome della voce (H3)">Nome del gruppo</th>
                    <td>
                        <input class="lab-campo @(voce.NomeMancante ? "lab-nome-mancante" : null)" value="@(voce.NomeMancante ? null : voce.Nome)"
                               placeholder="@(voce.NomeMancante ? voce.Nome : "—")" data-scrivi-nome="voce"
                               @onchange="e => Lab.CambiaIlNomeDellaVoce(File, voce, e.Value?.ToString())" />
                    </td>
                </tr>
            }
            else if (Lab.SiRinominaLaVoce(File, voce))
            {
                @* Slice 7f: il nome nelle righe di dati (2° campo, 6° delle aree) si rinomina in tutto il file. *@
                <tr data-nome-voce="@voce.Nome">
                    <th title="La voce della finestra di selezione di Aurora: il nome sta nelle righe di dati, e cambia in tutte le righe della voce del file (anche le nascoste)">Voce</th>
                    <td>
                        <input class="lab-campo" value="@voce.Nome" data-rinomina-voce="@voce.Nome"
                               @onchange="e => Lab.RinominaLaVoce(File, voce, e.Value?.ToString())" />
                        <span class="lab-nota">@Conto(voce)</span>
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <th title="La voce della finestra di selezione di Aurora: il nome sta nelle righe di dati">Voce</th>
                    <td>@voce.Nome <span class="lab-nota">@Conto(voce)</span></td>
                </tr>
            }
            @foreach (var parte in parti)
            {
                var questa = parte;
                <tr data-nome-parte="@parte.Chiave">
                    <th title="Il commento sopra la parte: il suo nome nell'elenco delle voci">@(parte.Poligono is { } p ? $"Poligono {p + 1}" : "Nome della parte")</th>
                    <td>
                        <input class="lab-campo" value="@parte.Nome" placeholder="senza nome" data-scrivi-nome="@parte.Chiave"
                               @onchange="e => Lab.CambiaIlNomeDellaParte(File, questa, e.Value?.ToString())" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </ChildContent>
    </Sezione>
}

@code {
    [Parameter, EditorRequired] public string File { get; set; } = null!;

    [Parameter, EditorRequired] public int Record { get; set; }

    private static string Conto(VoceDellaSelezione voce)
        => voce.Record.Count > 1 ? $"({voce.Record.Count} record)" : "";
}
