@implements IDisposable
@inject SessioneDelLab Lab

@*
    Il ramo git del sector nella barra (carta F4): il nome del ramo e lo stato in parole — «pulito», «3 file da
    registrare», «1 novità sul server» (slice 1). Aperto, il riquadro ha i gesti dei rami (slice 3): chiedere le novità
    al server, un lavoro nuovo (immediato o per il ciclo dopo), passare a un altro ramo, far nascere il ramo del ciclo.
    Fuori da git, o senza git sul PC, lo dice tenue: il Lab lavora lo stesso.
*@
@if (Lab.Ramo is { } ramo)
{
    <details class="lab-impostazioni lab-ramo-riquadro" data-riquadro-ramo>
        <summary class="lab-tasto lab-tasto-tenue lab-ramo @(ramo.Pulito ? null : "lab-ramo-da-fare")" data-ramo="@(ramo.Ramo ?? "")" title="@Titolo(ramo)">
            <span aria-hidden="true">⎇</span> @(ramo.Ramo ?? "commit staccato")
            <span class="lab-nota" data-stato-del-ramo>@(Lab.StaLeggendoIlRamo || Lab.StaCambiandoRamo ? "…" : ramo.InParole())</span>
        </summary>
        <div class="lab-impostazioni-riquadro">
            <p class="lab-nota">
                @if (Lab.BaseDelRamo is { } base_)
                {
                    <span data-base-del-ramo>Nato da <code>@base_</code>: la PR andrà lì.</span>
                }
                else
                {
                    <span>Server: <code>@(ramo.Remoto ?? "nessuno")</code></span>
                }
            </p>
            @if (Vipi.SectorLab.Core.Git.Registrazione.DaRegistrare(ramo) is { Count: > 0 } daRegistrare)
            {
                @* Slice 4 (D5): si registra quando lo chiede l'AOD, col messaggio proposto dai gesti salvati. *@
                <h3>Registra <span class="lab-nota">@daRegistrare.Count file</span></h3>
                <ul class="lab-elenco-dei-rami" data-da-registrare>
                    @foreach (var file in daRegistrare)
                    {
                        <li><code>@file.Percorso[(file.Percorso.LastIndexOf('/') + 1)..]</code> <span class="lab-nota">@file.Come</span></li>
                    }
                </ul>
                <textarea class="lab-campo lab-messaggio" rows="5" spellcheck="false" data-campo="messaggio"
                          value="@(_messaggio ?? Lab.MessaggioProposto)" @onchange="e => _messaggio = e.Value?.ToString()" disabled="@Occupato"></textarea>
                <button type="button" class="lab-tasto" data-tasto="registra" disabled="@Occupato"
                        title="git commit dei file qui sopra, sul ramo @ramo.Ramo" @onclick="Registra">Registra</button>
            }
            @if (ramo.Ramo?.StartsWith(Vipi.SectorLab.Core.Git.RamiDelSector.PrefissoDiLavoro, StringComparison.Ordinal) == true)
            {
                @* Slice 5 (D2): il push del ramo di lavoro, poi la pagina della PR già compilata nel browser. *@
                <h3>Manda e apri la PR</h3>
                @if (Vipi.SectorLab.Core.Git.Invio.PercheNonSiManda(ramo) is { } nonSiManda)
                {
                    <p class="lab-nota" data-non-si-manda>@nonSiManda</p>
                }
                else
                {
                    <button type="button" class="lab-tasto" data-tasto="manda" disabled="@Occupato"
                            title="git push del ramo @ramo.Ramo, poi la pagina di GitHub della PR verso @(Lab.BaseDelRamo ?? Lab.Predefinito)" @onclick="Manda">Manda</button>
                }
                @if (ramo.Monte is not null)
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="apri-pr" disabled="@Occupato"
                            title="Riapre la pagina di GitHub della PR, già compilata" @onclick="Lab.ApriLaPrAsync">Apri la PR</button>
                }
                <p class="lab-nota">Si manda solo quel che è registrato. La PR la crei tu, con «Create» sulla pagina di GitHub;
                    al primo invio git ti chiede l'accesso a GitHub nella sua finestra.</p>

                @* Slice 6 (C1, C2, C6): le righe del changelog dalle registrazioni del ramo, corrette dall'AOD. *@
                <h3>Changelog <span class="lab-nota">ciclo A@(Lab.CicloDelChangelog)</span></h3>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="proponi-changelog" disabled="@Occupato"
                        title="Una riga per file registrato in questo ramo, nella sezione della sua FIR" @onclick="Proponi">Proponi le righe</button>
                @if (_righe.Count > 0)
                {
                    <table class="lab-campi lab-righe-del-changelog" data-righe-del-changelog>
                        <tbody>
                            @foreach (var riga in _righe)
                            {
                                var questa = riga;
                                <tr>
                                    <td><input type="checkbox" checked="@questa.Scrivi" @onchange="e => questa.Scrivi = e.Value is true" data-scrivi-riga /></td>
                                    <td>
                                        @if (questa.Sezioni.Count > 1)
                                        {
                                            <select class="lab-campo" value="@questa.Sezione" @onchange="e => questa.Sezione = e.Value?.ToString() ?? questa.Sezione"
                                                    title="Lo scalo sta in più FIR: scegli la sezione" data-sezione-ambigua>
                                                @foreach (string s in questa.Sezioni)
                                                {
                                                    <option value="@s">@s</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <code>@questa.Sezione</code>
                                        }
                                    </td>
                                    <td><input class="lab-campo" value="@questa.Testo" @onchange="e => questa.Testo = e.Value?.ToString() ?? string.Empty" data-testo-riga /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="button" class="lab-tasto" data-tasto="scrivi-changelog" disabled="@Occupato"
                            title="Le righe spuntate in coda alla loro sezione di changelog.md (via *NIL se c'era); poi si registra" @onclick="Scrivi">Scrivi nel changelog</button>
                }
                @foreach (var avviso in Lab.AvvisiDelChangelog)
                {
                    <p class="lab-avviso-breve" data-avviso-changelog>@avviso.Testo@(avviso.Riga is { } r ? $" (riga {r})" : "")</p>
                }
            }
            @if (Vipi.SectorLab.Core.Git.Registrazione.Fuori(ramo) is { Count: > 0 } fuori)
            {
                <p class="lab-nota" data-restano-fuori title="@string.Join("\n", fuori.Select(f => f.Percorso))">
                    @fuori.Count file fuori dal sector cambiati: restano fuori, il Lab non li registra.</p>
            }

            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prendi-novita" disabled="@Occupato"
                    title="git fetch: chiede al server le novità; non cambia niente nei file" @onclick="() => Lab.RileggiIlRamoAsync(prendi: true)">Chiedi le novità al server</button>
            @if (Lab.PercheDelRamo is { } perche)
            {
                <p class="lab-avviso-breve" data-ramo-avviso>@perche</p>
            }

            <h3>Nuovo lavoro</h3>
            <label>
                Di che si tratta
                <input class="lab-campo" @bind="_argomento" @bind:event="oninput" placeholder="correzioni R-10" data-campo="argomento" disabled="@Occupato" />
            </label>
            @if (Lab.Vid is { } vid)
            {
                <p class="lab-nota">Il ramo: <code data-nome-del-lavoro>@(Vipi.SectorLab.Core.Git.RamiDelSector.NomeDiLavoro(vid, _argomento) ?? $"aod/{vid}/…")</code></p>
            }
            else
            {
                <p class="lab-avviso-breve" data-manca-vid>Manca il tuo VID: scrivilo nelle Impostazioni (va nel nome del ramo).</p>
            }
            <div class="lab-tasti-del-ramo">
                <button type="button" class="lab-tasto" data-tasto="lavoro-immediato" disabled="@(Occupato || Lab.Vid is null)"
                        title="Dal ramo @Lab.Predefinito: entra appena la PR è fusa" @onclick="() => Nuovo(Vipi.SectorLab.Core.Git.BaseDelLavoro.Immediato)">Immediato (da @Lab.Predefinito)</button>
                <button type="button" class="lab-tasto" data-tasto="lavoro-ciclo" disabled="@(Occupato || Lab.Vid is null || !Lab.CicloDopoSulServer)"
                        title="@(Lab.CicloDopoSulServer ? $"Dal ramo {Lab.CicloDopo}: entra col ciclo" : $"Sul server non c'è ancora {Lab.CicloDopo}")"
                        @onclick="() => Nuovo(Vipi.SectorLab.Core.Git.BaseDelLavoro.CicloDopo)">Per il ciclo (da @Lab.CicloDopo)</button>
            </div>
            @if (!Lab.CicloDopoSulServer)
            {
                <p class="lab-nota" data-ciclo-mancante>Il ramo <code>@Lab.CicloDopo</code> sul server non c'è ancora.
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="fai-nascere-ciclo" disabled="@Occupato"
                            title="Lo crea sul server, uguale a @Lab.Predefinito: il solo invio del Lab verso un ramo del ciclo" @onclick="Lab.FaiNascereIlCicloAsync">Fallo nascere</button></p>
            }

            @if (Lab.RamiLocali.Count > 1)
            {
                <h3>Passa a un altro ramo</h3>
                <ul class="lab-elenco-dei-rami">
                    @foreach (string altro in Lab.RamiLocali.Where(r => r != ramo.Ramo))
                    {
                        string questo = altro;
                        <li><button type="button" class="lab-citazione" data-passa="@questo" disabled="@Occupato" @onclick="() => Lab.PassaAlRamoAsync(questo)">@questo</button></li>
                    }
                </ul>
            }
            @if (Lab.PercheNonSiCambiaRamo() is { } no)
            {
                <p class="lab-nota" data-non-si-cambia>@no</p>
            }
            @if (Lab.Rifiuto is { } rifiuto && _rifiutoVisibile)
            {
                <p class="lab-avviso-breve" data-rifiuto-del-ramo>@rifiuto</p>
            }
        </div>
    </details>
}
else if (Lab.PercheDelRamo is { } perche)
{
    <span class="lab-nota" data-ramo-assente title="@perche">fuori da git</span>
}

@code {
    private string? _argomento;
    private bool _rifiutoVisibile;

    private string? _messaggio;

    private bool Occupato => Lab.StaLeggendoIlRamo || Lab.StaCambiandoRamo || Lab.StaRegistrando || Lab.StaMandando;

    private async Task Manda() => _rifiutoVisibile = !await Lab.MandaAsync();

    /// <summary>Una riga proposta mentre l'AOD la corregge: sezione scelta, testo, se scriverla.</summary>
    private sealed class RigaInCorrezione(Vipi.SectorLab.Core.Git.RigaDelChangelog proposta)
    {
        public IReadOnlyList<string> Sezioni { get; } = proposta.Sezioni;

        public string Sezione { get; set; } = proposta.Sezione;

        public string Testo { get; set; } = proposta.Testo;

        public bool Scrivi { get; set; } = true;
    }

    private List<RigaInCorrezione> _righe = [];

    private async Task Proponi()
    {
        _rifiutoVisibile = !await Lab.ProponiIlChangelogAsync();
        _righe = [.. Lab.RigheDelChangelog.Select(r => new RigaInCorrezione(r))];
    }

    private async Task Scrivi()
    {
        _rifiutoVisibile = !await Lab.ScriviNelChangelogAsync([.. _righe.Where(r => r.Scrivi).Select(r => (r.Sezione, r.Testo))]);
        if (!_rifiutoVisibile)
            _righe = [];
    }

    private async Task Registra()
    {
        _rifiutoVisibile = !await Lab.RegistraAsync(_messaggio ?? Lab.MessaggioProposto);
        if (!_rifiutoVisibile)
            _messaggio = null;
    }

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private async Task Nuovo(Vipi.SectorLab.Core.Git.BaseDelLavoro base_)
    {
        _rifiutoVisibile = !await Lab.NuovoLavoroAsync(_argomento, base_);
        if (!_rifiutoVisibile)
            _argomento = null;
    }

    private string Titolo(Vipi.SectorLab.Core.Git.StatoDelRamo ramo)
        => $"Il ramo git del sector ({ramo.Radice}), dal server {ramo.Remoto ?? "— nessuno"}"
           + (ramo.Monte is null ? "" : $", segue {ramo.Monte}")
           + (ramo.Cambiati.Count == 0 ? "" : "\nDa registrare: " + string.Join(", ", ramo.Cambiati.Take(8).Select(c => $"{c.Percorso[(c.Percorso.LastIndexOf('/') + 1)..]} ({c.Come})")) + (ramo.Cambiati.Count > 8 ? "…" : ""));
}
