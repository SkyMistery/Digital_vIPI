@implements IDisposable
@inject SessioneDelLab Lab
@inject IJSRuntime Js

@*
    La barra in alto, la stessa nelle due finestre (riordino delle pagine, D3 e D4): il sector aperto, le linguette
    delle quattro pagine, errori e avvisi (portano ai Problemi), il ramo (porta a Consegna), annulla e ripeti, «Salva»
    sempre a vista, i pannelli in un'altra finestra (solo dalla principale) e il tema. Tutto il resto sta nelle pagine.
*@
<header class="lab-barra">
    <strong>Aurora Sector Lab</strong>
    <span class="lab-nota lab-barra-sector" data-barra="sector" title="@Lab.Sessione?.Cartella.Radice">@NomeDelSector</span>

    @* Riordino D8: due mondi, ognuno con le sue pagine (il suo repo, la sua consegna); le Impostazioni sono comuni. *@
    <nav class="lab-pagine" role="tablist" aria-label="Pagine">
        @foreach (var (mondo, pagine) in Mondi)
        {
            <span class="lab-mondo @(pagine.Any(p => p.Pagina == Lab.Pagina) ? "lab-mondo-scelto" : null)" data-mondo="@mondo.ToLowerInvariant()">
                <span class="lab-mondo-nome">@mondo</span>
                @foreach (var (pagina, nome, perche) in pagine)
                {
                    <button role="tab" aria-selected="@(Lab.Pagina == pagina ? "true" : "false")"
                            class="lab-pagina-linguetta @(Lab.Pagina == pagina ? "lab-pagina-scelta" : null)"
                            title="@perche" @onclick="() => Lab.ScegliLaPagina(pagina)"
                            data-pagina="@pagina.ToString().ToLowerInvariant()">@nome</button>
                }
            </span>
        }
        <button role="tab" aria-selected="@(Lab.Pagina == PaginaDelLab.Impostazioni ? "true" : "false")"
                class="lab-pagina-linguetta @(Lab.Pagina == PaginaDelLab.Impostazioni ? "lab-pagina-scelta" : null)"
                title="Le scelte del Lab, il sector aperto, il registro" @onclick="() => Lab.ScegliLaPagina(PaginaDelLab.Impostazioni)"
                data-pagina="impostazioni">Impostazioni</button>
    </nav>

    <span class="lab-barra-spazio"></span>

    <button class="lab-tasto lab-tasto-tenue lab-barra-problemi @(Errori > 0 ? "lab-barra-con-errori" : null)"
            @onclick="Lab.MostraIProblemi" data-barra="problemi" title="Apre i Problemi, nella pagina Sector">
        @(Lab.StaValidando ? "validazione…" : $"{Errori} errori · {Avvisi} avvisi")
    </button>
    @if (Lab.Ramo is { } ramo)
    {
        <button class="lab-tasto lab-tasto-tenue lab-ramo @(ramo.Pulito ? null : "lab-ramo-da-fare")" data-barra="ramo"
                title="Il ramo del sector: registrare, mandare e aprire la PR stanno nella pagina Consegna"
                @onclick="() => Lab.ScegliLaPagina(PaginaDelLab.Consegna)">
            <span aria-hidden="true">⎇</span> @(ramo.Ramo ?? "commit staccato")
            <span class="lab-nota">@(Lab.StaLeggendoIlRamo || Lab.StaCambiandoRamo ? "…" : ramo.InParole())</span>
        </button>
    }
    <Storia />
    <button class="lab-tasto" disabled="@(Lab.Modifiche.Quante == 0 || Lab.StaSalvando)" @onclick="() => Lab.SalvaAsync()"
            title="@(Lab.Modifiche.Quante == 0 ? "Niente da salvare" : "Scrive le modifiche in sospeso nei file (Ctrl+S); l'elenco col diff sta nelle Modifiche")"
            data-tasto="salva-barra">@(Lab.StaSalvando ? "Salvo…" : Lab.Modifiche.Quante == 0 ? "Salva" : $"Salva ({Lab.Modifiche.Quante})")</button>
    @if (Principale)
    {
        @if (Lab.PannelliInUnAltraFinestra)
        {
            <button class="lab-tasto lab-tasto-tenue" @onclick="RiportaIPannelli" data-tasto="riporta"
                    title="Chiude la finestra dei pannelli e li rimette qui, accanto alla mappa">Pannelli qui</button>
        }
        else
        {
            <button class="lab-tasto lab-tasto-tenue" @onclick="StaccaIPannelli" data-tasto="stacca"
                    title="I pannelli della pagina in un'altra finestra (per esempio sull'altro schermo); qui resta la mappa">Pannelli a parte</button>
        }
    }
    <TastoDelTema />
</header>

@code {
    /// <summary>La finestra principale (con la mappa): solo lei stacca e riporta i pannelli.</summary>
    [Parameter] public bool Principale { get; set; }

    private static readonly (string Mondo, (PaginaDelLab Pagina, string Nome, string Perche)[] Pagine)[] Mondi =
    [
        ("AIP", [
            (PaginaDelLab.Aip, "Indice", "L'AIP espanso: i PDF, la lettura, le correzioni e i confronti col sector"),
        ]),
        ("Sector", [
            (PaginaDelLab.Sector, "Mappa", "Sfogliare, guardare e modificare i record; i problemi"),
            (PaginaDelLab.Consegna, "Consegna", "Le modifiche, il ramo, la vetrina di Aurora, la PR"),
        ]),
    ];

    private string NomeDelSector => Lab.Sessione?.Cartella.Radice is { } radice
        ? Path.GetFileName(Path.TrimEndingDirectorySeparator(radice))
        : "";

    private int Errori => Lab.ProblemiDellAlbero.Count(p => p.Gravita == Gravita.Errore);

    private int Avvisi => Lab.ProblemiDellAlbero.Count - Errori;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    /// <summary>
    /// La finestra dei pannelli la apre il guscio (una window.open che la WebView2 gli passa); in un browser qualunque
    /// si apre come scheda nuova, e funziona lo stesso: lo stato è del server.
    /// </summary>
    private async Task StaccaIPannelli() => await Js.InvokeVoidAsync("sectorlab.staccaIPannelli");

    /// <summary>Chiede al guscio di chiudere la finestra dei pannelli: sarà lui, chiudendola, a dire «di nuovo qui».</summary>
    private async Task RiportaIPannelli() => await Js.InvokeVoidAsync("sectorlab.riportaIPannelli");

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
