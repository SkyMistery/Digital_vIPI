@implements IDisposable
@inject SessioneDelLab Lab

@*
    L'ispettore in lettura (carta F3 §2.2 passo 3, slice 5): i campi del record e, sotto, le righe del file com'è sul
    disco, coi numeri di riga VERI — quelli che si citano a un AOD e che usa il validatore. In slice 6 i campi si
    modificano; qui si guardano.
*@
@if (Lab.Scheda() is { } scheda)
{
    <div class="lab-ispettore" data-ispettore="@($"{scheda.File}#{scheda.Indice}")">
        <header>
            <p class="lab-etichetta">@scheda.Etichetta</p>
            <p class="lab-nota" data-tipo-record="@scheda.Tipo">@scheda.NomeDelTipo · @scheda.File · record @scheda.Indice</p>
            <p class="lab-gesti-record">
                @* Slice 8: il nuovo nasce copiando questo, così è già nella forma dei vicini. *@
                <NuovoRecord File="@scheda.File" Modello="scheda.Indice" />
                <button class="lab-tasto lab-tasto-tenue" data-tasto="togli-record"
                        @onclick="() => Lab.TogliRecord(scheda.File, scheda.Indice)">− Togli questo record</button>
                @* La vista (chiesta dal committente il 23 settembre): sulla mappa solo quel che si sta lavorando. *@
                <button class="lab-tasto lab-tasto-tenue @(Lab.EInVista(scheda.File, scheda.Indice) ? "lab-tasto-acceso" : null)"
                        data-tasto="vista-record" @onclick="() => Lab.CambiaLaVista(scheda.File, scheda.Indice)"
                        title="@(Lab.EInVista(scheda.File, scheda.Indice) ? "Toglilo da quel che la mappa mostra" : "Sulla mappa solo questo (e quel che aggiungi alla vista)")">
                    @(Lab.EInVista(scheda.File, scheda.Indice) ? "◉ In vista" : "◎ Solo questo sulla mappa")
                </button>
            </p>
            @if (scheda.Forma is { NomiNonRisolti.Count: > 0 } forma)
            {
                <p class="lab-irrisolti">Nomi che @Lab.IscScelto non conosce: @string.Join(", ", forma.NomiNonRisolti)</p>
            }
        </header>

        @* Le sezioni si chiudono col clic sul titolo (committente, 24 settembre): Sezione.razor. *@
        <Sezione Chiave="scheda-campi">
        <Titolo>Campi <span class="lab-nota">@scheda.Campi.Count</span></Titolo>
        <ChildContent>
        <table class="lab-campi">
            <tbody>
                @foreach (var campo in scheda.Campi)
                {
                    <tr data-campo-record="@campo.Nome" class="@(Toccato(scheda, campo.Nome) ? "lab-campo-toccato" : null)">
                        @* Slice 3: il nome dell'AOD e, al passaggio del mouse, il significato; una proprietà del motore che
                           non ha descrizione si vede lo stesso, e lo dice. *@
                        <th title="@campo.Descrizione?.Significato">
                            @campo.NomeDaMostrare
                            @if (campo.Sconosciuto)
                            {
                                <span class="lab-sconosciuto" data-sconosciuto="@campo.Nome">campo sconosciuto</span>
                            }
                        </th>
                        <td><EditorDelCampo Scheda="scheda" Campo="campo" /></td>
                    </tr>
                }
            </tbody>
        </table>
        </ChildContent>
        </Sezione>

        @* Slice 3d: i metadati di §M del record, le chiavi del catalogo del suo tipo di file. Si scrivono nel tag
           //@"NOME" sopra il record; un valore vuoto toglie la chiave. *@
        @if (Lab.MetadatiDi(scheda.File, scheda.Indice) is { Count: > 0 } metadati)
        {
            <Sezione Chiave="scheda-metadati">
            <Titolo>Metadati <span class="lab-nota">@metadati.Count(m => m.Valore is not null)</span></Titolo>
            <ChildContent>
            <table class="lab-campi lab-metadati">
                <tbody>
                    @foreach (var metadato in metadati)
                    {
                        string chiave = metadato.Chiave;
                        <tr data-metadato="@chiave" class="@(Toccato(scheda, "§tag:" + chiave) ? "lab-campo-toccato" : null)">
                            <th title="@metadato.Significato">@metadato.Nome <code class="lab-chiave">@chiave</code></th>
                            <td>
                                @if (!metadato.SiScrive)
                                {
                                    <span title="@metadato.PercheNo" data-metadato-fermo="@chiave">@(metadato.Valore ?? "—")</span>
                                }
                                else if (metadato.SiNo)
                                {
                                    <input type="checkbox" class="lab-casella-campo" checked="@(metadato.Valore == "si")" data-scrivi-tag="@chiave"
                                           @onchange="e => SpuntaIlTag(scheda, chiave, e)" />
                                }
                                else if (metadato.Editor == EditorDelMetadato.Punto)
                                {
                                    @* Prova 68: un punto del sector, coi suggerimenti del master (un nome sconosciuto si rifiuta). *@
                                    <CampoPunto Valore="@metadato.Valore" OnCambia="v => CambiaIlTag(scheda, chiave, v)" data-scrivi-tag="@chiave" />
                                }
                                else if (metadato.Editor == EditorDelMetadato.SalitaIniziale)
                                {
                                    bool coo = metadato.Valore == ValoriDeiMetadati.CooApp;
                                    <span class="lab-campo-con-nota">
                                        <input class="lab-campo" value="@(coo ? null : metadato.Valore)" data-scrivi-tag="@chiave" disabled="@coo"
                                               placeholder="6000ft o FL80" @onchange="e => CambiaIlTag(scheda, chiave, e.Value?.ToString())" />
                                        <label class="lab-nota" title="Coordinare con l'avvicinamento: si scrive sempre uguale">
                                            <input type="checkbox" checked="@coo" data-coo-app="@chiave" @onchange="e => SpuntaCooApp(scheda, chiave, e)" />
                                            @ValoriDeiMetadati.CooApp
                                        </label>
                                    </span>
                                }
                                else if (metadato.Editor == EditorDelMetadato.Lettere)
                                {
                                    @* Prova 68: una lettera, un tasto; doppio clic = anche le precedenti come quella. *@
                                    <span class="lab-piste" data-lettere="@chiave">
                                        @foreach (char lettera in ValoriDeiMetadati.Lettere[metadato.Base])
                                        {
                                            bool accesa = (metadato.Valore ?? string.Empty).Contains(lettera, StringComparison.OrdinalIgnoreCase);
                                            <button class="lab-pista @(accesa ? "lab-pista-scelta" : null)" data-lettera="@lettera"
                                                    title="Clic: accende o spegne. Doppio clic: anche le precedenti come questa."
                                                    @onclick="e => Lettera(scheda, metadato, lettera, e)">@lettera</button>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <input class="lab-campo" value="@metadato.Valore" data-scrivi-tag="@chiave" placeholder="—"
                                           @onchange="e => Lab.CambiaIlMetadato(scheda.File, scheda.Indice, chiave, e.Value?.ToString())" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </ChildContent>
            </Sezione>
        }

        @if (Lab.Rifiuto is { } rifiuto)
        {
            <p class="lab-errore" data-rifiuto="1">@rifiuto</p>
        }

        @* F3-bis slice 5: una mappa MAPS di un .str può essere composta dalle procedure dello stesso file. Spuntare
           riscrive il tag //@ e rigenera la mappa; la prima volta il Lab sceglie da solo se disegnarle intere. *@
        @if (Lab.CompostaDi(scheda.File, scheda.Indice) is { } composta)
        {
            <Sezione Chiave="scheda-composta" data-composta="@composta.Elenco.Count">
            <Titolo>Composta da <span class="lab-nota">@composta.Elenco.Count</span></Titolo>
            <ChildContent>
            <div class="lab-composta">
                @if (composta.Caselle.Count == 0)
                {
                    <p class="lab-nota">In questo file non ci sono procedure da raccogliere.</p>
                }
                @if (composta.Elenco.Count == 0 && composta.DaQuelloCheDisegna.Count > 0)
                {
                    @* Un aggregato fatto a mano diventa composto così com'è: l'elenco e la forma li ricava il Lab. *@
                    <button class="lab-tasto lab-tasto-tenue lab-adotta" data-tasto="adotta"
                            title="@string.Join(", ", composta.DaQuelloCheDisegna.Select(v => (v.Pista is null ? "" : v.Pista + ":") + v.Nome))"
                            @onclick="() => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.DaQuelloCheDisegna)">
                        Composta da quello che disegna oggi (@composta.DaQuelloCheDisegna.Count)
                    </button>
                }
                @foreach (var casella in composta.Caselle)
                {
                    <label class="lab-casella" title="@(casella.Elencabile ? null : "Il nome è vuoto o ha le virgolette dentro: non può stare nell'elenco")">
                        <input type="checkbox" checked="@casella.Scelta" data-procedura="@casella.Testo" disabled="@(!casella.Elencabile)"
                               @onchange="e => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.Con(casella, e.Value is true))" />
                        @casella.Testo <span class="lab-nota">@casella.Piste @(casella.Tipo == "STAR" ? "" : "· " + casella.Tipo)</span>
                    </label>
                }
                @if (composta.Elenco.Count > 0)
                {
                    <label class="lab-casella lab-intere" title="Ogni procedura intera, anche dove ripassa su un tratto già disegnato">
                        <input type="checkbox" checked="@composta.Intere" data-intere="si"
                               @onchange="e => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.Elenco, e.Value is true)" />
                        procedure intere
                    </label>
                }
            </div>
            </ChildContent>
            </Sezione>
        }

        @* Una forma semplice ha un elenco solo; una zona a più tratti ne ha uno per tratto (slice 7-bis). *@
        @foreach (var elenco in Lab.ElenchiDiVerticiDi(scheda.File, scheda.Indice))
        {
            string chiave = elenco.Chiave;
            var vertici = Lab.VerticiDi(scheda.File, scheda.Indice, chiave);
            @* Un tratto per sezione: si chiudono uno per uno, e il nome del tratto è la chiave (Vertices, Tratto 3…). *@
            <Sezione Chiave="@($"vertici:{elenco.Nome}")" data-elenco="@chiave">
            <Titolo>@elenco.Nome <span class="lab-nota">@vertici.Count</span></Titolo>
            <ChildContent>

            <div class="lab-vertici" data-vertici="@vertici.Count">
                @for (int i = 0; i < vertici.Count; i++)
                {
                    int posizione = i;
                    <div class="lab-vertice">
                        <span class="lab-numero">@(posizione + 1)</span>
                        @if (elenco.AmmetteNomi)
                        {
                            @* Slice 3c: dove il file sa scrivere un nome, il vertice propone i punti del master. *@
                            <CampoPunto Valore="@vertici[posizione]" data-vertice="@posizione"
                                        OnCambia="t => Gesto(scheda, chiave, GestoDeiVertici.Cambia, posizione, t)" />
                        }
                        else
                        {
                            <input class="lab-campo" value="@vertici[posizione]"
                                   @onchange="e => Gesto(scheda, chiave, GestoDeiVertici.Cambia, posizione, e.Value?.ToString())"
                                   data-vertice="@posizione" />
                        }
                        <button class="lab-annulla" title="aggiungi un vertice qui sopra"
                                @onclick="() => Gesto(scheda, chiave, GestoDeiVertici.Aggiungi, posizione, vertici[posizione])"
                                data-aggiungi="@posizione">+</button>
                        <button class="lab-annulla" title="togli questo vertice"
                                @onclick="() => Gesto(scheda, chiave, GestoDeiVertici.Togli, posizione)"
                                data-togli="@posizione">−</button>
                    </div>
                }
            </div>

            <details class="lab-incolla">
                <summary data-incolla="@chiave">Incolla da testo</summary>
                @* Il testo dell'AIP (archi compresi) o l'uscita del convertitore del sito: lo legge F1. *@
                <textarea class="lab-campo" rows="4" value="@(_perQuale == chiave ? _daIncollare : null)"
                          @oninput="e => Scritto(scheda, chiave, e.Value?.ToString())"
                          placeholder="Testo AIP, o coordinate una per riga" data-campo="incolla"></textarea>
                @* Gli archi del testo si disegnano fitti come quelli che il file ha già: la stima la fa il Lab, l'AOD la
                   cambia, e l'anteprima segue a ogni scatto (oninput, non onchange). Il «°» sta attaccato al numero:
                   prima andava a capo da solo (prove del committente, 23 settembre). *@
                <label class="lab-nota lab-densita">
                    <span>Archi: un punto ogni</span>
                    <span class="lab-densita-valore">
                        <input type="number" min="0.1" max="10" step="0.5" class="lab-campo"
                               value="@GradiPerPunto(scheda).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                               @oninput="e => Densita(scheda, chiave, e.Value?.ToString())"
                               data-campo="gradi-per-punto" /><span>°</span>
                    </span>
                    @* Di base 5° (committente, 24 settembre); la stima dal file resta come indicazione. *@
                    @if (Lab.StimaDeiGradiDi(scheda.File, scheda.Indice) is { } stima)
                    {
                        <span data-stima-gradi="@stima.ToString(System.Globalization.CultureInfo.InvariantCulture)">(qui gli archi ne hanno uno ogni @stima.ToString("0.#")°)</span>
                    }
                </label>
                @* Chiusa o aperta: la sceglie l'AOD (committente, 24 settembre). Parte da com'è la forma di oggi. *@
                <label class="lab-nota lab-chiudi" title="La forma si chiude ripetendo il primo punto in fondo, come i settori dei .tfl. Senza, resta una linea aperta (come le mappe degli .str).">
                    <input type="checkbox" checked="@Chiudi(scheda, chiave)" @onchange="e => CambiaChiudi(scheda, chiave, e.Value is true)" data-campo="chiudi" />
                    Chiudi la forma (l'ultimo punto ripete il primo)
                </label>
                @if (Lab.Anteprima is { } anteprima && anteprima.File == scheda.File && anteprima.Record == scheda.Indice && anteprima.Campo == chiave)
                {
                    <AnteprimaDelDisegno Letto="anteprima.Letto" Oggi="scheda.Forma?.Tratti" />
                }
                <button class="lab-tasto" disabled="@(_perQuale != chiave || string.IsNullOrWhiteSpace(_daIncollare))"
                        title="@(_perQuale != chiave || string.IsNullOrWhiteSpace(_daIncollare) ? "Incolla prima il testo qui sopra" : null)"
                        @onclick="() => Incolla(scheda, chiave)" data-tasto="incolla">Sostituisci i vertici</button>
            </details>
            </ChildContent>
            </Sezione>
        }

        <Sezione Chiave="scheda-righe">
        <Titolo>Righe del file</Titolo>
        <ChildContent>
        @* Clic su una riga: si scrive a mano, con conferma (RigheAMano). *@
        <RigheAMano File="@scheda.File" Righe="scheda.Righe"
                    Classe="@(riga => (riga.DelRecord ? "lab-riga-del-record" : "lab-riga-contesto") + (Segnalata(scheda.File, riga.Numero) ? " lab-riga-segnalata" : ""))"
                    Segnata="@(riga => Segnalata(scheda.File, riga.Numero))" />
        </ChildContent>
        </Sezione>
    </div>
}
else if (Lab.RigaSegnalata is { } segnata)
{
    @* Slice 10: un problema che non sta in un record. Niente scheda, ma la riga si vede, dal disco. *@
    var righe = Lab.RigheIntornoAllaSegnalata();
    <div class="lab-ispettore" data-ispettore-riga="@($"{segnata.File}:{segnata.Riga}")">
        <header>
            <p class="lab-etichetta">@segnata.File[(segnata.File.LastIndexOf('/') + 1)..], riga @segnata.Riga</p>
            <p class="lab-nota">@segnata.File · la riga non appartiene a un record</p>
        </header>
        @* Una riga che non è un record (illeggibile, per esempio) si corregge qui, a mano (prova 7 del committente). *@
        <RigheAMano File="@segnata.File" Righe="righe"
                    Classe="@(riga => riga.DelRecord ? "lab-riga-segnalata" : "lab-riga-contesto")"
                    Segnata="@(riga => riga.DelRecord)" />
        @if (Lab.Rifiuto is { } rifiutoDellaRiga)
        {
            <p class="lab-errore" data-rifiuto="1">@rifiutoDellaRiga</p>
        }
    </div>
}
else if (Lab.FileScelto is not null)
{
    <p class="lab-nota lab-ispettore-vuoto">Scegli un record dall'elenco, o una forma sulla mappa.</p>
}
else
{
    <p class="lab-nota lab-ispettore-vuoto">Sfoglia l'albero, cerca un nome, o clicca una forma sulla mappa.</p>
}

@code {
    private void CambiaIlTag(SchedaDelRecord scheda, string chiave, string? valore)
        => Lab.CambiaIlMetadato(scheda.File, scheda.Indice, chiave, valore);

    /// <summary>La spunta COO APP: scrive «COO APP» fra virgolette (§M), tolta la chiave sparisce.</summary>
    private void SpuntaCooApp(SchedaDelRecord scheda, string chiave, ChangeEventArgs e)
        => Lab.CambiaIlMetadato(scheda.File, scheda.Indice, chiave, Equals(e.Value, true) ? ValoriDeiMetadati.CooApp : null);

    /// <summary>
    /// Un tasto delle lettere: il secondo clic di un doppio clic (Detail 2) porta con sé le precedenti. 🔴 Il valore si
    /// rilegge dalla sessione, non da quello disegnato: il secondo clic arriva prima che la scheda si ridisegni, e col
    /// valore di prima del primo clic annullava tutto (visto a schermo, doppio clic su H: niente).
    /// </summary>
    private void Lettera(SchedaDelRecord scheda, MetadatoDellaScheda metadato, char lettera, MouseEventArgs e)
    {
        string? adesso = Lab.MetadatiDi(scheda.File, scheda.Indice).FirstOrDefault(m => m.Chiave == metadato.Chiave)?.Valore;
        Lab.CambiaIlMetadato(scheda.File, scheda.Indice, metadato.Chiave,
            ValoriDeiMetadati.Clic(metadato.Base, adesso, lettera, e.Detail >= 2));
    }

    /// <summary>Una chiave sì/no dei metadati: spuntata vale «si», tolta sparisce (§M).</summary>
    private void SpuntaIlTag(SchedaDelRecord scheda, string chiave, ChangeEventArgs e)
        => Lab.CambiaIlMetadato(scheda.File, scheda.Indice, chiave, Equals(e.Value, true) ? "si" : null);

    /// <summary>La riga del problema scelto nel pannello (slice 10).</summary>
    private bool Segnalata(string file, int numero) => Lab.RigaSegnalata is { } s && s.File == file && s.Riga == numero;

    private bool Toccato(SchedaDelRecord scheda, string campo)
        => Lab.Modifiche.Tutte.Any(m => m.File == scheda.File && m.Record == scheda.Indice && m.Campo == campo);

    private string? _daIncollare;

    /// <summary>Per quale elenco è il testo da incollare: un record può avere più tratti, ognuno col suo.</summary>
    private string? _perQuale;

    private void Gesto(SchedaDelRecord scheda, string campo, GestoDeiVertici gesto, int posizione, string? testo = null)
        => Lab.GestoSuiVertici(scheda.File, scheda.Indice, campo, gesto, posizione, testo);

    /// <summary>I gradi fra due punti d'arco scritti dall'AOD, per QUEL record; null = la stima del Lab.</summary>
    private double? _gradi;

    private (string File, int Record)? _gradiDi;

    private double GradiPerPunto(SchedaDelRecord scheda)
    {
        // Un altro record ha la sua stima: il valore scritto per il record di prima non lo segue.
        if (_gradiDi != (scheda.File, scheda.Indice))
        {
            _gradiDi = (scheda.File, scheda.Indice);
            _gradi = null;
        }

        return _gradi ?? SessioneDelLab.GradiPerPuntoDiBase;
    }

    private void Incolla(SchedaDelRecord scheda, string campo)
    {
        double puntiPerGrado = 1 / GradiPerPunto(scheda);
        if (Lab.GestoSuiVertici(scheda.File, scheda.Indice, campo, GestoDeiVertici.Incolla, testo: _daIncollare,
                                puntiPerGrado: puntiPerGrado, chiudi: Chiudi(scheda, campo)))
            _daIncollare = null;
    }

    /// <summary>Un tasto nel testo da incollare: l'anteprima si rifà (scheda e mappa).</summary>
    private void Scritto(SchedaDelRecord scheda, string campo, string? testo)
    {
        _perQuale = campo;
        _daIncollare = testo;
        Lab.MostraLAnteprima(scheda.File, scheda.Indice, campo, testo, 1 / GradiPerPunto(scheda), Chiudi(scheda, campo));
    }

    /// <summary>La scelta «chiudi la forma» per QUELL'elenco; null = com'è la forma di oggi.</summary>
    private readonly Dictionary<(string File, int Record, string Campo), bool> _chiudi = [];

    private bool Chiudi(SchedaDelRecord scheda, string campo)
        => _chiudi.TryGetValue((scheda.File, scheda.Indice, campo), out bool scelto) ? scelto : Lab.ElencoChiuso(scheda.File, scheda.Indice, campo);

    private void CambiaChiudi(SchedaDelRecord scheda, string campo, bool chiudi)
    {
        _chiudi[(scheda.File, scheda.Indice, campo)] = chiudi;
        if (_perQuale == campo && !string.IsNullOrWhiteSpace(_daIncollare))
            Lab.MostraLAnteprima(scheda.File, scheda.Indice, campo, _daIncollare, 1 / GradiPerPunto(scheda), chiudi);
    }

    /// <summary>La densità degli archi cambiata: l'anteprima si rifà subito, così si vede come cambia la forma.</summary>
    private void Densita(SchedaDelRecord scheda, string campo, string? scritto)
    {
        // A metà scrittura (campo vuoto, «0») il valore di prima resta: rimettere la stima riscriverebbe il campo sotto le dita.
        if (!double.TryParse(scritto, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double g) || g <= 0)
            return;
        _gradi = g;
        if (_perQuale == campo && !string.IsNullOrWhiteSpace(_daIncollare))
            Lab.MostraLAnteprima(scheda.File, scheda.Indice, campo, _daIncollare, 1 / GradiPerPunto(scheda), Chiudi(scheda, campo));
    }

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
