@implements IDisposable
@inject SessioneDelLab Lab

@*
    L'ispettore in lettura (carta F3 §2.2 passo 3, slice 5): i campi del record e, sotto, le righe del file com'è sul
    disco, coi numeri di riga VERI — quelli che si citano a un AOD e che usa il validatore. In slice 6 i campi si
    modificano; qui si guardano.
*@
@if (Lab.Scheda() is { } scheda)
{
    <div class="lab-ispettore" data-ispettore="@($"{scheda.File}#{scheda.Indice}")">
        <header>
            <p class="lab-etichetta">@scheda.Etichetta</p>
            <p class="lab-nota">@scheda.Tipo · @scheda.File · record @scheda.Indice</p>
            @if (scheda.Forma is { NomiNonRisolti.Count: > 0 } forma)
            {
                <p class="lab-irrisolti">Nomi che @Lab.IscScelto non conosce: @string.Join(", ", forma.NomiNonRisolti)</p>
            }
        </header>

        <table class="lab-campi">
            <tbody>
                @foreach (var campo in scheda.Campi)
                {
                    <tr data-campo-record="@campo.Nome">
                        <th>@campo.Nome</th>
                        <td>@campo.Valore</td>
                    </tr>
                }
            </tbody>
        </table>

        <h2>Righe del file</h2>
        <pre class="lab-righe" data-righe="@scheda.Righe.Count">@foreach (var riga in scheda.Righe)
{<span class="@(riga.DelRecord ? "lab-riga-del-record" : "lab-riga-contesto")" data-riga="@riga.Numero"><span class="lab-numero">@riga.Numero</span> @riga.Testo
</span>}</pre>
    </div>
}
else if (Lab.FileScelto is not null)
{
    <p class="lab-nota lab-ispettore-vuoto">Scegli un record dall'elenco, o una forma sulla mappa.</p>
}
else
{
    <p class="lab-nota lab-ispettore-vuoto">Sfoglia l'albero, cerca un nome, o clicca una forma sulla mappa.</p>
}

@code {
    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
