@implements IDisposable
@inject SessioneDelLab Lab

@*
    L'ispettore in lettura (carta F3 §2.2 passo 3, slice 5): i campi del record e, sotto, le righe del file com'è sul
    disco, coi numeri di riga VERI — quelli che si citano a un AOD e che usa il validatore. In slice 6 i campi si
    modificano; qui si guardano.
*@
@if (Lab.Scheda() is { } scheda)
{
    <div class="lab-ispettore" data-ispettore="@($"{scheda.File}#{scheda.Indice}")">
        <header>
            <p class="lab-etichetta">@scheda.Etichetta</p>
            <p class="lab-nota">@scheda.Tipo · @scheda.File · record @scheda.Indice</p>
            <p class="lab-gesti-record">
                @* Slice 8: il nuovo nasce copiando questo, così è già nella forma dei vicini. *@
                <button class="lab-tasto lab-tasto-tenue" data-tasto="aggiungi-record"
                        @onclick="() => Lab.AggiungiRecord(scheda.File, scheda.Indice)">+ Record come questo</button>
                <button class="lab-tasto lab-tasto-tenue" data-tasto="togli-record"
                        @onclick="() => Lab.TogliRecord(scheda.File, scheda.Indice)">− Togli questo record</button>
            </p>
            @if (scheda.Forma is { NomiNonRisolti.Count: > 0 } forma)
            {
                <p class="lab-irrisolti">Nomi che @Lab.IscScelto non conosce: @string.Join(", ", forma.NomiNonRisolti)</p>
            }
        </header>

        <table class="lab-campi">
            <tbody>
                @foreach (var campo in scheda.Campi)
                {
                    <tr data-campo-record="@campo.Nome" class="@(Toccato(scheda, campo.Nome) ? "lab-campo-toccato" : null)">
                        <th>@campo.Nome</th>
                        <td>
                            @if (Scrivibile(scheda, campo.Nome))
                            {
                                @* La modifica parte quando il campo perde il fuoco o si preme Invio: a ogni tasto
                                   vorrebbe dire rifiutare mezza coordinata mentre la si scrive. *@
                                <input class="lab-campo" value="@campo.Valore"
                                       @onchange="e => Cambia(scheda, campo.Nome, e.Value?.ToString())"
                                       data-scrivi="@campo.Nome" />
                            }
                            else
                            {
                                @campo.Valore
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Lab.Rifiuto is { } rifiuto)
        {
            <p class="lab-errore" data-rifiuto="1">@rifiuto</p>
        }

        @* F3-bis slice 5: una mappa MAPS di un .str può essere composta dalle procedure dello stesso file. Spuntare
           riscrive il tag //@ e rigenera la mappa; la prima volta il Lab sceglie da solo se disegnarle intere. *@
        @if (Lab.CompostaDi(scheda.File, scheda.Indice) is { } composta)
        {
            <h2 data-composta="@composta.Elenco.Count">Composta da <span class="lab-nota">@composta.Elenco.Count</span></h2>
            <div class="lab-composta">
                @if (composta.Caselle.Count == 0)
                {
                    <p class="lab-nota">In questo file non ci sono procedure da raccogliere.</p>
                }
                @if (composta.Elenco.Count == 0 && composta.DaQuelloCheDisegna.Count > 0)
                {
                    @* Un aggregato fatto a mano diventa composto così com'è: l'elenco e la forma li ricava il Lab. *@
                    <button class="lab-tasto lab-tasto-tenue lab-adotta" data-tasto="adotta"
                            title="@string.Join(", ", composta.DaQuelloCheDisegna.Select(v => (v.Pista is null ? "" : v.Pista + ":") + v.Nome))"
                            @onclick="() => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.DaQuelloCheDisegna)">
                        Composta da quello che disegna oggi (@composta.DaQuelloCheDisegna.Count)
                    </button>
                }
                @foreach (var casella in composta.Caselle)
                {
                    <label class="lab-casella" title="@(casella.Elencabile ? null : "Il nome ha uno spazio, una virgola o due punti: non può stare nell'elenco")">
                        <input type="checkbox" checked="@casella.Scelta" data-procedura="@casella.Testo" disabled="@(!casella.Elencabile)"
                               @onchange="e => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.Con(casella, e.Value is true))" />
                        @casella.Testo <span class="lab-nota">@casella.Piste @(casella.Tipo == "STAR" ? "" : "· " + casella.Tipo)</span>
                    </label>
                }
                @if (composta.Elenco.Count > 0)
                {
                    <label class="lab-casella lab-intere" title="Ogni procedura intera, anche dove ripassa su un tratto già disegnato">
                        <input type="checkbox" checked="@composta.Intere" data-intere="si"
                               @onchange="e => Lab.CambiaLaComposta(scheda.File, scheda.Indice, composta.Elenco, e.Value is true)" />
                        procedure intere
                    </label>
                }
            </div>
        }

        @* Una forma semplice ha un elenco solo; una zona a più tratti ne ha uno per tratto (slice 7-bis). *@
        @foreach (var elenco in Lab.ElenchiDiVerticiDi(scheda.File, scheda.Indice))
        {
            string chiave = elenco.Chiave;
            var vertici = Lab.VerticiDi(scheda.File, scheda.Indice, chiave);
            <h2 data-elenco="@chiave">@elenco.Nome <span class="lab-nota">@vertici.Count</span></h2>

            <div class="lab-vertici" data-vertici="@vertici.Count">
                @for (int i = 0; i < vertici.Count; i++)
                {
                    int posizione = i;
                    <div class="lab-vertice">
                        <span class="lab-numero">@(posizione + 1)</span>
                        <input class="lab-campo" value="@vertici[posizione]"
                               @onchange="e => Gesto(scheda, chiave, GestoDeiVertici.Cambia, posizione, e.Value?.ToString())"
                               data-vertice="@posizione" />
                        <button class="lab-annulla" title="aggiungi un vertice qui sopra"
                                @onclick="() => Gesto(scheda, chiave, GestoDeiVertici.Aggiungi, posizione, vertici[posizione])"
                                data-aggiungi="@posizione">+</button>
                        <button class="lab-annulla" title="togli questo vertice"
                                @onclick="() => Gesto(scheda, chiave, GestoDeiVertici.Togli, posizione)"
                                data-togli="@posizione">−</button>
                    </div>
                }
            </div>

            <details class="lab-incolla">
                <summary data-incolla="@chiave">Incolla da testo</summary>
                @* Il testo dell'AIP (archi compresi) o l'uscita del convertitore del sito: lo legge F1. *@
                <textarea class="lab-campo" rows="4" value="@(_perQuale == chiave ? _daIncollare : null)"
                          @oninput="e => { _perQuale = chiave; _daIncollare = e.Value?.ToString(); }"
                          placeholder="Testo AIP, o coordinate una per riga" data-campo="incolla"></textarea>
                @* Gli archi del testo si disegnano fitti come quelli che il file ha già: la stima la fa il Lab, l'AOD la cambia. *@
                <label class="lab-nota lab-densita">
                    Archi: un punto ogni
                    <input type="number" min="0.1" max="10" step="0.5" class="lab-campo"
                           value="@GradiPerPunto(scheda).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                           @onchange="e => _gradi = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double g) && g > 0 ? g : null"
                           data-campo="gradi-per-punto" /> °
                </label>
                <button class="lab-tasto" disabled="@(_perQuale != chiave || string.IsNullOrWhiteSpace(_daIncollare))"
                        title="@(_perQuale != chiave || string.IsNullOrWhiteSpace(_daIncollare) ? "Incolla prima il testo qui sopra" : null)"
                        @onclick="() => Incolla(scheda, chiave)" data-tasto="incolla">Sostituisci i vertici</button>
            </details>
        }

        <h2>Righe del file</h2>
        <pre class="lab-righe" data-righe="@scheda.Righe.Count">@foreach (var riga in scheda.Righe)
{<span class="@(riga.DelRecord ? "lab-riga-del-record" : "lab-riga-contesto") @(Segnalata(scheda.File, riga.Numero) ? "lab-riga-segnalata" : null)" data-riga="@riga.Numero" data-segnalata="@(Segnalata(scheda.File, riga.Numero) ? "si" : null)"><span class="lab-numero">@riga.Numero</span> @riga.Testo
</span>}</pre>
    </div>
}
else if (Lab.RigaSegnalata is { } segnata)
{
    @* Slice 10: un problema che non sta in un record. Niente scheda, ma la riga si vede, dal disco. *@
    var righe = Lab.RigheIntornoAllaSegnalata();
    <div class="lab-ispettore" data-ispettore-riga="@($"{segnata.File}:{segnata.Riga}")">
        <header>
            <p class="lab-etichetta">@segnata.File[(segnata.File.LastIndexOf('/') + 1)..], riga @segnata.Riga</p>
            <p class="lab-nota">@segnata.File · la riga non appartiene a un record</p>
        </header>
        <pre class="lab-righe">@foreach (var riga in righe)
{<span class="@(riga.DelRecord ? "lab-riga-segnalata" : "lab-riga-contesto")" data-riga="@riga.Numero" data-segnalata="@(riga.DelRecord ? "si" : null)"><span class="lab-numero">@riga.Numero</span> @riga.Testo
</span>}</pre>
    </div>
}
else if (Lab.FileScelto is not null)
{
    <p class="lab-nota lab-ispettore-vuoto">Scegli un record dall'elenco, o una forma sulla mappa.</p>
}
else
{
    <p class="lab-nota lab-ispettore-vuoto">Sfoglia l'albero, cerca un nome, o clicca una forma sulla mappa.</p>
}

@code {
    /// <summary>
    /// Quali campi si scrivono in F3 slice 6: quelli semplici del record. Gli elenchi (i vertici) sono la slice 7,
    /// e si vede dal fatto che il valore li conta invece di mostrarli.
    /// </summary>
    private bool Scrivibile(SchedaDelRecord scheda, string campo)
    {
        var proprieta = TipoDelRecord(scheda)?.GetProperty(campo);
        if (proprieta is null || !proprieta.CanWrite || proprieta.SetMethod?.IsPublic != true)
            return false;

        var tipo = Nullable.GetUnderlyingType(proprieta.PropertyType) ?? proprieta.PropertyType;
        return tipo.IsPrimitive || tipo.IsEnum || tipo == typeof(string) || tipo == typeof(decimal)
               || tipo == typeof(Vipi.Sectorfile.Shared.Coordinate);
    }

    private Type? TipoDelRecord(SchedaDelRecord scheda)
        => Lab.Sessione?.File.GetValueOrDefault(scheda.File) is IFileConRecord conRecord
           && scheda.Indice < conRecord.RecordDelModello.Count
            ? conRecord.RecordDelModello[scheda.Indice].GetType()
            : null;

    /// <summary>La riga del problema scelto nel pannello (slice 10).</summary>
    private bool Segnalata(string file, int numero) => Lab.RigaSegnalata is { } s && s.File == file && s.Riga == numero;

    private bool Toccato(SchedaDelRecord scheda, string campo)
        => Lab.Modifiche.Tutte.Any(m => m.File == scheda.File && m.Record == scheda.Indice && m.Campo == campo);

    private void Cambia(SchedaDelRecord scheda, string campo, string? valore)
        => Lab.CambiaCampo(scheda.File, scheda.Indice, campo, valore);

    private string? _daIncollare;

    /// <summary>Per quale elenco è il testo da incollare: un record può avere più tratti, ognuno col suo.</summary>
    private string? _perQuale;

    private void Gesto(SchedaDelRecord scheda, string campo, GestoDeiVertici gesto, int posizione, string? testo = null)
        => Lab.GestoSuiVertici(scheda.File, scheda.Indice, campo, gesto, posizione, testo);

    /// <summary>I gradi fra due punti d'arco scritti dall'AOD, per QUEL record; null = la stima del Lab.</summary>
    private double? _gradi;

    private (string File, int Record)? _gradiDi;

    private double GradiPerPunto(SchedaDelRecord scheda)
    {
        // Un altro record ha la sua stima: il valore scritto per il record di prima non lo segue.
        if (_gradiDi != (scheda.File, scheda.Indice))
        {
            _gradiDi = (scheda.File, scheda.Indice);
            _gradi = null;
        }

        return _gradi ?? Math.Round(1 / Lab.DensitaDegliArchiDi(scheda.File, scheda.Indice), 1);
    }

    private void Incolla(SchedaDelRecord scheda, string campo)
    {
        double puntiPerGrado = 1 / GradiPerPunto(scheda);
        if (Lab.GestoSuiVertici(scheda.File, scheda.Indice, campo, GestoDeiVertici.Incolla, testo: _daIncollare,
                                puntiPerGrado: puntiPerGrado))
            _daIncollare = null;
    }

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
