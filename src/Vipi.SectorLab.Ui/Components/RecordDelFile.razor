@implements IDisposable
@inject SessioneDelLab Lab

@*
    I record del file aperto (carta F3 §2.2 passo 2, slice 5). 🔴 Stava in fondo alla colonna Sfoglia, dopo tutto
    l'albero: con la cartella IT aperta (centinaia di file) finiva fuori dallo schermo, e scegliere OTHER/lirr.ap
    sembrava non fare niente (prova 12 di F3-bis, 23 settembre). Ora si disegna subito sotto il file scelto.
    Si iscrive da sé a Cambiata: il suo parametro è una stringa che non cambia, e nessuno lo ridisegnerebbe.
*@
@if (Lab.Sessione?.File.GetValueOrDefault(Relativo) is { } file)
{
    <div class="lab-record" data-file-aperto="@Relativo">
        <Sezione Chiave="file-record">
        <Titolo>@Nome(Relativo) <span class="lab-nota">@file.Record.ToString("N0") record</span></Titolo>
        <ChildContent>
        @if (file.Record == 0)
        {
            <p class="lab-nota">Il motore non interpreta questo file: si vede come testo (slice 5 non lo apre).</p>
        }
        else
        {
            @* Un record nuovo senza sceglierne uno prima (prova 6 del committente, 23 settembre). *@
            <p class="lab-gesti-record">
                <NuovoRecord File="@Relativo" />
                <button class="lab-tasto lab-tasto-tenue @(Lab.EInVista(Relativo, null) ? "lab-tasto-acceso" : null)"
                        data-tasto="vista-file" @onclick="() => Lab.CambiaLaVista(Relativo, null)"
                        title="@(Lab.EInVista(Relativo, null) ? "Toglilo da quel che la mappa mostra" : "Sulla mappa solo questo file (e quel che aggiungi alla vista)")">
                    @(Lab.EInVista(Relativo, null) ? "◉ In vista" : "◎ Solo questo file sulla mappa")
                </button>
            </p>
            <input type="search" class="lab-cerca" placeholder="Filtra i record" value="@_filtro"
                   @oninput="e => _filtro = e.Value?.ToString() ?? string.Empty" data-campo="filtra" />
            @* Slice 6: le voci come la finestra di selezione di Aurora, sopra l'elenco dei record. *@
            <VociDelFile File="@Relativo" Filtro="@_filtro" />
            var voci = Voci();
            @* Slice 5c: i record nascosti (commentati) restano nell'elenco, grigi, al loro posto. *@
            var nascosti = Lab.NascostiDi(Relativo);
            var fra = nascosti.Fra;
            foreach (var blocco in fra.Where(b => b.DopoIlRecord < 0 && Passa(b.Etichetta)))
            {
                <NascostoNellElenco File="@Relativo" Blocco="blocco" />
            }
            foreach (var voce in voci.Take(Tetto))
            {
                <button class="@Classe(nascosti, voce.Indice)" title="@Titolo(nascosti, voce.Indice)"
                        @onclick="() => Lab.Scegli(Relativo, voce.Indice)" data-record="@voce.Indice">
                    <span class="lab-numero">@voce.Indice</span> @voce.Etichetta
                    @if (nascosti.InParte.TryGetValue(voce.Indice, out var sue))
                    {
                        <span class="lab-nota" data-in-parte="@sue.Count">◑ @sue.Count</span>
                    }
                </button>
                foreach (var blocco in fra.Where(b => b.DopoIlRecord == voce.Indice && Passa(b.Etichetta)))
                {
                    <NascostoNellElenco File="@Relativo" Blocco="blocco" />
                }
            }
            if (voci.Count > Tetto)
            {
                <p class="lab-nota" data-troppi="@voci.Count">@voci.Count.ToString("N0") record: ne vedi @Tetto. Filtra per arrivare agli altri.</p>
            }
        }
        </ChildContent>
        </Sezione>
    </div>
}

@code {
    /// <summary>Quanti record per volta: oltre non si legge, si filtra. (Il resto si trova con la ricerca.)</summary>
    internal const int Tetto = 200;

    [Parameter, EditorRequired] public string Relativo { get; set; } = null!;

    private string _filtro = string.Empty;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private IReadOnlyList<(int Indice, string Etichetta)> Voci()
    {
        var voci = Lab.EtichetteDi(Relativo).Select((e, i) => (Indice: i, Etichetta: e));
        return _filtro.Trim() is { Length: > 0 } filtro
            ? [.. voci.Where(v => v.Etichetta.Contains(filtro, StringComparison.OrdinalIgnoreCase))]
            : [.. voci];
    }

    private bool Passa(string etichetta) => _filtro.Trim() is not { Length: > 0 } filtro || etichetta.Contains(filtro, StringComparison.OrdinalIgnoreCase);

    private string Classe(AnalisiDeiNascosti nascosti, int indice)
        => "lab-voce" + (Lab.Scelta == (Relativo, indice) ? " lab-scelto" : "") + (nascosti.Dentro.Contains(indice) ? " lab-nascosto" : "");

    private static string? Titolo(AnalisiDeiNascosti nascosti, int indice)
        => nascosti.Dentro.Contains(indice) ? "Nascosto: le sue righe sono commentate"
            : nascosti.InParte.TryGetValue(indice, out var sue) ? $"{sue.Count} righe nascoste (commentate) dentro questo record"
            : null;

    private static string Nome(string relativo) => relativo[(relativo.LastIndexOf('/') + 1)..];

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
