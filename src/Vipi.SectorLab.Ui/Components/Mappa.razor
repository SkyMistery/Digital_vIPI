@implements IAsyncDisposable
@inject IJSRuntime Js
@inject SessioneDelLab Lab

@*
    La mappa (carta F3 §2.2 passo 4, slice 4). Il componente non porta coordinate: dice al JavaScript quali strati
    accendere, e quello se li prende con una fetch (§3). Così il circuito resta leggero anche con 244 227 punti.

    🔴 Si iscrive da sé a SessioneDelLab.Cambiata, e NON aspetta di essere ridisegnato: un componente senza parametri
    Blazor non lo rirende quando il padre cambia, e la mappa resterebbe ferma su quello che aveva al primo giro (preso
    dal test della casella, che vedeva arrivare solo lo sfondo).
*@
<div id="@Elemento" class="lab-mappa" data-mappa="@(_creata ? "viva" : "spenta")"></div>

@code {
    /// <summary>L'id dell'elemento: uno solo per pagina, ma il test ne può creare un altro.</summary>
    [Parameter] public string Elemento { get; set; } = "lab-mappa";

    private DotNetObjectReference<Mappa>? _riferimento;
    private bool _creata;
    private bool _dalClic;
    private readonly HashSet<string> _disegnati = new(StringComparer.Ordinal);
    private (string File, int Record)? _evidenziata;
    /// <summary>La versione di ogni strato quando l'ha disegnato: se il Lab ne ha una più nuova, lo strato si riprende.</summary>
    private readonly Dictionary<string, int> _versioni = new(StringComparer.Ordinal);
    private int _versioneDellAnteprima;
    private int _versioneDellaVista;
    private int _inquadrature;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    protected override async Task OnAfterRenderAsync(bool primo)
    {
        if (!primo) return;
        _riferimento = DotNetObjectReference.Create(this);
        _creata = await Js.InvokeAsync<bool>("sectorlab.mappa.crea", Elemento, _riferimento);
        await InFila();
    }

    /// <summary>
    /// 🔴 Una sincronizzazione alla volta. Scegliere un record accende il suo strato e fa partire più avvisi di fila:
    /// due giri insieme chiedevano lo stesso strato due volte, perché ognuno lo segnava come disegnato solo DOPO la
    /// fetch — e la seconda copia restava sulla mappa anche spegnendo la casella (committente, 24 settembre).
    /// </summary>
    private readonly SemaphoreSlim _fila = new(1, 1);

    private async Task InFila()
    {
        await _fila.WaitAsync();
        try
        {
            await Sincronizza();
        }
        finally
        {
            _fila.Release();
        }
    }

    /// <summary>Porta la mappa dov'è lo stato: gli strati accesi, e l'evidenza sul record scelto.</summary>
    private async Task Sincronizza()
    {
        if (!_creata) return;

        // Una modifica ha cambiato la geometria di uno strato: la mappa ce l'ha in memoria, va ripresa (slice 6).
        // Senza strato indicato si riprendono tutti: dopo un salvataggio i cataloghi sono rifatti (slice 9).
        // Si riprende ogni strato la cui geometria non è più quella disegnata: un gesto sulle copie gemelle ne tocca più d'uno.
        bool ridisegnato = false;
        foreach (string strato in _disegnati.Where(s => Lab.VersioneDelloStrato(s) != _versioni.GetValueOrDefault(s)).ToList())
        {
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, false);
            _disegnati.Remove(strato);
            ridisegnato = true;
        }

        var daAccendere = Lab.Accesi.Where(s => !_disegnati.Contains(s)).ToList();
        foreach (string strato in daAccendere)
        {
            _versioni[strato] = Lab.VersioneDelloStrato(strato);
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, true);
            _disegnati.Add(strato);
        }

        // L'anteprima di «incolla da testo», tratteggiata sopra la forma di oggi. Le coordinate passano dal circuito:
        // sono centinaia di punti al più, e vanno dal server alla pagina (il tetto dei 32 KB è nell'altro verso).
        if (_versioneDellAnteprima != Lab.VersioneDellAnteprima)
        {
            _versioneDellAnteprima = Lab.VersioneDellAnteprima;
            var anteprima = Lab.Anteprima;
            double[] punti = anteprima is null ? [] : [.. anteprima.Letto.Punti.SelectMany(p => new[] { p.Lat, p.Lon })];
            double[] centri = anteprima is null ? [] : [.. anteprima.Letto.Centri.SelectMany(p => new[] { p.Lat, p.Lon })];
            await Js.InvokeVoidAsync("sectorlab.mappa.anteprima", punti, centri);
        }

        // Quando tutto quel che era da accendere è arrivato, il totale va nel diario: è la misura del primo disegno.
        if (daAccendere.Count > 0)
            await Js.InvokeVoidAsync("sectorlab.mappa.disegnata");

        bool spento = false;
        foreach (string strato in _disegnati.Where(s => !Lab.Accesi.Contains(s)).ToList())
        {
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, false);
            _disegnati.Remove(strato);
            spento = true;
        }

        // La vista: solo gli elementi scelti (e le coste). Si riprende anche quando gli strati cambiano: le forme di
        // uno strato ridisegnato sono oggetti nuovi, e uno strato acceso adesso non deve comparire tutto.
        if (_versioneDellaVista != Lab.VersioneDellaVista || ridisegnato || spento || daAccendere.Count > 0)
        {
            _versioneDellaVista = Lab.VersioneDellaVista;
            // 🔴 (object): un string[] passato da solo diventa gli ARGOMENTI (covarianza con object[]), una chiave per
            // argomento — il JS riceveva una stringa, non un elenco, e la vista restava vuota (committente, 24 settembre).
            await Js.InvokeVoidAsync("sectorlab.mappa.vista", (object)Lab.InVista.ToArray());
        }

        // Si rievidenzia quando cambia la scelta, quando si chiede di nuovo lo stesso record (il secondo clic
        // sull'elenco), e quando lo strato è stato ridisegnato: la forma evidenziata di prima non c'è più.
        bool richiesta = _inquadrature != Lab.Inquadrature;
        if (_evidenziata != Lab.Scelta || richiesta || ridisegnato)
        {
            _evidenziata = Lab.Scelta;
            _inquadrature = Lab.Inquadrature;
            // Si inquadra solo se la scelta NON viene dalla mappa: chi ha appena cliccato una forma non vuole che
            // la mappa gli salti sotto il dito. Dopo una modifica del record scelto la mappa lo segue dov'è ora.
            bool segue = ridisegnato && _evidenziata is { } scelta && scelta.File == Lab.FileRifatto;
            await Js.InvokeAsync<bool>("sectorlab.mappa.evidenzia", _evidenziata?.File, _evidenziata?.Record ?? 0,
                                       !_dalClic && (richiesta || segue));
            _dalClic = false;
        }
    }

    private void Aggiorna() => _ = InvokeAsync(InFila);

    /// <summary>Il clic su una forma: la sceglie. La chiama il JavaScript della mappa.</summary>
    [JSInvokable]
    public void SceltaDallaMappa(string file, int record)
    {
        _dalClic = true;
        Lab.Scegli(file, record);
    }

    public async ValueTask DisposeAsync()
    {
        Lab.Cambiata -= Aggiorna;
        try
        {
            if (_creata) await Js.InvokeVoidAsync("sectorlab.mappa.chiudi");
        }
        catch (JSDisconnectedException)
        {
            // La finestra se n'è andata: non c'è più nessuno a cui dirlo.
        }

        _riferimento?.Dispose();
    }
}
