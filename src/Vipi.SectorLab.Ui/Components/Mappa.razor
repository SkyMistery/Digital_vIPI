@implements IAsyncDisposable
@inject IJSRuntime Js
@inject SessioneDelLab Lab

@*
    La mappa (carta F3 §2.2 passo 4, slice 4). Il componente non porta coordinate: dice al JavaScript quali strati
    accendere, e quello se li prende con una fetch (§3). Così il circuito resta leggero anche con 244 227 punti.

    🔴 Si iscrive da sé a SessioneDelLab.Cambiata, e NON aspetta di essere ridisegnato: un componente senza parametri
    Blazor non lo rirende quando il padre cambia, e la mappa resterebbe ferma su quello che aveva al primo giro (preso
    dal test della casella, che vedeva arrivare solo lo sfondo).

    Riordino R4 (D15): un motore, tre mappe — una per spazio di lavoro, ognuna col suo stato (strati accesi, vista, voci
    spente: SessioneDelLab.Mappa(spazio)). Ogni chiamata al JavaScript porta l'id del suo elemento per ultimo.
*@
<div id="@Elemento" class="lab-mappa" data-mappa="@(_creata ? "viva" : "spenta")" data-spazio="@Spazio.ToString().ToLowerInvariant()"></div>

@code {
    /// <summary>Lo spazio di lavoro di questa mappa.</summary>
    [Parameter] public SpazioDiLavoro Spazio { get; set; } = SpazioDiLavoro.Sector;

    /// <summary>L'id dell'elemento: «lab-mappa» quella del sector (la principale), le altre col nome dello spazio.</summary>
    private string Elemento => Spazio is SpazioDiLavoro.Sector ? "lab-mappa" : "lab-mappa-" + Spazio.ToString().ToLowerInvariant();

    private StatoDellaMappa Stato => Lab.Mappa(Spazio);

    private DotNetObjectReference<Mappa>? _riferimento;
    private bool _creata;
    private bool _dalClic;
    private readonly HashSet<string> _disegnati = new(StringComparer.Ordinal);
    private (string File, int Record)? _evidenziata;
    /// <summary>La versione di ogni strato quando l'ha disegnato: se il Lab ne ha una più nuova, lo strato si riprende.</summary>
    private readonly Dictionary<string, int> _versioni = new(StringComparer.Ordinal);
    private int _versioneDellAnteprima;
    private int _versioneDellaVista;
    private int _versioneDeiSpenti;
    private int _versioneDeiColori = -1;
    private int _inquadrature;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    protected override async Task OnAfterRenderAsync(bool primo)
    {
        if (!primo) return;
        _riferimento = DotNetObjectReference.Create(this);
        _creata = await Js.InvokeAsync<bool>("sectorlab.mappa.crea", Elemento, _riferimento);
        // R6 (D18): la mappa del Confronto mostra i due lati in due colori fissi.
        if (_creata && Spazio is SpazioDiLavoro.Confronti)
            await Js.InvokeVoidAsync("sectorlab.mappa.dueLati", true, Elemento);
        await InFila();
    }

    /// <summary>
    /// 🔴 Una sincronizzazione alla volta. Scegliere un record accende il suo strato e fa partire più avvisi di fila:
    /// due giri insieme chiedevano lo stesso strato due volte, perché ognuno lo segnava come disegnato solo DOPO la
    /// fetch — e la seconda copia restava sulla mappa anche spegnendo la casella (committente, 24 settembre).
    /// </summary>
    private readonly SemaphoreSlim _fila = new(1, 1);

    private async Task InFila()
    {
        await _fila.WaitAsync();
        try
        {
            await Sincronizza();
        }
        finally
        {
            _fila.Release();
        }
    }

    /// <summary>Porta la mappa dov'è lo stato: gli strati accesi, e l'evidenza sul record scelto.</summary>
    private async Task Sincronizza()
    {
        if (!_creata) return;

        // I colori prima degli strati: uno strato che arriva adesso si disegna già nel modo giusto (slice 4).
        if (_versioneDeiColori != Lab.VersioneDeiColori)
        {
            _versioneDeiColori = Lab.VersioneDeiColori;
            string? sfondo = Lab.Colori?.Sfondo is { } c ? $"#{c.R:X2}{c.G:X2}{c.B:X2}" : null;
            // I simboli di Aurora (slice 17b) viaggiano qui, una volta: sono pochi (19 ruoli), le forme dicono solo l'indice.
            string[][] simboli = Lab.Simboli is { } s ? [.. s.Simboli.Select(x => x.Colonne.ToArray())] : [];
            await Js.InvokeVoidAsync("sectorlab.mappa.colori", Lab.ColoriDiAurora && Lab.Colori is not null, sfondo, simboli, Elemento);
        }
        var accesi = Lab.AccesiDi(Spazio);

        // Una modifica ha cambiato la geometria di uno strato: la mappa ce l'ha in memoria, va ripresa (slice 6).
        // Senza strato indicato si riprendono tutti: dopo un salvataggio i cataloghi sono rifatti (slice 9).
        // Si riprende ogni strato la cui geometria non è più quella disegnata: un gesto sulle copie gemelle ne tocca più d'uno.
        bool ridisegnato = false;
        foreach (string strato in _disegnati.Where(s => Lab.VersioneDelloStrato(s) != _versioni.GetValueOrDefault(s)).ToList())
        {
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, false, Elemento);
            _disegnati.Remove(strato);
            ridisegnato = true;
        }

        var daAccendere = accesi.Where(s => !_disegnati.Contains(s)).ToList();
        foreach (string strato in daAccendere)
        {
            _versioni[strato] = Lab.VersioneDelloStrato(strato);
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, true, Elemento);
            _disegnati.Add(strato);
        }

        // L'anteprima di «incolla da testo», tratteggiata sopra la forma di oggi. Le coordinate passano dal circuito:
        // sono centinaia di punti al più, e vanno dal server alla pagina (il tetto dei 32 KB è nell'altro verso).
        // È del sector: sulla mappa dell'AIP espanso no.
        if (Spazio is not SpazioDiLavoro.Aip && _versioneDellAnteprima != Lab.VersioneDellAnteprima)
        {
            _versioneDellAnteprima = Lab.VersioneDellAnteprima;
            var anteprima = Lab.Anteprima;
            double[] punti = anteprima is null ? [] : [.. anteprima.Letto.Punti.SelectMany(p => new[] { p.Lat, p.Lon })];
            double[] centri = anteprima is null ? [] : [.. anteprima.Letto.Centri.SelectMany(p => new[] { p.Lat, p.Lon })];
            await Js.InvokeVoidAsync("sectorlab.mappa.anteprima", punti, centri, Elemento);
        }

        // Quando tutto quel che era da accendere è arrivato, il totale va nel diario: è la misura del primo disegno.
        if (daAccendere.Count > 0)
            await Js.InvokeVoidAsync("sectorlab.mappa.disegnata", Elemento);

        bool spento = false;
        foreach (string strato in _disegnati.Where(s => !accesi.Contains(s)).ToList())
        {
            await Js.InvokeAsync<int>("sectorlab.mappa.strato", strato, false, Elemento);
            _disegnati.Remove(strato);
            spento = true;
        }

        // La vista: solo gli elementi scelti (e le coste). Si riprende anche quando gli strati cambiano: le forme di
        // uno strato ridisegnato sono oggetti nuovi, e uno strato acceso adesso non deve comparire tutto.
        if (_versioneDellaVista != Stato.VersioneDellaVista || ridisegnato || spento || daAccendere.Count > 0)
        {
            _versioneDellaVista = Stato.VersioneDellaVista;
            await Js.InvokeVoidAsync("sectorlab.mappa.vista", Lab.InVistaDi(Spazio).ToArray(), Elemento);
        }

        // Slice 6: le voci e le parti spente dall'albero del file. Gli strati che arrivano dopo le spengono da sé.
        if (_versioneDeiSpenti != Stato.VersioneDeiSpenti)
        {
            _versioneDeiSpenti = Stato.VersioneDeiSpenti;
            await Js.InvokeVoidAsync("sectorlab.mappa.spenti", Lab.SpentiDi(Spazio).ToArray(), Elemento);
        }

        // Si rievidenzia quando cambia la scelta, quando si chiede di nuovo lo stesso record (il secondo clic
        // sull'elenco), e quando lo strato è stato ridisegnato: la forma evidenziata di prima non c'è più.
        bool richiesta = _inquadrature != Lab.Inquadrature;
        var sceltaQui = Lab.SceltaDi(Spazio);
        if (_evidenziata != sceltaQui || richiesta || ridisegnato)
        {
            _evidenziata = sceltaQui;
            _inquadrature = Lab.Inquadrature;
            _evidenziataRifatta = true;
            // Si inquadra solo se la scelta NON viene dalla mappa: chi ha appena cliccato una forma non vuole che
            // la mappa gli salti sotto il dito. Dopo una modifica del record scelto la mappa lo segue dov'è ora.
            bool segue = ridisegnato && _evidenziata is { } scelta && scelta.File == Lab.FileRifatto;
            await Js.InvokeAsync<bool>("sectorlab.mappa.evidenzia", _evidenziata?.File, _evidenziata?.Record ?? 0,
                                       !_dalClic && (richiesta || segue), Elemento);
            _dalClic = false;
        }

        // R6 (D18): la coppia della riga del Confronto, dopo l'evidenza (che ha lo stile di una sola forma). Si rifà anche
        // quando gli strati arrivano o cambiano: le forme di prima non ci sono più. Si inquadra solo a una scelta nuova.
        if (Spazio is SpazioDiLavoro.Confronti
            && (_versioneDellaCoppia != Lab.VersioneDellaCoppia || ridisegnato || daAccendere.Count > 0 || _evidenziataRifatta))
        {
            bool nuova = _versioneDellaCoppia != Lab.VersioneDellaCoppia;
            _versioneDellaCoppia = Lab.VersioneDellaCoppia;
            var (sector, aip) = Lab.CoppiaDelConfronto;
            await Js.InvokeAsync<int>("sectorlab.mappa.coppia", sector?.File, sector?.Record ?? 0, aip?.File, aip?.Record ?? 0, nuova, Elemento);
        }
        _evidenziataRifatta = false;

        // S3 (carta «Gli aeroporti nel Lab»): la carta posata e il punto della posa da prendere, solo sulla mappa dell'AIP.
        if (Spazio is SpazioDiLavoro.Aip)
        {
            if (_versioneDellaCarta != Lab.VersioneDellaCarta || _inquadratureDellaCarta != Lab.InquadratureDellaCarta)
            {
                bool inquadra = _inquadratureDellaCarta != Lab.InquadratureDellaCarta;
                _versioneDellaCarta = Lab.VersioneDellaCarta;
                _inquadratureDellaCarta = Lab.InquadratureDellaCarta;
                var carta = Lab.CartaSullaMappa;
                double[][]? angoli = carta is null ? null : [.. carta.Angoli.Select(a => new[] { a.LatitudeDeg, a.LongitudeDeg })];
                await Js.InvokeVoidAsync("sectorlab.mappa.carta", carta?.Indirizzo, angoli, carta?.Opacita ?? 1, inquadra && carta is not null, Elemento);
            }
            if (_prende != Lab.PrendeUnPuntoDallaMappa)
            {
                _prende = Lab.PrendeUnPuntoDallaMappa;
                await Js.InvokeVoidAsync("sectorlab.mappa.prendi", _prende, Elemento);
            }
            // S4: il tratto che si ridisegna sopra la carta, tratteggiato come l'anteprima di «incolla da testo».
            if (_versioneDelTracciato != Lab.VersioneDelTracciato)
            {
                _versioneDelTracciato = Lab.VersioneDelTracciato;
                double[] punti = [.. Lab.AnteprimaDelTracciato.SelectMany(p => new[] { p.LatitudeDeg, p.LongitudeDeg })];
                await Js.InvokeVoidAsync("sectorlab.mappa.anteprima", punti, Array.Empty<double>(), Elemento);
            }
        }
    }

    private int _versioneDelTracciato;
    private int _versioneDellaCarta;
    private int _inquadratureDellaCarta;
    private bool _prende;

    /// <summary>S3: il posto del punto della posa in attesa, dal clic sulla mappa (o su un punto dell'AIP, col suo nome).</summary>
    [JSInvokable]
    public void PuntoDallaMappa(double lat, double lon, string? nome) => Lab.PuntoDallaMappa(lat, lon, nome);

    private int _versioneDellaCoppia;

    // L'evidenza appena rifatta ha ridato lo stile alla sua forma: se è della coppia, la coppia si rimette.
    private bool _evidenziataRifatta;

    private void Aggiorna() => _ = InvokeAsync(InFila);

    /// <summary>Il clic su una forma: la sceglie. La chiama il JavaScript della mappa.</summary>
    [JSInvokable]
    public void SceltaDallaMappa(string file, int record)
    {
        // S5: sulla mappa dell'AIP espanso il ground del sector sta sopra la carta per guardarlo; sceglierne una forma
        // chiuderebbe la pagina dello scalo. Il nome lo dice il suggerimento.
        if (Spazio is SpazioDiLavoro.Aip && !Vipi.SectorLab.Core.PdfAip.AipSullaMappa.EDellAip(file))
            return;
        _dalClic = true;
        Lab.Scegli(file, record);
    }

    public async ValueTask DisposeAsync()
    {
        Lab.Cambiata -= Aggiorna;
        try
        {
            if (_creata) await Js.InvokeVoidAsync("sectorlab.mappa.chiudi", Elemento);
        }
        catch (JSDisconnectedException)
        {
            // La finestra se n'è andata: non c'è più nessuno a cui dirlo.
        }

        _riferimento?.Dispose();
    }
}
