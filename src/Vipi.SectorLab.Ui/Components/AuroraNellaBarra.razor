@implements IDisposable
@inject SessioneDelLab Lab

@*
    La vetrina di Aurora nella barra (carta F5, slice 1): che cosa c'è dentro (da quale sector, ramo, quando) e se Aurora
    la legge come «secondo sector». Aperto, il riquadro ha «Porta in Aurora»: la SectorFiles del sector aperto in
    vetrina, come specchio. Aurora non si tocca: dove guarda lo sceglie l'AOD, in Aurora, una volta.
    Il lotto (slice 2): i gesti salvati da «visto in Aurora», ognuno con dove guardarlo; il conto nella barra.
*@
<section class="lab-riquadro lab-ramo-riquadro" data-riquadro-aurora>
    <h2 class="lab-riquadro-titolo @(Lab.CartellaDellaVetrina is not null && !Lab.AuroraGuardaLaVetrina ? "lab-ramo-da-fare" : null)"
             title="La vetrina: la cartella che Aurora legge come secondo sector" data-aurora>
        <span aria-hidden="true">◫</span> Aurora
        <span class="lab-nota" data-in-vetrina>@Riassunto()</span>
        @if (ContoDelLotto() is { } conto)
        {
            <span class="lab-conto-lotto" data-conto-lotto>@conto</span>
        }
    </h2>
    <div class="lab-impostazioni-riquadro">
        @if (Lab.CartellaDellaVetrina is not { } vetrina)
        {
            <p class="lab-nota" data-senza-vetrina>Manca la cartella della vetrina: sceglila nelle Impostazioni (una cartella nuova,
                per esempio <code>D:\IVAO\Aurora-vetrina</code>). Poi in Aurora metti come secondo sector la sua <code>SectorFiles</code>, una volta.</p>
        }
        else
        {
            <p class="lab-nota">Vetrina: <code>@vetrina</code></p>
            @if (Lab.AuroraGuardaLaVetrina)
            {
                <p class="lab-nota" data-aurora-guarda="si">Aurora la legge come secondo sector.</p>
            }
            else
            {
                <p class="lab-avviso-breve" data-aurora-guarda="no">Aurora legge come secondo sector
                    <code>@(Lab.SecondoSectorDiAurora ?? "— nessuno")</code>. In Aurora mettilo su
                    <code>@Vipi.SectorLab.Core.Aurora.Vetrina.SectorFilesDi(vetrina)</code>, una volta: poi il Lab sceglie cosa c'è dentro.</p>
            }
            @if (Lab.InVetrina is { } dentro)
            {
                <p class="lab-nota" data-contenuto-vetrina>Dentro: <code>@dentro.Sorgente</code>@(dentro.Ramo is null ? "" : $" · {dentro.Ramo}")@(dentro.Commit is null ? "" : $" @ {dentro.Commit}"), portato il @Vipi.SectorLab.Core.Aurora.Vetrina.Ora(dentro.Quando).</p>
            }
            <button type="button" class="lab-tasto" data-tasto="porta-in-aurora" disabled="@(Lab.StaPortandoInAurora || Lab.Sessione is null)"
                    title="La SectorFiles di questo sector in vetrina: poi una ricarica in Aurora" @onclick="Porta">Porta in Aurora</button>
            <span class="lab-nota">questo sector: <code>@Lab.Sessione?.Cartella.Radice</code>@(Lab.Ramo?.Ramo is { } r ? $" · {r}" : "")</span>
            @if (Lab.UltimoPortaInAurora is { } esito)
            {
                <p class="lab-nota" data-esito-vetrina>Fatto: @esito.Copiati file copiati, @esito.Tolti tolti, @esito.Uguali uguali. Ora ricarica il sector in Aurora.</p>
            }
            @if (_rifiuto is not null)
            {
                <p class="lab-avviso-breve" data-rifiuto-vetrina>@_rifiuto</p>
            }
        }
        @if (Lab.Lotto is { Voci.Count: > 0 } lotto)
        {
            <div data-lotto>
                <p class="lab-nota"><strong>Da guardare in Aurora</strong>@(lotto.Visto is { } visto ? $" — dall'ultimo «visto», il {Vipi.SectorLab.Core.Aurora.Vetrina.Ora(visto)}" : "")
                    · dove guardare: proposta del Lab, da confermare</p>
                <ul class="lab-elenco-lotto">
                    @for (int i = 0; i < lotto.Voci.Count; i++)
                    {
                        int indice = i;
                        var voce = lotto.Voci[i];
                        bool daVedere = voce.Portata is not null && Lab.InVetrinaCeQuesto;
                        <li data-voce-lotto="@(daVedere ? "da-vedere" : "da-portare")" data-esito="@voce.Esito">
                            @* Slice 3: com'è andata in Aurora — ✅ come doveva, ❌ con due parole; un secondo clic toglie. *@
                            @if (daVedere)
                            {
                                <span class="lab-esiti">
                                    <button type="button" class="lab-esito @(voce.Esito == EsitoInAurora.Come ? "lab-esito-scelto" : null)" data-tasto="esito-come"
                                            title="Come doveva" @onclick="() => Segna(indice, voce.Esito == EsitoInAurora.Come ? null : EsitoInAurora.Come)">✅</button>
                                    <button type="button" class="lab-esito @(voce.Esito == EsitoInAurora.NonVa ? "lab-esito-scelto" : null)" data-tasto="esito-non-va"
                                            title="Non va: scrivi due parole" @onclick="() => Segna(indice, voce.Esito == EsitoInAurora.NonVa ? null : EsitoInAurora.NonVa, voce.Nota)">❌</button>
                                </span>
                            }
                            <span>@voce.Cosa</span>
                            <span class="lab-nota">→ @voce.Dove · @(voce.Portata is { } p ? $"in vetrina dal {Vipi.SectorLab.Core.Aurora.Vetrina.Ora(p)}" : voce.Prova is not null ? "domanda della prova, da portare" : $"salvato il {Vipi.SectorLab.Core.Aurora.Vetrina.Ora(voce.Salvata)}, da portare")</span>
                            @if (daVedere && voce.Esito == EsitoInAurora.NonVa)
                            {
                                <input type="text" class="lab-cerca" data-campo="nota-esito" placeholder="Che cosa non va? (l'etichetta copre il fix…)"
                                       value="@voce.Nota" @onchange="e => Segna(indice, EsitoInAurora.NonVa, e.Value?.ToString())" />
                            }
                        </li>
                    }
                </ul>
                @if (lotto.DaVedere > 0 && Lab.InVetrinaCeQuesto)
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="visto-in-aurora"
                            title="Hai ricaricato Aurora e guardato le voci in vetrina: le ✅ e quelle non segnate escono dal lotto, le ❌ restano come note sui loro record"
                            @onclick="Lab.VistoInAurora">Visto in Aurora</button>
                }
            </div>
        }
        @* Slice 4: le prove in Aurora come lotti — un ramo prova/… con la variante, le domande nel lotto, il ramo si butta. *@
        <div class="lab-prove" data-prove>
            <p class="lab-nota"><strong>Prove in Aurora</strong></p>
            @if (Lab.ProvaInCorso is { } prova)
            {
                <p class="lab-nota" data-prova-in-corso="@prova.Argomento">Sei sulla prova: <strong>@prova.Titolo</strong> (ramo <code>@prova.Ramo</code>, solo su
                    questo PC: non si manda). Portala in Aurora, rispondi alle domande qui sopra, «Visto in Aurora»; poi buttala.</p>
                @if (_confermaButta)
                {
                    <p class="lab-avviso-breve">Il ramo <code>@prova.Ramo</code> si cancella e si torna a <code>@(Lab.BaseDelRamo ?? "?")</code>. Le risposte date restano.</p>
                    <button type="button" class="lab-tasto" data-tasto="butta-prova-sicuro" disabled="@Lab.StaCambiandoRamo" @onclick="Butta">Sì, butta la prova</button>
                    <button type="button" class="lab-tasto lab-tasto-tenue" @onclick="() => _confermaButta = false">No</button>
                }
                else
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="butta-prova" @onclick="() => _confermaButta = true">Butta la prova e torna a @(Lab.BaseDelRamo ?? "?")</button>
                }
            }
            else if (Lab.Ramo is null)
            {
                <p class="lab-nota">Le prove si preparano in un clone git: il Lab fa un ramo prova/… con la variante.</p>
            }
            else
            {
                <ul class="lab-elenco-lotto">
                    @foreach (var p in ProveInAurora.Tutte)
                    {
                        var questa = p;
                        <li data-prova="@questa.Argomento">
                            <span>@questa.Titolo</span>
                            <span class="lab-nota">@questa.Perche</span>
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prepara-prova" disabled="@Lab.StaCambiandoRamo"
                                    title="Un ramo @questa.Ramo da @Lab.Ramo.Ramo con la variante, e le domande nel lotto" @onclick="() => Prepara(questa.Argomento)">Prepara la prova</button>
                        </li>
                    }
                </ul>
            }
            @if (_rifiuto is not null && Lab.CartellaDellaVetrina is null)
            {
                @* Con la vetrina il rifiuto si legge già sopra, sotto «Porta in Aurora». *@
                <p class="lab-avviso-breve" data-rifiuto-prova>@_rifiuto</p>
            }
            @if (Lab.Lotto is { EsitiDelleProve.Count: > 0 } conEsiti)
            {
                <p class="lab-nota">Le risposte:</p>
                <ul class="lab-elenco-lotto" data-esiti-delle-prove="@conEsiti.EsitiDelleProve.Count">
                    @foreach (var esito in conEsiti.EsitiDelleProve)
                    {
                        <li data-esito-prova="@esito.Esito">
                            @(esito.Esito switch { EsitoInAurora.Come => "✅", EsitoInAurora.NonVa => "❌", _ => "—" }) @esito.Domanda
                            <span class="lab-nota">@(ProveInAurora.Tutte.FirstOrDefault(t => t.Argomento == esito.Prova)?.Titolo ?? esito.Prova)@(esito.Nota is null ? "" : " · " + esito.Nota) · @Vetrina.Ora(esito.Quando)</span>
                        </li>
                    }
                </ul>
            }
        </div>
        @if (Lab.NoteDaAurora.Count > 0)
        {
            <p class="lab-nota" data-note-da-aurora="@Lab.NoteDaAurora.Count">❌ @(Lab.NoteDaAurora.Count == 1 ? "1 nota" : $"{Lab.NoteDaAurora.Count} note") da Aurora sui record: nella scheda e in cima ai Problemi.</p>
        }
    </div>
</section>

@code {
    private string? _rifiuto;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private async Task Porta() => _rifiuto = await Lab.PortaInAuroraAsync() ? null : Lab.Rifiuto;

    private void Segna(int indice, EsitoInAurora? esito, string? nota = null) => Lab.SegnaNelLotto(indice, esito, nota);

    private bool _confermaButta;

    private async Task Prepara(string argomento) => _rifiuto = await Lab.PreparaLaProvaAsync(argomento) ? null : Lab.Rifiuto;

    private async Task Butta()
    {
        _confermaButta = false;
        _rifiuto = await Lab.ButtaLaProvaAsync() ? null : Lab.Rifiuto;
    }

    /// <summary>Il conto del lotto nella barra: da vedere se in vetrina c'è questo sector, se no da portare.</summary>
    private string? ContoDelLotto()
    {
        if (Lab.Lotto is not { Voci.Count: > 0 } lotto)
            return null;
        int vedere = Lab.InVetrinaCeQuesto ? lotto.DaVedere : 0;
        int portare = lotto.Voci.Count - vedere;
        var parti = new List<string>();
        if (vedere > 0)
            parti.Add(vedere == 1 ? "1 modifica da vedere" : $"{vedere} modifiche da vedere");
        if (portare > 0)
            parti.Add($"{portare} da portare");
        return string.Join(" · ", parti);
    }

    private string Riassunto()
    {
        if (Lab.StaPortandoInAurora)
            return "…";
        if (Lab.CartellaDellaVetrina is null)
            return "senza vetrina";
        if (Lab.InVetrina is not { } dentro)
            return "vetrina vuota";
        bool questo = Lab.Sessione is { } s && string.Equals(Path.GetFullPath(s.Cartella.Radice), dentro.Sorgente, StringComparison.OrdinalIgnoreCase);
        return $"{(questo ? "questo sector" : Path.GetFileName(dentro.Sorgente))}{(dentro.Ramo is null ? "" : " · " + dentro.Ramo)}{(Lab.AuroraGuardaLaVetrina ? "" : " · Aurora guarda altrove")}";
    }
}
