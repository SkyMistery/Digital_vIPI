@implements IDisposable
@inject SessioneDelLab Lab
@using Famiglia = Vipi.SectorLab.Core.PdfAip.FamigliaDelConfronto
@using Esiti = Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto
@using Ad2 = Vipi.SectorLab.Core.PdfAip.ParteDiAd2

@*
    I PDF dell'AIP nella barra (carta F6, slice 0c): la cartella dei PDF, «Prendi i PDF da Download» (sposta, solo su questo
    tasto), e «Leggi nell'AIP espanso» (i PDF nel modello, una cartella per ciclo). «Confronta i CTR» (slice 1b) legge e
    basta; il sector cambia solo coi tasti di una riga del confronto, «Sostituisci» e «Porta nel sector» (slice 1c), che
    sono gesti come gli altri: modifiche in sospeso, nel diff, da annullare, salvate solo da «Salva».
*@
<section class="lab-riquadro lab-ramo-riquadro" data-riquadro-aip>
    <h2 class="lab-riquadro-titolo" title="I PDF dell'AIP e l'AIP espanso" data-aip>
        AIP <span class="lab-nota" data-quanti-pdf>@Riassunto()</span>
    </h2>
    <div class="lab-impostazioni-riquadro">
        @* La cartella dei PDF serve solo a leggerli: prendere l'AIP espanso, guardarlo sulla mappa e confrontarlo col sector
           si fa anche senza (committente, 19 ottobre: col riquadro chiuso dietro questo avviso non vedeva niente). *@
        @if (Lab.CartellaDeiPdf is not { } cartella)
        {
            <p class="lab-nota" data-senza-pdf>Manca la cartella dei PDF dell'AIP (sceglila nelle Impostazioni): serve solo a leggere i PDF.
                Per guardare l'AIP espanso sulla mappa e confrontarlo col sector basta la sua cartella, qui sotto.</p>
        }
        else
        {
            <p class="lab-nota">PDF: <code>@cartella</code> — @_pdf.Count file dell'AIP.</p>
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prendi-da-download"
                    title="Sposta i PDF dell'AIP (LI-ENR …, LI-AD 2 …) da @Lab.Download in questa cartella" @onclick="Prendi">Prendi i PDF da Download</button>
            @if (Lab.UltimaPresaDaDownload is { } presa)
            {
                <p class="lab-nota" data-presa>@(presa.Quanti == 0
                    ? "In Download non c'erano PDF dell'AIP."
                    : $"Presi {presa.Quanti}: {presa.Nuovi.Count} nuovi, {presa.Sostituiti.Count} al posto di quelli col loro nome.")</p>
            }
        }

            @if (Lab.CartellaDellAipEspanso is null || Lab.StatoDellAip is null)
            {
                <p class="lab-nota" data-prendi-espanso>Il repo dell'AIP espanso non è ancora su questo PC:
                    prendilo in una cartella nuova (o vuota), e diventa la cartella dell'AIP espanso.</p>
                <label class="lab-nota">
                    Dal repo (il link di GitHub, anche copiato dal browser)
                    <input class="lab-campo" value="@Lab.IndirizzoDellAipEspanso" data-campo="indirizzo-aip-espanso" disabled="@Lab.StaLavorandoSulRepoDellAip"
                           @onchange="e => Lab.CambiaLIndirizzoDellAipEspanso(e.Value?.ToString())" />
                </label>
                <label class="lab-nota">
                    Dove
                    <input class="lab-campo" value="@_dove" data-campo="dove-aip-espanso" placeholder="D:\IVAO\aip-espanso"
                           @onchange="e => _dove = e.Value?.ToString()" />
                </label>
                @if (Lab.ScegliCartella is not null)
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-dove-aip" @onclick="SfogliaDove">Sfoglia…</button>
                }
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prendi-aip-espanso" disabled="@Lab.StaLavorandoSulRepoDellAip"
                        title="Clona il repo dell'AIP espanso in quella cartella" @onclick="PrendiLEspanso">Prendi l'AIP espanso</button>
            }
            @if (Lab.CartellaDellAipEspanso is not { } espanso)
            {
                <p class="lab-nota" data-senza-espanso>Manca la cartella dell'AIP espanso: prendi il repo qui sopra, o sceglila nelle Impostazioni.</p>
            }
            else
            {
                <p class="lab-nota">AIP espanso: <code>@espanso</code></p>
                @if (Lab.StatoDellAip is { } repo)
                {
                    <p class="lab-nota" data-stato-aip>Repo: <code>@(Vipi.SectorLab.Core.Git.Invio.RepoGitHub(repo.Remoto) ?? repo.Remoto)</code> · ramo
                        <code>@(repo.Ramo ?? "staccato")</code> · @repo.InParole()</p>
                }
                <label class="lab-nota">
                    Ciclo
                    <input class="lab-campo lab-campo-corto" value="@_ciclo" data-campo="ciclo" maxlength="4" inputmode="numeric"
                           @onchange="e => _ciclo = e.Value?.ToString()" />
                </label>
                <button type="button" class="lab-tasto" data-tasto="leggi-aip" disabled="@(Lab.StaLeggendoLAip || _pdf.Count == 0 || Lab.CartellaDeiPdf is null)"
                        title="Legge i PDF della cartella e scrive il modello nella cartella del ciclo" @onclick="Leggi">
                    @(Lab.StaLeggendoLAip ? "Sto leggendo…" : "Leggi nell'AIP espanso")
                </button>
            }

            @if (Lab.UltimoAipEspanso is { } esito)
            {
                <div data-esito-aip>
                    <p class="lab-nota">Ciclo @esito.Ciclo: <strong>@esito.Quanti()</strong> da @esito.Letti.Count PDF letti su @esito.Pdf
                        (@esito.NonAncora.Count non ancora: le loro sezioni vengono con le prossime slice) → <code>@esito.Scritto</code></p>
                    @if (esito.CorrezioniInParole() is { } correzioni)
                    {
                        <p class="lab-nota" data-correzioni-aip>Correzioni: @correzioni</p>
                    }
                    @if (esito.Date.Count > 0)
                    {
                        <p class="lab-nota" data-date-aip>Date delle pagine: @string.Join(", ", esito.Date.Select(d => $"{Data(d.Data)} ×{d.Pagine}"))</p>
                    }
                    @foreach (var i in esito.Illeggibili)
                    {
                        <p class="lab-avviso-breve" data-illeggibile>Non si apre: @i</p>
                    }
                    @if (esito.Problemi.Count > 0)
                    {
                        <details data-problemi-aip>
                            <summary class="lab-nota">@esito.Problemi.Count segnalazioni: @string.Join(" · ", esito.Problemi.GroupBy(p => p.Problema.Kind).Select(g => $"{Tipo(g.Key)} {g.Count()}"))</summary>
                            <ul class="lab-elenco-lotto">
                                @foreach (var p in esito.Problemi.Take(200))
                                {
                                    <li class="lab-nota" data-problema-aip="@p.Problema.Kind">
                                        <code>@p.File</code>@(p.Problema.Page is { } n ? $" p.{n}" : "") — @Tipo(p.Problema.Kind)@(p.Problema.Key is { } k ? $" · {k}" : "")@(p.Problema.Detail is { } d ? $": {d}" : "")
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            }
            @if (Lab.StatoDellAip is { } repo2 && repo2.Ramo?.StartsWith(Vipi.SectorLab.Core.PdfAip.RepoDellAip.PrefissoDelRamo, StringComparison.Ordinal) == true)
            {
                <div data-git-aip>
                    <label class="lab-nota">
                        Messaggio
                        <input class="lab-campo" value="@Lab.MessaggioDellAip" data-campo="messaggio-aip"
                               @onchange="e => Lab.MessaggioDellAip = e.Value?.ToString()" />
                    </label>
                    <button type="button" class="lab-tasto" data-tasto="registra-aip" disabled="@Lab.StaLavorandoSulRepoDellAip"
                            title="Registra il modello del ciclo sul ramo @repo2.Ramo" @onclick="Registra">Registra</button>
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="manda-aip" disabled="@Lab.StaLavorandoSulRepoDellAip"
                            title="Manda il ramo @repo2.Ramo al server e apre la pagina della PR: la fonde il committente" @onclick="Manda">Manda</button>
                    @if (Lab.PaginaDellaPrDellAip is { } pr)
                    {
                        @* Riordino R0: un link con target="_blank" la finestra del Lab lo rifiuta (accetta solo /pannelli): la pagina si riapre nel browser di Windows. *@
                        <p class="lab-nota" data-pr-aip>PR aperta nel browser — la conferma tu su GitHub, la fonde il committente.
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="riapri-pr-aip"
                                    title="@pr" @onclick="() => Lab.ApriNelBrowser(pr)">Riaprila</button></p>
                    }
                </div>
            }
        @if (Lab.CartellaDellAipEspanso is not null)
        {
            <div data-aip-sulla-mappa>
                <label class="lab-nota">
                    <input type="checkbox" data-casella="aip-sulla-mappa" checked="@Lab.Accesi.Contains(Vipi.SectorLab.Core.PdfAip.AipSullaMappa.Tipo.Id)"
                           disabled="@(Lab.Sessione is null)" @onchange="e => Mostra(e.Value is true)" />
                    Mostra l'AIP espanso sulla mappa
                </label>
                @if (Lab.StratoDellAip is { } strato)
                {
                    <span class="lab-nota" data-aip-strato> · ciclo @strato.Ciclo, @strato.Strato.Forme.Count forme@(Attese(strato) is var (nonDisegnate, tutte) && nonDisegnate > 0 ? $" ({nonDisegnate} attese su {tutte} senza il punto nel sector)" : ""): i tipi si accendono negli Strati</span>
                    @* Le correzioni (slice 2 e 3): una voce si corregge dalla sua scheda; una che il PDF non ha si aggiunge da qui. *@
                    @if (_aggiungi is Aip.CorrectionKind.Airspace)
                    {
                        <ModuloDellArea Chiuso="() => _aggiungi = null" />
                    }
                    else if (_aggiungi is { } tipo)
                    {
                        <ModuloDiUnaVoce Tipo="tipo" Chiuso="() => _aggiungi = null" />
                    }
                    else
                    {
                        <span class="lab-nota" data-aggiungi>
                            <select class="lab-campo" data-campo="aggiungi-tipo" value="@_tipoDaAggiungere"
                                    @onchange="e => _tipoDaAggiungere = Enum.TryParse<Aip.CorrectionKind>(e.Value?.ToString(), out var t) ? t : _tipoDaAggiungere">
                                @foreach (var t in Enum.GetValues<Aip.CorrectionKind>())
                                {
                                    <option value="@t">@Vipi.SectorLab.Core.PdfAip.CorrezioniDellAip.Nome(t)</option>
                                }
                            </select>
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="aggiungi-area"
                                    title="Una voce che il PDF non ha (AIP SUP, AIC…): va nell'AIP espanso del ciclo @strato.Ciclo, con la sua fonte" @onclick="() => _aggiungi = _tipoDaAggiungere">Aggiungi</button>
                        </span>
                    }
                }
            </div>
            <div data-confronto>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-ctr" disabled="@(Lab.Sessione is null)"
                        title="I CTR dell'AIP espanso contro le voci CTR dei MAPS del sector aperto (sola lettura, soglia 0,1 NM)" @onclick="() => Confronta(Famiglia.Ctr)">Confronta i CTR</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-atz" disabled="@(Lab.Sessione is null)"
                        title="Le ATZ di ENR 2 (le militari e le ATZ-RMZ) contro le voci ATZ dei MAPS degli .str (sola lettura)" @onclick="() => Confronta(Famiglia.Atz)">le ATZ negli .str</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-torri" disabled="@(Lab.Sessione is null)"
                        title="Le ATZ di ENR 2 contro i settori delle torri di DYNAMIC_SEC/twrs.tfl (sola lettura)" @onclick="() => Confronta(Famiglia.AtzDelleTorri)">le ATZ in twrs.tfl</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-aree-enr5" disabled="@(Lab.Sessione is null)"
                        title="Le aree di ENR 5 (P, R, D, TSA, TRA, militari) contro italy.prohibit, italy.restrict e italy.danger, per nome (sola lettura, soglia 0,1 NM)" @onclick="() => Confronta(Famiglia.AreeEnr5)">le aree di ENR 5</button>
                @if (Lab.UltimoConfronto is { } confronto)
                {
                    var atz = confronto.Famiglia is Famiglia.Atz or Famiglia.AtzDelleTorri;
                    var enr5 = confronto.Famiglia == Famiglia.AreeEnr5;
                    <p class="lab-nota" data-riassunto-confronto>@Cosa(confronto.Famiglia), ciclo @confronto.Ciclo: @string.Join(" · ", confronto.Esiti.GroupBy(e => e.Esito).Select(g => $"{Esito(g.Key)} {g.Count()}"))</p>
                    @if (atz && confronto.Esiti.Any(e => e.Esito == Esiti.SoloNelSector))
                    {
                        <p class="lab-nota" data-solo-nel-sector>Le voci «solo nel sector» non si elencano: le ATZ civili stanno in AD 2, che il Lab legge solo per gli scali di cui ci sono i PDF.</p>
                    }
                    @if (enr5 && confronto.Esiti.Where(e => e.Esito == Esiti.MancaNelSector).Select(e => e.Aip).OfType<string>().ToList() is { Count: > 1 } mancanti)
                    {
                        <button type="button" class="lab-tasto" data-tasto="porta-tutte-enr5"
                                title="Tutte le aree qui sotto che il sector non ha, in fondo al loro file (P in italy.prohibit, D in italy.danger, il resto in italy.restrict): un gesto solo, da annullare"
                                @onclick="() => PortaEnr5(mancanti)">Porta tutte (@mancanti.Count)</button>
                    }
                    <ul class="lab-elenco-lotto">
                        @foreach (var e in confronto.Esiti.Where(e => (e.Esito != Esiti.Uguale || (enr5 && e.Zone > 1)) && !(atz && e.Esito == Esiti.SoloNelSector)))
                        {
                            <li class="lab-nota" data-differenza="@e.Esito">
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@Esito(e.Esito)</button>
                                }
                                else
                                {
                                    <strong>@Esito(e.Esito)</strong>
                                }
                                @(e.Aip ?? "—") @(e.Zone > 1 ? $"({e.Zone} zone)" : "") ↔ @(e.Sector ?? "—")
                                @if (e.ScartoAip is { } a && e.ScartoSector is { } s)
                                {
                                    <span> · l'AIP si stacca dal sector fino a @a.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) NM, il sector dall'AIP fino a @s.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) NM</span>
                                }
                                @if (e.Dove is { } dove)
                                {
                                    <span> · il punto peggiore: @Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.Dms(dove)</span>
                                }
                                @if (e.SenzaTracciato)
                                {
                                    <span> · lungo un confine o una costa che l'AIP non disegna: lì non si giudica</span>
                                }
                                @if (Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.DaGuardare(e))
                                {
                                    <span class="lab-avviso-breve" data-da-guardare> · più di @Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.ScartoDaGuardare.ToString("0", System.Globalization.CultureInfo.InvariantCulture) NM: quasi certo un errore di stampa (dell'AIP o del sector). Guarda il PDF, si corregge a mano.</span>
                                }
                                else if (e.Esito == Esiti.FormaDiversa && confronto.Famiglia == Famiglia.AtzDelleTorri && e.Zone > 1)
                                {
                                    <span data-piu-zone> · @e.Zone zone nell'AIP: un settore della torre è un poligono solo, si sistema a mano.</span>
                                }
                                else if (enr5 && (e.Esito == Esiti.FormaDiversa || (e.Esito == Esiti.Uguale && e.Zone > 1)) && e.File is not null)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-enr5"
                                            title="@(e.Zone > 1 ? $"Divide {e.Sector} in {e.Zone} voci, una per area dell'AIP, con le forme dell'AIP" : $"Riscrive le righe di {e.Sector} con la forma dell'AIP")"
                                            @onclick="() => SostituisciEnr5(e)">@(e.Zone > 1 ? "Dividi" : "Sostituisci")</button>
                                }
                                else if (enr5 && e.Esito == Esiti.MancaNelSector && e.Aip is { } chiave)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-enr5"
                                            title="Il blocco dell'area in fondo al suo file, coi lati dell'AIP" @onclick="() => PortaEnr5([chiave])">Porta nel sector</button>
                                }
                                else if (enr5)
                                {
                                }
                                else if (e.Esito == Esiti.FormaDiversa && e.File is not null)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci"
                                            title="Riscrive tutta la voce @e.Sector con le zone dell'AIP @confronto.Ciclo (la testata resta): una modifica in sospeso, nel diff e da annullare come le altre"
                                            @onclick="() => Sostituisci(e)">Sostituisci</button>
                                }
                                else if (e.Esito == Esiti.MancaNelSector && e.Aip is { } nome && confronto.Famiglia != Famiglia.AtzDelleTorri)
                                {
                                    <input class="lab-campo lab-campo-corto" maxlength="4" placeholder="LIxx" data-campo="scalo" value="@_scali.GetValueOrDefault(nome)"
                                           title="Lo scalo: la voce va nel suo .str" @onchange="v => _scali[nome] = v.Value?.ToString()" />
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta"
                                            title="Scrive la voce nuova del MAPS nello .str dello scalo: una modifica in sospeso, nel diff e da annullare come le altre"
                                            @onclick="() => Porta(e, nome)">Porta nel sector</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (Lab.CartellaDellAipEspanso is not null)
        {
            @* Slice 2b: ENR 3 — le rotte con itawlow.lairway, le attese con HOLDENR.hold. In sola lettura. *@
            <div data-confronto-enr3>
                @* F7, slice 7d: le procedure di AD 2 contro i .sid e gli .str, per nome e per percorso. Sola lettura. *@
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-procedure" disabled="@(Lab.Sessione is null)"
                        title="Le SID, le STAR e le transizioni di AD 2 dell'AIP espanso contro i .sid e gli .str degli scali: nome, piste, punti in fila (STAR), punto finale (SID), posizioni dei punti (sola lettura)"
                        @onclick="ConfrontaLeProcedure">Confronta SID e STAR</button>
                @if (Lab.UltimoConfrontoDelleProcedure is { } proc)
                {
                    <p class="lab-nota" data-riassunto-procedure>SID e STAR, ciclo @proc.Ciclo: @string.Join(" · ", proc.Esiti.GroupBy(e => e.Esito).Select(g => $"{Esito(g.Key)} {g.Count()}"))
                        — le SID del sector non hanno tracciato: si confrontano nome, piste e punto finale.</p>
                    @if (Lab.TracciatiDaScrivere is var senza and > 0)
                    {
                        <button type="button" class="lab-tasto" data-tasto="scrivi-tracciati"
                                title="Le SID uguali all'AIP per nome, piste e punto finale, che nel sector non hanno tracciato: il tracciato dell'AIP coi tag di quota e velocità (D2, D3), un gesto solo"
                                @onclick="ScriviITracciati">Scrivi i tracciati delle SID uguali (@senza voci)</button>
                    }
                    @foreach (var (scalo, _, quante) in Lab.ScaliPerLaMappaDelleSid())
                    {
                        <button type="button" class="lab-tasto" data-tasto="mappa-delle-sid"
                                title="In testa al .sid una voce MAPS che disegna insieme le SID col tracciato (P10): una mappa composta, che il Lab rigenera quando una SID cambia"
                                @onclick="() => CreaLaMappaDelleSid(scalo)">Mappa delle SID di @scalo (@quante)</button>
                    }
                    <ul class="lab-elenco-lotto" data-elenco-procedure>
                        @foreach (var e in proc.Esiti.Where(e => e.Esito != Esiti.Uguale))
                        {
                            <li class="lab-nota" data-procedura="@e.Esito">
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@Esito(e.Esito)</button>
                                }
                                else
                                {
                                    <strong>@Esito(e.Esito)</strong>
                                }
                                <span>&nbsp;@e.Scalo @Genere(e.Genere)</span> <strong>@e.Nome</strong>@(e.Piste.Count > 0 ? $" RWY {string.Join("/", e.Piste)}" : "")@(e.Nomi.Count > 0 && e.Esito != Esiti.SoloNelSector ? $" ({string.Join(", ", e.Nomi)})" : "")
                                @* Slice 7e: i gesti. Una procedura che manca si porta (coi punti che mancano); una diversa si sostituisce. *@
                                @if (e.Esito == Esiti.MancaNelSector)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-procedura"
                                            title="Una voce nuova nello .str o nel .sid dello scalo, coi punti e le quote dell'AIP; i punti che il sector non ha, prima in APT.fix"
                                            @onclick="() => PortaLaProcedura(e)">Porta nel sector</button>
                                }
                                else if (e.Esito == Esiti.FormaDiversa && e.File is not null)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-procedura"
                                            title="Le voci del sector di questa procedura riscritte coi punti, le quote e le velocità dell'AIP (la testata resta)"
                                            @onclick="() => SostituisciLaProcedura(e)">Sostituisci</button>
                                }
                                @foreach (var d in e.Dettagli)
                                {
                                    <br /><span>· @d</span>
                                }
                            </li>
                        }
                    </ul>
                }
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-rotte" disabled="@(Lab.Sessione is null)"
                        title="Le rotte di ENR 3.2 dell'AIP espanso contro le aerovie di itawlow.lairway: i lati, i tratti (verso e quote), le posizioni dei punti (sola lettura)"
                        @onclick="() => ConfrontaEnr3(true)">Confronta le rotte</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-attese" disabled="@(Lab.Sessione is null)"
                        title="Le attese di ENR 3.4.1 contro HOLDENR.hold: rotta d'avvicinamento, virata, quota (sola lettura)"
                        @onclick="() => ConfrontaEnr3(false)">le attese</button>
                @if (Lab.UltimoConfrontoDiEnr3 is { } enr3)
                {
                    <p class="lab-nota" data-riassunto-enr3>@(enr3.Rotte ? "Rotte" : "Attese"), ciclo @enr3.Ciclo: @string.Join(" · ", enr3.Esiti.GroupBy(e => e.Esito).Select(g => $"{Esito(g.Key)} {g.Count()}"))</p>
                    @* Slice 2c: i gesti. Rotte: i tratti nei tag //@@ (una o tutte), e le rotte che il sector non ha. Attese: quelle
                       scelte, di procedura (nello .str dello scalo) o in rotta (HOLDENR.hold), con la scritta o l'ovale. *@
                    @if (enr3.Rotte && enr3.Esiti.Where(e => e.TrattiDaScrivere > 0).ToList() is { Count: > 0 } conTratti)
                    {
                        <button type="button" class="lab-tasto" data-tasto="scrivi-tutti-i-tratti"
                                title="Verso e quote dell'AIP nei tag //@@ dei tratti di tutte le rotte qui sotto (le locked=si no): un gesto solo, da annullare"
                                @onclick="() => ScriviITratti(conTratti.Select(e => e.Nome).ToList())">Scrivi i tratti di tutte (@conTratti.Sum(e => e.TrattiDaScrivere) su @conTratti.Count rotte)</button>
                    }
                    @if (!enr3.Rotte && enr3.Esiti.Any(e => e.Esito == Esiti.MancaNelSector))
                    {
                        <button type="button" class="lab-tasto" data-tasto="porta-attese" disabled="@(Scelte(enr3).Count == 0)"
                                title="Le attese spuntate nel sector: di procedura come HLD- nello .str dello scalo, in rotta in HOLDENR.hold"
                                @onclick="() => PortaLeAttese(enr3)">Porta le selezionate (@Scelte(enr3).Count)</button>
                    }
                    <ul class="lab-elenco-lotto">
                        @foreach (var e in enr3.Esiti.Where(e => e.Esito != Esiti.Uguale || e.TrattiDaScrivere > 0))
                        {
                            <li class="lab-nota" data-enr3="@e.Esito">
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@Esito(e.Esito)</button>
                                }
                                else
                                {
                                    <strong>@Esito(e.Esito)</strong>
                                }
                                @e.Nome
                                @if (enr3.Rotte && e.TrattiDaScrivere > 0)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="scrivi-i-tratti"
                                            title="Verso e quote dell'AIP nei tag //@@ dei tratti di @e.Nome" @onclick="() => ScriviITratti([e.Nome])">Scrivi i tratti (@e.TrattiDaScrivere)</button>
                                }
                                else if (enr3.Rotte && e.Esito == Esiti.MancaNelSector)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-rotta"
                                            title="Il blocco della rotta in itawlow.lairway coi punti, i tratti e le etichette dell'AIP" @onclick="() => PortaLaRotta(e.Nome)">Porta nel sector</button>
                                }
                                else if (!enr3.Rotte && e.Esito == Esiti.FormaDiversa)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-attesa"
                                            title="Riscrive la descrizione in HOLDENR.hold con l'attesa dell'AIP" @onclick="() => SostituisciLAttesa(e)">Sostituisci</button>
                                }
                                else if (!enr3.Rotte && e.Esito == Esiti.MancaNelSector && Lab.ProposteDelleAttese.GetValueOrDefault(e.Nome) is { } proposta)
                                {
                                    var fix = e.Nome;
                                    var stato = Stato(proposta);
                                    <span class="lab-scelta-attesa" data-attesa="@fix">
                                        <input type="checkbox" data-casella="scegli-attesa" checked="@stato.Scelta" disabled="@(proposta.Punto is null)"
                                               title="@(proposta.Punto is null ? "Il sector non ha il punto: non si porta" : "Da portare")"
                                               @onchange="v => Cambia(proposta, scelta: v.Value is true)" />
                                        <select class="lab-campo lab-campo-corto" data-campo="dove-attesa" value="@(stato.Scalo ?? "")"
                                                @onchange="v => CambiaLoScalo(proposta, v)">
                                            <option value="">in rotta</option>
                                            @foreach (var scalo in proposta.Scali)
                                            {
                                                <option value="@scalo.Icao">@scalo.Icao (@scalo.Piste)</option>
                                            }
                                        </select>
                                        <select class="lab-campo lab-campo-corto" data-campo="come-attesa" value="@(stato.Ovale ? "ovale" : "scritta")"
                                                @onchange="v => CambiaIlCome(proposta, v)">
                                            <option value="scritta">scritta</option>
                                            <option value="ovale" disabled="@(Stato(proposta).Scalo is null)">ovale (@proposta.Tratto)</option>
                                        </select>
                                    </span>
                                }
                                @foreach (var d in e.Dettagli)
                                {
                                    <span class="lab-nota" data-dettaglio-enr3>@d</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            @* Slice 3b: ENR 4 — le radioassistenze coi .vor e i .ndb, i punti coi .fix. In sola lettura. *@
            <div data-confronto-enr4>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-radioassistenze" disabled="@(Lab.Sessione is null)"
                        title="Le radioassistenze di ENR 4.1 dell'AIP espanso contro i .vor e i .ndb: posizione (0,1 NM), frequenza, canale TACAN (sola lettura)"
                        @onclick="() => ConfrontaEnr4(true)">Confronta le radioassistenze</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-punti" disabled="@(Lab.Sessione is null)"
                        title="I punti di ENR 4.4 contro i .fix: posizione (0,1 NM); in itfix.fix anche l'uso e il FRA (sola lettura)"
                        @onclick="() => ConfrontaEnr4(false)">i punti</button>
                @if (Lab.UltimoConfrontoDiEnr4 is { } enr4)
                {
                    <p class="lab-nota" data-riassunto-enr4>@(enr4.Radioassistenze ? "Radioassistenze" : "Punti"), ciclo @enr4.Ciclo: @string.Join(" · ", enr4.Esiti.GroupBy(e => e.Esito).Select(g => $"{Esito(g.Key)} {g.Count()}"))@(enr4.Esiti.Count(e => e.UsoDiverso) is > 0 and var uso ? $" · uso diverso {uso}" : "")</p>
                    @* Slice 3c: i gesti. «Porta tutte» le mancanti (scelto con l'elenco davanti), o una per riga; «Sostituisci»
                       sulle radioassistenze diverse; «Correggi l'uso» (4° e 5° campo di itfix.fix, confermati dal committente). *@
                    @if (enr4.Esiti.Where(e => e.UsoDiverso).Select(e => e.Nome).ToList() is { Count: > 1 } usi)
                    {
                        <button type="button" class="lab-tasto" data-tasto="correggi-tutti-gli-usi"
                                title="L'uso (4° campo) e il FRA (5°) dell'AIP nelle righe di itfix.fix qui sotto: un gesto solo, da annullare"
                                @onclick="() => CorreggiLUso(usi)">Correggi l'uso di tutti (@usi.Count)</button>
                    }
                    @if (enr4.Esiti.Where(e => e.Esito == Esiti.MancaNelSector).Select(e => e.Nome).ToList() is { Count: > 1 } tutte)
                    {
                        <button type="button" class="lab-tasto" data-tasto="porta-tutte-enr4"
                                title="Tutte quelle qui sotto che il sector non ha, in ordine di nome nel loro file: un gesto solo, da annullare"
                                @onclick="() => PortaEnr4(tutte)">Porta tutte (@tutte.Count)</button>
                    }
                    <ul class="lab-elenco-lotto">
                        @foreach (var e in enr4.Esiti.Where(e => e.Esito != Esiti.Uguale || e.UsoDiverso))
                        {
                            <li class="lab-nota" data-enr4="@(e.UsoDiverso ? "UsoDiverso" : e.Esito.ToString())">
                                @{ var etichetta = e.UsoDiverso ? "uso diverso" : Esito(e.Esito); }
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@etichetta</button>
                                }
                                else
                                {
                                    <strong>@etichetta</strong>
                                }
                                @e.Nome
                                @if (e.Esito == Esiti.MancaNelSector)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-enr4"
                                            title="La riga nuova in @(enr4.Radioassistenze ? "itvor.vor o itndb.ndb" : "itfix.fix"), in ordine di nome, coi valori dell'AIP" @onclick="() => PortaEnr4([e.Nome])">Porta nel sector</button>
                                }
                                else if (e.UsoDiverso)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="correggi-uso"
                                            title="L'uso (4° campo) e il FRA (5°) di itfix.fix come li dà l'AIP" @onclick="() => CorreggiLUso([e.Nome])">Correggi l'uso</button>
                                }
                                else if (enr4.Radioassistenze && e.Esito == Esiti.FormaDiversa)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-enr4"
                                            title="Riscrive la riga del sector coi valori dell'AIP che sono diversi (frequenza, posizione, canale); il resto resta" @onclick="() => SostituisciEnr4(e)">Sostituisci</button>
                                }
                                @foreach (var d in e.Dettagli)
                                {
                                    <span class="lab-nota" data-dettaglio-enr4>@d</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
            @* Slice 5b: AD 2 — gli scali coi .ap, le piste coi .rw, le frequenze coi .frq, per gli scali di cui ci sono i PDF.
               Slice 5c: «Sostituisci» su scali e piste diversi, «Porta nel sector» per una pista che manca; le frequenze no. *@
            <div data-confronto-ad2>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-scali" disabled="@(Lab.Sessione is null)"
                        title="AD 2.2 e 2.17 dell'AIP espanso contro i .ap: punto di riferimento (0,1 NM), elevazione, altitudine di transizione (sola lettura)"
                        @onclick="() => ConfrontaAd2(Ad2.Scali)">Confronta gli scali</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-piste" disabled="@(Lab.Sessione is null)"
                        title="AD 2.12 contro i .rw: soglie (@Vipi.SectorLab.Core.PdfAip.ConfrontoDiAd2.SogliaDellaSogliaM.ToString("0") m), elevazioni, rotte magnetiche = vera − declinazione (sola lettura)"
                        @onclick="() => ConfrontaAd2(Ad2.Piste)">le piste</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-frequenze" disabled="@(Lab.Sessione is null)"
                        title="AD 2.18 contro le posizioni dei .frq dello scalo; emergenza e ATIS il sector non le tiene nei .frq (sola lettura)"
                        @onclick="() => ConfrontaAd2(Ad2.Frequenze)">le frequenze</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-radioassistenze-ad2" disabled="@(Lab.Sessione is null)"
                        title="AD 2.19 contro i .vor e i .ndb, come ENR 4.1: posizione (0,1 NM), frequenza, canale; e dove ENR 4.1 la stampa diversa (sola lettura)"
                        @onclick="() => ConfrontaAd2(Ad2.Radioassistenze)">le radioassistenze</button>
                @if (Lab.UltimoConfrontoDiAd2 is { } ad2)
                {
                    <p class="lab-nota" data-riassunto-ad2>@(ad2.Parte switch { Ad2.Scali => "Scali", Ad2.Piste => "Piste", Ad2.Radioassistenze => "Radioassistenze di AD 2.19", _ => "Frequenze" }), ciclo @ad2.Ciclo, @ad2.Esiti.Select(e => e.Scalo).Distinct().Count() scali: @string.Join(" · ", ad2.Esiti.GroupBy(e => e.Esito).Select(g => $"{EsitoAd2(g.Key)} {g.Count()}"))@(ad2.Esiti.Count(e => e.DiversaInEnr41) is > 0 and var discordi ? $" · diverse in ENR 4.1 {discordi}" : "")</p>
                    <p class="lab-nota">Una voce che sta in più file (OTHER/it… e le FIR) è una riga per file.@(ad2.Parte switch { Ad2.Frequenze => " Le frequenze sono in sola lettura.", Ad2.Radioassistenze => $" Le voci del sector che AD 2.19 non ha non si elencano. Gli ILS ({Lab.IlsDellAipDiAd2}) il sector non li tiene: non c'è una sezione per loro.", _ => "" })</p>
                    <ul class="lab-elenco-lotto">
                        @foreach (var e in ad2.Esiti.Where(e => e.Esito != Esiti.Uguale || e.DiversaInEnr41))
                        {
                            <li class="lab-nota" data-ad2="@e.Esito">
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@EsitoAd2(e.Esito)</button>
                                }
                                else
                                {
                                    <strong>@EsitoAd2(e.Esito)</strong>
                                }
                                @e.Nome
                                @if (ad2.Parte is Ad2.Scali or Ad2.Piste && e.Esito == Esiti.FormaDiversa)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-ad2"
                                            title="Riscrive questa riga del sector coi valori dell'AIP che sono diversi; il resto resta. Le altre righe (le FIR) una per una" @onclick="() => SostituisciAd2(e)">Sostituisci</button>
                                }
                                else if (ad2.Parte == Ad2.Radioassistenze && e.Esito == Esiti.FormaDiversa)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-radioassistenza-ad2"
                                            title="Riscrive la riga del sector coi valori di AD 2.19 che sono diversi (frequenza, posizione, canale); il resto resta" @onclick="() => SostituisciRadioassistenzaAd2(e)">Sostituisci</button>
                                }
                                else if (ad2.Parte == Ad2.Radioassistenze && e.Esito == Esiti.MancaNelSector)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-radioassistenza-ad2"
                                            title="La riga nuova in itvor.vor o itndb.ndb, in ordine di nome, coi valori di AD 2.19" @onclick="() => PortaRadioassistenzeAd2([e.Nome])">Porta nel sector</button>
                                }
                                else if (ad2.Parte == Ad2.Piste && e.Esito == Esiti.MancaNelSector)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-pista"
                                            title="La riga nuova in itrw.rw, nella sezione delle piste, con le due testate dell'AIP" @onclick="() => PortaLaPista(e)">Porta nel sector</button>
                                }
                                @foreach (var d in e.Dettagli)
                                {
                                    <span class="lab-nota" data-dettaglio-ad2>@d</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (_rifiuto is not null)
        {
            <p class="lab-avviso-breve" data-rifiuto-aip>@_rifiuto</p>
        }
    </div>
</section>

@code {
    private string? _rifiuto;
    private string? _ciclo;
    private string? _dove;
    private IReadOnlyList<string> _pdf = [];

    protected override async Task OnInitializedAsync()
    {
        Lab.Cambiata += Aggiorna;
        _ciclo = Lab.CicloDiOggi;
        _pdf = Lab.PdfDellAip;
        await Lab.RileggiIlRepoDellAipAsync();
    }

    private async Task SfogliaDove()
    {
        if (await Lab.ScegliCartella!("Dove mettere l'AIP espanso (nuova o vuota)", _dove) is { } scelta)
            _dove = scelta;
    }

    private async Task PrendiLEspanso() => _rifiuto = await Lab.PrendiLAipEspansoAsync(_dove) ? null : Lab.Rifiuto;

    private Aip.CorrectionKind? _aggiungi;

    private Aip.CorrectionKind _tipoDaAggiungere = Aip.CorrectionKind.Airspace;

    // Riuscito o no, il Lab può avere qualcosa da dire (le voci saltate da «Sostituisci»).
    private void PortaLaProcedura(Vipi.SectorLab.Core.PdfAip.DifferenzaDiProcedura riga)
    {
        Lab.PortaLaProcedura(riga);
        _rifiuto = Lab.Rifiuto;
    }

    private void CreaLaMappaDelleSid(string scalo)
    {
        Lab.CreaLaMappaDelleSid(scalo);
        _rifiuto = Lab.Rifiuto;
    }

    private void ScriviITracciati()
    {
        Lab.ScriviITracciatiDelleSid();
        _rifiuto = Lab.Rifiuto;
    }

    private void SostituisciLaProcedura(Vipi.SectorLab.Core.PdfAip.DifferenzaDiProcedura riga)
    {
        Lab.SostituisciLaProcedura(riga);
        _rifiuto = Lab.Rifiuto;
    }

    private async Task ConfrontaLeProcedure() => _rifiuto = await Lab.ConfrontaLeProcedureAsync() ? null : Lab.Rifiuto;

    private static string Genere(Aip.ProcedureKind genere) => genere switch
    {
        Aip.ProcedureKind.Sid => "SID",
        Aip.ProcedureKind.Star => "STAR",
        Aip.ProcedureKind.Transition => "transizione",
        _ => "salita iniziale",
    };

    private async Task Registra() => _rifiuto = await Lab.RegistraLAipAsync(Lab.MessaggioDellAip) ? null : Lab.Rifiuto;

    private async Task Manda() => _rifiuto = await Lab.MandaLAipAsync() ? null : Lab.Rifiuto;

    private async Task ConfrontaAd2(Ad2 parte) => _rifiuto = await Lab.ConfrontaAd2Async(parte) ? null : Lab.Rifiuto;

    private void SostituisciAd2(Vipi.SectorLab.Core.PdfAip.DifferenzaDiAd2 riga) => _rifiuto = Lab.SostituisciInAd2(riga) ? null : Lab.Rifiuto;

    private void PortaLaPista(Vipi.SectorLab.Core.PdfAip.DifferenzaDiAd2 riga) => _rifiuto = Lab.PortaLaPista(riga) ? null : Lab.Rifiuto;

    private void SostituisciRadioassistenzaAd2(Vipi.SectorLab.Core.PdfAip.DifferenzaDiAd2 riga) => _rifiuto = Lab.SostituisciLaRadioassistenzaDiAd2(riga) ? null : Lab.Rifiuto;

    private void PortaRadioassistenzeAd2(IReadOnlyList<string> nomi) => _rifiuto = Lab.PortaLeRadioassistenzeDiAd2(nomi) ? null : Lab.Rifiuto;

    /// <summary>Come <see cref="Esito"/>, ma scali, piste e frequenze non hanno una forma: «diversi».</summary>
    private static string EsitoAd2(Esiti e) => e == Esiti.FormaDiversa ? "diversi" : Esito(e);

    private async Task ConfrontaEnr4(bool radioassistenze) => _rifiuto = await Lab.ConfrontaEnr4Async(radioassistenze) ? null : Lab.Rifiuto;

    // Portare può riuscire per alcune righe e dire perché non per altre: il Rifiuto resta da leggere in tutti e due i casi.
    private void PortaEnr4(IReadOnlyList<string> nomi)
    {
        Lab.PortaNelSectorDiEnr4(nomi);
        _rifiuto = Lab.Rifiuto;
    }

    private void CorreggiLUso(IReadOnlyList<string> nomi) => _rifiuto = Lab.CorreggiLUso(nomi) ? null : Lab.Rifiuto;

    private void SostituisciEnr4(Vipi.SectorLab.Core.PdfAip.DifferenzaDiEnr4 riga) => _rifiuto = Lab.SostituisciLaRadioassistenza(riga) ? null : Lab.Rifiuto;

    private async Task ConfrontaEnr3(bool rotte)
    {
        _attese.Clear();
        _rifiuto = await Lab.ConfrontaEnr3Async(rotte) ? null : Lab.Rifiuto;
    }

    /// <summary>Le scelte dell'AOD sulle attese da portare, per punto (di base: non scelta, lo scalo proposto, la scritta).</summary>
    private readonly Dictionary<string, SceltaInCorso> _attese = new(StringComparer.OrdinalIgnoreCase);

    private sealed record SceltaInCorso(bool Scelta, string? Scalo, bool Ovale);

    private SceltaInCorso Stato(Vipi.SectorLab.Core.PdfAip.PropostaDiAttesa proposta) =>
        _attese.GetValueOrDefault(proposta.Attesa.Fix) ?? new SceltaInCorso(false, proposta.Scali.FirstOrDefault()?.Icao, false);

    private List<SessioneDelLab.SceltaDiAttesa> Scelte((string Ciclo, bool Rotte, IReadOnlyList<Vipi.SectorLab.Core.PdfAip.DifferenzaDiEnr3> Esiti) enr3) =>
        [.. enr3.Esiti.Where(e => e.Esito == Esiti.MancaNelSector)
            .Select(e => (e.Nome, Stato: _attese.GetValueOrDefault(e.Nome)))
            .Where(x => x.Stato is { Scelta: true })
            .Select(x => new SessioneDelLab.SceltaDiAttesa(x.Nome, x.Stato!.Scalo, x.Stato.Ovale && x.Stato.Scalo is not null))];

    /// <summary>Una riga spuntata o no.</summary>
    private void Cambia(Vipi.SectorLab.Core.PdfAip.PropostaDiAttesa proposta, bool scelta) =>
        _attese[proposta.Attesa.Fix] = Stato(proposta) with { Scelta = scelta };

    /// <summary>Lo scalo scelto (vuoto = in rotta: allora niente ovale, per ora).</summary>
    private void CambiaLoScalo(Vipi.SectorLab.Core.PdfAip.PropostaDiAttesa proposta, ChangeEventArgs v)
    {
        var scalo = v.Value?.ToString() is { Length: > 0 } x ? x : null;
        _attese[proposta.Attesa.Fix] = Stato(proposta) with { Scalo = scalo, Ovale = scalo is not null && Stato(proposta).Ovale };
    }

    /// <summary>La scritta o l'ovale.</summary>
    private void CambiaIlCome(Vipi.SectorLab.Core.PdfAip.PropostaDiAttesa proposta, ChangeEventArgs v) =>
        _attese[proposta.Attesa.Fix] = Stato(proposta) with { Ovale = string.Equals(v.Value?.ToString(), "ovale", StringComparison.Ordinal) };

    private void ScriviITratti(List<string> rotte) => _rifiuto = Lab.ScriviITratti(rotte) ? null : Lab.Rifiuto;

    private void PortaLaRotta(string nome) => _rifiuto = Lab.PortaLaRotta(nome) ? null : Lab.Rifiuto;

    private void SostituisciLAttesa(Vipi.SectorLab.Core.PdfAip.DifferenzaDiEnr3 e) => _rifiuto = Lab.SostituisciLAttesa(e) ? null : Lab.Rifiuto;

    private void PortaLeAttese((string Ciclo, bool Rotte, IReadOnlyList<Vipi.SectorLab.Core.PdfAip.DifferenzaDiEnr3> Esiti) enr3)
    {
        var scelte = Scelte(enr3);
        _rifiuto = Lab.PortaLeAttese(scelte) ? Lab.Rifiuto : Lab.Rifiuto;
        if (Lab.Modifiche.CEQualcosa)
            foreach (var s in scelte) _attese.Remove(s.Fix);
    }

    private async Task Mostra(bool mostra) => _rifiuto = await Lab.MostraLAipAsync(mostra) ? null : Lab.Rifiuto;

    private static (int NonDisegnate, int Tutte) Attese(Vipi.SectorLab.Core.PdfAip.StratoDellAip strato)
    {
        var attese = strato.Strato.Forme.Where(f => f.Genere == Vipi.SectorLab.Core.PdfAip.AipSullaMappa.Attese).ToList();
        return (attese.Count(f => f.Tratti.Count == 0), attese.Count);
    }

    private async Task Confronta(Famiglia famiglia) => _rifiuto = await Lab.ConfrontaAsync(famiglia) ? null : Lab.Rifiuto;

    private void SostituisciEnr5(Vipi.SectorLab.Core.PdfAip.DifferenzaDiForma riga) => _rifiuto = Lab.SostituisciAreaEnr5(riga) ? null : Lab.Rifiuto;

    // Portare può riuscire per alcune aree e dire perché non per altre: il Rifiuto resta da leggere.
    private void PortaEnr5(IReadOnlyList<string> chiavi)
    {
        Lab.PortaAreeEnr5(chiavi);
        _rifiuto = Lab.Rifiuto;
    }

    private static string Cosa(Famiglia f) => f switch
    {
        Famiglia.Ctr => "CTR",
        Famiglia.Atz => "ATZ negli .str",
        Famiglia.AreeEnr5 => "Aree di ENR 5",
        _ => "ATZ in twrs.tfl",
    };

    private readonly Dictionary<string, string?> _scali = new(StringComparer.OrdinalIgnoreCase);

    private void Sostituisci(Vipi.SectorLab.Core.PdfAip.DifferenzaDiForma e) => _rifiuto = Lab.SostituisciLaVoce(e) ? null : Lab.Rifiuto;

    private void Porta(Vipi.SectorLab.Core.PdfAip.DifferenzaDiForma e, string ctr) => _rifiuto = Lab.PortaNelSector(e, _scali.GetValueOrDefault(ctr)) ? null : Lab.Rifiuto;

    private static string Esito(Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto e) => e switch
    {
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.Uguale => "uguali",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.FormaDiversa => "forma diversa",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.MancaNelSector => "manca nel sector",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.SoloNelSector => "solo nel sector",
        _ => e.ToString(),
    };

    private void Aggiorna() => InvokeAsync(() =>
    {
        _pdf = Lab.PdfDellAip;
        StateHasChanged();
    });

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private string Riassunto() => Lab.CartellaDeiPdf is not null ? $"{_pdf.Count} PDF"
        : Lab.CartellaDellAipEspanso is not null ? "espanso" : "— da scegliere";

    private async Task Prendi()
    {
        _rifiuto = await Lab.PrendiIPdfDaDownloadAsync() ? null : Lab.Rifiuto;
        _pdf = Lab.PdfDellAip;
    }

    private async Task Leggi() => _rifiuto = await Lab.LeggiLAipAsync(_ciclo) ? null : Lab.Rifiuto;

    private static string Data(DateOnly? d) =>
        d is { } x ? x.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : "senza data";

    private static string Tipo(Aip.Pdf.Italia.ImportIssueKind k) => k switch
    {
        Aip.Pdf.Italia.ImportIssueKind.PageWithoutTable => "pagina senza tabella",
        Aip.Pdf.Italia.ImportIssueKind.PageWithoutDate => "pagina senza data",
        Aip.Pdf.Italia.ImportIssueKind.UnknownIdentifier => "identificativo fuori forma",
        Aip.Pdf.Italia.ImportIssueKind.Geometry => "geometria",
        Aip.Pdf.Italia.ImportIssueKind.NoGeometry => "senza geometria",
        Aip.Pdf.Italia.ImportIssueKind.MoreGeometries => "più geometrie",
        Aip.Pdf.Italia.ImportIssueKind.LimitsMissing => "limiti mancanti",
        Aip.Pdf.Italia.ImportIssueKind.LimitsExtra => "limiti in più",
        Aip.Pdf.Italia.ImportIssueKind.Unsupported => "non ancora letto",
        Aip.Pdf.Italia.ImportIssueKind.Route => "rotta",
        Aip.Pdf.Italia.ImportIssueKind.Holding => "attesa",
        _ => k.ToString(),
    };
