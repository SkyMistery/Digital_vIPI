@implements IDisposable
@inject SessioneDelLab Lab
@using Famiglia = Vipi.SectorLab.Core.PdfAip.FamigliaDelConfronto
@using Esiti = Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto

@*
    I PDF dell'AIP nella barra (carta F6, slice 0c): la cartella dei PDF, «Prendi i PDF da Download» (sposta, solo su questo
    tasto), e «Leggi nell'AIP espanso» (i PDF nel modello, una cartella per ciclo). «Confronta i CTR» (slice 1b) legge e
    basta; il sector cambia solo coi tasti di una riga del confronto, «Sostituisci» e «Porta nel sector» (slice 1c), che
    sono gesti come gli altri: modifiche in sospeso, nel diff, da annullare, salvate solo da «Salva».
*@
<details class="lab-impostazioni lab-ramo-riquadro" data-riquadro-aip>
    <summary class="lab-tasto lab-tasto-tenue" title="I PDF dell'AIP e l'AIP espanso" data-aip>
        AIP <span class="lab-nota" data-quanti-pdf>@Riassunto()</span>
    </summary>
    <div class="lab-impostazioni-riquadro">
        @if (Lab.CartellaDeiPdf is not { } cartella)
        {
            <p class="lab-nota" data-senza-pdf>Manca la cartella dei PDF dell'AIP: sceglila nelle Impostazioni.</p>
        }
        else
        {
            <p class="lab-nota">PDF: <code>@cartella</code> — @_pdf.Count file dell'AIP.</p>
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prendi-da-download"
                    title="Sposta i PDF dell'AIP (LI-ENR …, LI-AD 2 …) da @Lab.Download in questa cartella" @onclick="Prendi">Prendi i PDF da Download</button>
            @if (Lab.UltimaPresaDaDownload is { } presa)
            {
                <p class="lab-nota" data-presa>@(presa.Quanti == 0
                    ? "In Download non c'erano PDF dell'AIP."
                    : $"Presi {presa.Quanti}: {presa.Nuovi.Count} nuovi, {presa.Sostituiti.Count} al posto di quelli col loro nome.")</p>
            }

            @if (Lab.CartellaDellAipEspanso is null || Lab.StatoDellAip is null)
            {
                <p class="lab-nota" data-prendi-espanso>Il repo dell'AIP espanso (<code>@Lab.IndirizzoDellAipEspanso</code>) non è ancora su questo PC:
                    prendilo in una cartella nuova (o vuota), e diventa la cartella dell'AIP espanso.</p>
                <label class="lab-nota">
                    Dove
                    <input class="lab-campo" value="@_dove" data-campo="dove-aip-espanso" placeholder="D:\IVAO\aip-espanso"
                           @onchange="e => _dove = e.Value?.ToString()" />
                </label>
                @if (Lab.ScegliCartella is not null)
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-dove-aip" @onclick="SfogliaDove">Sfoglia…</button>
                }
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="prendi-aip-espanso" disabled="@Lab.StaLavorandoSulRepoDellAip"
                        title="Clona il repo dell'AIP espanso in quella cartella" @onclick="PrendiLEspanso">Prendi l'AIP espanso</button>
            }
            @if (Lab.CartellaDellAipEspanso is not { } espanso)
            {
                <p class="lab-nota" data-senza-espanso>Manca la cartella dell'AIP espanso: prendi il repo qui sopra, o sceglila nelle Impostazioni.</p>
            }
            else
            {
                <p class="lab-nota">AIP espanso: <code>@espanso</code></p>
                @if (Lab.StatoDellAip is { } repo)
                {
                    <p class="lab-nota" data-stato-aip>Repo: <code>@(Vipi.SectorLab.Core.Git.Invio.RepoGitHub(repo.Remoto) ?? repo.Remoto)</code> · ramo
                        <code>@(repo.Ramo ?? "staccato")</code> · @repo.InParole()</p>
                }
                <label class="lab-nota">
                    Ciclo
                    <input class="lab-campo lab-campo-corto" value="@_ciclo" data-campo="ciclo" maxlength="4" inputmode="numeric"
                           @onchange="e => _ciclo = e.Value?.ToString()" />
                </label>
                <button type="button" class="lab-tasto" data-tasto="leggi-aip" disabled="@(Lab.StaLeggendoLAip || _pdf.Count == 0)"
                        title="Legge i PDF della cartella e scrive il modello nella cartella del ciclo" @onclick="Leggi">
                    @(Lab.StaLeggendoLAip ? "Sto leggendo…" : "Leggi nell'AIP espanso")
                </button>
            }

            @if (Lab.UltimoAipEspanso is { } esito)
            {
                <div data-esito-aip>
                    <p class="lab-nota">Ciclo @esito.Ciclo: <strong>@esito.Aree aree</strong> da @esito.Letti.Count PDF letti su @esito.Pdf
                        (@esito.NonAncora.Count non ancora: le loro sezioni vengono con le prossime slice) → <code>@esito.Scritto</code></p>
                    @if (esito.Date.Count > 0)
                    {
                        <p class="lab-nota" data-date-aip>Date delle pagine: @string.Join(", ", esito.Date.Select(d => $"{Data(d.Data)} ×{d.Pagine}"))</p>
                    }
                    @if (Lab.StatoDellAip is { } repo2 && repo2.Ramo?.StartsWith(Vipi.SectorLab.Core.PdfAip.RepoDellAip.PrefissoDelRamo, StringComparison.Ordinal) == true)
                    {
                        <div data-git-aip>
                            <label class="lab-nota">
                                Messaggio
                                <input class="lab-campo" value="@Lab.MessaggioDellAip" data-campo="messaggio-aip"
                                       @onchange="e => Lab.MessaggioDellAip = e.Value?.ToString()" />
                            </label>
                            <button type="button" class="lab-tasto" data-tasto="registra-aip" disabled="@Lab.StaLavorandoSulRepoDellAip"
                                    title="Registra il modello del ciclo sul ramo @repo2.Ramo" @onclick="Registra">Registra</button>
                            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="manda-aip" disabled="@Lab.StaLavorandoSulRepoDellAip"
                                    title="Manda il ramo @repo2.Ramo al server e apre la pagina della PR: la fonde il committente" @onclick="Manda">Manda</button>
                            @if (Lab.PaginaDellaPrDellAip is { } pr)
                            {
                                <p class="lab-nota" data-pr-aip>PR: <a href="@pr" target="_blank" rel="noopener">aperta nel browser</a> — la conferma tu su GitHub, la fonde il committente.</p>
                            }
                        </div>
                    }
                    @foreach (var i in esito.Illeggibili)
                    {
                        <p class="lab-avviso-breve" data-illeggibile>Non si apre: @i</p>
                    }
                    @if (esito.Problemi.Count > 0)
                    {
                        <details data-problemi-aip>
                            <summary class="lab-nota">@esito.Problemi.Count segnalazioni: @string.Join(" · ", esito.Problemi.GroupBy(p => p.Problema.Kind).Select(g => $"{Tipo(g.Key)} {g.Count()}"))</summary>
                            <ul class="lab-elenco-lotto">
                                @foreach (var p in esito.Problemi.Take(200))
                                {
                                    <li class="lab-nota" data-problema-aip="@p.Problema.Kind">
                                        <code>@p.File</code>@(p.Problema.Page is { } n ? $" p.{n}" : "") — @Tipo(p.Problema.Kind)@(p.Problema.Key is { } k ? $" · {k}" : "")@(p.Problema.Detail is { } d ? $": {d}" : "")
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            }
        }
        @if (Lab.CartellaDellAipEspanso is not null)
        {
            <div data-confronto>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-ctr" disabled="@(Lab.Sessione is null)"
                        title="I CTR dell'AIP espanso contro le voci CTR dei MAPS del sector aperto (sola lettura, soglia 0,1 NM)" @onclick="() => Confronta(Famiglia.Ctr)">Confronta i CTR</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-atz" disabled="@(Lab.Sessione is null)"
                        title="Le ATZ di ENR 2 (le militari e le ATZ-RMZ) contro le voci ATZ dei MAPS degli .str (sola lettura)" @onclick="() => Confronta(Famiglia.Atz)">le ATZ negli .str</button>
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="confronta-torri" disabled="@(Lab.Sessione is null)"
                        title="Le ATZ di ENR 2 contro i settori delle torri di DYNAMIC_SEC/twrs.tfl (sola lettura)" @onclick="() => Confronta(Famiglia.AtzDelleTorri)">le ATZ in twrs.tfl</button>
                @if (Lab.UltimoConfronto is { } confronto)
                {
                    var atz = confronto.Famiglia != Famiglia.Ctr;
                    <p class="lab-nota" data-riassunto-confronto>@Cosa(confronto.Famiglia), ciclo @confronto.Ciclo: @string.Join(" · ", confronto.Esiti.GroupBy(e => e.Esito).Select(g => $"{Esito(g.Key)} {g.Count()}"))</p>
                    @if (atz && confronto.Esiti.Any(e => e.Esito == Esiti.SoloNelSector))
                    {
                        <p class="lab-nota" data-solo-nel-sector>Le voci «solo nel sector» non si elencano: le ATZ civili stanno in AD 2, che il Lab non legge ancora.</p>
                    }
                    <ul class="lab-elenco-lotto">
                        @foreach (var e in confronto.Esiti.Where(e => e.Esito != Esiti.Uguale && !(atz && e.Esito == Esiti.SoloNelSector)))
                        {
                            <li class="lab-nota" data-differenza="@e.Esito">
                                @if (e.File is { } file && e.Record is { } record)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" title="Apre la voce del sector" @onclick="() => Lab.Scegli(file, record)">@Esito(e.Esito)</button>
                                }
                                else
                                {
                                    <strong>@Esito(e.Esito)</strong>
                                }
                                @(e.Aip ?? "—") @(e.Zone > 1 ? $"({e.Zone} zone)" : "") ↔ @(e.Sector ?? "—")
                                @if (e.ScartoAip is { } a && e.ScartoSector is { } s)
                                {
                                    <span> · l'AIP si stacca dal sector fino a @a.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) NM, il sector dall'AIP fino a @s.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) NM</span>
                                }
                                @if (e.Dove is { } dove)
                                {
                                    <span> · il punto peggiore: @Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.Dms(dove)</span>
                                }
                                @if (e.SenzaTracciato)
                                {
                                    <span> · lungo un confine o una costa che l'AIP non disegna: lì non si giudica</span>
                                }
                                @if (Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.DaGuardare(e))
                                {
                                    <span class="lab-avviso-breve" data-da-guardare> · più di @Vipi.SectorLab.Core.PdfAip.ConfrontoDelleForme.ScartoDaGuardare.ToString("0", System.Globalization.CultureInfo.InvariantCulture) NM: quasi certo un errore di stampa (dell'AIP o del sector). Guarda il PDF, si corregge a mano.</span>
                                }
                                else if (e.Esito == Esiti.FormaDiversa && confronto.Famiglia == Famiglia.AtzDelleTorri && e.Zone > 1)
                                {
                                    <span data-piu-zone> · @e.Zone zone nell'AIP: un settore della torre è un poligono solo, si sistema a mano.</span>
                                }
                                else if (e.Esito == Esiti.FormaDiversa && e.File is not null)
                                {
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci"
                                            title="Riscrive tutta la voce @e.Sector con le zone dell'AIP @confronto.Ciclo (la testata resta): una modifica in sospeso, nel diff e da annullare come le altre"
                                            @onclick="() => Sostituisci(e)">Sostituisci</button>
                                }
                                else if (e.Esito == Esiti.MancaNelSector && e.Aip is { } nome && confronto.Famiglia != Famiglia.AtzDelleTorri)
                                {
                                    <input class="lab-campo lab-campo-corto" maxlength="4" placeholder="LIxx" data-campo="scalo" value="@_scali.GetValueOrDefault(nome)"
                                           title="Lo scalo: la voce va nel suo .str" @onchange="v => _scali[nome] = v.Value?.ToString()" />
                                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta"
                                            title="Scrive la voce nuova del MAPS nello .str dello scalo: una modifica in sospeso, nel diff e da annullare come le altre"
                                            @onclick="() => Porta(e, nome)">Porta nel sector</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (_rifiuto is not null)
        {
            <p class="lab-avviso-breve" data-rifiuto-aip>@_rifiuto</p>
        }
    </div>
</details>

@code {
    private string? _rifiuto;
    private string? _ciclo;
    private string? _dove;
    private IReadOnlyList<string> _pdf = [];

    protected override async Task OnInitializedAsync()
    {
        Lab.Cambiata += Aggiorna;
        _ciclo = Lab.CicloDiOggi;
        _pdf = Lab.PdfDellAip;
        await Lab.RileggiIlRepoDellAipAsync();
    }

    private async Task SfogliaDove()
    {
        if (await Lab.ScegliCartella!("Dove mettere l'AIP espanso (nuova o vuota)", _dove) is { } scelta)
            _dove = scelta;
    }

    private async Task PrendiLEspanso() => _rifiuto = await Lab.PrendiLAipEspansoAsync(_dove) ? null : Lab.Rifiuto;

    private async Task Registra() => _rifiuto = await Lab.RegistraLAipAsync(Lab.MessaggioDellAip) ? null : Lab.Rifiuto;

    private async Task Manda() => _rifiuto = await Lab.MandaLAipAsync() ? null : Lab.Rifiuto;

    private async Task Confronta(Famiglia famiglia) => _rifiuto = await Lab.ConfrontaAsync(famiglia) ? null : Lab.Rifiuto;

    private static string Cosa(Famiglia f) => f switch
    {
        Famiglia.Ctr => "CTR",
        Famiglia.Atz => "ATZ negli .str",
        _ => "ATZ in twrs.tfl",
    };

    private readonly Dictionary<string, string?> _scali = new(StringComparer.OrdinalIgnoreCase);

    private void Sostituisci(Vipi.SectorLab.Core.PdfAip.DifferenzaDiForma e) => _rifiuto = Lab.SostituisciLaVoce(e) ? null : Lab.Rifiuto;

    private void Porta(Vipi.SectorLab.Core.PdfAip.DifferenzaDiForma e, string ctr) => _rifiuto = Lab.PortaNelSector(e, _scali.GetValueOrDefault(ctr)) ? null : Lab.Rifiuto;

    private static string Esito(Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto e) => e switch
    {
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.Uguale => "uguali",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.FormaDiversa => "forma diversa",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.MancaNelSector => "manca nel sector",
        Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto.SoloNelSector => "solo nel sector",
        _ => e.ToString(),
    };

    private void Aggiorna() => InvokeAsync(() =>
    {
        _pdf = Lab.PdfDellAip;
        StateHasChanged();
    });

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private string Riassunto() => Lab.CartellaDeiPdf is null ? "— da scegliere" : $"{_pdf.Count} PDF";

    private async Task Prendi()
    {
        _rifiuto = await Lab.PrendiIPdfDaDownloadAsync() ? null : Lab.Rifiuto;
        _pdf = Lab.PdfDellAip;
    }

    private async Task Leggi() => _rifiuto = await Lab.LeggiLAipAsync(_ciclo) ? null : Lab.Rifiuto;

    private static string Data(DateOnly? d) =>
        d is { } x ? x.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : "senza data";

    private static string Tipo(Aip.Pdf.Italia.ImportIssueKind k) => k switch
    {
        Aip.Pdf.Italia.ImportIssueKind.PageWithoutTable => "pagina senza tabella",
        Aip.Pdf.Italia.ImportIssueKind.PageWithoutDate => "pagina senza data",
        Aip.Pdf.Italia.ImportIssueKind.UnknownIdentifier => "identificativo fuori forma",
        Aip.Pdf.Italia.ImportIssueKind.Geometry => "geometria",
        Aip.Pdf.Italia.ImportIssueKind.NoGeometry => "senza geometria",
        Aip.Pdf.Italia.ImportIssueKind.MoreGeometries => "più geometrie",
        Aip.Pdf.Italia.ImportIssueKind.LimitsMissing => "limiti mancanti",
        Aip.Pdf.Italia.ImportIssueKind.LimitsExtra => "limiti in più",
        Aip.Pdf.Italia.ImportIssueKind.Unsupported => "non ancora letto",
        _ => k.ToString(),
    };
}
