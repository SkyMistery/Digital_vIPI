@implements IDisposable
@inject SessioneDelLab Lab

@*
    La vista per scalo (lotto «Subito» slice 12d, «file per file» I6, O1): scelto uno scalo, tutto quello che lo riguarda
    da qualunque file — la sua riga dell'.ap, le piste, le posizioni, i file col suo nome, disegni e riempimenti, e le
    marcature per pista. Una voce che è un record lo sceglie (scheda e mappa); una che è un file lo apre in Sfoglia, o,
    col fuoco su questo scalo, qui sotto (carta «Lavorare su uno scalo», R3).
    Con Settori (R7) è la vista per settore: scelta una posizione ATC, i settori dei .tfl che la accendono, i bordi col
    suo nome, i file col suo nome e le sue righe dei .frq. Stesse voci, stesso fuoco.
    Sta in una linguetta sua (committente, 4 ottobre 2026: «la finestra a parte, poi sulla UI ragioneremo»).
    🔴 Si iscrive da sé a Cambiata: i suoi parametri non cambiano, e il ridisegno della colonna non arrivava fin qui — una
    scelta dalla mappa non si vedeva nell'elenco fino a un cambio di linguetta (trovato sul banco con R7).
*@
<div class="lab-scali" data-scalo="@(Settori ? null : Lab.ScaloScelto)" data-settore="@(Settori ? Lab.SettoreScelto : null)">
    <select class="lab-campo" value="@Scelto" @onchange="e => Scegli(e.Value?.ToString())" data-campo="@(Settori ? "settore" : "scalo")"
            title="@(Settori ? "La posizione ATC di cui vedere settori, bordi e file" : "Lo scalo di cui vedere tutto, da qualunque file")">
        <option value="">@(Settori ? "— scegli una posizione" : "— scegli uno scalo")</option>
        @if (Settori)
        {
            @foreach (var settore in Lab.SettoriDellaVista())
            {
                <option value="@settore.Codice">@settore.Codice@(settore.Frequenza is { } frequenza ? " · " + frequenza : null)</option>
            }
        }
        else
        {
            @foreach (var scalo in Lab.ScaliDellaVista())
            {
                <option value="@scalo.Icao">@scalo.Icao · @scalo.Nome</option>
            }
        }
    </select>

    @* Il fuoco (carta «Lavorare su uno scalo», R1, R7): da qui si lavora su questo scalo o settore, finché non si esce. *@
    @if (Scelto is { } scelto && !NelFuoco)
    {
        <button type="button" class="lab-tasto" data-tasto="lavora-su" @onclick="() => LavoraSu(scelto)"
                title="@(Settori ? "La mappa va sul settore e mostra solo i suoi settori e bordi, finché non esci" : "La mappa va sullo scalo e mostra solo i suoi file, finché non esci")">◎ Lavora su @scelto</button>
    }

    @if (Scelto is null)
    {
        @if (Settori)
        {
            <p class="lab-nota">Scegli una posizione ATC: qui compaiono i settori dei .tfl che accende, i bordi col suo nome
                (.hartcc, .lartcc), i file col suo nome e le sue righe dei .frq.</p>
        }
        else
        {
            <p class="lab-nota">Scegli uno scalo: qui compare tutto quello che lo riguarda — la riga dell'.ap, le piste, le
                posizioni, i suoi file, i disegni di terra e le marcature per pista.</p>
        }
    }
    else if (Sezioni is { Count: > 0 } sezioni)
    {
        @foreach (var sezione in sezioni)
        {
            <Sezione Chiave="@Chiave(sezione)" data-sezione-scalo="@sezione.Id">
            <Titolo>@sezione.Nome <span class="lab-nota">@sezione.Voci.Count</span></Titolo>
            <ChildContent>
            <div class="lab-stessa-forma">
            <ul>
                @foreach (var voce in sezione.Voci)
                {
                    var questa = voce;
                    <li>
                        <button type="button" class="lab-citazione @(Scelta(questa) || Aperto(questa) ? "lab-voce-scelta" : null)"
                                data-voce-scalo="@Indirizzo(questa)" @onclick="() => Apri(questa)"
                                title="@(questa.Record is not null ? "Sceglie il record: scheda e mappa" : NelFuoco ? "Apre i suoi record qui sotto" : "Apre il file in Sfoglia")">
                            @(Aperto(questa) ? "▾ " : null)@questa.Titolo <span class="lab-nota">@questa.Nota</span>
                        </button>
                        @* Il fuoco, R3: i record del file si aprono qui, sotto lo scalo, non in Sfoglia fra i file d'Italia. *@
                        @if (Aperto(questa))
                        {
                            <RecordDelFile Relativo="@questa.File" />
                        }
                    </li>
                }
            </ul>
            </div>
            </ChildContent>
            </Sezione>
        }
    }
    else
    {
        <p class="lab-nota" data-scalo-vuoto>Di @Scelto in questo albero non c'è niente.</p>
    }
</div>

@code {
    /// <summary>Si è aperto un file: la colonna passa a Sfoglia, dove stanno i suoi record.</summary>
    [Parameter] public EventCallback<string> OnApriUnFile { get; set; }

    /// <summary>R7: la vista per settore (una posizione ATC) invece che per scalo.</summary>
    [Parameter] public bool Settori { get; set; }

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private string? Scelto => Settori ? Lab.SettoreScelto : Lab.ScaloScelto;

    private IReadOnlyList<SezioneDelloScalo> Sezioni => Settori ? Lab.VistaDelSettore() : Lab.VistaDelloScalo();

    private void Scegli(string? valore)
    {
        if (Settori)
            Lab.ScegliIlSettore(valore);
        else
            Lab.ScegliLoScalo(valore);
    }

    private void LavoraSu(string scelto)
    {
        if (Settori)
            Lab.LavoraSulSettore(scelto);
        else
            Lab.LavoraSu(scelto);
    }

    // Una chiave per genere di sezione: «Marcature · pista 16L» chiusa a LIRF resta chiusa per le altre marcature. Le
    // sezioni del settore hanno la loro (anche «file» e «posizioni», che ci sono in tutte e due).
    private string Chiave(SezioneDelloScalo sezione) => (Settori ? "settore-" : "scalo-") + sezione.Id.Split(':')[0];

    private static string Indirizzo(VoceDelloScalo voce) => voce.Record is { } record ? voce.File + "#" + record : voce.File;

    private bool Scelta(VoceDelloScalo voce) => voce.Record is { } record && Lab.Scelta == (voce.File, record);

    /// <summary>Si lavora sullo scalo (o sul settore) che la linguetta mostra (R1, R7): i suoi file si aprono qui (R3).</summary>
    private bool NelFuoco => Lab.Fuoco is { } fuoco && Lab.FuocoSuUnSettore == Settori && fuoco == Scelto;

    /// <summary>
    /// Il file della voce è aperto qui sotto: col fuoco, è il file aperto del Lab. Anche quando lo apre la mappa — un clic
    /// su un edificio di LIRF apre lirf.geo, e la colonna lo mostra qui, col record scelto.
    /// </summary>
    private bool Aperto(VoceDelloScalo voce) => NelFuoco && voce.Record is null && Lab.FileScelto == voce.File;

    private async Task Apri(VoceDelloScalo voce)
    {
        if (voce.Record is { } record)
        {
            Lab.Scegli(voce.File, record);
            return;
        }

        if (NelFuoco)
        {
            // Un secondo clic lo chiude (ApriFile scambia).
            Lab.ApriFile(voce.File);
            return;
        }

        Lab.ApriIlFileCitato(voce.File);
        await OnApriUnFile.InvokeAsync(voce.File);
    }
}
