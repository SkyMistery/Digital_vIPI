@implements IDisposable
@inject SessioneDelLab Lab

@*
    I pannelli della pagina scelta (riordino delle pagine, D1 e D3): gli stessi nella finestra principale, accanto alla
    mappa, e nella finestra dei pannelli coi due schermi. Sector: la colonna, la Scheda e le Modifiche. AIP: l'AIP
    espanso coi confronti, la Scheda e le Modifiche (i gesti dei confronti sono modifiche in sospeso come le altre).
    Consegna e Impostazioni: la pagina intera. Ogni divisore allarga o stringe la colonna alla sua SINISTRA
    (sectorlab.js): il nome è la chiave della larghezza, con «p-» davanti nella finestra dei pannelli.
*@
@switch (Lab.Pagina)
{
    case PaginaDelLab.Sector:
        <ColonnaDiSinistra />
        <div class="lab-divisore" data-divide="@($"{_p}sfoglia")" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        @if (NellaFinestraDeiPannelli)
        {
            <aside class="lab-colonna lab-colonna-ispettore">
                <Scheda />
            </aside>
            <div class="lab-divisore" data-divide="p-ispettore" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
            <aside class="lab-colonna lab-colonna-modifiche">
                <Modifiche />
            </aside>
        }
        else if (Lab.SchedaAStriscia)
        {
            @* Carta «Lavorare su uno scalo», D4: col fuoco la Scheda stretta a una striscia; la mappa prende il suo posto.
               Le modifiche in sospeso restano contate, per non perderle di vista. *@
            <aside class="lab-colonna lab-colonna-ispettore lab-colonna-scheda-stretta" data-scheda="stretta">
                <nav class="lab-indice-striscia" data-scheda-striscia>
                    <button type="button" class="lab-voce lab-striscia-riapri" data-tasto="riapri-scheda" title="Riapre la Scheda e le Modifiche"
                            @onclick="() => Lab.StringiLaScheda(false)">‹ <span>Scheda</span></button>
                    @if (Lab.Modifiche.Quante is > 0 and var quante)
                    {
                        <button type="button" class="lab-voce" data-striscia-modifiche="@quante"
                                title="@(quante == 1 ? "1 modifica in sospeso" : $"{quante} modifiche in sospeso"): riapre la Scheda e le Modifiche"
                                @onclick="() => Lab.StringiLaScheda(false)">@quante<span class="lab-nota"> mod.</span></button>
                    }
                </nav>
            </aside>
        }
        else
        {
            <aside class="lab-colonna lab-colonna-ispettore" data-scheda="larga">
                @if (Lab.Fuoco is not null)
                {
                    @* D4: col fuoco la Scheda si stringe, come l'Indice dell'AIP. *@
                    <button type="button" class="lab-voce lab-scheda-stringi" data-tasto="stringi-scheda"
                            title="Stringe la Scheda a una striscia: la mappa prende il suo posto" @onclick="() => Lab.StringiLaScheda(true)">‹</button>
                }
                <Scheda />
                <Modifiche />
            </aside>
            <div class="lab-divisore" data-divide="ispettore" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        }
        break;

    case PaginaDelLab.AipIndice:
        @* Carta «L'Indice rifatto», R2: senza una voce l'Indice è largo e la scheda non c'è; aperta una voce (o uno scalo)
           l'Indice si stringe in una striscia e la scheda prende il suo posto. Nella finestra dei pannelli la scheda resta. *@
        var conVoce = Lab.VoceDellAipScelta is not null;
        var stretto = IndiceStretto(conVoce);
        var senzaScheda = !conVoce && !NellaFinestraDeiPannelli;
        <aside class="lab-colonna lab-colonna-indice @(stretto ? "lab-colonna-indice-stretta" : senzaScheda ? "lab-colonna-indice-larga" : null)"
               data-indice="@(stretto ? "stretto" : senzaScheda ? "largo" : "aperto")">
            <IndiceDellAipVista Stretto="stretto" Riapri="RiapriLIndice" PuoStringersi="@(conVoce && !stretto)" Stringi="StringiLIndice" />
        </aside>
        @if (!stretto)
        {
            <div class="lab-divisore" data-divide="@(senzaScheda ? "indice-largo" : $"{_p}indice")" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        }
        @if (senzaScheda)
        {
            break;
        }
        var paginaDelloScalo = Lab.PaginaDelloScaloScelto;
        <aside class="lab-colonna lab-colonna-ispettore lab-colonna-scheda-aip @(NellaFinestraDeiPannelli ? "lab-colonna-modifiche" : null)" data-colonna-scheda-aip>
            @if (Lab.VoceDellAipScelta is null)
            {
                <p class="lab-nota" data-scheda-aip-vuota>Scegli una voce nell'indice, o clicca una forma dell'AIP sulla mappa.</p>
            }
            @* Carta «Gli aeroporti nel Lab», S1: uno scalo è una pagina; una sua voce ha sopra la scheda il ritorno allo scalo. *@
            @if (paginaDelloScalo is not null)
            {
                <PaginaDelloScaloVista Pagina="paginaDelloScalo" Ciclo="@Lab.StratoDellAip?.Ciclo">
                    <SchedaDelloScalo>
                        <AipNellaScheda Voce="Lab.VoceDellAipScelta" Ciclo="@Lab.StratoDellAip?.Ciclo" Area="Lab.AreaDellAipScelta" Modello="Lab.VoceDelModelloScelta"
                                       Correzione="@(Lab.CorrezioneDellAreaScelta ?? Lab.CorrezioneDellaVoceScelta)" />
                    </SchedaDelloScalo>
                </PaginaDelloScaloVista>
            }
            else
            {
                @if (Lab.ScaloDellaVoceScelta is var (indiceDelloScalo, icao, nome) && Lab.StratoDellAip is { } strato)
                {
                    <button type="button" class="lab-voce lab-torna-allo-scalo" data-torna-allo-scalo="@icao"
                            @onclick="() => Lab.Scegli(strato.File, indiceDelloScalo)">‹ @icao @nome</button>
                }
                @* 🔴 Col parametro: un componente senza parametri non si ridisegna quando la scheda cambia (come in Scheda.razor). *@
                <AipNellaScheda Voce="Lab.VoceDellAipScelta" Ciclo="@Lab.StratoDellAip?.Ciclo" Area="Lab.AreaDellAipScelta" Modello="Lab.VoceDelModelloScelta"
                               Correzione="@(Lab.CorrezioneDellAreaScelta ?? Lab.CorrezioneDellaVoceScelta)" />
            }
        </aside>
        @if (!NellaFinestraDeiPannelli)
        {
            @* Una larghezza sua, per la voce e per lo scalo: prima lo scalo ne aveva una che il divisore non toccava. *@
            <div class="lab-divisore" data-divide="scheda-aip" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        }
        break;

    case PaginaDelLab.Aip:
        @* «Lettura e consegna» dello spazio AIP espanso: dal 22 ottobre la pagina intera, senza mappa (sta nell'Indice). *@
        <PaginaDellaLettura />
        break;

    case PaginaDelLab.Confronti:
        @* R6: le sezioni e le righe; accanto le due schede, del sector e dell'AIP, della riga scelta. *@
        <aside class="lab-colonna lab-colonna-aip">
            <ConfrontiVista />
        </aside>
        <div class="lab-divisore" data-divide="@($"{_p}aip")" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        <aside class="lab-colonna lab-colonna-ispettore @(NellaFinestraDeiPannelli ? "lab-colonna-modifiche" : null)">
            @* La Scheda ha già, in testa, la voce dell'AIP scelta: qui una seconda volta la mostrava doppia (R9). *@
            <Scheda />
        </aside>
        @if (!NellaFinestraDeiPannelli)
        {
            <div class="lab-divisore" data-divide="ispettore" title="Trascina per allargare; doppio clic per la larghezza di base"></div>
        }
        break;

    case PaginaDelLab.Consegna:
        <PaginaDellaConsegna />
        break;

    case PaginaDelLab.Testo:
        <PaginaDelTesto />
        break;

    default:
        <PaginaDelleImpostazioni />
        break;
}

@code {
    /// <summary>Nella finestra dei pannelli (due schermi) le colonne si dividono tutta la larghezza: la mappa è di là.</summary>
    [Parameter] public bool NellaFinestraDeiPannelli { get; set; }

    private string _p => NellaFinestraDeiPannelli ? "p-" : "";

    private int? _sceltaDiPrima;
    private bool _indiceRiaperto;

    /// <summary>
    /// R2: l'Indice è una striscia quando c'è una voce aperta, finché non lo si riapre; una voce nuova (dall'Indice o dalla
    /// mappa) lo stringe di nuovo.
    /// </summary>
    private bool IndiceStretto(bool conVoce)
    {
        if (Lab.SceltaDellAip != _sceltaDiPrima)
        {
            _sceltaDiPrima = Lab.SceltaDellAip;
            _indiceRiaperto = false;
        }
        return conVoce && !_indiceRiaperto;
    }

    private void RiapriLIndice() => _indiceRiaperto = true;

    private void StringiLIndice() => _indiceRiaperto = false;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
