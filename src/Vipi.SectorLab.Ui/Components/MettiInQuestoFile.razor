@inject SessioneDelLab Lab

@*
    «Metti in questo file» (riordino R8a, D19): i punti scelti — uno, gli spuntati o tutti quelli che mancano — in un file
    del sector scelto fra quelli che tengono già punti (i .fix), nel posto scelto. Prima di scrivere, l'anteprima: la riga
    di ogni punto e dove va. «Scrivi» è un gesto solo, una voce nella storia; «Lascia stare» chiude senza toccare niente.
    R8b: con Rotta, una rotta nelle aerovie basse o alte (.lairway, .hairway); il posto lo dà il nome, l'anteprima è il
    blocco e la riga dove va.
*@
<div class="lab-metti" data-metti-nel-file>
    <p class="lab-nota"><strong>@Titolo</strong></p>
    <label class="lab-nota">
        Nel file
        <select class="lab-campo" data-campo="file-di-destinazione" value="@_file" @onchange="e => _file = e.Value?.ToString()">
            @foreach (var file in FileAmmessi)
            {
                <option value="@file">@Path.GetFileName(file)@(DiOggi(file) ? " (di oggi)" : "")</option>
            }
        </select>
    </label>
    @if (Rotta is { } rotta)
    {
        var anteprima = Lab.AnteprimaDellaRotta(rotta, _file, out var perche);
        <span class="lab-nota">in ordine di nome</span>
        @if (anteprima is { } blocco)
        {
            <ul class="lab-metti-anteprima" data-anteprima-metti="@blocco.Righe.Count">
                <li class="lab-nota">@blocco.Dove</li>
                @foreach (var riga in blocco.Righe.Take(12))
                {
                    <li><code>@riga</code></li>
                }
                @if (blocco.Righe.Count > 12)
                {
                    <li class="lab-nota">… e altre @(blocco.Righe.Count - 12) righe</li>
                }
            </ul>
        }
        else
        {
            <p class="lab-avviso-breve" data-anteprima-metti="0">@(perche ?? "La rotta non si può portare in questo file.")</p>
        }
        <button type="button" class="lab-tasto" data-tasto="metti-nel-file" disabled="@(anteprima is null)"
                title="Scrive il blocco qui sopra e le etichette della rotta: un gesto solo, nel diff e da annullare come gli altri"
                @onclick="Scrivi">Scrivi</button>
    }
    else
    {
        <label class="lab-strato">
            <input type="radio" name="@($"posto-{_id}")" checked="@(!_inFondo)" data-posto="ordine" @onchange="() => _inFondo = false" />
            <span>in ordine di nome</span>
        </label>
        <label class="lab-strato">
            <input type="radio" name="@($"posto-{_id}")" checked="@_inFondo" data-posto="fondo" @onchange="() => _inFondo = true" />
            <span>in fondo</span>
        </label>
        var anteprima = Lab.AnteprimaDeiPunti(Nomi, _file, _inFondo);
        <ul class="lab-metti-anteprima" data-anteprima-metti="@anteprima.Count">
            @foreach (var (nome, riga, dove) in anteprima.Take(12))
            {
                <li><code>@riga</code> <span class="lab-nota">— @dove</span></li>
            }
            @if (anteprima.Count > 12)
            {
                <li class="lab-nota">… e altre @(anteprima.Count - 12)</li>
            }
        </ul>
        <button type="button" class="lab-tasto" data-tasto="metti-nel-file" disabled="@(anteprima.Count == 0)"
                title="Scrive le righe qui sopra: un gesto solo, nel diff e da annullare come gli altri" @onclick="Scrivi">Scrivi (@anteprima.Count)</button>
    }
    <button type="button" class="lab-annulla" data-tasto="lascia-stare-metti" @onclick="() => Chiuso.InvokeAsync()">Lascia stare</button>
</div>

@code {
    /// <summary>I punti da mettere nel file.</summary>
    [Parameter] public IReadOnlyList<string> Nomi { get; set; } = [];

    /// <summary>R8b: la rotta da mettere nel file (al posto dei punti).</summary>
    [Parameter] public string? Rotta { get; set; }

    [Parameter] public string Titolo { get; set; } = "Metti in questo file";

    /// <summary>Chiude il riquadro (dopo «Scrivi» o «Lascia stare»).</summary>
    [Parameter] public EventCallback Chiuso { get; set; }

    /// <summary>Com'è andato «Scrivi»: null se è andato, se no il perché.</summary>
    [Parameter] public EventCallback<string?> Fatto { get; set; }

    private readonly string _id = Guid.NewGuid().ToString("N")[..8];
    private string? _file;
    private bool _inFondo;

    private IReadOnlyList<string> FileAmmessi => Rotta is null ? Lab.FileDeiPunti : Lab.FileDelleRotte;

    private bool DiOggi(string file) => Path.GetFileName(file).Equals(
        Rotta is null ? Vipi.SectorLab.Core.PdfAip.ConfrontoDiEnr4.FileDeiPunti : Vipi.SectorLab.Core.PdfAip.ConfrontoDiEnr3.FileDelleAerovie,
        StringComparison.OrdinalIgnoreCase);

    // Il file proposto è quello di oggi (itfix.fix, itawlow.lairway): il primo dell'elenco.
    protected override void OnInitialized() => _file = FileAmmessi.FirstOrDefault();

    private async Task Scrivi()
    {
        // La rotta, come prima, dice qualcosa solo se non va; i punti anche quando vanno (quelli saltati).
        if (Rotta is { } rotta)
            await Fatto.InvokeAsync(Lab.PortaLaRotta(rotta, _file) ? null : Lab.Rifiuto);
        else
        {
            Lab.PortaNelSectorDiEnr4(Nomi, _file, _inFondo);
            await Fatto.InvokeAsync(Lab.Rifiuto);
        }
        await Chiuso.InvokeAsync();
    }
}
