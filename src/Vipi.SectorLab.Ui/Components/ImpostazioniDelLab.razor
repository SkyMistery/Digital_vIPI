@implements IDisposable
@inject SessioneDelLab Lab

@*
    Le impostazioni dell'app (lotto «Subito» slice 13f): quello che è una scelta degli AOD e può cambiare, e che quindi
    non sta nel codice. Si ricordano nei dati del Lab, fuori dal sector. La prima: come si scrive il nome di una
    configurazione nei confini (K1; committente, 5 ottobre 2026).
*@
<section class="lab-riquadro" data-impostazioni>
    <h2 class="lab-riquadro-titolo" title="Le scelte degli AOD che il Lab ricorda: non stanno nel sector">Impostazioni</h2>
    <div class="lab-impostazioni-riquadro">
        <label>
            Nomi delle configurazioni
            <input class="lab-campo" value="@Lab.ModelloDelleConfigurazioni" data-impostazione="configurazioni"
                   placeholder="@NomiDelleConfigurazioni.DiBase" @onchange="Cambia" />
        </label>
        <p class="lab-nota">
            Il modello dei nomi delle configurazioni in HI_AIRSPACE e LOW_AIRSPACE: <code>{ACC}</code> è la sigla (RR, MM),
            <code>{N}</code> il numero. Con «@Lab.ModelloDelleConfigurazioni»: <strong data-esempio>@Esempio()</strong>.
            Una voce scritta in un altro modo è un avviso nel pannello dei problemi. Vuoto = «@NomiDelleConfigurazioni.DiBase».
        </p>
        <label>
            Etichette delle aerovie: tratto minimo (NM)
            <input class="lab-campo" inputmode="decimal" value="@Soglia()" data-impostazione="soglia-etichette"
                   placeholder="10" @onchange="CambiaLaSoglia" />
        </label>
        <p class="lab-nota">
            Un tratto di aerovia più corto non riceve un'etichetta quando il Lab le calcola (di base 10: è la regola che il
            file segue già). 0 = un'etichetta su ogni tratto. Vuoto = 10.
        </p>
        <label>
            VID IVAO
            <input class="lab-campo" inputmode="numeric" value="@Lab.Vid" data-impostazione="vid"
                   placeholder="704798" @onchange="CambiaIlVid" />
        </label>
        <p class="lab-nota">Va nel nome dei rami di lavoro: <code>aod/@(Lab.Vid ?? "VID")/argomento</code> (carta F4).</p>
        <label>
            Repo del sector
            <input class="lab-campo" value="@Lab.IndirizzoDelSector" data-impostazione="indirizzo-del-sector"
                   @onchange="e => Lab.CambiaLIndirizzoDelSector(e.Value?.ToString())" />
        </label>
        <p class="lab-nota">Da dove «Prendi il sector» scarica. Per ora il fork di prova: il repo vero quando lo dice il committente.
            Vuoto = <code>@Vipi.SectorLab.Core.Git.PresaDelSector.IndirizzoDiBase</code>.</p>
        <label>
            Cartella di Aurora
            <input class="lab-campo" value="@Lab.CartellaDiAurora" data-impostazione="cartella-di-aurora"
                   placeholder="@Vipi.SectorLab.Core.Mappa.SchemiDiAurora.CartellaDiAuroraDiBase"
                   @onchange="e => _rifiuto = Lab.CambiaLaCartellaDiAurora(e.Value?.ToString()) ? null : Lab.Rifiuto" />
        </label>
        @if (Lab.ScegliCartella is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-aurora"
                    title="Sceglie la cartella di Aurora in Esplora risorse" @onclick="SfogliaAurora">Sfoglia…</button>
        }
        <p class="lab-nota">Dove Aurora tiene schemi di colore e profili: da qui il Lab prende gli schemi
            (<code>ColourSchemes\*.clr</code>) per colorare la mappa come Aurora; se lì non ce n'è nessuno, li cerca nel
            clone del sector. Vuoto = <code>@Vipi.SectorLab.Core.Mappa.SchemiDiAurora.CartellaDiAuroraDiBase</code>.
            @if (Lab.Sessione is not null)
            {
                <span data-schemi-da>Schemi: @Lab.SchemiDisponibili.Count, da <code>@Vipi.SectorLab.Core.Mappa.SchemiDiAurora.Cartella(Lab.Sessione.Cartella, Lab.CartellaDiAurora)</code>.</span>
            }
        </p>
        <label>
            Vetrina di Aurora
            <input class="lab-campo" value="@Lab.CartellaDellaVetrina" data-impostazione="vetrina"
                   placeholder="D:\IVAO\Aurora-vetrina" @onchange="CambiaLaVetrina" />
        </label>
        @if (Lab.ScegliCartella is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-vetrina"
                    title="Sceglie (o crea) la cartella della vetrina in Esplora risorse" @onclick="SfogliaLaVetrina">Sfoglia…</button>
        }
        <p class="lab-nota">Una cartella nuova, solo del Lab: «Porta in Aurora» ci mette il sector che stai guardando. In Aurora
            metti come secondo sector la sua <code>SectorFiles</code>, una volta (carta F5).</p>
        <label>
            PDF dell'AIP
            <input class="lab-campo" value="@Lab.CartellaDeiPdf" data-impostazione="cartella-dei-pdf"
                   placeholder="D:\IVAO\AIP" @onchange="e => _rifiuto = Lab.CambiaLaCartellaDeiPdf(e.Value?.ToString()) ? null : Lab.Rifiuto" />
        </label>
        @if (Lab.ScegliCartella is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-pdf"
                    title="Sceglie la cartella dei PDF dell'AIP in Esplora risorse" @onclick="SfogliaIPdf">Sfoglia…</button>
        }
        <p class="lab-nota">Dove stanno i PDF dell'AIP (<code>LI-ENR …</code>, <code>LI-AD 2 …</code>): ce li metti tu, o li sposta il Lab da
            Download col tasto nel riquadro «AIP». Anche in sottocartelle. Fuori dal sector e dai repo (carta F6).</p>
        <label>
            AIP espanso
            <input class="lab-campo" value="@Lab.CartellaDellAipEspanso" data-impostazione="aip-espanso"
                   placeholder="D:\IVAO\aip-espanso" @onchange="e => _rifiuto = Lab.CambiaLAipEspanso(e.Value?.ToString()) ? null : Lab.Rifiuto" />
        </label>
        @if (Lab.ScegliCartella is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sfoglia-aip-espanso"
                    title="Sceglie la cartella dell'AIP espanso in Esplora risorse" @onclick="SfogliaLAipEspanso">Sfoglia…</button>
        }
        <p class="lab-nota">Tutto quel che il Lab legge dall'AIP, nel modello, una cartella per ciclo (<code>2611\li.json</code>).
            Se è il clone del suo repo, il Lab ci scrive sul ramo del ciclo (<code>aip/2611</code>) e la PR la fonde il committente.</p>
        <label>
            Repo dell'AIP espanso
            <input class="lab-campo" value="@Lab.IndirizzoDellAipEspanso" data-impostazione="indirizzo-aip-espanso"
                   @onchange="e => Lab.CambiaLIndirizzoDellAipEspanso(e.Value?.ToString())" />
        </label>
        <p class="lab-nota">Da dove «Prendi l'AIP espanso» lo clona. Per ora quello di prova, privato.
            Vuoto = <code>@Vipi.SectorLab.Core.PdfAip.RepoDellAip.IndirizzoDiBase</code>.</p>
        @if (_rifiuto is not null)
        {
            <p class="lab-avviso-breve" data-impostazione-rifiutata>@_rifiuto</p>
        }
    </div>
</section>

@code {
    private string? _rifiuto;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private void Cambia(ChangeEventArgs e)
        => _rifiuto = Lab.CambiaIlModelloDelleConfigurazioni(e.Value?.ToString()) ? null : Lab.Rifiuto;

    private async Task SfogliaLaVetrina()
    {
        if (await Lab.ScegliCartella!("La cartella della vetrina di Aurora (nuova o vuota)", Lab.CartellaDellaVetrina) is { } scelta)
            _rifiuto = Lab.CambiaLaVetrina(scelta) ? null : Lab.Rifiuto;
    }

    private async Task SfogliaAurora()
    {
        if (await Lab.ScegliCartella!("La cartella di Aurora (quella con ColourSchemes e Profiles)", Lab.CartellaDiAurora) is { } scelta)
            _rifiuto = Lab.CambiaLaCartellaDiAurora(scelta) ? null : Lab.Rifiuto;
    }

    private async Task SfogliaIPdf()
    {
        if (await Lab.ScegliCartella!("La cartella dei PDF dell'AIP", Lab.CartellaDeiPdf) is { } scelta)
            _rifiuto = Lab.CambiaLaCartellaDeiPdf(scelta) ? null : Lab.Rifiuto;
    }

    private async Task SfogliaLAipEspanso()
    {
        if (await Lab.ScegliCartella!("La cartella dell'AIP espanso", Lab.CartellaDellAipEspanso) is { } scelta)
            _rifiuto = Lab.CambiaLAipEspanso(scelta) ? null : Lab.Rifiuto;
    }

    private void CambiaLaVetrina(ChangeEventArgs e)
        => _rifiuto = Lab.CambiaLaVetrina(e.Value?.ToString()) ? null : Lab.Rifiuto;

    private void CambiaIlVid(ChangeEventArgs e)
        => _rifiuto = Lab.CambiaIlVid(e.Value?.ToString()) ? null : Lab.Rifiuto;

    private void CambiaLaSoglia(ChangeEventArgs e)
        => _rifiuto = Lab.CambiaLaSogliaDelleEtichette(e.Value?.ToString()) ? null : Lab.Rifiuto;

    private string Soglia() => Lab.SogliaDelleEtichette.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string Esempio()
        => NomiDelleConfigurazioni.Scrivi(new NomeDiConfigurazione("RR", "CONF", "2.1", ""), Lab.ModelloDelleConfigurazioni);
}
