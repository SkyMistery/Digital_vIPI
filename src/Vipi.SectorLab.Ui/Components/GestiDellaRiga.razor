@inject SessioneDelLab Lab
@using Vipi.SectorLab.Core.PdfAip
@using Esiti = Vipi.SectorLab.Core.PdfAip.EsitoDelConfronto

@*
    I gesti di una riga del Confronto (riordino R7): quelli di prima (F6, F7), spostati da «Lettura e confronti» con gli
    stessi data-tasto (D7). Ogni gesto è una modifica in sospeso del sector, nel diff e da annullare come le altre; il
    confronto si rifà da sé e la riga cambia. Il tipo della riga di partenza (Riga.Origine) dice quali gesti ci sono.
*@
@switch (Riga.Origine)
{
    case DifferenzaDiForma e:
        var enr5 = Sezione == SezioneDelConfronto.AreeEnr5;
        @if (e.Dove is { } dove)
        {
            <span class="lab-nota"> · il punto peggiore: @ConfrontoDelleForme.Dms(dove)</span>
        }
        @if (ConfrontoDelleForme.DaGuardare(e))
        {
            <span class="lab-avviso-breve" data-da-guardare> · più di @ConfrontoDelleForme.ScartoDaGuardare.ToString("0", System.Globalization.CultureInfo.InvariantCulture) NM: quasi certo un errore di stampa (dell'AIP o del sector). Guarda il PDF, si corregge a mano.</span>
        }
        else if (e.Esito == Esiti.FormaDiversa && Sezione == SezioneDelConfronto.AtzDelleTorri && e.Zone > 1)
        {
            <span class="lab-nota" data-piu-zone> · @e.Zone zone nell'AIP: un settore della torre è un poligono solo, si sistema a mano.</span>
        }
        else if (enr5 && (e.Esito == Esiti.FormaDiversa || (e.Esito == Esiti.Uguale && e.Zone > 1)) && e.File is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-enr5"
                    title="@(e.Zone > 1 ? $"Divide {e.Sector} in {e.Zone} voci, una per area dell'AIP, con le forme dell'AIP" : $"Riscrive le righe di {e.Sector} con la forma dell'AIP")"
                    @onclick="() => Fai(Lab.SostituisciAreaEnr5(e))">@(e.Zone > 1 ? "Dividi" : "Sostituisci")</button>
        }
        else if (enr5 && e.Esito == Esiti.MancaNelSector && e.Aip is { } chiave)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-enr5"
                    title="Il blocco dell'area in fondo al suo file, coi lati dell'AIP" @onclick="() => PortaEnr5([chiave])">Porta nel sector</button>
        }
        else if (!enr5 && e.Esito == Esiti.FormaDiversa && e.File is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci"
                    title="Riscrive tutta la voce @e.Sector con le zone dell'AIP (la testata resta): una modifica in sospeso, nel diff e da annullare come le altre"
                    @onclick="() => Fai(Lab.SostituisciLaVoce(e))">Sostituisci</button>
        }
        else if (!enr5 && e.Esito == Esiti.MancaNelSector && e.Aip is not null && Sezione != SezioneDelConfronto.AtzDelleTorri)
        {
            <input class="lab-campo lab-campo-corto" maxlength="4" placeholder="LIxx" data-campo="scalo" value="@_scalo"
                   title="Lo scalo: la voce va nel suo .str" @onchange="v => _scalo = v.Value?.ToString()" />
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta"
                    title="Scrive la voce nuova del MAPS nello .str dello scalo: una modifica in sospeso, nel diff e da annullare come le altre"
                    @onclick="() => Fai(Lab.PortaNelSector(e, _scalo))">Porta nel sector</button>
        }
        break;

    case DifferenzaDiProcedura p:
        @if (p.Esito == Esiti.MancaNelSector)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-procedura"
                    title="Una voce nuova nello .str o nel .sid dello scalo, coi punti e le quote dell'AIP; i punti che il sector non ha, prima in APT.fix"
                    @onclick="() => Dici(Lab.PortaLaProcedura(p))">Porta nel sector</button>
        }
        else if (p.Esito == Esiti.FormaDiversa && p.File is not null)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-procedura"
                    title="Le voci del sector di questa procedura riscritte coi punti, le quote e le velocità dell'AIP (la testata resta)"
                    @onclick="() => Dici(Lab.SostituisciLaProcedura(p))">Sostituisci</button>
        }
        break;

    case DifferenzaDiEnr3 e:
        var rotte = Sezione == SezioneDelConfronto.Rotte;
        @if (rotte && e.TrattiDaScrivere > 0)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="scrivi-i-tratti"
                    title="Verso e quote dell'AIP nei tag //@@ dei tratti di @e.Nome" @onclick="() => Fai(Lab.ScriviITratti([e.Nome]))">Scrivi i tratti (@e.TrattiDaScrivere)</button>
        }
        else if (rotte && e.Esito == Esiti.MancaNelSector)
        {
            @* R8b: la rotta nelle aerovie basse (di base itawlow.lairway) o alte, con l'anteprima del blocco. *@
            @if (_mettiAperto)
            {
                <MettiInQuestoFile Rotta="@e.Nome" Titolo="@($"{e.Nome} nelle aerovie basse o alte")" Chiuso="() => _mettiAperto = false" Fatto="Fatto" />
            }
            else
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-rotta"
                        title="Sceglie il file delle aerovie (basse o alte), con l'anteprima del blocco coi punti, i tratti e le etichette dell'AIP"
                        @onclick="() => _mettiAperto = true">Porta nel sector…</button>
            }
        }
        else if (!rotte && e.Esito == Esiti.FormaDiversa)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-attesa"
                    title="Riscrive la descrizione in HOLDENR.hold con l'attesa dell'AIP" @onclick="() => Fai(Lab.SostituisciLAttesa(e))">Sostituisci</button>
        }
        else if (!rotte && e.Esito == Esiti.MancaNelSector && Lab.ProposteDelleAttese.GetValueOrDefault(e.Nome) is { } proposta)
        {
            var stato = Scelte.Stato(proposta);
            <span class="lab-scelta-attesa" data-attesa="@e.Nome">
                <input type="checkbox" data-casella="scegli-attesa" checked="@stato.Scelta" disabled="@(proposta.Punto is null)"
                       title="@(proposta.Punto is null ? "Il sector non ha il punto: non si porta" : "Da portare")"
                       @onchange="v => Scelte.Cambia(proposta, v.Value is true)" />
                <select class="lab-campo lab-campo-corto" data-campo="dove-attesa" value="@(stato.Scalo ?? "")"
                        @onchange="v => Scelte.CambiaLoScalo(proposta, v.Value?.ToString())">
                    <option value="">in rotta</option>
                    @foreach (var scalo in proposta.Scali)
                    {
                        <option value="@scalo.Icao">@scalo.Icao (@scalo.Piste)</option>
                    }
                </select>
                <select class="lab-campo lab-campo-corto" data-campo="come-attesa" value="@(stato.Ovale ? "ovale" : "scritta")"
                        @onchange="v => CambiaIlCome(proposta, v)">
                    <option value="scritta">scritta</option>
                    <option value="ovale" disabled="@(stato.Scalo is null)">ovale (@proposta.Tratto)</option>
                </select>
            </span>
        }
        break;

    case DifferenzaDiEnr4 e:
        var radioassistenze = Sezione == SezioneDelConfronto.Radioassistenze;
        @if (e.Esito == Esiti.MancaNelSector && radioassistenze)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-enr4"
                    title="La riga nuova in itvor.vor o itndb.ndb, in ordine di nome, coi valori dell'AIP"
                    @onclick="() => Dici(Lab.PortaNelSectorDiEnr4([e.Nome]))">Porta nel sector</button>
        }
        else if (e.Esito == Esiti.MancaNelSector)
        {
            @* R8a: un punto si mette nel .fix che l'AOD sceglie (di base itfix.fix), con l'anteprima; o si spunta per metterne
               più d'uno insieme dalla sezione. *@
            <input type="checkbox" data-casella="spunta-punto" title="Da mettere insieme agli altri spuntati (in cima alla sezione)"
                   checked="@Scelte.PuntiSpuntati.Contains(e.Nome)" @onchange="v => Spunta(e.Nome, v.Value is true)" />
            @if (_mettiAperto)
            {
                <MettiInQuestoFile Nomi="[e.Nome]" Titolo="@($"{e.Nome} in un file dei punti")" Chiuso="() => _mettiAperto = false" Fatto="Fatto" />
            }
            else
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-enr4"
                        title="Sceglie il file dei punti (.fix) e il posto, con l'anteprima della riga" @onclick="() => _mettiAperto = true">Porta nel sector…</button>
            }
        }
        else if (e.UsoDiverso)
        {
            <span class="lab-nota" data-uso-diverso>uso diverso</span>
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="correggi-uso"
                    title="L'uso (4° campo) e il FRA (5°) di itfix.fix come li dà l'AIP" @onclick="() => Fai(Lab.CorreggiLUso([e.Nome]))">Correggi l'uso</button>
        }
        else if (radioassistenze && e.Esito == Esiti.FormaDiversa)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-enr4"
                    title="Riscrive la riga del sector coi valori dell'AIP che sono diversi (frequenza, posizione, canale); il resto resta"
                    @onclick="() => Fai(Lab.SostituisciLaRadioassistenza(e))">Sostituisci</button>
        }
        break;

    case ConfineDellAip c:
        @* R9: il tracciato di itgeo.geo nell'AIP espanso, come correzione dell'area. *@
        @if (c.Esito == Esiti.SoloNelSector && c.Tracciabile)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-confine" disabled="@Lab.StaCorreggendoLAip"
                    title="Scrive nell'AIP espanso una correzione di @c.Chiave coi tratti di confine e di costa presi da itgeo.geo (nel file delle correzioni; si ritira dalla scheda dell'area)"
                    @onclick="() => PortaIConfini([c.Chiave])">Porta nell'AIP espanso</button>
        }
        break;

    case DifferenzaDiAd2 e:
        @if (Sezione is SezioneDelConfronto.Scali or SezioneDelConfronto.Piste && e.Esito == Esiti.FormaDiversa)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-ad2"
                    title="Riscrive questa riga del sector coi valori dell'AIP che sono diversi; il resto resta. Solo in questo file"
                    @onclick="() => Fai(Lab.SostituisciInAd2(e))">Sostituisci</button>
            @* R8c: la stessa voce diversa anche nelle copie delle FIR, in un gesto. *@
            @if (Lab.CopieDiversaInAd2(e).Count is var copie and > 1)
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-ovunque-ad2"
                        title="Riscrive la voce coi valori dell'AIP in tutti i file dove è diversa (quello di tutta Italia e le copie delle FIR): un gesto solo"
                        @onclick="() => Fai(Lab.SostituisciOvunqueInAd2(e))">Sostituisci in tutti i file (@copie)</button>
            }
        }
        else if (Sezione is SezioneDelConfronto.Scali or SezioneDelConfronto.Piste && e.Esito == Esiti.MancaNelSector)
        {
            @* R8c: uno scalo o una pista nuovi in itap.ap / itrw.rw e, a scelta, nelle copie delle FIR. *@
            var piste = Sezione == SezioneDelConfronto.Piste;
            @if (_mettiAperto)
            {
                <MettiInQuestoFile Ad2="e" Piste="piste" Titolo="@($"{e.Nome} nei file {(piste ? "delle piste" : "degli scali")}")" Chiuso="() => _mettiAperto = false" Fatto="Fatto" />
            }
            else
            {
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="@(piste ? "porta-pista" : "porta-scalo")"
                        title="@(piste ? "La riga nuova della pista, con le due testate dell'AIP" : "La riga nuova dello scalo, coi valori dell'AIP"): sceglie i file (quello di tutta Italia e le copie delle FIR), con l'anteprima"
                        @onclick="() => _mettiAperto = true">Porta nel sector…</button>
            }
        }
        else if (Sezione == SezioneDelConfronto.RadioassistenzeAd2 && e.Esito == Esiti.FormaDiversa)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="sostituisci-radioassistenza-ad2"
                    title="Riscrive la riga del sector coi valori di AD 2.19 che sono diversi (frequenza, posizione, canale); il resto resta"
                    @onclick="() => Fai(Lab.SostituisciLaRadioassistenzaDiAd2(e))">Sostituisci</button>
        }
        else if (Sezione == SezioneDelConfronto.RadioassistenzeAd2 && e.Esito == Esiti.MancaNelSector)
        {
            <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="porta-radioassistenza-ad2"
                    title="La riga nuova in itvor.vor o itndb.ndb, in ordine di nome, coi valori di AD 2.19"
                    @onclick="() => Fai(Lab.PortaLeRadioassistenzeDiAd2([e.Nome]))">Porta nel sector</button>
        }
        break;
}

@code {
    [Parameter, EditorRequired] public SezioneDelConfronto Sezione { get; set; }

    [Parameter, EditorRequired] public RigaDelConfronto Riga { get; set; } = default!;

    /// <summary>Le attese scelte da portare: le tiene la pagina, la sezione le porta.</summary>
    [Parameter, EditorRequired] public ScelteDelConfronto Scelte { get; set; } = default!;

    /// <summary>Com'è andato un gesto: null se è andato, se no il perché.</summary>
    [Parameter] public EventCallback<string?> Fatto { get; set; }

    private string? _scalo;

    // R8a, R8b, R8c: il riquadro «metti in questo file» di un punto, di una rotta, di uno scalo o di una pista.
    private bool _mettiAperto;

    /// <summary>Una spunta è cambiata: la pagina si ridisegna, e la sezione conta gli spuntati («Metti le spuntate»).</summary>
    [Parameter] public EventCallback Spuntato { get; set; }

    private Task Spunta(string nome, bool spuntato)
    {
        if (spuntato)
            Scelte.PuntiSpuntati.Add(nome);
        else
            Scelte.PuntiSpuntati.Remove(nome);
        return Spuntato.InvokeAsync();
    }

    private Task Fai(bool riuscito) => Fatto.InvokeAsync(riuscito ? null : Lab.Rifiuto);

    // Procedure, punti e aree dicono qualcosa anche quando vanno (le voci saltate): come prima, il messaggio si mostra sempre.
    private Task Dici(bool _) => Fatto.InvokeAsync(Lab.Rifiuto);

    private void CambiaIlCome(PropostaDiAttesa proposta, ChangeEventArgs v) =>
        Scelte.CambiaIlCome(proposta, string.Equals(v.Value?.ToString(), "ovale", StringComparison.Ordinal));

    private Task PortaEnr5(IReadOnlyList<string> chiavi) => Dici(Lab.PortaAreeEnr5(chiavi));

    private async Task PortaIConfini(IReadOnlyList<string> chiavi) => await Fai(await Lab.PortaIConfiniNellAipAsync(chiavi));
}
