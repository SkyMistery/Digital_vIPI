@implements IDisposable
@inject SessioneDelLab Lab

@*
    Sfoglia, Scali o Problemi, con le loro linguette (slice 5, 10 e 12d). Sta nella finestra principale o, coi due schermi,
    in quella dei pannelli: lo stesso componente, così le due non si separano. Si iscrive da sé a Cambiata (vedi Mappa.razor).
*@
<aside class="lab-colonna lab-colonna-sfoglia">
    <nav class="lab-linguette" role="tablist">
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Sfoglia)" class="@(_linguetta == Linguetta.Sfoglia ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Sfoglia" data-linguetta="sfoglia">Sfoglia</button>
        @* Slice 12d (I6): la vista per scalo, in una linguetta sua. *@
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Scali)" class="@(_linguetta == Linguetta.Scali ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Scali" data-linguetta="scali"
                title="Tutto quello che riguarda uno scalo, da qualunque file">Scali</button>
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Problemi)" class="@(_linguetta == Linguetta.Problemi ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Problemi" data-linguetta="problemi">
            Problemi
            @if (Lab.StaValidando)
            {
                <span class="lab-nota">…</span>
            }
            else
            {
                <span class="lab-nota">@Errori · @Avvisi</span>
            }
            @if (Lab.ProblemiDelleModifiche.Count > 0 || Lab.RecordCheSiFondono.Count > 0)
            {
                <span class="lab-segno-nuovi" title="Le modifiche in sospeso introducono dei problemi" data-segno="nuovi">!</span>
            }
        </button>
    </nav>
    @if (_linguetta == Linguetta.Problemi)
    {
        <PannelloDeiProblemi />
    }
    else if (_linguetta == Linguetta.Scali)
    {
        <ScaliVista OnApriUnFile="_ => _linguetta = Linguetta.Sfoglia" />
    }
    else
    {
        <Sfoglia />
    }
</aside>

@code {
    private enum Linguetta
    {
        Sfoglia,
        Scali,
        Problemi,
    }

    /// <summary>Che cosa mostra la colonna: l'albero (slice 5), la vista per scalo (12d) o i problemi (10).</summary>
    private Linguetta _linguetta;

    private int Errori => Lab.ProblemiDellAlbero.Count(p => p.Gravita == Gravita.Errore);

    private int Avvisi => Lab.ProblemiDellAlbero.Count - Errori;

    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
