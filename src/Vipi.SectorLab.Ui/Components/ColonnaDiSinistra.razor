@implements IDisposable
@inject SessioneDelLab Lab

@*
    Sfoglia, Scali o Problemi, con le loro linguette (slice 5, 10 e 12d). Sta nella finestra principale o, coi due schermi,
    in quella dei pannelli: lo stesso componente, così le due non si separano. Si iscrive da sé a Cambiata (vedi Mappa.razor).
*@
<aside class="lab-colonna lab-colonna-sfoglia">
    @* Il fuoco (carta «Lavorare su uno scalo», R1, D1): finché c'è, lo dice in testa, con l'uscita. *@
    @if (Lab.Fuoco is { } fuoco)
    {
        <div class="lab-fuoco" data-fuoco="@fuoco">
            <p class="lab-fuoco-titolo">
                <span title="Lavori su questo scalo: la mappa mostra solo i suoi file">◎ @fuoco <span class="lab-nota">@NomeDelloScalo(fuoco)</span></span>
                <button type="button" class="lab-annulla" data-tasto="inquadra-il-fuoco" @onclick="Lab.InquadraIlFuoco"
                        title="Riporta la mappa sullo scalo intero">⌖ Lo scalo</button>
                <button type="button" class="lab-annulla" data-tasto="esci-dal-fuoco" @onclick="Lab.EsciDalFuoco"
                        title="Torna al sector intero">esci</button>
            </p>
            <label class="lab-strato">
                <input type="checkbox" checked="@Lab.RestoInGrigio" data-tasto="resto-in-grigio"
                       @onchange="e => Lab.MostraIlRestoInGrigio(e.Value is true)" />
                <span>il resto del sector in grigio</span>
            </label>
        </div>
    }
    <nav class="lab-linguette" role="tablist">
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Sfoglia)" class="@(_linguetta == Linguetta.Sfoglia ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Sfoglia" data-linguetta="sfoglia">Sfoglia</button>
        @* Slice 12d (I6): la vista per scalo, in una linguetta sua. *@
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Scali)" class="@(_linguetta == Linguetta.Scali ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Scali" data-linguetta="scali"
                title="Tutto quello che riguarda uno scalo, da qualunque file">Scali</button>
        <button role="tab" aria-selected="@(_linguetta == Linguetta.Problemi)" class="@(_linguetta == Linguetta.Problemi ? "lab-linguetta-scelta" : null)"
                @onclick="() => _linguetta = Linguetta.Problemi" data-linguetta="problemi">
            Problemi
            @if (Lab.StaValidando)
            {
                <span class="lab-nota">…</span>
            }
            else
            {
                <span class="lab-nota">@Errori · @Avvisi</span>
            }
            @if (Lab.ProblemiDelleModifiche.Count > 0 || Lab.RecordCheSiFondono.Count > 0)
            {
                <span class="lab-segno-nuovi" title="Le modifiche in sospeso introducono dei problemi" data-segno="nuovi">!</span>
            }
        </button>
    </nav>
    @if (_linguetta == Linguetta.Problemi)
    {
        <PannelloDeiProblemi />
    }
    else if (_linguetta == Linguetta.Scali)
    {
        <ScaliVista OnApriUnFile="_ => _linguetta = Linguetta.Sfoglia" />
    }
    else
    {
        <Sfoglia />
    }
</aside>

@code {
    private enum Linguetta
    {
        Sfoglia,
        Scali,
        Problemi,
    }

    /// <summary>Che cosa mostra la colonna: l'albero (slice 5), la vista per scalo (12d) o i problemi (10).</summary>
    private Linguetta _linguetta;

    private string NomeDelloScalo(string icao) => Lab.ScaliDellaVista().FirstOrDefault(s => s.Icao == icao)?.Nome ?? "";

    private int Errori => Lab.ProblemiDellAlbero.Count(p => p.Gravita == Gravita.Errore);

    private int Avvisi => Lab.ProblemiDellAlbero.Count - Errori;

    protected override void OnInitialized()
    {
        // Il fuoco (R3): si lavora sullo scalo, e la colonna parte dal suo elenco.
        if (Lab.Fuoco is not null)
            _linguetta = Linguetta.Scali;
        _sceltaVista = Lab.Scelta;
        SeguiLaBarra();
        Lab.Cambiata += Aggiorna;
    }

    private (string File, int Record)? _sceltaVista;

    /// <summary>
    /// R3: col fuoco, una scelta nuova in un file dello scalo (dalla mappa, dalla ricerca) porta la colonna sullo scalo, dove
    /// il file si apre coi suoi record. Solo a una scelta nuova: chi passa a Sfoglia da sé ci resta.
    /// </summary>
    private void SeguiIlFuoco()
    {
        if (Lab.Scelta == _sceltaVista)
            return;
        _sceltaVista = Lab.Scelta;
        if (Lab.Fuoco is not null && Lab.Scelta is { } scelta && Lab.EDelFuoco(scelta.File))
        {
            if (Lab.ScaloScelto != Lab.Fuoco)
                Lab.ScegliLoScalo(Lab.Fuoco);
            _linguetta = Linguetta.Scali;
        }
    }

    /// <summary>Riordino R1: il tasto «errori · avvisi» della barra porta qui, sulla linguetta dei Problemi.</summary>
    private void SeguiLaBarra()
    {
        if (Lab.PrendiLaRichiestaDeiProblemi())
            _linguetta = Linguetta.Problemi;
    }

    private void Aggiorna() => InvokeAsync(() =>
    {
        SeguiLaBarra();
        SeguiIlFuoco();
        StateHasChanged();
    });

    public void Dispose() => Lab.Cambiata -= Aggiorna;
}
