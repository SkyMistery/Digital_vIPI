@implements IDisposable
@inject SessioneDelLab Lab

@*
    Il pannello delle modifiche in sospeso (carta F3 §2.2 passo 6, slice 6): quante sono, in quanti file, e il
    DIFF VERO di ogni file — quello che lo scrittore produrrebbe, non una simulazione. Dalla slice 9 si SALVA da qui
    (carta §2.4): il pannello dice com'è andata, chiede conferma se le modifiche portano errori nuovi, e davanti a un
    file cambiato sul disco offre di ricaricarlo.
*@
@if (Lab.Modifiche.CEQualcosa || Lab.UltimoSalvataggio is not null || Lab.ModifichePerse.Count > 0)
{
    <div class="lab-modifiche" data-modifiche="@Lab.Modifiche.Quante">
        @if (Lab.Modifiche.CEQualcosa)
        {
            <header>
                <h2>@Lab.Modifiche.Quante modifiche in @Lab.Modifiche.FileToccati.Count file</h2>
                <button class="lab-tasto" @onclick="() => Lab.SalvaAsync()" disabled="@Lab.StaSalvando"
                        title="@(Lab.StaSalvando ? "Salvataggio in corso" : "Scrive i file nel clone, dopo averne fatto il backup")"
                        data-tasto="salva">@(Lab.StaSalvando ? "Salvo…" : "Salva")</button>
                <button class="lab-tasto lab-tasto-tenue" @onclick="() => Lab.AnnullaTutte()" disabled="@Lab.StaSalvando"
                        title="@(Lab.StaSalvando ? "Salvataggio in corso" : null)"
                        data-tasto="annulla-tutto">Annulla tutto</button>
            </header>
        }

        @if (Lab.UltimoSalvataggio is { } esito)
        {
            <EsitoDelSalvataggioVista Esito="esito" />
        }

        @foreach (string file in Lab.Modifiche.FileToccati)
        {
            var diff = Lab.DiffDi(file);
            <details class="lab-file-toccato" open data-diff="@file">
                <summary>
                    @file[(file.LastIndexOf('/') + 1)..]
                    <span class="lab-nota">−@diff.Tolte +@diff.Aggiunte</span>
                </summary>

                @foreach (var modifica in Lab.Modifiche.Tutte.Where(m => m.File == file).OrderBy(m => m.Record))
                {
                    var copie = Lab.Modifiche.CopieDi(modifica);
                    <div class="lab-una-modifica" data-modifica="@modifica.Campo" data-copia="@(Lab.Modifiche.Principale(modifica) is null ? null : "si")">
                        <span class="lab-etichetta">@(modifica.Etichetta is { Length: > 0 } e ? e : $"record {modifica.Record}")</span>
                        <span class="lab-nota">@modifica.Descrizione@(copie.Count > 0 ? ", anche in " + string.Join(", ", copie.Select(c => NomeDelFile(c.File))) : "")</span>
                        @* Sulla riga di una copia gemella, «annulla» toglie la voce intera: la copia va con la sua principale. *@
                        <button class="lab-annulla" @onclick="() => Lab.AnnullaModifica(modifica)" data-annulla="@modifica.Campo">annulla</button>
                    </div>
                    @if (modifica is ModificaDiCampo { NonToccate.Count: > 0 } campo)
                    {
                        @foreach (var lasciata in campo.NonToccate)
                        {
                            <div class="lab-una-modifica lab-copia-lasciata" data-lasciata="@lasciata.File">
                                <span class="lab-nota">@lasciata.Descrizione</span>
                                <button class="lab-annulla" @onclick="() => Lab.AllineaLaCopia(campo, lasciata)"
                                        title="Porta @campo.Dopo anche qui" data-allinea="@lasciata.File">allinea anche questo</button>
                            </div>
                        }
                    }
                }

                @if (diff.InBlocco)
                {
                    @* Non dovrebbe succedere con una modifica di campo: se succede, è cambiato altro. *@
                    <p class="lab-errore">Il file è cambiato troppo perché il confronto riga per riga abbia senso.</p>
                }
                <RigheDelDiff Diff="diff" />
            </details>
        }

        @foreach (var (file, diff) in Lab.ModifichePerse)
        {
            @* Le modifiche lasciate ricaricando un file cambiato sul disco: da rifare a mano, se servono ancora. *@
            <details class="lab-file-toccato lab-perse" data-perse="@file">
                <summary>
                    @file[(file.LastIndexOf('/') + 1)..] — modifiche perse ricaricando dal disco
                    <span class="lab-nota">−@diff.Tolte +@diff.Aggiunte</span>
                </summary>
                <RigheDelDiff Diff="diff" />
            </details>
        }
    </div>
}

@code {
    protected override void OnInitialized() => Lab.Cambiata += Aggiorna;

    private void Aggiorna() => InvokeAsync(StateHasChanged);

    public void Dispose() => Lab.Cambiata -= Aggiorna;

    private static string NomeDelFile(string relativo) => relativo[(relativo.LastIndexOf('/') + 1)..];
}
