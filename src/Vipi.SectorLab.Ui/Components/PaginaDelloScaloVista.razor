@inject SessioneDelLab Lab
@using Vipi.SectorLab.Core.PdfAip

@*
    La pagina dello scalo (carta «Gli aeroporti nel Lab», S1; committente, 27 ottobre: «un visualizzatore funzionale e
    completo, soprattutto lato aeroporti»): lo scalo scelto nell'Indice o sulla mappa, al posto della scheda. In testa i dati
    dello scalo e i gesti; sotto cinque schede — le piste coi due lati, le procedure per pista e per genere, le carte di
    AD 2.24 con quel che il Lab ne legge, frequenze e radioassistenze, il testo di AD 2.1-2.25.
    S2: gli avvicinamenti per carta («ILS (Cat.II) or LOC X RWY 16L»), con lo stato; una carta si apre al posto delle schede,
    con le sue parti (le voci di prima, una per segmento stampato) e «Apri il PDF».
    §2 D, controlli 1 e 2: la scheda Ground, le soglie dei .rw contro AD 2.12 in metri e le taxiway dei .txi contro AD 2.8.
*@
@if (Pagina is { } p)
{
    var s = p.Scalo;
    var (lette, tutte) = p.CarteIap;
    var cartaAperta = CartaAperta;
    <div class="lab-ispettore lab-pagina-scalo" data-pagina-scalo="@s.Icao">
        <header>
            <p class="lab-etichetta">@s.Icao · @s.Name</p>
            <p class="lab-nota" data-testata-scalo>@Testata(s)</p>
            <p class="lab-gesti-record">
                @if (s.Page is { } pagina && Ciclo is { } ciclo)
                {
                    <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="apri-pagina-scalo" title="Apre il PDF alla pagina dello scalo (@pagina.Reference)"
                            @onclick="() => Apri(ciclo, pagina.Reference)">Apri il PDF</button>
                }
                <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="solo-lo-scalo"
                        title="Sulla mappa le coste e le @p.Voci.Count voci dello scalo: il resto si riaccende dagli Strati o dall'Indice"
                        @onclick="() => Lab.MostraSoloLeVociDellAip(p.Voci)">Solo lo scalo sulla mappa</button>
            </p>
        </header>
        <nav class="lab-schede-scalo" data-schede-scalo>
            @foreach (var (scheda, nome) in Schede(p))
            {
                <button type="button" class="lab-chip @(cartaAperta is null && FoglioAperto is null && SchedaAperta == scheda ? "lab-scelto" : null)" data-scheda-scalo="@scheda" @onclick="() => SchedaAperta = scheda">@nome</button>
            }
        </nav>
        @if (cartaAperta is { } carta)
        {
            var parti = carta.Parti.Select(x => x.Procedura.Indice).ToList();
            var tutteAccese = parti.Count > 0 && Lab.QuanteVociDellAipAccese(parti) == parti.Count;
            <section class="lab-carta-iap" data-carta-iap="@carta.Carta.Page">
                <button type="button" class="lab-voce lab-torna-allo-scalo" data-chiudi-carta @onclick="ChiudiLaCarta">‹ @s.Icao · @(SchedaAperta == Scheda.Carte ? "Carte" : "Procedure")</button>
                <h3 class="lab-pista-nome">@carta.Titolo</h3>
                <p class="lab-nota @Classe(carta)" data-stato-carta="@carta.Stato">@carta.StatoInParole</p>
                <dl class="lab-campi-aip">
                    @foreach (var (nome, foglio) in carta.Tabelle.Select(t => ("Tabelle", t)).Prepend(("Carta", carta.Carta)))
                    {
                        <dt>@nome</dt>
                        <dd>
                            @if (Ciclo is { } cicloDelFoglio)
                            {
                                <button type="button" class="lab-voce" data-apri-foglio="@foglio.Page" title="Apre il PDF a questa pagina" @onclick="() => Apri(cicloDelFoglio, foglio.Page)">@foglio.Page</button>
                            }
                            else
                            {
                                @foglio.Page
                            }
                            @(foglio.Effective is { } data ? " · " + data.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : "")
                        </dd>
                    }
                    @if (carta.Piste.Count > 0)
                    {
                        <dt>Piste</dt>
                        <dd>@string.Join(", ", carta.Piste)</dd>
                    }
                </dl>
                @if (carta.Parti.Count == 0)
                {
                    <p class="lab-nota" data-carta-solo-immagine>Solo immagine: la carta è un disegno e le sue pagine non hanno tabelle che il Lab legga.
                        Si guarda nel PDF, o posata sulla mappa (qui sotto).</p>
                }
                else
                {
                    <p class="lab-gesti-record">
                        <button type="button" class="lab-tasto lab-tasto-tenue" data-tasto="accendi-carta"
                                @onclick="() => Lab.AccendiLeVociDellAip(parti, !tutteAccese)">@(tutteAccese ? "Spegni le parti sulla mappa" : "Accendi le parti sulla mappa")</button>
                    </p>
                    @foreach (var parte in carta.Parti)
                    {
                        <p class="lab-procedura-scalo" data-parte-carta="@parte.Procedura.Indice">
                            <input type="checkbox" class="lab-indice-accesa" checked="@(Lab.QuanteVociDellAipAccese([parte.Procedura.Indice]) == 1)"
                                   title="Accende o spegne questa parte sulla mappa"
                                   @onchange="e => Lab.AccendiLeVociDellAip([parte.Procedura.Indice], e.Value is true)" />
                            <button type="button" class="lab-voce @(Lab.SceltaDellAip == parte.Procedura.Indice ? "lab-scelto" : null)" data-voce-aip="@parte.Procedura.Indice"
                                    title="@parte.Procedura.Titolo" @onclick="() => Scegli(parte.Procedura.Indice)">@parte.Nome</button>
                            <span class="lab-nota @(!parte.Tabella && (parte.Procedura.Tratti < 2 || parte.Procedura.NonTrovati > 0) ? "lab-stato-parziale" : null)">@(parte.Tabella ? "tabella" : parte.Procedura.Stato)@(parte.Procedura.ConSegnalazione ? " · segnalazione" : "")</span>
                        </p>
                    }
                }
                <PosaDellaCartaVista Icao="@s.Icao" Carta="carta.Carta" />
            </section>
        }
        else if (FoglioAperto is { } foglioAperto)
        {
            @* S3: una carta che non è di avvicinamento (la carta d'aerodromo, i parcheggi…), aperta dalla scheda Carte per posarla. *@
            <section class="lab-carta-iap" data-foglio="@foglioAperto.Page">
                <button type="button" class="lab-voce lab-torna-allo-scalo" data-chiudi-carta @onclick="ChiudiLaCarta">‹ @s.Icao · Carte</button>
                <h3 class="lab-pista-nome">@foglioAperto.Title</h3>
                <dl class="lab-campi-aip">
                    <dt>Carta</dt>
                    <dd>
                        @if (Ciclo is { } cicloDelFoglio)
                        {
                            <button type="button" class="lab-voce" data-apri-foglio="@foglioAperto.Page" title="Apre il PDF a questa pagina" @onclick="() => Apri(cicloDelFoglio, foglioAperto.Page)">@foglioAperto.Page</button>
                        }
                        else
                        {
                            @foglioAperto.Page
                        }
                        @(foglioAperto.Effective is { } data ? " · " + data.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture) : "")
                    </dd>
                </dl>
                <PosaDellaCartaVista Icao="@s.Icao" Carta="foglioAperto" />
            </section>
        }
        else
        {
        switch (SchedaAperta)
        {
            case Scheda.Piste:
                @if (p.Piste.Count == 0)
                {
                    <p class="lab-nota">AD 2.12 non ha piste lette per @s.Icao.</p>
                }
                @foreach (var pista in p.Piste)
                {
                    var prima = pista.Lati[0].Pista;
                    <section class="lab-pista" data-pista="@pista.Nome">
                        <h3 class="lab-pista-nome">@pista.Nome <span class="lab-nota">@(prima.Dimensions is { } dim ? dim + " m" : "") @(prima.Surface is { } f ? "· " + f : "")</span></h3>
                        @foreach (var lato in pista.Lati)
                        {
                            var r = lato.Pista;
                            <dl class="lab-campi-aip" data-lato="@r.Designator">
                                <dt>RWY @r.Designator</dt>
                                <dd>@(r.TrueBearing is { } b ? $"rotta vera {b}" : "")@(r.ThresholdElevation is { } e ? $" · soglia {e}" : "")</dd>
                                @if (r.Threshold is { } soglia)
                                {
                                    <dt>Soglia</dt>
                                    <dd>@Coordinate(soglia)</dd>
                                }
                                @foreach (var d in lato.Distanze)
                                {
                                    <dt>@(d.Intersection ?? "Distanze")</dt>
                                    <dd>TORA @d.Tora · TODA @d.Toda · ASDA @d.Asda · LDA @d.Lda</dd>
                                }
                                @foreach (var ils in lato.Ils)
                                {
                                    <dt>ILS</dt>
                                    <dd>@ils.Designator @ils.Category@(ils.Slope is { } gp ? $" · GP {gp}" : "")@(ils.Components.FirstOrDefault(c => c.Frequency is not null) is { } loc ? $" · {loc.Frequency}" : "")</dd>
                                }
                                @if (Procedure(p, r.Designator) is { Length: > 0 } quante)
                                {
                                    <dt>Procedure</dt>
                                    <dd>@quante</dd>
                                }
                            </dl>
                        }
                    </section>
                }
                break;

            case Scheda.Procedure:
                @if (p.Procedure.Count == 0 && p.Avvicinamenti.Count == 0)
                {
                    <p class="lab-nota">Nessuna procedura letta per @s.Icao.</p>
                }
                @foreach (var pista in p.PisteDelleProcedure)
                {
                    var carteDellaPista = p.AvvicinamentiDi(pista).ToList();
                    var sciolte = p.Procedure.FirstOrDefault(g => g.Pista == pista && g.Genere == AipSullaMappa.Avvicinamenti);
                    <section class="lab-pista" data-procedure-pista="@pista">
                        <h3 class="lab-pista-nome">@(pista.Length == 0 ? "Senza pista" : "RWY " + pista)</h3>
                        @foreach (var gruppo in p.Procedure.Where(g => g.Pista == pista && g.Genere != AipSullaMappa.Avvicinamenti))
                        {
                            var indici = gruppo.Procedure.Select(x => x.Indice).ToList();
                            var accese = Lab.QuanteVociDellAipAccese(indici);
                            var segnalate = gruppo.Procedure.Count(x => x.ConSegnalazione);
                            <details class="lab-indice-gruppo" open="@gruppo.Procedure.Any(x => x.Indice == Lab.SceltaDellAip)" data-gruppo-scalo="@($"{pista}/{gruppo.Genere}")">
                                <summary>
                                    <input type="checkbox" class="lab-indice-accesa" checked="@(accese == indici.Count)" data-accendi-gruppo-scalo="@($"{pista}/{gruppo.Genere}")"
                                           title="@(accese == indici.Count ? "Tutte accese sulla mappa: spegnile" : $"{accese} su {indici.Count} accese sulla mappa: accendile")"
                                           @onchange="e => Lab.AccendiLeVociDellAip(indici, e.Value is true)" />
                                    <span class="lab-indice-codice">@gruppo.Genere</span>
                                    <span class="lab-nota">@gruppo.Procedure.Count@(segnalate > 0 ? $" · {segnalate} con segnalazione" : "")</span>
                                </summary>
                                @foreach (var proc in gruppo.Procedure)
                                {
                                    @Riga(proc)
                                }
                            </details>
                        }
                        @if (carteDellaPista.Count > 0 || sciolte is not null)
                        {
                            // S2: gli avvicinamenti per carta; sotto, quelli che non stanno sulle pagine di una carta.
                            var indici = carteDellaPista.SelectMany(c => c.Parti).Select(x => x.Procedura.Indice)
                                .Concat(sciolte?.Procedure.Select(x => x.Indice) ?? []).Distinct().ToList();
                            var accese = Lab.QuanteVociDellAipAccese(indici);
                            var conParti = carteDellaPista.Count(c => c.Parti.Count > 0);
                            <details class="lab-indice-gruppo" open data-gruppo-scalo="@($"{pista}/{AipSullaMappa.Avvicinamenti}")">
                                <summary>
                                    @if (indici.Count > 0)
                                    {
                                        <input type="checkbox" class="lab-indice-accesa" checked="@(accese == indici.Count)" data-accendi-gruppo-scalo="@($"{pista}/{AipSullaMappa.Avvicinamenti}")"
                                               title="@(accese == indici.Count ? "Tutte le parti accese sulla mappa: spegnile" : $"{accese} su {indici.Count} parti accese sulla mappa: accendile")"
                                               @onchange="e => Lab.AccendiLeVociDellAip(indici, e.Value is true)" />
                                    }
                                    <span class="lab-indice-codice">@AipSullaMappa.Avvicinamenti</span>
                                    <span class="lab-nota">@(carteDellaPista.Count == 1 ? "1 carta" : $"{carteDellaPista.Count} carte") · @conParti con parti@(sciolte is null ? "" : $" · {sciolte.Procedure.Count} fuori dalle carte")</span>
                                </summary>
                                @foreach (var cartaDellaPista in carteDellaPista)
                                {
                                    var partiDellaCarta = cartaDellaPista.Parti.Select(x => x.Procedura.Indice).ToList();
                                    <p class="lab-procedura-scalo" data-carta-iap-riga="@cartaDellaPista.Carta.Page">
                                        @if (partiDellaCarta.Count > 0)
                                        {
                                            <input type="checkbox" class="lab-indice-accesa" checked="@(Lab.QuanteVociDellAipAccese(partiDellaCarta) == partiDellaCarta.Count)"
                                                   title="Accende o spegne le parti di questa carta sulla mappa"
                                                   @onchange="e => Lab.AccendiLeVociDellAip(partiDellaCarta, e.Value is true)" />
                                        }
                                        <button type="button" class="lab-voce" data-apri-carta="@cartaDellaPista.Carta.Page" title="@cartaDellaPista.Carta.Title · @cartaDellaPista.Carta.Page"
                                                @onclick="() => ApriLaCarta(cartaDellaPista)">@cartaDellaPista.Titolo</button>
                                        <span class="lab-nota @Classe(cartaDellaPista)">@cartaDellaPista.StatoInParole</span>
                                    </p>
                                }
                                @if (sciolte is not null)
                                {
                                    <p class="lab-nota">Fuori dalle carte di AD 2.24:</p>
                                    @foreach (var proc in sciolte.Procedure)
                                    {
                                        @Riga(proc)
                                    }
                                }
                            </details>
                        }
                    </section>
                }
                break;

            case Scheda.Carte:
                <p class="lab-nota">Le carte di AD 2.24. Le carte di avvicinamento sono disegni: il Lab ne legge le tabelle (DESCRIPTION TABLES, FIX/POINT).
                    Di @tutte carte di avvicinamento, @lette danno delle parti (con le loro DESCRIPTION TABLES).</p>
                <table class="lab-tabella-da-dove lab-carte-scalo">
                    <thead><tr><th>Carta</th><th>Pagina</th><th>Data</th><th>Il Lab</th><th>Sulla mappa</th></tr></thead>
                    <tbody>
                        @foreach (var c in p.Carte)
                        {
                            var posata = Lab.PoseDi(s.Icao).Any(x => x.Pagina == c.Carta.Page);
                            <tr data-carta="@c.Carta.Page" data-carta-avvicinamento="@(c.Avvicinamento ? "si" : "no")">
                                <td>@c.Carta.Title</td>
                                <td>
                                    @if (Ciclo is { } cicloDellaCarta)
                                    {
                                        <button type="button" class="lab-voce" title="Apre il PDF a questa pagina" @onclick="() => Apri(cicloDellaCarta, c.Carta.Page)">@c.Carta.Page</button>
                                    }
                                </td>
                                <td>@(c.Carta.Effective?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))</td>
                                <td>
                                    @if (c.Iap is { } iap)
                                    {
                                        @* S2: la carta di avvicinamento col suo stato; le sue DESCRIPTION TABLES rimandano a lei. *@
                                        <button type="button" class="lab-voce @Classe(iap)" data-apri-carta="@iap.Carta.Page" @onclick="() => ApriLaCarta(iap)">
                                            @(ReferenceEquals(iap.Carta, c.Carta) ? iap.StatoInParole : $"tabelle di {iap.Carta.Page}")
                                        </button>
                                    }
                                    else if (c.Procedure > 0)
                                    {
                                        @($"letta · {c.Procedure} {(c.Procedure == 1 ? "procedura" : "procedure")}")
                                    }
                                </td>
                                <td>
                                    @* S3: si posa la carta (la prima pagina); le DESCRIPTION TABLES no, sono tabelle della loro carta. *@
                                    @if (c.Iap is { } suaCarta && ReferenceEquals(suaCarta.Carta, c.Carta))
                                    {
                                        <button type="button" class="lab-voce" data-posa-dalla-tabella="@c.Carta.Page" @onclick="() => ApriLaCarta(suaCarta)">@(posata ? "posata" : "posa…")</button>
                                    }
                                    else if (c.Iap is null)
                                    {
                                        <button type="button" class="lab-voce" data-posa-dalla-tabella="@c.Carta.Page" @onclick="() => ApriIlFoglio(c.Carta)">@(posata ? "posata" : "posa…")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;

            case Scheda.Frequenze:
                <dl class="lab-campi-aip" data-frequenze-scalo>
                    @foreach (var f in s.Communications)
                    {
                        <dt>@f.Service</dt>
                        <dd>@f.Frequency@(f.CallSign is { } cs ? $" · {cs}" : "")@(f.Hours is { } h ? $" · {h}" : "")</dd>
                    }
                </dl>
                @if (s.NavigationAids.Count > 0)
                {
                    <h3 class="lab-pista-nome">Radioassistenze (AD 2.19)</h3>
                    <dl class="lab-campi-aip" data-radioassistenze-scalo>
                        @foreach (var n in s.NavigationAids)
                        {
                            <dt>@n.Designator</dt>
                            <dd>@n.Type@(n.Frequency is { } fr ? $" · {fr}" : "")@(n.Channel is { } ch ? $" · {ch}" : "") · @Coordinate(n.Position)</dd>
                        }
                    </dl>
                }
                break;

            case Scheda.Ground:
                @* §2 D, controlli 1 e 2: dal testo, in sola lettura, sul sector aperto. *@
                @if (Lab.ControlliDelGround(s) is not { } g)
                {
                    <p class="lab-nota" data-ground-senza-sector>Apri un sector: i controlli del ground confrontano AD 2 con il sector aperto.</p>
                }
                else
                {
                    <section class="lab-pista" data-ground-soglie>
                        <h3 class="lab-pista-nome">Soglie <span class="lab-nota">AD 2.12 contro i .rw</span></h3>
                        @if (g.Soglie.Count == 0)
                        {
                            <p class="lab-nota">Nessun .rw ha piste per @s.Icao.</p>
                        }
                        else
                        {
                            <p class="lab-nota">Oltre @ConfrontoDiAd2.SogliaDellaSogliaM m la soglia è diversa. Si corregge con «Sostituisci» nel confronto di AD 2 (Piste).</p>
                            <table class="lab-tabella-da-dove">
                                <thead><tr><th>Pista</th><th>Testata</th><th>File</th><th>Scarto</th></tr></thead>
                                <tbody>
                                    @foreach (var x in g.Soglie)
                                    {
                                        <tr data-soglia-ground="@x.Testata" class="@(x.Diversa || !x.NellAip ? "lab-stato-parziale" : null)">
                                            <td>@x.Pista</td>
                                            <td>@x.Testata</td>
                                            <td>@NomeDelFile(x.File)</td>
                                            <td>@(x.Metri is { } m ? m.ToString("0", System.Globalization.CultureInfo.InvariantCulture) + " m" : x.NellAip ? "AD 2.12 senza coordinate" : "non in AD 2.12")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (g.PisteSenzaSector.Count > 0)
                        {
                            <p class="lab-nota lab-stato-parziale" data-ground-senza-rw>Nessun .rw ha @string.Join(", ", g.PisteSenzaSector).</p>
                        }
                    </section>
                    var t = g.Taxiway;
                    <section class="lab-pista" data-ground-taxiway>
                        <h3 class="lab-pista-nome">Taxiway <span class="lab-nota">AD 2.8 contro i .txi</span></h3>
                        @if (t.Aip is not { } aip)
                        {
                            <p class="lab-nota">AD 2.8 non dice i nomi delle taxiway, o il Lab non li legge.</p>
                        }
                        else
                        {
                            @if (aip.Nomi.Count == 0 && !aip.SenzaNome && !aip.Tutte)
                            {
                                <p class="lab-nota">AD 2.8: NIL, nessuna taxiway.</p>
                            }
                            @if (aip.SenzaNome)
                            {
                                <p class="lab-nota">AD 2.8 ha una taxiway senza nome.</p>
                            }
                            @if (aip.Tutte)
                            {
                                <p class="lab-nota">AD 2.8 le dice tutte insieme («ALL»), senza nomi.</p>
                            }
                        }
                        <dl class="lab-campi-aip">
                            @if (t.Uguali.Count > 0)
                            {
                                <dt>In tutti e due</dt>
                                <dd data-taxiway-uguali>@string.Join(" ", t.Uguali)</dd>
                            }
                            @if (t.MancanoNelSector.Count > 0)
                            {
                                <dt>Mancano nel sector</dt>
                                <dd class="lab-stato-parziale" data-taxiway-mancano>@string.Join(" ", t.MancanoNelSector)</dd>
                            }
                            @if (t.SoloNelSector.Count > 0)
                            {
                                <dt>Solo nel sector</dt>
                                <dd data-taxiway-solo-sector>@string.Join(" ", t.SoloNelSector)</dd>
                            }
                            @if (t.AltreEtichette.Count > 0)
                            {
                                <dt>Altre etichette</dt>
                                <dd data-taxiway-altre title="Etichette dei .txi che non hanno la forma di una taxiway: AD 2.8 non le dice">@string.Join(" · ", t.AltreEtichette)</dd>
                            }
                            <dt>.txi</dt>
                            <dd>@(t.File.Count > 0 ? string.Join(", ", t.File.Select(NomeDelFile)) : $"nessuna etichetta per {s.Icao}")</dd>
                        </dl>
                        @if (t.Aip is { } stampata)
                        {
                            <details class="lab-indice-gruppo">
                                <summary><span class="lab-nota">@stampata.Sezione com'è letta</span></summary>
                                <p class="lab-nota" data-taxiway-testo>@stampata.Testo</p>
                                @if (stampata.Pagina is { } paginaDiAd28 && Ciclo is { } cicloDiAd28)
                                {
                                    <button type="button" class="lab-voce" title="Apre il PDF a questa pagina" @onclick="() => Apri(cicloDiAd28, paginaDiAd28.Reference)">@paginaDiAd28.Reference</button>
                                }
                            </details>
                        }
                    </section>
                }
                break;

            default:
                @* La scheda di prima dello scalo: AD 2.1-2.25 e «Correggi», che resta da qui. *@
                <div data-testo-scalo>@SchedaDelloScalo</div>
                break;
        }
        }
        @if (_rifiuto is { } rifiuto)
        {
            <p class="lab-errore">@rifiuto</p>
        }
    </div>
}

@code {
    private enum Scheda { Piste, Procedure, Carte, Frequenze, Ground, Testo }

    /// <summary>La pagina dello scalo: col parametro, così si ridisegna quando cambia (un componente senza parametri no).</summary>
    [Parameter] public PaginaDelloScalo? Pagina { get; set; }

    [Parameter] public string? Ciclo { get; set; }

    /// <summary>La scheda dello scalo (AD 2.1-2.25, le correzioni), nella scheda «Testo AD 2».</summary>
    [Parameter] public RenderFragment? SchedaDelloScalo { get; set; }

    private string? _rifiuto;

    /// <summary>
    /// La scheda aperta: nella sessione (<see cref="SessioneDelLab.SchedaDellaPaginaDelloScalo"/>), così resta quando si apre una voce e si
    /// torna con «‹ LIRF». Cambiarla chiude la carta aperta.
    /// </summary>
    private Scheda SchedaAperta
    {
        get => Lab.SchedaDellaPaginaDelloScalo is { } v && v.Icao == Pagina?.Scalo.Icao && Enum.TryParse<Scheda>(v.Scheda, out var scheda) ? scheda : Scheda.Procedure;
        set => Lab.SchedaDellaPaginaDelloScalo = (Pagina!.Scalo.Icao, value.ToString(), null);
    }

    /// <summary>La carta di avvicinamento aperta al posto delle schede (S2), o null.</summary>
    private CartaDiAvvicinamento? CartaAperta =>
        Lab.SchedaDellaPaginaDelloScalo is { Carta: { } pagina } v && Pagina is { } p && v.Icao == p.Scalo.Icao
            ? p.Avvicinamenti.FirstOrDefault(c => c.Carta.Page == pagina)
            : null;

    private void ApriLaCarta(CartaDiAvvicinamento carta) => Lab.SchedaDellaPaginaDelloScalo = (Pagina!.Scalo.Icao, SchedaAperta.ToString(), carta.Carta.Page);

    /// <summary>S3: una carta che non è di avvicinamento, aperta dalla scheda Carte per posarla; null se nessuna.</summary>
    private Aip.AerodromeChart? FoglioAperto =>
        CartaAperta is null && Lab.SchedaDellaPaginaDelloScalo is { Carta: { } pagina } v && Pagina is { } p && v.Icao == p.Scalo.Icao
            ? p.Carte.FirstOrDefault(c => c.Iap is null && c.Carta.Page == pagina)?.Carta
            : null;

    private void ApriIlFoglio(Aip.AerodromeChart foglio) => Lab.SchedaDellaPaginaDelloScalo = (Pagina!.Scalo.Icao, Scheda.Carte.ToString(), foglio.Page);

    private void ChiudiLaCarta() => Lab.SchedaDellaPaginaDelloScalo = (Pagina!.Scalo.Icao, SchedaAperta.ToString(), null);

    private static string? Classe(CartaDiAvvicinamento carta) => carta.Stato switch
    {
        StatoDellaCarta.InParte => "lab-stato-parziale",
        StatoDellaCarta.SoloImmagine => "lab-stato-immagine",
        _ => null,
    };

    /// <summary>Una procedura nella scheda Procedure: la voce (la sceglie) e il suo stato.</summary>
    private RenderFragment Riga(ProceduraDelloScalo proc) =>
        @<p class="lab-procedura-scalo">
            <button type="button" class="lab-voce @(Lab.SceltaDellAip == proc.Indice ? "lab-scelto" : null)" data-voce-aip="@proc.Indice"
                    @onclick="() => Scegli(proc.Indice)">@proc.Titolo</button>
            <span class="lab-nota @(proc.Tratti == 0 || proc.NonTrovati > 0 ? "lab-stato-parziale" : null)">@proc.Stato@(proc.ConSegnalazione ? " · segnalazione" : "")</span>
        </p>;

    private static IEnumerable<(Scheda, string)> Schede(PaginaDelloScalo p)
    {
        var (lette, tutte) = p.CarteIap;
        yield return (Scheda.Piste, $"Piste {p.Piste.Count}");
        yield return (Scheda.Procedure, $"Procedure {p.Procedure.SelectMany(g => g.Procedure).Select(x => x.Indice).Concat(p.Avvicinamenti.SelectMany(c => c.Parti).Select(x => x.Procedura.Indice)).Distinct().Count()}");
        yield return (Scheda.Carte, tutte > 0 ? $"Carte · IAP {lette}/{tutte}" : $"Carte {p.Carte.Count}");
        yield return (Scheda.Frequenze, "Frequenze");
        yield return (Scheda.Ground, "Ground");
        yield return (Scheda.Testo, "Testo AD 2");
    }

    private void Scegli(int indice)
    {
        if (Lab.StratoDellAip is { } strato)
            Lab.Scegli(strato.File, indice);
    }

    /// <summary>Il nome del file del sector senza la cartella: <c>itrw.rw</c>.</summary>
    private static string NomeDelFile(string relativo) => relativo[(relativo.LastIndexOfAny(['/', '\\']) + 1)..];

    private void Apri(string ciclo, string pagina) => _rifiuto = Lab.ApriLaPaginaDellAip(ciclo, pagina) ? null : Lab.Rifiuto;

    /// <summary>«ARP 41°48'N 012°15'E · 15 ft · 3° E · IFR/VFR»: quel che lo scalo ha.</summary>
    private static string Testata(Aip.Aerodrome s) => string.Join(" · ", new[]
    {
        s.Arp is { } arp ? "ARP " + Coordinate(arp) : null,
        s.Elevation,
        s.MagneticVariation is { } v ? $"declinazione {v}" : null,
        s.Traffic,
    }.OfType<string>());

    /// <summary>Gradi, primi e secondi, come li stampa l'AIP: 41°48'02"N 012°14'13"E.</summary>
    private static string Coordinate(Aip.Position p) => $"{Gms(p.Lat, 2, p.Lat < 0 ? 'S' : 'N')} {Gms(p.Lon, 3, p.Lon < 0 ? 'W' : 'E')}";

    private static string Gms(double gradi, int cifre, char lato)
    {
        var secondi = (int)Math.Round(Math.Abs(gradi) * 3600);
        return $"{(secondi / 3600).ToString(new string('0', cifre), System.Globalization.CultureInfo.InvariantCulture)}°{secondi / 60 % 60:00}'{secondi % 60:00}\"{lato}";
    }

    /// <summary>
    /// «SID 12 · STAR 20 · IAP 1/3» del lato di una pista: gli avvicinamenti per carta (S2), quelle con parti su tutte; quelli
    /// fuori dalle carte col loro gruppo.
    /// </summary>
    private static string Procedure(PaginaDelloScalo p, string lato)
    {
        var carte = p.AvvicinamentiDi(lato).ToList();
        return string.Join(" · ", p.Procedure.Where(g => g.Pista == lato).Select(g => $"{g.Genere} {g.Procedure.Count}")
            .Concat(carte.Count == 0 ? [] : [$"IAP {carte.Count(c => c.Parti.Count > 0)}/{carte.Count}"]));
    }
}
