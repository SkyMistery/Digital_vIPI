<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vipi.Domain\Vipi.Domain.csproj" />
    <!-- Contratto del bridge Aurora: POCO senza dipendenze. L'Application lo usa DIRETTAMENTE come input/output
         del matching invece di avere DTO propri poi ricopiati nell'endpoint: un modello solo (FEATURE-PROCESS §1). -->
    <ProjectReference Include="..\Vipi.AuroraBridge.Contracts\Vipi.AuroraBridge.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- ⚠️ IL RID SI DICHIARA QUI, e non è cosmesi: senza, il `packages.lock.json` di questa libreria CAMBIA
         FORMA a seconda di chi lo restora. Il publish del pacchetto (linux-x64, self-contained) risolve il
         grafo di quel RID anche per le librerie e scrive le sezioni `net8.0/linux-x64` e `net10.0/linux-x64`;
         un `dotnet build` normale non le produce, e il file balla a ogni giro mostrandosi modificato in git
         senza che nessuna dipendenza sia cambiata. Dichiarandolo, ogni restore produce lo stesso file. La CI
         restora in «locked mode» e si fermerebbe su un lock di forma diversa da quella committata. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
