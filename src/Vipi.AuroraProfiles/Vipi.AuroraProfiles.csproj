<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Il motore dell'Aurora Profile Swapper: legge un profilo .cpr, ne scambia sezioni intere, lo riscrive
    identico byte per byte in tutto il resto.

    Arriva dal repo AuroraProfileSwapper (commit 9c0207a), dove e' nato come libreria deliberatamente
    ignara della UI. Qui e' entrato COM'ERA: dei tre file e' cambiato il namespace e nient'altro, e i suoi
    test sono venuti dietro con le 26 fixture reali. Se un giorno un test di questi diventa rosso senza che
    nessuno abbia toccato il parser, il sospetto e' il multi-target, non la logica.

    ZERO dipendenze, e non e' pigrizia: un parser INI generico riordina le sezioni, normalizza le righe
    vuote e perde il preambolo. Su un file che Aurora deve poter riaprire, "quasi uguale" e' rotto.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- ⚠️ IL RID SI DICHIARA QUI, e non è cosmesi: senza, il `packages.lock.json` di questa libreria CAMBIA
         FORMA a seconda di chi lo restora. Il publish del pacchetto (linux-x64, self-contained) risolve il
         grafo di quel RID anche per le librerie e scrive le sezioni `net8.0/linux-x64` e `net10.0/linux-x64`;
         un `dotnet build` normale non le produce, e il file balla a ogni giro mostrandosi modificato in git
         senza che nessuna dipendenza sia cambiata. Dichiarandolo, ogni restore produce lo stesso file. La CI
         restora in «locked mode» e si fermerebbe su un lock di forma diversa da quella committata. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vipi.AuroraProfiles.Tests" />
  </ItemGroup>

</Project>
